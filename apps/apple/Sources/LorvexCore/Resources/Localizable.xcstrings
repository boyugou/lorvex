    "import.error.newer_version": {
      "comment": "Shown when the backup chosen for import was written by a newer version of Lorvex than the one running.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُنشئت هذه النسخة الاحتياطية بإصدار أحدث من Lorvex. حدِّث Lorvex على هذا الجهاز، ثم حاول مرة أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup was made by a newer version of Lorvex. Update Lorvex on this device, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia de seguridad se creó con una versión más reciente de Lorvex. Actualiza Lorvex en este dispositivo e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sauvegarde a été créée par une version plus récente de Lorvex. Mettez à jour Lorvex sur cet appareil, puis réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह बैकअप Lorvex के नए संस्करण से बनाया गया था। इस डिवाइस पर Lorvex अपडेट करें, फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo backup è stato creato con una versione più recente di Lorvex. Aggiorna Lorvex su questo dispositivo, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックアップは、より新しいバージョンのLorvexで作成されました。このデバイスでLorvexをアップデートしてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 백업은 더 새로운 버전의 Lorvex에서 만들어졌습니다. 이 기기에서 Lorvex를 업데이트한 후 다시 시도하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta kopia zapasowa została utworzona przez nowszą wersję Lorvex. Zaktualizuj Lorvex na tym urządzeniu i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este backup foi criado por uma versão mais recente do Lorvex. Atualize o Lorvex neste dispositivo e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта резервная копия создана более новой версией Lorvex. Обновите Lorvex на этом устройстве и повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю резервну копію створено новішою версією Lorvex. Оновіть Lorvex на цьому пристрої та спробуйте знову."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此备份由较新版本的 Lorvex 创建。请先在此设备上更新 Lorvex，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此備份是由較新版本的 Lorvex 建立的。請先在此裝置上更新 Lorvex，然後再試一次。"
          }
        }
      }
    },
    "import.error.no_data": {
