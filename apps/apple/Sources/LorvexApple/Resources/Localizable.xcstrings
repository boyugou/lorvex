        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strongest on %1$@, weakest on %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mejor día: %1$@. Peor día: %2$@."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بیشترین پایبندی در %1$@، کمترین در %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meilleur jour : %1$@, moins bon jour : %2$@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החזק ביותר ב%1$@, החלש ביותר ב%2$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ को सबसे मज़बूत, %2$@ को सबसे कमज़ोर।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terkuat pada %1$@, terlemah pada %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Giorno migliore: %1$@, peggiore: %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が最も多く、%2$@が最も少なくなっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에 가장 잘 지키고, %2$@에 가장 적게 지킵니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वात चांगला दिवस: %1$@, सर्वात कमकुवत दिवस: %2$@."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terkuat pada %1$@, terlemah pada %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het sterkst op %1$@, het zwakst op %2$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najczęściej: %1$@, najrzadziej: %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Melhor dia: %1$@, pior dia: %2$@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel mai bun: %1$@; cel mai slab: %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чаще всего: %1$@, реже всего: %2$@."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வலிமையான நாள் %1$@, பலவீனமான நாள் %2$@."
