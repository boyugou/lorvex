    "task_detail.metadata.available_from_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مخفية من قوائمك حتى هذا اليوم."
          }
        },
        "bn": {
