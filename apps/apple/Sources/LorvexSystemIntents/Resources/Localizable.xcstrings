    "system.parameter.date.today_when_blank.description": {
      "comment": "Description of an optional date parameter in Shortcuts that means today when left empty",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتركه فارغًا لاستخدام اليوم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave blank for today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjala en blanco para usar hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez vide pour aujourd’hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज के लिए खाली छोड़ें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia vuoto per oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空欄の場合は今日になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비워 두면 오늘입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaw puste, aby użyć dzisiejszej daty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe em branco para hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте поле пустым, чтобы использовать сегодняшнюю дату."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залиште поле порожнім, щоб використати сьогоднішню дату."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留空表示今天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留空則為今天。"
          }
        }
      }
    },
    "system.review.daily.amend.description": {
      "comment": "Description for the Amend Lorvex Daily Review App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحديث حقول مراجعة يومية موجودة في Lorvex."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update fields on an existing Lorvex daily review."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza campos de una revisión diaria de Lorvex existente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met à jour des champs d’un bilan quotidien existant de Lorvex."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौजूदा Lorvex दैनिक समीक्षा के फ़ील्ड अपडेट करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna i campi di una revisione giornaliera di Lorvex esistente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexの既存の毎日の振り返りの項目を更新します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 Lorvex 일일 회고의 항목을 업데이트합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizuje pola istniejącego podsumowania dnia Lorvex."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualiza campos de uma revisão diária do Lorvex existente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновляет поля существующих итогов дня Lorvex."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновлює поля наявних підсумків дня Lorvex."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新现有 Lorvex 每日回顾的字段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新現有 Lorvex 每日回顧的欄位。"
          }
        }
      }
    },
    "system.review.daily.amend.dialog": {
      "comment": "Dialog after amending daily review; %@ is review date",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تحديث المراجعة اليومية بتاريخ %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updated daily review for %@."
