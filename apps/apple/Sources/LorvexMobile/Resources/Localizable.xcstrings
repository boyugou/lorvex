    "settings.calendar.access.off_detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتم قراءة أي أحداث تقويم في Lorvex."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যালেন্ডারের কোনো ইভেন্ট Lorvex-এ পড়া হয় না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden keine Kalenderereignisse in Lorvex eingelesen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν διαβάζονται γεγονότα ημερολογίου στο Lorvex."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No calendar events are read into Lorvex."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex no lee ningún evento de calendario."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ رویداد تقویمی در Lorvex خوانده نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun événement du calendrier n’est lu dans Lorvex."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נקראים אירועי לוח שנה אל Lorvex."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई कैलेंडर इवेंट Lorvex में नहीं पढ़ा जाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada acara kalender yang dibaca ke dalam Lorvex."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun evento del calendario viene letto in Lorvex."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーイベントはLorvexに読み込まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 이벤트를 Lorvex로 읽어 오지 않습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दिनदर्शिकेतील कोणतेही इव्हेंट Lorvex मध्ये वाचले जात नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada peristiwa kalendar dibaca ke dalam Lorvex."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er worden geen agenda-activiteiten in Lorvex ingelezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydarzenia z kalendarza nie są odczytywane w Lorvex."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum evento do calendário é lido no Lorvex."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Niciun eveniment din calendar nu este citit în Lorvex."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "События календаря не считываются в Lorvex."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கேலண்டர் நிகழ்வுகள் எதுவும் Lorvexஇல் படிக்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexలోకి క్యాలెండర్ ఇవెంట్‌లు ఏవీ చదవబడవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีการอ่านกิจกรรมปฏิทินเข้า Lorvex"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex’e hiçbir takvim etkinliği okunmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Події календаря не зчитуються в Lorvex."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی کیلنڈر ایونٹ Lorvex میں نہیں پڑھا جاتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có sự kiện lịch nào được đọc vào Lorvex."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会将日历事件读入 Lorvex。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會將行事曆事件讀取到 Lorvex 中。"
          }
        }
      }
    },
    "settings.calendar.access.scope_detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينطبق على ما يمكن لـ Lorvex والمساعدين المتصلين رؤيته على هذا الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex এবং সংযুক্ত অ্যাসিস্ট্যান্ট এই ডিভাইসে কী দেখতে পারে, তার উপর এটি প্রযোজ্য।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für alles, was Lorvex und verbundene Assistenten auf diesem Gerät sehen können."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ισχύει για όσα μπορούν να δουν το Lorvex και οι συνδεδεμένοι βοηθοί σε αυτήν τη συσκευή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to what Lorvex and connected assistants can see on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a lo que Lorvex y los asistentes conectados pueden ver en este dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای آنچه Lorvex و دستیارهای متصل در این دستگاه می‌توانند ببینند اعمال می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique à ce que Lorvex et les assistants connectés peuvent voir sur cet appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חל על מה ש-Lorvex והעוזרים המחוברים יכולים לראות במכשיר זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह इस पर लागू होता है कि इस डिवाइस पर Lorvex और जुड़े हुए असिस्टेंट क्या देख सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berlaku untuk apa yang dapat dilihat Lorvex dan asisten yang terhubung di perangkat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si applica a ciò che Lorvex e gli assistenti connessi possono vedere su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定は、このデバイス上でLorvexと接続済みのアシスタントが見られる内容に適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 Lorvex와 연결된 어시스턴트가 볼 수 있는 내용에 적용됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex आणि कनेक्ट केलेले सहाय्यक या डिव्हाइसवर काय पाहू शकतात, त्याला हे लागू होते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terpakai pada apa yang boleh dilihat oleh Lorvex dan pembantu AI yang disambungkan pada peranti ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geldt voor wat Lorvex en verbonden assistenten op dit apparaat kunnen zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Określa, co Lorvex i połączeni asystenci mogą widzieć na tym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se ao que o Lorvex e os assistentes conectados podem ver neste dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplică la ceea ce pot vedea Lorvex și asistenții conectați pe acest dispozitiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Определяет, что Lorvex и подключённые ассистенты могут видеть на этом устройстве."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சாதனத்தில் Lorvex மற்றும் இணைக்கப்பட்ட அசிஸ்டென்ட்கள் பார்க்கக்கூடியவற்றுக்கு இது பொருந்தும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ డివైజ్‌లో Lorvex మరియు కనెక్ట్ చేసిన అసిస్టెంట్‌లు చూడగలిగే వాటికి ఇది వర్తిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีผลกับสิ่งที่ Lorvex และผู้ช่วยที่เชื่อมต่อมองเห็นบนอุปกรณ์เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex’in ve bağlı asistanların bu aygıtta görebildiklerini kapsar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Визначає, що Lorvex і підключені асистенти можуть бачити на цьому пристрої."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ اس پر لاگو ہوتا ہے جو Lorvex اور منسلک اسسٹنٹس اس ڈیوائس پر دیکھ سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp dụng cho những gì Lorvex và các trợ lý được kết nối có thể thấy trên thiết bị này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于 Lorvex 和已连接的助手可在此设备上看到的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適用於 Lorvex 與已連接的助理在此裝置上能看到的內容。"
          }
        }
      }
    },
    "settings.calendar.access_denied": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى التقويم متوقف. افتح الإعدادات للسماح لـ Lorvex بقراءة تقويمات الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যালেন্ডার অ্যাক্সেস বন্ধ আছে। ডিভাইসের ক্যালেন্ডার পড়ার অনুমতি Lorvex-কে দিতে সেটিংস খুলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kalenderzugriff ist ausgeschaltet. Öffne die Einstellungen, damit Lorvex die Kalender dieses Geräts lesen darf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πρόσβαση στο ημερολόγιο είναι απενεργοποιημένη. Ανοίξτε τις Ρυθμίσεις για να επιτρέψετε στο Lorvex να διαβάζει τα ημερολόγια της συσκευής."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar access is off. Open Settings to allow Lorvex to read device calendars."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso al calendario está desactivado. Abre Ajustes para permitir que Lorvex lea los calendarios del dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به تقویم خاموش است. برای اینکه Lorvex بتواند تقویم‌های دستگاه را بخواند، تنظیمات را باز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au calendrier est désactivé. Ouvrez les réglages pour autoriser Lorvex à lire les calendriers de l’appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגישה ללוח השנה כבויה. יש לפתוח את ההגדרות כדי לאפשר ל-Lorvex לקרוא את לוחות השנה במכשיר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलेंडर एक्सेस बंद है। Lorvex को डिवाइस के कैलेंडर पढ़ने देने के लिए सेटिंग्ज़ खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses kalender nonaktif. Buka Pengaturan agar Lorvex dapat membaca kalender di perangkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso al calendario è disattivato. Apri Impostazioni per consentire a Lorvex di leggere i calendari del dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーへのアクセスがオフです。「設定」を開いて、Lorvexがデバイスのカレンダーを読み取れるようにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 접근이 꺼져 있습니다. 설정을 열어 Lorvex가 기기 캘린더를 읽을 수 있도록 허용하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दिनदर्शिका ॲक्सेस बंद आहे. Lorvex ला डिव्हाइसच्या दिनदर्शिका वाचण्याची अनुमती देण्यासाठी सेटिंग उघडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses kalendar tidak aktif. Buka Seting untuk membenarkan Lorvex membaca kalendar peranti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot de agenda staat uit. Open Instellingen om Lorvex toe te staan de agenda’s op dit apparaat te lezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do kalendarza jest wyłączony. Otwórz Ustawienia, aby zezwolić Lorvex na odczyt kalendarzy urządzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao calendário está desativado. Abra os Ajustes para permitir que o Lorvex leia os calendários do dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesul la calendar este dezactivat. Deschideți Configurări pentru a permite Lorvex să citească calendarele de pe dispozitiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к календарю выключен. Откройте Настройки, чтобы разрешить Lorvex читать календари устройства."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கேலண்டர் அணுகல் ஆஃப் ஆக உள்ளது. சாதனக் கேலண்டர்களை Lorvex படிக்க அனுமதிக்க அமைப்புகளைத் திறக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "క్యాలెండర్ యాక్సెస్ ఆఫ్‌లో ఉంది. డివైజ్ క్యాలెండర్‌లను Lorvex చదవడానికి అనుమతించాలంటే సెట్టింగ్స్‌ను తెరవండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าถึงปฏิทินปิดอยู่ เปิดการตั้งค่าเพื่ออนุญาตให้ Lorvex อ่านปฏิทินในอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvim erişimi kapalı. Lorvex’in aygıt takvimlerini okumasına izin vermek için Ayarlar’ı açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до календаря вимкнено. Відкрийте Параметри, щоб дозволити Lorvex читати календарі пристрою."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیلنڈر تک رسائی بند ہے۔ Lorvex کو ڈیوائس کے کیلنڈرز پڑھنے کی اجازت دینے کے لیے ترتیبات کھولیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập lịch đang tắt. Hãy mở Cài đặt để cho phép Lorvex đọc lịch trên thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日历访问权限已关闭。打开设置以允许 Lorvex 读取设备日历。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "行事曆存取權限已關閉。請開啟「設定」，允許 Lorvex 讀取裝置行事曆。"
          }
        }
      }
    },
