            "state": "translated",
            "value": "取り組む予定の日です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하기로 계획한 날입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzień, w którym planujesz nad nim pracować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dia em que você planeja trabalhar nela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "День, в который вы планируете заняться задачей."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "День, коли ви плануєте над ним працювати."
