    "system.habit.batch_complete.description": {
      "comment": "Description for the Batch Complete Lorvex Habits App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إكمال عدة عادات في Lorvex من الاختصارات."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete multiple Lorvex habits from Shortcuts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa varios hábitos de Lorvex desde Atajos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Valide plusieurs habitudes de Lorvex depuis Raccourcis."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट्स से Lorvex की कई आदतें पूर्ण करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa più abitudini di Lorvex da Comandi rapidi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットでLorvexの複数の習慣を完了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어에서 Lorvex 습관 여러 개를 완료합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykonuje kilka nawyków Lorvex ze Skrótów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclui vários hábitos do Lorvex pelos Atalhos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполняет несколько привычек Lorvex из «Быстрых команд»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виконує кілька звичок Lorvex зі «Швидких команд»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“快捷指令”完成多个 Lorvex 习惯。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過捷徑一次完成多個 Lorvex 習慣。"
          }
        }
      }
    },
