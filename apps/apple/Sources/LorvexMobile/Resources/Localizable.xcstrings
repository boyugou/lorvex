    "memory.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط ＋ لحفظ ما تريد أن يتذكره مساعدك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাসিস্ট্যান্টকে যা মনে রাখাতে চান, তা সেভ করতে ＋ ট্যাপ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf ＋, um etwas festzuhalten, woran sich dein Assistent erinnern soll."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε ＋ για να αποθηκεύσετε κάτι που πρέπει να θυμάται ο βοηθός σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap ＋ to save something your assistant should remember."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca ＋ para guardar algo que tu asistente deba recordar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای ذخیره چیزی که دستیارتان باید به خاطر بسپارد، روی ＋ ضربه بزنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez ＋ pour enregistrer ce que votre assistant doit retenir."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להקיש על ＋ כדי לשמור משהו שהעוזר שלך צריך לזכור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो बात आपके असिस्टेंट को याद रखनी चाहिए, उसे सहेजने के लिए ＋ पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk ＋ untuk menyimpan sesuatu yang perlu diingat asisten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca ＋ per salvare qualcosa che il tuo assistente dovrebbe ricordare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "＋をタップして、アシスタントに覚えてほしいことを保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "＋ 버튼을 탭하여 어시스턴트가 기억해야 할 내용을 저장하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सहाय्यकाने लक्षात ठेवावे असे काही जतन करण्यासाठी ＋ टॅप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik ＋ untuk menyimpan sesuatu yang perlu diingati pembantu AI."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op ＋ om iets te bewaren dat je assistent moet onthouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij ＋, aby zapisać coś, co asystent powinien zapamiętać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em ＋ para salvar algo que seu assistente deve lembrar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți ＋ pentru a salva ceva ce asistentul ar trebui să rețină."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь ＋, чтобы сохранить то, что ассистент должен помнить."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் அசிஸ்டென்ட் நினைவில் வைத்திருக்க வேண்டியதைச் சேமிக்க ＋ தட்டவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ అసిస్టెంట్ గుర్తుంచుకోవాల్సిన విషయాన్ని సేవ్ చేయడానికి ＋ ట్యాప్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะ ＋ เพื่อบันทึกสิ่งที่ผู้ช่วยของคุณควรจดจำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asistanınızın hatırlaması gereken bir şeyi kaydetmek için ＋ simgesine dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніть ＋, щоб зберегти те, що має пам’ятати асистент."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی ایسی بات محفوظ کرنے کے لیے ＋ پر ٹیپ کریں جو آپ کے اسسٹنٹ کو یاد رکھنی چاہیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm ＋ để lưu điều trợ lý nên ghi nhớ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按 ＋ 保存希望助手记住的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下 ＋ 儲存希望助理記住的事情。"
          }
        }
      }
    },
