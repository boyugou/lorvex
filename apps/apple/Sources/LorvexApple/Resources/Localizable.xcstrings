    "setup.welcome.today.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما هو مخطط لليوم في قائمة واحدة، وجدولك إلى جانبها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজকের সবকিছু এক তালিকায়, পাশে আপনার সময়সূচি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles für heute in einer Liste – mit deinem Zeitplan daneben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα όσα έχουν οριστεί για σήμερα σε μία λίστα, με το πρόγραμμά σας δίπλα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything set for today in one list, with your schedule beside it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo de hoy en una sola lista, con tu agenda al lado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همه آنچه برای امروز تعیین شده در یک فهرست، با زمان‌بندی‌تان در کنارش."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui est prévu pour aujourd’hui dans une seule liste, avec votre planning à côté."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל מה שמתוכנן להיום ברשימה אחת, ולצדה לוח הזמנים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज के लिए सब कुछ एक ही सूची में, और उसके बगल में आपका शेड्यूल।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua yang direncanakan untuk hari ini dalam satu daftar, dengan jadwal di sampingnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che è previsto per oggi in un’unica lista, con la tua agenda accanto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の予定をすべて1つのリストにまとめ、スケジュールを横に表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 할 일을 하나의 목록으로 모아 보여 주고, 옆에 일정을 함께 표시합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आजसाठी ठरलेले सर्व काही एका यादीत, शेजारी तुमचे शेड्यूल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Segala yang ditetapkan untuk hari ini dalam satu senarai, dengan jadual di sebelahnya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles voor vandaag in één lijst, met je planning ernaast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko na dziś na jednej liście, a obok twój harmonogram."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que está marcado para hoje em uma só lista, com a sua agenda ao lado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot ce aveți de făcut astăzi, într-o singură listă, cu programul alături."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что запланировано на сегодня, в одном списке, а рядом ваше расписание."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்றைக்கான அனைத்தும் ஒரே பட்டியலில், அதன் அருகிலேயே உங்கள் அட்டவணை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈరోజు కోసం అన్నీ ఒకే జాబితాలో, పక్కనే మీ షెడ్యూల్."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างที่วางแผนไว้สำหรับวันนี้อยู่ในลิสต์เดียว และมีกำหนดการอยู่ด้านข้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugüne planlanan her şey tek bir listede, programınız da yanında."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе, що заплановано на сьогодні, в одному списку, а поруч ваш розклад."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج کے لیے طے شدہ سب کچھ ایک فہرست میں، آپ کے شیڈول کے ساتھ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi việc cho hôm nay trong một danh sách, kèm lịch trình ngay bên cạnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天要做的事都在一个列表里，日程就在旁边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天安排好的事項全都集中在一份清單裡，行程就放在旁邊。"
          }
        }
      }
    },
