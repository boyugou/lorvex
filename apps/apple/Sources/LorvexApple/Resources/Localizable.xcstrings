    "setup.sync.off.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقف المزامنة في أي وقت من الإعدادات. تبقى بياناتك على جهاز Mac هذا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেটিংসে গিয়ে যেকোনো সময় সিঙ্ক বন্ধ করতে পারেন। আপনার ডেটা শুধু এই Mac-এ থাকবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte die Synchronisierung jederzeit in den Einstellungen aus. Deine Daten bleiben auf diesem Mac."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απενεργοποιήστε τον συγχρονισμό όποτε θέλετε από τις Ρυθμίσεις. Τα δεδομένα σας παραμένουν σε αυτό το Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn syncing off anytime in Settings. Your data stays on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva la sincronización cuando quieras en Ajustes. Tus datos se quedan en este Mac."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همگام‌سازی را هر زمان در تنظیمات خاموش کنید. داده‌های شما در همین Mac می‌مانند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez la synchronisation à tout moment dans Réglages. Vos données restent sur ce Mac."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לכבות את הסנכרון בכל עת בהגדרות. הנתונים שלך נשארים ב-Mac הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्ज़ में कभी भी सिंक बंद करें। आपका डेटा इसी Mac पर रहेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan penyelarasan kapan saja di Pengaturan. Data tetap berada di Mac ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva la sincronizzazione in qualsiasi momento in Impostazioni. I tuoi dati restano su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期は「設定」でいつでもオフにできます。データはこのMacに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 언제든 동기화를 끌 수 있습니다. 데이터는 이 Mac에 그대로 남습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंगमध्ये तुम्ही कधीही सिंक बंद करू शकता. तुमचा डेटा या Mac वरच राहील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyahaktifkan penyelarasan bila-bila masa dalam Seting. Data anda kekal pada Mac ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet synchronisatie op elk moment uit in Instellingen. Je gegevens blijven op deze Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizację możesz wyłączyć w dowolnym momencie w ustawieniach. Twoje dane pozostaną na tym Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative a sincronização a qualquer momento em Ajustes. Seus dados permanecem neste Mac."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezactivați sincronizarea oricând din Configurări. Datele rămân pe acest Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключить синхронизацию можно в любой момент в настройках. Ваши данные останутся на этом Mac."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அமைப்புகளில் எப்போது வேண்டுமானாலும் ஒத்திசைவை ஆஃப் செய்யலாம். உங்கள் தரவு இந்த Macஇலேயே இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సెట్టింగ్స్‌లో ఎప్పుడైనా సింక్‌ను ఆఫ్ చేయవచ్చు. మీ డేటా ఈ Macలోనే ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดการเชื่อมข้อมูลได้ทุกเมื่อในการตั้งค่า ข้อมูลของคุณจะอยู่บน Mac เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşzamanlamayı istediğiniz zaman Ayarlar’dan kapatabilirsiniz. Verileriniz bu Mac’te kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкнути синхронізацію можна будь-коли в параметрах. Ваші дані залишаться на цьому Mac."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ترتیبات میں کبھی بھی سنک بند کر دیں۔ آپ کا ڈیٹا اسی Mac پر رہتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt đồng bộ hóa bất cứ lúc nào trong Cài đặt. Dữ liệu của bạn vẫn ở trên máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时可以在设置中关闭同步，数据仍保留在这台 Mac 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以隨時在「設定」中關閉同步，資料會留在這部 Mac 上。"
          }
        }
      }
    },
    "setup.done.capture.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضفها بنفسك"
          }
        },
        "bn": {
