    "calendar.delete_event.scope.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر حالات التكرار التي تريد حذفها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which occurrences to delete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué repeticiones eliminar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انتخاب کنید کدام تکرارها حذف شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les occurrences à supprimer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור אילו מופעים למחוק."
