    "carplay.error.load_tasks": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل المهام. اضغط لإعادة المحاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben konnten nicht geladen werden – tippe, um es erneut zu versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t load tasks — tap to retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar las tareas. Toca para reintentar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بارگیری کارها انجام نشد — برای تلاش دوباره ضربه بزنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les tâches. Touchez pour réessayer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לטעון את המשימות — יש להקיש כדי לנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्य लोड नहीं हो सके। फिर से कोशिश करने के लिए टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat memuat tugas – ketuk untuk mencoba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare le attività. Tocca per riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクを読み込めませんでした。タップして再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일을 불러올 수 없습니다. 탭하여 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat memuatkan tugas – ketik untuk mencuba semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Taken konden niet worden geladen – tik om opnieuw te proberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wczytać zadań. Stuknij, aby spróbować ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar as tarefas. Toque para tentar novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarcinile nu au putut fi încărcate – atingeți pentru a reîncerca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить задачи. Коснитесь, чтобы повторить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити завдання. Торкніть, щоб повторити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
