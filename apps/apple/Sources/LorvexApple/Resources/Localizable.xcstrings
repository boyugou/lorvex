    "setup.sync.private.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُخزَّن مشفّرة في حساب iCloud الخاص بك. ليس لدى Lorvex خادم خاص به."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored encrypted in your own iCloud account. Lorvex has no server of its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guardan cifrados en tu propia cuenta de iCloud. Lorvex no tiene servidor propio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données sont chiffrées dans votre propre compte iCloud. Lorvex n’a pas de serveur propre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके अपने iCloud खाते में एन्क्रिप्टेड रूप में सहेजा जाता है। Lorvex का अपना कोई सर्वर नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati sono archiviati con crittografia nel tuo account iCloud. Lorvex non ha un server proprio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなた自身のiCloudアカウントに暗号化して保存されます。Lorvexには独自のサーバはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 본인의 iCloud 계정에 암호화되어 저장됩니다. Lorvex에는 자체 서버가 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane są przechowywane w postaci zaszyfrowanej na twoim koncie iCloud. Lorvex nie ma własnego serwera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dados ficam armazenados com criptografia na sua própria conta do iCloud. O Lorvex não tem servidor próprio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранится в зашифрованном виде в вашей учётной записи iCloud. У Lorvex нет собственного сервера."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігається в зашифрованому вигляді у вашому обліковому записі iCloud. У Lorvex немає власного сервера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加密保存在你自己的 iCloud 账户中。Lorvex 没有自己的服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料會加密儲存在你自己的 iCloud 帳號中。Lorvex 沒有自己的伺服器。"
          }
        }
      }
    },
    "setup.sync.off.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقفها متى شئت"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off whenever you like"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactívala cuando quieras"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivable à tout moment"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब चाहें बंद करें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivabile quando vuoi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつでもオフにできる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언제든 끌 수 있습니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłączysz, kiedy zechcesz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative quando quiser"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключайте, когда захотите"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимикайте, коли захочете"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时可以关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨時都能關閉"
          }
        }
      }
    },
    "setup.sync.off.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقف المزامنة في أي وقت من الإعدادات. تبقى بياناتك على جهاز Mac هذا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn syncing off anytime in Settings. Your data stays on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva la sincronización cuando quieras en Ajustes. Tus datos se quedan en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez la synchronisation à tout moment dans Réglages. Vos données restent sur ce Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्ज़ में कभी भी सिंक बंद करें। आपका डेटा इसी Mac पर रहेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva la sincronizzazione in qualsiasi momento in Impostazioni. I tuoi dati restano su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期は「設定」でいつでもオフにできます。データはこのMacに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 언제든 동기화를 끌 수 있습니다. 데이터는 이 Mac에 그대로 남습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizację możesz wyłączyć w dowolnym momencie w ustawieniach. Twoje dane pozostaną na tym Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative a sincronização a qualquer momento em Ajustes. Seus dados permanecem neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключить синхронизацию можно в любой момент в настройках. Ваши данные останутся на этом Mac."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкнути синхронізацію можна будь-коли в параметрах. Ваші дані залишаться на цьому Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时可以在设置中关闭同步，数据仍保留在这台 Mac 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以隨時在「設定」中關閉同步，資料會留在這部 Mac 上。"
          }
        }
      }
    },
    "setup.done.capture.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضفها بنفسك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture it yourself"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añádela tú"
          }
        },
        "fr": {
