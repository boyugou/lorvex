          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کاموں کی آنے والی یاد دہانیاں Lorvex سے پڑھیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc lời nhắc nhiệm vụ Lorvex sắp tới"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取 Lorvex 即将到来的任务提醒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取即將到來的 Lorvex 任務提醒"
          }
        }
      }
    },
    "system.task.reopen.description": {
      "comment": "Description for the Reopen Lorvex Task App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة فتح مهمة مكتملة أو ملغاة أو مؤجلة في Lorvex."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সম্পূর্ণ, বাতিল বা পিছিয়ে দেওয়া একটি Lorvex টাস্ক আবার খুলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet eine erledigte, abgebrochene oder verschobene Lorvex-Aufgabe wieder."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε ξανά μια εργασία Lorvex που έχει ολοκληρωθεί, ακυρωθεί ή αναβληθεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reopen a completed, cancelled, or deferred Lorvex task."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reabre una tarea de Lorvex completada, cancelada o aplazada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بازگشایی یک کار تکمیل‌شده، لغوشده یا موکول‌شده در Lorvex."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rouvre une tâche de Lorvex terminée, annulée ou reportée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתיחה מחדש של משימה ב-Lorvex שהושלמה, בוטלה או נדחתה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्ण, रद्द या टाले गए Lorvex कार्य को फिर से खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka kembali tugas Lorvex yang selesai, dibatalkan, atau ditunda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riapre un’attività di Lorvex completata, annullata o rimandata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了、キャンセル、または延期したLorvexのタスクを未完了に戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료, 취소 또는 미뤄진 Lorvex 할 일을 다시 엽니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्ण झालेले, रद्द केलेले किंवा पुढे ढकललेले एक Lorvex कार्य पुन्हा उघडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka semula tugas Lorvex yang selesai, dibatalkan atau ditangguhkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heropent een voltooide, geannuleerde of uitgestelde Lorvex-taak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponownie otwiera ukończone, anulowane lub odłożone zadanie Lorvex."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reabre uma tarefa do Lorvex concluída, cancelada ou adiada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Redeschide o sarcină Lorvex finalizată, anulată sau amânată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снова открывает выполненную, отменённую или отложенную задачу Lorvex."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நிறைவடைந்த, ரத்துசெய்யப்பட்ட அல்லது தள்ளிவைக்கப்பட்ட Lorvex பணியை மீண்டும் திறக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పూర్తయిన, రద్దయిన లేదా వాయిదా వేసిన Lorvex టాస్క్‌ను మళ్ళీ తెరవండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดงาน Lorvex ที่เสร็จแล้ว ถูกยกเลิก หรือถูกเลื่อนออกไปใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamlanmış, iptal edilmiş veya ertelenmiş bir Lorvex görevini yeniden açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знову відкриває виконане, скасоване або відкладене завдання Lorvex."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مکمل، منسوخ یا ملتوی شدہ Lorvex کام دوبارہ کھولیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở lại một nhiệm vụ Lorvex đã hoàn thành, đã hủy hoặc đã bị hoãn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新打开已完成、已取消或已推迟的 Lorvex 任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新開啟已完成、已取消或已延後的 Lorvex 任務。"
          }
        }
      }
    },
