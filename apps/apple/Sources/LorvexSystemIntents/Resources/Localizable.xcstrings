    "system.habit.complete.description": {
      "comment": "Description for the Complete Lorvex Habit App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إكمال عادة في Lorvex من الاختصارات أو Siri."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শর্টকাট বা Siri থেকে একটি Lorvex অভ্যাস সম্পূর্ণ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erledigt eine Lorvex-Gewohnheit über Kurzbefehle oder Siri."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ολοκληρώστε μια συνήθεια Lorvex από τις Συντομεύσεις ή το Siri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete a Lorvex habit from Shortcuts or Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa un hábito de Lorvex desde Atajos o Siri."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تکمیل یک عادت Lorvex از طریق میان‌برها یا Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Valide une habitude de Lorvex depuis Raccourcis ou Siri."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השלמת הרגל ב-Lorvex דרך קיצורי דרך או Siri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट्स या Siri से Lorvex की कोई आदत पूर्ण करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyelesaikan kebiasaan Lorvex dari Pintasan atau Siri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa un’abitudine di Lorvex da Comandi rapidi o Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットまたはSiriでLorvexの習慣を完了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어 또는 Siri에서 Lorvex 습관을 완료합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट किंवा Siri द्वारे एक Lorvex सवय पूर्ण करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyelesaikan tabiat Lorvex daripada Pintasan atau Siri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltooit een Lorvex-gewoonte via Opdrachten of Siri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykonuje nawyk Lorvex ze Skrótów lub Siri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclui um hábito do Lorvex pelos Atalhos ou pela Siri."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalizează un obicei Lorvex prin Scurtături sau Siri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполняет привычку Lorvex из «Быстрых команд» или Siri."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்கவழிகள் அல்லது Siri மூலம் Lorvex பழக்கத்தை நிறைவுசெய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "షార్ట్‌కట్స్ లేదా Siri నుండి Lorvex అలవాటును పూర్తి చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำนิสัย Lorvex ให้เสร็จจากคำสั่งลัดหรือ Siri"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kestirmeler veya Siri ile bir Lorvex alışkanlığını tamamlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виконує звичку Lorvex зі «Швидких команд» або Siri."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شارٹ کٹس یا Siri سے Lorvex عادت مکمل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoàn thành một thói quen Lorvex từ Phím tắt hoặc Siri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“快捷指令”或 Siri 完成一个 Lorvex 习惯。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過捷徑或 Siri 完成 Lorvex 習慣。"
          }
        }
      }
    },
