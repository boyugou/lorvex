            "state": "translated",
            "value": "Choose which occurrences to update."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué repeticiones actualizar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انتخاب کنید کدام تکرارها به‌روزرسانی شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les occurrences à mettre à jour."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור אילו מופעים לעדכן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि कौन-से इवेंट अपडेट करने हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih kejadian yang akan diperbarui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quali occorrenze aggiornare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新するイベントの範囲を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트할 범위를 선택하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोणते इव्हेंट अपडेट करायचे ते निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih kejadian yang hendak dikemas kini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies welke herhalingen je wilt bijwerken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, które wystąpienia zaktualizować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quais ocorrências atualizar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți ce apariții doriți să actualizați."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, какие повторения обновить."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எந்த நேர்வுகளைப் புதுப்பிக்க வேண்டும் என்பதைத் தேர்வுசெய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏ సందర్భాలను అప్‌డేట్ చేయాలో ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกกิจกรรมที่ต้องการอัปเดต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncellenecek etkinlikleri seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть, які повторення оновити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب کریں کہ کون سی تکرارات اپ ڈیٹ کی جائیں۔"
          }
        },
        "vi": {
