            "value": "একটি Lorvex অভ্যাসের রিমাইন্ডারগুলির মধ্যে একটি ডিলিট করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht eine der Erinnerungen einer Lorvex-Gewohnheit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράψτε μία από τις υπομνήσεις μιας συνήθειας Lorvex."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete one of a Lorvex habit’s reminders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina uno de los recordatorios de un hábito de Lorvex."
          }
        },
