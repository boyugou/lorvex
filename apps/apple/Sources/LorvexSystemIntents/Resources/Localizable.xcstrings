        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita un recordatorio de una tarea de Lorvex."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برداشتن یک یادآور از یک کار Lorvex."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime un rappel d’une tâche de Lorvex."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסרת תזכורת אחת ממשימה ב-Lorvex."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex कार्य से एक रिमाइंडर हटाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus satu pengingat dari tugas Lorvex."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove un promemoria da un’attività di Lorvex."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexのタスクからリマインダーを1つ削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 할 일에서 알림을 하나 제거합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एका Lorvex कार्यातून एक रिमाइंडर काढून टाका."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memadamkan satu peringatan daripada tugas Lorvex."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert één herinnering uit een Lorvex-taak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa jedno przypomnienie z zadania Lorvex."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove um lembrete de uma tarefa do Lorvex."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimină un memento dintr-o sarcină Lorvex."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет одно напоминание из задачи Lorvex."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex பணியில் இருந்து ஒரு நினைவூட்டலை அகற்றவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex టాస్క్ నుండి ఒక రిమైండర్‌ను తొలగించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอาเตือนความจำหนึ่งรายการออกจากงาน Lorvex"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Lorvex görevinden bir anımsatıcıyı kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаляє одне нагадування із завдання Lorvex."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی Lorvex کام سے ایک یاد دہانی ہٹائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa một lời nhắc khỏi nhiệm vụ Lorvex."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从一个 Lorvex 任务移除一个提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從 Lorvex 任務移除一個提醒。"
          }
        }
      }
    },
