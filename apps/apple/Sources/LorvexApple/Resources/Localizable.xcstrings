    "tasks.empty.search_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مهام تطابق بحثك. جرّب كلمات مختلفة أو امسح البحث."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No tasks match your search. Try different words or clear the search."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna tarea coincide con tu búsqueda. Prueba con otras palabras o borra la búsqueda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune tâche ne correspond à votre recherche. Essayez d’autres mots ou effacez la recherche."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी खोज से कोई कार्य मेल नहीं खाता। दूसरे शब्द आज़माएँ या खोज साफ़ करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
