          "stringUnit": {
            "state": "translated",
            "value": "יש להוסיף תאריך תכנון לפני הוספת המשימה ללוח השנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस कार्य को कैलेंडर में जोड़ने से पहले प्लान की तारीख़ जोड़ें।"
