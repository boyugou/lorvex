    "settings.diagnostics.reseed_required.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت مزامنة بعض السجلات وقد تحتاج إلى إعادة مزامنة كاملة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছু রেকর্ড সিঙ্ক করা যায়নি, তাই পুরো রি-সিঙ্ক দরকার হতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Datensätze konnten nicht synchronisiert werden und erfordern möglicherweise eine vollständige erneute Synchronisierung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορισμένες εγγραφές δεν μπόρεσαν να συγχρονιστούν και ίσως χρειάζεται πλήρης επανασυγχρονισμός."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some records could not be synced and may need a full re-sync."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos registros no se pudieron sincronizar y puede que haga falta una resincronización completa."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همگام‌سازی برخی رکوردها انجام نشد و ممکن است به همگام‌سازی کامل مجدد نیاز باشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains enregistrements n’ont pas pu être synchronisés et pourraient nécessiter une resynchronisation complète."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לסנכרן חלק מהרשומות, ייתכן שיידרש סנכרון מלא מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ रिकॉर्ड सिंक नहीं हो सके और उनके लिए पूरा री-सिंक ज़रूरी हो सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa rekaman tidak dapat diselaraskan dan mungkin memerlukan penyelarasan ulang penuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni record non sono stati sincronizzati e potrebbero richiedere una risincronizzazione completa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のレコードを同期できませんでした。完全な再同期が必要になる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 항목을 동기화하지 못했으며 전체 재동기화가 필요할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काही रेकॉर्ड सिंक करता आले नाहीत आणि पूर्ण री-सिंक आवश्यक असू शकते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesetengah rekod tidak dapat diselaraskan dan mungkin memerlukan penyelarasan semula sepenuhnya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige records konden niet worden gesynchroniseerd en vereisen mogelijk een volledige hersynchronisatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektórych rekordów nie udało się zsynchronizować i może być konieczna pełna ponowna synchronizacja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns registros não puderam ser sincronizados e podem exigir uma nova sincronização completa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Unele înregistrări nu au putut fi sincronizate și ar putea necesita o resincronizare completă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые записи не удалось синхронизировать, и может потребоваться полная повторная синхронизация."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சில பதிவுகளை ஒத்திசைக்க முடியவில்லை; முழு மறு-ஒத்திசைவு தேவைப்படலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొన్ని రికార్డ్‌లను సింక్ చేయడం వీలుపడలేదు, పూర్తి రీ-సింక్ అవసరం కావచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลบางรายการเชื่อมข้อมูลไม่ได้ และอาจต้องเชื่อมข้อมูลใหม่ทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı kayıtlar eşzamanlanamadı ve tam bir yeniden eşzamanlama gerekebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деякі записи не вдалося синхронізувати, і може знадобитися повна повторна синхронізація."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کچھ ریکارڈز سنک نہیں ہو سکے اور ہو سکتا ہے مکمل ری سنک کی ضرورت ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số bản ghi không thể đồng bộ hóa và có thể cần đồng bộ hóa lại toàn bộ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
