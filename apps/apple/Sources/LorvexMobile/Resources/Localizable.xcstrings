            "value": "Votre journée au même endroit"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका दिन, एक ही जगह"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua giornata in un unico posto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日のすべてを1か所に"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루를 한곳에서"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój dzień w jednym miejscu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu dia em um só lugar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш день в одном месте"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш день в одному місці"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一天尽在一处"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的一天，集中在一處"
          }
        }
      }
    },
    "setup.welcome.today.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما هو مخطط له أو مستحق أو بدأ العمل عليه اليوم، في قائمة واحدة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What’s planned, due, or started today, in one list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo planificado, lo que vence y lo que ya empezaste hoy, en una sola lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui est planifié, à échéance ou commencé aujourd’hui, dans une seule liste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज क्या प्लान है, क्या नियत है और क्या शुरू हुआ है, सब एक सूची में।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che è pianificato, in scadenza o iniziato oggi, in un’unica lista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日予定されているもの、期限のもの、開始したものを、1つのリストにまとめます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 계획되었거나 기한이 되었거나 시작한 일을 하나의 목록에 모아 보여 줍니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadania zaplanowane na dziś, z terminem na dziś lub już rozpoczęte — na jednej liście."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que está planejado, com prazo ou iniciado hoje, em uma só lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задачи, запланированные на сегодня, со сроком сегодня или уже начатые, — в одном списке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завдання, заплановані на сьогодні, з терміном на сьогодні або вже розпочаті, — в одному списку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天计划做的、到期的和已开始的事，都在一个列表里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天安排好的、到期的或已開始的任務，全都集中在一份清單裡。"
          }
        }
      }
    },
    "setup.welcome.control.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لك الكلمة الأخيرة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have the last word"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú tienes la última palabra"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez le dernier mot"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आख़िरी फ़ैसला आपका"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ultima parola è tua"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終判断はあなたに"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최종 결정은 직접 하세요"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnie słowo należy do ciebie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A palavra final é sua"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последнее слово за вами"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Останнє слово за вами"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最终由你决定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最後由你決定"
          }
        }
      }
    },
    "setup.welcome.control.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقترح مساعدك ويخطط، وأنت تقرر ما يبقى في قائمتك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your assistant suggests and plans; you decide what stays on your list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu asistente sugiere y planifica; tú decides qué se queda en tu lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre assistant suggère et planifie ; c’est vous qui décidez de ce qui reste dans votre liste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका असिस्टेंट सुझाव देता है और प्लान करता है; आपकी सूची में क्या रहे, यह आप तय करते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo assistente suggerisce e pianifica; sei tu a decidere cosa resta nella tua lista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "提案と計画はアシスタントが行い、リストに残すものはあなたが決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어시스턴트가 제안하고 계획하며, 목록에 무엇을 남길지는 직접 결정합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Asystent proponuje i planuje, a ty decydujesz, co zostanie na liście."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu assistente sugere e planeja; você decide o que fica na sua lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ассистент предлагает и планирует, а вы решаете, что останется в списке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Асистент пропонує й планує, а ви вирішуєте, що залишиться в списку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手负责建议和规划，清单上留下什么由你决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "助理負責建議與規劃，要留下哪些任務由你決定。"
          }
        }
      }
    },
    "setup.sync.devices.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء متطابق على جميع أجهزتك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same on every device"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo mismo en todos tus dispositivos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Identique sur chaque appareil"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर डिवाइस पर एक जैसा"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uguale su ogni dispositivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのデバイスでも同じ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기기에서 동일하게"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To samo na każdym urządzeniu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Igual em todos os dispositivos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно и то же на всех устройствах"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Те саме на всіх пристроях"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有设备保持一致"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每台裝置都一致"
          }
        }
      }
    },
    "setup.sync.devices.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى مهامك وقوائمك وعاداتك متطابقة على iPhone وiPad وMac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tasks, lists, and habits stay in step on iPhone, iPad, and Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus tareas, listas y hábitos se mantienen al día en el iPhone, el iPad y el Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos tâches, listes et habitudes restent synchronisées sur iPhone, iPad et Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके कार्य, सूचियाँ और आदतें iPhone, iPad और Mac पर एक साथ अपडेट रहती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue attività, liste e abitudini restano allineate su iPhone, iPad e Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスク、リスト、習慣は、iPhone、iPad、Macで同じ状態に保たれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일, 목록, 습관이 iPhone, iPad, Mac에서 항상 동일하게 유지됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadania, listy i nawyki są takie same na iPhonie, iPadzie i Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas tarefas, listas e hábitos ficam em sincronia no iPhone, no iPad e no Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задачи, списки и привычки совпадают на iPhone, iPad и Mac."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завдання, списки й звички збігаються на iPhone, iPad та Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务、列表和习惯在 iPhone、iPad 和 Mac 上同步更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的任務、清單和習慣會在 iPhone、iPad 和 Mac 上保持同步。"
          }
        }
      }
    },
    "setup.sync.private.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خاصة بك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private to you"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para ti"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Privé, rien que pour vous"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ आपके लिए"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Privato, solo tuo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなただけのもの"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나만의 공간"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko dla ciebie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Privado, só seu"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только для вас"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише для вас"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只属于你"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只屬於你"
          }
        }
      }
    },
    "setup.sync.private.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُخزَّن مشفّرة في حساب iCloud الخاص بك. ليس لدى Lorvex خادم خاص به."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored encrypted in your own iCloud account. Lorvex has no server of its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guardan cifrados en tu propia cuenta de iCloud. Lorvex no tiene servidor propio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données sont chiffrées dans votre propre compte iCloud. Lorvex n’a pas de serveur propre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके अपने iCloud खाते में एन्क्रिप्टेड रूप में सहेजा जाता है। Lorvex का अपना कोई सर्वर नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati sono archiviati con crittografia nel tuo account iCloud. Lorvex non ha un server proprio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなた自身のiCloudアカウントに暗号化して保存されます。Lorvexには独自のサーバはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 본인의 iCloud 계정에 암호화되어 저장됩니다. Lorvex에는 자체 서버가 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane są przechowywane w postaci zaszyfrowanej na twoim koncie iCloud. Lorvex nie ma własnego serwera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dados ficam armazenados com criptografia na sua própria conta do iCloud. O Lorvex não tem servidor próprio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранится в зашифрованном виде в вашей учётной записи iCloud. У Lorvex нет собственного сервера."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігається в зашифрованому вигляді у вашому обліковому записі iCloud. У Lorvex немає власного сервера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加密保存在你自己的 iCloud 账户中。Lorvex 没有自己的服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料會加密儲存在你自己的 iCloud 帳號中。Lorvex 沒有自己的伺服器。"
          }
        }
      }
    },
    "setup.sync.off.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقفها متى شئت"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off whenever you like"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactívala cuando quieras"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivable à tout moment"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब चाहें बंद करें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivabile quando vuoi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつでもオフにできる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언제든 끌 수 있습니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłączysz, kiedy zechcesz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative quando quiser"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключайте, когда захотите"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимикайте, коли захочете"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时可以关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨時都能關閉"
          }
        }
      }
    },
    "setup.sync.off.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقف المزامنة في أي وقت من الإعدادات. تبقى بياناتك على هذا الجهاز."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn syncing off anytime in Settings. Your data stays on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva la sincronización cuando quieras en Ajustes. Tus datos se quedan en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez la synchronisation à tout moment dans Réglages. Vos données restent sur cet appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्ज़ में कभी भी सिंक बंद करें। आपका डेटा इसी डिवाइस पर रहेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva la sincronizzazione in qualsiasi momento in Impostazioni. I tuoi dati restano su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期は「設定」でいつでもオフにできます。データはこのデバイスに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 언제든 동기화를 끌 수 있습니다. 데이터는 이 기기에 그대로 남습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizację możesz wyłączyć w dowolnym momencie w ustawieniach. Twoje dane pozostaną na tym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative a sincronização a qualquer momento em Ajustes. Seus dados ficam neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключить синхронизацию можно в любой момент в настройках. Ваши данные останутся на этом устройстве."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкнути синхронізацію можна будь-коли в параметрах. Ваші дані залишаться на цьому пристрої."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时可以在设置中关闭同步，数据仍保留在这台设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以隨時在「設定」中關閉同步，資料會留在此裝置上。"
          }
        }
      }
    },
    "setup.notifications.due.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذكيرات في موعدها"
