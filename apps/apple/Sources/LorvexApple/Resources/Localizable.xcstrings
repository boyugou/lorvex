    "tasks.empty.list_description": {
      "comment": "Empty state of a list scope in Tasks; points at the quick-add row above.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب مهمة في الحقل أعلاه لإضافتها إلى هذه القائمة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type a task in the field above to add it to this list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe una tarea en el campo de arriba para añadirla a esta lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une tâche dans le champ ci-dessus pour l’ajouter à cette liste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस सूची में जोड़ने के लिए ऊपर के फ़ील्ड में कार्य लिखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi un’attività nel campo qui sopra per aggiungerla a questa lista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上の入力欄にタスクを入力すると、このリストに追加されます。"
