    "today.schedule.suggest.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوزّع مهام اليوم على أوقاتك الحرة، حول أحداث تقويمك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যালেন্ডারের ইভেন্ট বাদ দিয়ে আপনার ফাঁকা সময়ে আজকের টাস্ক বসিয়ে দেয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt die heutigen Aufgaben in deine freie Zeit – rund um deinen Kalender."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τοποθετεί τις εργασίες της ημέρας στον ελεύθερο χρόνο σας, γύρω από το ημερολόγιό σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lays today’s tasks into your free time, around your calendar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acomoda las tareas de hoy en tu tiempo libre, respetando tu calendario."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارهای امروز را در زمان آزاد شما، با در نظر گرفتن تقویم‌تان می‌چیند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répartit les tâches du jour dans votre temps libre, en tenant compte de votre calendrier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסדר את משימות היום בזמן הפנוי שלך, תוך התחשבות בלוח השנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज के कार्यों को आपके कैलेंडर के आसपास, आपके खाली समय में बिठाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menempatkan tugas hari ini pada waktu kosong, di sela-sela acara kalender."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispone le attività di oggi nel tuo tempo libero, tenendo conto del tuo calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーの予定を避けて、今日のタスクを空き時間に配置します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 일정을 피해 오늘의 할 일을 빈 시간에 배치합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या दिनदर्शिकेचा विचार करून आजची कार्ये तुमच्या मोकळ्या वेळेत ठेवते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyusun tugas hari ini ke dalam masa lapang, di sekitar peristiwa kalendar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plant de taken van vandaag in je vrije tijd, rond je agenda."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozmieszcza dzisiejsze zadania w wolnym czasie, z uwzględnieniem twojego kalendarza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribui as tarefas de hoje no seu tempo livre, respeitando o seu calendário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Plasează sarcinile de astăzi în timpul liber, în jurul calendarului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распределяет сегодняшние задачи по свободному времени с учётом вашего календаря."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางงานของวันนี้ลงในเวลาว่างของคุณ โดยเลี่ยงช่วงที่มีนัดในปฏิทิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünün görevlerini, takviminizi gözeterek boş zamanınıza yerleştirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розподіляє сьогоднішні завдання за вільним часом з огляду на ваш календар."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج کے کاموں کو آپ کے خالی وقت میں، کیلنڈر کو مدنظر رکھتے ہوئے ترتیب دیتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xếp nhiệm vụ hôm nay vào thời gian trống, tránh các sự kiện trong lịch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把今天的任务排进空闲时间，避开日历上的安排。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "避開行事曆上的事件，把今天的任務安排進你的空閒時間。"
          }
        }
      }
    },
    "today.schedule.suggest.help_hours": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوزّع مهام اليوم على أوقاتك الحرة (%@)، حول أحداث تقويمك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যালেন্ডারের ইভেন্ট বাদ দিয়ে আপনার ফাঁকা সময়ে (%@) আজকের টাস্ক বসিয়ে দেয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt die heutigen Aufgaben in deine freie Zeit (%@) – rund um deinen Kalender."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τοποθετεί τις εργασίες της ημέρας στον ελεύθερο χρόνο σας (%@), γύρω από το ημερολόγιό σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lays today’s tasks into your free time (%@), around your calendar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acomoda las tareas de hoy en tu tiempo libre (%@), respetando tu calendario."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارهای امروز را در زمان آزاد شما (%@)، با در نظر گرفتن تقویم‌تان می‌چیند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répartit les tâches du jour dans votre temps libre (%@), en tenant compte de votre calendrier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסדר את משימות היום בזמן הפנוי שלך (%@), תוך התחשבות בלוח השנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज के कार्यों को आपके कैलेंडर के आसपास, आपके खाली समय (%@) में बिठाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menempatkan tugas hari ini pada waktu kosong (%@), di sela-sela acara kalender."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispone le attività di oggi nel tuo tempo libero (%@), tenendo conto del tuo calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーの予定を避けて、今日のタスクを空き時間（%@）に配置します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 일정을 피해 오늘의 할 일을 빈 시간(%@)에 배치합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या दिनदर्शिकेचा विचार करून आजची कार्ये तुमच्या मोकळ्या वेळेत (%@) ठेवते."
          }
        },
        "ms": {
