    "settings.calendar.access.off_detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتم قراءة أي أحداث تقويم في Lorvex."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No calendar events are read into Lorvex."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex no lee ningún evento de calendario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun événement du calendrier n’est lu dans Lorvex."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई कैलेंडर इवेंट Lorvex में नहीं पढ़ा जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun evento del calendario viene letto in Lorvex."
          }
        },
        "ja": {
