    "system.status.overview.read.description": {
      "comment": "Description for the Read Lorvex Overview App Intent, which says how many tasks are open and names the most important ones",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستماع إلى عدد المهام غير المكتملة وأي المهام تأتي أولًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কতগুলি টাস্ক বাকি আছে এবং কোনগুলি আগে আসে তা শুনুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest vor, wie viele Aufgaben offen sind und welche zuerst anstehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακούστε πόσες εργασίες είναι ανοιχτές και ποιες έχουν προτεραιότητα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hear how many tasks are open and which come first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dice en voz alta cuántas tareas están pendientes y cuáles van primero."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شنیدن تعداد کارهای باز و کارهایی که اول انجام می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annonce à voix haute combien de tâches sont à faire et lesquelles passent en premier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמיעת מספר המשימות הפתוחות ואילו מהן בראש הרשימה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुनें कि कितने कार्य लंबित हैं और कौन-से कार्य पहले आते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengarkan berapa banyak tugas yang belum selesai dan mana yang didahulukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuncia ad alta voce quante attività sono da fare e quali vengono prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未完了のタスクの件数と、先に取り組むタスクを読み上げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미완료 할 일의 개수와 먼저 처리할 할 일을 들려줍니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "किती कार्ये प्रलंबित आहेत आणि कोणती आधी येतात ते ऐका."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengar berapa banyak tugas yang belum selesai dan yang manakah didahulukan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat horen hoeveel taken er open zijn en welke als eerste aan de beurt zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytuje na głos, ile zadań jest do zrobienia i które są pierwsze w kolejności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informa em voz alta quantas tarefas estão pendentes e quais vêm primeiro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spune câte sarcini sunt de făcut și care sunt primele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Озвучивает, сколько задач не выполнено и какие идут первыми."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எத்தனை பணிகள் நிலுவையில் உள்ளன, எவை முதலில் வருகின்றன என்பதைக் கேட்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎన్ని టాస్క్‌లు పెండింగ్‌లో ఉన్నాయో, ఏవి ముందు వస్తాయో వినండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟังว่ามีงานที่ยังไม่เสร็จกี่รายการและงานใดมาก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaç görevin açık olduğunu ve hangilerinin önce geldiğini dinleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Озвучує, скільки завдань не виконано і які йдуть першими."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سنیں کہ کتنے کام نامکمل ہیں اور کون سے پہلے آتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nghe có bao nhiêu nhiệm vụ chưa hoàn thành và nhiệm vụ nào đứng đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音播报未完成任务的数量，以及排在最前面的任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音播報未完成任務的數量，以及排在最前面的任務。"
          }
