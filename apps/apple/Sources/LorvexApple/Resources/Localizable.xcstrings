    "calendar.all_day.more.a11y": {
      "comment": "VoiceOver label of the overflow chip in a day's all-day row. Argument: how many all-day items it hides.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld عناصر أخرى طوال اليوم"
                }
              },
              "many": {
