        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ की दैनिक समीक्षा अपडेट की गई।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinjauan harian untuk %@ diperbarui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisione giornaliera aggiornata per il %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の毎日の振り返りを更新しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 일일 회고를 업데이트했습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ रोजीचा दैनिक आढावा अपडेट केला."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
