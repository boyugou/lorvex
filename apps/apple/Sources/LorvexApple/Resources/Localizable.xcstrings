    "task_detail.metadata.available_from_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مخفية من قوائمك حتى هذا اليوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই দিন পর্যন্ত আপনার তালিকা থেকে লুকানো থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu diesem Tag in deinen Listen ausgeblendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρυμμένη από τις λίστες σας μέχρι την επιλεγμένη ημέρα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden from your lists until this day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta en tus listas hasta este día."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تا این روز از فهرست‌های شما پنهان می‌ماند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquée de vos listes jusqu’à ce jour."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוסתרת מהרשימות שלך עד יום זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस दिन तक आपकी सूचियों में छिपा रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disembunyikan dari daftar hingga tanggal ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascosta dalle tue liste fino a questo giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日まで、リストには表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 날짜가 될 때까지 목록에 표시되지 않습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या दिवसापर्यंत तुमच्या याद्यांमधून लपवलेले राहते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Disembunyikan daripada senarai sehingga tarikh ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot deze dag verborgen in je lijsten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukryte na twoich listach do tego dnia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta das suas listas até este dia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarcina rămâne ascunsă din liste până în această zi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрыта из ваших списков до этого дня."
          }
        },
