            "value": "Opnieuw uploaden en hervatten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prześlij ponownie i wznów"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reenviar e retomar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reîncărcați și continuați"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправить заново и возобновить"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீண்டும் பதிவேற்றித் தொடர்க"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మళ్ళీ అప్‌లోడ్ చేసి, కొనసాగించండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปโหลดอีกครั้งและทำต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden yükle ve sürdür"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надіслати знову й відновити"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دوبارہ اپ لوڈ اور بحال کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải lên lại và tiếp tục"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新上传并恢复"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新上傳並繼續"
          }
        }
      }
    },
    "settings.sync.resume.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيرفع Lorvex البيانات المخزنة على هذا الجهاز إلى حساب iCloud المسجَّل الدخول إليه حاليًا ويستأنف المزامنة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইসে সংরক্ষিত ডেটা Lorvex বর্তমানে সাইন ইন করা iCloud অ্যাকাউন্টে আপলোড করবে এবং সিঙ্ক আবার চালু করবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex lädt die auf diesem Gerät gespeicherten Daten in den aktuell angemeldeten iCloud-Account hoch und setzt die Synchronisierung fort."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Lorvex θα μεταφορτώσει τα δεδομένα που είναι αποθηκευμένα σε αυτήν τη συσκευή στον λογαριασμό iCloud με τον οποίο έχετε συνδεθεί αυτήν τη στιγμή και θα συνεχίσει τον συγχρονισμό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex will upload the data stored on this device to the currently signed-in iCloud account and resume syncing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex subirá los datos guardados en este dispositivo a la cuenta de iCloud con la sesión iniciada y reanudará la sincronización."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه Lorvex داده‌های ذخیره‌شده در این دستگاه را در حساب iCloud واردشده فعلی بارگذاری و همگام‌سازی را از سر می‌گیرد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex enverra les données stockées sur cet appareil vers le compte iCloud actuellement connecté et reprendra la synchronisation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הנתונים השמורים במכשיר הזה יועלו לחשבון ה-iCloud המחובר כעת והסנכרון יתחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex इस डिवाइस पर रखा डेटा अभी साइन इन किए हुए iCloud खाते में अपलोड करेगा और सिंक फिर शुरू करेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex akan mengunggah data yang tersimpan di perangkat ini ke akun iCloud yang saat ini masuk, lalu melanjutkan penyelarasan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex caricherà i dati archiviati su questo dispositivo nell’account iCloud attualmente connesso e riprenderà la sincronizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスに保存されているデータを、現在サインインしているiCloudアカウントにアップロードし、同期を再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 저장된 데이터를 현재 로그인한 iCloud 계정에 업로드하고 동기화를 재개합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या डिव्हाइसवर साठवलेला डेटा Lorvex सध्या साइन इन केलेल्या iCloud अकाउंटवर अपलोड करेल आणि सिंक पुन्हा सुरू करेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex akan memuat naik data yang disimpan pada peranti ini ke akaun iCloud yang sedang didaftar masuk, kemudian meneruskan penyelarasan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex uploadt de op dit apparaat opgeslagen gegevens naar het momenteel ingelogde iCloud-account en hervat de synchronisatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex prześle dane przechowywane na tym urządzeniu na aktualnie zalogowane konto iCloud i wznowi synchronizację."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lorvex enviará os dados armazenados neste dispositivo para a conta do iCloud conectada no momento e retomará a sincronização."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex va încărca datele stocate pe acest dispozitiv în contul iCloud conectat în prezent și va relua sincronizarea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex загрузит данные, хранящиеся на этом устройстве, в учётную запись iCloud, в которую сейчас выполнен вход, и возобновит синхронизацию."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சாதனத்தில் சேமிக்கப்பட்டுள்ள தரவை, தற்போது உள்நுழைந்துள்ள iCloud கணக்கில் Lorvex பதிவேற்றி, ஒத்திசைவைத் தொடரும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ డివైజ్‌లో నిల్వ ఉన్న డేటాను ప్రస్తుతం సైన్ ఇన్ చేసిన iCloud ఖాతాకు Lorvex అప్‌లోడ్ చేసి, సింక్‌ను తిరిగి ప్రారంభిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex จะอัปโหลดข้อมูลที่จัดเก็บบนอุปกรณ์เครื่องนี้ไปยังบัญชี iCloud ที่ลงชื่อเข้าอยู่ในขณะนี้ แล้วเชื่อมข้อมูลต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex, bu aygıtta saklanan verileri şu anda giriş yapılmış iCloud hesabına yükleyecek ve eşzamanlamayı sürdürecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex завантажить дані, що зберігаються на цьому пристрої, в обліковий запис iCloud, в який зараз виконано вхід, і відновить синхронізацію."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ڈیوائس پر محفوظ ڈیٹا کو Lorvex موجودہ سائن اِن iCloud اکاؤنٹ میں اپ لوڈ کرے گا اور سنک دوبارہ شروع کر دے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex sẽ tải dữ liệu lưu trên thiết bị này lên tài khoản iCloud đang đăng nhập và tiếp tục đồng bộ hóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 会将此设备上存储的数据上传到当前登录的 iCloud 账户，并恢复同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 會將此裝置上儲存的資料上傳到目前登入的 iCloud 帳號，並繼續同步。"
          }
        }
      }
    },
    "settings.sync.resume.confirm.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد إعادة رفع بيانات هذا الجهاز واستئناف المزامنة؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইসের ডেটা আবার আপলোড করে সিঙ্ক চালু করবেন?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten dieses Geräts erneut hochladen und Synchronisierung fortsetzen?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Να γίνει επαναμεταφόρτωση των δεδομένων αυτής της συσκευής και συνέχιση του συγχρονισμού;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-upload this device’s data and resume sync?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Volver a subir los datos de este dispositivo y reanudar la sincronización?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "داده‌های این دستگاه دوباره بارگذاری و همگام‌سازی ازسر گرفته شود؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renvoyer les données de cet appareil et reprendre la synchronisation ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להעלות מחדש את נתוני המכשיר הזה ולחדש את הסנכרון?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस का डेटा दोबारा अपलोड करें और सिंक फिर शुरू करें?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unggah ulang data perangkat ini dan lanjutkan penyelarasan?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricaricare i dati di questo dispositivo e riprendere la sincronizzazione?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスのデータを再アップロードして、同期を再開しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 데이터를 다시 업로드하고 동기화를 재개하시겠습니까?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या डिव्हाइसचा डेटा पुन्हा अपलोड करून सिंक सुरू करायचे का?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat naik semula data peranti ini dan teruskan penyelarasan?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gegevens van dit apparaat opnieuw uploaden en synchronisatie hervatten?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesłać ponownie dane z tego urządzenia i wznowić synchronizację?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reenviar os dados deste dispositivo e retomar a sincronização?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reîncărcați datele acestui dispozitiv și continuați sincronizarea?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправить данные этого устройства заново и возобновить синхронизацию?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சாதனத் தரவை மீண்டும் பதிவேற்றி, ஒத்திசைவைத் தொடரவா?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ డివైజ్ డేటాను మళ్ళీ అప్‌లోడ్ చేసి, సింక్‌ను కొనసాగించాలా?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปโหลดข้อมูลของอุปกรณ์เครื่องนี้อีกครั้งและเชื่อมข้อมูลต่อหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aygıtın verileri yeniden yüklensin ve eşzamanlama sürdürülsün mü?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надіслати дані цього пристрою знову й відновити синхронізацію?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ڈیوائس کا ڈیٹا دوبارہ اپ لوڈ کریں اور سنک بحال کریں؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải lên lại dữ liệu của thiết bị này và tiếp tục đồng bộ hóa?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要重新上传此设备的数据并恢复同步吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要重新上傳此裝置的資料並繼續同步嗎？"
          }
        }
      }
    },
