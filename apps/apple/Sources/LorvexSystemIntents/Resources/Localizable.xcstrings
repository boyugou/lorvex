          "stringUnit": {
            "state": "translated",
            "value": "مرور روزانه برای %@ به‌روزرسانی شد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilan quotidien mis à jour pour le %@."
