    "system.task.recurrence.exception.add.description": {
      "comment": "Description for the Add Lorvex Recurrence Exception App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تخطي تاريخ تكرار واحد لمهمة متكررة في Lorvex."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip one occurrence date for a recurring Lorvex task."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omite una fecha de repetición de una tarea recurrente de Lorvex."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignore une occurrence d’une tâche récurrente de Lorvex."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोहराए जाने वाले Lorvex कार्य की किसी एक तारीख़ को छोड़ें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta un’occorrenza di un’attività ricorrente di Lorvex."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "繰り返しのLorvexのタスクで、特定の日の1回分をスキップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반복되는 Lorvex 할 일에서 특정 날짜의 반복 하나를 건너뜁니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomija jedną datę w powtarzającym się zadaniu Lorvex."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignora uma ocorrência de uma tarefa recorrente do Lorvex."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропускает одну дату в повторяющейся задаче Lorvex."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропускає одну дату в повторюваному завданні Lorvex."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳过一个周期性 Lorvex 任务的某次发生日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "略過重複 Lorvex 任務中特定日期的一次。"
          }
        }
      }
    },
