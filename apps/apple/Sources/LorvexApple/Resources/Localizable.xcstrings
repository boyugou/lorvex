    "lists.empty.no_lists_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر ＋ لتجميع المهام المترابطة في قائمة، أو اطلب من مساعدك ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সম্পর্কিত টাস্ক একটি তালিকায় গুছিয়ে রাখতে ＋ ক্লিক করুন – অথবা আপনার অ্যাসিস্ট্যান্টকে বলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf ＋, um zusammengehörige Aufgaben in einer Liste zu bündeln – oder bitte deinen Assistenten darum."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάντε κλικ στο ＋ για να ομαδοποιήσετε σχετικές εργασίες σε μια λίστα ή ζητήστε το από τον βοηθό σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click ＋ to group related tasks into a list — or ask your assistant to."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en ＋ para agrupar tareas relacionadas en una lista, o pídeselo a tu asistente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای گروه‌بندی کارهای مرتبط در یک فهرست، روی ＋ کلیک کنید — یا از دستیار خود بخواهید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur ＋ pour regrouper des tâches liées dans une liste, ou demandez à votre assistant de le faire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש ללחוץ על ＋ כדי לקבץ משימות קשורות לרשימה — או לבקש זאת מהעוזר שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संबंधित कार्यों को सूची में समूहित करने के लिए ＋ पर क्लिक करें, या अपने असिस्टेंट से कहें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik ＋ untuk mengelompokkan tugas terkait ke dalam daftar – atau minta asisten untuk membuatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su ＋ per raggruppare attività correlate in una lista oppure chiedi al tuo assistente di farlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "＋をクリックして、関連するタスクをリストにまとめましょう。アシスタントに頼むこともできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "＋ 버튼을 클릭하여 관련 있는 할 일을 목록으로 묶어 보세요. 어시스턴트에게 부탁할 수도 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "संबंधित कार्ये एका यादीत एकत्र करण्यासाठी ＋ क्लिक करा – किंवा तुमच्या सहाय्यकाला सांगा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik ＋ untuk mengumpulkan tugas berkaitan ke dalam senarai – atau minta pembantu AI melakukannya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op ＋ om gerelateerde taken in een lijst te groeperen – of vraag het je assistent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij ＋, aby zgrupować powiązane zadania w listę — lub poproś o to asystenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em ＋ para agrupar tarefas relacionadas em uma lista ou peça ao seu assistente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Faceți clic pe ＋ pentru a grupa sarcinile înrudite într-o listă – sau cereți asta asistentului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите ＋, чтобы объединить связанные задачи в список, или попросите об этом ассистента."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடர்புடைய பணிகளை ஒரு பட்டியலில் குழுவாக்க ＋ கிளிக் செய்யவும் – அல்லது உங்கள் அசிஸ்டென்ட்டிடம் கேட்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సంబంధిత టాస్క్‌లను ఒక జాబితాలో గ్రూప్ చేయడానికి ＋ క్లిక్ చేయండి – లేదా మీ అసిస్టెంట్‌ను అడగండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิก ＋ เพื่อจัดกลุ่มงานที่เกี่ยวข้องเป็นลิสต์ หรือให้ผู้ช่วยของคุณทำให้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlgili görevleri bir listede toplamak için ＋ düğmesini tıklayın veya asistanınızdan isteyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть ＋, щоб об’єднати пов’язані завдання в список, або попросіть про це асистента."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "متعلقہ کاموں کو فہرست میں جمع کرنے کے لیے ＋ پر کلک کریں — یا اپنے اسسٹنٹ سے کہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm ＋ để nhóm các nhiệm vụ liên quan vào một danh sách – hoặc nhờ trợ lý làm giúp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按 ＋ 把相关任务归入一个列表，或让助手代劳。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下 ＋ 將相關任務整理成清單，或請助理代勞。"
          }
        }
      }
    },
