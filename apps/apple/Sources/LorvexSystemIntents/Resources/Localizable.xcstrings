            "state": "translated",
            "value": "Lorvex आदत के आँकड़े पढ़ें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggi statistiche abitudine di Lorvex"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexの習慣の統計を読み取る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 습관 통계 읽기"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytaj statystyki nawyku Lorvex"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ler estatísticas de hábito do Lorvex"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитать статистику привычки Lorvex"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитати статистику звички Lorvex"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取 Lorvex 习惯统计"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取 Lorvex 習慣統計"
          }
        }
      }
