            "state": "translated",
            "value": "События календаря не считываются в Lorvex."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Події календаря не зчитуються в Lorvex."
          }
        },
        "zh-Hans": {
          "stringUnit": {
