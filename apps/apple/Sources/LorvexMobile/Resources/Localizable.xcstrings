    },
    "setup.done.capture.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط ＋ في أي تبويب لإضافة مهمة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap ＋ on any tab to add a task."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca ＋ en cualquier pestaña para añadir una tarea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez ＋ dans n’importe quel onglet pour ajouter une tâche."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्य जोड़ने के लिए किसी भी टैब पर ＋ पर टैप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca ＋ in qualsiasi scheda per aggiungere un’attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのタブでも＋をタップするとタスクを追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 탭에서든 ＋ 버튼을 탭하면 할 일을 추가할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij ＋ na dowolnej karcie, aby dodać zadanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em ＋ em qualquer aba para adicionar uma tarefa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь ＋ на любой вкладке, чтобы добавить задачу."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніть ＋ на будь-якій вкладці, щоб додати завдання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意标签页点按 ＋ 即可添加任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何分頁點一下 ＋ 即可新增任務。"
          }
        }
      }
    },
    "setup.done.assistant.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أو دع مساعدك يضيفها"
          }
        },
        "en": {
