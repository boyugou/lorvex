    "settings.cloud_sync.account.restricted_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تقييد iCloud بواسطة ملف تعريف إدارة الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডিভাইস ম্যানেজমেন্ট প্রোফাইল iCloud সীমিত করেছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ist durch ein Geräteverwaltungsprofil eingeschränkt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το iCloud περιορίζεται από ένα προφίλ διαχείρισης συσκευών."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is restricted by a device management profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud está restringido por un perfil de gestión de dispositivos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرویس iCloud توسط یک نمایه مدیریت دستگاه محدود شده است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud est restreint par un profil de gestion d’appareils."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגישה ל-iCloud הוגבלה על ידי פרופיל ניהול מכשירים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud पर डिवाइस मैनेजमेंट प्रोफ़ाइल द्वारा प्रतिबंध लगा है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud dibatasi oleh profil manajemen perangkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud è limitato da un profilo di gestione dei dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudはデバイス管理プロファイルによって制限されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 관리 프로파일에 의해 iCloud가 제한되어 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "डिव्हाइस व्यवस्थापन प्रोफाइलने iCloud निर्बंधित केले आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud dihadkan oleh profil pengurusan peranti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud wordt beperkt door een profiel voor apparaatbeheer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud jest ograniczony przez profil zarządzania urządzeniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iCloud está restrito por um perfil de gerenciamento de dispositivos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud este restricționat de un profil de gestionare a dispozitivelor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к iCloud ограничен профилем управления устройством."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ถูกจำกัดโดยโปรไฟล์การจัดการอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud, bir aygıt yönetimi profili tarafından kısıtlanıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до iCloud обмежено профілем керування пристроєм."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈیوائس مینجمنٹ پروفائل نے iCloud کو محدود کر رکھا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud bị giới hạn bởi hồ sơ quản lý thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 受到设备管理配置描述文件限制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 已受到裝置管理描述檔限制。"
          }
        }
      }
    },
