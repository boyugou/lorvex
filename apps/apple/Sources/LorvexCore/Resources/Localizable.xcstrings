    "error.reason.calendar_time_skipped": {
      "comment": "Alert shown when an event starts at a time the clocks skip on the day daylight saving time begins (for example 2:30 AM when clocks jump from 2:00 to 3:00).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الوقت غير موجود في ذلك اليوم لأن الساعات تتقدّم مع بدء التوقيت الصيفي. اختر وقتًا قبله أو بعده."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডেলাইট সেভিং টাইমের কারণে ঘড়ির কাঁটা এগিয়ে দেওয়া হয় বলে সেই দিনে এই সময়টি নেই। এর আগের বা পরের একটি সময় বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Uhrzeit gibt es an diesem Tag nicht, weil die Uhren für die Sommerzeit vorgestellt werden. Wähle eine frühere oder spätere Uhrzeit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η ώρα δεν υπάρχει εκείνη την ημέρα, επειδή τα ρολόγια πηγαίνουν μπροστά λόγω θερινής ώρας. Επιλέξτε νωρίτερη ή μεταγενέστερη ώρα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This time doesn’t exist on that day because the clocks move forward for daylight saving time. Pick an earlier or later time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta hora no existe ese día porque los relojes se adelantan por el horario de verano. Elige una hora anterior o posterior."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این ساعت در آن روز وجود ندارد، چون ساعت‌ها برای ساعت تابستانی جلو می‌روند. ساعتی زودتر یا دیرتر انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette heure n’existe pas ce jour-là, car les horloges avancent pour l’heure d’été. Choisissez une heure plus tôt ou plus tard."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השעה הזו לא קיימת ביום הזה, כי השעון מתקדם במעבר לשעון קיץ. יש לבחור שעה מוקדמת או מאוחרת יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस दिन यह समय मौजूद नहीं है, क्योंकि डेलाइट सेविंग टाइम के लिए घड़ियाँ आगे बढ़ जाती हैं। इससे पहले या बाद का समय चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu ini tidak ada pada hari tersebut karena jam dimajukan untuk waktu musim panas. Pilih waktu yang lebih awal atau lebih lambat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quest’ora non esiste in quel giorno perché gli orologi vanno avanti per l’ora legale. Scegli un orario precedente o successivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日は夏時間の開始で時計が進むため、この時刻は存在しません。前後の時刻を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이날은 서머타임 시작으로 시계가 앞당겨져 이 시간이 없습니다. 더 이르거나 늦은 시간을 선택하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "डेलाइट सेव्हिंग टाइममुळे त्या दिवशी घड्याळे पुढे केली जात असल्याने ही वेळ अस्तित्वात नाही. त्याआधीची किंवा नंतरची वेळ निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa ini tidak wujud pada hari tersebut kerana jam dimajukan untuk waktu jimat siang. Pilih masa yang lebih awal atau lebih lewat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit tijdstip bestaat niet op die dag omdat de klok voor de zomertijd vooruit wordt gezet. Kies een eerder of later tijdstip."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tego dnia nie ma takiej godziny, ponieważ zegary przestawia się do przodu na czas letni. Wybierz wcześniejszą lub późniejszą godzinę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este horário não existe nesse dia porque os relógios são adiantados para o horário de verão. Escolha um horário anterior ou posterior."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această oră nu există în ziua respectivă, deoarece ceasurile se mută înainte pentru ora de vară. Alegeți o oră mai devreme sau mai târziu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этот день такого времени нет: часы переводятся вперёд на летнее время. Выберите более раннее или более позднее время."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பகலொளி சேமிப்பு நேரத்தின்போது கடிகாரங்கள் முன்னோக்கி நகர்வதால் அந்த நாளில் இந்த நேரம் இல்லை. இதற்கு முன் அல்லது பின் உள்ள நேரத்தைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "డేలైట్ సేవింగ్ టైమ్ వల్ల గడియారాలు ముందుకు జరుగుతాయి, కాబట్టి ఆ రోజు ఈ సమయం ఉండదు. దీనికి ముందు లేదా తర్వాత ఉన్న సమయాన్ని ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีเวลานี้ในวันดังกล่าว เนื่องจากนาฬิกาเดินหน้าไปตามเวลาออมแสง เลือกเวลาที่เร็วกว่าหรือช้ากว่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatler yaz saati uygulaması nedeniyle ileri alındığı için bu saat o gün mevcut değil. Daha erken ya da daha geç bir saat seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цього дня такого часу немає: годинники переводять уперед на літній час. Виберіть раніший або пізніший час."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ وقت اس دن موجود نہیں کیونکہ ڈے لائٹ سیونگ ٹائم کے لیے گھڑیاں آگے بڑھ جاتی ہیں۔ پہلے یا بعد کا کوئی وقت منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giờ này không tồn tại vào ngày đó vì đồng hồ được chỉnh sớm lên cho giờ mùa hè. Hãy chọn giờ sớm hơn hoặc muộn hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一天因夏令时开始、时钟拨快，没有这个时间。请选一个更早或更晚的时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這一天因夏令時間開始、時鐘撥快，沒有這個時間。請選擇更早或更晚的時間。"
          }
        }
      }
    },
    "error.reason.canceling_advanced_repeat": {
      "comment": "Alert shown when a person cancels an occurrence of a repeating task whose next occurrence has already moved on.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه المهمة المتكررة انتقلت بالفعل إلى تكرارها التالي، لذا لا يمكن إلغاؤها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই পুনরাবৃত্ত টাস্কটি ইতিমধ্যেই পরবর্তী বারে চলে গেছে, তাই এটি বাতিল করা যাবে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese sich wiederholende Aufgabe ist bereits bei der nächsten Wiederholung angekommen und kann deshalb nicht abgebrochen werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η επαναλαμβανόμενη εργασία έχει ήδη περάσει στην επόμενη επανάληψή της, επομένως δεν μπορεί να ακυρωθεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This repeating task has already moved on to its next occurrence, so it can’t be cancelled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarea recurrente ya ha pasado a su siguiente repetición, así que no se puede cancelar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار تکرارشونده از قبل به تکرار بعدی خود رفته است، بنابراین نمی‌توان آن را لغو کرد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette tâche récurrente est déjà passée à son occurrence suivante et ne peut donc pas être annulée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשימה החוזרת הזו כבר עברה למופע הבא שלה, ולכן אי אפשר לבטל אותה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह दोहराया जाने वाला कार्य पहले ही अगली बार के लिए आगे बढ़ चुका है, इसलिए इसे रद्द नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas berulang ini sudah berlanjut ke kejadian berikutnya, sehingga tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa attività ricorrente è già passata alla sua occorrenza successiva, quindi non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この繰り返しタスクはすでに次回分に進んでいるため、キャンセルできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 반복 할 일은 이미 다음 반복으로 넘어갔기 때문에 취소할 수 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे पुनरावृत्ती होणारे कार्य आधीच पुढच्या वेळेकडे सरकले आहे, त्यामुळे ते रद्द करता येत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas berulang ini sudah beralih ke kejadian seterusnya, jadi tidak boleh dibatalkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze terugkerende taak is al doorgegaan naar de volgende herhaling en kan daarom niet worden geannuleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zadanie cykliczne przeszło już do kolejnego wystąpienia, więc nie można go anulować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarefa recorrente já passou para a próxima ocorrência, então não pode ser cancelada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această sarcină repetitivă a trecut deja la următoarea apariție, deci nu poate fi anulată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта повторяющаяся задача уже перешла к следующему повторению, поэтому её нельзя отменить."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீண்டும் நிகழும் இந்தப் பணி ஏற்கெனவே அடுத்த நேர்வுக்குச் சென்றுவிட்டது, எனவே அதை ரத்துசெய்ய முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పునరావృతమయ్యే ఈ టాస్క్ ఇప్పటికే తదుపరి సందర్భానికి వెళ్ళిపోయింది, కాబట్టి దాన్ని రద్దు చేయలేరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานทำประจำนี้ไปถึงครั้งถัดไปแล้ว จึงยกเลิกไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yinelenen görev zaten sonraki yinelemeye geçti, bu yüzden iptal edilemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це повторюване завдання вже перейшло до наступного повторення, тому його не можна скасувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ دہرایا جانے والا کام پہلے ہی اگلی تکرار پر جا چکا ہے، اس لیے اسے منسوخ نہیں کیا جا سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhiệm vụ lặp lại này đã chuyển sang lần lặp tiếp theo, nên không thể hủy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个重复任务已经进入下一次，所以无法取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個重複任務已經進入下一次，所以無法取消。"
          }
        }
      }
    },
    "error.reason.canceling_done_task": {
      "comment": "Alert shown when a person cancels a task that is already done.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه المهمة مكتملة بالفعل. أعِد فتحها قبل إلغائها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই টাস্কটি ইতিমধ্যেই সম্পন্ন হয়েছে। বাতিল করার আগে এটি আবার খুলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aufgabe ist bereits erledigt. Öffne sie wieder, bevor du sie abbrichst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η εργασία έχει ήδη ολοκληρωθεί. Ανοίξτε την ξανά πριν την ακυρώσετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This task is already done. Reopen it before you cancel it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarea ya está completada. Reábrela antes de cancelarla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار از قبل تکمیل شده است. پیش از لغو، آن را بازگشایی کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette tâche est déjà terminée. Rouvrez-la avant de l’annuler."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשימה הזו כבר הושלמה. יש לפתוח אותה מחדש לפני ביטולה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कार्य पहले ही पूरा हो चुका है। रद्द करने से पहले इसे फिर से खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas ini sudah selesai. Buka kembali sebelum membatalkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa attività è già completata. Riaprila prima di annullarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタスクはすでに完了しています。キャンセルする前に未完了に戻してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 할 일은 이미 완료되었습니다. 취소하려면 먼저 다시 여세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे कार्य आधीच पूर्ण झाले आहे. रद्द करण्यापूर्वी ते पुन्हा उघडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas ini sudah selesai. Buka semula tugas ini sebelum membatalkannya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze taak is al voltooid. Heropen de taak voordat je deze annuleert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zadanie jest już ukończone. Otwórz je ponownie, zanim je anulujesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarefa já foi concluída. Reabra-a antes de cancelá-la."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această sarcină este deja finalizată. Redeschideți-o înainte de a o anula."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта задача уже выполнена. Чтобы отменить её, сначала откройте её снова."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் பணி ஏற்கெனவே முடிந்துவிட்டது. ரத்துசெய்வதற்கு முன் அதை மீண்டும் திறக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ టాస్క్ ఇప్పటికే పూర్తయింది. రద్దు చేసే ముందు దాన్ని మళ్ళీ తెరవండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานนี้เสร็จแล้ว เปิดงานใหม่ก่อนยกเลิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu görev zaten tamamlandı. İptal etmeden önce yeniden açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це завдання вже виконано. Щоб скасувати його, спершу відкрийте його знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ کام پہلے ہی مکمل ہو چکا ہے۔ منسوخ کرنے سے پہلے اسے دوبارہ کھولیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhiệm vụ này đã xong. Hãy mở lại trước khi hủy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个任务已经完成，请先重新打开再取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個任務已經完成，請先重新開啟再取消。"
          }
        }
      }
    },
    "error.reason.completing_advanced_repeat": {
      "comment": "Alert shown when a person completes an occurrence of a repeating task again after its next occurrence has already moved on.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه المهمة المتكررة انتقلت بالفعل إلى تكرارها التالي، لذا لا يمكن إكمالها مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই পুনরাবৃত্ত টাস্কটি ইতিমধ্যেই পরবর্তী বারে চলে গেছে, তাই এটি আবার সম্পন্ন করা যাবে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese sich wiederholende Aufgabe ist bereits bei der nächsten Wiederholung angekommen und kann deshalb nicht noch einmal erledigt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η επαναλαμβανόμενη εργασία έχει ήδη περάσει στην επόμενη επανάληψή της, επομένως δεν μπορεί να ολοκληρωθεί ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This repeating task has already moved on to its next occurrence, so it can’t be completed again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarea recurrente ya ha pasado a su siguiente repetición, así que no se puede completar de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار تکرارشونده از قبل به تکرار بعدی خود رفته است، بنابراین نمی‌توان آن را دوباره تکمیل کرد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette tâche récurrente est déjà passée à son occurrence suivante et ne peut donc pas être terminée à nouveau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשימה החוזרת הזו כבר עברה למופע הבא שלה, ולכן אי אפשר להשלים אותה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह दोहराया जाने वाला कार्य पहले ही अगली बार के लिए आगे बढ़ चुका है, इसलिए इसे दोबारा पूरा नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas berulang ini sudah berlanjut ke kejadian berikutnya, sehingga tidak dapat diselesaikan lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa attività ricorrente è già passata alla sua occorrenza successiva, quindi non può essere completata di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この繰り返しタスクはすでに次回分に進んでいるため、もう一度完了にすることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 반복 할 일은 이미 다음 반복으로 넘어갔기 때문에 다시 완료할 수 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे पुनरावृत्ती होणारे कार्य आधीच पुढच्या वेळेकडे सरकले आहे, त्यामुळे ते पुन्हा पूर्ण करता येत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas berulang ini sudah beralih ke kejadian seterusnya, jadi tidak boleh diselesaikan lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze terugkerende taak is al doorgegaan naar de volgende herhaling en kan daarom niet nog een keer worden voltooid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zadanie cykliczne przeszło już do kolejnego wystąpienia, więc nie można go ukończyć ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarefa recorrente já passou para a próxima ocorrência, então não pode ser concluída novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această sarcină repetitivă a trecut deja la următoarea apariție, deci nu poate fi finalizată din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта повторяющаяся задача уже перешла к следующему повторению, поэтому её нельзя выполнить ещё раз."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீண்டும் நிகழும் இந்தப் பணி ஏற்கெனவே அடுத்த நேர்வுக்குச் சென்றுவிட்டது, எனவே அதை மீண்டும் முடிக்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పునరావృతమయ్యే ఈ టాస్క్ ఇప్పటికే తదుపరి సందర్భానికి వెళ్ళిపోయింది, కాబట్టి దాన్ని మళ్ళీ పూర్తి చేయలేరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานทำประจำนี้ไปถึงครั้งถัดไปแล้ว จึงทำให้เสร็จอีกครั้งไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yinelenen görev zaten sonraki yinelemeye geçti, bu yüzden yeniden tamamlanamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це повторюване завдання вже перейшло до наступного повторення, тому його не можна виконати ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ دہرایا جانے والا کام پہلے ہی اگلی تکرار پر جا چکا ہے، اس لیے اسے دوبارہ مکمل نہیں کیا جا سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhiệm vụ lặp lại này đã chuyển sang lần lặp tiếp theo, nên không thể hoàn thành lần nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个重复任务已经进入下一次，所以无法再次完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個重複任務已經進入下一次，所以無法再次完成。"
          }
        }
      }
    },
    "error.reason.completing_canceled_task": {
      "comment": "Alert shown when a person completes a task that was canceled, for example from a reminder's Complete button.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إلغاء هذه المهمة. أعِد فتحها قبل إكمالها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই টাস্কটি বাতিল করা হয়েছে। সম্পূর্ণ করার আগে এটি আবার খুলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aufgabe wurde abgebrochen. Öffne sie wieder, bevor du sie erledigst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η εργασία ακυρώθηκε. Ανοίξτε την ξανά πριν την ολοκληρώσετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This task was cancelled. Reopen it before completing it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarea se canceló. Reábrela antes de completarla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار لغو شده است. پیش از تکمیل، آن را بازگشایی کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette tâche a été annulée. Rouvrez-la avant de la terminer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשימה הזו בוטלה. יש לפתוח אותה מחדש לפני השלמתה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कार्य रद्द कर दिया गया है। पूरा करने से पहले इसे फिर से खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas ini telah dibatalkan. Buka kembali sebelum menyelesaikannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa attività è stata annullata. Riaprila prima di completarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタスクはキャンセルされています。完了にする前に未完了に戻してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 할 일은 취소되었습니다. 완료하려면 먼저 다시 여세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे कार्य रद्द केले होते. पूर्ण करण्यापूर्वी ते पुन्हा उघडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas ini telah dibatalkan. Buka semula tugas ini sebelum menyelesaikannya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze taak is geannuleerd. Heropen de taak voordat je deze voltooit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zadanie zostało anulowane. Otwórz je ponownie, zanim je ukończysz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarefa foi cancelada. Reabra-a antes de concluí-la."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această sarcină a fost anulată. Redeschideți-o înainte de a o finaliza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта задача отменена. Чтобы выполнить её, сначала откройте её снова."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் பணி ரத்துசெய்யப்பட்டது. நிறைவுசெய்வதற்கு முன் அதை மீண்டும் திறக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ టాస్క్ రద్దు చేయబడింది. పూర్తి చేసే ముందు దాన్ని మళ్ళీ తెరవండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานนี้ถูกยกเลิก เปิดงานใหม่ก่อนทำให้เสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu görev iptal edildi. Tamamlamadan önce yeniden açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це завдання скасовано. Щоб виконати його, спершу відкрийте його знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ کام منسوخ کر دیا گیا تھا۔ مکمل کرنے سے پہلے اسے دوبارہ کھولیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhiệm vụ này đã bị hủy. Hãy mở lại trước khi hoàn thành."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个任务已取消，请先重新打开再完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個任務已取消，請先重新開啟再完成。"
          }
        }
      }
    },
    "error.reason.habit_reminder_time_taken": {
      "comment": "Alert shown when a habit reminder is set to a time the habit already has a reminder at.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لهذه العادة تذكير في هذا الوقت بالفعل. اختر وقتًا آخر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অভ্যাসের জন্য সেই সময়ে আগে থেকেই একটি রিমাইন্ডার আছে। অন্য একটি সময় বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Gewohnheit gibt es zu dieser Uhrzeit bereits eine Erinnerung. Wähle eine andere Uhrzeit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η συνήθεια έχει ήδη υπόμνηση εκείνη την ώρα. Επιλέξτε άλλη ώρα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit already has a reminder at that time. Choose another time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este hábito ya tiene un recordatorio a esa hora. Elige otra hora."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این عادت از قبل در همان ساعت یادآور دارد. ساعت دیگری انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette habitude a déjà un rappel à cette heure. Choisissez une autre heure."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להרגל הזה כבר יש תזכורת בשעה הזו. יש לבחור שעה אחרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस आदत के लिए उस समय पहले से एक रिमाइंडर है। कोई दूसरा समय चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebiasaan ini sudah memiliki pengingat pada waktu tersebut. Pilih waktu lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa abitudine ha già un promemoria a quell’ora. Scegli un altro orario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この習慣にはその時刻のリマインダーがすでにあります。別の時刻を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 습관에는 그 시간에 이미 알림이 있습니다. 다른 시간을 선택하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या सवयीसाठी त्या वेळी आधीपासूनच रिमाइंडर आहे. दुसरी वेळ निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabiat ini sudah mempunyai peringatan pada masa itu. Pilih masa lain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze gewoonte heeft al een herinnering op dat tijdstip. Kies een ander tijdstip."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten nawyk ma już przypomnienie o tej godzinie. Wybierz inną godzinę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este hábito já tem um lembrete nesse horário. Escolha outro horário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest obicei are deja un memento la ora respectivă. Alegeți altă oră."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этой привычки уже есть напоминание на это время. Выберите другое время."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் பழக்கத்துக்கு அந்த நேரத்தில் ஏற்கெனவே நினைவூட்டல் உள்ளது. வேறொரு நேரத்தைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ అలవాటుకు ఆ సమయానికి ఇప్పటికే రిమైండర్ ఉంది. వేరే సమయాన్ని ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นิสัยนี้มีเตือนความจำในเวลานั้นอยู่แล้ว เลือกเวลาอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alışkanlığın o saatte zaten bir anımsatıcısı var. Başka bir saat seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця звичка вже має нагадування на цей час. Виберіть інший час."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس عادت کی اس وقت پہلے سے یاد دہانی موجود ہے۔ کوئی اور وقت منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thói quen này đã có lời nhắc vào giờ đó. Hãy chọn giờ khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个习惯在这个时间已有提醒，请换一个时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個習慣在這個時間已有提醒，請換一個時間。"
          }
        }
      }
    },
    "error.reason.memory_name_taken": {
      "comment": "Alert shown when an entry in Memory (what the assistant remembers) is renamed to the name of another entry.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توجد ذاكرة بهذا الاسم بالفعل. اختر اسمًا آخر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
