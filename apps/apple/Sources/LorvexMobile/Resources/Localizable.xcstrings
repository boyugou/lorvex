    "today.calm.headline.all_done": {
      "comment": "Today headline when every planned task is complete",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتمل كل ما خططت له."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্ল্যান করা সবকিছু হয়ে গেছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles Geplante ist erledigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ολοκληρώθηκαν όλα όσα είχαν προγραμματιστεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything planned is done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo planificado está hecho."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همه آنچه برنامه‌ریزی شده بود انجام شد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui était prévu est fait."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל מה שתוכנן בוצע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो प्लान किया था, सब पूरा हो गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua yang direncanakan sudah selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che era in programma è fatto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定していたことはすべて完了しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계획한 일을 모두 마쳤습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्लॅन केलेले सर्व पूर्ण झाले आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua yang dirancang telah selesai."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wat gepland was, is voltooid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko zaplanowane zostało ukończone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que estava planejado está feito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot ce era planificat este finalizat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё запланированное выполнено."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "திட்டமிட்டவை அனைத்தும் முடிந்தன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్లాన్ చేసినవన్నీ పూర్తయ్యాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำทุกอย่างที่วางแผนไว้เสร็จแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planlanan her şey tamamlandı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе заплановане виконано."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جو کچھ طے تھا وہ سب ہو گیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi việc đã lên kế hoạch đều đã xong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计划里的事都做完了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安排好的事項都完成了。"
          }
        }
      }
    },
    "today.calm.headline.empty": {
      "comment": "Today headline when nothing is planned or on today's list",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء مخطط له. اليوم لك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছু প্ল্যান করা নেই। দিনটি আপনার।"
