    "system.tag.find_tasks.description": {
      "comment": "Description for the Find Lorvex Tasks by Tag App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البحث عن مهام Lorvex التي تحمل وسمًا من الاختصارات أو Siri."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শর্টকাট বা Siri থেকে কোনো ট্যাগযুক্ত Lorvex টাস্ক খুঁজুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Findet Lorvex-Aufgaben mit einem bestimmten Tag über Kurzbefehle oder Siri."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βρείτε εργασίες Lorvex που φέρουν μια ετικέτα από τις Συντομεύσεις ή το Siri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find Lorvex tasks carrying a tag from Shortcuts or Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca tareas de Lorvex con una etiqueta desde Atajos o Siri."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یافتن کارهای Lorvex دارای یک برچسب از طریق میان‌برها یا Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve les tâches de Lorvex portant un tag depuis Raccourcis ou Siri."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "איתור משימות ב-Lorvex עם תג מסוים דרך קיצורי דרך או Siri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट्स या Siri से किसी टैग वाले Lorvex कार्य खोजें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menemukan tugas Lorvex yang memiliki label dari Pintasan atau Siri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova le attività di Lorvex con un tag da Comandi rapidi o Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットまたはSiriで、タグが付いたLorvexのタスクを探します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어 또는 Siri에서 태그가 지정된 Lorvex 할 일을 찾습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट किंवा Siri द्वारे एखादा टॅग असलेली Lorvex कार्ये शोधा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencari tugas Lorvex yang mempunyai tag daripada Pintasan atau Siri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoekt Lorvex-taken met een bepaalde tag via Opdrachten of Siri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukuje zadania Lorvex według tagu ze Skrótów lub Siri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontra tarefas do Lorvex com uma etiqueta pelos Atalhos ou pela Siri."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Găsește sarcinile Lorvex cu un anumit tag prin Scurtături sau Siri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Находит задачи Lorvex по тегу из «Быстрых команд» или Siri."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்கவழிகள் அல்லது Siri மூலம் ஒரு குறிச்சொல் உள்ள Lorvex பணிகளைக் கண்டறியவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "షార్ట్‌కట్స్ లేదా Siri నుండి ఒక ట్యాగ్ ఉన్న Lorvex టాస్క్‌లను కనుగొనండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค้นหางาน Lorvex ที่มีแท็กที่ระบุจากคำสั่งลัดหรือ Siri"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kestirmeler veya Siri ile bir etiket taşıyan Lorvex görevlerini bulun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знаходить завдання Lorvex за тегом зі «Швидких команд» або Siri."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شارٹ کٹس یا Siri سے کسی ٹیگ والے Lorvex کام تلاش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm các nhiệm vụ Lorvex có gắn thẻ từ Phím tắt hoặc Siri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“快捷指令”或 Siri 查找带有某个标签的 Lorvex 任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過捷徑或 Siri 尋找帶有指定標籤的 Lorvex 任務。"
          }
        }
      }
    },
