    "watch.status.update": {
      "comment": "Status text when the app needs updating to read the snapshot",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update Lorvex to sync"
          }
        },
