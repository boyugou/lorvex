    "settings.working_hours.invalid": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر وقت نهاية بعد وقت البداية."
          }
        },
        "en": {
