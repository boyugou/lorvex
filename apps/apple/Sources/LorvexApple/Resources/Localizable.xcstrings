            "state": "translated",
            "value": "任務提醒"
          }
        }
      }
    },
    "recurrence.editor.error.concurrent_change": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر هذا التكرار على جهاز آخر أثناء تعديلك. راجع أحدث قاعدة ثم حاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি এডিট করার সময় এই পুনরাবৃত্তি অন্য ডিভাইসে বদলে গেছে। সর্বশেষ নিয়মটি দেখে আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Wiederholung wurde auf einem anderen Gerät geändert, während du sie bearbeitet hast. Prüfe die aktuelle Regel und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η επανάληψη άλλαξε σε άλλη συσκευή ενώ κάνατε επεξεργασία. Ελέγξτε τον πιο πρόσφατο κανόνα και δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This recurrence changed on another device while you were editing. Review the latest rule and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta repetición cambió en otro dispositivo mientras la editabas. Revisa la regla más reciente e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قانون تکرار هنگام ویرایش شما در دستگاه دیگری تغییر کرد. آخرین قانون را مرور کنید و دوباره تلاش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette répétition a été modifiée sur un autre appareil pendant votre modification. Vérifiez la dernière règle, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כלל החזרה שונה במכשיר אחר בזמן העריכה. יש לעיין בכלל העדכני ולנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संपादन के दौरान यह दोहराव किसी दूसरे डिवाइस पर बदल गया। नवीनतम नियम देखें और फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengulangan ini berubah di perangkat lain saat sedang diedit. Tinjau aturan terbaru dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa ripetizione è stata modificata su un altro dispositivo mentre la modificavi. Controlla la regola più recente e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集中に、別のデバイスでこの繰り返しが変更されました。最新のルールを確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집하는 동안 다른 기기에서 이 반복이 변경되었습니다. 최신 규칙을 확인한 후 다시 시도하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही संपादित करत असताना ही पुनरावृत्ती दुसऱ्या डिव्हाइसवर बदलली. नवीनतम नियम तपासा आणि पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perulangan ini berubah pada peranti lain semasa sedang diedit. Semak peraturan terkini dan cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze herhaling is op een ander apparaat gewijzigd terwijl je aan het wijzigen was. Controleer de nieuwste regel en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To powtarzanie zostało zmienione na innym urządzeniu podczas edycji. Sprawdź aktualną regułę i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta repetição foi alterada em outro dispositivo enquanto você editava. Revise a regra mais recente e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această repetare a fost modificată pe alt dispozitiv în timp ce o editați. Verificați cea mai recentă regulă și încercați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это повторение было изменено на другом устройстве во время редактирования. Проверьте актуальное правило и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การทำประจำนี้ถูกเปลี่ยนบนอุปกรณ์เครื่องอื่นขณะที่คุณแก้ไข ตรวจดูกฎล่าสุดแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yineleme, siz düzenlerken başka bir aygıtta değişti. En son kuralı inceleyip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це повторення змінили на іншому пристрої, поки ви редагували. Перегляньте актуальне правило й повторіть спробу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ترمیم کے دوران تکرار کا قاعدہ کسی دوسری ڈیوائس پر تبدیل ہو گیا۔ تازہ ترین قاعدہ دیکھیں اور دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quy tắc lặp lại này đã thay đổi trên thiết bị khác trong khi bạn đang sửa. Hãy xem lại quy tắc mới nhất rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你编辑期间，此重复规则已在另一台设备上更改。请检查最新规则后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在編輯時，這項重複設定已在另一台裝置上變更。請查看最新的規則，然後再試一次。"
          }
        }
      }
    },
    "recurrence.editor.error.invalid_interval": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تكون فترة التكرار عددًا صحيحًا من واحد إلى عشرة آلاف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পুনরাবৃত্তির ব্যবধান 1 থেকে 10,000-এর মধ্যে একটি পূর্ণসংখ্যা হতে হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wiederholungsintervall muss eine ganze Zahl von 1 bis 10.000 sein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το διάστημα επανάληψης πρέπει να είναι ακέραιος αριθμός από 1 έως 10.000."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recurrence interval must be a whole number from 1 through 10,000."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El intervalo de repetición debe ser un número entero del 1 al 10 000."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فاصله تکرار باید یک عدد صحیح از یک تا ده هزار باشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’intervalle de répétition doit être un nombre entier compris entre 1 et 10 000."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מרווח החזרה חייב להיות מספר שלם בין 1 ל-10,000."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोहराव का अंतराल 1 से 10,000 के बीच की पूर्ण संख्या होना चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Interval pengulangan harus berupa bilangan bulat dari 1 sampai 10.000."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’intervallo di ripetizione deve essere un numero intero da 1 a 10.000."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "繰り返しの間隔は、1〜10,000の整数にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반복 간격은 1에서 10,000 사이의 정수여야 합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनरावृत्तीचे अंतर 1 ते 10,000 मधील पूर्ण संख्या असणे आवश्यक आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selang perulangan mestilah nombor bulat dari 1 hingga 10,000."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het herhalingsinterval moet een geheel getal van 1 tot en met 10.000 zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Interwał powtarzania musi być liczbą całkowitą od 1 do 10 000."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O intervalo de repetição deve ser um número inteiro de 1 a 10.000."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervalul de repetare trebuie să fie un număr întreg între 1 și 10.000."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Интервал повторения должен быть целым числом от 1 до 10 000."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงเวลาการทำประจำต้องเป็นจำนวนเต็มตั้งแต่ 1 ถึง 10,000"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yineleme aralığı, 1 ile 10.000 arasında bir tam sayı olmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інтервал повторення має бути цілим числом від 1 до 10 000."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تکرار کا وقفہ 1 سے 10,000 تک کا مکمل عدد ہونا چاہیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoảng lặp lại phải là số nguyên từ 1 đến 10.000."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重复间隔必须是 1 到 10,000 之间的整数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重複間隔必須是 1 到 10,000 之間的整數。"
          }
        }
      }
    },
