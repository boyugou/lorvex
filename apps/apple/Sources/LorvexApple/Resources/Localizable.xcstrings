        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会将日历事件读入 Lorvex。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會將行事曆事件讀取到 Lorvex 中。"
          }
        }
      }
    },
    "settings.calendar.access.scope_detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينطبق على ما يمكن لـ Lorvex والمساعدين المتصلين رؤيته على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für alles, was Lorvex und verbundene Assistenten auf diesem Gerät sehen können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to what Lorvex and connected assistants can see on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a lo que Lorvex y los asistentes conectados pueden ver en este dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای آنچه Lorvex و دستیارهای متصل در این دستگاه می‌توانند ببینند اعمال می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique à ce que Lorvex et les assistants connectés peuvent voir sur cet appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חל על מה ש-Lorvex והעוזרים המחוברים יכולים לראות במכשיר זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह इस पर लागू होता है कि इस डिवाइस पर Lorvex और जुड़े हुए असिस्टेंट क्या देख सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si applica a ciò che Lorvex e gli assistenti connessi possono vedere su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定は、このデバイス上でLorvexと接続済みのアシスタントが見られる内容に適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 Lorvex와 연결된 어시스턴트가 볼 수 있는 내용에 적용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geldt voor wat Lorvex en verbonden assistenten op dit apparaat kunnen zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Określa, co Lorvex i połączeni asystenci mogą widzieć na tym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se ao que o Lorvex e os assistentes conectados podem ver neste dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplică la ceea ce pot vedea Lorvex și asistenții conectați pe acest dispozitiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Определяет, что Lorvex и подключённые ассистенты могут видеть на этом устройстве."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Визначає, що Lorvex і підключені асистенти можуть бачити на цьому пристрої."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ اس پر لاگو ہوتا ہے جو Lorvex اور منسلک اسسٹنٹس اس ڈیوائس پر دیکھ سکتے ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于 Lorvex 和已连接的助手可在此设备上看到的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適用於 Lorvex 與已連接的助理在此裝置上能看到的內容。"
          }
        }
      }
    },
    "settings.calendar.access_denied": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم رفض الوصول إلى التقويم. افتح إعدادات النظام لمنح حق الوصول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf Kalender wurde verweigert. Öffne die Systemeinstellungen, um den Zugriff zu erlauben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar access has been denied. Open System Settings to grant access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha denegado el acceso al calendario. Abre Ajustes del Sistema para concederlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به تقویم رد شده است. برای اعطای دسترسی، تنظیمات سیستم را باز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au calendrier a été refusé. Ouvrez Réglages Système pour l’autoriser."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגישה ללוח השנה נדחתה. יש לפתוח את הגדרות המערכת כדי להעניק גישה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलेंडर एक्सेस अस्वीकार कर दिया गया है। एक्सेस देने के लिए सिस्टम सेटिंग्ज़ खोलें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso al calendario è stato negato. Apri Impostazioni di Sistema per consentirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーへのアクセスが拒否されています。「システム設定」を開いてアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 접근이 거부되었습니다. 시스템 설정을 열어 접근을 허용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot de agenda is geweigerd. Open Systeeminstellingen om toegang te geven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odmówiono dostępu do kalendarza. Otwórz Ustawienia systemowe, aby go przyznać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao calendário foi negado. Abra os Ajustes do Sistema para permitir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesul la calendar a fost refuzat. Deschideți Configurări sistem pentru a permite accesul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к календарю запрещён. Откройте Системные настройки, чтобы разрешить доступ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до календаря заборонено. Відкрийте Системні параметри, щоб надати доступ."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیلنڈر تک رسائی مسترد کر دی گئی ہے۔ رسائی دینے کے لیے سسٹم کی ترتیبات کھولیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日历访问已被拒绝。请打开“系统设置”授予访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "行事曆存取權限已被拒絕。請開啟「系統設定」來授予存取權限。"
          }
        }
      }
