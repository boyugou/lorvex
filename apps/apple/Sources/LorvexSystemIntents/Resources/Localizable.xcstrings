    "system.day_times.save.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقتراح أوقات لمهام Lorvex اليوم، أو لمهام تاريخ محدد، حول أحداث تقويمك وحفظها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ক্যালেন্ডারের সাথে মিলিয়ে আজকের বা কোনো নির্দিষ্ট তারিখের Lorvex টাস্কের জন্য সময় প্রস্তাব করুন এবং সেভ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlägt Zeiten für die Lorvex-Aufgaben von heute oder eines bestimmten Datums rund um deinen Kalender vor und sichert sie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προτείνετε ώρες για τις εργασίες Lorvex της ημέρας ή μιας συγκεκριμένης ημερομηνίας, γύρω από το ημερολόγιό σας, και αποθηκεύστε τις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggest times for today’s Lorvex tasks, or a specific date’s, around your calendar and save them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugiere horarios para las tareas de Lorvex de hoy o de una fecha concreta, teniendo en cuenta tu calendario, y los guarda."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیشنهاد و ذخیره زمان برای کارهای Lorvex امروز یا تاریخی مشخص، با در نظر گرفتن تقویم شما."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggère des horaires pour les tâches Lorvex d’aujourd’hui ou d’une date précise, autour de votre calendrier, et les enregistre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצעת שעות למשימות Lorvex של היום או של תאריך מסוים, בהתאם ללוח השנה שלך, ושמירתן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके कैलेंडर के आसपास आज के, या किसी तय तारीख़ के, Lorvex कार्यों के लिए समय सुझाएँ और उन्हें सहेजें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyarankan waktu untuk tugas Lorvex hari ini, atau untuk tanggal tertentu, sesuai dengan kalender Anda, lalu menyimpannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggerisce orari per le attività Lorvex di oggi o di una data specifica, attorno al tuo calendario, e li salva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日、または指定した日のLorvexのタスクについて、カレンダーを避けて時間を提案し、保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 또는 지정한 날짜의 Lorvex 할 일에 대해 캘린더 일정을 피해 시간을 제안하고 저장합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या दिनदर्शिकेनुसार आजच्या किंवा एखाद्या विशिष्ट तारखेच्या Lorvex कार्यांसाठी वेळा सुचवा आणि जतन करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencadangkan masa untuk tugas Lorvex hari ini, atau untuk tarikh tertentu, mengikut kalendar anda, kemudian menyimpannya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelt tijden voor voor de Lorvex-taken van vandaag of van een bepaalde datum, rond je agenda, en bewaart ze."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proponuje godziny dla zadań Lorvex na dzisiaj lub wybraną datę z uwzględnieniem twojego kalendarza i zapisuje je."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugere horários para as tarefas do Lorvex de hoje ou de uma data específica, considerando seu calendário, e os salva."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugerează ore pentru sarcinile Lorvex de astăzi sau dintr-o anumită dată, în jurul calendarului, și le salvează."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предлагает время для задач Lorvex на сегодня или на выбранную дату с учётом вашего календаря и сохраняет его."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கேலண்டரைக் கருத்தில் கொண்டு, இன்றைய அல்லது குறிப்பிட்ட தேதியின் Lorvex பணிகளுக்கு நேரங்களைப் பரிந்துரைத்துச் சேமிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ క్యాలెండర్‌ను పరిగణనలోకి తీసుకుని, ఈరోజు లేదా ఒక నిర్దిష్ట తేదీ నాటి Lorvex టాస్క్‌లకు సమయాలను సూచించి, సేవ్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แนะนำเวลาสำหรับงาน Lorvex ของวันนี้หรือของวันที่ที่ระบุ โดยเลี่ยงช่วงที่มีนัดในปฏิทินของคุณ แล้วบันทึกไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takviminizi gözeterek bugünün veya belirli bir tarihin Lorvex görevleri için saat önerin ve bunları kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропонує час для завдань Lorvex на сьогодні або на вибрану дату з урахуванням вашого календаря та зберігає його."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج یا کسی خاص تاریخ کے Lorvex کاموں کے لیے آپ کے کیلنڈر کے مطابق اوقات تجویز کریں اور انہیں محفوظ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gợi ý giờ cho các nhiệm vụ Lorvex hôm nay, hoặc của một ngày cụ thể, dựa trên lịch của bạn rồi lưu lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "围绕你的日历，为今天或指定日期的 Lorvex 任务建议时间并保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依照你的行事曆，為今天或指定日期的 Lorvex 任務建議時間並儲存。"
          }
        }
      }
    },
    "system.day_times.save.dialog": {
      "comment": "Dialog after saving suggested times. 1: tasks placed; 2: date (YYYY-MM-DD)",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
