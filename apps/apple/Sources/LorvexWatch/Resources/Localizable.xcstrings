    "watch.action.cancel.message": {
      "comment": "Confirmation message for cancelling a task",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في المهام المتكررة، يُلغى هذا التكرار فقط وتستمر التكرارات اللاحقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei wiederkehrenden Aufgaben wird nur diese Wiederholung abgebrochen; künftige Wiederholungen laufen weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For repeating tasks, only this occurrence is cancelled and future occurrences continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En las tareas recurrentes, solo se cancela esta repetición y las siguientes continúan."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای کارهای تکرارشونده فقط همین تکرار لغو می‌شود و تکرارهای بعدی ادامه می‌یابند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les tâches récurrentes, seule cette occurrence est annulée et les suivantes continuent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "במשימות חוזרות מבוטל רק המופע הזה, והמופעים הבאים ממשיכים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोहराए जाने वाले कार्यों में केवल इस बार का कार्य रद्द होता है, आगे के कार्य जारी रहते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk tugas berulang, hanya kejadian ini yang dibatalkan dan kejadian berikutnya tetap berlanjut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per le attività ricorrenti viene annullata solo questa occorrenza e le successive continuano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "繰り返しタスクの場合、キャンセルされるのは今回分のみで、以降の分は続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반복되는 할 일은 이번 반복만 취소되고 이후 반복은 그대로 이어집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagi tugas berulang, hanya kejadian ini yang dibatalkan dan kejadian akan datang diteruskan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij terugkerende taken wordt alleen deze herhaling geannuleerd; toekomstige herhalingen lopen door."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W zadaniach powtarzających się anulowane jest tylko to wystąpienie, a kolejne są kontynuowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em tarefas recorrentes, apenas esta ocorrência é cancelada e as próximas continuam."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru sarcinile recurente, se anulează doar această apariție, iar aparițiile viitoare continuă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для повторяющихся задач отменяется только это повторение, а следующие продолжаются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для повторюваних завдань скасовується лише це повторення, а наступні тривають."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دہرائے جانے والے کاموں میں صرف یہی تکرار منسوخ ہوتی ہے اور آئندہ کی تکرارات جاری رہتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với nhiệm vụ lặp lại, chỉ lần lặp này bị hủy và các lần lặp sau vẫn tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对于重复任务，只会取消本次，之后的任务仍会继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重複任務只會取消這一次，之後的重複仍會繼續。"
          }
        }
      }
    },
