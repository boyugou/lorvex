    "setup.permissions.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التقويم والإشعارات اختياريان، ويمكنك تغييرهما لاحقًا من الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalender und Mitteilungen sind optional. Du kannst sie später in den Einstellungen ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar and Notifications are optional, and you can change them later in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendario y Notificaciones son opcionales, y puedes cambiarlos más tarde en Ajustes."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تقویم و اعلان‌ها اختیاری هستند و می‌توانید بعداً آن‌ها را در تنظیمات تغییر دهید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le calendrier et les notifications sont facultatifs ; vous pourrez les modifier plus tard dans les réglages."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לוח שנה והתראות הם אופציונליים, ואפשר לשנות אותם בהמשך בהגדרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलेंडर और सूचनाएँ वैकल्पिक हैं, और आप इन्हें बाद में सेटिंग्ज़ में बदल सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendario e notifiche sono facoltativi e potrai modificarli in seguito nelle impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーと通知は任意です。あとから「設定」で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더와 알림은 선택 사항이며 나중에 설정에서 변경할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenda en Meldingen zijn optioneel en je kunt ze later wijzigen in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendarz i powiadomienia są opcjonalne — możesz je zmienić później w ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendário e notificações são opcionais, e você pode alterá-los depois nos ajustes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendarul și Notificările sunt opționale și le puteți modifica ulterior din Configurări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Календарь и уведомления необязательны — их можно изменить позже в настройках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Календар і сповіщення необов’язкові — їх можна змінити пізніше в параметрах."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیلنڈر اور نوٹیفکیشنز اختیاری ہیں، اور آپ انہیں بعد میں ترتیبات میں تبدیل کر سکتے ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日历和通知都是可选的，之后也可以在设置中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "行事曆與通知為選用項目，你之後可以在「設定」中變更。"
          }
        }
      }
    },
