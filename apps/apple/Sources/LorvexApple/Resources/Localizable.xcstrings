          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi la scorciatoia da tastiera in qualsiasi app per aggiungere un’attività senza passare a Lorvex."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアプリでもキーボードショートカットを押すと、Lorvexに切り替えずにタスクを追加できます。"
