        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 백업에는 가져올 데이터가 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या बॅकअपमध्ये इम्पोर्ट करण्यासाठी कोणताही डेटा नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sandaran ini tiada data untuk diimport."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze back-up bevat geen gegevens om te importeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta kopia zapasowa nie zawiera danych do zaimportowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este backup não tem dados para importar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această copie de rezervă nu conține date de importat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой резервной копии нет данных для импорта."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் பேக்-அப்பில் இம்போர்ட் செய்ய தரவு எதுவும் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ బ్యాకప్‌లో ఇంపోర్ట్ చేయడానికి డేటా ఏదీ లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลสำรองนี้ไม่มีข้อมูลที่จะนำเข้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yedekte içe aktarılacak veri yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цій резервній копії немає даних для імпорту."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس بیک اپ میں امپورٹ کرنے کے لیے کوئی ڈیٹا نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao lưu này không có dữ liệu để nhập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此备份中没有可导入的数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此備份中沒有可匯入的資料。"
          }
        }
      }
    },
    "import.error.not_a_backup": {
      "comment": "Shown when the file chosen for import can't be read as a Lorvex backup: it is another kind of file, or it is too damaged to recognize.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الملف ليس نسخة احتياطية من Lorvex، أو أنه تالف. اختر ملفًا مُصدَّرًا من Lorvex."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফাইলটি Lorvex ব্যাকআপ নয়, অথবা এটি ক্ষতিগ্রস্ত। Lorvex থেকে এক্সপোর্ট করা একটি ফাইল বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist kein Lorvex-Backup oder sie ist beschädigt. Wähle eine aus Lorvex exportierte Datei."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το αρχείο δεν είναι αντίγραφο ασφαλείας του Lorvex ή είναι κατεστραμμένο. Επιλέξτε ένα αρχείο που έχει εξαχθεί από το Lorvex."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file isn’t a Lorvex backup, or it’s damaged. Choose a file exported from Lorvex."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo no es una copia de seguridad de Lorvex o está dañado. Elige un archivo exportado desde Lorvex."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این فایل پشتیبان Lorvex نیست یا آسیب دیده است. فایلی را انتخاب کنید که از Lorvex صادر شده است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier n’est pas une sauvegarde Lorvex, ou il est endommagé. Choisissez un fichier exporté depuis Lorvex."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקובץ הזה אינו גיבוי של Lorvex, או שהוא פגום. יש לבחור קובץ שיוצא מ-Lorvex."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ाइल Lorvex बैकअप नहीं है, या यह क्षतिग्रस्त है। Lorvex से एक्सपोर्ट की गई फ़ाइल चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File ini bukan cadangan Lorvex, atau file rusak. Pilih file yang diekspor dari Lorvex."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file non è un backup di Lorvex oppure è danneggiato. Scegli un file esportato da Lorvex."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルはLorvexのバックアップではないか、破損しています。Lorvexから書き出したファイルを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 Lorvex 백업이 아니거나 손상되었습니다. Lorvex에서 내보낸 파일을 선택하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ही फाइल Lorvex बॅकअप नाही किंवा ती खराब झाली आहे. Lorvex मधून एक्सपोर्ट केलेली फाइल निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail ini bukan sandaran Lorvex, atau rosak. Pilih fail yang dieksport daripada Lorvex."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit bestand is geen Lorvex-back-up of het is beschadigd. Kies een bestand dat uit Lorvex is geëxporteerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten plik nie jest kopią zapasową Lorvex lub jest uszkodzony. Wybierz plik wyeksportowany z Lorvex."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo não é um backup do Lorvex ou está danificado. Escolha um arquivo exportado do Lorvex."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest fișier nu este o copie de rezervă Lorvex sau este deteriorat. Alegeți un fișier exportat din Lorvex."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот файл не является резервной копией Lorvex или повреждён. Выберите файл, экспортированный из Lorvex."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் கோப்பு Lorvex பேக்-அப் அல்ல, அல்லது அது சேதமடைந்துள்ளது. Lorvexஇல் இருந்து எக்ஸ்போர்ட் செய்த கோப்பைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫైల్ Lorvex బ్యాకప్ కాదు, లేదా ఇది దెబ్బతింది. Lorvex నుండి ఎక్స్‌పోర్ట్ చేసిన ఫైల్‌ను ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์นี้ไม่ใช่ข้อมูลสำรองของ Lorvex หรือเสียหาย เลือกไฟล์ที่ส่งออกจาก Lorvex"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya bir Lorvex yedeği değil ya da hasarlı. Lorvex’ten dışa aktarılmış bir dosya seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей файл не є резервною копією Lorvex або пошкоджений. Виберіть файл, експортований з Lorvex."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ فائل Lorvex کا بیک اپ نہیں ہے، یا خراب ہے۔ Lorvex سے ایکسپورٹ کی گئی فائل منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp này không phải bản sao lưu Lorvex, hoặc bị hỏng. Hãy chọn tệp được xuất từ Lorvex."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件不是 Lorvex 备份，或者已损坏。请选择从 Lorvex 导出的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案不是 Lorvex 備份，或已損毀。請選擇從 Lorvex 匯出的檔案。"
          }
        }
      }
    },
    "import.error.too_large": {
      "comment": "Shown when the file chosen for import is larger than a backup can be. %1$@ is the file's size and %2$@ the largest size a backup can have, each with its unit (\"412.3 MB\", \"67.1 MB\").",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حجم الملف المحدد %1$@. الحد الأقصى لحجم النسخة الاحتياطية من Lorvex هو %2$@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্বাচিত ফাইলটির আকার %1$@। Lorvex ব্যাকআপের আকার সর্বোচ্চ %2$@ হতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählte Datei ist %1$@ groß. Ein Lorvex-Backup darf höchstens %2$@ groß sein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το επιλεγμένο αρχείο είναι %1$@. Ένα αντίγραφο ασφαλείας του Lorvex μπορεί να είναι έως %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected file is %1$@. A Lorvex backup can be at most %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo seleccionado ocupa %1$@. Una copia de seguridad de Lorvex puede ocupar como máximo %2$@."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل انتخاب‌شده %1$@ است. حجم پشتیبان Lorvex حداکثر می‌تواند %2$@ باشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier sélectionné fait %1$@. Une sauvegarde Lorvex ne peut pas dépasser %2$@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקובץ שנבחר הוא %1$@. גיבוי של Lorvex יכול להיות לכל היותר %2$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनी गई फ़ाइल का आकार %1$@ है। Lorvex बैकअप का आकार अधिकतम %2$@ हो सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File yang dipilih berukuran %1$@. Cadangan Lorvex berukuran maksimum %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file selezionato è di %1$@. Un backup di Lorvex può essere al massimo di %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したファイルのサイズは%1$@です。Lorvexのバックアップは最大%2$@までです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 파일의 크기는 %1$@입니다. Lorvex 백업은 최대 %2$@까지 가능합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "निवडलेल्या फाइलचा आकार %1$@ आहे. Lorvex बॅकअपचा आकार जास्तीत जास्त %2$@ असू शकतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail yang dipilih bersaiz %1$@. Sandaran Lorvex boleh bersaiz sehingga %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het geselecteerde bestand is %1$@. Een Lorvex-back-up mag maximaal %2$@ zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrany plik ma rozmiar %1$@. Kopia zapasowa Lorvex może mieć najwyżej %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo selecionado tem %1$@. Um backup do Lorvex pode ter no máximo %2$@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierul selectat are %1$@. O copie de rezervă Lorvex poate avea cel mult %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер выбранного файла — %1$@. Резервная копия Lorvex не может превышать %2$@."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேர்ந்தெடுத்த கோப்பின் அளவு %1$@. Lorvex பேக்-அப்பின் அதிகபட்ச அளவு %2$@."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎంచుకున్న ఫైల్ సైజ్ %1$@. Lorvex బ్యాకప్ గరిష్ఠ సైజ్ %2$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ที่เลือกมีขนาด %1$@ ข้อมูลสำรองของ Lorvex ใหญ่ได้สูงสุด %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen dosya %1$@ boyutunda. Bir Lorvex yedeği en fazla %2$@ olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розмір вибраного файлу — %1$@. Резервна копія Lorvex не може перевищувати %2$@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب کردہ فائل %1$@ کی ہے۔ Lorvex بیک اپ زیادہ سے زیادہ %2$@ کا ہو سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp đã chọn có dung lượng %1$@. Bản sao lưu Lorvex có dung lượng tối đa %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选文件大小为 %1$@。Lorvex 备份最大为 %2$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選檔案大小為 %1$@。Lorvex 備份最大為 %2$@。"
          }
        }
      }
    },
