    "tasks.empty.cancelled.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى المهام الملغاة هنا، لتتمكن من مراجعة قراراتك السابقة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelled tasks stay here, so you can look back on past decisions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas canceladas se quedan aquí, para que puedas revisar decisiones pasadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches annulées restent ici, pour que vous puissiez revenir sur vos décisions passées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रद्द किए गए कार्य यहीं रहते हैं, ताकि आप पुराने फ़ैसलों को देख सकें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le attività annullate restano qui, così puoi rivedere le decisioni passate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセルしたタスクはここに残り、過去の判断を振り返ることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소한 할 일은 여기에 남아 있어 과거의 결정을 돌아볼 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulowane zadania zostają tutaj, dzięki czemu możesz wrócić do dawnych decyzji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas canceladas ficam aqui para você rever decisões passadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменённые задачи остаются здесь, чтобы вы могли оглянуться на прошлые решения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасовані завдання залишаються тут, щоб ви могли озирнутися на минулі рішення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消任务会保留在这里，便于回看过去的决策。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消的任務會保留在這裡，方便你回顧過去的決定。"
          }
        }
      }
    },
