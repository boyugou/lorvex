    "system.habit.update.description": {
      "comment": "Description for the Update Lorvex Habit App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة تسمية عادة في Lorvex أو تحديثها من الاختصارات أو Siri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rename or update a Lorvex habit from Shortcuts or Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el nombre o actualiza un hábito de Lorvex desde Atajos o Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renomme ou met à jour une habitude de Lorvex depuis Raccourcis ou Siri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट्स या Siri से Lorvex आदत का नाम बदलें या उसे अपडेट करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinomina o aggiorna un’abitudine di Lorvex da Comandi rapidi o Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットまたはSiriでLorvexの習慣の名前を変更または更新します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어 또는 Siri에서 Lorvex 습관의 이름을 바꾸거나 업데이트합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmienia nazwę lub aktualizuje nawyk Lorvex ze Skrótów lub Siri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renomeia ou atualiza um hábito do Lorvex pelos Atalhos ou pela Siri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переименовывает или обновляет привычку Lorvex из «Быстрых команд» или Siri."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейменовує або оновлює звичку Lorvex зі «Швидких команд» або Siri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“快捷指令”或 Siri 重命名或更新一个 Lorvex 习惯。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過捷徑或 Siri 重新命名或更新 Lorvex 習慣。"
          }
        }
      }
    },
