          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тегів ще немає. Введіть тег і натисніть Return."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی تک کوئی ٹیگ نہیں۔ ایک ٹائپ کریں اور Return دبائیں۔"
