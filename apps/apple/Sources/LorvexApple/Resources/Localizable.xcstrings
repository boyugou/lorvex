    "settings.time_zone.use_device": {
      "comment": "Button: switch the synced time zone to this device's; the argument is the zone, e.g. Tokyo · GMT+9",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
