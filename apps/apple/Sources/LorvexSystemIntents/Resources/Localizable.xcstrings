        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” collegata all’evento del calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」をカレンダーイベントに関連付けました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 할 일을 캘린더 이벤트에 연결했습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiązano zadanie „%@” z wydarzeniem kalendarza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” vinculada ao evento do calendário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задача «%@» связана с событием календаря."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
