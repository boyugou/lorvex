        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتضمن Lorvex ذكاءً اصطناعيًا خاصًا به. اربط Claude أو مساعد MCP آخر على جهاز Mac هذا، وسيضيف المهام ويخطط معك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex has no AI of its own. Connect Claude or another MCP assistant on this Mac, and it captures and plans with you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex no tiene IA propia. Conecta Claude u otro asistente MCP en este Mac y anotará y planificará contigo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex n’a pas d’IA propre. Connectez Claude ou un autre assistant MCP sur ce Mac : il ajoute des tâches et planifie avec vous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex में अपना कोई AI नहीं है। इस Mac पर Claude या कोई दूसरा MCP असिस्टेंट जोड़ें, और वह आपके साथ कार्य जोड़ेगा और प्लान करेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex non ha un’IA propria. Collega Claude o un altro assistente MCP su questo Mac e aggiungerà attività e pianificherà con te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LorvexにはAIが組み込まれていません。このMacでClaudeなどのMCPアシスタントを接続すると、タスクの追加や計画を一緒に行ってくれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex에는 자체 AI가 없습니다. 이 Mac에서 Claude 또는 다른 MCP 어시스턴트를 연결하면 함께 할 일을 추가하고 계획해 줍니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex nie ma własnej sztucznej inteligencji. Połącz Claude lub innego asystenta MCP na tym Macu, a będzie dodawać zadania i planować razem z tobą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lorvex não tem IA própria. Conecte o Claude ou outro assistente MCP neste Mac e ele adiciona tarefas e planeja com você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Lorvex нет собственного ИИ. Подключите Claude или другого MCP-ассистента на этом Mac, и он будет добавлять задачи и планировать вместе с вами."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У Lorvex немає власного ШІ. Підключіть Claude або іншого MCP-асистента на цьому Mac, і він додаватиме завдання та плануватиме разом із вами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 本身不含 AI。在这台 Mac 上连接 Claude 或其他 MCP 助手，它会和你一起记录和规划。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 本身沒有內建 AI。在這部 Mac 上連接 Claude 或其他 MCP 助理後，它就能與你一起快速新增任務並規劃。"
          }
        }
      }
    },
    "setup.welcome.today.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يومك في مكان واحد"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your day in one place"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu día en un solo lugar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre journée au même endroit"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका दिन, एक ही जगह"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua giornata in un unico posto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日のすべてを1か所に"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루를 한곳에서"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój dzień w jednym miejscu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu dia em um só lugar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш день в одном месте"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш день в одному місці"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一天尽在一处"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的一天，集中在一處"
          }
        }
      }
    },
    "setup.welcome.today.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما هو مخطط لليوم في قائمة واحدة، وجدولك إلى جانبها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything set for today in one list, with your schedule beside it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo de hoy en una sola lista, con tu agenda al lado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui est prévu pour aujourd’hui dans une seule liste, avec votre planning à côté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज के लिए सब कुछ एक ही सूची में, और उसके बगल में आपका शेड्यूल।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che è previsto per oggi in un’unica lista, con la tua agenda accanto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の予定をすべて1つのリストにまとめ、スケジュールを横に表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 할 일을 하나의 목록으로 모아 보여 주고, 옆에 일정을 함께 표시합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko na dziś na jednej liście, a obok twój harmonogram."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que está marcado para hoje em uma só lista, com a sua agenda ao lado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что запланировано на сегодня, в одном списке, а рядом ваше расписание."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе, що заплановано на сьогодні, в одному списку, а поруч ваш розклад."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天要做的事都在一个列表里，日程就在旁边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天安排好的事項全都集中在一份清單裡，行程就放在旁邊。"
          }
        }
      }
    },
    "setup.welcome.control.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لك الكلمة الأخيرة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have the last word"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú tienes la última palabra"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez le dernier mot"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आख़िरी फ़ैसला आपका"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ultima parola è tua"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終判断はあなたに"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최종 결정은 직접 하세요"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnie słowo należy do ciebie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A palavra final é sua"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последнее слово за вами"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Останнє слово за вами"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最终由你决定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最後由你決定"
          }
        }
      }
    },
    "setup.welcome.control.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقترح مساعدك ويخطط، وأنت تقرر ما يبقى في قائمتك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your assistant suggests and plans; you decide what stays on your list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu asistente sugiere y planifica; tú decides qué se queda en tu lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre assistant suggère et planifie ; c’est vous qui décidez de ce qui reste dans votre liste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका असिस्टेंट सुझाव देता है और प्लान करता है; आपकी सूची में क्या रहे, यह आप तय करते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo assistente suggerisce e pianifica; sei tu a decidere cosa resta nella tua lista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "提案と計画はアシスタントが行い、リストに残すものはあなたが決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어시스턴트가 제안하고 계획하며, 목록에 무엇을 남길지는 직접 결정합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Asystent proponuje i planuje, a ty decydujesz, co zostanie na liście."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu assistente sugere e planeja; você decide o que fica na sua lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ассистент предлагает и планирует, а вы решаете, что останется в списке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Асистент пропонує й планує, а ви вирішуєте, що залишиться в списку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手负责建议和规划，清单上留下什么由你决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "助理負責建議與規劃，要留下哪些任務由你決定。"
          }
        }
      }
    },
    "setup.sync.devices.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء متطابق على جميع أجهزتك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same on every device"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo mismo en todos tus dispositivos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Identique sur chaque appareil"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर डिवाइस पर एक जैसा"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uguale su ogni dispositivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのデバイスでも同じ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기기에서 동일하게"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To samo na każdym urządzeniu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Igual em todos os dispositivos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно и то же на всех устройствах"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Те саме на всіх пристроях"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有设备保持一致"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每台裝置都一致"
          }
        }
      }
    },
    "setup.sync.devices.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى مهامك وقوائمك وعاداتك متطابقة على Mac وiPhone وiPad."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tasks, lists, and habits stay in step on your Mac, iPhone, and iPad."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus tareas, listas y hábitos se mantienen al día en el Mac, el iPhone y el iPad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos tâches, listes et habitudes restent synchronisées sur votre Mac, votre iPhone et votre iPad."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके कार्य, सूचियाँ और आदतें आपके Mac, iPhone और iPad पर एक जैसी रहती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue attività, liste e abitudini restano allineate su Mac, iPhone e iPad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスク、リスト、習慣は、Mac、iPhone、iPadで同じ状態に保たれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일, 목록, 습관이 Mac, iPhone, iPad에서 항상 동일하게 유지됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadania, listy i nawyki są takie same na Macu, iPhonie i iPadzie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas tarefas, listas e hábitos ficam em sincronia no seu Mac, iPhone e iPad."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задачи, списки и привычки совпадают на вашем Mac, iPhone и iPad."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завдання, списки й звички збігаються на вашому Mac, iPhone та iPad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务、列表和习惯在 Mac、iPhone 和 iPad 上同步更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的任務、清單和習慣會在 Mac、iPhone 和 iPad 上保持同步。"
          }
        }
      }
    },
    "setup.sync.private.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خاصة بك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private to you"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para ti"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Privé, rien que pour vous"
          }
        },
        "hi": {
