        "ur": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "\"%1$@\" کو حذف نہیں کیا جا سکتا کیونکہ اس میں ابھی %2$lld کام موجود ہے۔ اس کے بجائے اسے آرکائیو کریں تاکہ اس کے کام اور تاریخچہ محفوظ رہیں۔ آپ اسے بعد میں آرکائیو سے نکال سکتے ہیں۔"
                }
