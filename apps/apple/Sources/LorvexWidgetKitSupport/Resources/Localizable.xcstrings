          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltooit een Lorvex-taak vanuit een widget."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznacza zadanie Lorvex jako ukończone z poziomu widżetu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclui uma tarefa do Lorvex a partir de um widget."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalizează o sarcină Lorvex dintr-un widget."
          }
        },
        "ru": {
          "stringUnit": {
