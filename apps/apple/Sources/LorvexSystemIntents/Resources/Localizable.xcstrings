        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어 또는 Siri에서 Lorvex 할 일에 메모를 덧붙입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
