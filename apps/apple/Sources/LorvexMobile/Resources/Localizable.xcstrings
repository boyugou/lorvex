    "setup.sync.off.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقف المزامنة في أي وقت من الإعدادات. تبقى بياناتك على هذا الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেটিংসে গিয়ে যেকোনো সময় সিঙ্কিং বন্ধ করতে পারবেন। আপনার ডেটা এই ডিভাইসেই থাকবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte die Synchronisierung jederzeit in den Einstellungen aus. Deine Daten bleiben auf diesem Gerät."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απενεργοποιήστε τον συγχρονισμό όποτε θέλετε από τις Ρυθμίσεις. Τα δεδομένα σας παραμένουν σε αυτήν τη συσκευή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn syncing off anytime in Settings. Your data stays on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva la sincronización cuando quieras en Ajustes. Tus datos se quedan en este dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همگام‌سازی را هر زمان در تنظیمات خاموش کنید. داده‌های شما در این دستگاه می‌مانند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez la synchronisation à tout moment dans Réglages. Vos données restent sur cet appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לכבות את הסנכרון בכל עת בהגדרות. הנתונים שלך נשארים במכשיר הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्ज़ में कभी भी सिंक बंद करें। आपका डेटा इसी डिवाइस पर रहेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan penyelarasan kapan saja di Pengaturan. Data tetap berada di perangkat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva la sincronizzazione in qualsiasi momento in Impostazioni. I tuoi dati restano su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期は「設定」でいつでもオフにできます。データはこのデバイスに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 언제든 동기화를 끌 수 있습니다. 데이터는 이 기기에 그대로 남습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सिंकिंग तुम्ही केव्हाही सेटिंगमध्ये बंद करू शकता. तुमचा डेटा या डिव्हाइसवरच राहील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyahaktifkan penyelarasan bila-bila masa dalam Seting. Data anda kekal pada peranti ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet synchronisatie op elk moment uit in Instellingen. Je gegevens blijven op dit apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizację możesz wyłączyć w dowolnym momencie w ustawieniach. Twoje dane pozostaną na tym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative a sincronização a qualquer momento em Ajustes. Seus dados ficam neste dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezactivați sincronizarea oricând din Configurări. Datele rămân pe acest dispozitiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключить синхронизацию можно в любой момент в настройках. Ваши данные останутся на этом устройстве."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அமைப்புகளில் எப்போது வேண்டுமானாலும் ஒத்திசைவை ஆஃப் செய்யலாம். உங்கள் தரவு இந்தச் சாதனத்திலேயே இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సెట్టింగ్స్‌లో ఎప్పుడైనా సింక్‌ను ఆఫ్ చేయవచ్చు. మీ డేటా ఈ డివైజ్‌లోనే ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดการเชื่อมข้อมูลได้ทุกเมื่อในการตั้งค่า ข้อมูลของคุณจะอยู่บนอุปกรณ์เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşzamanlamayı istediğiniz zaman Ayarlar’dan kapatabilirsiniz. Verileriniz bu aygıtta kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкнути синхронізацію можна будь-коли в параметрах. Ваші дані залишаться на цьому пристрої."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سنک کو کسی بھی وقت ترتیبات میں بند کریں۔ آپ کا ڈیٹا اس ڈیوائس پر رہتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt đồng bộ hóa bất cứ lúc nào trong Cài đặt. Dữ liệu của bạn vẫn ở trên thiết bị này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时可以在设置中关闭同步，数据仍保留在这台设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以隨時在「設定」中關閉同步，資料會留在此裝置上。"
          }
        }
      }
    },
