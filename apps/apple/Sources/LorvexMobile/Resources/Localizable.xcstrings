    "tasks.empty.completed.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر المهام المكتملة هنا بعد إنهاء العمل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাজ শেষ হলে সম্পন্ন টাস্কগুলি এখানে দেখা যাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erledigte Aufgaben erscheinen hier, sobald Arbeit abgeschlossen ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ολοκληρωμένες εργασίες εμφανίζονται εδώ όταν ολοκληρώνεται η δουλειά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completed tasks will appear here after work is closed out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas aparecerán aquí cuando las completes."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارهای تکمیل‌شده پس از پایان کار در اینجا نمایش داده می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches terminées apparaîtront ici une fois le travail clôturé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משימות שהושלמו יופיעו כאן אחרי שהעבודה עליהן תסתיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "काम पूरा होने के बाद पूर्ण कार्य यहाँ दिखेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas yang selesai akan muncul di sini setelah pekerjaan ditutup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le attività completate appariranno qui quando il lavoro sarà concluso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了したタスクは、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료한 할 일이 여기에 표시됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काम पूर्ण झाल्यावर पूर्ण झालेली कार्ये येथे दिसतील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas yang selesai akan dipaparkan di sini selepas kerja ditutup."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltooide taken verschijnen hier zodra werk is afgerond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukończone zadania pojawią się tutaj po zakończeniu pracy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas concluídas aparecerão aqui depois que o trabalho for encerrado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarcinile finalizate vor apărea aici după ce munca este încheiată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполненные задачи появятся здесь, когда работа будет завершена."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வேலை முடிந்த பிறகு நிறைவடைந்த பணிகள் இங்கே தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పని ముగిసిన తర్వాత పూర్తయిన టాస్క్‌లు ఇక్కడ కనిపిస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานที่เสร็จแล้วจะแสดงที่นี่เมื่อทำงานเสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamlanan görevler, işler bitirildikçe burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виконані завдання з’являться тут, коли роботу буде завершено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کام ختم کرنے کے بعد مکمل کام یہاں نظر آئیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các nhiệm vụ đã hoàn thành sẽ xuất hiện tại đây sau khi công việc được khép lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务完成后会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成的任務會顯示在這裡。"
          }
        }
      }
    },
