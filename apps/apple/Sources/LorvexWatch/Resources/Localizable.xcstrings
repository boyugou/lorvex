          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla questa occorrenza di “%@”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の今回分をキャンセルします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”의 이번 반복을 취소합니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anuluje to wystąpienie zadania „%@”"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancela esta ocorrência de “%@”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменяет это повторение задачи «%@»"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасовує це повторення завдання «%@»"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅取消“%@”的这一次"
          }
