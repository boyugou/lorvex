        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이벤트 시트를 열어 반복 또는 여러 날 세부 정보를 편집합니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
