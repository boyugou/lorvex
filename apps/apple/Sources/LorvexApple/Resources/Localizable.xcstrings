        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas di daftar ini akan muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le attività assegnate a questa lista appariranno qui."
          }
        },
