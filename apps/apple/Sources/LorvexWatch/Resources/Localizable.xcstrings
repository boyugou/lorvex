      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Lorvex to sync"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Lorvex 以同步"
