          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità di sincronizzazione selezionata avrà pieno effetto dopo il riavvio di Lorvex."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した同期モードは、Lorvexを再起動すると完全に反映されます。"
