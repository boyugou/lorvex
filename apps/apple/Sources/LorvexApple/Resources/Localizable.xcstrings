          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Umieść na osi czasu kalendarza prawdziwe spotkanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque um compromisso real na linha do tempo do calendário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте на временную шкалу календаря реальную встречу."
