    "system.task.search.description": {
      "comment": "Description for the Search Lorvex Tasks App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البحث في مهام Lorvex حسب النص."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
