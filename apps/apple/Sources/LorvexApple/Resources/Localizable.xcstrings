    "settings.cloud_sync.resume.action": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة الرفع واستئناف المزامنة…"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আবার আপলোড করে সিঙ্ক চালু করুন…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut hochladen und Synchronisierung fortsetzen …"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαναμεταφόρτωση και συνέχιση συγχρονισμού…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-upload & Resume Sync…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver a subir y reanudar sincronización…"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بارگذاری مجدد و ازسرگیری همگام‌سازی…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renvoyer et reprendre la synchronisation…"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העלאה מחדש וחידוש הסנכרון…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोबारा अपलोड करें और सिंक फिर शुरू करें…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unggah Ulang & Lanjutkan Penyelarasan…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricarica e riprendi la sincronizzazione…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再アップロードして同期を再開…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 업로드하고 동기화 재개…"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पुन्हा अपलोड करा आणि सिंक सुरू ठेवा…"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat Naik Semula & Teruskan Penyelarasan…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnieuw uploaden en synchronisatie hervatten…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prześlij ponownie i wznów synchronizację…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reenviar e retomar a sincronização…"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reîncărcați și continuați sincronizarea…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправить заново и возобновить синхронизацию…"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீண்டும் பதிவேற்றி, ஒத்திசைவைத் தொடர்க…"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మళ్ళీ అప్‌లోడ్ చేసి, సింక్‌ను తిరిగి కొనసాగించండి…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปโหลดอีกครั้งและเชื่อมข้อมูลต่อ…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden yükle ve eşzamanlamayı sürdür…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надіслати знову й відновити синхронізацію…"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دوبارہ اپ لوڈ کریں اور سنک بحال کریں…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải lên lại và tiếp tục đồng bộ hóa…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新上传并恢复同步…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新上傳並繼續同步…"
          }
        }
      }
    },
