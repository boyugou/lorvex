    "share.item_detail": {
      "comment": "A listed task in shared review text with one fact about it (\"Big refactor (Pushed 4 times)\"). %1$@ is the task title, %2$@ the fact.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@)"
          }
        },
        "en": {
          "stringUnit": {
