    "calendar.timeline.load_error": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل أحداث التقويم. تأكد من أن Lorvex يملك حق الوصول إلى التقويم في إعدادات النظام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalenderereignisse konnten nicht geladen werden. Prüfe in den Systemeinstellungen, ob Lorvex Zugriff auf Kalender hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t load calendar events. Check that Lorvex has calendar access in System Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar los eventos del calendario. Comprueba que Lorvex tenga acceso al calendario en Ajustes del Sistema."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بارگیری رویدادهای تقویم انجام نشد. بررسی کنید که Lorvex در تنظیمات سیستم به تقویم دسترسی دارد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les événements du calendrier. Vérifiez que Lorvex a accès aux calendriers dans Réglages Système."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לטעון את אירועי לוח השנה. יש לוודא שיש ל-Lorvex גישה ללוח השנה בהגדרות המערכת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलेंडर इवेंट लोड नहीं हो सके। सिस्टम सेटिंग्ज़ में जाँचें कि Lorvex के पास कैलेंडर एक्सेस है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare gli eventi del calendario. Verifica che Lorvex abbia accesso al calendario in Impostazioni di Sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーのイベントを読み込めませんでした。「システム設定」でLorvexにカレンダーへのアクセスが許可されているか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 이벤트를 불러올 수 없습니다. 시스템 설정에서 Lorvex에 캘린더 접근 권한이 있는지 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenda-activiteiten konden niet worden geladen. Controleer in Systeeminstellingen of Lorvex toegang heeft tot je agenda’s."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wczytać wydarzeń kalendarza. Sprawdź, czy Lorvex ma dostęp do kalendarzy w Ustawieniach systemowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar os eventos do calendário. Verifique se o Lorvex tem acesso ao calendário em Ajustes do Sistema."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Evenimentele din calendar nu au putut fi încărcate. Verificați în Configurări sistem dacă Lorvex are acces la calendare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить события календаря. Убедитесь, что у Lorvex есть доступ к календарям в Системных настройках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити події календаря. Переконайтеся, що Lorvex має доступ до календарів у Системних параметрах."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیلنڈر ایونٹس لوڈ نہیں ہو سکے۔ سسٹم کی ترتیبات میں دیکھیں کہ Lorvex کو کیلنڈر تک رسائی حاصل ہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载日历事件。请在“系统设置”中确认 Lorvex 拥有日历访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入行事曆事件。請在「系統設定」中確認 Lorvex 是否擁有行事曆存取權限。"
          }
        }
      }
    },
