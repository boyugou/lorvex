    "system.calendar.delete.description": {
      "comment": "Description for the Delete Lorvex Calendar Event App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف حدث تقويم Lorvex من الاختصارات أو Siri."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শর্টকাট বা Siri থেকে একটি Lorvex ক্যালেন্ডার ইভেন্ট ডিলিট করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht ein Ereignis aus dem Lorvex-Kalender über Kurzbefehle oder Siri."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράψτε ένα γεγονός ημερολογίου Lorvex από τις Συντομεύσεις ή το Siri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete a Lorvex calendar event from Shortcuts or Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina un evento de calendario de Lorvex desde Atajos o Siri."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف رویداد تقویم Lorvex از طریق میان‌برها یا Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime un événement du calendrier de Lorvex depuis Raccourcis ou Siri."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחיקת אירוע בלוח השנה של Lorvex דרך קיצורי דרך או Siri."
          }
        },
        "hi": {
          "stringUnit": {
