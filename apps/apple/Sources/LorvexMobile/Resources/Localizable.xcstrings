    "settings.show_task_notes": {
      "comment": "Toggle label: whether a task's notes may appear in its reminder notification",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار ملاحظات المهمة في الإشعارات"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Task Notes in Notifications"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar notas de tareas en las notificaciones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher les notes des tâches dans les notifications"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचनाओं में कार्य के नोट दिखाएँ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra le note delle attività nelle notifiche"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知にタスクのメモを表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림에 할 일 메모 표시"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuj notatki zadań w powiadomieniach"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar notas das tarefas nas notificações"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать заметки задач в уведомлениях"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати нотатки завдань у сповіщеннях"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在通知中显示任务备注"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在通知中顯示任務備註"
          }
        }
      }
    },
    "settings.show_task_notes.footer": {
      "comment": "Footer explaining the show-task-notes-in-notifications toggle's default-off behavior",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند الإيقاف، تعرض التذكيرات عنوان المهمة فقط، وليس ملاحظاتك أبدًا، على شاشة القفل وفي اللافتات."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, reminders show only the task title — never your notes — on the lock screen and banners."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está desactivado, los recordatorios muestran solo el título de la tarea, nunca tus notas, en la pantalla bloqueada y en los banners."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque cette option est désactivée, les rappels n’affichent que le titre de la tâche, jamais vos notes, sur l’écran verrouillé et dans les bannières."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद होने पर, रिमाइंडर लॉक स्क्रीन और बैनर पर केवल कार्य का शीर्षक दिखाते हैं, आपके नोट कभी नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando è disattivata, i promemoria mostrano solo il titolo dell’attività, mai le tue note, nella schermata di blocco e nei banner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフの場合、ロック画面とバナーにはタスクのタイトルだけが表示され、メモは表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 잠금 화면과 배너에 할 일 제목만 표시되고 메모는 표시되지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy wyłączone, przypomnienia na ekranie blokady i w banerach pokazują tylko tytuł zadania — nigdy twoich notatek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando desativado, os lembretes mostram apenas o título da tarefa, nunca suas notas, na tela bloqueada e nos banners."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если выключено, напоминания на экране блокировки и в баннерах показывают только название задачи, но не ваши заметки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо вимкнено, нагадування на екрані блокування та в банерах показують лише назву завдання, але не ваші нотатки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭时，提醒仅在锁屏和横幅通知中显示任务标题，绝不显示你的备注。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉時，鎖定畫面與橫幅上的提醒只會顯示任務標題，不會顯示你的備註。"
          }
        }
      }
    },
