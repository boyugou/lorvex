            "value": "Más o menos igual durante toda la semana."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در طول هفته تقریباً یکنواخت است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À peu près constant sur la semaine."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פחות או יותר שווה לאורך השבוע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरे सप्ताह लगभग बराबर।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più o meno regolare durante la settimana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週を通してほぼ均等です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 주 동안 거의 고르게 나타납니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeveer gelijk verdeeld over de week."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mniej więcej równo przez cały tydzień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais ou menos constante ao longo da semana."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproximativ uniform pe parcursul săptămânii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Примерно поровну в течение недели."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приблизно порівну протягом тижня."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پورے ہفتے میں تقریباً یکساں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一周各天差不多。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整週的分布大致平均。"
          }
        }
      }
    },
    "habit_detail.weekdays.insight": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأقوى يوم %1$@، والأضعف يوم %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am stärksten am %1$@, am schwächsten am %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strongest on %1$@, weakest on %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mejor día: %1$@. Peor día: %2$@."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بیشترین پایبندی در %1$@، کمترین در %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meilleur jour : %1$@, moins bon jour : %2$@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החזק ביותר ב%1$@, החלש ביותר ב%2$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ को सबसे मज़बूत, %2$@ को सबसे कमज़ोर।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Giorno migliore: %1$@, peggiore: %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が最も多く、%2$@が最も少なくなっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에 가장 잘 지키고, %2$@에 가장 적게 지킵니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het sterkst op %1$@, het zwakst op %2$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najczęściej: %1$@, najrzadziej: %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Melhor dia: %1$@, pior dia: %2$@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel mai bun: %1$@; cel mai slab: %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чаще всего: %1$@, реже всего: %2$@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найчастіше: %1$@, найрідше: %2$@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سب سے مضبوط %1$@ کو، سب سے کمزور %2$@ کو۔"
          }
