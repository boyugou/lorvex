        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una data pianificata prima di aggiungere questa attività al calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタスクをカレンダーに追加する前に、予定日を設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 할 일을 캘린더에 추가하기 전에 예정일을 지정하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे कार्य दिनदर्शिकेत जोडण्यापूर्वी प्लॅन केलेला दिनांक जोडा."
          }
        },
        "ms": {
          "stringUnit": {
