        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftalık düzeniniz, iki haftalık işaretlemeden sonra burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут з’явиться ваш тижневий ритм після двох тижнів позначок."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دو ہفتوں کے چیک اِن کے بعد آپ کا ہفتہ وار پیٹرن یہاں نظر آئے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mẫu theo tuần sẽ hiển thị ở đây sau hai tuần điểm danh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
