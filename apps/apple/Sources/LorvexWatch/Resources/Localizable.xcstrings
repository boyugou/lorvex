    "watch.error.retry.hint": {
      "comment": "Accessibility hint for the retry button",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد تحميل اليوم من اللقطة أو من iPhone المقترن"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt „Heute“ erneut aus dem Snapshot oder vom gekoppelten iPhone"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reloads Today from the snapshot or paired iPhone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a cargar Hoy desde la instantánea o el iPhone emparejado"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«امروز» را از اسنپ‌شات یا iPhone جفت‌شده دوباره بارگیری می‌کند"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recharge Aujourd’hui depuis l’instantané ou l’iPhone associé"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טוען מחדש את \"היום\" מתמונת המצב או מה-iPhone המצומד"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्नैपशॉट या पेयर किए गए iPhone से आज को फिर से लोड करता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memuat ulang Hari Ini dari snapshot atau iPhone yang dipasangkan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricarica Oggi dall’istantanea o dall’iPhone associato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スナップショットまたはペアリング済みのiPhoneから今日を再読み込みします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스냅샷 또는 페어링된 iPhone에서 오늘을 다시 불러옵니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memuatkan semula Hari Ini daripada syot kilat atau iPhone yang dipasangkan"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laadt ‘Vandaag’ opnieuw vanuit de snapshot of de gekoppelde iPhone"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponownie wczytuje „Dzisiaj” z migawki lub ze sparowanego iPhone’a"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recarrega Hoje a partir do instantâneo ou do iPhone pareado"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reîncarcă „Astăzi” din instantaneu sau de pe iPhone-ul asociat"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезагружает «Сегодня» из снимка или с сопряжённого iPhone"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезавантажує «Сьогодні» зі знімка або зі спареного iPhone"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "\"آج\" کو اسنیپ شاٹ یا جوڑے گئے iPhone سے دوبارہ لوڈ کرتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải lại Hôm nay từ ảnh chụp nhanh hoặc iPhone đã ghép nối"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从快照或已配对的 iPhone 重新加载今天的任务"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從快照或已配對的 iPhone 重新載入今天"
          }
        }
      }
    },
