    "task_detail.ai_notes.empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد ملاحظات من الذكاء الاصطناعي بعد. يضيف مساعدك الملاحظات هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine KI-Notizen. Dein Assistent fügt hier Notizen hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No AI notes yet. Your assistant adds notes here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay notas de IA. Tu asistente las añade aquí."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز یادداشت هوش مصنوعی وجود ندارد. دستیار شما یادداشت‌ها را اینجا اضافه می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune note de l’IA pour l’instant. Votre assistant ajoute ses notes ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין אין הערות AI. העוזר שלך מוסיף כאן הערות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई AI नोट नहीं। आपका असिस्टेंट नोट यहाँ जोड़ता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna nota dell’IA. Il tuo assistente aggiunge le note qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIのメモはまだありません。アシスタントがここにメモを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 AI 메모가 없습니다. 어시스턴트가 여기에 메모를 추가합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen AI-notities. Je assistent voegt hier notities toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak notatek AI. Tutaj asystent dodaje notatki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma nota da IA ainda. Seu assistente adiciona notas aqui."
          }
        },
        "ro": {
