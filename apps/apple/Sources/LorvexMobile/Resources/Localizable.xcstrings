    "settings.badge.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار عدد المهام المتأخرة والمستحقة اليوم على أيقونة التطبيق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ আইকনে বকেয়া ও আজ শেষ তারিখ এমন টাস্কের সংখ্যা দেখান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die Anzahl überfälliger und heute fälliger Aufgaben am App-Symbol an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζει στο εικονίδιο της εφαρμογής τον αριθμό των εργασιών που είναι εκπρόθεσμες ή λήγουν σήμερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the count of overdue and due-today tasks on the app icon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra en el icono de la app el número de tareas vencidas y que vencen hoy."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تعداد کارهای عقب‌افتاده و سررسید امروز را روی نماد برنامه نمایش می‌دهد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche sur l’icône de l’app le nombre de tâches en retard ou à échéance aujourd’hui."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג על סמל האפליקציה את מספר המשימות שבאיחור ושתאריך היעד שלהן היום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप आइकन पर अतिदेय और आज नियत कार्यों की संख्या दिखाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan jumlah tugas terlewat dan jatuh tempo hari ini pada ikon app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra sull’icona dell’app il numero di attività in ritardo o in scadenza oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限切れと今日が期限のタスクの数をAppアイコンに表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기한이 지난 할 일과 오늘 기한인 할 일의 개수를 앱 아이콘에 표시합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ॲप आयकॉनवर ओव्हरड्यू आणि आज देय असलेल्या कार्यांची संख्या दाखवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunjukkan bilangan tugas yang lewat dan dijangka hari ini pada ikon app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont het aantal verlopen taken en taken die vandaag vervallen op het appsymbool."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuj na ikonie aplikacji liczbę zaległych zadań i zadań z terminem na dzisiaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra no ícone do app a quantidade de tarefas atrasadas ou com prazo para hoje."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișează numărul de sarcini restante și scadente astăzi pe pictograma aplicației."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать на значке приложения число просроченных задач и задач со сроком на сегодня."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காலக்கெடு முடிந்த மற்றும் இன்று காலக்கெடு உள்ள பணிகளின் எண்ணிக்கையைச் செயலி ஐகானில் காட்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గడువు మీరిన మరియు ఈరోజు గడువు ఉన్న టాస్క్‌ల సంఖ్యను యాప్ ఐకాన్‌పై చూపుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงจำนวนงานที่เกินกำหนดและครบกำหนดวันนี้บนไอคอนแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama simgesinde gecikmiş ve bugün son tarihi gelen görevlerin sayısını gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати на значку програми кількість прострочених завдань і завдань із терміном на сьогодні."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ آئیکن پر تاخیر زدہ اور آج مقررہ کاموں کی تعداد دکھاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị số nhiệm vụ quá hạn và đến hạn hôm nay trên biểu tượng ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 App 图标上显示逾期及今日到期任务的数量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 App 圖示上顯示逾期與今天到期的任務數量。"
          }
        }
      }
    },
