    "calendar.weekgrid.edit_hint.a11y_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن سحب الأحداث المتكررة والأحداث متعددة الأيام أو تغيير حجمها في شبكة التقويم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যালেন্ডার গ্রিডে পুনরাবৃত্ত ও একাধিক দিনের ইভেন্ট টেনে আনা বা আকার পরিবর্তন করা যায় না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ereignisserien und mehrtägige Ereignisse können im Kalenderraster nicht gezogen oder in der Größe geändert werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα επαναλαμβανόμενα γεγονότα και τα γεγονότα πολλών ημερών δεν μπορούν να σύρονται ή να αλλάζουν μέγεθος στο πλέγμα του ημερολογίου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recurring and multi-day events cannot be dragged or resized in the calendar grid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los eventos recurrentes y de varios días no se pueden arrastrar ni redimensionar en la cuadrícula del calendario."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رویدادهای تکرارشونده و چندروزه را نمی‌توان در جدول تقویم کشید یا تغییر اندازه داد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les événements récurrents et sur plusieurs jours ne peuvent pas être déplacés ni redimensionnés dans la grille du calendrier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לגרור אירועים חוזרים ואירועים של כמה ימים או לשנות את גודלם ברשת לוח השנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलेंडर ग्रिड में दोहराए जाने वाले और कई दिनों के इवेंट को न खींचा जा सकता है, न उनका आकार बदला जा सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Acara berulang dan acara yang berlangsung beberapa hari tidak dapat diseret atau diubah ukurannya di kisi kalender."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli eventi ripetuti e di più giorni non possono essere trascinati né ridimensionati nella griglia del calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "繰り返しイベントや複数日のイベントは、カレンダーのグリッド上でドラッグやサイズ変更ができません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반복 이벤트와 여러 날에 걸친 이벤트는 캘린더 격자에서 끌거나 크기를 조절할 수 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दिनदर्शिका ग्रिडमध्ये पुनरावृत्ती होणारे आणि अनेक दिवसांचे इव्हेंट ड्रॅग किंवा रीसाइझ करता येत नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peristiwa berulang dan peristiwa berbilang hari tidak dapat diseret atau diubah saiz dalam grid kalendar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhaalde en meerdaagse activiteiten kunnen in het agendaraster niet worden gesleept of in grootte worden aangepast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydarzeń cyklicznych i wielodniowych nie można przeciągać ani zmieniać ich rozmiaru w siatce kalendarza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eventos recorrentes e de vários dias não podem ser arrastados nem redimensionados na grade do calendário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Evenimentele repetitive și cele pe mai multe zile nu pot fi trase sau redimensionate în grila calendarului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторяющиеся и многодневные события нельзя перетаскивать или изменять по размеру в сетке календаря."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கேலண்டர் கிரிட்டில் தொடர் நிகழ்வுகளையும் பல நாள் நிகழ்வுகளையும் இழுக்கவோ அளவை மாற்றவோ முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "క్యాలెండర్ గ్రిడ్‌లో పునరావృతమయ్యే మరియు బహుళ-రోజుల ఇవెంట్‌లను డ్రాగ్ చేయడం లేదా రీసైజ్ చేయడం సాధ్యం కాదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถลากหรือปรับขนาดกิจกรรมทำประจำและกิจกรรมหลายวันในตารางปฏิทินได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yinelenen ve birden fazla günlük etkinlikler takvim ızgarasında sürüklenemez veya yeniden boyutlandırılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторювані та багатоденні події не можна перетягувати або змінювати їхній розмір у сітці календаря."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دہرائے جانے والے اور کئی دن کے ایونٹس کو کیلنڈر گرڈ میں گھسیٹا یا ان کا سائز تبدیل نہیں کیا جا سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể kéo hoặc đổi kích thước sự kiện lặp lại và sự kiện kéo dài nhiều ngày trong lưới lịch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重复和跨天日程无法在日历网格中拖动或调整大小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重複事件與跨多天的事件無法在行事曆網格中拖移或調整大小。"
          }
        }
      }
    },
    "calendar.weekgrid.edit_hint.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح نافذة الحدث لتعديل تفاصيل التكرار أو الأيام المتعددة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পুনরাবৃত্ত বা একাধিক দিনের বিবরণ এডিট করতে ইভেন্ট শিট খুলুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne das Ereignisfenster, um Details von Ereignisserien oder mehrtägigen Ereignissen zu bearbeiten"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε το φύλλο γεγονότος για να επεξεργαστείτε λεπτομέρειες επαναλαμβανόμενων γεγονότων ή γεγονότων πολλών ημερών"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the event sheet to edit recurring or multi-day details"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el editor de eventos para editar los detalles de eventos recurrentes o de varios días"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای ویرایش جزئیات تکرار یا چندروزه، برگه‌ی رویداد را باز کنید"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez la fenêtre de l’événement pour modifier les détails d’un événement récurrent ou sur plusieurs jours"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לפתוח את גיליון האירוע כדי לערוך פרטים של אירוע חוזר או של כמה ימים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोहराव या कई दिनों का ब्योरा संपादित करने के लिए इवेंट शीट खोलें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka lembar acara untuk mengedit detail acara berulang atau acara beberapa hari"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri la finestra dell’evento per modificare i dettagli di eventi ripetuti o di più giorni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イベントシートを開いて、繰り返しや複数日の詳細を編集します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이벤트 시트를 열어 반복 또는 여러 날 세부 정보를 편집합니다"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनरावृत्ती होणारा किंवा अनेक दिवसांचा तपशील संपादित करण्यासाठी इव्हेंट शीट उघडा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka helaian peristiwa untuk mengedit butiran peristiwa berulang atau berbilang hari"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open het activiteitenvenster om herhaalde of meerdaagse gegevens te wijzigen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szczegóły wydarzenia cyklicznego lub wielodniowego edytujesz w formularzu wydarzenia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra a janela do evento para editar os detalhes de eventos recorrentes ou de vários dias"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschideți fereastra evenimentului pentru a edita detaliile evenimentelor repetitive sau pe mai multe zile"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменить параметры повторяющегося или многодневного события можно в форме события"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடர் அல்லது பல நாள் விவரங்களைத் திருத்த நிகழ்வுத் தாளைத் திறக்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పునరావృత లేదా బహుళ-రోజుల వివరాలను ఎడిట్ చేయడానికి ఇవెంట్ షీట్‌ను తెరవండి"
          }
        },
        "th": {
