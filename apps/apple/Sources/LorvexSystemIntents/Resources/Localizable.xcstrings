            "value": "%@、同期バックエンド：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, 동기화 백엔드: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, synchronizacja: %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, serviço de sincronização %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, синхронизация: %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, синхронізація: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，同步后端 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，同步後端：%@"
          }
        }
      }
