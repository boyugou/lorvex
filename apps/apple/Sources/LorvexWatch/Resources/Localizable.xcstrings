    "watch.delivery.journal_failure.hint": {
      "comment": "Accessibility recovery hint when the durable watch command journal cannot be opened",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Lorvex على iPhone، ثم أعد فتح تطبيق الساعة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Lorvex auf dem iPhone und dann die Watch-App erneut"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Lorvex on iPhone, then reopen the watch app"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Lorvex en el iPhone y vuelve a abrir la app del reloj"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه Lorvex را در iPhone باز کنید و سپس برنامه ساعت را دوباره باز کنید"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Lorvex sur l’iPhone, puis rouvrez l’app de la montre"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לפתוח את Lorvex ב-iPhone ואז לפתוח מחדש את אפליקציית השעון"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone पर Lorvex खोलें, फिर वॉच ऐप को दोबारा खोलें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Lorvex di iPhone, lalu buka kembali app di Apple Watch"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Lorvex su iPhone, poi riapri l’app dell’orologio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneでLorvexを開いてから、Apple WatchのAppを開き直してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 Lorvex를 연 다음 Apple Watch 앱을 다시 여세요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Lorvex pada iPhone, kemudian buka semula app pada Apple Watch"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Lorvex op je iPhone en open daarna de Watch-app opnieuw"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Lorvex na iPhonie, a potem ponownie otwórz aplikację na zegarku"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Lorvex no iPhone e reabra o app do relógio"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschideți Lorvex pe iPhone, apoi redeschideți aplicația de pe ceas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Lorvex на iPhone, затем снова откройте приложение на часах"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте Lorvex на iPhone, а потім знову відкрийте програму на годиннику"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے iPhone پر Lorvex کھولیں، پھر واچ ایپ دوبارہ کھولیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy mở Lorvex trên iPhone, rồi mở lại ứng dụng trên Apple Watch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上打开 Lorvex，然后重新打开手表 App"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在 iPhone 上開啟 Lorvex，再重新開啟 Apple Watch 上的 App"
          }
        }
      }
    },
