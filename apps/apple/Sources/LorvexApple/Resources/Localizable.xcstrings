    "settings.cloud_sync.restart_detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيسري وضع المزامنة المحدد بالكامل بعد إعادة تشغيل Lorvex."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der ausgewählte Synchronisierungsmodus wird nach einem Neustart von Lorvex vollständig wirksam."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected sync mode will fully take effect after restarting Lorvex."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo de sincronización seleccionado surtirá efecto por completo tras reiniciar Lorvex."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حالت همگام‌سازی انتخاب‌شده پس از راه‌اندازی مجدد Lorvex به‌طور کامل اعمال می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode de synchronisation sélectionné sera pleinement actif après le redémarrage de Lorvex."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצב הסנכרון שנבחר ייכנס לתוקף במלואו לאחר הפעלה מחדש של Lorvex."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुना गया सिंक मोड Lorvex को दोबारा शुरू करने के बाद पूरी तरह लागू होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità di sincronizzazione selezionata avrà pieno effetto dopo il riavvio di Lorvex."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した同期モードは、Lorvexを再起動すると完全に反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 동기화 모드는 Lorvex를 다시 시작하면 완전히 적용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De geselecteerde synchronisatiemodus wordt volledig van kracht nadat Lorvex opnieuw is gestart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrany tryb synchronizacji zacznie w pełni działać po ponownym uruchomieniu Lorvex."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo de sincronização selecionado entrará totalmente em vigor após reiniciar o Lorvex."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modul de sincronizare selectat va avea efect complet după repornirea Lorvex."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранный режим синхронизации полностью вступит в силу после перезапуска Lorvex."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибраний режим синхронізації повністю набуде чинності після перезапуску Lorvex."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب سنک موڈ Lorvex دوبارہ شروع کرنے کے بعد مکمل طور پر نافذ ہو گا۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选同步模式将在重启 Lorvex 后完全生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新啟動 Lorvex 後，所選的同步模式才會完全生效。"
          }
        }
      }
    },
