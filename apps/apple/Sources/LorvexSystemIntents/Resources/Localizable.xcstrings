    "system.task.reminders.due.read.none_dialog": {
      "comment": "Siri dialog when no task reminder has come due",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد تذكيرات مستحقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো রিমাইন্ডারের সময় হয়নি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Erinnerungen sind fällig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έφτασε η ώρα καμίας υπόμνησης."
          }
