    "recurring_cancel.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد إلغاء هذا التكرار فقط، أم إنهاء سلسلة التكرار بالكامل؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু এইবারের টাস্ক বাতিল করবেন, নাকি পুরো পুনরাবৃত্ত সিরিজ শেষ করবেন?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur diese Wiederholung abbrechen oder die gesamte Serie beenden?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Να ακυρωθεί μόνο αυτή η επανάληψη ή να τερματιστεί ολόκληρη η σειρά επαναλήψεων;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel only this occurrence, or end the whole repeating series?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cancelar solo esta repetición o terminar toda la serie?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط همین تکرار لغو شود یا کل مجموعه تکرارشونده پایان یابد؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler uniquement cette occurrence ou mettre fin à toute la série ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לבטל רק את המופע הזה או לסיים את כל הסדרה החוזרת?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल इस बार का कार्य रद्द करें, या पूरी दोहराई जाने वाली श्रृंखला समाप्त करें?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batalkan hanya kejadian ini, atau akhiri seluruh rangkaian pengulangan?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annullare solo questa occorrenza o terminare l’intera serie ricorrente?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今回分のみキャンセルしますか？それとも繰り返し全体を終了しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 반복만 취소하시겠습니까, 아니면 반복 전체를 종료하시겠습니까?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फक्त यावेळचे कार्य रद्द करायचे, की संपूर्ण पुनरावृत्ती मालिका संपवायची?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Batalkan hanya kejadian ini, atau tamatkan keseluruhan siri perulangan?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen deze herhaling annuleren, of de hele reeks beëindigen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulować tylko to wystąpienie czy całą serię?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar somente esta ocorrência ou encerrar toda a série recorrente?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulați doar această apariție sau încheiați întreaga serie repetitivă?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить только это повторение или всю серию?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த நேர்வை மட்டும் ரத்துசெய்யவா, அல்லது மீண்டும் நிகழும் முழுத் தொடரையும் முடிக்கவா?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ సందర్భాన్ని మాత్రమే రద్దు చేయాలా, లేదా మొత్తం పునరావృత సిరీస్‌ను ముగించాలా?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องการยกเลิกเฉพาะครั้งนี้ หรือยุติการทำประจำทั้งชุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu yineleme mi iptal edilsin, yoksa yinelenen serinin tamamı mı sonlandırılsın?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасувати лише це повторення чи всю серію?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف یہی تکرار منسوخ کریں یا پوری دہرائی جانے والی سیریز ختم کریں؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ hủy lần lặp này, hay kết thúc toàn bộ các lần lặp?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只取消这一次，还是结束整个重复系列？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要只取消這一次，還是結束整個重複系列？"
          }
        }
      }
    },
