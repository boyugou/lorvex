    "task_detail.checklist.empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف أول عنصر إلى قائمة التحقق لتقسيم هذه المهمة إلى خطوات ملموسة."
