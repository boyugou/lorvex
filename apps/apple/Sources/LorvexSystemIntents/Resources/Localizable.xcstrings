            "state": "translated",
            "value": "สร้างงาน Lorvex หลายรายการจากชื่อเรื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlıklardan birden fazla Lorvex görevi oluşturun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створює кілька завдань Lorvex за назвами."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوانات سے متعدد Lorvex کام بنائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo nhiều nhiệm vụ Lorvex từ các tiêu đề."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据标题批量创建多个 Lorvex 任务。"
          }
