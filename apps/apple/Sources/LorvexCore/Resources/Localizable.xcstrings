    "recurrence.anchor.schedule.hint": {
      "comment": "One line beneath the repeat editor's anchor control, explaining “Regularly”.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتكرر وفق جدول ثابت، بغض النظر عن وقت إنهائك لها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যখনই শেষ করুন না কেন, নির্দিষ্ট সময়সূচি অনুযায়ী পুনরাবৃত্ত হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederholt sich nach festem Zeitplan, unabhängig davon, wann du fertig wirst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαναλαμβάνεται με σταθερό πρόγραμμα, ανεξάρτητα από το πότε ολοκληρώνετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeats on a fixed schedule, regardless of when you finish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se repite según un calendario fijo, sin importar cuándo termines."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با زمان‌بندی ثابت تکرار می‌شود، صرف‌نظر از اینکه چه زمانی تمامش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se répète selon un calendrier fixe, quel que soit le moment où vous terminez la tâche."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חוזר לפי לוח זמנים קבוע, בלי קשר למועד ההשלמה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तय शेड्यूल पर दोहराता है, चाहे आप इसे कभी भी पूरा करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berulang sesuai jadwal tetap, kapan pun tugas diselesaikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ripete secondo una pianificazione fissa, indipendentemente da quando finisci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了した日にかかわらず、決まったスケジュールで繰り返します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료 시점과 관계없이 정해진 일정에 따라 반복됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही केव्हाही पूर्ण केले तरी ठराविक वेळापत्रकानुसार पुनरावृत्ती होते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berulang mengikut jadual tetap, tidak kira bila tugas diselesaikan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhaalt volgens een vast schema, ongeacht wanneer je klaar bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powtarza się według stałego harmonogramu, niezależnie od tego, kiedy ukończysz zadanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repete em um cronograma fixo, independentemente de quando você terminar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se repetă după un program fix, indiferent de momentul în care terminați."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторяется по фиксированному расписанию независимо от того, когда вы выполните задачу."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் எப்போது முடித்தாலும், நிலையான அட்டவணைப்படி மீண்டும் நிகழும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఎప్పుడు పూర్తి చేసినా, నిర్ణీత షెడ్యూల్ ప్రకారం రిపీట్ అవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำประจำตามกำหนดคงที่ ไม่ว่าคุณจะทำเสร็จเมื่อใด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne zaman bitirdiğinizden bağımsız olarak sabit bir takvimle yinelenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторюється за фіксованим розкладом незалежно від того, коли ви виконаєте завдання."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقررہ شیڈول پر دہرایا جاتا ہے، چاہے آپ اسے کبھی بھی مکمل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lặp lại theo lịch cố định, bất kể khi nào hoàn thành."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按固定计划重复，与你何时完成无关。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無論你何時完成，都會依固定的排程重複。"
          }
        }
      }
    },
