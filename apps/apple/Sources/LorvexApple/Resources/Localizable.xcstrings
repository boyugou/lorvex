    "calendar.week.unauthorized.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل الوصول إلى التقويم في إعدادات النظام لعرض أحداثك هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere in den Systemeinstellungen den Zugriff auf Kalender, um deine Ereignisse hier zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Calendar access in System Settings to see your events here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el acceso al calendario en Ajustes del Sistema para ver tus eventos aquí."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای دیدن رویدادهایتان در اینجا، دسترسی به تقویم را در تنظیمات سیستم روشن کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez l’accès au calendrier dans Réglages Système pour voir vos événements ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להפעיל את הגישה ללוח השנה בהגדרות המערכת כדי לראות כאן את האירועים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने इवेंट यहाँ देखने के लिए सिस्टम सेटिंग्ज़ में कैलेंडर एक्सेस चालू करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva l’accesso al calendario in Impostazioni di Sistema per vedere qui i tuoi eventi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定」でカレンダーへのアクセスをオンにすると、ここにイベントが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 캘린더 접근을 켜면 여기에서 이벤트를 볼 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel toegang tot je agenda in via Systeeminstellingen om je activiteiten hier te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz dostęp do Kalendarza w Ustawieniach systemowych, aby zobaczyć tutaj swoje wydarzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o acesso ao calendário em Ajustes do Sistema para ver seus eventos aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activați accesul la calendar în Configurări sistem pentru a vedea aici evenimentele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите доступ к календарю в Системных настройках, чтобы видеть здесь свои события."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть доступ до календаря в Системних параметрах, щоб бачити тут свої події."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہاں اپنے ایونٹس دیکھنے کے لیے سسٹم کی ترتیبات میں کیلنڈر تک رسائی آن کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置中开启日历访问权限即可在此查看你的事件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「系統設定」中開啟行事曆存取權限，即可在這裡查看你的事件。"
