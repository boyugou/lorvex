          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束时间必须晚于开始时间"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束時間必須晚於開始時間"
