    "habit_detail.weekdays.empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر نمطك الأسبوعي هنا بعد أسبوعين من التسجيلات."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your weekly pattern shows here after two weeks of check-ins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu patrón semanal aparecerá aquí tras dos semanas de registros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre rythme hebdomadaire s’affiche ici après deux semaines de validations."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दो सप्ताह के चेक-इन के बाद आपका साप्ताहिक पैटर्न यहाँ दिखेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo ritmo settimanale apparirà qui dopo due settimane di registrazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェックインが2週間たまると、曜日ごとのパターンがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2주 동안 체크인하면 요일별 패턴이 여기에 표시됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój tygodniowy rytm pojawi się tutaj po dwóch tygodniach odhaczeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu ritmo semanal aparece aqui depois de duas semanas de registros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появится ваш недельный ритм после двух недель отметок."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут з’явиться ваш тижневий ритм після двох тижнів позначок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打卡满两周后，这里会显示你一周里的规律。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "累積兩週的打卡紀錄後，這裡會顯示你每週的規律。"
          }
        }
      }
    },
    "habit_detail.weekdays.even": {
      "extractionState": "manual",
      "localizations": {
