    "dependency.no_candidates.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مهام أخرى غير مكتملة يمكن الاعتماد عليها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্ভর করার মতো আর কোনো বাকি টাস্ক নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keine weiteren offenen Aufgaben, von denen diese Aufgabe abhängen kann."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν άλλες ανοιχτές εργασίες για προσθήκη ως εξάρτηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no other open tasks to depend on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay otras tareas pendientes de las que depender."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کار باز دیگری برای وابستگی وجود ندارد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a pas d’autre tâche à faire dont dépendre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין משימות פתוחות אחרות שאפשר להתלות בהן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्भर रहने के लिए कोई अन्य लंबित कार्य नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada tugas lain yang belum selesai untuk dijadikan dependensi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono altre attività da fare da cui dipendere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依存先にできる未完了のタスクが他にありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의존 대상으로 지정할 수 있는 다른 미완료 할 일이 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अवलंबून राहण्यासाठी दुसरे कोणतेही प्रलंबित कार्य नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada tugas lain yang belum selesai untuk dijadikan kebergantungan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen andere open taken waarvan deze taak kan afhangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak innych zadań do zrobienia, od których można zależeć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há outras tarefas pendentes das quais depender."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu există alte sarcini de făcut de care această sarcină să depindă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет других невыполненных задач, от которых можно зависеть."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சார்ந்திருக்க வேறு நிலுவைப் பணிகள் எதுவும் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆధారపడటానికి ఇతర పెండింగ్ టాస్క్‌లు ఏవీ లేవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีงานอื่นที่ยังไม่เสร็จให้เพิ่มเป็นงานที่ต้องรอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağımlılık olarak eklenebilecek başka açık görev yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає інших невиконаних завдань, від яких можна залежати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
