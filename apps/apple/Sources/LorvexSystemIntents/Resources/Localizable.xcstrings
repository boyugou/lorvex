    "system.habit.reminder_policies.read.description": {
      "comment": "Description for the Read Lorvex Habit Reminder Policies App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة قواعد التذكير لعادة في Lorvex."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read reminder policies for a Lorvex habit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee las reglas de recordatorio de un hábito de Lorvex."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit les règles de rappel d’une habitude de Lorvex."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex आदत की रिमाइंडर नीतियाँ पढ़ें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge le regole di promemoria di un’abitudine di Lorvex."
