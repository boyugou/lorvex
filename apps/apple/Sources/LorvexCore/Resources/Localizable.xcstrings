    "import.error.newer_version": {
      "comment": "Shown when the backup chosen for import was written by a newer version of Lorvex than the one running.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُنشئت هذه النسخة الاحتياطية بإصدار أحدث من Lorvex. حدِّث Lorvex على هذا الجهاز، ثم حاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ব্যাকআপটি Lorvex-এর একটি নতুন ভার্সন দিয়ে তৈরি করা হয়েছে। এই ডিভাইসে Lorvex আপডেট করুন, তারপর আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Backup wurde mit einer neueren Version von Lorvex erstellt. Aktualisiere Lorvex auf diesem Gerät und versuche es dann erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το αντίγραφο ασφαλείας δημιουργήθηκε από νεότερη έκδοση του Lorvex. Ενημερώστε το Lorvex σε αυτή τη συσκευή και δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup was made by a newer version of Lorvex. Update Lorvex on this device, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia de seguridad se creó con una versión más reciente de Lorvex. Actualiza Lorvex en este dispositivo e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این پشتیبان با نسخه‌ای جدیدتر از Lorvex ساخته شده است. Lorvex را در این دستگاه به‌روزرسانی کنید و دوباره تلاش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sauvegarde a été créée par une version plus récente de Lorvex. Mettez à jour Lorvex sur cet appareil, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגיבוי הזה נוצר בגרסה חדשה יותר של Lorvex. יש לעדכן את Lorvex במכשיר הזה ולנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह बैकअप Lorvex के नए संस्करण से बनाया गया था। इस डिवाइस पर Lorvex अपडेट करें, फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadangan ini dibuat oleh versi Lorvex yang lebih baru. Perbarui Lorvex di perangkat ini, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo backup è stato creato con una versione più recente di Lorvex. Aggiorna Lorvex su questo dispositivo, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックアップは、より新しいバージョンのLorvexで作成されました。このデバイスでLorvexをアップデートしてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 백업은 더 새로운 버전의 Lorvex에서 만들어졌습니다. 이 기기에서 Lorvex를 업데이트한 후 다시 시도하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा बॅकअप Lorvex च्या नवीन व्हर्जनने तयार केला होता. या डिव्हाइसवर Lorvex अपडेट करा आणि मग पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sandaran ini dibuat oleh versi Lorvex yang lebih baharu. Kemas kini Lorvex pada peranti ini, kemudian cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze back-up is gemaakt met een nieuwere versie van Lorvex. Werk Lorvex bij op dit apparaat en probeer het daarna opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta kopia zapasowa została utworzona przez nowszą wersję Lorvex. Zaktualizuj Lorvex na tym urządzeniu i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este backup foi criado por uma versão mais recente do Lorvex. Atualize o Lorvex neste dispositivo e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această copie de rezervă a fost creată cu o versiune mai nouă a Lorvex. Actualizați Lorvex pe acest dispozitiv, apoi încercați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта резервная копия создана более новой версией Lorvex. Обновите Lorvex на этом устройстве и повторите попытку."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் பேக்-அப் Lorvexஇன் புதிய பதிப்பால் உருவாக்கப்பட்டது. இந்தச் சாதனத்தில் Lorvexஐப் புதுப்பித்து, மீண்டும் முயலவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ బ్యాకప్ Lorvex కొత్త వెర్షన్‌తో రూపొందించబడింది. ఈ డివైజ్‌లో Lorvexను అప్‌డేట్ చేసి, మళ్ళీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลสำรองนี้สร้างโดย Lorvex เวอร์ชั่นที่ใหม่กว่า อัปเดต Lorvex บนอุปกรณ์เครื่องนี้ แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yedek, Lorvex’in daha yeni bir sürümüyle oluşturulmuş. Bu aygıtta Lorvex’i güncelleyin, sonra yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю резервну копію створено новішою версією Lorvex. Оновіть Lorvex на цьому пристрої та спробуйте знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ بیک اپ Lorvex کے نئے ورژن سے بنایا گیا تھا۔ اس ڈیوائس پر Lorvex اپ ڈیٹ کریں، پھر دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao lưu này được tạo bởi phiên bản Lorvex mới hơn. Hãy cập nhật Lorvex trên thiết bị này rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此备份由较新版本的 Lorvex 创建。请先在此设备上更新 Lorvex，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此備份是由較新版本的 Lorvex 建立的。請先在此裝置上更新 Lorvex，然後再試一次。"
          }
        }
      }
    },
    "import.error.no_data": {
