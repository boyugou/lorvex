        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Panjang rentetan dalam hari, contohnya 30. Tabiat ini terus berjalan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lengte van de reeks in dagen, bijvoorbeeld 30. De gewoonte gaat door."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Długość serii w dniach, np. 30. Nawyk trwa dalej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Duração da sequência em dias, como 30. O hábito continua."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lungimea seriei în zile, de exemplu 30. Obiceiul continuă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Длина серии в днях, например 30. Привычка продолжается."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நாட்களில் ஸ்ட்ரீக் நீளம், எ.கா. 30. பழக்கம் தொடரும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రోజుల్లో స్ట్రీక్ పొడవు, ఉదా. 30. అలవాటు కొనసాగుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความยาวสถิติต่อเนื่องเป็นวัน เช่น 30 วัน นิสัยนี้จะดำเนินต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gün olarak seri uzunluğu (örneğin 30). Alışkanlık devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тривалість серії в днях, наприклад 30. Звичка триває."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تسلسل کی لمبائی دنوں میں، جیسے 30۔ عادت جاری رہتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Độ dài chuỗi tính theo ngày, ví dụ 30. Thói quen vẫn tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连续天数，例如 30。习惯会继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連續天數，例如 30。習慣仍會持續。"
          }
        }
      }
    },
