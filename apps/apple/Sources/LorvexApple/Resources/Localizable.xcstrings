        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין אין הערות AI. העוזר שלך מוסיף כאן הערות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई AI नोट नहीं। आपका असिस्टेंट नोट यहाँ जोड़ता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada catatan AI. Asisten menambahkan catatan di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna nota dell’IA. Il tuo assistente aggiunge le note qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIのメモはまだありません。アシスタントがここにメモを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 AI 메모가 없습니다. 어시스턴트가 여기에 메모를 추가합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अजून AI नोट्स नाहीत. तुमचा सहाय्यक येथे नोट्स जोडतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada nota AI. Pembantu AI anda menambahkan nota di sini."
          }
