    "calendar.delete_event.scope.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر حالات التكرار التي تريد حذفها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which occurrences to delete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué repeticiones eliminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les occurrences à supprimer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि कौन-से इवेंट हटाने हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quali occorrenze eliminare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除するイベントの範囲を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제할 범위를 선택하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, które wystąpienia usunąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quais ocorrências excluir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, какие повторения удалить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть, які повторення видалити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择要删除哪些重复项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇要刪除的範圍。"
          }
        }
      }
    },
