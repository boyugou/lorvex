    "watch.delivery.rejection.conflict": {
      "comment": "Reason shown when an iPhone rejects a queued action because newer data conflicts",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعارض هذا الإجراء مع تغييرات أحدث."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aktion steht im Konflikt mit neueren Änderungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action conflicts with newer changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción entra en conflicto con cambios más recientes."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این اقدام با تغییرات جدیدتر تضاد دارد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action est en conflit avec des modifications plus récentes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעולה הזו מתנגשת בשינויים חדשים יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कार्रवाई नए बदलावों से टकराती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan ini bertentangan dengan perubahan yang lebih baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione è in conflitto con modifiche più recenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は、より新しい変更と競合しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 동작이 더 최근의 변경 사항과 충돌합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan ini bercanggah dengan perubahan yang lebih baharu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze actie conflicteert met nieuwere wijzigingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta akcja jest w konflikcie z nowszymi zmianami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação entra em conflito com alterações mais recentes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această acțiune intră în conflict cu modificări mai recente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это действие конфликтует с более новыми изменениями."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця дія конфліктує з новішими змінами."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ اقدام زیادہ نئی تبدیلیوں سے ٹکراتا ہے۔"
          }
        },
