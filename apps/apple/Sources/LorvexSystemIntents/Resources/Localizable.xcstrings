            "state": "translated",
            "value": "یک تاریخ تکرار برای کار «%@» رد شد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une occurrence de « %@ » ignorée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דולג תאריך חזרה אחד של \"%@\"."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
