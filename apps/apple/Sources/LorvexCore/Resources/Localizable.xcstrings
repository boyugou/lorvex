    "error.storage_unavailable": {
      "comment": "Shown when Lorvex cannot use its database at all, so trying again will not help.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع Lorvex الوصول إلى مساحة تخزين بياناته، لذا تعذّر إكمال هذا الإجراء. يُرجى إعادة تشغيل Lorvex."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex kann nicht auf seinen Datenspeicher zugreifen, daher konnte dies nicht abgeschlossen werden. Bitte starte Lorvex neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex can’t access its data storage, so this couldn’t be completed. Please restart Lorvex."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex no puede acceder a su almacenamiento de datos, así que no se pudo completar la acción. Reinicia Lorvex."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه Lorvex نمی‌تواند به فضای ذخیره‌سازی داده‌های خود دسترسی پیدا کند، بنابراین عملیات کامل نشد. لطفاً Lorvex را دوباره راه‌اندازی کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex ne peut pas accéder à son stockage de données. L’opération n’a donc pas pu aboutir. Redémarrez Lorvex."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין ל-Lorvex גישה לאחסון הנתונים שלו, ולכן לא ניתן היה להשלים את הפעולה. יש להפעיל מחדש את Lorvex."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex अपने डेटा स्टोरेज तक नहीं पहुँच सकता, इसलिए यह पूरा नहीं हो सका। कृपया Lorvex को दोबारा शुरू करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex non riesce ad accedere al proprio archivio dati, quindi non è stato possibile completare l’operazione. Riavvia Lorvex."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexがデータ保存領域にアクセスできないため、この操作を完了できませんでした。Lorvexを再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex가 데이터 저장소에 접근할 수 없어 작업을 완료하지 못했습니다. Lorvex를 다시 시작하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex heeft geen toegang tot de gegevensopslag, dus dit kon niet worden voltooid. Start Lorvex opnieuw op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex nie ma dostępu do magazynu danych, więc nie można było tego zakończyć. Uruchom Lorvex ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lorvex não consegue acessar o armazenamento de dados, então não foi possível concluir a operação. Reinicie o Lorvex."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex nu poate accesa spațiul de stocare a datelor, deci acțiunea nu a putut fi finalizată. Reporniți Lorvex."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex не может получить доступ к хранилищу данных, поэтому действие не выполнено. Перезапустите Lorvex."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex не може отримати доступ до сховища даних, тому дію не виконано. Перезапустіть Lorvex."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے ڈیٹا اسٹوریج تک رسائی حاصل نہیں ہو سکی، اس لیے یہ عمل مکمل نہیں ہو سکا۔ براہ کرم Lorvex دوبارہ شروع کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 无法访问其数据存储，因此无法完成此操作。请重新启动 Lorvex。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 無法存取其資料儲存空間，因此無法完成此操作。請重新啟動 Lorvex。"
          }
        }
      }
    },
