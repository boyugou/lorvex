    "settings.cloud_sync.account.no_account_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد حساب iCloud. سجّل الدخول من إعدادات النظام > حساب Apple."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো iCloud অ্যাকাউন্ট নেই। সিস্টেম সেটিংস > Apple অ্যাকাউন্ট থেকে সাইন ইন করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein iCloud-Account. Melde dich über Systemeinstellungen > Apple Account an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει λογαριασμός iCloud. Συνδεθείτε από τις Ρυθμίσεις συστήματος > Λογαριασμός Apple."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No iCloud account. Sign in via System Settings > Apple Account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna cuenta de iCloud. Inicia sesión en Ajustes del Sistema > Cuenta de Apple."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب iCloud وجود ندارد. از طریق تنظیمات سیستم > Apple Account وارد شوید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte iCloud. Connectez-vous dans Réglages Système > Compte Apple."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין חשבון iCloud. יש להיכנס דרך הגדרות המערכת > חשבון Apple."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई iCloud खाता नहीं है। सिस्टम सेटिंग्ज़ > Apple Account में साइन इन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada akun iCloud. Masuk melalui Pengaturan Sistem > Akun Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun account iCloud. Accedi da Impostazioni di Sistema > Account Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudアカウントがありません。「システム設定」>「Apple Account」でサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 계정이 없습니다. 시스템 설정 > Apple 계정에서 로그인하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud अकाउंट नाही. सिस्टीम सेटिंग > Apple अकाउंट मधून साइन इन करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada akaun iCloud. Daftar masuk melalui Seting Sistem > Akaun Apple."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen iCloud-account. Log in via Systeeminstellingen > Apple Account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak konta iCloud. Zaloguj się w Ustawieniach systemowych > Konto Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma conta do iCloud. Entre em Ajustes do Sistema > Conta Apple."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Niciun cont iCloud. Autentificați-vă din Configurări sistem > Cont Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет учётной записи iCloud. Войдите через «Системные настройки» > «Аккаунт Apple»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud கணக்கு இல்லை. சிஸ்டம் அமைப்புகள் > Apple கணக்கு வழியாக உள்நுழையவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ఖాతా లేదు. సిస్టమ్ సెట్టింగ్స్ > Apple ఖాతా ద్వారా సైన్ ఇన్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีบัญชี iCloud ลงชื่อเข้าผ่านการตั้งค่าระบบ > บัญชี Apple"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud hesabı yok. Sistem Ayarları > Apple Hesabı üzerinden giriş yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає облікового запису iCloud. Увійдіть через «Системні параметри» > «Обліковий запис Apple»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی iCloud اکاؤنٹ نہیں۔ سسٹم کی ترتیبات > Apple Account کے ذریعے سائن اِن کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có tài khoản iCloud. Hãy đăng nhập qua Cài đặt hệ thống > Tài khoản Apple."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有 iCloud 账户。请在“系统设置”>“Apple 账户”中登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有 iCloud 帳號。請前往「系統設定」>「Apple 帳號」登入。"
          }
        }
      }
    },
