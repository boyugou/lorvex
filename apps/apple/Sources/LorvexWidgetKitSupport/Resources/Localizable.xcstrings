    "widget.habits.desc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطّلع على تقدم عاداتك اليوم بنظرة سريعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজকের অভ্যাসের অগ্রগতি এক নজরে দেখুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh den Fortschritt deiner Gewohnheiten von heute auf einen Blick."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δείτε με μια ματιά την πρόοδο των συνηθειών σας για σήμερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See today’s habit progress at a glance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta de un vistazo el progreso de tus hábitos de hoy."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیشرفت عادت‌های امروز را با یک نگاه ببینید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez d’un coup d’œil la progression de vos habitudes du jour."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מבט מהיר על ההתקדמות בהרגלים של היום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज की आदतों की प्रगति एक नज़र में देखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat kemajuan kebiasaan hari ini sekilas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta a colpo d’occhio i progressi delle abitudini di oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の習慣の進捗をひと目で確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 습관 진행 상황을 한눈에 확인하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आजच्या सवयींची प्रगती एका दृष्टिक्षेपात पाहा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat kemajuan tabiat hari ini dengan sekali pandang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zie de voortgang van je gewoontes van vandaag in één oogopslag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledź dzisiejszy postęp nawyków na pierwszy rzut oka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja rapidamente o progresso dos hábitos de hoje."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedeți dintr-o privire progresul obiceiurilor de astăzi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следите за прогрессом привычек на сегодня с одного взгляда."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูความคืบหน้านิสัยของวันนี้ได้ในพริบตา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünkü alışkanlık ilerlemesini tek bakışta görün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стежте за прогресом звичок на сьогодні з одного погляду."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج کی عادات کی پیش رفت ایک نظر میں دیکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem nhanh tiến độ thói quen hôm nay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼查看今天的习惯进度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼看清今天的習慣進度。"
          }
        }
      }
    },
    "widget.habits.fallback": {
      "extractionState": "manual",
      "localizations": {
