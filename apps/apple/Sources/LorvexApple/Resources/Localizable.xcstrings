    "setup.permissions.notifications.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلقَّ تذكيرات المهام كإشعارات من النظام."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
