    "task_detail.tags.hint": {
      "comment": "Hint under the title of the task detail tags picker.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمات تجمع المهام عبر القوائم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে শব্দ বিভিন্ন তালিকার টাস্ককে একসাথে গোছায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wörter, die Aufgaben listenübergreifend gruppieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λέξεις που ομαδοποιούν εργασίες σε όλες τις λίστες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Words that group tasks across lists."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Palabras que agrupan tareas de distintas listas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "واژه‌هایی که کارها را در سراسر فهرست‌ها گروه‌بندی می‌کنند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des mots qui regroupent les tâches entre plusieurs listes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מילים שמקבצות משימות בין רשימות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐसे शब्द जो अलग-अलग सूचियों के कार्यों को समूहित करते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata yang mengelompokkan tugas lintas daftar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parole che raggruppano le attività tra più liste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストをまたいでタスクをまとめるキーワードです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록과 관계없이 할 일을 묶어 주는 단어입니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वेगवेगळ्या याद्यांमधील कार्ये एकत्र गटबद्ध करणारे शब्द."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkataan yang mengumpulkan tugas merentas senarai."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Woorden waarmee je taken over lijsten heen groepeert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słowa, które grupują zadania z różnych list."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Palavras que agrupam tarefas entre listas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuvinte care grupează sarcinile din mai multe liste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слова, объединяющие задачи из разных списков."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பட்டியல்கள் முழுவதும் பணிகளைக் குழுவாக்கும் வார்த்தைகள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "జాబితాలన్నింటిలో టాస్క్‌లను గ్రూప్ చేసే పదాలు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำที่ใช้จัดกลุ่มงานข้ามลิสต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görevleri listeler arasında gruplayan sözcükler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Слова, що групують завдання з різних списків."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایسے الفاظ جو فہرستوں کے آر پار کاموں کو گروپ کرتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các từ dùng để nhóm nhiệm vụ trên nhiều danh sách."
          }
        },
        "zh-Hans": {
