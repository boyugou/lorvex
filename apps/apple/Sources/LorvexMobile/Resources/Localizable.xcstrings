    "habits.row.delete_confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى إزالة سجل إكمالها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অভ্যাসের সম্পন্ন করার হিস্ট্রি মুছে যাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird der Verlauf der Erledigungen entfernt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα διαγραφεί το ιστορικό ολοκληρώσεών της."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes its completion history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará su historial de registros."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخچه تکمیل آن حذف می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime son historique de réalisations."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היסטוריית ההשלמות שלו תימחק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे इसका चेक-इन इतिहास हट जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Riwayat penyelesaiannya akan dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione rimuove la sua cronologia dei completamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了履歴も削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료 기록도 함께 삭제됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "यामुळे या सवयीची पूर्ण केल्याची हिस्ट्री काढून टाकली जाईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejarah penyelesaiannya akan dipadam."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt de geschiedenis van deze gewoonte verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Historia wykonań zostanie usunięta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove o histórico de conclusões do hábito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această acțiune elimină istoricul finalizărilor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История выполнения будет удалена."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது இதை முடித்த வரலாற்றை அகற்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది దీన్ని పూర్తి చేసిన చరిత్రను తొలగిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประวัติการทำสำเร็จของนิสัยนี้จะถูกลบไปด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem, alışkanlığın tamamlanma geçmişini siler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Історію виконання буде видалено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کا تکمیلی تاریخچہ حذف ہو جائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch sử hoàn thành sẽ bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会移除它的完成历史。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這也會移除它的完成紀錄。"
          }
        }
      }
    },
