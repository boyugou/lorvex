          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب کردہ زمروں کی مکمل ٹیبلز کی ایکسپورٹ، JSON، CSV یا ZIP پیکیج کی شکل میں۔"
          }
