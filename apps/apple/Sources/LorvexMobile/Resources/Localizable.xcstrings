        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione si sta aggiornando. Riprova tra un attimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウド同期を更新中です。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 동기화를 업데이트하는 중입니다. 잠시 후 다시 시도하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लाउड सिंक अपडेट होत आहे. थोड्या वेळाने पुन्हा प्रयत्न करा."
