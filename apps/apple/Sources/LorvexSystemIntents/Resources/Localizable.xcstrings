                "stringUnit": {
                  "state": "translated",
                  "value": "%2$@ తేదీన %1$lld టాస్క్‌లకు సమయం ఉంది, మొదటిది %4$@ సమయానికి %3$@."
                }
              }
            }
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันที่ %2$@ มีงานที่กำหนดเวลา %1$lld รายการ รายการแรกคือ %3$@ เวลา %4$@"
          }
        },
        "tr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%2$@ tarihinde saati olan %1$lld görev var: %3$@, saat %4$@."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%2$@ tarihinde saati olan %1$lld görev var. İlki: %3$@, saat %4$@."
                }
              }
            }
          }
        },
        "uk": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "На %2$@ у %1$lld завдань є час, починаючи з «%3$@» о %4$@."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "На %2$@ у %1$lld завдань є час, починаючи з «%3$@» о %4$@."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "На %2$@ у %1$lld завдання є час: «%3$@» о %4$@."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "На %2$@ у %1$lld завдання є час, починаючи з «%3$@» о %4$@."
                }
              }
            }
          }
        },
        "ur": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld کام کا وقت %2$@ پر مقرر ہے: %3$@ %4$@ پر۔"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld کاموں کا وقت %2$@ پر مقرر ہے، پہلا %3$@ %4$@ پر۔"
                }
              }
            }
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld nhiệm vụ có giờ vào %2$@, bắt đầu với %3$@ lúc %4$@."
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%2$@ 有 %1$lld 项任务安排了时间，最早的是 %4$@ 的“%3$@”。"
                }
              }
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@有 %1$lld 個任務已安排時間，第一個是 %4$@ 的「%3$@」。"
          }
        }
      }
    },
    "system.day_times.read.none_dialog": {
      "comment": "Dialog when no task has a time on the day; %@ is the date (YYYY-MM-DD)",
      "extractionState": "manual",
      "localizations": {
