    "setup.done.capture.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط ⁦⌘N⁩ في أي مكان في Lorvex لإضافة مهمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টাস্ক যোগ করতে Lorvex-এর যেকোনো জায়গায় ⌘N চাপুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke in Lorvex überall ⌘N, um eine Aufgabe hinzuzufügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε ⌘N οπουδήποτε στο Lorvex για να προσθέσετε μια εργασία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press ⌘N anywhere in Lorvex to add a task."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa ⌘N en cualquier parte de Lorvex para añadir una tarea."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای افزودن کار، در هر جای Lorvex کلیدهای ⁦⌘N⁩ را بزنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur ⌘N n’importe où dans Lorvex pour ajouter une tâche."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להוסיף משימה, לוחצים על ⁦⌘N⁩ בכל מקום ב-Lorvex."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्य जोड़ने के लिए Lorvex में कहीं भी ⌘N दबाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan ⌘N di mana saja di Lorvex untuk menambahkan tugas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi ⌘N ovunque in Lorvex per aggiungere un’attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexのどこでも⌘Nを押すと、タスクを追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 어디에서든 ⌘N 단축키를 눌러 할 일을 추가하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्य जोडण्यासाठी Lorvex मध्ये कुठेही ⌘N दाबा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan ⌘N di mana-mana dalam Lorvex untuk menambah tugas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk overal in Lorvex op ⌘N om een taak toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij ⌘N w dowolnym miejscu w Lorvex, aby dodać zadanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione ⌘N em qualquer lugar do Lorvex para adicionar uma tarefa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apăsați ⌘N oriunde în Lorvex pentru a adăuga o sarcină."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите ⌘N в любом месте Lorvex, чтобы добавить задачу."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பணியைச் சேர்க்க Lorvexஇல் எங்கிருந்தாலும் ⌘N அழுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "టాస్క్‌ను జోడించడానికి Lorvexలో ఎక్కడైనా ⌘N నొక్కండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กด ⌘N ที่ใดก็ได้ใน Lorvex เพื่อเพิ่มงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görev eklemek için Lorvex’in herhangi bir yerinde ⌘N tuşlarına basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть ⌘N будь-де в Lorvex, щоб додати завдання."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کام شامل کرنے کے لیے Lorvex میں کہیں بھی ⁦⌘N⁩ دبائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn ⌘N ở bất kỳ đâu trong Lorvex để thêm nhiệm vụ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Lorvex 中随时按 ⌘N 添加任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Lorvex 的任何地方按下 ⌘N，即可新增任務。"
          }
        }
      }
    },
    "setup.done.assistant.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أو دع مساعدك يضيفها"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অথবা অ্যাসিস্ট্যান্টকে দিয়ে যোগ করান"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oder lass es deinen Assistenten hinzufügen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ή αφήστε τον βοηθό σας να το προσθέσει"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or let your assistant add it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "O deja que la añada tu asistente"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یا بگذارید دستیارتان اضافه کند"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou laissez votre assistant l’ajouter"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "או לתת לעוזר להוסיף"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "या असिस्टेंट से जुड़वाएँ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atau biarkan asisten menambahkannya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppure lascia che la aggiunga il tuo assistente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "またはアシスタントに追加してもらう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "또는 어시스턴트가 추가하게 하기"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "किंवा सहाय्यकाला जोडू द्या"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Atau biarkan pembantu AI menambahnya"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Of laat je assistent het toevoegen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Albo zleć to asystentowi"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou deixe seu assistente adicionar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau lăsați asistentul să o adauge"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Или поручите ассистенту"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அல்லது உங்கள் அசிஸ்டென்ட்டைக் கொண்டு சேர்க்கலாம்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లేదా మీ అసిస్టెంట్‌తో జోడించండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หรือให้ผู้ช่วยของคุณเพิ่มให้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya da asistanınız eklesin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Або доручіть асистенту"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یا اپنے اسسٹنٹ سے شامل کروائیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoặc để trợ lý thêm giúp"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "或者交给助手"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "或讓助理代為新增"
          }
        }
      }
    },
    "setup.done.assistant.detail": {
      "comment": "Simplified Chinese deliberately names no assistant product here (China mainland App Store review); other languages may name Claude as the example.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اربط Claude أو مساعدًا آخر من الإعدادات ضمن \"المساعد\"، وسيضيف المهام ويخطط يومك معك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেটিংসের অ্যাসিস্ট্যান্ট অংশে Claude বা অন্য কোনো অ্যাসিস্ট্যান্ট কানেক্ট করুন, তাহলে সেটি টাস্ক যোগ করবে এবং আপনার সাথে দিন প্ল্যান করবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde Claude oder einen anderen Assistenten in den Einstellungen unter „Assistent“, und er fügt Aufgaben hinzu und plant deinen Tag mit dir."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδέστε το Claude ή έναν άλλο βοηθό από τις Ρυθμίσεις > Βοηθός και θα προσθέτει εργασίες και θα προγραμματίζει την ημέρα σας μαζί σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect Claude or another assistant in Settings under Assistant, and it adds tasks and plans your day with you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta Claude u otro asistente en Ajustes > Asistente y añadirá tareas y planificará tu día contigo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در تنظیمات، بخش «دستیار»، Claude یا دستیار دیگری را وصل کنید تا کارها را اضافه کند و روزتان را با شما برنامه‌ریزی کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez Claude ou un autre assistant dans Réglages, sous Assistant : il ajoute des tâches et planifie votre journée avec vous."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לחבר את Claude או עוזר אחר בהגדרות, תחת \"עוזר\", והוא יוסיף משימות ויתכנן איתך את היום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्ज़ में असिस्टेंट के अंतर्गत Claude या कोई दूसरा असिस्टेंट जोड़ें, और वह कार्य जोड़ेगा तथा आपके साथ आपका दिन प्लान करेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan Claude atau asisten lain di Pengaturan pada tab Asisten, lalu asisten menambahkan tugas dan merencanakan hari bersama Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega Claude o un altro assistente in Impostazioni, sotto Assistente: aggiungerà attività e pianificherà la giornata con te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」の「アシスタント」でClaudeなどのアシスタントを接続すると、タスクの追加や1日の計画を一緒に行ってくれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정의 어시스턴트에서 Claude 또는 다른 어시스턴트를 연결하면 할 일을 추가하고 하루를 함께 계획해 줍니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंगमधील सहाय्यक विभागात Claude किंवा दुसरा सहाय्यक कनेक्ट करा, म्हणजे तो कार्ये जोडेल आणि तुमच्यासोबत दिवस प्लॅन करेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungkan Claude atau pembantu AI lain dalam Seting di bawah Pembantu AI, dan ia menambah tugas serta merancang hari bersama anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbind Claude of een andere assistent in Instellingen onder ‘Assistent’, en die voegt taken toe en plant je dag met je mee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz Claude lub innego asystenta w Ustawieniach > Asystent, a będzie dodawać zadania i planować dzień razem z tobą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte o Claude ou outro assistente em Ajustes, em Assistente, e ele adiciona tarefas e planeja o seu dia com você."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectați Claude sau un alt asistent din Configurări, la „Asistent”, iar acesta vă adaugă sarcini și vă planifică ziua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите Claude или другого ассистента в разделе «Настройки» > «Ассистент», и он будет добавлять задачи и планировать день вместе с вами."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அமைப்புகளில் அசிஸ்டென்ட் பிரிவில் Claude அல்லது வேறொரு அசிஸ்டென்ட்டை இணைக்கவும்; அது பணிகளைச் சேர்க்கும், உங்களுடன் சேர்ந்து உங்கள் நாளைத் திட்டமிடும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సెట్టింగ్స్‌లో అసిస్టెంట్ విభాగంలో Claude లేదా మరో అసిస్టెంట్‌ను కనెక్ట్ చేయండి; అది టాస్క్‌లను జోడిస్తుంది, మీతో కలిసి మీ రోజును ప్లాన్ చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อ Claude หรือผู้ช่วยอื่นได้ที่การตั้งค่า > ผู้ช่วย แล้วผู้ช่วยจะเพิ่มงานและวางแผนวันของคุณร่วมกับคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar > Asistan bölümünden Claude’u ya da başka bir asistanı bağlayın; görev ekler ve gününüzü sizinle birlikte planlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключіть Claude або іншого асистента в розділі «Параметри» > «Асистент», і він додаватиме завдання та плануватиме день разом із вами."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ترتیبات میں اسسٹنٹ کے تحت Claude یا کوئی اور اسسٹنٹ جوڑیں، وہ کام شامل کرے گا اور آپ کے ساتھ آپ کا دن منصوبہ بنائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối Claude hoặc một trợ lý khác trong Cài đặt, mục Trợ lý, và trợ lý sẽ thêm nhiệm vụ cùng lên kế hoạch cho ngày của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置的“助手”中连接支持 MCP 的 AI 助手，它会替你添加任务，并和你一起规划每一天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「設定」的「助理」中連接 Claude 或其他助理後，它就能新增任務，並與你一起規劃一天。"
          }
        }
      }
    },
