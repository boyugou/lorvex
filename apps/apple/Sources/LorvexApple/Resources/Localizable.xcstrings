    "lists.empty.no_complete_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا القوائم التي اكتملت جميع مهامها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে তালিকার সব টাস্ক সম্পন্ন, তা এখানে দেখা যাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen, in denen alle Aufgaben erledigt sind, erscheinen hier."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι λίστες με όλες τις εργασίες ολοκληρωμένες θα εμφανίζονται εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lists with every task complete will appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las listas con todas las tareas completadas aparecerán aquí."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فهرست‌هایی که همه کارهایشان تکمیل شده اینجا نمایش داده می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les listes dont toutes les tâches sont terminées apparaîtront ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשימות שכל המשימות בהן הושלמו יופיעו כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिन सूचियों के सभी कार्य पूर्ण हैं, वे यहाँ दिखेंगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar yang semua tugasnya selesai akan muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le liste con tutte le attività completate appariranno qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのタスクが完了したリストがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 할 일을 완료한 목록이 여기에 표시됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ज्या याद्यांतील सर्व कार्ये पूर्ण झाली आहेत, त्या येथे दिसतील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Senarai yang semua tugasnya selesai akan dipaparkan di sini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lijsten waarin alle taken zijn voltooid, verschijnen hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj pojawią się listy, w których wszystkie zadania są ukończone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As listas com todas as tarefas concluídas aparecerão aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Listele în care toate sarcinile sunt finalizate vor apărea aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появятся списки, в которых выполнены все задачи."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิสต์ที่งานทั้งหมดเสร็จแล้วจะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm görevleri tamamlanmış listeler burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут з’являться списки, у яких усі завдання виконано."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ فہرستیں جن کے تمام کام مکمل ہوں یہاں نظر آئیں گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các danh sách có tất cả nhiệm vụ đã hoàn thành sẽ xuất hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有任务都已完成的列表会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有任務都已完成的清單會顯示在這裡。"
          }
        }
      }
    },
