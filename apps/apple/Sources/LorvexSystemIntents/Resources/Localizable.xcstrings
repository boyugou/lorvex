    "system.review.daily.save.description": {
      "comment": "Description for the Save Lorvex Daily Review App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حفظ مراجعة يومية في Lorvex من الاختصارات أو Siri."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শর্টকাট বা Siri থেকে Lorvex-এ একটি দৈনিক পর্যালোচনা সেভ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichert einen Tagesrückblick in Lorvex über Kurzbefehle oder Siri."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκεύστε μια ημερήσια ανασκόπηση στο Lorvex από τις Συντομεύσεις ή το Siri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a daily review in Lorvex from Shortcuts or Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda una revisión diaria en Lorvex desde Atajos o Siri."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ذخیره یک مرور روزانه در Lorvex از طریق میان‌برها یا Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre un bilan quotidien dans Lorvex depuis Raccourcis ou Siri."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמירת סקירה יומית ב-Lorvex דרך קיצורי דרך או Siri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट्स या Siri से Lorvex में दैनिक समीक्षा सहेजें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan tinjauan harian di Lorvex dari Pintasan atau Siri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva una revisione giornaliera in Lorvex da Comandi rapidi o Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットまたはSiriでLorvexに毎日の振り返りを保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어 또는 Siri에서 Lorvex에 일일 회고를 저장합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट किंवा Siri द्वारे Lorvex मध्ये एक दैनिक आढावा जतन करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan semakan harian dalam Lorvex daripada Pintasan atau Siri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaart een dagterugblik in Lorvex via Opdrachten of Siri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuje podsumowanie dnia w Lorvex ze Skrótów lub Siri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva uma revisão diária no Lorvex pelos Atalhos ou pela Siri."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvează o recapitulare zilnică în Lorvex prin Scurtături sau Siri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет итоги дня в Lorvex из «Быстрых команд» или Siri."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்கவழிகள் அல்லது Siri மூலம் Lorvexஇல் தினசரி மீள்பார்வையைச் சேமிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "షార్ట్‌కట్స్ లేదా Siri నుండి Lorvexలో రోజువారీ సమీక్షను సేవ్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกการทบทวนรายวันใน Lorvex จากคำสั่งลัดหรือ Siri"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kestirmeler veya Siri ile Lorvex’te bir günlük gözden geçirmeyi kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігає підсумки дня в Lorvex зі «Швидких команд» або Siri."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شارٹ کٹس یا Siri سے Lorvex میں روزانہ جائزہ محفوظ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu một bản tổng kết hàng ngày trong Lorvex từ Phím tắt hoặc Siri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“快捷指令”或 Siri 在 Lorvex 中保存每日回顾。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過捷徑或 Siri 在 Lorvex 中儲存每日回顧。"
          }
        }
      }
    },
