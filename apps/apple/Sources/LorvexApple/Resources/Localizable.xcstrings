    "settings.cloud_sync.account.restricted_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تقييد iCloud بواسطة ملف تعريف إدارة الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ist durch ein Geräteverwaltungsprofil eingeschränkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is restricted by a device management profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud está restringido por un perfil de gestión de dispositivos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرویس iCloud توسط یک نمایه مدیریت دستگاه محدود شده است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud est restreint par un profil de gestion d’appareils."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגישה ל-iCloud הוגבלה על ידי פרופיל ניהול מכשירים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud पर डिवाइस मैनेजमेंट प्रोफ़ाइल द्वारा प्रतिबंध लगा है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud è limitato da un profilo di gestione dei dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudはデバイス管理プロファイルによって制限されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 관리 프로파일에 의해 iCloud가 제한되어 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud wordt beperkt door een profiel voor apparaatbeheer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud jest ograniczony przez profil zarządzania urządzeniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iCloud está restrito por um perfil de gerenciamento de dispositivos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud este restricționat de un profil de gestionare a dispozitivelor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к iCloud ограничен профилем управления устройством."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до iCloud обмежено профілем керування пристроєм."
          }
        },
        "ur": {
