        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ డివైజ్ టైమ్ జోన్‌ను ఉపయోగించండి (%@)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ไทม์โซนของอุปกรณ์เครื่องนี้ (%@)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aygıtın saat dilimini kullan (%@)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовувати часовий пояс цього пристрою (%@)"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ڈیوائس کا ٹائم زون استعمال کریں (%@)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng múi giờ của thiết bị này (%@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改用本设备的时区（%@）"
          }
        },
        "zh-Hant": {
