        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस सूची में डाले गए कार्य यहाँ दिखेंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le attività assegnate a questa lista appariranno qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリストに割り当てたタスクがここに表示されます。"
