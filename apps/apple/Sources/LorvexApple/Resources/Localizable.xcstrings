    "settings.mcp.helper_runtime_failed_detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عثر Lorvex على البرنامج المساعد، لكنه لم يبدأ العمل بإعدادات التخزين الحالية. أعد ربط Lorvex من الإعدادات > المساعد أو أعد تثبيت التطبيق."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex found the helper, but it could not start with the current storage settings. Reconnect Lorvex in Settings > Assistant or reinstall the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex encontró el programa auxiliar, pero no pudo iniciarlo con los ajustes de almacenamiento actuales. Vuelve a conectar Lorvex en Ajustes > Asistente o reinstala la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex a trouvé l’utilitaire, mais celui-ci n’a pas pu démarrer avec les réglages de stockage actuels. Reconnectez Lorvex dans Réglages > Assistant ou réinstallez l’app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex को हेल्पर मिल गया, पर वह मौजूदा स्टोरेज सेटिंग्ज़ के साथ शुरू नहीं हो सका। सेटिंग्ज़ > असिस्टेंट में Lorvex को फिर से जोड़ें या ऐप दोबारा इंस्टॉल करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex ha trovato l’helper, ma non è riuscito ad avviarsi con le attuali impostazioni di archiviazione. Ricollega Lorvex in Impostazioni > Assistente oppure reinstalla l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルパーは見つかりましたが、現在のストレージ設定では起動できませんでした。「設定」>「アシスタント」でLorvexを再接続するか、アプリを再インストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도우미를 찾았지만 현재 저장 공간 설정으로는 시작할 수 없습니다. 설정 > 어시스턴트에서 Lorvex를 다시 연결하거나 앱을 다시 설치하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex znalazł aplikację pomocniczą, ale nie mogła się ona uruchomić z bieżącymi ustawieniami przechowywania. Połącz Lorvex ponownie w Ustawieniach > Asystent lub zainstaluj aplikację ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lorvex encontrou o utilitário, mas ele não conseguiu iniciar com as configurações de armazenamento atuais. Reconecte o Lorvex em Ajustes > Assistente ou reinstale o app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вспомогательная программа найдена, но не смогла запуститься с текущими настройками хранилища. Подключите Lorvex заново в разделе «Настройки» > «Ассистент» или переустановите приложение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Допоміжну програму знайдено, але вона не змогла запуститися з поточними параметрами сховища. Підключіть Lorvex знову в розділі «Параметри» > «Асистент» або перевстановіть програму."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 找到了助手，但无法在当前存储设置下启动。请在“设置 > 助手”中重新连接 Lorvex，或重新安装应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 找到了輔助程式，但無法以目前的儲存空間設定啟動。請在「設定」>「助理」中重新連接 Lorvex，或重新安裝 App。"
          }
        }
      }
    },
