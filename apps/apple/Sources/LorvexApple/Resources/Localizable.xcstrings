        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij skrót klawiszowy w dowolnej aplikacji, aby dodać zadanie bez przełączania się na Lorvex."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione o atalho de teclado em qualquer app para adicionar uma tarefa sem mudar para o Lorvex."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apăsați comanda rapidă de la tastatură în orice aplicație pentru a adăuga o sarcină fără a trece la Lorvex."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите сочетание клавиш в любом приложении, чтобы добавить задачу, не переключаясь на Lorvex."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexக்கு மாறாமலேயே பணியைச் சேர்க்க, எந்தச் செயலியிலும் அந்தச் சுருக்கவழியை அழுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexకు మారకుండానే టాస్క్‌ను జోడించడానికి ఏ యాప్‌లోనైనా ఆ షార్ట్‌కట్‌ను నొక్కండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดทางลัดแป้นพิมพ์ในแอปใดก็ได้ เพื่อเพิ่มงานโดยไม่ต้องสลับไปที่ Lorvex"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex’e geçmeden görev eklemek için herhangi bir uygulamada klavye kısayoluna basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть комбінацію клавіш у будь-якій програмі, щоб додати завдання, не перемикаючись на Lorvex."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی بھی ایپ میں شارٹ کٹ دبائیں اور Lorvex پر جائے بغیر ایک کام شامل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn phím tắt trong bất kỳ ứng dụng nào để thêm nhiệm vụ mà không cần chuyển sang Lorvex."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何 App 中按下键盘快捷键，即可添加任务，无需切换到 Lorvex。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何 App 中按下鍵盤快速鍵，即可新增任務，無需切換到 Lorvex。"
          }
        }
      }
    },
