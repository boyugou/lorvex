          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets gepland. De dag is van jou."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie zaplanowano. Dzień należy do ciebie."
