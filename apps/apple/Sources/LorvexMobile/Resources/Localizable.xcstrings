    "setup.done.capture.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط ＋ في أي تبويب لإضافة مهمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেকোনো ট্যাবে ＋ ট্যাপ করে টাস্ক যোগ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einem beliebigen Tab auf ＋, um eine Aufgabe hinzuzufügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε ＋ σε οποιαδήποτε καρτέλα για να προσθέσετε μια εργασία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap ＋ on any tab to add a task."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca ＋ en cualquier pestaña para añadir una tarea."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای افزودن کار، در هر زبانه روی ＋ ضربه بزنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez ＋ dans n’importe quel onglet pour ajouter une tâche."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להקיש על ＋ בכל לשונית כדי להוסיף משימה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्य जोड़ने के लिए किसी भी टैब पर ＋ पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk ＋ di tab mana pun untuk menambah tugas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca ＋ in qualsiasi scheda per aggiungere un’attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのタブでも＋をタップするとタスクを追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 탭에서든 ＋ 버튼을 탭하면 할 일을 추가할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोणत्याही टॅबवर ＋ टॅप करून कार्य जोडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik ＋ pada mana-mana tab untuk menambah tugas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een willekeurig tabblad op ＋ om een taak toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij ＋ na dowolnej karcie, aby dodać zadanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em ＋ em qualquer aba para adicionar uma tarefa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți ＋ în orice filă pentru a adăuga o sarcină."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь ＋ на любой вкладке, чтобы добавить задачу."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பணியைச் சேர்க்க எந்தத் தாவலிலும் ＋ தட்டவும்."
