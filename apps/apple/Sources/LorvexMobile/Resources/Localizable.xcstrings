            "value": "Uguale su ogni dispositivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのデバイスでも同じ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기기에서 동일하게"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To samo na każdym urządzeniu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Igual em todos os dispositivos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно и то же на всех устройствах"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Те саме на всіх пристроях"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر ڈیوائس پر یکساں"
          }
        },
        "zh-Hans": {
          "stringUnit": {
