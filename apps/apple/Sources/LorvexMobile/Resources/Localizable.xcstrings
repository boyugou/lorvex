    "settings.sync.paused.account_changed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر حساب iCloud المسجَّل الدخول إليه. تم إيقاف المزامنة مؤقتًا حتى لا تختلط بيانات هذا الجهاز بحساب مختلف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাইন ইন করা iCloud অ্যাকাউন্ট বদলে গেছে। এই ডিভাইসের ডেটা যাতে অন্য অ্যাকাউন্টে মিশে না যায়, তাই সিঙ্ক পজ করা হয়েছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der angemeldete iCloud-Account hat sich geändert. Die Synchronisierung ist pausiert, damit die Daten dieses Geräts nicht mit einem anderen Account vermischt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο λογαριασμός iCloud με τον οποίο έχετε συνδεθεί άλλαξε. Ο συγχρονισμός τέθηκε σε παύση ώστε τα δεδομένα αυτής της συσκευής να μην αναμειχθούν με άλλον λογαριασμό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The signed-in iCloud account changed. Sync is paused so this device’s data isn’t mixed into a different account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta de iCloud con la sesión iniciada ha cambiado. La sincronización está en pausa para que los datos de este dispositivo no se mezclen con los de otra cuenta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب iCloud واردشده تغییر کرد. همگام‌سازی متوقف شده است تا داده‌های این دستگاه با حساب دیگری ترکیب نشود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte iCloud connecté a changé. La synchronisation est en pause afin que les données de cet appareil ne soient pas mélangées à celles d’un autre compte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חשבון ה-iCloud המחובר השתנה. הסנכרון מושהה כדי שנתוני המכשיר הזה לא יתערבבו בחשבון אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन किया हुआ iCloud खाता बदल गया है। सिंक रोक दिया गया है, ताकि इस डिवाइस का डेटा किसी दूसरे खाते में न मिल जाए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun iCloud yang masuk telah berubah. Penyelarasan dijeda agar data perangkat ini tidak tercampur ke akun yang berbeda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’account iCloud connesso è cambiato. La sincronizzazione è in pausa affinché i dati di questo dispositivo non vengano mescolati con quelli di un altro account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインしているiCloudアカウントが変更されました。このデバイスのデータが別のアカウントに混在しないよう、同期を一時停止しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인한 iCloud 계정이 변경되었습니다. 이 기기의 데이터가 다른 계정에 섞이지 않도록 동기화를 일시 중지했습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन केलेले iCloud अकाउंट बदलले. या डिव्हाइसचा डेटा दुसऱ्या अकाउंटमध्ये मिसळू नये म्हणून सिंक पॉज केले आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun iCloud yang didaftar masuk telah berubah. Penyelarasan dijeda supaya data peranti ini tidak bercampur ke dalam akaun yang berbeza."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het ingelogde iCloud-account is gewijzigd. Synchronisatie is onderbroken zodat de gegevens van dit apparaat niet met een ander account worden vermengd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalogowane konto iCloud zostało zmienione. Synchronizacja jest wstrzymana, aby dane z tego urządzenia nie zmieszały się z danymi innego konta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta do iCloud conectada mudou. A sincronização está pausada para que os dados deste dispositivo não sejam misturados com os de outra conta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Contul iCloud conectat s-a schimbat. Sincronizarea este întreruptă pentru ca datele acestui dispozitiv să nu fie amestecate cu cele ale altui cont."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учётная запись iCloud, в которую выполнен вход, изменилась. Синхронизация приостановлена, чтобы данные этого устройства не смешались с данными другой учётной записи."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்நுழைந்த iCloud கணக்கு மாறிவிட்டது. இந்தச் சாதனத் தரவு வேறொரு கணக்கில் கலந்துவிடாமல் இருக்க ஒத்திசைவு இடைநிறுத்தப்பட்டுள்ளது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సైన్ ఇన్ చేసిన iCloud ఖాతా మారింది. ఈ డివైజ్ డేటా వేరే ఖాతాలో కలిసిపోకుండా సింక్ పాజ్ చేయబడింది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชี iCloud ที่ลงชื่อเข้าไว้เปลี่ยนไป การเชื่อมข้อมูลจึงหยุดชั่วคราวเพื่อไม่ให้ข้อมูลของอุปกรณ์เครื่องนี้ปะปนกับอีกบัญชีหนึ่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş yapılmış iCloud hesabı değişti. Bu aygıtın verilerinin farklı bir hesaba karışmaması için eşzamanlama duraklatıldı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обліковий запис iCloud, в який виконано вхід, змінився. Синхронізацію призупинено, щоб дані цього пристрою не змішалися з даними іншого облікового запису."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سائن اِن iCloud اکاؤنٹ تبدیل ہو گیا ہے۔ سنک موقوف ہے تاکہ اس ڈیوائس کا ڈیٹا کسی دوسرے اکاؤنٹ میں شامل نہ ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản iCloud đang đăng nhập đã thay đổi. Đồng bộ hóa đã tạm dừng để dữ liệu của thiết bị này không bị trộn vào một tài khoản khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录的 iCloud 账户已更改。同步已暂停，以防此设备的数据混入其他账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入的 iCloud 帳號已變更。為避免此裝置的資料混入其他帳號，已暫停同步。"
          }
        }
      }
    },
    "settings.sync.paused.user_deleted_zone": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حذف بيانات Lorvex من iCloud. تظل المزامنة متوقفة مؤقتًا حتى لا يعيد هذا الجهاز رفعها دون موافقتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud থেকে Lorvex ডেটা ডিলিট করা হয়েছে। আপনার সম্মতি ছাড়া এই ডিভাইস যাতে এটি আবার আপলোড না করে, তাই সিঙ্ক পজ থাকছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Lorvex-Daten wurden aus iCloud gelöscht. Die Synchronisierung bleibt pausiert, damit dieses Gerät sie nicht ohne deine Zustimmung erneut hochlädt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα δεδομένα του Lorvex διαγράφηκαν από το iCloud. Ο συγχρονισμός παραμένει σε παύση ώστε αυτή η συσκευή να μην τα μεταφορτώσει ξανά χωρίς τη συναίνεσή σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex data was deleted from iCloud. Sync stays paused so this device doesn’t re-upload it without your consent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de Lorvex se eliminaron de iCloud. La sincronización sigue en pausa para que este dispositivo no los vuelva a subir sin tu consentimiento."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "داده‌های Lorvex از iCloud حذف شد. همگام‌سازی متوقف می‌ماند تا این دستگاه بدون رضایت شما دوباره آن‌ها را بارگذاری نکند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données Lorvex ont été supprimées d’iCloud. La synchronisation reste en pause afin que cet appareil ne les renvoie pas sans votre accord."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נתוני Lorvex נמחקו מ-iCloud. הסנכרון נשאר מושהה כדי שהמכשיר הזה לא יעלה אותם מחדש ללא הסכמתך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud से Lorvex का डेटा हटा दिया गया था। सिंक रुका रहेगा, ताकि यह डिवाइस आपकी सहमति के बिना उसे दोबारा अपलोड न करे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data Lorvex telah dihapus dari iCloud. Penyelarasan tetap dijeda agar perangkat ini tidak mengunggahnya kembali tanpa persetujuan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati di Lorvex sono stati eliminati da iCloud. La sincronizzazione resta in pausa affinché questo dispositivo non li ricarichi senza il tuo consenso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudからLorvexのデータが削除されました。このデバイスがあなたの同意なくデータを再アップロードしないよう、同期は一時停止のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에서 Lorvex 데이터가 삭제되었습니다. 이 기기가 동의 없이 데이터를 다시 업로드하지 않도록 동기화는 일시 중지된 상태로 유지됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud मधून Lorvex डेटा हटवला गेला. तुमच्या संमतीशिवाय तो या डिव्हाइसवरून पुन्हा अपलोड होऊ नये म्हणून सिंक पॉज राहते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Data Lorvex telah dipadam daripada iCloud. Penyelarasan kekal dijeda supaya peranti ini tidak memuat naiknya semula tanpa persetujuan anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Lorvex-gegevens zijn uit iCloud verwijderd. Synchronisatie blijft onderbroken, zodat dit apparaat ze niet zonder jouw toestemming opnieuw uploadt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane Lorvex zostały usunięte z iCloud. Synchronizacja pozostaje wstrzymana, aby to urządzenie nie przesłało ich ponownie bez twojej zgody."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados do Lorvex foram excluídos do iCloud. A sincronização continua pausada para que este dispositivo não os reenvie sem o seu consentimento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele Lorvex au fost șterse din iCloud. Sincronizarea rămâne întreruptă pentru ca acest dispozitiv să nu le încarce din nou fără acordul dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные Lorvex были удалены из iCloud. Синхронизация остаётся приостановленной, чтобы это устройство не загрузило их повторно без вашего согласия."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudஇல் இருந்து Lorvex தரவு நீக்கப்பட்டது. உங்கள் ஒப்புதல் இல்லாமல் இந்தச் சாதனம் அதை மீண்டும் பதிவேற்றாமல் இருக்க ஒத்திசைவு இடைநிறுத்தத்திலேயே இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud నుండి Lorvex డేటా డిలీట్ చేయబడింది. మీ సమ్మతి లేకుండా ఈ డివైజ్ దాన్ని మళ్ళీ అప్‌లోడ్ చేయకుండా సింక్ పాజ్‌లోనే ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูล Lorvex ถูกลบออกจาก iCloud แล้ว การเชื่อมข้อมูลจะหยุดชั่วคราวต่อไปเพื่อไม่ให้อุปกรณ์เครื่องนี้อัปโหลดข้อมูลซ้ำโดยที่คุณไม่อนุญาต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex verileri iCloud’dan silindi. Bu aygıtın bunları onayınız olmadan yeniden yüklememesi için eşzamanlama duraklatılmış durumda kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані Lorvex було видалено з iCloud. Синхронізація залишається призупиненою, щоб цей пристрій не завантажив їх повторно без вашої згоди."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا Lorvex ڈیٹا iCloud سے حذف کر دیا گیا۔ سنک موقوف رہتا ہے تاکہ یہ ڈیوائس آپ کی رضامندی کے بغیر اسے دوبارہ اپ لوڈ نہ کرے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu Lorvex đã bị xóa khỏi iCloud. Đồng bộ hóa vẫn tạm dừng để thiết bị này không tải dữ liệu lên lại khi chưa có sự đồng ý của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 数据已从 iCloud 中删除。同步保持暂停，以防此设备在未经你同意的情况下重新上传数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已從 iCloud 刪除 Lorvex 資料。在你同意之前，此裝置不會重新上傳資料，因此同步會維持暫停。"
          }
        }
      }
    },
    "settings.sync.paused.user_deleted_zone.retry_hint": {
      "comment": "Second sentence of the userDeletedZone pause notice: how to recover if the deletion was interrupted mid-way (running it again is safe and idempotent)",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا انقطع الحذف قبل اكتماله، فشغّل \"حذف بيانات iCloud\" مرة أخرى لإكماله بأمان."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডিলিট শেষ হওয়ার আগে বাধা পেলে, নিরাপদে সম্পূর্ণ করতে আবার “iCloud ডেটা ডিলিট করুন” চালান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls das Löschen unterbrochen wurde, bevor es abgeschlossen war, führe „iCloud-Daten löschen“ erneut aus, um es sicher abzuschließen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν η διαγραφή διακόπηκε πριν ολοκληρωθεί, εκτελέστε ξανά τη «Διαγραφή δεδομένων iCloud» για να την ολοκληρώσετε με ασφάλεια."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the deletion was interrupted before it finished, run Delete iCloud Data again to complete it safely."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la eliminación se interrumpió antes de terminar, vuelve a ejecutar Eliminar datos de iCloud para completarla de forma segura."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر حذف پیش از پایان قطع شده بود، برای تکمیل ایمن آن دوباره «حذف داده‌های iCloud» را اجرا کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la suppression a été interrompue avant la fin, exécutez de nouveau Supprimer les données iCloud pour la terminer en toute sécurité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם המחיקה הופסקה לפני שהסתיימה, יש להפעיל שוב את \"מחיקת נתוני iCloud\" כדי להשלים אותה בבטחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर हटाना पूरा होने से पहले रुक गया था, तो उसे सुरक्षित रूप से पूरा करने के लिए “iCloud डेटा हटाएँ” फिर से चलाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika penghapusan terhenti sebelum selesai, jalankan Hapus Data iCloud lagi untuk menyelesaikannya dengan aman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se l’eliminazione è stata interrotta prima del termine, esegui di nuovo Elimina dati iCloud per completarla in sicurezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除が完了する前に中断された場合は、「iCloudデータを削除」をもう一度実行すると、安全に完了できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제가 끝나기 전에 중단되었다면 ‘iCloud 데이터 삭제’를 다시 실행하여 안전하게 완료하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हटवणे पूर्ण होण्यापूर्वी खंडित झाले असल्यास, ते सुरक्षितपणे पूर्ण करण्यासाठी ‘iCloud डेटा हटवा’ पुन्हा चालवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika pemadaman terganggu sebelum selesai, jalankan Padam Data iCloud sekali lagi untuk melengkapkannya dengan selamat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als het verwijderen is onderbroken voordat het klaar was, voer je ‘Verwijder iCloud-gegevens’ opnieuw uit om het veilig af te ronden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli usuwanie zostało przerwane, uruchom ponownie „Usuń dane iCloud”, aby bezpiecznie je dokończyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a exclusão foi interrompida antes de terminar, execute Excluir dados do iCloud novamente para concluí-la com segurança."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă ștergerea a fost întreruptă înainte de a se termina, rulați din nou „Ștergeți datele din iCloud” pentru a o finaliza în siguranță."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если удаление было прервано, запустите «Удалить данные iCloud» ещё раз, чтобы безопасно завершить его."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீக்குதல் முடிவதற்குள் தடைபட்டிருந்தால், அதைப் பாதுகாப்பாக முடிக்க “iCloud தரவை நீக்கு” என்பதை மீண்டும் இயக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "డిలీట్ చేయడం పూర్తి కాకముందే ఆగిపోయి ఉంటే, దాన్ని సురక్షితంగా పూర్తి చేయడానికి “iCloud డేటాను డిలీట్ చేయండి” యాక్షన్‌ను మళ్ళీ అమలు చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากการลบถูกขัดจังหวะก่อนเสร็จสิ้น ให้ใช้ “ลบข้อมูล iCloud” อีกครั้งเพื่อทำให้เสร็จอย่างปลอดภัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silme işlemi bitmeden kesintiye uğradıysa, güvenle tamamlamak için “iCloud verilerini sil” işlemini yeniden çalıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо видалення було перервано, запустіть «Видалити дані iCloud» ще раз, щоб безпечно завершити його."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر حذف مکمل ہونے سے پہلے رک گیا تھا تو اسے محفوظ طریقے سے مکمل کرنے کے لیے \"اپنا iCloud ڈیٹا حذف کریں\" دوبارہ چلائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu việc xóa bị gián đoạn trước khi hoàn tất, hãy chạy lại Xóa dữ liệu iCloud để hoàn tất một cách an toàn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果删除在完成前被中断，再次运行“删除 iCloud 数据”即可安全地完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果刪除在完成前被中斷，請再次執行「刪除 iCloud 資料」，即可安全完成。"
          }
        }
      }
    },
    "settings.sync.resume.action": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة الرفع واستئناف المزامنة…"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আবার আপলোড করে সিঙ্ক চালু করুন…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut hochladen und Synchronisierung fortsetzen …"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαναμεταφόρτωση και συνέχιση συγχρονισμού…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-upload & Resume Sync…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver a subir y reanudar sincronización…"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بارگذاری مجدد و ازسرگیری همگام‌سازی…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renvoyer et reprendre la synchronisation…"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העלאה מחדש וחידוש הסנכרון…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोबारा अपलोड करें और सिंक फिर शुरू करें…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unggah Ulang & Lanjutkan Penyelarasan…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricarica e riprendi la sincronizzazione…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再アップロードして同期を再開…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 업로드하고 동기화 재개…"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पुन्हा अपलोड करा आणि सिंक सुरू ठेवा…"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat Naik Semula & Teruskan Penyelarasan…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnieuw uploaden en synchronisatie hervatten…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prześlij ponownie i wznów synchronizację…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reenviar e retomar a sincronização…"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reîncărcați și continuați sincronizarea…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправить заново и возобновить синхронизацию…"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீண்டும் பதிவேற்றி, ஒத்திசைவைத் தொடர்க…"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మళ్ళీ అప్‌లోడ్ చేసి, సింక్‌ను తిరిగి కొనసాగించండి…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปโหลดอีกครั้งและเชื่อมข้อมูลต่อ…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden yükle ve eşzamanlamayı sürdür…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надіслати знову й відновити синхронізацію…"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دوبارہ اپ لوڈ کریں اور سنک بحال کریں…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải lên lại và tiếp tục đồng bộ hóa…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新上传并恢复同步…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新上傳並繼續同步…"
          }
        }
      }
    },
