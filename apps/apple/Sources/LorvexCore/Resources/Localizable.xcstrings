    "recurrence.anchor.completion.hint": {
      "comment": "One line beneath the repeat editor's anchor control, explaining “After completion”.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحدَّد موعد المهمة التالية بناءً على وقت إكمال هذه المهمة، لذا فإن الإكمال المتأخر يؤخر موعدها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরবর্তীটি আপনি কখন এটি সম্পূর্ণ করেন তার ভিত্তিতে নির্ধারিত হয়, তাই দেরিতে শেষ করলে পরবর্তীটিও পিছিয়ে যায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die nächste Wiederholung richtet sich nach dem Zeitpunkt, an dem du diese erledigst – ein verspäteter Abschluss verschiebt sie also nach hinten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επόμενη προγραμματίζεται με βάση το πότε ολοκληρώνετε αυτήν, οπότε αν τελειώσετε αργά μετατίθεται αργότερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next one is scheduled relative to when you complete this, so a late finish pushes it forward."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La siguiente se programa a partir del momento en que completes esta, por lo que terminar tarde la retrasa."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تکرار بعدی بر اساس زمان تکمیل این کار تعیین می‌شود؛ پس اگر دیر تمامش کنید، تکرار بعدی هم دیرتر می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La prochaine occurrence est planifiée à partir du moment où vous terminez celle-ci : si vous finissez en retard, elle est repoussée d’autant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המופע הבא נקבע לפי מועד ההשלמה, ולכן אם ההשלמה מתאחרת, גם המופע הבא יידחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगली बार की तारीख़ इस पर निर्भर है कि आप इसे कब पूरा करते हैं, इसलिए देर से पूरा करने पर वह आगे खिसक जाती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berikutnya dijadwalkan berdasarkan kapan tugas ini diselesaikan, sehingga penyelesaian yang terlambat menggesernya ke depan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La successiva viene pianificata in base a quando completi questa, quindi un completamento in ritardo la sposta in avanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回は、このタスクを完了した日を基準にスケジュールされます。完了が遅れると、次回もその分後ろにずれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 할 일은 이 할 일을 완료한 시점을 기준으로 일정이 잡히므로, 늦게 완료하면 그만큼 뒤로 밀립니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पुढील वेळ तुम्ही हे केव्हा पूर्ण करता त्यावरून ठरते, त्यामुळे उशिरा पूर्ण केल्यास ती पुढे ढकलली जाते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang seterusnya dijadualkan berdasarkan bila tugas ini diselesaikan, jadi penyelesaian yang lewat akan menganjakkannya ke hadapan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De volgende herhaling wordt gepland ten opzichte van het moment waarop je deze voltooit, dus een late afronding schuift ook de volgende op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolejne powtórzenie jest planowane od momentu ukończenia tego, więc późne ukończenie przesuwa je do przodu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A próxima é planejada com base em quando você conclui esta, então uma conclusão tardia a empurra para frente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Următoarea apariție este programată în funcție de momentul în care o finalizați, așa că o finalizare târzie o amână."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующее повторение планируется от момента выполнения этого, поэтому позднее выполнение сдвигает его вперёд."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அடுத்தது நீங்கள் இதை நிறைவுசெய்யும் நேரத்தைப் பொறுத்து திட்டமிடப்படும், எனவே தாமதமாக முடித்தால் அது தள்ளிப்போகும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తదుపరిది మీరు దీన్ని పూర్తి చేసిన సమయాన్ని బట్టి షెడ్యూల్ అవుతుంది, కాబట్టి ఆలస్యంగా పూర్తి చేస్తే అది తర్వాతి తేదీకి మారుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ครั้งถัดไปจะกำหนดตามเวลาที่คุณทำเสร็จ ถ้าเสร็จช้าก็จะเลื่อนออกไปด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sonraki, bunu ne zaman tamamladığınıza göre planlanır; geç bitirirseniz ileri kayar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наступне повторення планується від моменту виконання цього, тож пізніше виконання зсуває його вперед."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگلی تکرار اس وقت کے مطابق طے ہوتی ہے جب آپ اسے مکمل کرتے ہیں، اس لیے دیر سے مکمل کرنے پر وہ آگے بڑھ جاتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lần tiếp theo được lên lịch dựa trên thời điểm nhiệm vụ này hoàn thành, nên nếu hoàn thành muộn thì lần tiếp theo cũng bị lùi lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一个会以你完成这一个的时间为基准来安排，因此完成得越晚，下一个就顺延得越晚。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下一次會以你完成這一次的時間為基準來安排，所以越晚完成，下一次就越晚。"
          }
        }
      }
    },
    "recurrence.anchor.schedule": {
      "comment": "The repeat editor's anchor control: the next occurrence follows the fixed schedule, whenever this one is finished.",
