    "error.database_newer": {
      "comment": "Shown when the database was written by a newer version of Lorvex than the one running.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إنشاء قاعدة البيانات هذه بواسطة إصدار أحدث من Lorvex. يُرجى تحديث Lorvex لفتحها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডেটাবেস Lorvex-এর একটি নতুন ভার্সন দিয়ে তৈরি করা হয়েছে। এটি খুলতে অনুগ্রহ করে Lorvex আপডেট করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datenbank wurde mit einer neueren Version von Lorvex erstellt. Bitte aktualisiere Lorvex, um sie zu öffnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η βάση δεδομένων δημιουργήθηκε από νεότερη έκδοση του Lorvex. Ενημερώστε το Lorvex για να την ανοίξετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This database was created by a newer version of Lorvex. Please update Lorvex to open it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta base de datos la creó una versión más reciente de Lorvex. Actualiza Lorvex para abrirla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این پایگاه‌داده با نسخه‌ای جدیدتر از Lorvex ایجاد شده است. برای باز کردن آن، Lorvex را به‌روزرسانی کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette base de données a été créée par une version plus récente de Lorvex. Mettez à jour Lorvex pour l’ouvrir."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסד הנתונים הזה נוצר בגרסה חדשה יותר של Lorvex. יש לעדכן את Lorvex כדי לפתוח אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डेटाबेस Lorvex के नए संस्करण में बना था। इसे खोलने के लिए कृपया Lorvex अपडेट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Basis data ini dibuat oleh versi Lorvex yang lebih baru. Perbarui Lorvex untuk membukanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo database è stato creato da una versione più recente di Lorvex. Aggiorna Lorvex per aprirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデータベースは、より新しいバージョンのLorvexで作成されました。開くにはLorvexをアップデートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 데이터베이스는 더 새로운 버전의 Lorvex에서 만들어졌습니다. 열려면 Lorvex를 업데이트하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा डेटाबेस Lorvex च्या नवीन व्हर्जनने तयार केला होता. तो उघडण्यासाठी कृपया Lorvex अपडेट करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pangkalan data ini dicipta oleh versi Lorvex yang lebih baharu. Sila kemas kini Lorvex untuk membukanya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze database is gemaakt met een nieuwere versie van Lorvex. Werk Lorvex bij om de database te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta baza danych została utworzona przez nowszą wersję Lorvex. Zaktualizuj Lorvex, aby ją otworzyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este banco de dados foi criado por uma versão mais recente do Lorvex. Atualize o Lorvex para abri-lo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această bază de date a fost creată cu o versiune mai nouă a Lorvex. Actualizați Lorvex pentru a o deschide."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта база данных создана более новой версией Lorvex. Обновите Lorvex, чтобы открыть её."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தத் தரவுத்தளம் Lorvexஇன் புதிய பதிப்பால் உருவாக்கப்பட்டது. இதைத் திறக்க Lorvexஐப் புதுப்பிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ డేటాబేస్ Lorvex కొత్త వెర్షన్‌తో సృష్టించబడింది. దీన్ని తెరవడానికి దయచేసి Lorvexను అప్‌డేట్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฐานข้อมูลนี้สร้างโดย Lorvex เวอร์ชั่นที่ใหม่กว่า โปรดอัปเดต Lorvex เพื่อเปิดใช้งาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu veritabanı, Lorvex’in daha yeni bir sürümüyle oluşturulmuş. Açmak için lütfen Lorvex’i güncelleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю базу даних створено новішою версією Lorvex. Оновіть Lorvex, щоб відкрити її."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ڈیٹابیس Lorvex کے نئے ورژن سے بنایا گیا تھا۔ اسے کھولنے کے لیے براہ کرم Lorvex اپ ڈیٹ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cơ sở dữ liệu này được tạo bởi phiên bản Lorvex mới hơn. Hãy cập nhật Lorvex để mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此数据库由较新版本的 Lorvex 创建。请更新 Lorvex 以打开它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此資料庫是由較新版本的 Lorvex 建立的。請更新 Lorvex 才能開啟。"
          }
        }
      }
    },
    "error.generic": {
      "comment": "Shown when an action failed for a reason that may go away if the person tries again.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خطأ ما. يُرجى المحاولة مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছু সমস্যা হয়েছে। অনুগ্রহ করে আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas ist schiefgelaufen. Bitte versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρουσιάστηκε πρόβλημα. Δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo salió mal. Inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مشکلی پیش آمد. لطفاً دوباره تلاش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une erreur s’est produite. Veuillez réessayer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משהו השתבש. יש לנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ गड़बड़ हो गई। कृपया फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada yang salah. Coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si è verificato un errore. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題が発生しました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제가 발생했습니다. 다시 시도하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काहीतरी चुकले. कृपया पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masalah telah berlaku. Sila cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is iets misgegaan. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coś poszło nie tak. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo deu errado. Tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceva nu a funcționat corect. Încercați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что-то пошло не так. Повторите попытку."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஏதோ தவறாகிவிட்டது. மீண்டும் முயலவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏదో తప్పు జరిగింది. దయచేసి మళ్ళీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีบางอย่างผิดพลาด โปรดลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sorun oluştu. Lütfen yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щось пішло не так. Повторіть спробу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کچھ غلط ہو گیا۔ براہ کرم دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xảy ra sự cố. Hãy thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出了点问题，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發生了問題，請再試一次。"
          }
        }
      }
    },
    "error.item_gone": {
      "comment": "Shown when the item an action or a screen refers to was deleted, here or on another device.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا العنصر لم يعد موجودًا."
