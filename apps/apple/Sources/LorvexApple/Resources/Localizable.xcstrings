    "calendar.week.load.over_sentence": {
      "comment": "Week header tooltip and VoiceOver for an overbooked day",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ أكثر مما تتسع له ساعات يومك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার দিনের ঘণ্টার চেয়ে %@ বেশি"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mehr, als deine Tagesstunden fassen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ πάνω από τις ώρες της ημέρας σας"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ more than your day hours hold"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ más de lo que cabe en tu horario del día"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ بیش از ظرفیت ساعت‌های روز شما"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de plus que vos horaires de la journée"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ יותר ממה ששעות היום שלך יכולות להכיל"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
