    "task_detail.actions.add_to_calendar.no_date_error": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف تاريخ تخطيط قبل إضافة هذه المهمة إلى التقويم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
