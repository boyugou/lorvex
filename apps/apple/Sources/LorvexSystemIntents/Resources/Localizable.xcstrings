{
  "sourceLanguage": "en",
  "strings": {
    "system.ai_changelog.read.description": {
      "comment": "Description for the Read Lorvex AI Changelog App Intent",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read recent Lorvex AI changelog entries from Shortcuts or Siri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“快捷指令”或 Siri 读取最近的 Lorvex AI 变更记录。"
          }
        }
      }
    },
    "system.ai_changelog.read.dialog": {
      "comment": "Dialog after reading AI changelog; %lld is entry count and %@ is summary",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld changelog entry. %2$@"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld changelog entries. %2$@"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld 条变更记录。%2$@"
                }
              }
            }
          }
        }
      }
    },
    "system.ai_changelog.read.empty_summary": {
      "comment": "Summary used when there are no recent AI changelog entries",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No recent AI changelog entries."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有最近的 AI 变更记录。"
          }
        }
      }
    },
    "system.ai_changelog.read.title": {
      "comment": "Title for the Read Lorvex AI Changelog App Intent",
      "extractionState": "manual",
      "localizations": {
        "en": {
