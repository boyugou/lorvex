        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexの習慣のリマインダー設定を読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 습관의 알림 설정을 읽습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytuje reguły przypomnień dla nawyku Lorvex."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê as regras de lembrete de um hábito do Lorvex."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает правила напоминаний для привычки Lorvex."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читає правила нагадувань для звички Lorvex."
          }
