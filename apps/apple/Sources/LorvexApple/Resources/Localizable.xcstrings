          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync Paused"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronización en pausa"
          }
        },
        "fr": {
