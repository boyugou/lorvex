    "setup.permissions.calendar.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استيراد عناوين الأحداث وأوقاتها ومواقعها وملاحظاتها وتفاصيل تكرارها لأغراض التخطيط. قد تكون بيانات التقويم متاحة للمساعدين المتصلين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiert Titel, Zeiten, Orte, Notizen und Wiederholungsdetails von Ereignissen für die Planung. Kalenderdaten können für verbundene Assistenten verfügbar sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import event titles, times, locations, notes, and recurrence details for planning. Calendar data may be available to connected assistants."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa títulos, horas, ubicaciones, notas y detalles de repetición de los eventos para planificar. Los asistentes conectados pueden tener acceso a los datos del calendario."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوان، زمان، مکان، یادداشت و جزئیات تکرار رویدادها را برای برنامه‌ریزی وارد می‌کند. داده‌های تقویم ممکن است در دسترس دستیارهای متصل باشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe les titres, horaires, lieux, notes et détails de répétition des événements pour la planification. Les données du calendrier peuvent être accessibles aux assistants connectés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייבוא כותרות, שעות, מיקומים, הערות ופרטי חזרה של אירועים לצורך תכנון. נתוני לוח השנה עשויים להיות זמינים לעוזרים מחוברים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्लानिंग के लिए इवेंट के शीर्षक, समय, स्थान, नोट और दोहराव का ब्योरा इंपोर्ट करें। कैलेंडर डेटा जुड़े हुए असिस्टेंट को उपलब्ध हो सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa titoli, orari, luoghi, note e dettagli di ripetizione degli eventi per la pianificazione. I dati del calendario possono essere accessibili agli assistenti connessi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計画に使うため、イベントのタイトル、時刻、場所、メモ、繰り返しの詳細を読み込みます。カレンダーのデータは、接続したアシスタントが利用できる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계획에 활용하기 위해 이벤트 제목, 시간, 위치, 메모, 반복 세부 정보를 가져옵니다. 캘린더 데이터는 연결된 어시스턴트가 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importeert titels, tijden, locaties, notities en herhalingsgegevens van activiteiten voor de planning. Agendagegevens kunnen beschikbaar zijn voor verbonden assistenten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Import tytułów, godzin, miejsc, notatek i szczegółów powtarzania wydarzeń na potrzeby planowania. Dane kalendarza mogą być dostępne dla połączonych asystentów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa títulos, horários, locais, notas e detalhes de repetição dos eventos para o planejamento. Os dados do calendário podem ficar disponíveis para assistentes conectados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Importă titlurile, orele, locațiile, notițele și detaliile de repetare ale evenimentelor pentru planificare. Datele din calendar pot fi disponibile pentru asistenții conectați."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импорт названий, времени, мест, заметок и подробностей повторения событий для планирования. Данные календаря могут быть доступны подключённым ассистентам."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імпорт назв, часу, місць, нотаток і подробиць повторення подій для планування. Дані календаря можуть бути доступні підключеним асистентам."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منصوبہ بندی کے لیے ایونٹس کے عنوان، اوقات، مقامات، نوٹس اور تکرار کی تفصیلات امپورٹ کریں۔ کیلنڈر ڈیٹا منسلک اسسٹنٹس کو دستیاب ہو سکتا ہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入事件的标题、时间、地点、备注和重复详情，用于规划。已连接的助手可能能够访问日历数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入事件的標題、時間、位置、備註與重複詳細資料，以供規劃使用。已連接的助理可能可以存取行事曆資料。"
          }
        }
      }
    },
