        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παραλείφθηκε μία ημερομηνία επανάληψης για την εργασία %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skipped one recurrence date for %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se omitió una fecha de repetición de “%@”."
          }
        },
        "fa": {
