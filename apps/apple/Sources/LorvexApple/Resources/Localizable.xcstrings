          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg het eerste checklistonderdeel toe om deze taak op te splitsen in concrete stappen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj pierwszy element listy kontrolnej, aby podzielić zadanie na konkretne kroki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
