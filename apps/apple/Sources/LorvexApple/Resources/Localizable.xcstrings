            "state": "translated",
            "value": "Kies een eindtijd na de starttijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz godzinę zakończenia późniejszą niż godzina rozpoczęcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um horário de término depois do horário de início."
          }
        },
