    "system.task.batch.defer.dialog": {
      "comment": "Result after batch-deferring tasks; both changed and skipped counts pluralize independently",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@changed@؛ %#@skipped@."
          },
          "substitutions": {
            "changed": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "few": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "تم تأجيل %arg مهام"
                    }
                  },
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "تم تأجيل %arg مهمة"
                    }
                  },
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "تم تأجيل مهمة واحدة"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "تم تأجيل %arg مهمة"
                    }
                  },
                  "two": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "تم تأجيل مهمتين"
                    }
                  },
                  "zero": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "تم تأجيل %arg مهمة"
                    }
                  }
                }
