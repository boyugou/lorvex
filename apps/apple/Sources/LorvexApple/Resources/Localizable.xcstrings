        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस कार्य को कैलेंडर में जोड़ने से पहले प्लान की तारीख़ जोड़ें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una data pianificata prima di aggiungere questa attività al calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタスクをカレンダーに追加する前に、予定日を設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 할 일을 캘린더에 추가하기 전에 예정일을 지정하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een geplande datum toe voordat je deze taak in de agenda zet."
