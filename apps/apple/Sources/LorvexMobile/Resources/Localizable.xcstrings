    "settings.sync.detail.off": {
      "comment": "Under the iCloud switch while sync is off.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى مهامك على هذا الجهاز. شغّل هذا الخيار لترى المهام والقوائم والعادات نفسها على أجهزتك الأخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার টাস্ক শুধু এই ডিভাইসে থাকে। অন্য ডিভাইসেও একই টাস্ক, তালিকা ও অভ্যাস দেখতে এটি চালু করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Aufgaben bleiben auf diesem Gerät. Schalte dies ein, um dieselben Aufgaben, Listen und Gewohnheiten auf deinen anderen Geräten zu sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εργασίες σας παραμένουν σε αυτήν τη συσκευή. Ενεργοποιήστε το για να βλέπετε τις ίδιες εργασίες, λίστες και συνήθειες στις άλλες συσκευές σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tasks stay on this device. Turn this on to see the same tasks, lists, and habits on your other devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus tareas se quedan en este dispositivo. Activa esta opción para ver las mismas tareas, listas y hábitos en tus otros dispositivos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارهای شما در همین دستگاه می‌مانند. این گزینه را روشن کنید تا همین کارها، فهرست‌ها و عادت‌ها را در دستگاه‌های دیگرتان ببینید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos tâches restent sur cet appareil. Activez cette option pour retrouver les mêmes tâches, listes et habitudes sur vos autres appareils."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשימות שלך נשארות במכשיר הזה. יש להפעיל כדי לראות את אותן משימות, רשימות והרגלים גם במכשירים האחרים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके कार्य इसी डिवाइस पर रहते हैं। अपने दूसरे डिवाइस पर वही कार्य, सूचियाँ और आदतें देखने के लिए इसे चालू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas Anda tetap berada di perangkat ini. Nyalakan untuk melihat tugas, daftar, dan kebiasaan yang sama di perangkat lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue attività restano su questo dispositivo. Attiva questa opzione per vedere le stesse attività, liste e abitudini sugli altri dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクはこのデバイスにのみ保存されます。オンにすると、ほかのデバイスでも同じタスク、リスト、習慣を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일은 이 기기에만 저장됩니다. 켜면 다른 기기에서도 같은 할 일, 목록, 습관을 볼 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची कार्ये फक्त या डिव्हाइसवर राहतात. तुमच्या इतर डिव्हाइसवरही तीच कार्ये, याद्या आणि सवयी पाहण्यासाठी हे चालू करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas anda kekal pada peranti ini. Aktifkan untuk melihat tugas, senarai dan tabiat yang sama pada peranti anda yang lain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je taken blijven op dit apparaat. Schakel dit in om dezelfde taken, lijsten en gewoontes op je andere apparaten te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje zadania zostają na tym urządzeniu. Włącz, aby widzieć te same zadania, listy i nawyki na swoich innych urządzeniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas tarefas ficam neste dispositivo. Ative esta opção para ver as mesmas tarefas, listas e hábitos nos seus outros dispositivos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarcinile rămân pe acest dispozitiv. Activați această opțiune pentru a vedea aceleași sarcini, liste și obiceiuri pe celelalte dispozitive."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши задачи хранятся только на этом устройстве. Включите, чтобы видеть те же задачи, списки и привычки на других устройствах."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பணிகள் இந்தச் சாதனத்தில்தான் இருக்கும். உங்கள் பிற சாதனங்களிலும் அதே பணிகள், பட்டியல்கள், பழக்கங்களைப் பார்க்க இதை ஆன் செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ టాస్క్‌లు ఈ డివైజ్‌లోనే ఉంటాయి. మీ ఇతర డివైజ్‌లలో అవే టాస్క్‌లు, జాబితాలు, అలవాట్లు చూడటానికి దీన్ని ఆన్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานของคุณจะอยู่บนอุปกรณ์เครื่องนี้ เปิดตัวเลือกนี้เพื่อดูงาน ลิสต์ และนิสัยเดียวกันบนอุปกรณ์เครื่องอื่นของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görevleriniz bu aygıtta kalır. Diğer aygıtlarınızda aynı görevleri, listeleri ve alışkanlıkları görmek için bunu açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші завдання зберігаються лише на цьому пристрої. Увімкніть, щоб бачити ті самі завдання, списки та звички на інших пристроях."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے کام اسی ڈیوائس پر رہتے ہیں۔ اپنی دوسری ڈیوائسز پر وہی کام، فہرستیں اور عادات دیکھنے کے لیے اسے آن کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhiệm vụ của bạn vẫn nằm trên thiết bị này. Bật tùy chọn này để xem cùng các nhiệm vụ, danh sách và thói quen trên các thiết bị khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务只保存在这台设备上。打开后，你的其他设备上也会有同样的任务、清单和习惯。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的任務只會留在此裝置上。開啟後，你就能在其他裝置上看到相同的任務、清單和習慣。"
          }
        }
      }
    },
    "settings.sync.detail.on": {
      "comment": "Under the iCloud switch while sync is on.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى مهامك وقوائمك وعاداتك متطابقة على كل جهاز مسجّل الدخول إلى حساب iCloud الخاص بك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার iCloud অ্যাকাউন্টে সাইন ইন করা প্রতিটি ডিভাইসে আপনার টাস্ক, তালিকা ও অভ্যাস একই থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Aufgaben, Listen und Gewohnheiten sind auf jedem Gerät identisch, das bei deinem iCloud-Account angemeldet ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εργασίες, οι λίστες και οι συνήθειές σας παραμένουν ίδιες σε κάθε συσκευή που έχει συνδεθεί στον λογαριασμό σας iCloud."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tasks, lists, and habits stay the same on every device signed in to your iCloud account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus tareas, listas y hábitos son los mismos en todos los dispositivos con sesión iniciada en tu cuenta de iCloud."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارها، فهرست‌ها و عادت‌های شما در همه دستگاه‌هایی که با حساب iCloud شما وارد شده‌اند یکسان می‌مانند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos tâches, listes et habitudes restent identiques sur tous les appareils connectés à votre compte iCloud."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשימות, הרשימות וההרגלים שלך נשארים זהים בכל מכשיר שמחובר לחשבון ה-iCloud שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके iCloud खाते में साइन इन हर डिवाइस पर आपके कार्य, सूचियाँ और आदतें एक जैसी रहती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas, daftar, dan kebiasaan tetap sama di setiap perangkat yang masuk ke akun iCloud Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue attività, liste e abitudini restano uguali su ogni dispositivo connesso al tuo account iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスク、リスト、習慣は、同じiCloudアカウントでサインインしているすべてのデバイスで同じ状態に保たれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일, 목록, 습관이 iCloud 계정으로 로그인한 모든 기기에서 동일하게 유지됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या iCloud अकाउंटमध्ये साइन इन केलेल्या प्रत्येक डिव्हाइसवर तुमची कार्ये, याद्या आणि सवयी सारख्याच राहतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas, senarai dan tabiat kekal sama pada setiap peranti yang didaftar masuk ke akaun iCloud anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je taken, lijsten en gewoontes blijven op elk apparaat hetzelfde dat bij je iCloud-account is ingelogd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje zadania, listy i nawyki są takie same na każdym urządzeniu zalogowanym na twoje konto iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas tarefas, listas e hábitos permanecem iguais em todos os dispositivos conectados à sua conta do iCloud."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarcinile, listele și obiceiurile rămân aceleași pe fiecare dispozitiv conectat la contul iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши задачи, списки и привычки одинаковы на всех устройствах, на которых выполнен вход в вашу учётную запись iCloud."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் iCloud கணக்கில் உள்நுழைந்துள்ள ஒவ்வொரு சாதனத்திலும் உங்கள் பணிகள், பட்டியல்கள், பழக்கங்கள் ஒரே மாதிரி இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ iCloud ఖాతాలో సైన్ ఇన్ చేసిన ప్రతి డివైజ్‌లో మీ టాస్క్‌లు, జాబితాలు, అలవాట్లు ఒకేలా ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งาน ลิสต์ และนิสัยของคุณจะเหมือนกันบนทุกอุปกรณ์ที่ลงชื่อเข้าบัญชี iCloud ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görevleriniz, listeleriniz ve alışkanlıklarınız, iCloud hesabınızla giriş yapmış her aygıtta aynı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші завдання, списки та звички однакові на всіх пристроях, на яких виконано вхід в обліковий запис iCloud."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے کام، فہرستیں اور عادات آپ کے iCloud اکاؤنٹ میں سائن اِن ہر ڈیوائس پر یکساں رہتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhiệm vụ, danh sách và thói quen luôn giống nhau trên mọi thiết bị đăng nhập vào tài khoản iCloud của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务、清单和习惯会在登录同一 iCloud 账户的每台设备上保持一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的任務、清單和習慣會在所有登入同一個 iCloud 帳號的裝置上保持一致。"
          }
        }
      }
    },
