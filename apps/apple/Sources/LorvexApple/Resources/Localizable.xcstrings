          "stringUnit": {
            "state": "translated",
            "value": "Ancora %1$@ e %2$@ oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は%1$@と%2$@が残っています。"
          }
        },
        "ko": {
          "stringUnit": {
