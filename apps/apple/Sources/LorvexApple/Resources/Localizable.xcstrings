    "error.database_newer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إنشاء قاعدة البيانات هذه بواسطة إصدار أحدث من Lorvex. يُرجى تحديث Lorvex لفتحها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This database was created by a newer version of Lorvex. Please update Lorvex to open it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta base de datos la creó una versión más reciente de Lorvex. Actualiza Lorvex para abrirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette base de données a été créée par une version plus récente de Lorvex. Mettez à jour Lorvex pour l’ouvrir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डेटाबेस Lorvex के नए संस्करण में बना था। इसे खोलने के लिए कृपया Lorvex अपडेट करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo database è stato creato da una versione più recente di Lorvex. Aggiorna Lorvex per aprirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデータベースは、より新しいバージョンのLorvexで作成されました。開くにはLorvexをアップデートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 데이터베이스는 더 새로운 버전의 Lorvex에서 만들어졌습니다. 열려면 Lorvex를 업데이트하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta baza danych została utworzona przez nowszą wersję Lorvex. Zaktualizuj Lorvex, aby ją otworzyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este banco de dados foi criado por uma versão mais recente do Lorvex. Atualize o Lorvex para abri-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта база данных создана более новой версией Lorvex. Обновите Lorvex, чтобы открыть её."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю базу даних створено новішою версією Lorvex. Оновіть Lorvex, щоб відкрити її."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此数据库由较新版本的 Lorvex 创建。请更新 Lorvex 以打开它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此資料庫是由較新版本的 Lorvex 建立的。請更新 Lorvex 才能開啟。"
          }
        }
      }
    },
    "error.storage_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع Lorvex الوصول إلى مساحة تخزين بياناته، لذا تعذّر إكمال هذا الإجراء. يُرجى إعادة تشغيل Lorvex."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex can’t access its data storage, so this couldn’t be completed. Please restart Lorvex."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex no puede acceder a su almacenamiento de datos, así que no se pudo completar la acción. Reinicia Lorvex."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex ne peut pas accéder à son stockage de données. L’opération n’a donc pas pu aboutir. Redémarrez Lorvex."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex अपने डेटा स्टोरेज तक नहीं पहुँच सकता, इसलिए यह पूरा नहीं हो सका। कृपया Lorvex को दोबारा शुरू करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex non riesce ad accedere al proprio archivio dati, quindi non è stato possibile completare l’operazione. Riavvia Lorvex."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexがデータ保存領域にアクセスできないため、この操作を完了できませんでした。Lorvexを再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex가 데이터 저장소에 접근할 수 없어 작업을 완료하지 못했습니다. Lorvex를 다시 시작하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex nie ma dostępu do magazynu danych, więc nie można było tego zakończyć. Uruchom Lorvex ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lorvex não consegue acessar o armazenamento de dados, então não foi possível concluir a operação. Reinicie o Lorvex."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex не может получить доступ к хранилищу данных, поэтому действие не выполнено. Перезапустите Lorvex."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex не може отримати доступ до сховища даних, тому дію не виконано. Перезапустіть Lorvex."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 无法访问其数据存储，因此无法完成此操作。请重新启动 Lorvex。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 無法存取其資料儲存空間，因此無法完成此操作。請重新啟動 Lorvex。"
          }
        }
      }
    },
