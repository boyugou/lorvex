    "system.calendar.linked_tasks_for_event.read.description": {
      "comment": "Description for the Read Lorvex Linked Tasks For Event App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة مهام Lorvex المرتبطة بحدث تقويم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো ক্যালেন্ডার ইভেন্টের সাথে লিঙ্ক করা Lorvex টাস্ক পড়ুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest Lorvex-Aufgaben, die mit einem Kalenderereignis verknüpft sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαβάστε εργασίες Lorvex που συνδέονται με ένα γεγονός ημερολογίου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Lorvex tasks linked to a calendar event."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee las tareas de Lorvex vinculadas a un evento de calendario."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خواندن کارهای Lorvex که به یک رویداد تقویم پیوند شده‌اند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit les tâches de Lorvex liées à un événement du calendrier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קריאת משימות ב-Lorvex המקושרות לאירוע בלוח השנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex के वे कार्य पढ़ें जो किसी कैलेंडर इवेंट से जुड़े हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca tugas Lorvex yang tertaut ke acara kalender."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge le attività di Lorvex collegate a un evento del calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーイベントに関連付けられたLorvexのタスクを読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 이벤트에 연결된 Lorvex 할 일을 읽습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एखाद्या दिनदर्शिका इव्हेंटशी लिंक केलेली Lorvex कार्ये वाचा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca tugas Lorvex yang dipautkan kepada peristiwa kalendar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest Lorvex-taken die aan een agenda-activiteit zijn gekoppeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytuje zadania Lorvex powiązane z wydarzeniem kalendarza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê as tarefas do Lorvex vinculadas a um evento do calendário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Citește sarcinile Lorvex legate de un eveniment de calendar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает задачи Lorvex, связанные с событием календаря."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கேலண்டர் நிகழ்வுடன் இணைக்கப்பட்ட Lorvex பணிகளைப் படிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "క్యాలెండర్ ఇవెంట్‌కు లింక్ చేసిన Lorvex టాస్క్‌లను చదవండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านงาน Lorvex ที่เชื่อมโยงกับกิจกรรมปฏิทิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir takvim etkinliğine bağlı Lorvex görevlerini okuyun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читає завдання Lorvex, пов’язані з подією календаря."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی کیلنڈر ایونٹ سے منسلک Lorvex کام پڑھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc các nhiệm vụ Lorvex được liên kết với một sự kiện lịch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取与一个日历事件关联的 Lorvex 任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取連結到行事曆事件的 Lorvex 任務。"
          }
        }
      }
    },
