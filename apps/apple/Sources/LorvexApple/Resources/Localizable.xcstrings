    "settings.calendar.read_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Lorvex قراءة تقويماتك. سيعيد المحاولة تلقائيًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex couldn’t read your calendars. It will try again automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex no pudo leer tus calendarios. Volverá a intentarlo automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex n’a pas pu lire vos calendriers. Il réessaiera automatiquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex आपके कैलेंडर नहीं पढ़ सका। वह अपने आप फिर से कोशिश करेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex non è riuscito a leggere i tuoi calendari. Riproverà automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexはカレンダーを読み取れませんでした。自動的に再試行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex에서 캘린더를 읽을 수 없습니다. 자동으로 다시 시도합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex nie mógł odczytać twoich kalendarzy. Spróbuje ponownie automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lorvex não conseguiu ler seus calendários. Ele tentará novamente automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex не удалось прочитать ваши календари. Попытка будет повторена автоматически."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex не вдалося прочитати ваші календарі. Спробу буде повторено автоматично."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 没能读取你的日历，稍后会自动重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 無法讀取你的行事曆，將會自動重試。"
          }
        }
      }
    },
    "settings.calendar.write_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يصل حدث حفظته في Lorvex إلى تقويمك. احفظه مرة أخرى لإعادة المحاولة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An event you saved in Lorvex didn’t reach your calendar. Save it again to retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un evento que guardaste en Lorvex no llegó a tu calendario. Vuelve a guardarlo para reintentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un événement enregistré dans Lorvex n’a pas atteint votre calendrier. Enregistrez-le à nouveau pour réessayer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex में सहेजा गया एक इवेंट आपके कैलेंडर तक नहीं पहुँचा। फिर से कोशिश करने के लिए उसे दोबारा सहेजें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un evento salvato in Lorvex non è arrivato nel tuo calendario. Salvalo di nuovo per riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexで保存したイベントがカレンダーに反映されませんでした。もう一度保存して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex에서 저장한 이벤트가 캘린더에 반영되지 않았습니다. 다시 저장하여 재시도하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydarzenie zapisane w Lorvex nie trafiło do twojego kalendarza. Zapisz je ponownie, aby spróbować jeszcze raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um evento que você salvou no Lorvex não chegou ao seu calendário. Salve-o novamente para tentar de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Событие, сохранённое в Lorvex, не попало в ваш календарь. Сохраните его ещё раз, чтобы повторить попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Подія, збережена в Lorvex, не потрапила до вашого календаря. Збережіть її ще раз, щоб повторити спробу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在 Lorvex 中保存的一个事件没能写入日历。再保存一次即可重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在 Lorvex 儲存的事件未能寫入行事曆。請重新儲存以再試一次。"
          }
        }
      }
    },
