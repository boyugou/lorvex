    "memory.composer.requirement": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلزم إدخال المفتاح والمحتوى معًا للحفظ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেভ করতে “কী” এবং বিষয়বস্তু, দুটিই দরকার।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Sichern sind ein Schlüssel und ein Inhalt erforderlich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για την αποθήκευση απαιτούνται τόσο ένα κλειδί όσο και περιεχόμενο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A key and content are both required to save."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para guardar se necesitan una clave y un contenido."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای ذخیره، هم کلید و هم محتوا لازم است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une clé et un contenu sont nécessaires pour enregistrer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נדרשים גם מפתח וגם תוכן כדי לשמור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजने के लिए कुंजी और सामग्री दोनों ज़रूरी हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci dan konten wajib diisi untuk menyimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per salvare servono sia una chiave sia un contenuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存するには、キーと内容の両方が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하려면 키와 내용이 모두 필요합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जतन करण्यासाठी ‘की’ आणि मजकूर, दोन्ही आवश्यक आहेत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci dan kandungan diperlukan untuk menyimpan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor het bewaren zijn een sleutel en inhoud vereist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do zapisania potrzebny jest klucz i treść."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessário informar uma chave e um conteúdo para salvar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a salva sunt necesare atât o cheie, cât și un conținut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для сохранения нужны ключ и содержимое."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சேமிக்க கீ மற்றும் உள்ளடக்கம் இரண்டும் தேவை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సేవ్ చేయడానికి కీ మరియు కంటెంట్ రెండూ అవసరం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องมีทั้งคีย์และเนื้อหาจึงจะบันทึกได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydetmek için hem bir anahtar hem de içerik gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для збереження потрібні ключ і вміст."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظ کرنے کے لیے کلید اور مواد دونوں ضروری ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần có cả khóa và nội dung để lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存需要同时填写键和内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "必須同時填寫鍵與內容才能儲存。"
          }
        }
      }
    },
