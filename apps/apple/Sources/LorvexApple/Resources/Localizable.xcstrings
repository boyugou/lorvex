          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매월 %lld일에 알리며, 완료하면 멈춥니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinnert elke maand op dag %lld en stopt zodra de gewoonte is voltooid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomina %lld. dnia każdego miesiąca i kończy się po wykonaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembra no dia %lld de cada mês e para assim que for concluído."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reamintește în ziua %lld a fiecărei luni și se oprește după ce obiceiul este finalizat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
