    "system.task.provider_event.unlink.description": {
      "comment": "Description for the Unlink Lorvex Task From Provider Event App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة الربط بين مهمة في Lorvex وحدث تقويم خارجي."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the link between a Lorvex task and an external calendar event."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita el vínculo entre una tarea de Lorvex y un evento de calendario externo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime le lien entre une tâche de Lorvex et un événement externe du calendrier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex कार्य और किसी बाहरी कैलेंडर इवेंट के बीच का लिंक हटाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove il collegamento tra un’attività di Lorvex e un evento esterno del calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexのタスクと外部のカレンダーイベントの関連付けを解除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 할 일과 외부 캘린더 이벤트의 연결을 해제합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa powiązanie zadania Lorvex z wydarzeniem kalendarza zewnętrznego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove o vínculo entre uma tarefa do Lorvex e um evento externo do calendário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет связь между задачей Lorvex и событием внешнего календаря."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаляє зв’язок між завданням Lorvex і подією зовнішнього календаря."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除任务与提供方日历事件的关联。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 Lorvex 任務與外部行事曆事件之間的連結。"
          }
        }
      }
    },
