    "settings.data_export.format.csv_detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف CSV واحد مناسب لجداول البيانات يضم قسمًا لكل فئة، لفتحه في أدوات أخرى. لا يستطيع Lorvex استيراد CSV."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্প্রেডশিটে ব্যবহারযোগ্য একটি CSV ফাইল, যাতে প্রতিটি বিভাগের জন্য একটি করে সেকশন থাকে; অন্য টুলে খোলার জন্য। Lorvex CSV ইম্পোর্ট করতে পারে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine tabellenfreundliche CSV-Datei mit einem Abschnitt pro Kategorie, zum Öffnen in anderen Programmen. Lorvex kann CSV nicht importieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα αρχείο CSV φιλικό προς τα υπολογιστικά φύλλα, με μία ενότητα ανά κατηγορία, για άνοιγμα σε άλλα εργαλεία. Το Lorvex δεν μπορεί να εισαγάγει CSV."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One spreadsheet-friendly CSV file with a section per category, for opening in other tools. Lorvex can’t import CSV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un archivo CSV apto para hojas de cálculo, con una sección por categoría, para abrirlo en otras herramientas. Lorvex no puede importar CSV."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک فایل CSV مناسب صفحه‌گسترده با یک بخش برای هر دسته، برای باز کردن در ابزارهای دیگر. Lorvex نمی‌تواند CSV را وارد کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier CSV adapté aux tableurs, avec une section par catégorie, à ouvrir dans d’autres outils. Lorvex ne peut pas importer le CSV."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובץ CSV אחד שמתאים לגיליון אלקטרוני, עם מקטע לכל קטגוריה, לפתיחה בכלים אחרים. לא ניתן לייבא CSV אל Lorvex."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक स्प्रेडशीट-अनुकूल CSV फ़ाइल, जिसमें हर श्रेणी का अलग खंड होता है, ताकि इसे दूसरे टूल में खोला जा सके। Lorvex CSV इंपोर्ट नहीं कर सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu file CSV yang ramah spreadsheet dengan satu bagian per kategori, untuk dibuka di alat lain. Lorvex tidak dapat mengimpor CSV."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un unico file CSV adatto ai fogli di calcolo, con una sezione per categoria, da aprire in altri strumenti. Lorvex non può importare il formato CSV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カテゴリごとにセクションを分けた、表計算ソフト向けのCSVファイル1つです。ほかのツールで開くために使います。LorvexはCSVを読み込めません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카테고리별로 구역을 나눈, 스프레드시트에 적합한 CSV 파일 하나입니다. 다른 도구에서 열 때 사용하세요. Lorvex는 CSV를 가져올 수 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्प्रेडशीटमध्ये वापरता येणारी एक CSV फाइल, ज्यात प्रत्येक श्रेणीसाठी एक विभाग असतो, इतर टूल्समध्ये उघडण्यासाठी. Lorvex CSV इम्पोर्ट करू शकत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu fail CSV mesra hamparan dengan satu bahagian bagi setiap kategori, untuk dibuka dalam alat lain. Lorvex tidak dapat mengimport CSV."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén CSV-bestand dat geschikt is voor spreadsheets, met een sectie per categorie, om in andere apps te openen. Lorvex kan geen CSV importeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden plik CSV przyjazny arkuszom kalkulacyjnym, z osobną sekcją dla każdej kategorii — do otwierania w innych narzędziach. Lorvex nie potrafi importować CSV."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um arquivo CSV compatível com planilhas, com uma seção por categoria, para abrir em outras ferramentas. O Lorvex não pode importar CSV."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un singur fișier CSV compatibil cu foile de calcul, cu o secțiune pentru fiecare categorie, pentru a fi deschis în alte instrumente. Lorvex nu poate importa CSV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один CSV-файл, удобный для таблиц, с отдельным разделом для каждой категории — для открытия в других программах. Lorvex не может импортировать CSV."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ CSV หนึ่งไฟล์ที่เหมาะกับสเปรดชีต แบ่งเป็นหนึ่งส่วนต่อหนึ่งหมวดหมู่ สำหรับเปิดในเครื่องมืออื่น Lorvex นำเข้า CSV ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her kategori için ayrı bir bölüm içeren, başka araçlarda açılabilen, hesap tablolarına uygun tek bir CSV dosyası. Lorvex, CSV dosyalarını içe aktaramaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один CSV-файл, зручний для електронних таблиць, з окремим розділом для кожної категорії — для відкриття в інших програмах. Lorvex не може імпортувати CSV."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک اسپریڈشیٹ کے لیے موزوں CSV فائل جس میں ہر زمرے کا ایک سیکشن ہوتا ہے، دوسرے ٹولز میں کھولنے کے لیے۔ Lorvex CSV امپورٹ نہیں کر سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một tệp CSV thân thiện với bảng tính, mỗi danh mục một phần, để mở trong các công cụ khác. Lorvex không thể nhập CSV."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个便于电子表格使用的 CSV 文件，每个类别一节，适合在其他工具中打开。Lorvex 无法导入 CSV。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個適合試算表的 CSV 檔案，每個類別各佔一個區段，可在其他工具中開啟。Lorvex 無法匯入 CSV。"
          }
        }
      }
    },
    "settings.data_export.format.json_detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف JSON واحد يمكن لـ Lorvex استيراده مرة أخرى: نسخة احتياطية، أو وسيلة لنقل بياناتك إلى نسخة أخرى من Lorvex."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex আবার ইম্পোর্ট করতে পারে এমন একটি JSON ফাইল: ব্যাকআপ হিসাবে, বা আপনার ডেটা অন্য Lorvex ইনস্টলে সরানোর উপায় হিসাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine JSON-Datei, die Lorvex wieder importieren kann: ein Backup oder eine Möglichkeit, deine Daten in eine andere Lorvex-Installation zu übertragen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα αρχείο JSON που το Lorvex μπορεί να εισαγάγει ξανά: αντίγραφο ασφαλείας ή τρόπος μεταφοράς των δεδομένων σας σε άλλη εγκατάσταση του Lorvex."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One JSON file Lorvex can import again: a backup, or a way to move your data to another Lorvex install."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un archivo JSON que Lorvex puede volver a importar: una copia de seguridad o una forma de llevar tus datos a otra instalación de Lorvex."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک فایل JSON که Lorvex می‌تواند دوباره آن را وارد کند: یک پشتیبان یا راهی برای انتقال داده‌هایتان به نصب دیگری از Lorvex."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier JSON que Lorvex peut réimporter : une sauvegarde, ou un moyen de transférer vos données vers une autre installation de Lorvex."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובץ JSON אחד שאפשר לייבא שוב אל Lorvex: גיבוי, או דרך להעביר את הנתונים להתקנה אחרת של Lorvex."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक JSON फ़ाइल जिसे Lorvex फिर से इंपोर्ट कर सकता है: बैकअप के लिए, या अपना डेटा किसी दूसरे Lorvex इंस्टॉल में ले जाने के लिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu file JSON yang dapat diimpor kembali oleh Lorvex: sebagai cadangan, atau cara memindahkan data ke instalasi Lorvex lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un unico file JSON che Lorvex può importare di nuovo: un backup, oppure un modo per spostare i dati su un’altra installazione di Lorvex."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexで再び読み込めるJSONファイル1つです。バックアップとして、またはデータを別のLorvexに移す手段として使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex에서 다시 가져올 수 있는 JSON 파일 하나입니다. 백업용으로, 또는 데이터를 다른 Lorvex 설치본으로 옮기는 용도로 사용할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex पुन्हा इम्पोर्ट करू शकेल अशी एक JSON फाइल: बॅकअप म्हणून, किंवा तुमचा डेटा दुसऱ्या Lorvex इन्स्टॉलमध्ये मूव्ह करण्यासाठी."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu fail JSON yang boleh diimport semula oleh Lorvex: sebagai sandaran, atau cara untuk memindahkan data ke pemasangan Lorvex yang lain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén JSON-bestand dat Lorvex weer kan importeren: een back-up, of een manier om je gegevens naar een andere Lorvex-installatie te verplaatsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden plik JSON, który Lorvex może ponownie zaimportować: kopia zapasowa lub sposób na przeniesienie danych do innej instalacji Lorvex."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um arquivo JSON que o Lorvex pode importar novamente: um backup ou uma forma de levar seus dados para outra instalação do Lorvex."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un singur fișier JSON pe care Lorvex îl poate importa din nou: o copie de rezervă sau o modalitate de a muta datele într-o altă instalare Lorvex."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один JSON-файл, который Lorvex сможет снова импортировать: резервная копия или способ перенести данные в другую установку Lorvex."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ JSON หนึ่งไฟล์ที่ Lorvex นำเข้าได้อีกครั้ง ใช้เป็นข้อมูลสำรองหรือใช้ย้ายข้อมูลของคุณไปยัง Lorvex อีกเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex’in yeniden içe aktarabildiği tek bir JSON dosyası: bir yedek veya verilerinizi başka bir Lorvex kurulumuna taşımanın bir yolu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один JSON-файл, який Lorvex зможе знову імпортувати: резервна копія або спосіб перенести дані до іншої інсталяції Lorvex."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک JSON فائل جسے Lorvex دوبارہ امپورٹ کر سکتا ہے: بیک اپ، یا اپنا ڈیٹا کسی دوسری Lorvex انسٹالیشن میں منتقل کرنے کا طریقہ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một tệp JSON mà Lorvex có thể nhập lại: dùng làm bản sao lưu, hoặc để chuyển dữ liệu sang bản cài đặt Lorvex khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个 Lorvex 可以再次导入的 JSON 文件：可用来备份，或把数据迁移到另一个 Lorvex。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個 Lorvex 可再次匯入的 JSON 檔案，可作為備份，或用來將資料移到另一個 Lorvex。"
          }
        }
      }
    },
    "settings.data_export.format.zip_detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرشيف ZIP يحتوي على ملف JSON لكل فئة. يمكن لـ Lorvex استيراده مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি বিভাগের জন্য একটি করে JSON ফাইলসহ একটি ZIP আর্কাইভ। Lorvex এটি আবার ইম্পোর্ট করতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ZIP-Archiv mit einer JSON-Datei pro Kategorie. Lorvex kann es wieder importieren."
          }
        },
        "el": {
          "stringUnit": {
