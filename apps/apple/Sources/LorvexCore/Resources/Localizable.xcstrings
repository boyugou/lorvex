        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই শিরোনামটি অনেক বড়। এটি ছোট করে আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Titel ist zu lang. Kürze ihn und versuche es erneut."
