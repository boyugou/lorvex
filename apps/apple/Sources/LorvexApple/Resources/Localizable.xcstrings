          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp dụng cho những gì Lorvex và các trợ lý được kết nối có thể thấy trên thiết bị này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于 Lorvex 和已连接的助手可在此设备上看到的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適用於 Lorvex 與已連接的助理在此裝置上能看到的內容。"
          }
        }
      }
    },
    "settings.calendar.access_denied": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم رفض الوصول إلى التقويم. افتح إعدادات النظام لمنح حق الوصول."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যালেন্ডারে অ্যাক্সেস অস্বীকার করা হয়েছে। অ্যাক্সেস দিতে সিস্টেম সেটিংস খুলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf Kalender wurde verweigert. Öffne die Systemeinstellungen, um den Zugriff zu erlauben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πρόσβαση στο ημερολόγιο έχει απορριφθεί. Ανοίξτε τις Ρυθμίσεις συστήματος για να την παραχωρήσετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar access has been denied. Open System Settings to grant access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha denegado el acceso al calendario. Abre Ajustes del Sistema para concederlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به تقویم رد شده است. برای اعطای دسترسی، تنظیمات سیستم را باز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au calendrier a été refusé. Ouvrez Réglages Système pour l’autoriser."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגישה ללוח השנה נדחתה. יש לפתוח את הגדרות המערכת כדי להעניק גישה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलेंडर एक्सेस अस्वीकार कर दिया गया है। एक्सेस देने के लिए सिस्टम सेटिंग्ज़ खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses kalender ditolak. Buka Pengaturan Sistem untuk memberikan akses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso al calendario è stato negato. Apri Impostazioni di Sistema per consentirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーへのアクセスが拒否されています。「システム設定」を開いてアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 접근이 거부되었습니다. 시스템 설정을 열어 접근을 허용하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दिनदर्शिका ॲक्सेस नाकारला गेला आहे. ॲक्सेस देण्यासाठी सिस्टीम सेटिंग उघडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses kalendar telah dinafikan. Buka Seting Sistem untuk memberikan akses."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot de agenda is geweigerd. Open Systeeminstellingen om toegang te geven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odmówiono dostępu do kalendarza. Otwórz Ustawienia systemowe, aby go przyznać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao calendário foi negado. Abra os Ajustes do Sistema para permitir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesul la calendar a fost refuzat. Deschideți Configurări sistem pentru a permite accesul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к календарю запрещён. Откройте Системные настройки, чтобы разрешить доступ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าถึงปฏิทินถูกปฏิเสธ เปิดการตั้งค่าระบบเพื่ออนุญาตการเข้าถึง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvim erişimi reddedildi. Erişim vermek için Sistem Ayarları’nı açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до календаря заборонено. Відкрийте Системні параметри, щоб надати доступ."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیلنڈر تک رسائی مسترد کر دی گئی ہے۔ رسائی دینے کے لیے سسٹم کی ترتیبات کھولیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập lịch đã bị từ chối. Hãy mở Cài đặt hệ thống để cấp quyền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日历访问已被拒绝。请打开“系统设置”授予访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "行事曆存取權限已被拒絕。請開啟「系統設定」來授予存取權限。"
          }
        }
      }
    },
