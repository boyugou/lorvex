            "value": "دستیار چه چیزی را باید به خاطر بسپارد؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que doit retenir l’assistant ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מה העוזר צריך לזכור?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "असिस्टेंट को क्या याद रखना चाहिए?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang perlu diingat asisten?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa deve ricordare l’assistente?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントに何を覚えてもらいますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어시스턴트가 무엇을 기억해야 하나요?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सहाय्यकाने काय लक्षात ठेवावे?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah yang perlu diingati pembantu AI?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat moet de assistent onthouden?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co asystent ma zapamiętać?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o assistente deve lembrar?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce ar trebui să rețină asistentul?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что должен помнить ассистент?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அசிஸ்டென்ட் எதை நினைவில் வைத்திருக்க வேண்டும்?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అసిస్టెంట్ ఏం గుర్తుంచుకోవాలి?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ช่วยควรจดจำอะไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asistan neyi hatırlamalı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що має пам’ятати асистент?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسسٹنٹ کو کیا یاد رکھنا چاہیے؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trợ lý cần ghi nhớ điều gì?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "希望助手记住什么？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "希望助理記住什麼？"
          }
        }
      }
