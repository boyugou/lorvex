    "database.recovery.notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Lorvex فتح قاعدة بياناتك السابقة (%1$@)، فتم وضعها جانبًا وإنشاء قاعدة جديدة. بياناتك السابقة محفوظة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex couldn’t open your previous database (%1$@), so it was set aside and a fresh one was created. Your earlier data is preserved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex no pudo abrir tu base de datos anterior (%1$@), así que se apartó y se creó una nueva. Tus datos anteriores se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex n’a pas pu ouvrir votre base de données précédente (%1$@). Elle a été mise de côté et une nouvelle base a été créée. Vos données antérieures sont conservées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex आपका पिछला डेटाबेस (%1$@) नहीं खोल सका, इसलिए उसे अलग रख दिया गया और नया डेटाबेस बनाया गया। आपका पहले का डेटा सुरक्षित है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex non è riuscito ad aprire il tuo database precedente (%1$@), quindi è stato messo da parte ed è stato creato un nuovo database. I tuoi dati precedenti sono conservati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexが以前のデータベース（%1$@）を開けなかったため、そのデータベースは別の場所に保管され、新しいデータベースが作成されました。以前のデータは保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex에서 이전 데이터베이스(%1$@)를 열 수 없어 따로 보관하고 새 데이터베이스를 만들었습니다. 이전 데이터는 그대로 보존되어 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex nie mógł otworzyć twojej poprzedniej bazy danych (%1$@), więc odłożył ją na bok i utworzył nową. Twoje wcześniejsze dane są zachowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lorvex não conseguiu abrir seu banco de dados anterior (%1$@), então ele foi separado e um novo foi criado. Seus dados anteriores foram preservados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex не удалось открыть вашу прежнюю базу данных (%1$@), поэтому она сохранена отдельно, а вместо неё создана новая. Ваши прежние данные не потеряны."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex не вдалося відкрити вашу попередню базу даних (%1$@), тому її збережено окремо, а замість неї створено нову. Ваші попередні дані збережено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 无法打开你之前的数据库（%1$@），因此已将其保存起来并创建了一个新数据库。你之前的数据仍会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 無法開啟你先前的資料庫（%1$@），因此已將它另行保存，並建立了一個新的資料庫。你先前的資料仍會保留。"
          }
        }
      }
    },
