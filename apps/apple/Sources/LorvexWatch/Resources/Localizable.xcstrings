    "watch.action.cancel.confirm": {
      "comment": "Title of the cancel-task confirmation dialog; %@ is the task title",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد إلغاء هذا التكرار من \"%@\"؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel this occurrence of %@?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cancelar esta repetición de “%@”?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler cette occurrence de « %@ » ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” को केवल इस बार के लिए रद्द करें?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annullare questa occorrenza di “%@”?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の今回分をキャンセルしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”의 이번 반복을 취소하시겠습니까?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulować to wystąpienie zadania „%@”?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar esta ocorrência de “%@”?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить это повторение задачи «%@»?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасувати це повторення завдання «%@»?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅取消“%@”的这一次？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要取消「%@」的這一次嗎？"
          }
        }
      }
    },
    "watch.action.cancel.hint": {
      "comment": "Accessibility hint for cancelling a task; %@ is the task title",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلغي هذا التكرار من \"%@\""
          }
        },
        "en": {
