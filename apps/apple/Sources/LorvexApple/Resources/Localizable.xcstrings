    "habits.empty.no_habits_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر ＋ لبدء عادة تريد بناءها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে অভ্যাস গড়ে তুলতে চান, তা শুরু করতে ＋ ক্লিক করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf ＋, um eine neue Gewohnheit aufzubauen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάντε κλικ στο ＋ για να ξεκινήσετε μια συνήθεια που θέλετε να αποκτήσετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click ＋ to start a habit you want to build."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en ＋ para empezar un hábito que quieras formar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای شروع عادتی که می‌خواهید بسازید، روی ＋ کلیک کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur ＋ pour commencer une habitude à adopter."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש ללחוץ על ＋ כדי להתחיל הרגל שרוצים לבנות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो आदत बनानी हो, उसे शुरू करने के लिए ＋ पर क्लिक करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik ＋ untuk memulai kebiasaan yang ingin dibangun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su ＋ per iniziare un’abitudine che vuoi costruire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "＋をクリックして、身につけたい習慣を始めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "＋ 버튼을 클릭하여 만들고 싶은 습관을 시작하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हाला जी सवय लावायची आहे ती सुरू करण्यासाठी ＋ क्लिक करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik ＋ untuk memulakan tabiat yang ingin dibina."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op ＋ om te beginnen met een gewoonte die je wilt opbouwen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij ＋, aby zacząć budować nawyk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em ＋ para começar um hábito que você quer criar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Faceți clic pe ＋ pentru a începe un obicei pe care doriți să-l formați."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите ＋, чтобы начать формировать привычку."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் உருவாக்க விரும்பும் பழக்கத்தைத் தொடங்க ＋ கிளிக் செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు పెంపొందించుకోవాలనుకుంటున్న అలవాటును ప్రారంభించడానికి ＋ క్లిక్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิก ＋ เพื่อเริ่มสร้างนิสัยที่คุณต้องการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Edinmek istediğiniz bir alışkanlığa başlamak için ＋ düğmesini tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть ＋, щоб почати формувати звичку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جو عادت بنانا چاہتے ہیں اسے شروع کرنے کے لیے ＋ پر کلک کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm ＋ để bắt đầu một thói quen bạn muốn xây dựng."
          }
        },
        "zh-Hans": {
