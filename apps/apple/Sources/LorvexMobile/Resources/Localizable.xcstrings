              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Déplacer « %1$@ », « %2$@ » et %3$lld autre à demain libère environ %4$@."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Déplacer « %1$@ », « %2$@ » et %3$lld autres à demain libère environ %4$@."
