    "task_detail.empty.no_selection_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مهمة من اليوم أو المهام أو القوائم أو التقويم لمراجعة تفاصيلها هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Aufgabe in „Heute“, „Aufgaben“, „Listen“ oder „Kalender“ aus, um hier ihre Details anzusehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a task from Today, Tasks, Lists, or Calendar to review its details here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona una tarea en Hoy, Tareas, Listas o Calendario para ver sus detalles aquí."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای دیدن جزئیات کار در اینجا، یک کار را از «امروز»، «همه کارها»، «فهرست‌ها» یا «تقویم» انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez une tâche dans Aujourd’hui, Toutes les tâches, Listes ou Calendrier pour afficher ses détails ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור משימה מ\"היום\", \"כל המשימות\", \"רשימות\" או \"לוח שנה\" כדי לעיין בפרטיה כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्योरा यहाँ देखने के लिए आज, कार्य, सूचियाँ या कैलेंडर में से कोई कार्य चुनें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona un’attività da Oggi, Tutte le attività, Liste o Calendario per vederne qui i dettagli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「今日」「タスク」「リスト」「カレンダー」からタスクを選択すると、ここに詳細が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘, 할 일, 목록 또는 캘린더에서 할 일을 선택하면 여기에서 세부 정보를 볼 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer een taak in ‘Vandaag’, ‘Taken’, ‘Lijsten’ of ‘Agenda’ om hier de details te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz zadanie w sekcji „Dzisiaj”, „Wszystkie zadania”, „Listy” lub „Kalendarz”, aby zobaczyć jego szczegóły tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione uma tarefa em Hoje, Todas as tarefas, Listas ou Calendário para ver os detalhes aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Selectați o sarcină din „Astăzi”, „Sarcini”, „Liste” sau „Calendar” pentru a-i vedea aici detaliile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите задачу в разделе «Сегодня», «Все задачи», «Списки» или «Календарь», чтобы увидеть её подробности здесь."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть завдання в розділі «Сьогодні», «Усі завдання», «Списки» або «Календар», щоб побачити його подробиці тут."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہاں کسی کام کی تفصیلات دیکھنے کے لیے \"آج\"، \"تمام کام\"، \"فہرستیں\" یا \"کیلنڈر\" میں سے کوئی کام منتخب کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“今天”、“任务”、“列表”或“日历”中选择一个任务，即可在此查看其详情。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從「今天」、「任務」、「清單」或「行事曆」選取任務，即可在這裡查看詳細資料。"
          }
        }
      }
    },
