    "watch.action.cancel.message": {
      "comment": "Confirmation message for cancelling a task",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في المهام المتكررة، يُلغى هذا التكرار فقط وتستمر التكرارات اللاحقة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For repeating tasks, only this occurrence is cancelled and future occurrences continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En las tareas recurrentes, solo se cancela esta repetición y las siguientes continúan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les tâches récurrentes, seule cette occurrence est annulée et les suivantes continuent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोहराए जाने वाले कार्यों में केवल इस बार का कार्य रद्द होता है, आगे के कार्य जारी रहते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per le attività ricorrenti viene annullata solo questa occorrenza e le successive continuano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "繰り返しタスクの場合、キャンセルされるのは今回分のみで、以降の分は続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반복되는 할 일은 이번 반복만 취소되고 이후 반복은 그대로 이어집니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W zadaniach powtarzających się anulowane jest tylko to wystąpienie, a kolejne są kontynuowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em tarefas recorrentes, apenas esta ocorrência é cancelada e as próximas continuam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для повторяющихся задач отменяется только это повторение, а следующие продолжаются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для повторюваних завдань скасовується лише це повторення, а наступні тривають."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对于重复任务，只会取消本次，之后的任务仍会继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重複任務只會取消這一次，之後的重複仍會繼續。"
          }
        }
      }
    },
