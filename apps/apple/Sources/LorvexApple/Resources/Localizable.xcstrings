    "task_detail.notes.character_limit": {
      "comment": "Counter under a task's notes near the limit. 1: characters written. 2: the limit.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld / %#@limit@"
          },
          "substitutions": {
            "limit": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "few": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg أحرف"
                    }
                  },
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg حرفًا"
                    }
                  },
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "حرف واحد"
