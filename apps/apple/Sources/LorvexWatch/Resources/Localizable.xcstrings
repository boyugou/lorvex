            "state": "translated",
            "value": "Spațiul de lucru de pe iPhone a fost înlocuit înainte ca această acțiune să fie aplicată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рабочая область на iPhone была заменена до применения этого действия."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Робочу область на iPhone було замінено до застосування цієї дії."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس اقدام کے لاگو ہونے سے پہلے iPhone کا ورک اسپیس تبدیل ہو گیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu trên iPhone đã được thay thế trước khi thao tác này được áp dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用此操作前，iPhone 工作区已被替换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在套用此操作前，iPhone 的資料庫已被取代。"
          }
        }
      }
    },
    "watch.error.action_failed": {
      "comment": "Watch Today: a task or habit action failed to save",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم حفظ هذا التغيير. حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Änderung wurde nicht gesichert. Versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That change didn’t save. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cambio no se guardó. Inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آن تغییر ذخیره نشد. دوباره تلاش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La modification n’a pas été enregistrée. Réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השינוי לא נשמר. יש לנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह बदलाव सहेजा नहीं जा सका। फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan itu tidak tersimpan. Coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modifica non è stata salvata. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を保存できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항을 저장하지 못했습니다. 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan itu tidak disimpan. Cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die wijziging is niet bewaard. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zapisano zmiany. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A alteração não foi salva. Tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificarea nu a fost salvată. Încercați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменение не сохранено. Повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміну не збережено. Повторіть спробу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ تبدیلی محفوظ نہیں ہوئی۔ دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi đó chưa được lưu. Hãy thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这项更改没有保存，请再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存這項變更，請再試一次。"
          }
        }
      }
    },
    "watch.error.capture_forwarder_required": {
      "comment": "Error shown if a watch capture action reaches a read-only snapshot backend without an iPhone/Mac mutation forwarder",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Lorvex على iPhone أو Mac لإضافة مهام جديدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Lorvex auf dem iPhone oder Mac, um neue Aufgaben zu erfassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Lorvex on iPhone or Mac to capture new tasks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Lorvex en el iPhone o el Mac para añadir tareas nuevas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای افزودن کارهای جدید، Lorvex را در iPhone یا Mac باز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Lorvex sur l’iPhone ou le Mac pour ajouter de nouvelles tâches."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להוסיף משימות חדשות, יש לפתוח את Lorvex ב-iPhone או ב-Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नए कार्य जोड़ने के लिए iPhone या Mac पर Lorvex खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Lorvex di iPhone atau Mac untuk mencatat tugas baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Lorvex su iPhone o Mac per aggiungere nuove attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいタスクを追加するには、iPhoneまたはMacでLorvexを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 할 일을 추가하려면 iPhone 또는 Mac에서 Lorvex를 여세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Lorvex pada iPhone atau Mac untuk mencatat tugas baharu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Lorvex op iPhone of Mac om nieuwe taken vast te leggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Lorvex na iPhonie lub Macu, aby dodawać nowe zadania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Lorvex no iPhone ou no Mac para adicionar novas tarefas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschideți Lorvex pe iPhone sau Mac pentru a adăuga sarcini noi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Lorvex на iPhone или Mac, чтобы добавлять новые задачи."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте Lorvex на iPhone або Mac, щоб додавати нові завдання."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نئے کام شامل کرنے کے لیے iPhone یا Mac پر Lorvex کھولیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy mở Lorvex trên iPhone hoặc Mac để ghi nhanh nhiệm vụ mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 或 Mac 上打开 Lorvex 以添加新任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 iPhone 或 Mac 上開啟 Lorvex 以新增任務。"
          }
        }
      }
    },
