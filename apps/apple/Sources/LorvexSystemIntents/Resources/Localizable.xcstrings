    "system.task.recurrence.exception.remove.description": {
      "comment": "Description for the Remove Lorvex Recurrence Exception App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استعادة تاريخ تكرار واحد تم تخطيه لمهمة متكررة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি পুনরাবৃত্ত টাস্কের এড়িয়ে যাওয়া একটি তারিখ ফিরিয়ে আনুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt eine übersprungene Wiederholung einer wiederkehrenden Aufgabe wieder her."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαναφέρετε μία παραλειφθείσα ημερομηνία επανάληψης μιας επαναλαμβανόμενης εργασίας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore one skipped occurrence date for a recurring task."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura una fecha de repetición omitida de una tarea recurrente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بازگرداندن یک تاریخ تکرار ردشده برای یک کار تکرارشونده."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablit une occurrence ignorée d’une tâche récurrente."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שחזור תאריך חזרה אחד שדולג במשימה חוזרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोहराए जाने वाले कार्य की छोड़ी गई एक तारीख़ रीस्टोर करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memulihkan satu tanggal kejadian yang dilewati untuk tugas berulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina un’occorrenza saltata di un’attività ricorrente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキップした繰り返しの日を1回分元に戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건너뛴 반복 날짜 하나를 복원합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनरावृत्ती होणाऱ्या कार्याचा वगळलेला एक दिनांक पुन्हा आणा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memulihkan satu tarikh kejadian yang dilangkau bagi tugas berulang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstelt één overgeslagen herhaling van een terugkerende taak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywraca jedną pominiętą datę w powtarzającym się zadaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura uma ocorrência ignorada de uma tarefa recorrente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Restabilește o dată de apariție omisă pentru o sarcină recurentă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстанавливает одну пропущенную дату в повторяющейся задаче."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடர் பணிக்குத் தவிர்க்கப்பட்ட ஒரு நேர்வுத் தேதியை மீட்டெடு."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పునరావృతమయ్యే టాస్క్ కోసం దాటవేసిన ఒక సందర్భ తేదీని పునరుద్ధరించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คืนค่าวันที่ทำประจำที่ถูกข้ามหนึ่งวันของงานที่ทำประจำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yinelenen bir görev için atlanmış bir yineleme tarihini geri yükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновлює одну пропущену дату в повторюваному завданні."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دہرائے جانے والے کام کی چھوڑی گئی کوئی ایک تکرار کی تاریخ بحال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục một ngày lặp đã bị bỏ qua của một nhiệm vụ lặp lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复周期性任务中一个被跳过的发生日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還原重複任務中已略過的一個日期。"
          }
        }
      }
    },
