    "system.task.provider_event.link.description": {
      "comment": "Description for the Link Lorvex Task To Provider Event App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ربط مهمة في Lorvex بحدث تقويم خارجي."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link a Lorvex task to an external calendar event."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vincula una tarea de Lorvex a un evento de calendario externo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lie une tâche de Lorvex à un événement externe du calendrier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex कार्य को किसी बाहरी कैलेंडर इवेंट से जोड़ें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
