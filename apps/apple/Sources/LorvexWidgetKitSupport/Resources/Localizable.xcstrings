            "value": "ウィジェットからLorvexのタスクを完了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위젯에서 Lorvex 할 일을 완료합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "विजेटवरून एक Lorvex कार्य पूर्ण करा."
          }
        },
        "ms": {
