    "tasks.lists.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط ＋ لتجميع المهام المترابطة في قائمة، أو اطلب من مساعدك ذلك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap ＋ to group related tasks into a list — or ask your assistant to."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca ＋ para agrupar tareas relacionadas en una lista, o pídeselo a tu asistente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای گروه‌بندی کارهای مرتبط در یک فهرست، روی ＋ ضربه بزنید — یا از دستیارتان بخواهید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez ＋ pour regrouper des tâches liées dans une liste, ou demandez à votre assistant de le faire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להקיש על ＋ כדי לקבץ משימות קשורות לרשימה — או לבקש זאת מהעוזר שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संबंधित कार्यों को एक सूची में रखने के लिए ＋ पर टैप करें, या अपने असिस्टेंट से कहें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca ＋ per raggruppare attività correlate in una lista oppure chiedi al tuo assistente di farlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "＋をタップして、関連するタスクをリストにまとめましょう。アシスタントに頼むこともできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "＋ 버튼을 탭하여 관련 할 일을 목록으로 묶어 보세요. 어시스턴트에게 요청할 수도 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij ＋, aby zgrupować powiązane zadania na liście — albo poproś o to asystenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em ＋ para agrupar tarefas relacionadas em uma lista ou peça ao seu assistente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь ＋, чтобы объединить связанные задачи в список. Или попросите об этом ассистента."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніть ＋, щоб об’єднати пов’язані завдання в список. Або попросіть про це асистента."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "متعلقہ کاموں کو ایک فہرست میں گروپ کرنے کے لیے ＋ پر ٹیپ کریں — یا اپنے اسسٹنٹ سے کہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按 ＋ 把相关任务归入一个列表，或让助手代劳。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下 ＋ 將相關的任務整理成清單，也可以請助理代勞。"
          }
        }
      }
    },
