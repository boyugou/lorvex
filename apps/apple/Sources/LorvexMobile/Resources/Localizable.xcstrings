    "task_detail.picker.hide_until.hint": {
      "comment": "iPhone task field sheet footer for the hide-until day.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى بعيدة عن أيامك حتى ذلك الحين."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept off your days until then."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuera de tus días hasta entonces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Absente de vos journées jusque-là."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तब तक आपके दिनों से बाहर रखा जाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuori dalle tue giornate fino ad allora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その日になるまで、各日の予定には表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그날이 되기 전에는 각 날짜의 일정에 표시되지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukryte w twoich dniach do tej daty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fica fora dos seus dias até lá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрыта из ваших дней до этой даты."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приховано з ваших днів до цієї дати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在那之前不会出现在你的日程里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在那天之前，不會列入你每天的待辦。"
          }
        }
      }
    },
