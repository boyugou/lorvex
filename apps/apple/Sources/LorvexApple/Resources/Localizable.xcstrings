    "database.recovery.notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Lorvex فتح قاعدة بياناتك السابقة (%1$@)، فتم وضعها جانبًا في %2$@ وإنشاء قاعدة جديدة. بياناتك السابقة محفوظة هناك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex আপনার আগের ডেটাবেস (%1$@) খুলতে পারেনি, তাই সেটি %2$@ লোকেশনে আলাদা করে রাখা হয়েছে এবং একটি নতুন ডেটাবেস তৈরি করা হয়েছে। আপনার আগের ডেটা সেখানেই সংরক্ষিত আছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex konnte deine bisherige Datenbank (%1$@) nicht öffnen. Sie wurde unter %2$@ beiseitegelegt und eine neue Datenbank wurde angelegt. Deine früheren Daten sind dort erhalten geblieben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Lorvex δεν μπόρεσε να ανοίξει την προηγούμενη βάση δεδομένων σας (%1$@), οπότε μεταφέρθηκε στη θέση %2$@ και δημιουργήθηκε μια νέα. Τα προηγούμενα δεδομένα σας διατηρούνται εκεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex couldn’t open your previous database (%1$@), so it was set aside at %2$@ and a fresh one was created. Your earlier data is preserved there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex no pudo abrir tu base de datos anterior (%1$@), así que se apartó en %2$@ y se creó una nueva. Tus datos anteriores se conservan allí."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه Lorvex نتوانست پایگاه‌داده قبلی شما (%1$@) را باز کند؛ بنابراین آن را در %2$@ کنار گذاشت و یک پایگاه‌داده تازه ایجاد کرد. داده‌های قبلی شما همان‌جا نگهداری می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex n’a pas pu ouvrir votre base de données précédente (%1$@). Elle a été mise de côté dans %2$@ et une nouvelle base a été créée. Vos données antérieures y sont conservées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לפתוח את מסד הנתונים הקודם שלך (%1$@) ב-Lorvex, ולכן הוא הועבר הצידה אל %2$@ ונוצר מסד נתונים חדש. הנתונים הקודמים שלך נשמרו שם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex आपका पिछला डेटाबेस (%1$@) नहीं खोल सका, इसलिए उसे %2$@ पर अलग रख दिया गया और नया डेटाबेस बनाया गया। आपका पहले का डेटा वहीं सुरक्षित है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex tidak dapat membuka basis data sebelumnya (%1$@), sehingga basis data itu disisihkan di %2$@ dan basis data baru dibuat. Data sebelumnya tetap tersimpan di sana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex non è riuscito ad aprire il tuo database precedente (%1$@), quindi è stato messo da parte in %2$@ e ne è stato creato uno nuovo. I tuoi dati precedenti sono conservati lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexは以前のデータベース（%1$@）を開けなかったため、%2$@に退避し、新しいデータベースを作成しました。以前のデータはそこに保存されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex에서 이전 데이터베이스(%1$@)를 열 수 없어 %2$@에 따로 보관하고 새 데이터베이스를 만들었습니다. 이전 데이터는 그곳에 보존되어 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex तुमचा आधीचा डेटाबेस (%1$@) उघडू शकले नाही, म्हणून तो %2$@ येथे वेगळा ठेवला गेला आणि नवीन डेटाबेस तयार केला गेला. तुमचा आधीचा डेटा तेथे जतन आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex tidak dapat membuka pangkalan data sebelumnya (%1$@), jadi pangkalan data itu diasingkan di %2$@ dan pangkalan data baharu dicipta. Data sebelumnya kekal tersimpan di sana."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex kon je vorige database (%1$@) niet openen. Deze is apart gezet op %2$@ en er is een nieuwe database aangemaakt. Je eerdere gegevens zijn daar bewaard gebleven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się otworzyć poprzedniej bazy danych Lorvex (%1$@), więc odłożono ją w %2$@ i utworzono nową. Twoje wcześniejsze dane zostały tam zachowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lorvex não conseguiu abrir seu banco de dados anterior (%1$@), então ele foi separado em %2$@ e um novo foi criado. Seus dados anteriores estão preservados lá."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex nu a putut deschide baza de date anterioară (%1$@), așa că aceasta a fost mutată în %2$@ și a fost creată una nouă. Datele anterioare sunt păstrate acolo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex не удалось открыть вашу предыдущую базу данных (%1$@), поэтому она перемещена в %2$@, а вместо неё создана новая. Ваши прежние данные сохранены там."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex ไม่สามารถเปิดฐานข้อมูลก่อนหน้าของคุณได้ (%1$@) จึงนำไปเก็บไว้ที่ %2$@ และสร้างฐานข้อมูลใหม่ ข้อมูลเดิมของคุณยังคงอยู่ที่นั่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex önceki veritabanınızı açamadı (%1$@). Bu veritabanı %2$@ konumuna ayrıldı ve yeni bir veritabanı oluşturuldu. Önceki verileriniz orada saklanıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex не вдалося відкрити вашу попередню базу даних (%1$@), тому її переміщено до %2$@, а замість неї створено нову. Ваші попередні дані збережено там."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا پچھلا ڈیٹابیس (%1$@) Lorvex نہیں کھول سکا، اس لیے اسے %2$@ پر الگ رکھ دیا گیا اور ایک نیا ڈیٹابیس بنا دیا گیا۔ آپ کا پرانا ڈیٹا وہیں محفوظ ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex không thể mở cơ sở dữ liệu trước đó (%1$@), nên đã cất riêng nó tại %2$@ và tạo một cơ sở dữ liệu mới. Dữ liệu cũ vẫn được giữ ở đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 无法打开你之前的数据库（%1$@），因此已将其保存在 %2$@ 并创建了一个新数据库。你之前的数据仍保留在那里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 無法開啟你先前的資料庫（%1$@），因此已將其移至 %2$@，並建立了新的資料庫。你先前的資料仍保存在該處。"
          }
        }
      }
    },
