            "state": "translated",
            "value": "Le jour où elle doit être terminée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह दिन जिस तक इसे पूरा करना है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
