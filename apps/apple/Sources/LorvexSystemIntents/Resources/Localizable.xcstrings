    "system.task.recurrence.exception.add.description": {
      "comment": "Description for the Add Lorvex Recurrence Exception App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تخطي تاريخ تكرار واحد لمهمة متكررة في Lorvex."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি পুনরাবৃত্ত Lorvex টাস্কের একটি তারিখ এড়িয়ে যান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überspringt für eine wiederkehrende Lorvex-Aufgabe eine einzelne Wiederholung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παραλείψτε μία ημερομηνία επανάληψης μιας επαναλαμβανόμενης εργασίας Lorvex."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip one occurrence date for a recurring Lorvex task."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omite una fecha de repetición de una tarea recurrente de Lorvex."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رد کردن یک تاریخ تکرار برای یک کار تکرارشونده در Lorvex."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignore une occurrence d’une tâche récurrente de Lorvex."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דילוג על תאריך חזרה אחד במשימה חוזרת ב-Lorvex."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोहराए जाने वाले Lorvex कार्य की किसी एक तारीख़ को छोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Melewati satu tanggal kejadian untuk tugas Lorvex yang berulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta un’occorrenza di un’attività ricorrente di Lorvex."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "繰り返しのLorvexのタスクで、特定の日の1回分をスキップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반복되는 Lorvex 할 일에서 특정 날짜의 반복 하나를 건너뜁니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनरावृत्ती होणाऱ्या Lorvex कार्याचा एक दिनांक वगळा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Melangkau satu tarikh kejadian bagi tugas Lorvex yang berulang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaat één herhaling over voor een terugkerende Lorvex-taak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomija jedną datę w powtarzającym się zadaniu Lorvex."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignora uma ocorrência de uma tarefa recorrente do Lorvex."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Omite o dată de apariție pentru o sarcină Lorvex recurentă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропускает одну дату в повторяющейся задаче Lorvex."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடர் Lorvex பணிக்கு ஒரு நேர்வுத் தேதியைத் தவிர்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పునరావృతమయ్యే Lorvex టాస్క్ కోసం ఒక సందర్భ తేదీని దాటవేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้ามวันที่ทำประจำหนึ่งวันของงาน Lorvex ที่ทำประจำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yinelenen bir Lorvex görevi için tek bir yineleme tarihini atlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропускає одну дату в повторюваному завданні Lorvex."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دہرائے جانے والے Lorvex کام کی کوئی ایک تکرار کی تاریخ چھوڑ دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ qua một ngày lặp của một nhiệm vụ Lorvex lặp lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳过一个周期性 Lorvex 任务的某次发生日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "略過重複 Lorvex 任務中特定日期的一次。"
          }
        }
      }
    },
    "system.task.recurrence.exception.add.dialog": {
      "comment": "Dialog after adding a recurrence exception; %@ is the task title",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تخطي تاريخ تكرار واحد لـ %@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” টাস্কের একটি পুনরাবৃত্তির তারিখ এড়িয়ে যাওয়া হয়েছে।"
          }
