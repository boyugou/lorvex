        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस कार्य को ठोस चरणों में बाँटने के लिए पहला चेकलिस्ट आइटम जोड़ें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi il primo elemento alla lista di controllo per suddividere questa attività in passaggi concreti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のチェックリスト項目を追加して、このタスクを具体的なステップに分けましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 체크리스트 항목을 추가하여 이 할 일을 구체적인 단계로 나눠 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg het eerste checklistonderdeel toe om deze taak op te splitsen in concrete stappen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj pierwszy element listy kontrolnej, aby podzielić zadanie na konkretne kroki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione o primeiro item da lista de verificação para dividir esta tarefa em etapas concretas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adăugați primul element din lista de control pentru a împărți sarcina în pași concreți."
