        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دو ہفتوں کے چیک اِن کے بعد آپ کا ہفتہ وار پیٹرن یہاں نظر آئے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mẫu theo tuần sẽ hiển thị ở đây sau hai tuần điểm danh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
