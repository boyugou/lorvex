    "today.schedule.clear.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تفقد مهام اليوم غير المنجزة أوقاتها وتبقى في اليوم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today’s unfinished tasks lose their times and stay on today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas pendientes de hoy pierden su hora y siguen en Hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches non terminées d’aujourd’hui perdent leur horaire et restent sur aujourd’hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज के अधूरे कार्यों के समय हट जाएँगे और वे आज पर ही रहेंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le attività non completate di oggi perdono l’orario e restano su oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の未完了のタスクは時刻がクリアされ、今日のままになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 미완료 할 일은 시간이 지워지고 오늘에 그대로 남습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieukończone zadania na dziś stracą godziny, ale zostaną na dzisiaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas não concluídas de hoje perdem o horário e continuam em hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Невыполненные задачи на сегодня потеряют время, но останутся на сегодня."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Невиконані завдання на сьогодні втратять час, але залишаться на сьогодні."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天未完成的任务会移除时间，但仍留在今天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天尚未完成的任務會清除時間，但仍留在今天。"
          }
        }
      }
    },
