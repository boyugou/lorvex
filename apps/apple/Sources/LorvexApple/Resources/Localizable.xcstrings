          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press the shortcut in any app to add a task without switching to Lorvex."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa el atajo de teclado en cualquier app para añadir una tarea sin cambiar a Lorvex."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای افزودن یک کار بدون رفتن به Lorvex، میان‌بر صفحه‌کلید را در هر برنامه‌ای فشار دهید."
          }
        },
        "fr": {
          "stringUnit": {
