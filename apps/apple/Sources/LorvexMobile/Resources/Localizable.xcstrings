    "memory.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط ＋ لحفظ ما تريد أن يتذكره مساعدك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap ＋ to save something your assistant should remember."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca ＋ para guardar algo que tu asistente deba recordar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez ＋ pour enregistrer ce que votre assistant doit retenir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो बात आपके असिस्टेंट को याद रखनी चाहिए, उसे सहेजने के लिए ＋ पर टैप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca ＋ per salvare qualcosa che il tuo assistente dovrebbe ricordare."
