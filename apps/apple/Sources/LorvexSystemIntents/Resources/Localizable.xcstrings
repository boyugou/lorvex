    "system.task.reminders.upcoming.read.description": {
      "comment": "Description for the Read Lorvex Upcoming Task Reminders App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة تذكيرات مهام Lorvex القادمة قريبًا وما زالت قيد الانتظار."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read pending Lorvex task reminders coming up soon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee los recordatorios pendientes de tareas de Lorvex que se acercan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit les rappels de tâches de Lorvex en attente qui arrivent bientôt."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex कार्यों के वे लंबित रिमाइंडर पढ़ें जो जल्द आने वाले हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge i promemoria in sospeso delle attività di Lorvex in arrivo a breve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後予定されている、保留中のLorvexのタスクのリマインダーを読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예정된 대기 중인 Lorvex 할 일 알림을 읽습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytuje oczekujące przypomnienia zadań Lorvex, które zostaną wyświetlone w najbliższym czasie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê os lembretes pendentes de tarefas do Lorvex que estão chegando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает ожидающие напоминания задач Lorvex, которые сработают в ближайшее время."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читає очікувані нагадування завдань Lorvex, що спрацюють найближчим часом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取即将到来的待处理 Lorvex 任务提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取即將到來、待處理的 Lorvex 任務提醒。"
          }
        }
      }
    },
