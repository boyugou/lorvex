    "capture.footer.words": {
      "comment": "Capture sheet footer: explains the one-task-per-line model and the recognized detail words.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مهمة واحدة في كل سطر. كلمات مثل \"غدًا\" و\"الساعة 3 مساءً\" و\"كل اثنين\" و\"20 دقيقة\" أو \"#قائمة\" تملأ تفاصيل المهمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতি লাইনে একটি টাস্ক। শব্দ, যেমন “আগামীকাল”, “বিকেল 5টায়”, “প্রতি সোমবার”, “20 মিনিট” বা “#তালিকা”, টাস্কের বিবরণ পূরণ করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Aufgabe pro Zeile. Wörter wie „morgen“, „um 15 Uhr“, „jeden Montag“, „20 Min“ oder „#Liste“ ergänzen die Details der Aufgabe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μία εργασία ανά γραμμή. Λέξεις όπως «αύριο», «στις 15:00», «κάθε Δευτέρα», «20 λεπτά» ή «#λίστα» συμπληρώνουν τις λεπτομέρειές της."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One task per line. Words like “tomorrow”, “3pm”, “every Monday”, “20 min”, or “#list” fill in its details."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarea por línea. Palabras como “mañana”, “a las 15:00”, “cada lunes”, “20 min” o “#lista” completan sus detalles."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر خط یک کار. کلماتی مانند «فردا»، «ساعت ۳ بعدازظهر»، «هر دوشنبه»، «۲۰ دقیقه» یا «#فهرست» جزئیات آن را پر می‌کنند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une tâche par ligne. Des mots comme « demain », « 15h », « tous les lundis », « 20 min » ou « #liste » complètent ses détails."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משימה אחת בכל שורה. מילים כמו \"מחר\", \"בשעה 5 בערב\", \"כל יום שני\", \"20 דקות\" או \"#רשימה\" ממלאות את פרטי המשימה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर पंक्ति में एक कार्य लिखें। शब्द जैसे “कल”, “शाम 5 बजे”, “हर सोमवार”, “20 मिनट” या “#सूची” उसका ब्योरा भर देते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu tugas per baris. Kata seperti “besok”, “jam 15.00”, “setiap Senin”, “20 menit”, atau “#daftar” mengisi detail tugas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’attività per riga. Parole come “domani”, “alle 15”, “ogni lunedì”, “20 min” o “#lista” ne completano i dettagli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1行に1つのタスクを入力します。「明日」「午後3時」「毎週月曜」「30分」や「#⁠リスト名」のような語句を書くと、詳細が自動で入力されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 줄에 할 일 하나씩 입력하세요. “내일”, “오후 3시”, “매주 월요일”, “30분”이나 “#⁠목록명” 같은 단어는 세부 정보를 자동으로 채워 줍니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक ओळीत एक कार्य. ‘उद्या’, ‘संध्याकाळी 5 वाजता’, ‘दर सोमवारी’, ‘20 मिनिटे’ किंवा ‘#यादी’ यांसारखे शब्द कार्याचे तपशील भरतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu tugas setiap baris. Perkataan seperti “esok”, “pukul 3 petang”, “setiap Isnin”, “20 minit” atau “#senarai” melengkapkan butiran tugas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén taak per regel. Woorden zoals ‘morgen’, ‘om 15:00’, ‘elke maandag’, ‘20 min’ of ‘#lijst’ vullen de details van de taak in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno zadanie w wierszu. Słowa, takie jak „jutro”, „o 15:00”, „co poniedziałek”, „20 min” lub „#lista”, uzupełniają jego szczegóły."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tarefa por linha. Palavras como “amanhã”, “15h”, “toda segunda”, “20 min” ou “#lista” completam os detalhes dela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O sarcină pe rând. Cuvinte precum „mâine”, „la 15:00”, „în fiecare luni”, „20 min” sau „#listă” completează detaliile sarcinii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна задача на строку. Слова вроде «завтра», «в 15:00», «каждый понедельник», «20 мин» или «#список» заполняют её подробности."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு வரிக்கும் ஒரு பணி. “நாளை”, “மாலை 5 மணிக்கு”, “ஒவ்வொரு திங்கட்கிழமை”, “20 நிமிடங்கள்” அல்லது “#பட்டியல்” போன்ற சொற்கள் அதன் விவரங்களை நிரப்பும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి లైన్‌కు ఒక టాస్క్. “రేపు”, “సాయంత్రం 5 గంటలకు”, “ప్రతి సోమవారం”, “20 నిమిషాలు” లేదా “#జాబితా” వంటి పదాలు దాని వివరాలను నింపుతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หนึ่งบรรทัดต่อหนึ่งงาน คำอย่าง “พรุ่งนี้”, “บ่ายสามโมง”, “ทุกวันจันทร์”, “20 นาที” หรือ “#รายการ” จะเติมรายละเอียดของงานให้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satır başına bir görev. “yarın”, “saat 15:00”, “her pazartesi”, “20 dk” veya “#liste” gibi sözcükler görevin ayrıntılarını doldurur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одне завдання на рядок. Слова на кшталт «завтра», «о 15:00», «кожного понеділка», «20 хв» або «#список» заповнюють його подробиці."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر لائن میں ایک کام۔ \"کل\"، \"شام 5 بجے\"، \"ہر پیر\"، \"20 منٹ\" یا \"#فہرست\" جیسے الفاظ اس کی تفصیلات خود بھر دیتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi dòng một nhiệm vụ. Các từ như “ngày mai”, “3 giờ chiều”, “mỗi thứ Hai”, “20 phút” hoặc “#danhsách” sẽ điền chi tiết cho nhiệm vụ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一个任务。写上“明天”“下午3点”“每周一”“30分钟”或“#⁠列表名”等词，会自动填好对应信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一個任務。寫上「明天」「下午3點」「每星期一」「30分鐘」或「#⁠清單名稱」等詞，就會自動填入對應的資訊。"
          }
        }
      }
    },
