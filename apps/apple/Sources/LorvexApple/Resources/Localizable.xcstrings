        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen toevoegen – lezen geblokkeerd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko dodawanie — odczyt zablokowany"
          }
        },
