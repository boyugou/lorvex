    "recurring_cancel.batch_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء المهام المتكررة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederkehrende Aufgaben abbrechen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel Recurring Tasks"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar tareas recurrentes"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "لغو کارهای تکرارشونده"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler les tâches récurrentes"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביטול משימות חוזרות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोहराए जाने वाले कार्य रद्द करें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla attività ricorrenti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "繰り返しタスクをキャンセル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반복되는 할 일 취소"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terugkerende taken annuleren"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulowanie zadań cyklicznych"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar tarefas recorrentes"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulați sarcinile recurente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмена повторяющихся задач"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасування повторюваних завдань"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دہرائے جانے والے کام منسوخ کریں"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消重复任务"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消重複任務"
          }
        }
      }
    },
    "recurring_cancel.batch_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد إلغاء حالات التكرار المحددة فقط، أم إنهاء كل سلاسل التكرار المحددة؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die ausgewählten Wiederholungen abbrechen oder jede ausgewählte Serie beenden?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel only the selected occurrences, or end every selected repeating series?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cancelar solo las repeticiones seleccionadas o terminar las series completas?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط تکرارهای انتخاب‌شده لغو شوند یا همه مجموعه‌های تکرارشونده انتخاب‌شده پایان یابند؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler uniquement les occurrences sélectionnées ou mettre fin à toutes les séries récurrentes sélectionnées ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לבטל רק את המופעים שנבחרו או לסיים כל סדרה חוזרת שנבחרה?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल चुने गए बार रद्द करें, या चुनी गई हर दोहराई जाने वाली श्रृंखला समाप्त करें?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annullare solo le occorrenze selezionate o terminare tutte le serie ricorrenti selezionate?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した回のみキャンセルしますか？それとも、選択した繰り返しをすべて終了しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 반복만 취소하시겠습니까, 아니면 선택한 반복 전체를 종료하시겠습니까?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de geselecteerde herhalingen annuleren, of elke geselecteerde reeks beëindigen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulować tylko wybrane wystąpienia czy wszystkie wybrane serie?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar somente as ocorrências selecionadas ou encerrar todas as séries recorrentes selecionadas?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulați doar aparițiile selectate sau încheiați fiecare serie repetitivă selectată?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить только выбранные повторения или все выбранные серии?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасувати лише вибрані повторення чи всі вибрані серії?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف منتخب تکرار منسوخ کریں یا ہر منتخب دہرائی جانے والی سیریز ختم کریں؟"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只取消所选的这几次，还是结束所有选中的重复系列？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要只取消所選的這幾次，還是結束所選的所有重複系列？"
          }
        }
      }
    },
