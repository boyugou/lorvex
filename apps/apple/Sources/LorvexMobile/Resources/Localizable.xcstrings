    "today.schedule.untimed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد وقت محدد لأي من مهام اليوم. يوزّعها \"اقتراح أوقات\" حول أحداث تقويمك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজকের কোনো টাস্কেরই সময় ঠিক করা নেই। “সময় প্রস্তাব করুন” সেগুলিকে আপনার ক্যালেন্ডারের ফাঁকে সাজিয়ে দেয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine der heutigen Aufgaben hat eine Uhrzeit. „Zeiten vorschlagen“ plant sie rund um deinen Kalender ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καμία από τις εργασίες της ημέρας δεν έχει ώρα. Η «Πρόταση ωρών» τις τοποθετεί γύρω από το ημερολόγιό σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None of today’s tasks has a time. Suggest Times fits them around your calendar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna de las tareas de hoy tiene hora. Sugerir horarios las acomoda en los huecos de tu calendario."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ‌یک از کارهای امروز زمان ندارد. «پیشنهاد زمان‌ها» آن‌ها را با توجه به تقویم‌تان جا می‌دهد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune tâche d’aujourd’hui n’a d’horaire. « Suggérer des horaires » les place autour de votre calendrier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאף אחת ממשימות היום אין שעה. \"הצעת שעות\" מתאימה אותן ללוח השנה שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज के किसी भी कार्य का समय तय नहीं है। “समय सुझाएँ” उन्हें आपके कैलेंडर के आसपास बिठा देता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada tugas hari ini yang memiliki waktu. Sarankan Waktu akan menyusunnya sesuai dengan kalender Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna attività di oggi ha un orario. “Suggerisci orari” le sistema attorno al tuo calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のタスクには時刻が設定されていません。「時刻を提案」を使うと、カレンダーの予定を避けて配置します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 할 일 중 시간이 정해진 것이 없습니다. ‘시간 제안’을 누르면 캘린더 일정을 피해 배치합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आजच्या कोणत्याही कार्याची वेळ ठरवलेली नाही. ‘वेळा सुचवा’ त्यांना तुमच्या दिनदर्शिकेनुसार बसवते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada tugas hari ini yang mempunyai masa. Cadangkan Masa akan menyusunnya mengikut kalendar anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen van de taken van vandaag heeft een tijd. ‘Stel tijden voor’ plant ze rond je agenda."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadne zadanie na dziś nie ma godziny. „Zaproponuj godziny” dobierze je z uwzględnieniem twojego kalendarza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma tarefa de hoje tem horário. “Sugerir horários” as encaixa em torno do seu calendário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicio sarcină de astăzi nu are oră. „Sugerați ore” le plasează în jurul calendarului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни у одной задачи на сегодня нет времени. «Предложить время» подберёт его с учётом вашего календаря."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்றைய பணிகள் எதற்கும் நேரம் அமைக்கப்படவில்லை. “நேரங்களைப் பரிந்துரை” உங்கள் கேலண்டரைக் கருத்தில் கொண்டு அவற்றை அமைக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈరోజు టాస్క్‌లలో దేనికీ సమయం సెట్ చేయలేదు. “సమయాలను సూచించండి” మీ క్యాలెండర్‌ను పరిగణనలోకి తీసుకుని వాటిని అమరుస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานของวันนี้ยังไม่มีเวลาเลย “แนะนำเวลา” จะจัดงานให้พอดีกับปฏิทินของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünün hiçbir görevinin saati yok. “Saat öner” bunları takviminizin etrafına yerleştirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жодне із завдань на сьогодні не має часу. «Запропонувати час» підбере його з урахуванням вашого календаря."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج کے کسی بھی کام کا وقت مقرر نہیں۔ \"اوقات تجویز کریں\" انہیں آپ کے کیلنڈر کے مطابق ترتیب دیتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không nhiệm vụ nào hôm nay có giờ. Gợi ý giờ sẽ xếp chúng vào các khoảng trống trong lịch của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的任务都还没有时间。“建议时间”可以把它们排进日历的空档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的任務都還沒有時間。「建議時間」會依照你的行事曆為它們安排時段。"
          }
        }
      }
    },
