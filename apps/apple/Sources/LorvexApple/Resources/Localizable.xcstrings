    "settings.mcp.helper_runtime_failed_detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عثر Lorvex على البرنامج المساعد، لكنه لم يبدأ العمل بإعدادات التخزين الحالية. أعد ربط Lorvex من الإعدادات > المساعد أو أعد تثبيت التطبيق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex হেল্পারটি খুঁজে পেয়েছে, কিন্তু বর্তমান স্টোরেজ সেটিংসে সেটি চালু হয়নি। সেটিংস > অ্যাসিস্ট্যান্ট থেকে Lorvex আবার কানেক্ট করুন অথবা অ্যাপটি আবার ইনস্টল করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex hat den Helfer gefunden, er konnte aber mit den aktuellen Speichereinstellungen nicht gestartet werden. Verbinde Lorvex in Einstellungen > Assistent erneut oder installiere die App neu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Lorvex βρήκε το βοηθητικό πρόγραμμα, αλλά δεν μπόρεσε να ξεκινήσει με τις τρέχουσες ρυθμίσεις αποθήκευσης. Συνδέστε ξανά το Lorvex στις Ρυθμίσεις > Βοηθός ή εγκαταστήστε ξανά την εφαρμογή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex found the helper, but it could not start with the current storage settings. Reconnect Lorvex in Settings > Assistant or reinstall the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex encontró el programa auxiliar, pero no pudo iniciarlo con los ajustes de almacenamiento actuales. Vuelve a conectar Lorvex en Ajustes > Asistente o reinstala la app."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه کمکی پیدا شد، اما با تنظیمات ذخیره‌سازی فعلی نتوانست راه‌اندازی شود. Lorvex را در تنظیمات > دستیار دوباره متصل کنید یا برنامه را دوباره نصب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex a trouvé l’utilitaire, mais celui-ci n’a pas pu démarrer avec les réglages de stockage actuels. Reconnectez Lorvex dans Réglages > Assistant ou réinstallez l’app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כלי העזר נמצא, אך לא ניתן היה להפעילו עם הגדרות האחסון הנוכחיות. יש לחבר מחדש את Lorvex דרך הגדרות > עוזר או להתקין את האפליקציה מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex को हेल्पर मिल गया, पर वह मौजूदा स्टोरेज सेटिंग्ज़ के साथ शुरू नहीं हो सका। सेटिंग्ज़ > असिस्टेंट में Lorvex को फिर से जोड़ें या ऐप दोबारा इंस्टॉल करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex menemukan helper, tetapi helper tidak dapat dimulai dengan pengaturan penyimpanan saat ini. Hubungkan kembali Lorvex di Pengaturan > Asisten atau instal ulang app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex ha trovato l’helper, ma non è riuscito ad avviarsi con le attuali impostazioni di archiviazione. Ricollega Lorvex in Impostazioni > Assistente oppure reinstalla l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルパーは見つかりましたが、現在のストレージ設定では起動できませんでした。「設定」>「アシスタント」でLorvexを再接続するか、アプリを再インストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도우미를 찾았지만 현재 저장 공간 설정으로는 시작할 수 없습니다. 설정 > 어시스턴트에서 Lorvex를 다시 연결하거나 앱을 다시 설치하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex ला हेल्पर सापडला, पण सध्याच्या स्टोरेज सेटिंगसह तो सुरू होऊ शकला नाही. सेटिंग > सहाय्यक मध्ये Lorvex पुन्हा कनेक्ट करा किंवा ॲप पुन्हा इन्स्टॉल करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex menemui helper, tetapi helper tidak dapat dimulakan dengan seting storan semasa. Sambungkan semula Lorvex dalam Seting > Pembantu AI atau pasang semula app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex heeft de helper gevonden, maar die kon niet starten met de huidige opslaginstellingen. Verbind Lorvex opnieuw via Instellingen > Assistent of installeer de app opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex znalazł aplikację pomocniczą, ale nie mogła się ona uruchomić z bieżącymi ustawieniami przechowywania. Połącz Lorvex ponownie w Ustawieniach > Asystent lub zainstaluj aplikację ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lorvex encontrou o utilitário, mas ele não conseguiu iniciar com as configurações de armazenamento atuais. Reconecte o Lorvex em Ajustes > Assistente ou reinstale o app."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex a găsit programul auxiliar, dar acesta nu a putut porni cu configurările de stocare curente. Reconectați Lorvex din Configurări > Asistent sau reinstalați aplicația."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вспомогательная программа найдена, но не смогла запуститься с текущими настройками хранилища. Подключите Lorvex заново в разделе «Настройки» > «Ассистент» или переустановите приложение."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex ஹெல்ப்பரைக் கண்டறிந்தது, ஆனால் தற்போதைய சேமிப்பக அமைப்புகளுடன் அதைத் தொடங்க முடியவில்லை. அமைப்புகள் > அசிஸ்டென்ட்டில் Lorvexஐ மீண்டும் இணைக்கவும் அல்லது செயலியை மீண்டும் நிறுவவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex హెల్పర్‌ను కనుగొంది, కానీ ప్రస్తుత స్టోరేజ్ సెట్టింగ్స్‌తో అది ప్రారంభం కాలేదు. సెట్టింగ్స్ > అసిస్టెంట్‌లో Lorvexను మళ్ళీ కనెక్ట్ చేయండి లేదా యాప్‌ను మళ్ళీ ఇన్‌స్టాల్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex พบโปรแกรมช่วยแล้ว แต่เริ่มทำงานด้วยการตั้งค่าที่เก็บข้อมูลปัจจุบันไม่ได้ เชื่อมต่อ Lorvex ใหม่ในการตั้งค่า > ผู้ช่วย หรือติดตั้งแอปใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex yardımcı uygulamayı buldu ancak mevcut depolama ayarlarıyla başlatılamadı. Lorvex’i Ayarlar > Asistan bölümünde yeniden bağlayın veya uygulamayı yeniden kurun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Допоміжну програму знайдено, але вона не змогла запуститися з поточними параметрами сховища. Підключіть Lorvex знову в розділі «Параметри» > «Асистент» або перевстановіть програму."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہیلپر مل گیا، لیکن وہ موجودہ اسٹوریج ترتیبات کے ساتھ شروع نہیں ہو سکا۔ ترتیبات > اسسٹنٹ میں Lorvex کو دوبارہ جوڑیں یا ایپ دوبارہ انسٹال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex đã tìm thấy trình hỗ trợ nhưng không thể khởi động với cài đặt lưu trữ hiện tại. Hãy kết nối lại Lorvex trong Cài đặt > Trợ lý hoặc cài đặt lại ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 找到了助手，但无法在当前存储设置下启动。请在“设置 > 助手”中重新连接 Lorvex，或重新安装应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 找到了輔助程式，但無法以目前的儲存空間設定啟動。請在「設定」>「助理」中重新連接 Lorvex，或重新安裝 App。"
          }
        }
      }
    },
    "settings.mcp.helper_runtime_failed_title": {
