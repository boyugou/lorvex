    "today.schedule.clear.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تفقد مهام اليوم غير المنجزة أوقاتها وتبقى في اليوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজকের অসম্পূর্ণ টাস্কগুলির সময় মুছে যাবে, তবে সেগুলি আজকের জন্যই থাকবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die unerledigten Aufgaben von heute verlieren ihre Uhrzeiten und bleiben für heute geplant."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ανολοκλήρωτες εργασίες της σημερινής ημέρας χάνουν την ώρα τους και παραμένουν στη σημερινή ημέρα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today’s unfinished tasks lose their times and stay on today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas pendientes de hoy pierden su hora y siguen en Hoy."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارهای تمام‌نشده امروز زمان‌هایشان را از دست می‌دهند و برای امروز باقی می‌مانند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches non terminées d’aujourd’hui perdent leur horaire et restent sur aujourd’hui."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למשימות היום שטרם הושלמו תוסר השעה, והן יישארו להיום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज के अधूरे कार्यों के समय हट जाएँगे और वे आज पर ही रहेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas hari ini yang belum selesai kehilangan waktunya dan tetap berada di hari ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le attività non completate di oggi perdono l’orario e restano su oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の未完了のタスクは時刻がクリアされ、今日のままになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 미완료 할 일은 시간이 지워지고 오늘에 그대로 남습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आजच्या अपूर्ण कार्यांच्या वेळा काढून टाकल्या जातील; ती कार्ये आजसाठीच राहतील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas hari ini yang belum selesai kehilangan masanya dan kekal pada hari ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De onvoltooide taken van vandaag verliezen hun tijden en blijven voor vandaag gepland."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieukończone zadania na dziś stracą godziny, ale zostaną na dzisiaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas não concluídas de hoje perdem o horário e continuam em hoje."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarcinile nefinalizate de astăzi își pierd orele și rămân planificate pentru astăzi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Невыполненные задачи на сегодня потеряют время, но останутся на сегодня."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்றைய முடிக்கப்படாத பணிகள் தங்கள் நேரங்களை இழக்கும், ஆனால் இன்றைக்கே இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈరోజు పూర్తి కాని టాస్క్‌లు తమ సమయాలను కోల్పోతాయి, కానీ ఈరోజే ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานที่ยังไม่เสร็จของวันนี้จะไม่มีเวลา แต่ยังอยู่ในวันนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünün bitmemiş görevleri saatlerini kaybeder ve bugünde kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Невиконані завдання на сьогодні втратять час, але залишаться на сьогодні."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج کے نامکمل کام اپنا وقت کھو دیتے ہیں اور آج ہی پر رہتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các nhiệm vụ chưa hoàn thành hôm nay sẽ mất giờ và vẫn ở lại hôm nay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天未完成的任务会移除时间，但仍留在今天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天尚未完成的任務會清除時間，但仍留在今天。"
          }
        }
      }
    },
