          },
          "substitutions": {
            "taskcount": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg 项任务"
                    }
                  }
                }
              }
            }
