    "system.habit.reminder.add.description": {
      "comment": "Description of the App Intent that adds a reminder to a habit",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة تذكير إلى عادة في Lorvex."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি Lorvex অভ্যাসে রিমাইন্ডার যোগ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt einer Lorvex-Gewohnheit eine Erinnerung hinzu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε μια υπόμνηση σε μια συνήθεια Lorvex."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a reminder to a Lorvex habit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un recordatorio a un hábito de Lorvex."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "افزودن یادآور به یک عادت Lorvex."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un rappel à une habitude de Lorvex."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוספת תזכורת להרגל ב-Lorvex."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex आदत में एक रिमाइंडर जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menambahkan pengingat ke kebiasaan Lorvex."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge un promemoria a un’abitudine di Lorvex."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexの習慣にリマインダーを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 습관에 알림을 추가합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एका Lorvex सवयीमध्ये रिमाइंडर जोडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menambah peringatan pada tabiat Lorvex."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voegt een herinnering toe aan een Lorvex-gewoonte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje przypomnienie do nawyku Lorvex."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona um lembrete a um hábito do Lorvex."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă un memento unui obicei Lorvex."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет напоминание к привычке Lorvex."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex பழக்கத்துக்கு ஒரு நினைவூட்டலைச் சேர்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex అలవాటుకు రిమైండర్‌ను జోడించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มเตือนความจำให้นิสัย Lorvex"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Lorvex alışkanlığına anımsatıcı ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додає нагадування до звички Lorvex."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی Lorvex عادت میں یاد دہانی شامل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm một lời nhắc vào thói quen Lorvex."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为一个 Lorvex 习惯添加提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為 Lorvex 習慣新增提醒。"
          }
        }
      }
    },
