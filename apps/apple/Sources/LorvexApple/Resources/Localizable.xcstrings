    "settings.cloud_sync.storage_full": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مساحة تخزين iCloud ممتلئة. سيُكمل Lorvex المزامنة عندما تتوفر مساحة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার iCloud স্টোরেজ ভর্তি হয়ে গেছে। জায়গা হলে Lorvex সিঙ্ক শেষ করবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein iCloud-Speicher ist voll. Lorvex schließt die Synchronisierung ab, sobald wieder Platz ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο χώρος αποθήκευσης iCloud σας είναι γεμάτος. Το Lorvex θα ολοκληρώσει τον συγχρονισμό όταν υπάρξει χώρος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iCloud storage is full. Lorvex will finish syncing when there’s space."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu almacenamiento de iCloud está lleno. Lorvex terminará de sincronizar cuando haya espacio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فضای iCloud شما پر است. Lorvex وقتی جا باز شود همگام‌سازی را کامل می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre stockage iCloud est plein. Lorvex terminera la synchronisation dès qu’il y aura de la place."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האחסון ב-iCloud שלך מלא. הסנכרון יושלם כשיתפנה מקום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका iCloud स्टोरेज भर गया है। जगह मिलते ही Lorvex सिंक पूरा कर लेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyimpanan iCloud penuh. Lorvex akan menyelesaikan penyelarasan setelah ada ruang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio di archiviazione iCloud è pieno. Lorvex completerà la sincronizzazione quando ci sarà spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudのストレージがいっぱいです。空き容量ができ次第、Lorvexが同期を完了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 저장 공간이 가득 찼습니다. 공간이 생기면 Lorvex가 동기화를 마무리합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे iCloud स्टोरेज भरले आहे. जागा झाल्यावर सिंक पूर्ण केले जाईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Storan iCloud penuh. Lorvex akan menyelesaikan penyelarasan apabila ada ruang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je iCloud-opslag is vol. Lorvex voltooit de synchronisatie zodra er ruimte is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamięć iCloud jest pełna. Lorvex dokończy synchronizację, gdy zrobi się miejsce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento do iCloud está cheio. O Lorvex concluirá a sincronização quando houver espaço."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spațiul de stocare iCloud este plin. Lorvex va finaliza sincronizarea când va fi din nou loc."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранилище iCloud заполнено. Lorvex завершит синхронизацию, когда появится место."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் iCloud சேமிப்பகம் நிரம்பிவிட்டது. இடம் கிடைக்கும்போது Lorvex ஒத்திசைவை முடிக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ iCloud స్టోరేజ్ నిండింది. స్థలం ఉన్నప్పుడు Lorvex సింక్‌ను పూర్తి చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นที่จัดเก็บ iCloud ของคุณเต็ม Lorvex จะเชื่อมข้อมูลให้เสร็จเมื่อมีพื้นที่ว่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud depolama alanınız dolu. Yer açılınca Lorvex eşzamanlamayı tamamlayacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сховище iCloud заповнене. Lorvex завершить синхронізацію, щойно з’явиться місце."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا iCloud اسٹوریج بھر گیا ہے۔ جگہ ملتے ہی Lorvex سنک مکمل کر لے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dung lượng iCloud đã đầy. Lorvex sẽ hoàn tất đồng bộ hóa khi có chỗ trống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 iCloud 储存空间已满。有空间后，Lorvex 会继续完成同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 iCloud 儲存空間已滿。有空間時，Lorvex 會完成同步。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
