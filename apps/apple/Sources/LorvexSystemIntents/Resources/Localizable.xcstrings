    "system.calendar.ics.export.description": {
      "comment": "Description for the Export Lorvex Calendar ICS App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجهيز أحداث تقويم Lorvex بصيغة ICS من الاختصارات أو Siri."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শর্টকাট বা Siri থেকে Lorvex ক্যালেন্ডার ইভেন্ট ICS হিসাবে প্রস্তুত করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereitet Ereignisse aus dem Lorvex-Kalender über Kurzbefehle oder Siri als ICS vor."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προετοιμάστε γεγονότα ημερολογίου Lorvex ως ICS από τις Συντομεύσεις ή το Siri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare Lorvex calendar events as ICS from Shortcuts or Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara eventos de calendario de Lorvex como ICS desde Atajos o Siri."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آماده‌سازی رویدادهای تقویم Lorvex به‌صورت ICS از طریق میان‌برها یا Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prépare les événements du calendrier de Lorvex au format ICS depuis Raccourcis ou Siri."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכנת אירועי לוח השנה של Lorvex כקובץ ICS דרך קיצורי דרך או Siri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट्स या Siri से Lorvex कैलेंडर इवेंट को ICS के रूप में तैयार करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyiapkan acara kalender Lorvex sebagai ICS dari Pintasan atau Siri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara gli eventi del calendario di Lorvex in formato ICS da Comandi rapidi o Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットまたはSiriでLorvexのカレンダーイベントをICSとして用意します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어 또는 Siri에서 Lorvex 캘린더 이벤트를 ICS로 준비합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट किंवा Siri द्वारे Lorvex दिनदर्शिका इव्हेंट ICS म्हणून तयार करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyediakan peristiwa kalendar Lorvex sebagai ICS daripada Pintasan atau Siri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereidt activiteiten uit de Lorvex-agenda als ICS voor via Opdrachten of Siri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przygotowuje wydarzenia kalendarza Lorvex w formacie ICS ze Skrótów lub Siri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara os eventos do calendário do Lorvex como ICS pelos Atalhos ou pela Siri."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregătește evenimentele din calendarul Lorvex ca ICS prin Scurtături sau Siri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готовит события календаря Lorvex в формате ICS из «Быстрых команд» или Siri."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்கவழிகள் அல்லது Siri மூலம் Lorvex கேலண்டர் நிகழ்வுகளை ICS ஆகத் தயார் செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "షార్ట్‌కట్స్ లేదా Siri నుండి Lorvex క్యాలెండర్ ఇవెంట్‌లను ICSగా తయారు చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เตรียมกิจกรรมปฏิทิน Lorvex เป็น ICS จากคำสั่งลัดหรือ Siri"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kestirmeler veya Siri ile Lorvex takvim etkinliklerini ICS olarak hazırlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готує події календаря Lorvex у форматі ICS зі «Швидких команд» або Siri."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شارٹ کٹس یا Siri سے Lorvex کیلنڈر ایونٹس کو ICS کے طور پر تیار کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuẩn bị các sự kiện lịch Lorvex dưới dạng ICS từ Phím tắt hoặc Siri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
