    "settings.language.reopen_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد فتح Lorvex لتطبيق اللغة الجديدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন ভাষা প্রয়োগ করতে Lorvex আবার খুলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Lorvex erneut, um die neue Sprache zu verwenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε ξανά το Lorvex για να εφαρμοστεί η νέα γλώσσα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reopen Lorvex to apply the new language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a abrir Lorvex para aplicar el nuevo idioma."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای اعمال زبان جدید، Lorvex را دوباره باز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rouvrez Lorvex pour appliquer la nouvelle langue."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לפתוח מחדש את Lorvex כדי להחיל את השפה החדשה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नई भाषा लागू करने के लिए Lorvex को दोबारा खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka kembali Lorvex untuk menerapkan bahasa baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riapri Lorvex per applicare la nuova lingua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい言語を適用するには、Lorvexを開き直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 언어를 적용하려면 Lorvex를 다시 여세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नवीन भाषा लागू करण्यासाठी Lorvex पुन्हा उघडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka semula Lorvex untuk menggunakan bahasa baharu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Lorvex opnieuw om de nieuwe taal toe te passen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Lorvex ponownie, aby zastosować nowy język."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reabra o Lorvex para aplicar o novo idioma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Redeschideți Lorvex pentru a aplica noua limbă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Lorvex снова, чтобы применить новый язык."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புதிய மொழியைப் பயன்படுத்த Lorvexஐ மீண்டும் திறக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొత్త భాషను వర్తింపజేయడానికి Lorvexను మళ్ళీ తెరవండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Lorvex ใหม่เพื่อใช้ภาษาใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni dili uygulamak için Lorvex’i yeniden açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте Lorvex знову, щоб застосувати нову мову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نئی زبان لاگو کرنے کے لیے Lorvex دوبارہ کھولیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy mở lại Lorvex để áp dụng ngôn ngữ mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新打开 Lorvex 以应用新语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新開啟 Lorvex 以套用新的語言。"
          }
        }
      }
    },
