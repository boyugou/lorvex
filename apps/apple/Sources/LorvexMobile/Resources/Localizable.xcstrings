        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더를 불러올 수 없습니다. 설정에서 캘린더 접근 권한을 확인하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दिनदर्शिका लोड करता आल्या नाहीत. सेटिंगमध्ये दिनदर्शिका ॲक्सेस तपासा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat memuatkan kalendar. Semak akses kalendar dalam Seting."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenda’s konden niet worden geladen. Controleer de toegang tot de agenda in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wczytać kalendarzy. Sprawdź dostęp do kalendarzy w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar os calendários. Verifique o acesso ao calendário em Ajustes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendarele nu au putut fi încărcate. Verificați accesul la calendar în Configurări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить календари. Проверьте доступ к календарям в Настройках."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கேலண்டர்களை ஏற்ற முடியவில்லை. அமைப்புகளில் கேலண்டர் அணுகலைச் சரிபார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "క్యాలెండర్‌లను లోడ్ చేయడం వీలుపడలేదు. సెట్టింగ్స్‌లో క్యాలెండర్ యాక్సెస్‌ను చెక్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดปฏิทินไม่ได้ ตรวจสอบการเข้าถึงปฏิทินในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvimler yüklenemedi. Ayarlar’da takvim erişimini kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити календарі. Перевірте доступ до календарів у Параметрах."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیلنڈرز لوڈ نہیں ہو سکے۔ ترتیبات میں کیلنڈر تک رسائی چیک کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tải lịch. Hãy kiểm tra quyền truy cập lịch trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载日历。请在“设置”中检查日历访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入行事曆。請在「設定」中檢查行事曆存取權限。"
          }
        }
      }
    },
    "settings.calendar.mirror_detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة تقويمات الجهاز المحددة في Lorvex دون الكتابة في تقويماتك الشخصية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ব্যক্তিগত ক্যালেন্ডারে কিছু না লিখে নির্বাচিত ডিভাইস ক্যালেন্ডার Lorvex-এ পড়ুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest ausgewählte Kalender dieses Geräts in Lorvex ein, ohne in deine persönlichen Kalender zu schreiben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαβάζει τα επιλεγμένα ημερολόγια της συσκευής στο Lorvex χωρίς να γράφει στα προσωπικά σας ημερολόγια."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read selected device calendars into Lorvex without writing to your personal calendars."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee en Lorvex los calendarios del dispositivo que elijas, sin escribir en tus calendarios personales."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تقویم‌های انتخاب‌شده دستگاه را در Lorvex می‌خواند، بدون اینکه در تقویم‌های شخصی شما چیزی بنویسد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire dans Lorvex les calendriers de l’appareil sélectionnés, sans rien écrire dans vos calendriers personnels."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קריאת לוחות השנה שנבחרו במכשיר אל Lorvex, בלי לכתוב ללוחות השנה האישיים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके निजी कैलेंडर में कुछ लिखे बिना, चुने गए डिवाइस कैलेंडर Lorvex में पढ़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baca kalender perangkat yang dipilih ke dalam Lorvex tanpa menulis ke kalender pribadi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggi in Lorvex i calendari del dispositivo selezionati, senza scrivere nei tuoi calendari personali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したデバイスのカレンダーをLorvexに読み込みます。個人のカレンダーには書き込みません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 기기 캘린더를 Lorvex로 읽어 오며, 개인 캘린더에는 기록하지 않습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या वैयक्तिक दिनदर्शिकांमध्ये काहीही न लिहिता निवडलेल्या डिव्हाइस दिनदर्शिका Lorvex मध्ये वाचा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Baca kalendar peranti yang dipilih ke dalam Lorvex tanpa menulis ke kalendar peribadi anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest geselecteerde agenda’s van dit apparaat in Lorvex in, zonder naar je persoonlijke agenda’s te schrijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex odczytuje wybrane kalendarze urządzenia i niczego nie zapisuje w twoich kalendarzach osobistych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia no Lorvex os calendários do dispositivo selecionados, sem gravar nos seus calendários pessoais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Citește calendarele selectate de pe dispozitiv în Lorvex, fără a scrie în calendarele personale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex считывает выбранные календари устройства, ничего не записывая в ваши личные календари."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் தனிப்பட்ட கேலண்டர்களில் எதையும் எழுதாமல், தேர்ந்தெடுத்த சாதனக் கேலண்டர்களை Lorvexஇல் படிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ వ్యక్తిగత క్యాలెండర్‌లలో ఏమీ రాయకుండానే ఎంచుకున్న డివైజ్ క్యాలెండర్‌లను Lorvexలోకి చదవండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านปฏิทินในอุปกรณ์ที่เลือกเข้ามาใน Lorvex โดยไม่เขียนลงในปฏิทินส่วนตัวของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili aygıt takvimlerini kişisel takvimlerinize yazmadan Lorvex’e okur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex зчитує вибрані календарі пристрою, нічого не записуючи у ваші особисті календарі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب ڈیوائس کیلنڈرز کو Lorvex میں پڑھیں، آپ کے ذاتی کیلنڈرز میں کچھ لکھے بغیر۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc các lịch thiết bị đã chọn vào Lorvex mà không ghi vào lịch cá nhân."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将所选设备日历读取到 Lorvex 中，不会写入你的个人日历。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將所選的裝置行事曆讀取到 Lorvex 中，不會寫入你的個人行事曆。"
          }
        }
      }
    },
