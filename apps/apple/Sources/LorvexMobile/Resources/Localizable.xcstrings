    "settings.sync.delete_cloud.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى إزالة جميع بيانات Lorvex نهائيًا من حساب iCloud الخاص بك، لكل جهاز يتزامن معه. تبقى البيانات المخزنة على هذا الجهاز كما هي. تظل المزامنة متوقفة إلى أن تعيد تشغيلها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently removes all Lorvex data from your iCloud account, for every device that syncs with it. Data stored on this device stays intact. Sync stays off until you turn it back on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina de forma permanente todos los datos de Lorvex de tu cuenta de iCloud, para todos los dispositivos que se sincronizan con ella. Los datos guardados en este dispositivo no se modifican. La sincronización permanece desactivada hasta que la vuelvas a activar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprime définitivement toutes les données Lorvex de votre compte iCloud, pour tous les appareils qui s’y synchronisent. Les données stockées sur cet appareil ne sont pas modifiées. La synchronisation reste désactivée jusqu’à ce que vous la réactiviez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे आपके iCloud खाते से Lorvex का सारा डेटा हमेशा के लिए हट जाएगा, उन सभी डिवाइस के लिए जो इसके साथ सिंक होते हैं। इस डिवाइस पर रखा डेटा बना रहेगा। सिंक तब तक बंद रहेगा जब तक आप उसे फिर से चालू नहीं करते।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione rimuove definitivamente tutti i dati di Lorvex dal tuo account iCloud, per ogni dispositivo che si sincronizza con esso. I dati archiviati su questo dispositivo restano intatti. La sincronizzazione resta disattivata finché non la riattivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作により、iCloudアカウントからLorvexのデータがすべて完全に削除されます。同期しているすべてのデバイスが対象です。このデバイスに保存されているデータはそのまま残ります。同期は、再びオンにするまでオフのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업을 하면 iCloud 계정에서 모든 Lorvex 데이터가 영구적으로 삭제되며, 이 계정과 동기화하는 모든 기기에 적용됩니다. 이 기기에 저장된 데이터는 그대로 유지됩니다. 동기화는 다시 켤 때까지 꺼진 상태로 유지됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to trwałe usunięcie wszystkich danych Lorvex z twojego konta iCloud — dla każdego urządzenia, które się z nim synchronizuje. Dane przechowywane na tym urządzeniu pozostaną nienaruszone. Synchronizacja pozostanie wyłączona, dopóki nie włączysz jej ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove permanentemente todos os dados do Lorvex da sua conta do iCloud, para todos os dispositivos que sincronizam com ela. Os dados armazenados neste dispositivo permanecem intactos. A sincronização continua desativada até que você a ative novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все данные Lorvex будут безвозвратно удалены из вашей учётной записи iCloud — для всех устройств, которые с ней синхронизируются. Данные, хранящиеся на этом устройстве, останутся нетронутыми. Синхронизация останется выключенной, пока вы снова не включите её."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі дані Lorvex буде безповоротно видалено з вашого облікового запису iCloud — для всіх пристроїв, які з ним синхронізуються. Дані, що зберігаються на цьому пристрої, залишаться без змін. Синхронізація залишатиметься вимкненою, доки ви знову її не ввімкнете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将从你的 iCloud 账户中永久移除所有 Lorvex 数据，对与其同步的所有设备生效。此设备上存储的数据保持不变。同步将保持关闭，直到你重新开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會從你的 iCloud 帳號永久移除所有 Lorvex 資料，所有與其同步的裝置都會受到影響。此裝置上儲存的資料不會變動。在你重新開啟之前，同步會保持關閉。"
          }
        }
      }
    },
    "settings.sync.delete_cloud.error.busy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجري تحديث المزامنة السحابية. حاول مرة أخرى بعد قليل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud Sync is updating. Try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización en la nube se está actualizando. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation est en cours de mise à jour. Réessayez dans un instant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लाउड सिंक अपडेट हो रहा है। थोड़ी देर बाद फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione si sta aggiornando. Riprova tra un attimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウド同期を更新中です。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 동기화를 업데이트하는 중입니다. 잠시 후 다시 시도하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja jest w trakcie aktualizacji. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização está sendo atualizada. Tente novamente em instantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация обновляется. Повторите попытку чуть позже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронізація оновлюється. Повторіть спробу трохи пізніше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云同步正在更新。请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲端同步正在更新。請稍後再試。"
          }
        }
      }
    },
    "settings.sync.delete_cloud.error.failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إكمال حذف بيانات iCloud (%@). تحقق من اتصالك ثم حاول مرة أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t finish deleting iCloud data (%@). Check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo terminar de eliminar los datos de iCloud (%@). Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de terminer la suppression des données iCloud (%@). Vérifiez votre connexion, puis réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud डेटा हटाना पूरा नहीं हो सका (%@)। अपना कनेक्शन जाँचें और फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile completare l’eliminazione dei dati iCloud (%@). Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudデータの削除を完了できませんでした（%@）。接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 데이터 삭제를 완료할 수 없습니다(%@). 연결 상태를 확인한 후 다시 시도하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się dokończyć usuwania danych iCloud (%@). Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível concluir a exclusão dos dados do iCloud (%@). Verifique sua conexão e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось завершить удаление данных iCloud (%@). Проверьте подключение и повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завершити видалення даних iCloud (%@). Перевірте з’єднання й повторіть спробу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法完成删除 iCloud 数据（%@）。请检查网络连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法完成刪除 iCloud 資料（%@）。請檢查連線後再試一次。"
          }
        }
      }
    },
    "settings.sync.delete_cloud.error.no_account": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد حساب iCloud صالح للاستخدام. سجّل الدخول إلى iCloud ثم حاول مرة أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No usable iCloud account. Sign in to iCloud and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna cuenta de iCloud utilizable. Inicia sesión en iCloud e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte iCloud utilisable. Connectez-vous à iCloud, puis réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई उपयोग योग्य iCloud खाता नहीं है। iCloud में साइन इन करें और फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun account iCloud utilizzabile. Accedi a iCloud e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用できるiCloudアカウントがありません。iCloudにサインインして、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용할 수 있는 iCloud 계정이 없습니다. iCloud에 로그인한 후 다시 시도하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak użytecznego konta iCloud. Zaloguj się w iCloud i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma conta do iCloud utilizável. Entre no iCloud e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет доступной учётной записи iCloud. Войдите в iCloud и повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає придатного облікового запису iCloud. Увійдіть в iCloud і повторіть спробу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可用的 iCloud 账户。请登录 iCloud 后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可用的 iCloud 帳號。請登入 iCloud 後再試一次。"
          }
        }
      }
    },
    "settings.sync.delete_cloud.error.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
