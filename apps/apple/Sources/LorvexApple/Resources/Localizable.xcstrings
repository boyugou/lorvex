    "settings.language.relaunch_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد تشغيل Lorvex لتطبيق اللغة الجديدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte Lorvex neu, um die neue Sprache zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart Lorvex to apply the new language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicia Lorvex para aplicar el nuevo idioma."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای اعمال زبان جدید، Lorvex را دوباره راه‌اندازی کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redémarrez Lorvex pour appliquer la nouvelle langue."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להפעיל מחדש את Lorvex כדי להחיל את השפה החדשה."
