    "tasks.empty.list_description": {
      "comment": "Empty state of a list scope in Tasks; points at the quick-add row above.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب مهمة في الحقل أعلاه لإضافتها إلى هذه القائمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib oben im Feld eine Aufgabe ein, um sie zu dieser Liste hinzuzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type a task in the field above to add it to this list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe una tarea en el campo de arriba para añadirla a esta lista."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای افزودن به این فهرست، یک کار را در کادر بالا بنویسید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une tâche dans le champ ci-dessus pour l’ajouter à cette liste."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להקליד משימה בשדה שלמעלה כדי להוסיף אותה לרשימה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस सूची में जोड़ने के लिए ऊपर के फ़ील्ड में कार्य लिखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi un’attività nel campo qui sopra per aggiungerla a questa lista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上の入力欄にタスクを入力すると、このリストに追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위 입력란에 할 일을 입력하면 이 목록에 추가됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ in het veld hierboven een taak om die aan deze lijst toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz zadanie w polu powyżej, aby dodać je do tej listy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite uma tarefa no campo acima para adicioná-la a esta lista."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduceți o sarcină în câmpul de mai sus pentru a o adăuga în această listă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите задачу в поле выше, чтобы добавить её в этот список."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть завдання в полі вище, щоб додати його до цього списку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس فہرست میں شامل کرنے کے لیے اوپر والے فیلڈ میں کام ٹائپ کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在上方输入框里输入任务，就会加进这个列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在上方欄位輸入任務，即可新增到此清單。"
          }
        }
      }
    },
    "tasks.empty.list_title": {
      "extractionState": "manual",
      "localizations": {
