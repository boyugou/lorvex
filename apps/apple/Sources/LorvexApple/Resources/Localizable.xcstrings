          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El programa auxiliar del asistente no se puede ejecutar"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه کمکی دستیار اجرا نمی‌شود"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’utilitaire de l’assistant ne peut pas s’exécuter"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כלי העזר של העוזר אינו יכול לפעול"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "असिस्टेंट हेल्पर नहीं चल सकता"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Helper asisten tidak dapat berjalan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’helper dell’assistente non può essere eseguito"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントのヘルパーを実行できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어시스턴트 도우미를 실행할 수 없음"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सहाय्यक हेल्पर चालवता येत नाही"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Helper pembantu AI tidak boleh dijalankan"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistenthelper kan niet worden uitgevoerd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja pomocnicza asystenta nie może się uruchomić"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O utilitário do assistente não pode ser executado"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Programul auxiliar al asistentului nu poate rula"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вспомогательная программа ассистента не запускается"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அசிஸ்டென்ட் ஹெல்ப்பரை இயக்க முடியவில்லை"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అసిస్టెంట్ హెల్పర్ రన్ కాలేకపోతోంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเรียกใช้โปรแกรมช่วยของผู้ช่วยได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asistan yardımcı uygulaması çalışamıyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Допоміжна програма асистента не запускається"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسسٹنٹ ہیلپر نہیں چل سکتا"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trình hỗ trợ của trợ lý không thể chạy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手帮助程序无法运行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "助理輔助程式無法執行"
          }
        }
      }
    },
    "settings.mcp.helper_missing_detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع Lorvex العثور على برنامج MCP المساعد المدمج فيه. أعد تثبيت Lorvex من التنزيل الأصلي لاستعادته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex তার বিল্ট-ইন MCP হেল্পার খুঁজে পাচ্ছে না। এটি ফিরিয়ে আনতে মূল ডাউনলোড থেকে Lorvex আবার ইনস্টল করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex findet seinen integrierten MCP-Helfer nicht. Installiere Lorvex erneut aus dem ursprünglichen Download, um ihn wiederherzustellen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Lorvex δεν βρίσκει το ενσωματωμένο βοηθητικό πρόγραμμα MCP. Εγκαταστήστε ξανά το Lorvex από την αρχική λήψη για να το αποκαταστήσετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex can’t find its built-in MCP helper. Reinstall Lorvex from the original download to restore it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex no encuentra su programa auxiliar MCP integrado. Vuelve a instalar Lorvex desde la descarga original para restaurarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه کمکی MCP داخلی Lorvex پیدا نشد. برای بازیابی آن، Lorvex را از دانلود اصلی دوباره نصب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex ne trouve pas son utilitaire MCP intégré. Réinstallez Lorvex depuis le téléchargement d’origine pour le restaurer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כלי העזר המובנה של MCP לא נמצא. יש להתקין מחדש את Lorvex מההורדה המקורית כדי לשחזר אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex को अपना बिल्ट-इन MCP हेल्पर नहीं मिल रहा। उसे बहाल करने के लिए Lorvex को मूल डाउनलोड से दोबारा इंस्टॉल करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex tidak dapat menemukan helper MCP bawaannya. Instal ulang Lorvex dari unduhan asli untuk memulihkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex non trova l’helper MCP integrato. Reinstalla Lorvex dal download originale per ripristinarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LorvexのMCPヘルパーが見つかりません。元のダウンロードからLorvexを再インストールして復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 내장 MCP 도우미를 찾을 수 없습니다. 원래 다운로드한 파일로 Lorvex를 다시 설치하여 복원하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex ला त्याचा बिल्ट-इन MCP हेल्पर सापडत नाही. तो पुन्हा मिळवण्यासाठी मूळ डाउनलोडमधून Lorvex पुन्हा इन्स्टॉल करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex tidak dapat menemui helper MCP terbina dalamnya. Pasang semula Lorvex daripada muat turun asal untuk memulihkannya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex kan zijn ingebouwde MCP-helper niet vinden. Installeer Lorvex opnieuw vanaf de oorspronkelijke download om de helper te herstellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex nie może znaleźć wbudowanej aplikacji pomocniczej MCP. Zainstaluj Lorvex ponownie z oryginalnego pobrania, aby ją przywrócić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lorvex não encontra o utilitário MCP integrado. Reinstale o Lorvex a partir do download original para restaurá-lo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex nu își găsește programul auxiliar MCP încorporat. Reinstalați Lorvex din descărcarea originală pentru a-l restaura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex не удаётся найти встроенную вспомогательную программу MCP. Переустановите Lorvex из исходной загрузки, чтобы восстановить её."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex தனது உள்ளமைக்கப்பட்ட MCP ஹெல்ப்பரைக் கண்டறிய முடியவில்லை. அதை மீட்டெடுக்க, அசல் பதிவிறக்கத்திலிருந்து Lorvexஐ மீண்டும் நிறுவவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex తన బిల్ట్-ఇన్ MCP హెల్పర్‌ను కనుగొనలేకపోతోంది. దాన్ని పునరుద్ధరించడానికి అసలు డౌన్‌లోడ్ నుండి Lorvexను మళ్ళీ ఇన్‌స్టాల్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex ไม่พบโปรแกรมช่วย MCP ในตัว ติดตั้ง Lorvex ใหม่จากไฟล์ดาวน์โหลดต้นฉบับเพื่อกู้คืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex, yerleşik MCP yardımcı uygulamasını bulamıyor. Geri yüklemek için Lorvex’i özgün indirmeden yeniden kurun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex не вдається знайти вбудовану допоміжну програму MCP. Перевстановіть Lorvex з оригінального завантаження, щоб відновити її."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بلٹ اِن MCP ہیلپر نہیں مل رہا۔ اسے بحال کرنے کے لیے Lorvex کو اصل ڈاؤن لوڈ سے دوبارہ انسٹال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex không tìm thấy trình hỗ trợ MCP tích hợp sẵn. Hãy cài đặt lại Lorvex từ bản tải về gốc để khôi phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 找不到其内置的 MCP 帮助程序。请从原始下载重新安装 Lorvex 以恢复它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 找不到內建的 MCP 輔助程式。請用原始下載檔重新安裝 Lorvex 來恢復。"
          }
        }
      }
    },
