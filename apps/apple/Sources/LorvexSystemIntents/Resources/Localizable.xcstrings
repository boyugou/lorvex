    "system.list.health.read.description": {
      "comment": "Description for the Find Lorvex Lists with Overdue Tasks App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البحث عن قوائم Lorvex التي تحتوي على مهام متأخرة، مع عدد المهام المتأخرة في كل منها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে Lorvex তালিকাগুলিতে বকেয়া টাস্ক আছে সেগুলি এবং প্রতিটিতে কতগুলি আছে তা খুঁজুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Findet die Lorvex-Listen mit überfälligen Aufgaben und zeigt, wie viele es jeweils sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βρείτε τις λίστες Lorvex που έχουν εκπρόθεσμες εργασίες και πόσες έχει η καθεμία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find the Lorvex lists that have overdue tasks, and how many each has."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca las listas de Lorvex que tienen tareas vencidas y cuántas tiene cada una."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یافتن فهرست‌های Lorvex که کار عقب‌افتاده دارند، و تعداد آن‌ها در هر فهرست."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve les listes de Lorvex qui ont des tâches en retard, avec le nombre de tâches pour chacune."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "איתור רשימות ב-Lorvex עם משימות באיחור, וכמה יש בכל אחת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उन Lorvex सूचियों को खोजें जिनमें अतिदेय कार्य हैं, और यह भी कि हर सूची में कितने हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menemukan daftar Lorvex yang memiliki tugas terlewat, beserta jumlahnya di tiap daftar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova le liste di Lorvex che hanno attività in ritardo e quante ne ha ciascuna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限切れのタスクがあるLorvexのリストと、それぞれの期限切れタスクの件数を探します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기한 초과 할 일이 있는 Lorvex 목록과 목록별 개수를 찾습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ज्या Lorvex याद्यांमध्ये ओव्हरड्यू कार्ये आहेत त्या आणि प्रत्येकीमध्ये किती आहेत ते शोधा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencari senarai Lorvex yang mempunyai tugas lewat, beserta bilangannya bagi setiap senarai."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoekt de Lorvex-lijsten met verlopen taken en toont hoeveel het er per lijst zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukuje listy Lorvex z zaległymi zadaniami i podaje, ile ich jest w każdej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontra as listas do Lorvex que têm tarefas atrasadas e quantas cada uma tem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Găsește listele Lorvex cu sarcini restante și câte are fiecare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Находит списки Lorvex с просроченными задачами и показывает, сколько их в каждом."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காலக்கெடு முடிந்த பணிகள் உள்ள Lorvex பட்டியல்களையும், ஒவ்வொன்றிலும் எத்தனை உள்ளன என்பதையும் கண்டறியவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గడువు మీరిన టాస్క్‌లు ఉన్న Lorvex జాబితాలను, ప్రతిదానిలో ఎన్ని ఉన్నాయో కనుగొనండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค้นหาลิสต์ Lorvex ที่มีงานเกินกำหนด พร้อมจำนวนงานของแต่ละลิสต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gecikmiş görevleri olan Lorvex listelerini ve her birinde kaç tane olduğunu bulun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знаходить списки Lorvex із простроченими завданнями й показує, скільки їх у кожному."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ Lorvex فہرستیں تلاش کریں جن میں تاخیر کا شکار کام ہیں، اور ہر ایک میں ان کی تعداد۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm các danh sách Lorvex có nhiệm vụ quá hạn, cùng số lượng ở mỗi danh sách."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找有逾期任务的 Lorvex 列表，以及每个列表各有多少项逾期任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尋找有逾期任務的 Lorvex 清單，以及各清單的逾期任務數量。"
          }
        }
      }
    },
