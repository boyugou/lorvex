          }
        }
      }
    },
    "settings.permissions.badge_due_tasks": {
      "comment": "Toggle label for showing due-task count on the Dock icon",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض شارة بعدد المهام المستحقة على أيقونة التطبيق"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ আইকনে বকেয়া ও আজকের টাস্কের সংখ্যা দেখান"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Symbol mit Anzahl fälliger Aufgaben kennzeichnen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ταμπέλα εικονιδίου εφαρμογής με το πλήθος των εργασιών με προθεσμία"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Badge app icon with due-task count"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar contador de tareas en el icono de la app"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نشان تعداد کارهای سررسید روی نماد برنامه"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher le nombre de tâches à échéance sur l’icône"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תג עם מספר המשימות לביצוע על סמל האפליקציה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप आइकन पर नियत कार्यों का बैज"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri lencana pada ikon app dengan jumlah tugas jatuh tempo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il numero di attività in scadenza sull’icona"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリアイコンに期限のタスク数をバッジ表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 아이콘에 기한 할 일 수를 배지로 표시"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ॲप आयकॉनवर ओव्हरड्यू आणि आजच्या कार्यांची संख्या दाखवा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri lencana pada ikon app dengan bilangan tugas yang dijangka"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Badge op appsymbool met aantal vervallende taken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuj liczbę zadań na ikonie aplikacji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar contagem de tarefas com prazo no ícone"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișați numărul de sarcini scadente pe pictograma aplicației"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать число задач на значке приложения"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காலக்கெடு பணிகளின் எண்ணிக்கையுடன் செயலி ஐகான் பேட்ஜ்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గడువు టాస్క్‌ల సంఖ్యతో యాప్ ఐకాన్ బ్యాడ్జ్"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่ป้ายกำกับบนไอคอนแอปด้วยจำนวนงานที่ถึงกำหนด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama simgesinde son tarihi gelen görev sayısını göster"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати кількість завдань на значку програми"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ آئیکن پر مقررہ کاموں کی تعداد کا بیج"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị huy hiệu số nhiệm vụ đến hạn trên biểu tượng ứng dụng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 App 图标上显示到期任务数量"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 App 圖示上標記到期任務數量"
          }
        }
      }
    },
    "settings.permissions.badge_footer": {
      "comment": "Footer explaining the Dock badge task count",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض عدد المهام المتأخرة والمستحقة اليوم على أيقونة Dock."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock আইকনে বকেয়া এবং আজ শেষ তারিখ এমন বাকি টাস্কের সংখ্যা দেখায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die Anzahl überfälliger und heute fälliger offener Aufgaben am Dock-Symbol an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζει στο εικονίδιο του Dock τον αριθμό των ανοιχτών εργασιών που είναι εκπρόθεσμες ή λήγουν σήμερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the number of overdue and due-today open tasks on the Dock icon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra en el icono del Dock el número de tareas pendientes vencidas o que vencen hoy."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تعداد کارهای باز عقب‌افتاده و سررسید امروز را روی نماد Dock نمایش می‌دهد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche sur l’icône du Dock le nombre de tâches à faire en retard ou à échéance aujourd’hui."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג על סמל ה-Dock את מספר המשימות הפתוחות שבאיחור או שתאריך היעד שלהן היום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डॉक आइकन पर अतिदेय और आज नियत लंबित कार्यों की संख्या दिखाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan jumlah tugas belum selesai yang terlewat dan jatuh tempo hari ini pada ikon Dock."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra sull’icona del Dock il numero di attività da fare in ritardo o in scadenza oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dockのアイコンに、期限切れと今日が期限の未完了タスクの数を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 아이콘에 기한이 지났거나 오늘 기한인 미완료 할 일의 수를 표시합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock आयकॉनवर ओव्हरड्यू आणि आज देय असलेल्या प्रलंबित कार्यांची संख्या दाखवते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunjukkan bilangan tugas belum selesai yang lewat dan dijangka hari ini pada ikon Dock."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont het aantal openstaande taken die verlopen zijn of vandaag vervallen op het Dock-symbool."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje na ikonie w Docku liczbę zaległych zadań oraz zadań do zrobienia z terminem na dzisiaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra no ícone do Dock o número de tarefas pendentes atrasadas ou com prazo para hoje."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișează numărul de sarcini de făcut restante sau scadente astăzi pe pictograma din Dock."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает на значке в Dock число невыполненных задач, которые просрочены или должны быть выполнены сегодня."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காலக்கெடு முடிந்த மற்றும் இன்று காலக்கெடு உள்ள நிலுவைப் பணிகளின் எண்ணிக்கையை Dock ஐகானில் காட்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గడువు మీరిన మరియు ఈరోజు గడువు ఉన్న పెండింగ్ టాస్క్‌ల సంఖ్యను Dock ఐకాన్‌పై చూపుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงจำนวนงานที่ยังไม่เสร็จซึ่งเกินกำหนดและครบกำหนดวันนี้บนไอคอน Dock"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock simgesinde, gecikmiş ve bugün son tarihi gelen açık görevlerin sayısını gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує на значку в Dock кількість невиконаних завдань, які прострочені або мають бути виконані сьогодні."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تاخیر زدہ اور آج مقررہ نامکمل کاموں کی تعداد Dock آئیکن پر دکھاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị số nhiệm vụ chưa hoàn thành quá hạn và đến hạn hôm nay trên biểu tượng Dock."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在程序坞图标上显示逾期和今日到期的未完成任务数量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Dock 圖示上顯示逾期與今天到期的未完成任務數量。"
          }
        }
      }
    },
