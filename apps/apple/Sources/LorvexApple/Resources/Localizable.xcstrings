    "task_detail.tags.empty": {
      "comment": "Shown in the tags picker when no task carries a tag yet.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد وسوم بعد. اكتب وسمًا ثم اضغط على Return."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও কোনো ট্যাগ নেই। একটি লিখে রিটার্ন চাপুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Tags. Gib einen ein und drücke den Zeilenschalter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν ετικέτες ακόμη. Πληκτρολογήστε μία και πατήστε το Return."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No tags yet. Type one and press Return."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay etiquetas. Escribe una y pulsa Retorno."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز برچسبی وجود ندارد. یکی بنویسید و Return را بزنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun tag pour l’instant. Saisissez-en un et appuyez sur Retour."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין אין תגים. יש להקליד תג וללחוץ על Return."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई टैग नहीं। एक लिखें और Return दबाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada label. Ketik satu lalu tekan Return."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun tag. Scrivine uno e premi Invio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグはまだありません。入力してReturnキーを押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 태그가 없습니다. 입력한 후 Return 키를 누르세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अजून टॅग नाहीत. एक टाइप करा आणि रिटर्न दाबा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada tag. Taip satu dan tekan Return."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen tags. Typ er een en druk op Return."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak tagów. Wpisz tag i naciśnij Return."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma etiqueta ainda. Digite uma e pressione Return."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu există taguri. Introduceți unul și apăsați Retur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тегов пока нет. Введите тег и нажмите Return."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีแท็ก พิมพ์แท็กแล้วกด Return"
