    "settings.cloud_sync.account.not_checked_detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم التحقق من iCloud بمجرد تشغيل المزامنة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud wird geprüft, sobald die Synchronisierung eingeschaltet ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is checked once sync is turned on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud se comprueba al activar la sincronización."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پس از روشن شدن همگام‌سازی، iCloud بررسی می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud est vérifié dès que la synchronisation est activée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאחר הפעלת הסנכרון ייבדק חשבון iCloud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिंक चालू करने पर iCloud की जाँच की जाती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud viene verificato quando la sincronizzazione è attiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期をオンにすると、iCloudを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화를 켜면 iCloud를 확인합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud wordt gecontroleerd zodra synchronisatie is ingeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud jest sprawdzany po włączeniu synchronizacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iCloud é verificado quando a sincronização é ativada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud este verificat după ce sincronizarea este activată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud проверяется после включения синхронизации."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud перевіряється після ввімкнення синхронізації."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سنک آن ہونے کے بعد iCloud چیک کیا جاتا ہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
