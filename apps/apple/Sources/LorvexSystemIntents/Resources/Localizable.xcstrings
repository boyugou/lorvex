            "state": "translated",
            "value": "Xóa lời nhắc nhiệm vụ Lorvex"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 Lorvex 任务提醒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 Lorvex 任務提醒"
