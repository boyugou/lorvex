          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna attività pianificata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スケジュール済みのタスクはありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예정된 할 일 없음"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शेड्यूल केलेली कार्ये नाहीत"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada Tugas Dijadualkan"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen geplande taken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak zaplanowanych zadań"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma tarefa planejada"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicio sarcină programată"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет запланированных задач"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "திட்டமிடப்பட்ட பணிகள் இல்லை"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "షెడ్యూల్ చేయబడిన టాస్క్‌లు లేవు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีงานที่กำหนดไว้แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planlanan görev yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає запланованих завдань"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی شیڈول شدہ کام نہیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có nhiệm vụ đã lên lịch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
