    "settings.cloud_delete.success": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حذف بيانات Lorvex من iCloud. المزامنة متوقفة الآن."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud থেকে Lorvex ডেটা ডিলিট করা হয়েছে। সিঙ্ক এখন বন্ধ।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Lorvex-Daten wurden aus iCloud gelöscht. Die Synchronisierung ist jetzt ausgeschaltet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα δεδομένα του Lorvex διαγράφηκαν από το iCloud. Ο συγχρονισμός είναι πλέον ανενεργός."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex data was deleted from iCloud. Sync is now off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminaron los datos de Lorvex de iCloud. La sincronización está desactivada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "داده‌های Lorvex از iCloud حذف شد. همگام‌سازی اکنون خاموش است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données Lorvex ont été supprimées d’iCloud. La synchronisation est désormais désactivée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נתוני Lorvex נמחקו מ-iCloud. הסנכרון כבוי כעת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud से Lorvex का डेटा हटा दिया गया। सिंक अब बंद है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data Lorvex telah dihapus dari iCloud. Penyelarasan kini dimatikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati di Lorvex sono stati eliminati da iCloud. La sincronizzazione ora è disattivata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudからLorvexのデータを削除しました。同期はオフになりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에서 Lorvex 데이터를 삭제했습니다. 동기화가 꺼졌습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud मधून Lorvex डेटा हटवला गेला. सिंक आता बंद आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Data Lorvex telah dipadam daripada iCloud. Penyelarasan kini dinyahaktifkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Lorvex-gegevens zijn uit iCloud verwijderd. Synchronisatie staat nu uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane Lorvex zostały usunięte z iCloud. Synchronizacja jest wyłączona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados do Lorvex foram excluídos do iCloud. A sincronização agora está desativada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele Lorvex au fost șterse din iCloud. Sincronizarea este acum dezactivată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные Lorvex удалены из iCloud. Синхронизация выключена."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบข้อมูล Lorvex ออกจาก iCloud แล้ว การเชื่อมข้อมูลปิดอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex verileri iCloud’dan silindi. Eşzamanlama artık kapalı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані Lorvex видалено з iCloud. Синхронізацію вимкнено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا Lorvex ڈیٹا iCloud سے حذف کر دیا گیا۔ سنک اب بند ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu Lorvex đã được xóa khỏi iCloud. Đồng bộ hóa hiện đã tắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
