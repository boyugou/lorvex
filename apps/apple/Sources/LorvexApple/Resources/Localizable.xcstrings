            "value": "Terima pengingat tugas sebagai pemberitahuan sistem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi i promemoria delle attività come notifiche di sistema."
          }
        },
        "ja": {
