          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinitialiser la progression d’aujourd’hui ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאפס את ההתקדמות של היום?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज की प्रगति रीसेट करें?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur ulang kemajuan hari ini?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Reimpostare i progressi di oggi?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の進捗をリセットしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 진행 상황을 초기화하시겠습니까?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आजची प्रगती रीसेट करायची का?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset kemajuan hari ini?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De voortgang van vandaag terugzetten?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zresetować dzisiejszy postęp?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Redefinir o progresso de hoje?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Resetați progresul de astăzi?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбросить прогресс за сегодня?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்றைய முன்னேற்றத்தை மீட்டமைக்கவா?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈరోజు ప్రోగ్రెస్‌ను రీసెట్ చేయాలా?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีเซ็ตความคืบหน้าของวันนี้หรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünkü ilerleme sıfırlansın mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скинути прогрес за сьогодні?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج کی پیش رفت ری سیٹ کریں؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt lại tiến độ hôm nay?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置今天的进度？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要重設今天的進度嗎？"
          }
        }
      }
    },
