    "setup.permissions.notifications.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلقَّ تذكيرات المهام كإشعارات من النظام."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টাস্ক রিমাইন্ডার সিস্টেম নোটিফিকেশন হিসাবে পান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte Aufgabenerinnerungen als Systemmitteilungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λάβετε τις υπομνήσεις εργασιών ως γνωστοποιήσεις συστήματος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receive task reminders as system notifications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe recordatorios de tareas como notificaciones del sistema."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یادآورهای کار را به‌صورت اعلان سیستم دریافت کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevez les rappels de tâches sous forme de notifications système."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבלת תזכורות למשימות כהתראות מערכת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्य रिमाइंडर सिस्टम सूचनाओं के रूप में पाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima pengingat tugas sebagai pemberitahuan sistem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi i promemoria delle attività come notifiche di sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクのリマインダーをシステム通知として受け取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일 알림을 시스템 알림으로 받습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्य रिमाइंडर सिस्टीम नोटिफिकेशन म्हणून मिळवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima peringatan tugas sebagai pemberitahuan sistem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontvang taakherinneringen als systeemmeldingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otrzymuj przypomnienia o zadaniach jako powiadomienia systemowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receba lembretes de tarefas como notificações do sistema."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Primiți mementouri pentru sarcini ca notificări de sistem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получайте напоминания о задачах в виде системных уведомлений."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รับเตือนความจำของงานเป็นการแจ้งเตือนของระบบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görev anımsatıcılarını sistem bildirimleri olarak alın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отримуйте нагадування про завдання у вигляді системних сповіщень."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کاموں کی یاد دہانیاں سسٹم نوٹیفکیشنز کی صورت میں حاصل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận lời nhắc nhiệm vụ dưới dạng thông báo hệ thống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过系统通知接收任务提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以系統通知接收任務提醒。"
          }
        }
      }
    },
