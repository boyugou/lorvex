    "system.habit.stats.read.description": {
      "comment": "Description for the Read Lorvex Habit Stats App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة سلاسل عادات Lorvex وإحصاءات إكمالها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex অভ্যাসের ধারা ও চেক-ইনের পরিসংখ্যান পড়ুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest Serien und Erledigungsstatistiken von Lorvex-Gewohnheiten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαβάστε τα σερί και τα στατιστικά ολοκλήρωσης των συνηθειών Lorvex."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Lorvex habit streaks and completion stats."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee las rachas y las estadísticas de los hábitos de Lorvex."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خواندن زنجیره‌ها و آمار تکمیل عادت‌های Lorvex."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit les séries et les statistiques de réalisation des habitudes de Lorvex."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קריאת רצפים ונתוני השלמה של הרגלים ב-Lorvex."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex आदतों की स्ट्रीक और चेक-इन आँकड़े पढ़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca rekor dan statistik penyelesaian kebiasaan Lorvex."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge le serie e le statistiche di completamento delle abitudini di Lorvex."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexの習慣の連続記録と完了数の統計を読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 습관의 연속 기록과 완료 통계를 읽습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex सवयीची स्ट्रीक आणि चेक-इनची आकडेवारी वाचा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca rentetan dan statistik penyelesaian tabiat Lorvex."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest reeksen en voltooiingsstatistieken van Lorvex-gewoontes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytuje serie i statystyki wykonania nawyków Lorvex."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê as sequências e as estatísticas de conclusão dos hábitos do Lorvex."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Citește seriile și statisticile de finalizare ale obiceiurilor Lorvex."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает серии и статистику выполнения привычек Lorvex."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex பழக்க ஸ்ட்ரீக்குகள், நிறைவு புள்ளிவிவரங்களைப் படிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex అలవాటు స్ట్రీక్‌లు, పూర్తి గణాంకాలను చదవండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านสถิติต่อเนื่องและสถิติการทำนิสัย Lorvex"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex alışkanlık serilerini ve tamamlama istatistiklerini okuyun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читає серії та статистику виконання звичок Lorvex."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عادات کے تسلسل اور تکمیل کے اعداد و شمار Lorvex سے پڑھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc chuỗi và thống kê hoàn thành của thói quen Lorvex."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取 Lorvex 习惯连续完成和完成统计。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取 Lorvex 習慣的連續紀錄與完成統計。"
          }
        }
      }
    },
    "system.habit.stats.read.dialog.days": {
      "comment": "Siri's answer about a daily habit. 1: the habit name. 2: its current streak in days. 3: all its completions.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %#@streak@، و%#@total@ في المجموع."
          },
          "substitutions": {
            "streak": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "few": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "سلسلة من %arg أيام"
                    }
