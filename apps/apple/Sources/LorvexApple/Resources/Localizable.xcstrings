    "calendar.event.end_after_start.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون وقت الانتهاء بعد وقت البدء"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শেষ হওয়ার সময় অবশ্যই শুরুর সময়ের পরে হতে হবে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Endzeit muss nach der Startzeit liegen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ώρα λήξης πρέπει να είναι μετά την ώρα έναρξης"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The end time must be after the start time"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hora de fin debe ser posterior a la de inicio"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زمان پایان باید بعد از زمان شروع باشد"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’heure de fin doit être postérieure à l’heure de début"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שעת הסיום חייבת להיות אחרי שעת ההתחלה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समाप्ति का समय शुरू होने के समय के बाद होना चाहिए"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu berakhir harus setelah waktu mulai"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ora di fine deve essere successiva all’ora di inizio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了時刻は開始時刻より後にしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료 시간은 시작 시간보다 늦어야 합니다"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "समाप्तीची वेळ सुरुवातीच्या वेळेनंतर असणे आवश्यक आहे"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa tamat mesti selepas masa mula"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De eindtijd moet na de starttijd liggen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Godzina zakończenia musi być późniejsza niż godzina rozpoczęcia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O horário de término deve ser posterior ao horário de início"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora de sfârșit trebuie să fie după ora de început"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время окончания должно быть позже времени начала"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முடிவு நேரம் தொடக்க நேரத்துக்குப் பிறகு இருக்க வேண்டும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ముగింపు సమయం ప్రారంభ సమయం తర్వాత ఉండాలి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาสิ้นสุดต้องอยู่หลังเวลาเริ่มต้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitiş saati, başlangıç saatinden sonra olmalıdır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час завершення має бути пізніше за час початку"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اختتامی وقت آغاز کے وقت کے بعد ہونا چاہیے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giờ kết thúc phải sau giờ bắt đầu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束时间必须晚于开始时间"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束時間必須晚於開始時間"
          }
        }
      }
    },
