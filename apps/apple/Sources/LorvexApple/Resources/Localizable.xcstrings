    "settings.cloud_sync.resume.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيرفع Lorvex البيانات المخزنة على جهاز Mac هذا إلى حساب iCloud المسجَّل الدخول إليه حاليًا ويستأنف المزامنة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Mac-এ সংরক্ষিত ডেটা Lorvex বর্তমানে সাইন ইন করা iCloud অ্যাকাউন্টে আপলোড করবে এবং সিঙ্ক আবার চালু করবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex lädt die auf diesem Mac gespeicherten Daten in den aktuell angemeldeten iCloud-Account hoch und setzt die Synchronisierung fort."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Lorvex θα μεταφορτώσει τα δεδομένα που είναι αποθηκευμένα σε αυτό το Mac στον λογαριασμό iCloud με τον οποίο έχετε συνδεθεί αυτήν τη στιγμή και θα συνεχίσει τον συγχρονισμό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex will upload the data stored on this Mac to the currently signed-in iCloud account and resume syncing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex subirá los datos guardados en este Mac a la cuenta de iCloud con la sesión iniciada y reanudará la sincronización."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه Lorvex داده‌های ذخیره‌شده در این Mac را در حساب iCloud واردشده فعلی بارگذاری و همگام‌سازی را از سر می‌گیرد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex enverra les données stockées sur ce Mac vers le compte iCloud actuellement connecté et reprendra la synchronisation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הנתונים השמורים ב-Mac הזה יועלו לחשבון ה-iCloud המחובר כעת והסנכרון יתחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex इस Mac पर रखा डेटा अभी साइन इन किए हुए iCloud खाते में अपलोड करेगा और सिंक फिर शुरू करेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex akan mengunggah data yang tersimpan di Mac ini ke akun iCloud yang saat ini masuk, lalu melanjutkan penyelarasan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex caricherà i dati archiviati su questo Mac nell’account iCloud attualmente connesso e riprenderà la sincronizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacに保存されているデータを、現在サインインしているiCloudアカウントにアップロードし、同期を再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에 저장된 데이터를 현재 로그인한 iCloud 계정에 업로드하고 동기화를 재개합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या Mac वर साठवलेला डेटा Lorvex सध्या साइन इन केलेल्या iCloud अकाउंटवर अपलोड करेल आणि सिंक पुन्हा सुरू करेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex akan memuat naik data yang disimpan pada Mac ini ke akaun iCloud yang sedang didaftar masuk, kemudian meneruskan penyelarasan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex uploadt de op deze Mac opgeslagen gegevens naar het momenteel ingelogde iCloud-account en hervat de synchronisatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex prześle dane przechowywane na tym Macu na aktualnie zalogowane konto iCloud i wznowi synchronizację."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lorvex enviará os dados armazenados neste Mac para a conta do iCloud conectada no momento e retomará a sincronização."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex va încărca datele stocate pe acest Mac în contul iCloud conectat în prezent și va relua sincronizarea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex загрузит данные, хранящиеся на этом Mac, в учётную запись iCloud, в которую сейчас выполнен вход, и возобновит синхронизацию."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex จะอัปโหลดข้อมูลที่จัดเก็บบน Mac เครื่องนี้ไปยังบัญชี iCloud ที่ลงชื่อเข้าอยู่ในขณะนี้ แล้วเชื่อมข้อมูลต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex, bu Mac’te saklanan verileri şu anda giriş yapılmış iCloud hesabına yükleyecek ve eşzamanlamayı sürdürecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex завантажить дані, що зберігаються на цьому Mac, в обліковий запис iCloud, в який зараз виконано вхід, і відновить синхронізацію."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس Mac پر محفوظ ڈیٹا کو Lorvex موجودہ سائن اِن iCloud اکاؤنٹ میں اپ لوڈ کرے گا اور سنک دوبارہ شروع کر دے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex sẽ tải dữ liệu lưu trên máy Mac này lên tài khoản iCloud đang đăng nhập và tiếp tục đồng bộ hóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 会将这台 Mac 上存储的数据上传到当前登录的 iCloud 账户，并恢复同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 會將這部 Mac 上儲存的資料上傳到目前登入的 iCloud 帳號，並繼續同步。"
          }
        }
      }
    },
    "settings.cloud_sync.resume.confirm.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد إعادة رفع بيانات جهاز Mac هذا واستئناف المزامنة؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Mac-এর ডেটা আবার আপলোড করে সিঙ্ক চালু করবেন?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten dieses Mac erneut hochladen und Synchronisierung fortsetzen?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Να γίνει επαναμεταφόρτωση των δεδομένων αυτού του Mac και συνέχιση του συγχρονισμού;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-upload this Mac’s data and resume sync?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Volver a subir los datos de este Mac y reanudar la sincronización?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "داده‌های این Mac دوباره بارگذاری و همگام‌سازی ازسر گرفته شود؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renvoyer les données de ce Mac et reprendre la synchronisation ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להעלות מחדש את נתוני ה-Mac הזה ולחדש את הסנכרון?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Mac का डेटा दोबारा अपलोड करें और सिंक फिर शुरू करें?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unggah ulang data Mac ini dan lanjutkan penyelarasan?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricaricare i dati di questo Mac e riprendere la sincronizzazione?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacのデータを再アップロードして、同期を再開しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 데이터를 다시 업로드하고 동기화를 재개하시겠습니까?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या Mac चा डेटा पुन्हा अपलोड करून सिंक सुरू करायचे का?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat naik semula data Mac ini dan teruskan penyelarasan?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gegevens van deze Mac opnieuw uploaden en synchronisatie hervatten?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesłać ponownie dane z tego Maca i wznowić synchronizację?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reenviar os dados deste Mac e retomar a sincronização?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reîncărcați datele acestui Mac și continuați sincronizarea?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправить данные этого Mac заново и возобновить синхронизацию?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปโหลดข้อมูลของ Mac เครื่องนี้อีกครั้งและเชื่อมข้อมูลต่อหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac’in verileri yeniden yüklensin ve eşzamanlama sürdürülsün mü?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надіслати дані цього Mac знову й відновити синхронізацію?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس Mac کا ڈیٹا دوبارہ اپ لوڈ کریں اور سنک بحال کریں؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải lại dữ liệu của máy Mac này lên và tiếp tục đồng bộ hóa?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要重新上传这台 Mac 的数据并恢复同步吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要重新上傳這部 Mac 的資料並繼續同步嗎？"
          }
        }
      }
    },
