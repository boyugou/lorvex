          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla l’ortografia o prova con un’altra ricerca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペルを確認するか、別の検索をお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "철자를 확인하거나 다른 검색어를 입력해 보세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्पेलिंग तपासा किंवा वेगळे काहीतरी सर्च करून पहा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semak ejaan atau cuba carian lain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer de spelling of probeer een andere zoekopdracht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź pisownię lub spróbuj wyszukać inną frazę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique a ortografia ou tente outra busca."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificați ortografia sau încercați o altă căutare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте написание или попробуйте другой запрос."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எழுத்தாக்கத்தைச் சரிபார்க்கவும் அல்லது வேறு தேடலை முயலவும்."
