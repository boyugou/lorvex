    "settings.calendar.mirror_detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة تقويمات الجهاز المحددة في Lorvex دون الكتابة في تقويماتك الشخصية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read selected device calendars into Lorvex without writing to your personal calendars."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee en Lorvex los calendarios del dispositivo que elijas, sin escribir en tus calendarios personales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire dans Lorvex les calendriers de l’appareil sélectionnés, sans rien écrire dans vos calendriers personnels."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके निजी कैलेंडर में कुछ लिखे बिना, चुने गए डिवाइस कैलेंडर Lorvex में पढ़ें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggi in Lorvex i calendari del dispositivo selezionati, senza scrivere nei tuoi calendari personali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したデバイスのカレンダーをLorvexに読み込みます。個人のカレンダーには書き込みません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 기기 캘린더를 Lorvex로 읽어 오며, 개인 캘린더에는 기록하지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex odczytuje wybrane kalendarze urządzenia i niczego nie zapisuje w twoich kalendarzach osobistych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia no Lorvex os calendários do dispositivo selecionados, sem gravar nos seus calendários pessoais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex считывает выбранные календари устройства, ничего не записывая в ваши личные календари."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex зчитує вибрані календарі пристрою, нічого не записуючи у ваші особисті календарі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将所选设备日历读取到 Lorvex 中，不会写入你的个人日历。"
