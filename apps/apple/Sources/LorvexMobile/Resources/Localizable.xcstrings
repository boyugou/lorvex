    "habits.field.encouragement.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عبارة تحفيزية تظهر لك على العادة، مثل \"اقرأ نصف ساعة ويزداد عقلك ثراءً.\""
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A motivating line you’ll see on the habit — e.g. “Read 30 minutes and your mind grows richer.”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una frase motivadora que verás en el hábito, por ejemplo: “Lee 30 minutos y tu mente se enriquece.”"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "جمله‌ای انگیزشی که روی عادت می‌بینید، مثلاً «30 دقیقه مطالعه کن تا ذهنت غنی‌تر شود.»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une phrase motivante qui s’affiche sur l’habitude, par exemple « Lisez 30 minutes et votre esprit s’enrichit. »"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שורת עידוד שתופיע על ההרגל, למשל: \"קריאה של 30 דקות מעשירה את התודעה.\""
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक प्रेरक पंक्ति जो आपको आदत पर दिखेगी, जैसे “30 मिनट पढ़ें, मन और समृद्ध होगा।”"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una frase motivante che vedrai sull’abitudine, ad esempio “Leggi 30 minuti e la tua mente si arricchisce.”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "習慣に表示される励ましの一言です。例：「30分読書して、心を豊かに。」"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "습관에 표시되는 응원 문구입니다. 예: “30분 책을 읽으면 마음이 더 풍요로워집니다.”"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Motywujące zdanie, które zobaczysz przy nawyku, np. „Czytaj 30 minut, a twój umysł stanie się bogatszy”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma frase motivadora que você verá no hábito, por exemplo: “Leia 30 minutos e sua mente fica mais rica.”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мотивирующая фраза, которую вы увидите у привычки, например: «Читайте 30 минут, и ваш ум станет богаче»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мотивувальна фраза, яку ви побачите біля звички, наприклад: «Читайте 30 хвилин, і ваш розум стане багатшим»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک حوصلہ افزا جملہ جو آپ کو عادت پر نظر آئے گا، مثلاً \"30 منٹ مطالعہ کریں اور آپ کا ذہن مزید وسیع ہو گا۔\""
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在习惯中显示的激励语 — 例如“坚持阅读 30 分钟，让思维更丰富。”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示在習慣上的鼓勵語，例如「閱讀 30 分鐘，讓思緒更豐富。」"
          }
        }
      }
    },
