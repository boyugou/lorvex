    "tasks.empty.search_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مهام تطابق بحثك. جرّب كلمات مختلفة أو امسح البحث."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Aufgaben entsprechen deiner Suche. Versuche andere Wörter oder lösche die Suche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No tasks match your search. Try different words or clear the search."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna tarea coincide con tu búsqueda. Prueba con otras palabras o borra la búsqueda."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ کاری با جست‌وجوی شما مطابقت ندارد. واژه‌های دیگری امتحان کنید یا جست‌وجو را پاک کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune tâche ne correspond à votre recherche. Essayez d’autres mots ou effacez la recherche."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין משימות שתואמות לחיפוש. אפשר לנסות מילים אחרות או לנקות את החיפוש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी खोज से कोई कार्य मेल नहीं खाता। दूसरे शब्द आज़माएँ या खोज साफ़ करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna attività corrisponde alla tua ricerca. Prova con parole diverse o cancella la ricerca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索に一致するタスクはありません。別の言葉を試すか、検索をクリアしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색과 일치하는 할 일이 없습니다. 다른 단어를 사용하거나 검색을 지워 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen taken komen overeen met je zoekopdracht. Probeer andere woorden of wis de zoekopdracht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadne zadanie nie pasuje do wyszukiwania. Spróbuj innych słów lub wyczyść wyszukiwanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma tarefa corresponde à sua busca. Tente outras palavras ou limpe a busca."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicio sarcină nu corespunde căutării. Încercați alte cuvinte sau ștergeți căutarea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни одна задача не соответствует поиску. Попробуйте другие слова или очистите поиск."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жодне завдання не відповідає пошуку. Спробуйте інші слова або очистіть пошук."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی تلاش سے کوئی کام مطابقت نہیں رکھتا۔ دوسرے الفاظ آزمائیں یا تلاش صاف کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有任务匹配你的搜索。换个词或清除搜索。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有符合搜尋條件的任務。請嘗試其他字詞，或清除搜尋。"
          }
        }
      }
    },
