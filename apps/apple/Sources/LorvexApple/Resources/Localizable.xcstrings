    "settings.reset.delete_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إكمال مسح البيانات المحلية. أعد تشغيل Lorvex ثم حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Löschen der lokalen Daten konnte nicht abgeschlossen werden. Starte Lorvex neu und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t finish erasing local data. Restart Lorvex and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo terminar de borrar los datos locales. Reinicia Lorvex e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پاک‌کردن داده‌های محلی کامل نشد. Lorvex را دوباره راه‌اندازی کنید و دوباره تلاش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de terminer l’effacement des données locales. Redémarrez Lorvex, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה להשלים את מחיקת הנתונים המקומיים. יש להפעיל מחדש את Lorvex ולנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय डेटा मिटाना पूरा नहीं हो सका। Lorvex को दोबारा शुरू करें और फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile completare la cancellazione dei dati locali. Riavvia Lorvex e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルデータの消去を完了できませんでした。Lorvexを再起動して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 데이터 지우기를 완료할 수 없습니다. Lorvex를 다시 시작하고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het wissen van de lokale gegevens kon niet worden voltooid. Start Lorvex opnieuw op en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się dokończyć usuwania danych lokalnych. Uruchom ponownie Lorvex i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível concluir a exclusão dos dados locais. Reinicie o Lorvex e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ștergerea datelor locale nu a putut fi finalizată. Reporniți Lorvex și încercați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось завершить стирание локальных данных. Перезапустите Lorvex и повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завершити стирання локальних даних. Перезапустіть Lorvex і повторіть спробу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقامی ڈیٹا مٹانے کا عمل مکمل نہیں ہو سکا۔ Lorvex دوبارہ شروع کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法完成本地数据清除。请重新启动 Lorvex 后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法完成清除本機資料。請重新啟動 Lorvex 後再試一次。"
          }
        }
      }
    },
    "settings.reset.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسح البيانات المحلية والإعدادات التي يديرها Lorvex على جهاز Mac هذا والبدء من جديد. هذا الإجراء محلي فقط: تبقى البيانات التي تمت مزامنتها مع iCloud في iCloud ويمكن تنزيلها مرة أخرى عند إعادة تمكين المزامنة. لا يتم حذف أحداث تقويم النظام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht die von Lorvex verwalteten lokalen Daten und Einstellungen auf diesem Mac und beginnt neu. Dies betrifft nur lokale Daten: Bereits mit iCloud synchronisierte Daten bleiben in iCloud und können erneut geladen werden, sobald die Synchronisierung wieder eingeschaltet wird. Ereignisse im Systemkalender werden nicht gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase Lorvex-managed local data and settings on this Mac and start fresh. This is local-only: data already synced to iCloud stays in iCloud and can download again when sync is re-enabled. System Calendar events are not deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra los datos locales y los ajustes que gestiona Lorvex en este Mac y empieza de cero. Solo afecta a lo local: los datos ya sincronizados con iCloud permanecen en iCloud y pueden volver a descargarse cuando se reactive la sincronización. Los eventos del Calendario del sistema no se eliminan."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "داده‌های محلی و تنظیمات مدیریت‌شده توسط Lorvex را در این Mac پاک می‌کند و از نو شروع می‌کند. این کار فقط محلی است: داده‌هایی که پیش‌تر با iCloud همگام شده‌اند در iCloud باقی می‌مانند و با فعال‌سازی مجدد همگام‌سازی دوباره دانلود می‌شوند. رویدادهای تقویم سیستم حذف نمی‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface les données et réglages locaux gérés par Lorvex sur ce Mac pour repartir de zéro. Cette action est locale : les données déjà synchronisées avec iCloud restent dans iCloud et peuvent être téléchargées de nouveau lorsque la synchronisation est réactivée. Les événements du calendrier du système ne sont pas supprimés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחיקת הנתונים וההגדרות המקומיים המנוהלים על ידי Lorvex ב-Mac הזה והתחלה מחדש. הפעולה מקומית בלבד: נתונים שכבר סונכרנו עם iCloud נשארים ב-iCloud ויורדו שוב כשהסנכרון יופעל מחדש. אירועי לוח השנה של המערכת לא נמחקים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Mac पर Lorvex द्वारा प्रबंधित स्थानीय डेटा और सेटिंग्ज़ मिटाएँ और नए सिरे से शुरू करें। यह केवल स्थानीय है: iCloud में पहले से सिंक हो चुका डेटा iCloud में बना रहता है और सिंक फिर से चालू करने पर दोबारा डाउनलोड हो सकता है। सिस्टम कैलेंडर के इवेंट नहीं हटाए जाते।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella i dati e le impostazioni locali gestiti da Lorvex su questo Mac e ricomincia da zero. L’operazione è solo locale: i dati già sincronizzati con iCloud restano in iCloud e possono essere scaricati di nuovo quando la sincronizzazione viene riattivata. Gli eventi del Calendario di sistema non vengono eliminati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMac上でLorvexが管理しているローカルのデータと設定を消去して、最初からやり直します。この操作はローカルのみが対象です。すでにiCloudに同期されたデータはiCloudに残り、同期を再び有効にすると再びダウンロードできます。システムカレンダーのイベントは削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 Lorvex가 관리하는 로컬 데이터와 설정을 지우고 처음부터 다시 시작합니다. 로컬에만 적용되며, 이미 iCloud에 동기화된 데이터는 iCloud에 남아 있고 동기화를 다시 활성화하면 다시 내려받을 수 있습니다. 시스템 캘린더 이벤트는 삭제되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wist de door Lorvex beheerde lokale gegevens en instellingen op deze Mac en begint opnieuw. Dit geldt alleen voor lokale gegevens: gegevens die al met iCloud zijn gesynchroniseerd, blijven in iCloud staan en kunnen opnieuw worden gedownload wanneer synchronisatie weer wordt ingeschakeld. Activiteiten in de systeemagenda worden niet verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa dane lokalne i ustawienia zarządzane przez Lorvex na tym Macu, aby zacząć od nowa. Dotyczy to wyłącznie danych lokalnych: dane już zsynchronizowane z iCloud pozostają w iCloud i można je ponownie pobrać po ponownym włączeniu synchronizacji. Wydarzenia z Kalendarza systemowego nie są usuwane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga os dados e ajustes locais gerenciados pelo Lorvex neste Mac e recomeça do zero. A ação é somente local: os dados já sincronizados com o iCloud permanecem no iCloud e podem ser baixados novamente quando a sincronização for reativada. Os eventos do Calendário do sistema não são excluídos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șterge datele locale și configurările gestionate de Lorvex de pe acest Mac și o ia de la capăt. Acțiunea este doar locală: datele deja sincronizate cu iCloud rămân în iCloud și pot fi descărcate din nou când sincronizarea este reactivată. Evenimentele din Calendarul sistemului nu sunt șterse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стирает локальные данные и настройки, которыми управляет Lorvex, на этом Mac, чтобы начать с чистого листа. Это затрагивает только локальные данные: данные, уже синхронизированные с iCloud, остаются в iCloud и снова загрузятся при повторном включении синхронизации. События системного Календаря не удаляются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стирає локальні дані та параметри, якими керує Lorvex, на цьому Mac, щоб почати з чистого аркуша. Це стосується лише локальних даних: дані, уже синхронізовані з iCloud, залишаються в iCloud і знову завантажаться, коли синхронізацію ввімкнуть повторно. Події системного Календаря не видаляються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس Mac پر Lorvex کے زیر انتظام مقامی ڈیٹا اور ترتیبات مٹا کر نئے سرے سے شروع کریں۔ یہ صرف مقامی ہے: جو ڈیٹا پہلے سے iCloud میں سنک ہو چکا ہے وہ iCloud میں رہتا ہے اور سنک دوبارہ فعال کرنے پر دوبارہ ڈاؤن لوڈ ہو سکتا ہے۔ سسٹم کیلنڈر کے ایونٹس حذف نہیں ہوتے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除本台 Mac 上由 Lorvex 管理的本地数据和设置并重新开始。此操作仅限本地：已同步到 iCloud 的数据会保留在 iCloud 中，重新启用同步后可能会再次下载。系统日历中的事件不会被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除這部 Mac 上由 Lorvex 管理的本機資料與設定，並重新開始。這只會影響本機：已同步到 iCloud 的資料會留在 iCloud 中，重新啟用同步後即可再次下載。系統行事曆中的事件不會被刪除。"
          }
        }
      }
    },
    "settings.reset.environment_database_error": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم Lorvex مسار قاعدة بيانات من بيئة التشغيل. أزل إعداد البيئة هذا وأعد تشغيل Lorvex قبل إعادة تعيين البيانات المحلية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex verwendet einen Datenbankpfad aus der Startumgebung. Entferne diese Umgebungseinstellung und starte Lorvex neu, bevor du die lokalen Daten zurücksetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex is using a database path from the launch environment. Remove that environment setting and restart Lorvex before resetting local data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex está usando una ruta de base de datos del entorno de inicio. Elimina esa configuración del entorno y reinicia Lorvex antes de restablecer los datos locales."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه Lorvex از یک مسیر پایگاه‌داده در محیط راه‌اندازی استفاده می‌کند. پیش از بازنشانی داده‌های محلی، آن تنظیم محیطی را حذف کنید و Lorvex را دوباره راه‌اندازی کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex utilise un chemin de base de données défini par l’environnement de lancement. Supprimez ce réglage d’environnement et redémarrez Lorvex avant de réinitialiser les données locales."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נתיב מסד הנתונים נלקח מסביבת ההפעלה של Lorvex. יש להסיר את הגדרת הסביבה ולהפעיל מחדש את Lorvex לפני איפוס הנתונים המקומיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex लॉन्च एनवायरनमेंट से मिला डेटाबेस पाथ उपयोग कर रहा है। स्थानीय डेटा रीसेट करने से पहले वह एनवायरनमेंट सेटिंग हटाएँ और Lorvex को दोबारा शुरू करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex sta usando un percorso del database definito dall’ambiente di avvio. Rimuovi l’impostazione dell’ambiente e riavvia Lorvex prima di reimpostare i dati locali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexは起動環境で指定されたデータベースのパスを使用しています。ローカルデータをリセットする前に、その環境設定を削除してLorvexを再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex가 실행 환경에서 지정한 데이터베이스 경로를 사용하고 있습니다. 로컬 데이터를 초기화하기 전에 해당 환경 설정을 제거하고 Lorvex를 다시 시작하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex gebruikt een databasepad uit de opstartomgeving. Verwijder die omgevingsinstelling en start Lorvex opnieuw op voordat je de lokale gegevens wist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex używa ścieżki bazy danych ze środowiska uruchomieniowego. Usuń to ustawienie środowiska i uruchom Lorvex ponownie, zanim zresetujesz dane lokalne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lorvex está usando um caminho de banco de dados definido pelo ambiente de inicialização. Remova essa configuração de ambiente e reinicie o Lorvex antes de redefinir os dados locais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex utilizează o cale de bază de date din mediul de lansare. Eliminați configurarea respectivă din mediu și reporniți Lorvex înainte de a reseta datele locale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex использует путь к базе данных из окружения запуска. Удалите этот параметр окружения и перезапустите Lorvex, прежде чем сбрасывать локальные данные."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex використовує шлях до бази даних із середовища запуску. Видаліть цей параметр середовища й перезапустіть Lorvex, перш ніж скидати локальні дані."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لانچ ماحول کا ڈیٹابیس پاتھ استعمال ہو رہا ہے۔ مقامی ڈیٹا ری سیٹ کرنے سے پہلے وہ ماحولیاتی سیٹنگ ہٹائیں اور Lorvex دوبارہ شروع کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 正在使用来自启动环境的数据库路径。请先移除该环境设置并重启 Lorvex，然后再重置本地数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 正在使用啟動環境所指定的資料庫路徑。重設本機資料之前，請先移除該環境設定並重新啟動 Lorvex。"
          }
        }
      }
    },
