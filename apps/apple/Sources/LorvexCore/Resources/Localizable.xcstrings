    "import.error.not_a_backup": {
      "comment": "Shown when the file chosen for import can't be read as a Lorvex backup: it is another kind of file, or it is too damaged to recognize.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الملف ليس نسخة احتياطية من Lorvex، أو أنه تالف. اختر ملفًا مُصدَّرًا من Lorvex."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file isn’t a Lorvex backup, or it’s damaged. Choose a file exported from Lorvex."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo no es una copia de seguridad de Lorvex o está dañado. Elige un archivo exportado desde Lorvex."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier n’est pas une sauvegarde Lorvex, ou il est endommagé. Choisissez un fichier exporté depuis Lorvex."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ाइल Lorvex बैकअप नहीं है, या यह क्षतिग्रस्त है। Lorvex से एक्सपोर्ट की गई फ़ाइल चुनें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file non è un backup di Lorvex oppure è danneggiato. Scegli un file esportato da Lorvex."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルはLorvexのバックアップではないか、破損しています。Lorvexから書き出したファイルを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 Lorvex 백업이 아니거나 손상되었습니다. Lorvex에서 내보낸 파일을 선택하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten plik nie jest kopią zapasową Lorvex lub jest uszkodzony. Wybierz plik wyeksportowany z Lorvex."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo não é um backup do Lorvex ou está danificado. Escolha um arquivo exportado do Lorvex."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот файл не является резервной копией Lorvex или повреждён. Выберите файл, экспортированный из Lorvex."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей файл не є резервною копією Lorvex або пошкоджений. Виберіть файл, експортований з Lorvex."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件不是 Lorvex 备份，或者已损坏。请选择从 Lorvex 导出的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案不是 Lorvex 備份，或已損毀。請選擇從 Lorvex 匯出的檔案。"
          }
        }
      }
    },
    "import.error.too_large": {
      "comment": "Shown when the file chosen for import is larger than a backup can be. %1$@ is the file's size and %2$@ the largest size a backup can have, each with its unit (\"412.3 MB\", \"67.1 MB\").",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حجم الملف المحدد %1$@. الحد الأقصى لحجم النسخة الاحتياطية من Lorvex هو %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected file is %1$@. A Lorvex backup can be at most %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo seleccionado ocupa %1$@. Una copia de seguridad de Lorvex puede ocupar como máximo %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier sélectionné fait %1$@. Une sauvegarde Lorvex ne peut pas dépasser %2$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनी गई फ़ाइल का आकार %1$@ है। Lorvex बैकअप का आकार अधिकतम %2$@ हो सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file selezionato è di %1$@. Un backup di Lorvex può essere al massimo di %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したファイルのサイズは%1$@です。Lorvexのバックアップは最大%2$@までです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 파일의 크기는 %1$@입니다. Lorvex 백업은 최대 %2$@까지 가능합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrany plik ma rozmiar %1$@. Kopia zapasowa Lorvex może mieć najwyżej %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo selecionado tem %1$@. Um backup do Lorvex pode ter no máximo %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер выбранного файла — %1$@. Резервная копия Lorvex не может превышать %2$@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розмір вибраного файлу — %1$@. Резервна копія Lorvex не може перевищувати %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选文件大小为 %1$@。Lorvex 备份最大为 %2$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選檔案大小為 %1$@。Lorvex 備份最大為 %2$@。"
          }
        }
      }
    },
