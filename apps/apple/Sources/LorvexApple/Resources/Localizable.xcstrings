          "stringUnit": {
            "state": "translated",
            "value": "＋ 버튼을 클릭하여 어시스턴트가 기억해야 할 내용을 저장하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op ＋ om iets te bewaren dat je assistent moet onthouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij ＋, aby zapisać coś, co asystent powinien zapamiętać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em ＋ para salvar algo que seu assistente deve lembrar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Faceți clic pe ＋ pentru a salva ceva ce ar trebui să rețină asistentul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите ＋, чтобы сохранить то, что ассистент должен помнить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть ＋, щоб зберегти те, що має пам’ятати асистент."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی ایسی بات محفوظ کرنے کے لیے ＋ پر کلک کریں جو آپ کے اسسٹنٹ کو یاد رکھنی چاہیے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按 ＋ 保存希望助手记住的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下 ＋ 儲存希望助理記住的事情。"
          }
        }
      }
    },
