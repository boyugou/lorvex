    "habits.row.reset_confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى مسح تسجيلات اليوم لهذه العادة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এতে এই অভ্যাসের আজকের চেক-ইন মুছে যাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden die heutigen Einträge dieser Gewohnheit gelöscht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα εκκαθαριστούν οι σημερινές καταγραφές αυτής της συνήθειας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This clears today’s check-ins for this habit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borrarán los registros de hoy de este hábito."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبت‌های امروز این عادت پاک می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela efface les validations d’aujourd’hui pour cette habitude."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסימונים של היום להרגל זה יימחקו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे इस आदत के आज के चेक-इन साफ़ हो जाएँगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Check-in hari ini untuk kebiasaan ini akan dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione cancella le registrazioni di oggi per questa abitudine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この習慣の今日のチェックインがクリアされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 습관의 오늘 체크인이 지워집니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "यामुळे या सवयीचे आजचे चेक-इन क्लिअर होतील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Check-in hari ini untuk tabiat ini akan dikosongkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wis je wat je vandaag voor deze gewoonte hebt afgevinkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhaczenia z dzisiaj dla tego nawyku zostaną wyczyszczone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso apaga os registros de hoje deste hábito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această acțiune șterge bifările de astăzi pentru acest obicei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметки за сегодня для этой привычки будут удалены."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது இந்தப் பழக்கத்தின் இன்றைய செக்-இன்களை அழிக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది ఈ అలవాటు యొక్క ఈరోజు చెక్ ఇన్‌లను క్లియర్ చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเช็คอินของนิสัยนี้ในวันนี้จะถูกล้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem, bu alışkanlık için bugünkü işaretlemeleri temizler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначки за сьогодні для цієї звички буде очищено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس عادت کے آج کے چیک اِن صاف ہو جائیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các lần điểm danh hôm nay của thói quen này sẽ bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将清除该习惯今天的打卡记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會清除這個習慣今天的打卡紀錄。"
          }
        }
      }
    },
    "habits.row.reset_confirm.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد إعادة تعيين تقدم اليوم؟"
          }
        },
        "bn": {
          "stringUnit": {
