    "system.task.batch.defer.title": {
      "comment": "Title for the Batch Defer Lorvex Tasks App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأجيل مهام Lorvex دفعة واحدة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Batch Defer Lorvex Tasks"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplazar tareas de Lorvex en lote"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reporter des tâches de Lorvex en lot"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex के कई कार्य टालें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimanda attività di Lorvex in blocco"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexのタスクをまとめて延期"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 할 일 일괄 미루기"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odłóż kilka zadań Lorvex"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiar tarefas do Lorvex em lote"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отложить несколько задач Lorvex"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкласти кілька завдань Lorvex"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批量延期 Lorvex 任务"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "批次延後 Lorvex 任務"
          }
        }
      }
    },
    "system.task.batch.move.description": {
      "comment": "Description for the Batch Move Lorvex Tasks App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نقل عدة مهام في Lorvex إلى قائمة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move multiple Lorvex tasks to a list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve varias tareas de Lorvex a una lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplace plusieurs tâches de Lorvex vers une liste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कई Lorvex कार्य किसी सूची में ले जाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta più attività di Lorvex in una lista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数のLorvexのタスクをリストに移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 Lorvex 할 일을 목록으로 이동합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenosi kilka zadań Lorvex do listy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Move várias tarefas do Lorvex para uma lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переносит несколько задач Lorvex в список."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переносить кілька завдань Lorvex до списку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将多个 Lorvex 任务移动到一个列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將多個 Lorvex 任務移到清單。"
          }
