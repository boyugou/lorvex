    "settings.quick_capture.detail.off": {
      "comment": "Footer under the Quick Capture shortcut picker in Settings while the shortcut is off. Quick Capture is a small window that opens over any app.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر اختصارًا لإضافة مهمة من أي تطبيق دون الانتقال إلى Lorvex."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেকোনো অ্যাপ থেকে Lorvex-এ না গিয়েই একটি টাস্ক যোগ করতে একটি শর্টকাট বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Tastaturkurzbefehl, um aus jeder App eine Aufgabe hinzuzufügen, ohne zu Lorvex zu wechseln."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε μια συντόμευση πληκτρολογίου για να προσθέτετε εργασίες από οποιαδήποτε εφαρμογή χωρίς να μεταβαίνετε στο Lorvex."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a shortcut to add a task from any app without switching to Lorvex."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un atajo de teclado para añadir una tarea desde cualquier app sin cambiar a Lorvex."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای افزودن یک کار از هر برنامه‌ای بدون رفتن به Lorvex، یک میان‌بر صفحه‌کلید انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un raccourci clavier pour ajouter une tâche depuis n’importe quelle app sans passer par Lorvex."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להוסיף משימה מכל אפליקציה בלי לעבור ל-Lorvex, יש לבחור קיצור מקלדת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी ऐप से Lorvex पर गए बिना कार्य जोड़ने के लिए एक शॉर्टकट चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih pintasan untuk menambahkan tugas dari app mana pun tanpa beralih ke Lorvex."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una scorciatoia da tastiera per aggiungere un’attività da qualsiasi app senza passare a Lorvex."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードショートカットを選ぶと、どのアプリからでもLorvexに切り替えずにタスクを追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키를 선택하면 어떤 앱에서든 Lorvex로 전환하지 않고 할 일을 추가할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex वर न जाता कोणत्याही ॲपमधून कार्य जोडण्यासाठी एक शॉर्टकट निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih pintasan untuk menambah tugas daripada mana-mana app tanpa beralih ke Lorvex."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een sneltoets om vanuit een willekeurige app een taak toe te voegen zonder naar Lorvex te schakelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz skrót klawiszowy, aby dodawać zadania z dowolnej aplikacji bez przełączania się na Lorvex."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um atalho de teclado para adicionar uma tarefa de qualquer app sem mudar para o Lorvex."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți o comandă rapidă de la tastatură pentru a adăuga o sarcină din orice aplicație fără a trece la Lorvex."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите сочетание клавиш, чтобы добавлять задачи из любого приложения, не переключаясь на Lorvex."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எந்தச் செயலியிலிருந்தும் Lorvexக்கு மாறாமலேயே பணியைச் சேர்க்க, ஒரு சுருக்கவழியைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏ యాప్ నుండైనా, Lorvexకు మారకుండానే టాస్క్‌ను జోడించడానికి ఒక షార్ట్‌కట్‌ను ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกทางลัดแป้นพิมพ์เพื่อเพิ่มงานจากแอปใดก็ได้โดยไม่ต้องสลับไปที่ Lorvex"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex’e geçmeden herhangi bir uygulamadan görev eklemek için bir klavye kısayolu seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть комбінацію клавіш, щоб додавати завдання з будь-якої програми, не перемикаючись на Lorvex."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی بھی ایپ سے Lorvex پر جائے بغیر کام شامل کرنے کے لیے ایک شارٹ کٹ منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một phím tắt để thêm nhiệm vụ từ bất kỳ ứng dụng nào mà không cần chuyển sang Lorvex."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个键盘快捷键，即可在任何 App 中添加任务，无需切换到 Lorvex。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個鍵盤快速鍵，即可在任何 App 中新增任務，無需切換到 Lorvex。"
          }
        }
      }
    },
    "settings.quick_capture.detail.on": {
      "comment": "Footer under the Quick Capture shortcut picker in Settings once a shortcut is chosen. Quick Capture is a small window that opens over any app.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على الاختصار في أي تطبيق لإضافة مهمة دون الانتقال إلى Lorvex."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেকোনো অ্যাপে শর্টকাট চাপুন এবং Lorvex-এ না গিয়েই একটি টাস্ক যোগ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke den Tastaturkurzbefehl in einer beliebigen App, um eine Aufgabe hinzuzufügen, ohne zu Lorvex zu wechseln."
          }
        },
        "el": {
          "stringUnit": {
