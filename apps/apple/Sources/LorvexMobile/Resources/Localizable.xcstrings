    "today.calm.schedule.empty": {
      "comment": "Schedule pane when there is nothing to draw",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد أحداث في التقويم ولا مهام لها وقت محدد بعد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যালেন্ডারে এখনও কিছু নেই, আর সময় নির্ধারিত কোনো টাস্কও নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts im Kalender und noch keine Aufgaben mit Uhrzeit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τίποτα στο ημερολόγιο και καμία εργασία με ώρα ακόμη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing on the calendar and no timed work yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada en el calendario y aún no hay tareas con hora."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز در تقویم چیزی نیست و کاری هم زمان‌بندی نشده است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien au calendrier et aucune tâche avec horaire pour l’instant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין אין דבר בלוח השנה, ואין משימות עם שעה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलेंडर में कुछ नहीं है और समय वाला कोई काम भी नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada acara di kalender dan belum ada tugas yang diberi waktu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente in calendario e ancora nessuna attività con orario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーに予定はなく、時刻の決まったタスクもまだありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더에 일정이 없고, 시간이 정해진 할 일도 아직 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दिनदर्शिकेत अजून काहीही नाही आणि वेळ ठरवलेले कोणतेही कार्यही नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada peristiwa dalam kalendar dan belum ada tugas yang diberi masa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niets in je agenda en nog geen taken met een tijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na razie brak wydarzeń w kalendarzu i zadań z godziną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada no calendário e nenhuma tarefa com horário ainda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nimic în calendar și nicio sarcină cu oră."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нет ни событий в календаре, ни задач со временем."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கேலண்டரில் எதுவும் இல்லை, நேரம் ஒதுக்கப்பட்ட வேலையும் இன்னும் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "క్యాలెండర్‌లో ఏమీ లేదు, సమయం కేటాయించిన పని కూడా ఇంకా లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีอะไรในปฏิทินและยังไม่มีงานที่กำหนดเวลา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvimde hiçbir şey yok ve henüz saatli iş yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки що немає ні подій у календарі, ні завдань із часом."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی کیلنڈر میں کچھ نہیں اور کسی کام کا وقت مقرر نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có sự kiện nào trong lịch và chưa có nhiệm vụ nào được đặt giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日历上没有安排，也还没有定时的任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "行事曆上沒有事件，也還沒有排定時間的任務。"
          }
        }
      }
    },
