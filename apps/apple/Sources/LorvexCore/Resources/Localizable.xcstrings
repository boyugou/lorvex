    },
    "error.reason.record_too_long_to_sync": {
      "comment": "Alert shown when saving an item whose text, all fields together, is more than one sync record can carry.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا العنصر أطول من أن تتم مزامنته. اختصر أطول نص فيه ثم حاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই আইটেমটি সিঙ্ক করার জন্য অনেক বড়। এর সবচেয়ে বড় লেখাটি ছোট করে আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Objekt ist zu lang für die Synchronisierung. Kürze den längsten Text und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το στοιχείο είναι πολύ μεγάλο για συγχρονισμό. Συντομεύστε το μεγαλύτερο κείμενό του και δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item is too long to sync. Shorten its longest text and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este elemento es demasiado largo para sincronizarse. Acorta su texto más largo e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این مورد برای همگام‌سازی بیش از حد طولانی است. طولانی‌ترین متن آن را کوتاه کنید و دوباره تلاش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet élément est trop long pour être synchronisé. Raccourcissez son texte le plus long, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפריט הזה ארוך מדי לסנכרון. יש לקצר את הטקסט הארוך ביותר שבו ולנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आइटम सिंक होने के लिए बहुत लंबा है। इसका सबसे लंबा टेक्स्ट छोटा करके फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Item ini terlalu panjang untuk diselaraskan. Persingkat teks terpanjangnya lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elemento è troppo lungo per essere sincronizzato. Accorcia il testo più lungo e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目は長すぎて同期できません。いちばん長いテキストを短くしてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목이 너무 길어 동기화할 수 없습니다. 가장 긴 텍스트를 줄인 후 다시 시도하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा आयटम सिंक करण्यासाठी खूप मोठा आहे. त्यातील सर्वात मोठा मजकूर लहान करा आणि पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Item ini terlalu panjang untuk diselaraskan. Pendekkan teksnya yang terpanjang dan cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit item is te lang om te synchroniseren. Kort de langste tekst in en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten element jest za długi, aby go zsynchronizować. Skróć jego najdłuższy tekst i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este item é longo demais para sincronizar. Encurte o texto mais longo e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest element este prea lung pentru a fi sincronizat. Scurtați cel mai lung text și încercați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот элемент слишком длинный для синхронизации. Сократите самый длинный текст и попробуйте ещё раз."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த ஐட்டம் ஒத்திசைக்க மிக நீளமாக உள்ளது. அதில் மிக நீளமான உரையைச் சுருக்கி, மீண்டும் முயலவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఐటెమ్ సింక్ చేయడానికి చాలా పొడవుగా ఉంది. దానిలోని అత్యంత పొడవైన టెక్స్ట్‌ను తగ్గించి, మళ్ళీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการนี้ยาวเกินกว่าจะเชื่อมข้อมูลได้ ย่อข้อความที่ยาวที่สุดแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu öğe eşzamanlanamayacak kadar uzun. En uzun metnini kısaltıp yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей елемент задовгий для синхронізації. Скоротіть найдовший текст та спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ آئٹم سنک کرنے کے لیے بہت لمبا ہے۔ اس کا سب سے لمبا متن مختصر کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mục này quá dài để đồng bộ hóa. Hãy rút ngắn đoạn văn bản dài nhất rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容太长，无法同步，请缩短最长的部分后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內容太長，無法同步，請縮短最長的部分後再試。"
          }
        }
      }
    },
    "error.reason.reopening_advanced_repeat": {
      "comment": "Alert shown when a person reopens an occurrence of a repeating task whose next occurrence has already moved on.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه المهمة المتكررة انتقلت بالفعل إلى تكرارها التالي، لذا لا يمكن إعادة فتحها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই পুনরাবৃত্ত টাস্কটি ইতিমধ্যেই পরবর্তী বারে চলে গেছে, তাই এটি আবার খোলা যাবে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese sich wiederholende Aufgabe ist bereits bei der nächsten Wiederholung angekommen und kann deshalb nicht wieder geöffnet werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η επαναλαμβανόμενη εργασία έχει ήδη περάσει στην επόμενη επανάληψή της, επομένως δεν μπορεί να ανοιχτεί ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This repeating task has already moved on to its next occurrence, so it can’t be reopened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarea recurrente ya ha pasado a su siguiente repetición, así que no se puede reabrir."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار تکرارشونده از قبل به تکرار بعدی خود رفته است، بنابراین نمی‌توان آن را بازگشایی کرد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette tâche récurrente est déjà passée à son occurrence suivante et ne peut donc pas être rouverte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשימה החוזרת הזו כבר עברה למופע הבא שלה, ולכן אי אפשר לפתוח אותה מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह दोहराया जाने वाला कार्य पहले ही अगली बार के लिए आगे बढ़ चुका है, इसलिए इसे फिर से नहीं खोला जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas berulang ini sudah berlanjut ke kejadian berikutnya, sehingga tidak dapat dibuka kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa attività ricorrente è già passata alla sua occorrenza successiva, quindi non può essere riaperta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この繰り返しタスクはすでに次回分に進んでいるため、未完了に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 반복 할 일은 이미 다음 반복으로 넘어갔기 때문에 다시 열 수 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे पुनरावृत्ती होणारे कार्य आधीच पुढच्या वेळेकडे सरकले आहे, त्यामुळे ते पुन्हा उघडता येत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas berulang ini sudah beralih ke kejadian seterusnya, jadi tidak boleh dibuka semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze terugkerende taak is al doorgegaan naar de volgende herhaling en kan daarom niet worden heropend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zadanie cykliczne przeszło już do kolejnego wystąpienia, więc nie można go ponownie otworzyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarefa recorrente já passou para a próxima ocorrência, então não pode ser reaberta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această sarcină repetitivă a trecut deja la următoarea apariție, deci nu poate fi redeschisă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта повторяющаяся задача уже перешла к следующему повторению, поэтому её нельзя открыть снова."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீண்டும் நிகழும் இந்தப் பணி ஏற்கெனவே அடுத்த நேர்வுக்குச் சென்றுவிட்டது, எனவே அதை மீண்டும் திறக்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పునరావృతమయ్యే ఈ టాస్క్ ఇప్పటికే తదుపరి సందర్భానికి వెళ్ళిపోయింది, కాబట్టి దాన్ని మళ్ళీ తెరవలేరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานทำประจำนี้ไปถึงครั้งถัดไปแล้ว จึงเปิดงานใหม่ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yinelenen görev zaten sonraki yinelemeye geçti, bu yüzden yeniden açılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це повторюване завдання вже перейшло до наступного повторення, тому його не можна відкрити знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ دہرایا جانے والا کام پہلے ہی اگلی تکرار پر جا چکا ہے، اس لیے اسے دوبارہ نہیں کھولا جا سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhiệm vụ lặp lại này đã chuyển sang lần lặp tiếp theo, nên không thể mở lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个重复任务已经进入下一次，所以无法重新打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個重複任務已經進入下一次，所以無法重新開啟。"
          }
        }
      }
    },
    "error.reason.repeat_day_taken": {
      "comment": "Alert shown when a person moves an occurrence of a repeating task to a day that another occurrence of the same series already holds.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد بالفعل تكرار آخر لهذه المهمة المتكررة في ذلك اليوم. اختر يومًا آخر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই পুনরাবৃত্ত টাস্কের আরেকটি বার ইতিমধ্যেই ওই দিনে পড়েছে। অন্য একটি দিন বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An diesem Tag liegt bereits eine andere Wiederholung dieser sich wiederholenden Aufgabe. Wähle einen anderen Tag."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια άλλη επανάληψη αυτής της επαναλαμβανόμενης εργασίας πέφτει ήδη εκείνη την ημέρα. Επιλέξτε άλλη ημέρα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another occurrence of this repeating task already falls on that day. Choose a different day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra repetición de esta tarea recurrente ya cae ese día. Elige otro día."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک تکرار دیگر از این کار تکرارشونده همان روز قرار دارد. روز دیگری را انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre occurrence de cette tâche récurrente tombe déjà ce jour-là. Choisissez un autre jour."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מופע אחר של המשימה החוזרת הזו כבר חל באותו יום. יש לבחור יום אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस दोहराए जाने वाले कार्य की एक और बार उसी दिन पहले से है। कोई दूसरा दिन चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kejadian lain dari tugas berulang ini sudah jatuh pada hari itu. Pilih hari lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’altra occorrenza di questa attività ricorrente cade già in quel giorno. Scegli un altro giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この繰り返しタスクの別の回がすでにその日にあります。別の日を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 반복 할 일의 다른 반복이 이미 그날에 있습니다. 다른 날짜를 선택하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या पुनरावृत्ती होणाऱ्या कार्याची दुसरी वेळ आधीच त्या दिवशी आहे. दुसरा दिवस निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kejadian lain bagi tugas berulang ini sudah jatuh pada hari itu. Pilih hari lain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een andere herhaling van deze terugkerende taak valt al op die dag. Kies een andere dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inne wystąpienie tego zadania cyklicznego przypada już na ten dzień. Wybierz inny dzień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra ocorrência desta tarefa recorrente já cai nesse dia. Escolha outro dia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O altă apariție a acestei sarcini repetitive are loc deja în ziua respectivă. Alegeți altă zi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другое повторение этой повторяющейся задачи уже приходится на этот день. Выберите другой день."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீண்டும் நிகழும் இந்தப் பணியின் மற்றொரு நேர்வு ஏற்கெனவே அந்த நாளில் உள்ளது. வேறொரு நாளைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పునరావృతమయ్యే ఈ టాస్క్‌కు చెందిన మరొక సందర్భం ఇప్పటికే ఆ రోజున ఉంది. మరొక రోజును ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานทำประจำนี้มีอีกครั้งในวันนั้นอยู่แล้ว เลือกวันอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yinelenen görevin başka bir yinelemesi zaten o güne denk geliyor. Başka bir gün seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інше повторення цього повторюваного завдання вже припадає на цей день. Виберіть інший день."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس دہرائے جانے والے کام کی ایک اور تکرار پہلے ہی اسی دن ہے۔ کوئی دوسرا دن منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một lần lặp khác của nhiệm vụ lặp lại này đã rơi vào ngày đó. Hãy chọn ngày khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个重复任务的另一次已经在那一天，请选择其他日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個重複任務的另一次已經在那一天，請選擇其他日期。"
          }
        }
      }
    },
    "error.reason.starting_canceled_task": {
      "comment": "Alert shown when a person starts a task that was canceled.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إلغاء هذه المهمة. أعِد فتحها قبل بدئها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই টাস্কটি বাতিল করা হয়েছে। শুরু করার আগে এটি আবার খুলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aufgabe wurde abgebrochen. Öffne sie wieder, bevor du sie startest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η εργασία ακυρώθηκε. Ανοίξτε την ξανά πριν την ξεκινήσετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This task was cancelled. Reopen it before starting it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarea se canceló. Reábrela antes de iniciarla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار لغو شده است. پیش از شروع، آن را بازگشایی کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette tâche a été annulée. Rouvrez-la avant de la démarrer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשימה הזו בוטלה. יש לפתוח אותה מחדש לפני התחלתה."
          }
        },
        "hi": {
