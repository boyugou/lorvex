            "value": "나중에 바꿀 수 있습니다"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बदलणे तुमच्या हातात"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
