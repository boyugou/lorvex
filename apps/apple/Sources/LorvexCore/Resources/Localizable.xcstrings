  "strings": {
    "day_phrase.days_ago": {
      "comment": "How many days ago a day was, two or more (\"3 days ago\"); after \"Due\" in the week review's overdue rows.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld day ago"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld days ago"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld 天前"
                }
              }
            }
          }
        }
      }
    },
