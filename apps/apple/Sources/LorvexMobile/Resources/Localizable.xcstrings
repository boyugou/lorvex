    "setup.welcome.today.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما هو مخطط له أو مستحق أو بدأ العمل عليه اليوم، في قائمة واحدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ যা প্ল্যান করা আছে, যার শেষ তারিখ আজ, বা যা শুরু হয়েছে – সব এক তালিকায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was heute geplant, fällig oder begonnen ist, in einer Liste."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ό,τι είναι προγραμματισμένο, λήγει ή έχει ξεκινήσει σήμερα, σε μία λίστα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What’s planned, due, or started today, in one list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo planificado, lo que vence y lo que ya empezaste hoy, en una sola lista."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همه آنچه برای امروز تعیین شده، سررسید دارد یا شروع شده، در یک فهرست."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui est planifié, à échéance ou commencé aujourd’hui, dans une seule liste."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל מה שמתוכנן להיום, שמועד היעד שלו היום או שהתחיל היום — ברשימה אחת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज क्या प्लान है, क्या नियत है और क्या शुरू हुआ है, सब एक सूची में।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang direncanakan, jatuh tempo, atau dimulai hari ini, dalam satu daftar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che è pianificato, in scadenza o iniziato oggi, in un’unica lista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日予定されているもの、期限のもの、開始したものを、1つのリストにまとめます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 계획되었거나 기한이 되었거나 시작한 일을 하나의 목록에 모아 보여 줍니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आज जे प्लॅन केले आहे, ज्याची देय तारीख आज आहे किंवा जे सुरू झाले आहे – सर्व काही एकाच यादीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang dirancang, dijangka atau dimulakan hari ini, dalam satu senarai."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wat vandaag gepland staat, vervalt of al is gestart, in één lijst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadania zaplanowane na dziś, z terminem na dziś lub już rozpoczęte — na jednej liście."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que está planejado, com prazo ou iniciado hoje, em uma só lista."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot ce este planificat, scadent sau început astăzi, într-o singură listă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задачи, запланированные на сегодня, со сроком сегодня или уже начатые, — в одном списке."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்று திட்டமிட்டவை, காலக்கெடு உள்ளவை அல்லது தொடங்கியவை – அனைத்தும் ஒரே பட்டியலில்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈరోజు ప్లాన్ చేసినవి, గడువు ఉన్నవి లేదా ప్రారంభించినవి – అన్నీ ఒకే జాబితాలో."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่วางแผนไว้ ถึงกำหนด หรือเริ่มแล้วในวันนี้ รวมอยู่ในลิสต์เดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün planlanan, son tarihi gelen veya başlatılan her şey tek bir listede."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завдання, заплановані на сьогодні, з терміном на сьогодні або вже розпочаті, — в одному списку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج کے لیے جو کچھ طے ہے، مقرر ہے یا شروع ہو چکا ہے، سب ایک ہی فہرست میں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc đã lên kế hoạch, đến hạn hoặc đã bắt đầu hôm nay, trong một danh sách."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天计划做的、到期的和已开始的事，都在一个列表里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天安排好的、到期的或已開始的任務，全都集中在一份清單裡。"
          }
        }
      }
    },
    "setup.welcome.control.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لك الكلمة الأخيرة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শেষ সিদ্ধান্ত আপনারই"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast das letzte Wort"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η τελευταία λέξη είναι δική σας"
          }
        },
        "en": {
