    "system.task.reminders.upcoming.read.description": {
      "comment": "Description for the Read Lorvex Upcoming Task Reminders App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة تذكيرات مهام Lorvex القادمة قريبًا وما زالت قيد الانتظار."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শীঘ্রই আসছে এমন অপেক্ষমাণ Lorvex টাস্ক রিমাইন্ডার পড়ুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest ausstehende Lorvex-Aufgabenerinnerungen, die bald anstehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαβάστε τις εκκρεμείς υπομνήσεις εργασιών Lorvex που πλησιάζουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read pending Lorvex task reminders coming up soon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee los recordatorios pendientes de tareas de Lorvex que se acercan."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خواندن یادآورهای در انتظار کارهای Lorvex که به‌زودی فرا می‌رسند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit les rappels de tâches de Lorvex en attente qui arrivent bientôt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קריאת תזכורות ממתינות של משימות ב-Lorvex שיגיעו בקרוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex कार्यों के वे लंबित रिमाइंडर पढ़ें जो जल्द आने वाले हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca pengingat tugas Lorvex yang masih menunggu dan akan segera tiba."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge i promemoria in sospeso delle attività di Lorvex in arrivo a breve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後予定されている、保留中のLorvexのタスクのリマインダーを読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예정된 대기 중인 Lorvex 할 일 알림을 읽습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लवकरच येणारे प्रलंबित Lorvex कार्य रिमाइंडर वाचा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca peringatan tugas Lorvex yang masih menunggu dan akan tiba tidak lama lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest openstaande Lorvex-taakherinneringen die binnenkort volgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytuje oczekujące przypomnienia zadań Lorvex, które zostaną wyświetlone w najbliższym czasie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê os lembretes pendentes de tarefas do Lorvex que estão chegando."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Citește mementourile sarcinilor Lorvex în așteptare care urmează în curând."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает ожидающие напоминания задач Lorvex, которые сработают в ближайшее время."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விரைவில் வரவிருக்கும், நிலுவையில் உள்ள Lorvex பணி நினைவூட்டல்களைப் படிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "త్వరలో రాబోయే పెండింగ్ Lorvex టాస్క్ రిమైండర్‌లను చదవండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านเตือนความจำงาน Lorvex ที่รอดำเนินการและกำลังจะถึง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakında gelecek bekleyen Lorvex görev anımsatıcılarını okuyun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читає очікувані нагадування завдань Lorvex, що спрацюють найближчим часом."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کاموں کی وہ باقی یاد دہانیاں Lorvex سے پڑھیں جو جلد آنے والی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc các lời nhắc nhiệm vụ Lorvex đang chờ và sắp đến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取即将到来的待处理 Lorvex 任务提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取即將到來、待處理的 Lorvex 任務提醒。"
          }
        }
      }
    },
    "system.task.reminders.upcoming.read.names_dialog": {
