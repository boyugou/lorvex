            "value": "응원 문구"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Motywujące zdanie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Incentivo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мотивирующая фраза"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мотивувальна фраза"
          }
        },
        "zh-Hans": {
