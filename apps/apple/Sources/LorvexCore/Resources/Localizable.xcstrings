            "value": "ข้อความยาวเกินไป ย่อให้สั้นลงแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu metin çok uzun. Kısaltıp yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст задовгий. Скоротіть його та спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ متن بہت لمبا ہے۔ اسے مختصر کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Văn bản này quá dài. Hãy rút ngắn rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容太长了，请缩短后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內容太長了，請縮短後再試。"
          }
        }
      }
    },
    "error.reason.title_required": {
      "comment": "Alert shown when a task is saved without a title, for example from a Shortcuts action given a blank title.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج المهمة إلى عنوان. أضف عنوانًا ثم حاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টাস্কের একটি শিরোনাম লাগবে। একটি শিরোনাম যোগ করে আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Aufgabe braucht einen Titel. Gib einen Titel ein und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια εργασία χρειάζεται τίτλο. Προσθέστε έναν και δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A task needs a title. Add one and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarea necesita un título. Añade uno e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کار باید عنوان داشته باشد. یکی اضافه کنید و دوباره تلاش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une tâche doit avoir un titre. Ajoutez-en un, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למשימה נדרשת כותרת. יש להוסיף כותרת ולנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्य का शीर्षक होना ज़रूरी है। शीर्षक जोड़कर फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas harus memiliki judul. Tambahkan judul lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’attività deve avere un titolo. Aggiungine uno e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクにはタイトルが必要です。タイトルを入力してからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일에는 제목이 필요합니다. 제목을 입력한 후 다시 시도하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्याला शीर्षक आवश्यक आहे. शीर्षक जोडा आणि पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas memerlukan tajuk. Tambah satu dan cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een taak heeft een titel nodig. Voeg een titel toe en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadanie musi mieć tytuł. Dodaj go i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tarefa precisa de um título. Adicione um e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O sarcină are nevoie de un titlu. Adăugați unul și încercați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У задачи должно быть название. Добавьте его и попробуйте ещё раз."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பணிக்குத் தலைப்பு தேவை. ஒன்றைச் சேர்த்து, மீண்டும் முயலவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "టాస్క్‌కు టైటిల్ అవసరం. ఒకటి జోడించి, మళ్ళీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานต้องมีชื่อเรื่อง เพิ่มชื่อเรื่องแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir görevin başlığı olmalıdır. Başlık ekleyip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завдання повинно мати назву. Додайте її та спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کام کا عنوان ضروری ہے۔ ایک شامل کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhiệm vụ cần có tiêu đề. Hãy thêm tiêu đề rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务需要标题，请输入标题后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任務需要標題，請輸入標題後再試。"
          }
        }
      }
    },
    "error.reason.title_too_long": {
      "comment": "Alert shown when a task title is longer than the app accepts.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا العنوان طويل جدًا. اختصره ثم حاول مرة أخرى."
