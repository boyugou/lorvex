    "tasks.empty.cancelled.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى المهام الملغاة هنا، لتتمكن من مراجعة قراراتك السابقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাতিল করা টাস্কগুলি এখানে থেকে যায়, যাতে আপনি আগের সিদ্ধান্তগুলি ফিরে দেখতে পারেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgebrochene Aufgaben bleiben hier erhalten, damit du frühere Entscheidungen nachvollziehen kannst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ακυρωμένες εργασίες παραμένουν εδώ, ώστε να μπορείτε να ανατρέχετε σε παλαιότερες αποφάσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelled tasks stay here, so you can look back on past decisions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas canceladas se quedan aquí, para que puedas revisar decisiones pasadas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارهای لغوشده اینجا می‌مانند تا بتوانید به تصمیم‌های گذشته نگاه کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches annulées restent ici, pour que vous puissiez revenir sur vos décisions passées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משימות שבוטלו נשארות כאן, כדי שאפשר יהיה לעיין בהחלטות מהעבר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रद्द किए गए कार्य यहीं रहते हैं, ताकि आप पुराने फ़ैसलों को देख सकें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas yang dibatalkan tetap berada di sini, sehingga keputusan masa lalu dapat dilihat kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le attività annullate restano qui, così puoi rivedere le decisioni passate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセルしたタスクはここに残り、過去の判断を振り返ることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소한 할 일은 여기에 남아 있어 과거의 결정을 돌아볼 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रद्द केलेली कार्ये येथे राहतात, जेणेकरून तुम्ही मागील निर्णयांकडे वळून पाहू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas yang dibatalkan kekal di sini, supaya keputusan lalu boleh dilihat semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geannuleerde taken blijven hier staan, zodat je kunt terugkijken op eerdere beslissingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulowane zadania zostają tutaj, dzięki czemu możesz wrócić do dawnych decyzji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas canceladas ficam aqui para você rever decisões passadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarcinile anulate rămân aici, astfel încât să puteți reveni asupra deciziilor anterioare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменённые задачи остаются здесь, чтобы вы могли оглянуться на прошлые решения."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ரத்துசெய்யப்பட்ட பணிகள் இங்கேயே இருக்கும், அதனால் கடந்த கால முடிவுகளைத் திரும்பிப் பார்க்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రద్దయిన టాస్క్‌లు ఇక్కడే ఉంటాయి, కాబట్టి మీరు గత నిర్ణయాలను తిరిగి చూసుకోవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานที่ยกเลิกจะอยู่ที่นี่ เพื่อให้คุณย้อนดูการตัดสินใจในอดีตได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İptal edilen görevler burada kalır; böylece geçmiş kararlara dönüp bakabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасовані завдання залишаються тут, щоб ви могли озирнутися на минулі рішення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منسوخ کام یہاں رہتے ہیں تاکہ آپ ماضی کے فیصلوں پر نظر ڈال سکیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các nhiệm vụ đã hủy vẫn nằm ở đây để có thể nhìn lại các quyết định trước đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消任务会保留在这里，便于回看过去的决策。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消的任務會保留在這裡，方便你回顧過去的決定。"
          }
        }
      }
    },
