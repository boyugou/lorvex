        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف شامل کرنا — پڑھنا مسدود"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ thêm – quyền đọc bị chặn"
          }
        },
