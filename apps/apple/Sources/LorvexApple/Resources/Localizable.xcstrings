    "batch_cancel.plain_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم إلغاء المهام المحددة. يمكنك إعادة فتح كل منها على حدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählten Aufgaben werden abgebrochen. Du kannst sie einzeln wieder öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected tasks will be cancelled. You can reopen them individually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas seleccionadas se cancelarán. Puedes reabrirlas una por una."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارهای انتخاب‌شده لغو می‌شوند. می‌توانید هرکدام را جداگانه دوباره باز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches sélectionnées seront annulées. Vous pouvez les rouvrir une par une."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשימות שנבחרו יבוטלו. אפשר לפתוח כל אחת מחדש בנפרד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुने गए कार्य रद्द हो जाएँगे। आप उन्हें एक-एक करके फिर से खोल सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le attività selezionate verranno annullate. Puoi riaprirle singolarmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したタスクがキャンセルされます。あとから個別に未完了に戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 할 일이 취소됩니다. 나중에 개별적으로 다시 열 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De geselecteerde taken worden geannuleerd. Je kunt ze afzonderlijk heropenen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrane zadania zostaną anulowane. Możesz otworzyć każde z nich ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas selecionadas serão canceladas. Você pode reabri-las individualmente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarcinile selectate vor fi anulate. Le puteți redeschide individual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранные задачи будут отменены. Вы сможете открыть каждую из них снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрані завдання буде скасовано. Ви зможете знову відкрити кожне з них."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب کام منسوخ کر دیے جائیں گے۔ آپ انہیں انفرادی طور پر دوبارہ کھول سکتے ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选任务将被取消。你可以单独重新打开它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選的任務將被取消。你可以之後個別重新開啟它們。"
          }
        }
      }
    },
