    "error.reason.notes_too_long": {
      "comment": "Alert shown when a task's notes are longer than the app accepts.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الملاحظات طويلة جدًا. اختصرها ثم حاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই নোটগুলি অনেক বড়। ছোট করে আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Notizen sind zu lang. Kürze sie und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτές οι σημειώσεις είναι πολύ μεγάλες. Συντομεύστε τις και δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These notes are too long. Shorten them and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas notas son demasiado largas. Acórtalas e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این یادداشت‌ها بیش از حد طولانی‌اند. آن‌ها را کوتاه‌تر کنید و دوباره تلاش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces notes sont trop longues. Raccourcissez-les, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההערות האלה ארוכות מדי. יש לקצר אותן ולנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये नोट बहुत लंबे हैं। इन्हें छोटा करके फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan ini terlalu panjang. Persingkat lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste note sono troppo lunghe. Accorciale e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモが長すぎます。短くしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모가 너무 깁니다. 줄인 후 다시 시도하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या नोट्स खूप मोठ्या आहेत. त्या लहान करा आणि पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota ini terlalu panjang. Pendekkan dan cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze notities zijn te lang. Kort ze in en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te notatki są za długie. Skróć je i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas notas são longas demais. Encurte-as e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceste notițe sunt prea lungi. Scurtați-le și încercați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заметки слишком длинные. Сократите их и попробуйте ещё раз."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் குறிப்புகள் மிக நீளமாக உள்ளன. அவற்றைச் சுருக்கி, மீண்டும் முயலவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ నోట్స్ చాలా పొడవుగా ఉన్నాయి. వాటిని తగ్గించి, మళ్ళీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โน้ตยาวเกินไป ย่อให้สั้นลงแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu notlar çok uzun. Kısaltıp yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нотатки задовгі. Скоротіть їх та спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ نوٹس بہت لمبے ہیں۔ انہیں مختصر کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi chú này quá dài. Hãy rút ngắn rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备注太长了，请缩短后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備註太長了，請縮短後再試。"
          }
        }
      }
    },
    "error.reason.pausing_unstarted_task": {
      "comment": "Alert shown when a person pauses a task that is not in progress.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن الإيقاف المؤقت إلا لمهمة قيد التنفيذ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু চলমান টাস্কই পজ করা যায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur eine Aufgabe in Bearbeitung kann pausiert werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο μια εργασία σε εξέλιξη μπορεί να τεθεί σε παύση."
