          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Melebihi jam aktif sebanyak %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ in più rispetto agli orari della tua giornata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定に使う時間帯を%@超えています"
          }
        },
        "ko": {
          "stringUnit": {
