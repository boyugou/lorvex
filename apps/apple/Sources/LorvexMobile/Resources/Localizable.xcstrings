    "data_import.background.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستمر الاستيراد في العمل إذا أغلقت هذه الشاشة. وإذا لم يكتمل، فتحقق من اتصالك بالإنترنت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি বন্ধ করলেও ইম্পোর্ট চলতে থাকবে। শেষ না হলে আপনার ইন্টারনেট সংযোগ পরীক্ষা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Import läuft weiter, auch wenn du dies schließt. Falls er nicht abgeschlossen wird, überprüfe deine Internetverbindung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εισαγωγή συνεχίζεται ακόμη κι αν το κλείσετε. Αν δεν ολοκληρωθεί, ελέγξτε τη σύνδεσή σας στο διαδίκτυο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The import keeps running if you close this. If it doesn’t finish, check your internet connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La importación continúa si cierras esta pantalla. Si no termina, comprueba tu conexión a internet."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر این صفحه را ببندید، وارد کردن ادامه می‌یابد. اگر کامل نشد، اتصال اینترنت خود را بررسی کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’importation se poursuit si vous fermez cette fenêtre. Si elle ne se termine pas, vérifiez votre connexion internet."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הייבוא ממשיך גם לאחר סגירת המסך הזה. אם הוא לא מסתיים, יש לבדוק את חיבור האינטרנט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे बंद करने पर भी इंपोर्ट चलता रहेगा। अगर यह पूरा न हो, तो अपना इंटरनेट कनेक्शन जाँचें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Impor tetap berjalan jika ini ditutup. Jika tidak selesai, periksa koneksi internet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’importazione continua anche se chiudi questa schermata. Se non termina, controlla la connessione a internet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じても読み込みは続行されます。完了しない場合は、インターネット接続を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면을 닫아도 가져오기는 계속 진행됩니다. 완료되지 않으면 인터넷 연결을 확인하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे बंद केले तरी इम्पोर्ट सुरू राहील. ते पूर्ण न झाल्यास तुमचे इंटरनेट कनेक्शन तपासा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Import terus berjalan jika ini ditutup. Jika tidak selesai, semak sambungan internet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De import loopt door als je dit sluit. Controleer je internetverbinding als de import niet wordt voltooid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Import będzie trwał, nawet jeśli zamkniesz ten ekran. Jeśli się nie zakończy, sprawdź połączenie z internetem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A importação continua se você fechar esta tela. Se ela não terminar, verifique sua conexão com a internet."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Importul continuă chiar dacă închideți acest ecran. Dacă nu se finalizează, verificați conexiunea la internet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импорт продолжится, даже если вы закроете этот экран. Если он не завершится, проверьте подключение к интернету."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இதை மூடினாலும் இம்போர்ட் தொடர்ந்து நடக்கும். அது முடியவில்லை என்றால், உங்கள் இணைய இணைப்பைச் சரிபார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు దీన్ని మూసివేసినా ఇంపోర్ట్ కొనసాగుతుంది. అది పూర్తి కాకపోతే, మీ ఇంటర్నెట్ కనెక్షన్‌ను చెక్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การนำเข้าจะทำงานต่อไปแม้ปิดหน้านี้ หากไม่เสร็จ ให้ตรวจสอบการเชื่อมต่ออินเทอร์เน็ต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu kapatsanız da içe aktarma sürer. Bitmezse internet bağlantınızı kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імпорт триватиме, навіть якщо ви закриєте цей екран. Якщо він не завершиться, перевірте підключення до інтернету."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر آپ اسے بند کر دیں تو بھی امپورٹ جاری رہتا ہے۔ اگر مکمل نہ ہو تو اپنا انٹرنیٹ کنکشن چیک کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quá trình nhập vẫn tiếp tục nếu đóng bảng này. Nếu không hoàn tất, hãy kiểm tra kết nối internet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭此界面后导入会继续。如果一直没完成，请检查网络连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使關閉此畫面，匯入仍會繼續。若未能完成，請檢查你的網際網路連線。"
          }
        }
      }
    },
