    "recurrence.anchor.schedule.hint": {
      "comment": "One line beneath the repeat editor's anchor control, explaining “Regularly”.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتكرر وفق جدول ثابت، بغض النظر عن وقت إنهائك لها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederholt sich nach festem Zeitplan, unabhängig davon, wann du fertig wirst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeats on a fixed schedule, regardless of when you finish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se repite según un calendario fijo, sin importar cuándo termines."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با زمان‌بندی ثابت تکرار می‌شود، صرف‌نظر از اینکه چه زمانی تمامش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se répète selon un calendrier fixe, quel que soit le moment où vous terminez la tâche."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חוזר לפי לוח זמנים קבוע, בלי קשר למועד ההשלמה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तय शेड्यूल पर दोहराता है, चाहे आप इसे कभी भी पूरा करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ripete secondo una pianificazione fissa, indipendentemente da quando finisci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了した日にかかわらず、決まったスケジュールで繰り返します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료 시점과 관계없이 정해진 일정에 따라 반복됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhaalt volgens een vast schema, ongeacht wanneer je klaar bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powtarza się według stałego harmonogramu, niezależnie od tego, kiedy ukończysz zadanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repete em um cronograma fixo, independentemente de quando você terminar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se repetă după un program fix, indiferent de momentul în care terminați."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторяется по фиксированному расписанию независимо от того, когда вы выполните задачу."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторюється за фіксованим розкладом незалежно від того, коли ви виконаєте завдання."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقررہ شیڈول پر دہرایا جاتا ہے، چاہے آپ اسے کبھی بھی مکمل کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按固定计划重复，与你何时完成无关。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無論你何時完成，都會依固定的排程重複。"
          }
        }
      }
    },
