    "today.schedule.untimed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد وقت محدد لأي من مهام اليوم. يوزّعها \"اقتراح أوقات\" حول أحداث تقويمك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None of today’s tasks has a time. Suggest Times fits them around your calendar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna de las tareas de hoy tiene hora. Sugerir horarios las acomoda en los huecos de tu calendario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune tâche d’aujourd’hui n’a d’horaire. « Suggérer des horaires » les place autour de votre calendrier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज के किसी भी कार्य का समय तय नहीं है। “समय सुझाएँ” उन्हें आपके कैलेंडर के आसपास बिठा देता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna attività di oggi ha un orario. “Suggerisci orari” le sistema attorno al tuo calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のタスクには時刻が設定されていません。「時刻を提案」を使うと、カレンダーの予定を避けて配置します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 할 일 중 시간이 정해진 것이 없습니다. ‘시간 제안’을 누르면 캘린더 일정을 피해 배치합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadne zadanie na dziś nie ma godziny. „Zaproponuj godziny” dobierze je z uwzględnieniem twojego kalendarza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma tarefa de hoje tem horário. “Sugerir horários” as encaixa em torno do seu calendário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни у одной задачи на сегодня нет времени. «Предложить время» подберёт его с учётом вашего календаря."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жодне із завдань на сьогодні не має часу. «Запропонувати час» підбере його з урахуванням вашого календаря."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的任务都还没有时间。“建议时间”可以把它们排进日历的空档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的任務都還沒有時間。「建議時間」會依照你的行事曆為它們安排時段。"
          }
        }
      }
    },
    "today.schedule.wont_fit": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
