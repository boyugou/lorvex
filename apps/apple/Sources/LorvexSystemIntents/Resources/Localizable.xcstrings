    "system.task.batch.create.description": {
      "comment": "Description for the Batch Create Lorvex Tasks App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنشاء عدة مهام في Lorvex من العناوين."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শিরোনাম থেকে একাধিক Lorvex টাস্ক তৈরি করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt mehrere Lorvex-Aufgaben aus Titeln."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργήστε πολλές εργασίες Lorvex από τίτλους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create multiple Lorvex tasks from titles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea varias tareas de Lorvex a partir de títulos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ایجاد چند کار Lorvex از روی عنوان‌ها."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée plusieurs tâches de Lorvex à partir de titres."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יצירת כמה משימות ב-Lorvex מכותרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शीर्षकों से कई Lorvex कार्य बनाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuat beberapa tugas Lorvex dari judul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea più attività di Lorvex a partire dai titoli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルから複数のLorvexのタスクを作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목으로 여러 Lorvex 할 일을 만듭니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शीर्षकांवरून अनेक Lorvex कार्ये तयार करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencipta beberapa tugas Lorvex daripada tajuk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maakt meerdere Lorvex-taken aan op basis van titels."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tworzy kilka zadań Lorvex na podstawie tytułów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria várias tarefas do Lorvex a partir de títulos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Creează mai multe sarcini Lorvex pe baza titlurilor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создаёт несколько задач Lorvex по названиям."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தலைப்புகளிலிருந்து பல Lorvex பணிகளை உருவாக்கவும்."
          }
