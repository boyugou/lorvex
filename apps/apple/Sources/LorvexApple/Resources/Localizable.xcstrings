    "recurring_cancel.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد إلغاء هذا التكرار فقط، أم إنهاء سلسلة التكرار بالكامل؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur diese Wiederholung abbrechen oder die gesamte Serie beenden?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel only this occurrence, or end the whole repeating series?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cancelar solo esta repetición o terminar toda la serie?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط همین تکرار لغو شود یا کل مجموعه تکرارشونده پایان یابد؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler uniquement cette occurrence ou mettre fin à toute la série ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לבטל רק את המופע הזה או לסיים את כל הסדרה החוזרת?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल इस बार का कार्य रद्द करें, या पूरी दोहराई जाने वाली श्रृंखला समाप्त करें?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annullare solo questa occorrenza o terminare l’intera serie ricorrente?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今回分のみキャンセルしますか？それとも繰り返し全体を終了しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 반복만 취소하시겠습니까, 아니면 반복 전체를 종료하시겠습니까?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen deze herhaling annuleren, of de hele reeks beëindigen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulować tylko to wystąpienie czy całą serię?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar somente esta ocorrência ou encerrar toda a série recorrente?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulați doar această apariție sau încheiați întreaga serie repetitivă?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить только это повторение или всю серию?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасувати лише це повторення чи всю серію?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف یہی تکرار منسوخ کریں یا پوری دہرائی جانے والی سیریز ختم کریں؟"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只取消这一次，还是结束整个重复系列？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要只取消這一次，還是結束整個重複系列？"
          }
        }
      }
    },
