    "settings.sync.detail.off": {
      "comment": "Under the iCloud switch while sync is off.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى مهامك على هذا الجهاز. شغّل هذا الخيار لترى المهام والقوائم والعادات نفسها على أجهزتك الأخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tasks stay on this device. Turn this on to see the same tasks, lists, and habits on your other devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus tareas se quedan en este dispositivo. Activa esta opción para ver las mismas tareas, listas y hábitos en tus otros dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos tâches restent sur cet appareil. Activez cette option pour retrouver les mêmes tâches, listes et habitudes sur vos autres appareils."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके कार्य इसी डिवाइस पर रहते हैं। अपने दूसरे डिवाइस पर वही कार्य, सूचियाँ और आदतें देखने के लिए इसे चालू करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue attività restano su questo dispositivo. Attiva questa opzione per vedere le stesse attività, liste e abitudini sugli altri dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクはこのデバイスにのみ保存されます。オンにすると、ほかのデバイスでも同じタスク、リスト、習慣を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일은 이 기기에만 저장됩니다. 켜면 다른 기기에서도 같은 할 일, 목록, 습관을 볼 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje zadania zostają na tym urządzeniu. Włącz, aby widzieć te same zadania, listy i nawyki na swoich innych urządzeniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas tarefas ficam neste dispositivo. Ative esta opção para ver as mesmas tarefas, listas e hábitos nos seus outros dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши задачи хранятся только на этом устройстве. Включите, чтобы видеть те же задачи, списки и привычки на других устройствах."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші завдання зберігаються лише на цьому пристрої. Увімкніть, щоб бачити ті самі завдання, списки та звички на інших пристроях."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务只保存在这台设备上。打开后，你的其他设备上也会有同样的任务、清单和习惯。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的任務只會留在此裝置上。開啟後，你就能在其他裝置上看到相同的任務、清單和習慣。"
          }
        }
      }
    },
    "settings.sync.detail.on": {
      "comment": "Under the iCloud switch while sync is on.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى مهامك وقوائمك وعاداتك متطابقة على كل جهاز مسجّل الدخول إلى حساب iCloud الخاص بك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tasks, lists, and habits stay the same on every device signed in to your iCloud account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus tareas, listas y hábitos son los mismos en todos los dispositivos con sesión iniciada en tu cuenta de iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos tâches, listes et habitudes restent identiques sur tous les appareils connectés à votre compte iCloud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके iCloud खाते में साइन इन हर डिवाइस पर आपके कार्य, सूचियाँ और आदतें एक जैसी रहती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue attività, liste e abitudini restano uguali su ogni dispositivo connesso al tuo account iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスク、リスト、習慣は、同じiCloudアカウントでサインインしているすべてのデバイスで同じ状態に保たれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일, 목록, 습관이 iCloud 계정으로 로그인한 모든 기기에서 동일하게 유지됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje zadania, listy i nawyki są takie same na każdym urządzeniu zalogowanym na twoje konto iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas tarefas, listas e hábitos permanecem iguais em todos os dispositivos conectados à sua conta do iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши задачи, списки и привычки одинаковы на всех устройствах, на которых выполнен вход в вашу учётную запись iCloud."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші завдання, списки та звички однакові на всіх пристроях, на яких виконано вхід в обліковий запис iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务、清单和习惯会在登录同一 iCloud 账户的每台设备上保持一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的任務、清單和習慣會在所有登入同一個 iCloud 帳號的裝置上保持一致。"
          }
        }
      }
    },
