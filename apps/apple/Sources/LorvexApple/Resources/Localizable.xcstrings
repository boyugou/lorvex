    "today.schedule.undo.use": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدام الأوقات المقترحة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রস্তাবিত সময় ব্যবহার করুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorgeschlagene Zeiten verwenden"
          }
