    "calendar.picker.load_error": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل تقويماتك. تأكد من أن Lorvex يملك حق الوصول إلى التقويم في إعدادات النظام."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t load your calendars. Check that Lorvex has calendar access in System Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar tus calendarios. Comprueba que Lorvex tenga acceso al calendario en Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger vos calendriers. Vérifiez que Lorvex a accès aux calendriers dans Réglages Système."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके कैलेंडर लोड नहीं हो सके। सिस्टम सेटिंग्ज़ में जाँचें कि Lorvex के पास कैलेंडर एक्सेस है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare i tuoi calendari. Verifica che Lorvex abbia accesso al calendario in Impostazioni di Sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーを読み込めませんでした。「システム設定」でLorvexにカレンダーへのアクセスが許可されているか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더를 불러올 수 없습니다. 시스템 설정에서 Lorvex에 캘린더 접근 권한이 있는지 확인하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wczytać kalendarzy. Sprawdź, czy Lorvex ma dostęp do kalendarzy w Ustawieniach systemowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar seus calendários. Verifique se o Lorvex tem acesso ao calendário em Ajustes do Sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить календари. Убедитесь, что у Lorvex есть доступ к календарям в Системных настройках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити календарі. Переконайтеся, що Lorvex має доступ до календарів у Системних параметрах."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载你的日历。请在“系统设置”中确认 Lorvex 拥有日历访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入你的行事曆。請在「系統設定」中確認 Lorvex 是否擁有行事曆存取權限。"
          }
        }
      }
    },
