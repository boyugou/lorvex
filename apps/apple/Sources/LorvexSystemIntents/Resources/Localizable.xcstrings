    "system.task.checklist.add.description": {
      "comment": "Description for the Add Lorvex Checklist Item App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة عنصر إلى قائمة التحقق لمهمة في Lorvex."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি Lorvex টাস্কে চেকলিস্ট আইটেম যোগ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt einer Lorvex-Aufgabe einen Checklistenpunkt hinzu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε ένα στοιχείο λίστας ελέγχου σε μια εργασία Lorvex."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a checklist item to a Lorvex task."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un elemento de la lista de comprobación a una tarea de Lorvex."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "افزودن یک مورد چک‌لیست به یک کار Lorvex."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un élément de liste de contrôle à une tâche de Lorvex."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוספת פריט לרשימת התיוג של משימה ב-Lorvex."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex कार्य में चेकलिस्ट आइटम जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menambahkan item daftar centang ke tugas Lorvex."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge un elemento della lista di controllo a un’attività di Lorvex."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexのタスクにチェックリスト項目を追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 할 일에 체크리스트 항목을 추가합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एका Lorvex कार्यात तपासणी यादी आयटम जोडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menambah item senarai semak pada tugas Lorvex."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voegt een checklistonderdeel toe aan een Lorvex-taak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje element listy kontrolnej do zadania Lorvex."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona um item da lista de verificação a uma tarefa do Lorvex."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă un element în lista de control a unei sarcini Lorvex."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет пункт чек-листа к задаче Lorvex."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex பணியில் சரிபார்ப்புப் பட்டியல் ஐட்டத்தைச் சேர்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex టాస్క్‌కు చెక్‌లిస్ట్ ఐటెమ్‌ను జోడించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มรายการเช็คลิสต์ให้งาน Lorvex"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Lorvex görevine kontrol listesi öğesi ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додає пункт чек-листа до завдання Lorvex."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی Lorvex کام میں چیک لسٹ آئٹم شامل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm một mục checklist vào nhiệm vụ Lorvex."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向一个 Lorvex 任务添加清单项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為 Lorvex 任務新增核對清單項目。"
          }
        }
      }
    },
