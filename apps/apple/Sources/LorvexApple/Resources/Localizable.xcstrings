    "list_detail.empty.no_tasks_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا المهام المعيّنة لهذه القائمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
