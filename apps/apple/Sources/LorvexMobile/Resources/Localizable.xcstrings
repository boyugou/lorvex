    "diagnostics.recent.empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تسجيل أي إخفاقات. ستظهر حالات التعطل والأخطاء هنا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No failures recorded. Crashes and errors appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay fallos registrados. Los cierres inesperados y los errores aparecerán aquí."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ خطایی ثبت نشده است. کرش‌ها و خطاها اینجا نمایش داده می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune défaillance enregistrée. Les fermetures inattendues et les erreurs apparaissent ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נרשמו כשלים. קריסות ושגיאות יופיעו כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई विफलता दर्ज नहीं हुई। क्रैश और त्रुटियाँ यहाँ दिखेंगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun errore registrato. Arresti anomali ed errori appaiono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録された問題はありません。クラッシュやエラーはここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록된 문제가 없습니다. 충돌과 오류가 여기에 표시됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zarejestrowano problemów. Tutaj pojawiają się awarie i błędy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma falha registrada. Encerramentos inesperados e erros aparecem aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неполадок не зафиксировано. Здесь появляются сбои и ошибки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збоїв не зафіксовано. Тут з’являються аварії та помилки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی ناکامی ریکارڈ نہیں ہوئی۔ کریش اور خرابیاں یہاں نظر آتی ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未记录任何故障。崩溃和错误将显示在此处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有已記錄的問題。當機與錯誤會顯示在這裡。"
          }
        }
      }
    },
    "diagnostics.recent.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حالات التعطل واستثناءات الموارد التي يبلغ عنها النظام إلى Lorvex، بالإضافة إلى الأخطاء التي سجلها Lorvex بنفسه، الأحدث أولًا. اضغط على صف لعرض تفاصيله كاملة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crashes and resource exceptions the system reports to Lorvex, plus errors Lorvex recorded itself, newest first. Tap a row to see its full detail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierres inesperados y excepciones de recursos que el sistema notifica a Lorvex, además de los errores que Lorvex registró por su cuenta, del más reciente al más antiguo. Toca una fila para ver todos los detalles."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کرش‌ها و استثناهای منابع که سیستم به Lorvex گزارش می‌دهد، به‌علاوه خطاهایی که خود Lorvex ثبت کرده است، جدیدترین‌ها اول. برای دیدن جزئیات کامل، روی یک ردیف ضربه بزنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermetures inattendues et exceptions de ressources signalées par le système à Lorvex, ainsi que les erreurs que Lorvex a lui-même enregistrées, les plus récentes en premier. Touchez une ligne pour voir tous les détails."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קריסות וחריגות משאבים שהמערכת מדווחת ל-Lorvex, וגם שגיאות ש-Lorvex רשם בעצמו, החדשות ראשונות. יש להקיש על שורה כדי לראות את כל הפרטים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम द्वारा Lorvex को बताए गए क्रैश और रिसोर्स अपवाद, साथ ही Lorvex द्वारा खुद दर्ज की गई त्रुटियाँ, सबसे नई पहले। पूरा ब्योरा देखने के लिए किसी पंक्ति पर टैप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arresti anomali ed eccezioni di risorse segnalati dal sistema a Lorvex, più gli errori registrati da Lorvex stesso, dal più recente. Tocca una riga per vederne tutti i dettagli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムからLorvexに報告されたクラッシュとリソース例外、およびLorvex自身が記録したエラーを、新しい順に表示します。行をタップすると詳細を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템이 Lorvex에 보고한 충돌과 리소스 예외, 그리고 Lorvex가 직접 기록한 오류를 최신순으로 표시합니다. 행을 탭하면 자세한 내용을 볼 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Awarie i przekroczenia limitów zasobów zgłaszane przez system do Lorvex oraz błędy zapisane przez sam Lorvex, od najnowszych. Stuknij wiersz, aby zobaczyć wszystkie szczegóły."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerramentos inesperados e exceções de recursos que o sistema relata ao Lorvex, além de erros que o próprio Lorvex registrou, do mais recente ao mais antigo. Toque em uma linha para ver todos os detalhes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбои и превышения лимитов ресурсов, о которых система сообщает Lorvex, а также ошибки, записанные самим Lorvex, — сначала новые. Коснитесь строки, чтобы увидеть все подробности."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аварії та перевищення лімітів ресурсів, про які система повідомляє Lorvex, а також помилки, записані самим Lorvex, — спочатку новіші. Торкніть рядок, щоб побачити всі подробиці."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سسٹم کی طرف سے Lorvex کو رپورٹ کیے گئے کریش اور وسائل کے استثنیٰ، نیز Lorvex کے اپنے ریکارڈ کردہ ایرر، تازہ ترین پہلے۔ مکمل تفصیل دیکھنے کے لیے کسی قطار پر ٹیپ کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统向 Lorvex 报告的崩溃和资源异常，以及 Lorvex 自己记录的错误，最新的排在前面。点按任意一行可查看完整详情。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統回報給 Lorvex 的當機與資源例外，以及 Lorvex 自行記錄的錯誤，依時間由新到舊排列。點一下任一列即可查看完整詳細資料。"
          }
        }
      }
    },
