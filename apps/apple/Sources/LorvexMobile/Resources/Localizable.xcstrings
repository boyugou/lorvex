            "state": "translated",
            "value": "آپ اسے کسی بھی وقت ترتیبات میں تبدیل کر سکتے ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后也可以随时在设置中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以隨時在「設定」中變更。"
          }
        }
      }
    },
    "setup.done.capture.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضفها بنفسك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture it yourself"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añádela tú"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خودتان اضافه کنید"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez-la vous-même"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להוסיף בעצמך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खुद जोड़ें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungila tu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で追加する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 추가하기"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj samodzielnie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione manualmente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте сами"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте самі"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خود شامل کریں"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自己记下"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自己新增"
          }
        }
      }
    },
    "setup.done.capture.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط ＋ في أي تبويب لإضافة مهمة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap ＋ on any tab to add a task."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca ＋ en cualquier pestaña para añadir una tarea."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای افزودن کار، در هر زبانه روی ＋ ضربه بزنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez ＋ dans n’importe quel onglet pour ajouter une tâche."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להקיש על ＋ בכל לשונית כדי להוסיף משימה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्य जोड़ने के लिए किसी भी टैब पर ＋ पर टैप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca ＋ in qualsiasi scheda per aggiungere un’attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのタブでも＋をタップするとタスクを追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 탭에서든 ＋ 버튼을 탭하면 할 일을 추가할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij ＋ na dowolnej karcie, aby dodać zadanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em ＋ em qualquer aba para adicionar uma tarefa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь ＋ на любой вкладке, чтобы добавить задачу."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніть ＋ на будь-якій вкладці, щоб додати завдання."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کام شامل کرنے کے لیے کسی بھی ٹیب پر ＋ پر ٹیپ کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意标签页点按 ＋ 即可添加任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何分頁點一下 ＋ 即可新增任務。"
          }
        }
      }
    },
    "setup.done.assistant.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أو دع مساعدك يضيفها"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or let your assistant add it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "O deja que la añada tu asistente"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یا بگذارید دستیارتان اضافه کند"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou laissez votre assistant l’ajouter"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "או לתת לעוזר להוסיף"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "या असिस्टेंट से जुड़वाएँ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppure lascia che la aggiunga il tuo assistente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "またはアシスタントに追加してもらう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "또는 어시스턴트가 추가하게 하기"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Albo zleć to asystentowi"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou deixe seu assistente adicionar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Или поручите ассистенту"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Або доручіть асистенту"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یا اپنے اسسٹنٹ سے شامل کروائیں"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "或者交给助手"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "或讓助理代為新增"
          }
        }
      }
    },
    "setup.done.assistant.detail": {
      "comment": "Simplified Chinese deliberately names no assistant product here (China mainland App Store review); other languages may name Claude as the example.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اربط Claude أو مساعدًا آخر من إعدادات Lorvex على جهاز Mac، وسيضيف المهام ويخطط يومك معك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect Claude or another assistant in Lorvex’s settings on your Mac, and it adds tasks and plans your day with you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta Claude u otro asistente en los ajustes de Lorvex en tu Mac y añadirá tareas y planificará tu día contigo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در تنظیمات Lorvex روی Mac خود، Claude یا دستیار دیگری را وصل کنید تا کارها را اضافه کند و روزتان را با شما برنامه‌ریزی کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez Claude ou un autre assistant dans les réglages de Lorvex sur votre Mac : il ajoute des tâches et planifie votre journée avec vous."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לחבר את Claude או עוזר אחר בהגדרות של Lorvex ב-Mac שלך, והוא יוסיף משימות ויתכנן איתך את היום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने Mac पर Lorvex की सेटिंग्ज़ में Claude या कोई दूसरा असिस्टेंट जोड़ें, और वह कार्य जोड़ेगा तथा आपके साथ आपका दिन प्लान करेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega Claude o un altro assistente nelle impostazioni di Lorvex sul tuo Mac e aggiungerà attività e pianificherà la tua giornata con te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac版Lorvexの設定でClaudeなどのアシスタントを接続すると、アシスタントがタスクを追加し、一緒に1日を計画してくれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 Lorvex 설정에서 Claude 또는 다른 어시스턴트를 연결하면 할 일을 추가하고 함께 하루를 계획해 줍니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz Claude lub innego asystenta w ustawieniach Lorvex na swoim Macu, a będzie dodawać zadania i planować dzień razem z tobą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte o Claude ou outro assistente nos ajustes do Lorvex no seu Mac e ele adiciona tarefas e planeja seu dia com você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите Claude или другого ассистента в настройках Lorvex на своём Mac, и он будет добавлять задачи и планировать день вместе с вами."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключіть Claude або іншого асистента в параметрах Lorvex на своєму Mac, і він додаватиме завдання та плануватиме день разом із вами."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے Mac پر Lorvex کی ترتیبات میں Claude یا کوئی اور اسسٹنٹ جوڑ لیں، وہ کام شامل کرے گا اور آپ کے ساتھ آپ کا دن منصوبہ بنائے گا۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上的 Lorvex 设置中连接支持 MCP 的 AI 助手，它会替你添加任务，并和你一起规划每一天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上 Lorvex 的設定中連接 Claude 或其他助理後，它就能新增任務，並與你一起規劃一天。"
          }
        }
      }
    },
    "settings.sync.storage_full": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مساحة تخزين iCloud ممتلئة. سيُكمل Lorvex المزامنة عندما تتوفر مساحة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iCloud storage is full. Lorvex will finish syncing when there’s space."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu almacenamiento de iCloud está lleno. Lorvex terminará de sincronizar cuando haya espacio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فضای iCloud شما پر است. Lorvex وقتی جا باز شود همگام‌سازی را کامل می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre stockage iCloud est plein. Lorvex terminera la synchronisation dès qu’il y aura de la place."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האחסון ב-iCloud שלך מלא. הסנכרון יושלם כשיתפנה מקום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका iCloud स्टोरेज भर गया है। जगह मिलते ही Lorvex सिंक पूरा कर लेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio di archiviazione iCloud è pieno. Lorvex completerà la sincronizzazione quando ci sarà spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudのストレージがいっぱいです。空き容量ができ次第、Lorvexが同期を完了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 저장 공간이 가득 찼습니다. 공간이 생기면 Lorvex가 동기화를 마무리합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamięć iCloud jest pełna. Lorvex dokończy synchronizację, gdy zrobi się miejsce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento do iCloud está cheio. O Lorvex concluirá a sincronização quando houver espaço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранилище iCloud заполнено. Lorvex завершит синхронизацию, когда появится место."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сховище iCloud заповнене. Lorvex завершить синхронізацію, щойно з’явиться місце."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا iCloud اسٹوریج بھر گیا ہے۔ جگہ ملتے ہی Lorvex سنک مکمل کر لے گا۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 iCloud 储存空间已满。有空间后，Lorvex 会继续完成同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 iCloud 儲存空間已滿。有空間時，Lorvex 會完成同步。"
          }
        }
      }
    },
