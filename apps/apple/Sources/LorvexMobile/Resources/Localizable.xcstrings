    "tasks.empty.priority.message": {
      "comment": "Empty-state message of the Priority collection in the Tasks tab; says which tasks the collection holds.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا المهام غير المكتملة ذات الأولوية العالية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উচ্চ প্রাধান্যের বাকি টাস্কগুলি এখানে দেখা যায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offene Aufgaben mit hoher Priorität erscheinen hier."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ανοιχτές εργασίες με υψηλή προτεραιότητα εμφανίζονται εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open tasks with high priority appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas pendientes con prioridad alta aparecen aquí."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارهای باز با اولویت بالا در اینجا نمایش داده می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches à faire de priorité haute apparaissent ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משימות פתוחות בעדיפות גבוהה מופיעות כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उच्च प्राथमिकता वाले लंबित कार्य यहाँ दिखते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas yang belum selesai dengan prioritas tinggi muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le attività da fare con priorità alta appaiono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "優先度が高い未完了のタスクは、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우선순위가 높은 미완료 할 일이 여기에 표시됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उच्च प्राधान्य असलेली प्रलंबित कार्ये येथे दिसतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas yang belum selesai dengan keutamaan tinggi dipaparkan di sini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open taken met hoge prioriteit verschijnen hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadania do zrobienia z wysokim priorytetem pojawiają się tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas pendentes com prioridade alta aparecem aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarcinile de făcut cu prioritate ridicată apar aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появляются невыполненные задачи с высоким приоритетом."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதிக முன்னுரிமை உள்ள நிலுவைப் பணிகள் இங்கே தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అధిక ప్రాధాన్యత ఉన్న పెండింగ్ టాస్క్‌లు ఇక్కడ కనిపిస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานที่ยังไม่เสร็จและมีความสำคัญสูงจะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüksek öncelikli açık görevler burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут з’являються невиконані завдання з високим пріоритетом."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اعلیٰ ترجیح والے نامکمل کام یہاں نظر آتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các nhiệm vụ chưa hoàn thành có mức ưu tiên cao xuất hiện tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高优先级的未完成任务会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高優先順序的未完成任務會顯示在這裡。"
          }
        }
      }
    },
