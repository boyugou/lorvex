            "state": "translated",
            "value": "%1$@에 가장 잘 지키고, %2$@에 가장 적게 지킵니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najczęściej: %1$@, najrzadziej: %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Melhor dia: %1$@, pior dia: %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чаще всего: %1$@, реже всего: %2$@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найчастіше: %1$@, найрідше: %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@最稳定，%2$@最容易错过。"
