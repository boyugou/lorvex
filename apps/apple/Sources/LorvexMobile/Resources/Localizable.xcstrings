    "today.overbooked.none": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أجّل ما يمكنه الانتظار، أو اطلب من مساعدك تخطيط اليوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যা অপেক্ষা করতে পারে তা পিছিয়ে দিন, অথবা অ্যাসিস্ট্যান্টকে দিনটি প্ল্যান করতে বলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschiebe, was warten kann, oder bitte deinen Assistenten, den Tag zu planen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναβάλετε ό,τι μπορεί να περιμένει ή ζητήστε από τον βοηθό σας να προγραμματίσει την ημέρα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Defer what can wait, or ask your assistant to plan the day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplaza lo que pueda esperar o pide a tu asistente que planifique el día."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آنچه می‌تواند صبر کند را موکول کنید، یا از دستیارتان بخواهید روز را برنامه‌ریزی کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reportez ce qui peut attendre, ou demandez à votre assistant de planifier la journée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לדחות מה שיכול לחכות, או לבקש מהעוזר לתכנן את היום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो रुक सकता है उसे टालें, या अपने असिस्टेंट से दिन प्लान करने को कहें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunda yang dapat menunggu, atau minta asisten merencanakan hari ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimanda ciò che può aspettare oppure chiedi al tuo assistente di pianificare la giornata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後回しにできるものは延期するか、アシスタントに1日の計画を頼みましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미뤄도 되는 일은 미루거나, 어시스턴트에게 하루 계획을 요청해 보세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जे थांबू शकते ते पुढे ढकला, किंवा तुमच्या सहाय्यकाला दिवस प्लॅन करायला सांगा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangguhkan yang boleh menunggu, atau minta pembantu AI merancang hari ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel uit wat kan wachten, of vraag je assistent de dag te plannen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odłóż to, co może poczekać, albo poproś asystenta o zaplanowanie dnia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adie o que pode esperar ou peça ao seu assistente para planejar o dia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Amânați ce poate aștepta sau cereți asistentului să planifice ziua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отложите то, что может подождать, или попросите ассистента спланировать день."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காத்திருக்கக்கூடியவற்றைத் தள்ளிவைக்கவும், அல்லது நாளைத் திட்டமிடச் சொல்லி உங்கள் அசிஸ்டென்ட்டிடம் கேட்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆగగలిగే వాటిని వాయిదా వేయండి, లేదా రోజును ప్లాన్ చేయమని మీ అసిస్టెంట్‌ను అడగండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลื่อนสิ่งที่รอได้ หรือให้ผู้ช่วยของคุณวางแผนวันนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekleyebilecekleri erteleyin ya da asistanınızdan günü planlamasını isteyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкладіть те, що може зачекати, або попросіть асистента спланувати день."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جو انتظار کر سکتا ہے اسے ملتوی کریں، یا اپنے اسسٹنٹ سے دن کی منصوبہ بندی کرنے کو کہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoãn những việc có thể chờ, hoặc nhờ trợ lý lên kế hoạch cho ngày hôm nay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推迟可以等的事，或者让助手帮你规划今天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把可以等的事延後，或請助理規劃這一天。"
          }
        }
      }
    },
