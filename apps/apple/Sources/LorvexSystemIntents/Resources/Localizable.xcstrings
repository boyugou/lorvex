    "system.habit.reset.description": {
      "comment": "Description for the Reset Lorvex Habit App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة تعيين إكمال اليوم لعادة في Lorvex."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি Lorvex অভ্যাসের আজকের চেক-ইন রিসেট করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt die heutige Erledigung einer Lorvex-Gewohnheit zurück."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαναφέρετε τη σημερινή ολοκλήρωση μιας συνήθειας Lorvex."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset today’s completion for a Lorvex habit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablece los registros de hoy de un hábito de Lorvex."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بازنشانی تکمیل امروز یک عادت Lorvex."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinitialise la réalisation d’aujourd’hui pour une habitude de Lorvex."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "איפוס ההשלמה של היום להרגל ב-Lorvex."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex आदत का आज का चेक-इन रीसेट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengatur ulang penyelesaian hari ini untuk kebiasaan Lorvex."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Reimposta il completamento di oggi per un’abitudine di Lorvex."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexの習慣の今日の完了記録をリセットします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 습관의 오늘 완료 기록을 초기화합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एका Lorvex सवयीचे आजचे चेक-इन रीसेट करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mereset penyelesaian hari ini bagi tabiat Lorvex."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet de voortgang van vandaag van een Lorvex-gewoonte terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Resetuje dzisiejsze wykonanie nawyku Lorvex."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Redefine a conclusão de hoje de um hábito do Lorvex."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Resetează finalizarea de astăzi a unui obicei Lorvex."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбрасывает сегодняшнее выполнение привычки Lorvex."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex பழக்கத்தின் இன்றைய செக்-இனை மீட்டமைக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex అలవాటు కోసం ఈరోజు చెక్ ఇన్‌ను రీసెట్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีเซ็ตการทำนิสัย Lorvex ของวันนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Lorvex alışkanlığının bugünkü tamamlamasını sıfırlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скидає сьогоднішнє виконання звички Lorvex."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی Lorvex عادت کی آج کی تکمیل ری سیٹ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt lại lần hoàn thành hôm nay của một thói quen Lorvex."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置一个 Lorvex 习惯今天的完成记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重設 Lorvex 習慣今天的完成紀錄。"
          }
        }
      }
    },
    "system.habit.reset.dialog": {
      "comment": "Dialog after resetting a habit; %@ is the habit name",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت إعادة تعيين %@ في Lorvex."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
