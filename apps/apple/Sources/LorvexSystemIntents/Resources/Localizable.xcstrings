    "system.setup.complete.description": {
      "comment": "Description for the Complete Lorvex Setup App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وضع علامة على إعداد Lorvex كمكتمل مع قيم افتراضية اختيارية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঐচ্ছিক ডিফল্টসহ Lorvex সেট আপ সম্পূর্ণ হিসাবে চিহ্নিত করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiert die Lorvex-Einrichtung als abgeschlossen, optional mit Standardwerten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επισημάνετε τη ρύθμιση του Lorvex ως ολοκληρωμένη, με προαιρετικές προεπιλογές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark Lorvex setup complete with optional defaults."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca la configuración de Lorvex como completa, con valores predeterminados opcionales."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "علامت‌گذاری راه‌اندازی Lorvex به‌عنوان کامل، با پیش‌فرض‌های اختیاری."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque la configuration de Lorvex comme terminée, avec des valeurs par défaut facultatives."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סימון ההגדרה של Lorvex כהושלמה, עם ערכי ברירת מחדל אופציונליים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक डिफ़ॉल्ट के साथ Lorvex सेटअप को पूरा चिह्नित करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menandai penyiapan Lorvex selesai dengan nilai default opsional."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segna la configurazione di Lorvex come completata, con valori predefiniti facoltativi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexのセットアップを完了にし、必要に応じて既定値を設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 초기 설정을 완료로 표시하고 선택 사항인 기본값을 적용합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पर्यायी डिफॉल्टसह Lorvex सेटअप पूर्ण म्हणून चिन्हांकित करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menandakan persediaan Lorvex selesai dengan nilai lalai pilihan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeert de Lorvex-configuratie als voltooid, optioneel met standaardwaarden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznacza konfigurację Lorvex jako zakończoną, opcjonalnie z wartościami domyślnymi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca a configuração do Lorvex como concluída, com valores padrão opcionais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Marchează configurarea Lorvex drept finalizată, opțional cu valori implicite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помечает настройку Lorvex как завершённую; можно указать значения по умолчанию."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விருப்பத்தேர்வு இயல்புநிலைகளுடன் Lorvex அமைவை முடிந்ததாகக் குறிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఐచ్ఛిక డిఫాల్ట్‌లతో Lorvex సెటప్‌ను పూర్తయినట్లుగా మార్క్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำเครื่องหมายว่าการตั้งค่าเริ่มต้น Lorvex เสร็จแล้ว พร้อมระบุค่าเริ่มต้นได้ตามต้องการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex kurulumunu, isteğe bağlı saptanmış değerlerle birlikte tamamlandı olarak işaretleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначає налаштування Lorvex як завершене; за потреби можна вказати значення за умовчанням."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اختیاری ڈیفالٹس کے ساتھ Lorvex سیٹ اپ کو مکمل نشان زد کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh dấu hoàn tất thiết lập Lorvex với các giá trị mặc định tùy chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Lorvex 设置标记为完成，并可带上默认值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 Lorvex 初始設定標示為完成，並可選擇套用預設值。"
          }
        }
      }
    },
