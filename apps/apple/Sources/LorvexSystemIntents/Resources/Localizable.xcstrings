            "value": "Recapitularea zilnică pentru %@ a fost actualizată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Итоги дня за %@ обновлены."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ தேதிக்கான தினசரி மீள்பார்வை புதுப்பிக்கப்பட்டது."
