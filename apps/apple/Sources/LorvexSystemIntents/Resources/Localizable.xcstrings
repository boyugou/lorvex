    "system.task.parameter.tags_description": {
      "comment": "Description for comma, space, or newline separated tags",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوسوم مفصولة بفواصل أو مسافات أو أسطر جديدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কমা, স্পেস বা নতুন লাইন দিয়ে আলাদা করা ট্যাগ।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tags, durch Komma, Leerzeichen oder Zeilenumbruch getrennt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ετικέτες χωρισμένες με κόμμα, κενό ή νέα γραμμή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comma, space, or newline separated tags."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiquetas separadas por comas, espacios o saltos de línea."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برچسب‌ها، جداشده با ویرگول، فاصله یا خط جدید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tags séparés par des virgules, des espaces ou des retours à la ligne."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תגים מופרדים בפסיק, ברווח או בשורה חדשה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉमा, स्पेस या नई पंक्ति से अलग किए गए टैग।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Label dipisahkan koma, spasi, atau baris baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag separati da virgole, spazi o a capo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カンマ、スペース、または改行で区切ったタグ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쉼표, 공백 또는 줄 바꿈으로 구분한 태그."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वल्पविराम, स्पेस किंवा नवीन ओळीने वेगळे केलेले टॅग."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag dipisahkan dengan koma, ruang atau baris baharu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tags, gescheiden door komma’s, spaties of nieuwe regels."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagi rozdzielone przecinkiem, spacją lub nową linią."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiquetas separadas por vírgulas, espaços ou quebras de linha."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Taguri separate prin virgulă, spațiu sau rând nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теги через запятую, пробел или перенос строки."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காற்புள்ளி, ஸ்பேஸ் அல்லது புதிய வரியால் பிரிக்கப்பட்ட குறிச்சொற்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కామా, స్పేస్ లేదా కొత్త లైన్‌తో వేరు చేసిన ట్యాగ్‌లు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แท็กที่คั่นด้วยเครื่องหมายจุลภาค ช่องว่าง หรือการขึ้นบรรทัดใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Virgül, boşluk veya satır sonuyla ayrılmış etiketler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Теги через кому, пробіл або новий рядок."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹیگز، کوما، خالی جگہ یا نئی لائن سے الگ کیے ہوئے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thẻ được phân tách bằng dấu phẩy, dấu cách hoặc dòng mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用逗号、空格或换行分隔的标签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以逗號、空格或換行分隔的標籤。"
          }
        }
      }
    },
