    "system.diagnostics.read.description": {
      "comment": "Description for the Read Lorvex Diagnostics App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة تشخيصات الإعداد والمزامنة في Lorvex من الاختصارات أو Siri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Lorvex setup and sync diagnostics from Shortcuts or Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee el diagnóstico de configuración y sincronización de Lorvex desde Atajos o Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit les diagnostics de configuration et de synchronisation de Lorvex depuis Raccourcis ou Siri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट्स या Siri से Lorvex सेटअप और सिंक डायग्नोस्टिक पढ़ें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge la diagnostica di configurazione e sincronizzazione di Lorvex da Comandi rapidi o Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットまたはSiriで、Lorvexのセットアップと同期の診断情報を読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어 또는 Siri에서 Lorvex 설정 및 동기화 진단 정보를 읽습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytuje diagnostykę konfiguracji i synchronizacji Lorvex ze Skrótów lub Siri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê o diagnóstico de configuração e sincronização do Lorvex pelos Atalhos ou pela Siri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает диагностику настройки и синхронизации Lorvex из «Быстрых команд» или Siri."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читає діагностику налаштування й синхронізації Lorvex зі «Швидких команд» або Siri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“快捷指令”或 Siri 读取 Lorvex 设置和同步诊断。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過捷徑或 Siri 讀取 Lorvex 的設定與同步診斷資訊。"
          }
        }
      }
    },
    "system.diagnostics.read.dialog.complete": {
      "comment": "Diagnostics dialog when setup is complete; arguments are backend, pending count, and failed count",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتمل إعداد Lorvex. خدمة المزامنة: %1$@. قيد الانتظار: %2$lld، الفاشلة: %3$lld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex setup is complete. Sync backend: %1$@. Pending: %2$lld, failed: %3$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración de Lorvex está completa. Servicio de sincronización: %1$@. Pendientes: %2$lld, fallidos: %3$lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
