    "task_detail.picker.when.hint": {
      "comment": "iPhone task field sheet footer for the planned day.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اليوم الذي تخطط للعمل عليها فيه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The day you plan to work on it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El día en que planeas trabajar en ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jour où vous prévoyez d’y travailler."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह दिन जब आप इस पर काम करना चाहते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il giorno in cui prevedi di lavorarci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り組む予定の日です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하기로 계획한 날입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzień, w którym planujesz nad nim pracować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dia em que você planeja trabalhar nela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "День, в который вы планируете заняться задачей."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "День, коли ви плануєте над ним працювати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你打算做这件事的那一天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你打算處理它的日子。"
          }
        }
      }
    },
    "task_detail.picker.due.hint": {
      "comment": "iPhone task field sheet footer for the due day.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "آخر يوم لإنجازها."
