    "setup.sync.devices.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى مهامك وقوائمك وعاداتك متطابقة على Mac وiPhone وiPad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Aufgaben, Listen und Gewohnheiten bleiben auf deinem Mac, iPhone und iPad auf demselben Stand."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tasks, lists, and habits stay in step on your Mac, iPhone, and iPad."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus tareas, listas y hábitos se mantienen al día en el Mac, el iPhone y el iPad."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارها، فهرست‌ها و عادت‌های شما در Mac، iPhone و iPad هماهنگ می‌مانند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos tâches, listes et habitudes restent synchronisées sur votre Mac, votre iPhone et votre iPad."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשימות, הרשימות וההרגלים שלך נשארים מסונכרנים ב-Mac, ב-iPhone וב-iPad."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके कार्य, सूचियाँ और आदतें आपके Mac, iPhone और iPad पर एक जैसी रहती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue attività, liste e abitudini restano allineate su Mac, iPhone e iPad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスク、リスト、習慣は、Mac、iPhone、iPadで同じ状態に保たれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일, 목록, 습관이 Mac, iPhone, iPad에서 항상 동일하게 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je taken, lijsten en gewoontes blijven op je Mac, iPhone en iPad gelijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadania, listy i nawyki są takie same na Macu, iPhonie i iPadzie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas tarefas, listas e hábitos ficam em sincronia no seu Mac, iPhone e iPad."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarcinile, listele și obiceiurile se mențin sincronizate pe Mac, iPhone și iPad."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задачи, списки и привычки совпадают на вашем Mac, iPhone и iPad."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завдання, списки й звички збігаються на вашому Mac, iPhone та iPad."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے کام، فہرستیں اور عادات آپ کے Mac، iPhone اور iPad پر ہم آہنگ رہتی ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务、列表和习惯在 Mac、iPhone 和 iPad 上同步更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的任務、清單和習慣會在 Mac、iPhone 和 iPad 上保持同步。"
          }
        }
      }
    },
    "setup.sync.private.title": {
      "extractionState": "manual",
      "localizations": {
