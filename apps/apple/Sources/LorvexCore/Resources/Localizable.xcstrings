    "import.error.damaged": {
      "comment": "Shown when the file chosen for import is recognizably a Lorvex backup but its contents are inconsistent or incomplete.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه النسخة الاحتياطية تالفة ولا يمكن استيرادها. صدِّرها مرة أخرى على الجهاز الذي أُنشئت عليه، ثم حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Backup ist beschädigt und kann nicht importiert werden. Exportiere es erneut auf dem Gerät, von dem es stammt, und versuche es dann noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup is damaged and can’t be imported. Export it again on the device it came from, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia de seguridad está dañada y no se puede importar. Vuelve a exportarla en el dispositivo de origen e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این پشتیبان آسیب دیده است و وارد نمی‌شود. آن را دوباره در دستگاهی که از آن آمده صادر کنید و دوباره تلاش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sauvegarde est endommagée et ne peut pas être importée. Exportez-la à nouveau sur l’appareil d’origine, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגיבוי הזה פגום ולא ניתן לייבא אותו. יש לייצא אותו שוב מהמכשיר שממנו הגיע ולנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह बैकअप क्षतिग्रस्त है और इंपोर्ट नहीं किया जा सकता। जिस डिवाइस पर यह बना था, उस पर इसे दोबारा एक्सपोर्ट करें, फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo backup è danneggiato e non può essere importato. Esportalo di nuovo sul dispositivo di origine, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックアップは破損しているため読み込めません。元のデバイスで書き出し直してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 백업이 손상되어 가져올 수 없습니다. 원래 기기에서 다시 내보낸 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze back-up is beschadigd en kan niet worden geïmporteerd. Exporteer de back-up opnieuw op het apparaat waarvan deze afkomstig is en probeer het daarna opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta kopia zapasowa jest uszkodzona i nie można jej zaimportować. Wyeksportuj ją jeszcze raz na urządzeniu, z którego pochodzi, i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este backup está danificado e não pode ser importado. Exporte-o de novo no dispositivo de origem e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această copie de rezervă este deteriorată și nu poate fi importată. Exportați-o din nou de pe dispozitivul de la care provine, apoi încercați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта резервная копия повреждена и не может быть импортирована. Экспортируйте её ещё раз на исходном устройстве и повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця резервна копія пошкоджена, тому її не можна імпортувати. Експортуйте її ще раз на пристрої, де її створено, і спробуйте знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ بیک اپ خراب ہے اور امپورٹ نہیں ہو سکتا۔ اسے اسی ڈیوائس پر دوبارہ ایکسپورٹ کریں جہاں سے یہ آیا تھا، پھر دوبارہ کوشش کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此备份已损坏，无法导入。请在创建它的设备上重新导出，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此備份已損毀，無法匯入。請在原來的裝置上重新匯出，然後再試一次。"
          }
        }
      }
    },
