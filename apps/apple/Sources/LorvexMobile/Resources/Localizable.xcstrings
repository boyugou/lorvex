    "settings.calendar.access.full_details_detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم قراءة تفاصيل الأحداث كاملة، بما في ذلك العناوين والمواقع والملاحظات."
