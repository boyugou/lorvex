    "diagnostics.recent.empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تسجيل أي إخفاقات. ستظهر حالات التعطل والأخطاء هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো ব্যর্থতা রেকর্ড করা হয়নি। ক্র্যাশ ও ত্রুটি এখানে দেখা যাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Probleme aufgezeichnet. Abstürze und Fehler werden hier angezeigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχουν καταγραφεί αστοχίες. Οι καταρρεύσεις και τα σφάλματα εμφανίζονται εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No failures recorded. Crashes and errors appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay fallos registrados. Los cierres inesperados y los errores aparecerán aquí."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ خطایی ثبت نشده است. کرش‌ها و خطاها اینجا نمایش داده می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune défaillance enregistrée. Les fermetures inattendues et les erreurs apparaissent ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נרשמו כשלים. קריסות ושגיאות יופיעו כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई विफलता दर्ज नहीं हुई। क्रैश और त्रुटियाँ यहाँ दिखेंगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada kegagalan yang tercatat. Crash dan kesalahan muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun errore registrato. Arresti anomali ed errori appaiono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録された問題はありません。クラッシュやエラーはここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록된 문제가 없습니다. 충돌과 오류가 여기에 표시됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोणतेही अपयश नोंदवलेले नाही. क्रॅश आणि त्रुटी येथे दिसतील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada kegagalan direkodkan. Ranap dan ralat dipaparkan di sini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen problemen geregistreerd. Crashes en fouten verschijnen hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zarejestrowano problemów. Tutaj pojawiają się awarie i błędy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma falha registrada. Encerramentos inesperados e erros aparecem aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu a fost înregistrată nicio problemă. Închiderile neașteptate și erorile apar aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неполадок не зафиксировано. Здесь появляются сбои и ошибки."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தோல்விகள் எதுவும் பதிவாகவில்லை. செயலிழப்புகளும் பிழைகளும் இங்கே தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎలాంటి వైఫల్యాలు నమోదు కాలేదు. క్రాష్‌లు, ఎర్రర్‌లు ఇక్కడ కనిపిస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีความล้มเหลวที่บันทึกไว้ การขัดข้องและข้อผิดพลาดจะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilmiş hata yok. Çökmeler ve hatalar burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збоїв не зафіксовано. Тут з’являються аварії та помилки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی ناکامی ریکارڈ نہیں ہوئی۔ کریش اور خرابیاں یہاں نظر آتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa ghi nhận lỗi nào. Các lần sập ứng dụng và lỗi sẽ hiển thị tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未记录任何故障。崩溃和错误将显示在此处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有已記錄的問題。當機與錯誤會顯示在這裡。"
          }
        }
      }
    },
    "diagnostics.recent.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حالات التعطل واستثناءات الموارد التي يبلغ عنها النظام إلى Lorvex، بالإضافة إلى الأخطاء التي سجلها Lorvex بنفسه، الأحدث أولًا. اضغط على صف لعرض تفاصيله كاملة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিস্টেম Lorvex-কে যেসব ক্র্যাশ ও রিসোর্স এক্সেপশন জানায়, সেগুলি এবং Lorvex নিজে যেসব ত্রুটি রেকর্ড করেছে, নতুনগুলি আগে। পূর্ণ বিবরণ দেখতে একটি সারিতে ট্যাপ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abstürze und Ressourcenausnahmen, die das System an Lorvex meldet, sowie Fehler, die Lorvex selbst aufgezeichnet hat, die neuesten zuerst. Tippe auf eine Zeile, um alle Details zu sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καταρρεύσεις και εξαιρέσεις πόρων που αναφέρει το σύστημα στο Lorvex, μαζί με σφάλματα που κατέγραψε το ίδιο το Lorvex, με τα νεότερα πρώτα. Πατήστε μια γραμμή για να δείτε όλες τις λεπτομέρειες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crashes and resource exceptions the system reports to Lorvex, plus errors Lorvex recorded itself, newest first. Tap a row to see its full detail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierres inesperados y excepciones de recursos que el sistema notifica a Lorvex, además de los errores que Lorvex registró por su cuenta, del más reciente al más antiguo. Toca una fila para ver todos los detalles."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کرش‌ها و استثناهای منابع که سیستم به Lorvex گزارش می‌دهد، به‌علاوه خطاهایی که خود Lorvex ثبت کرده است، جدیدترین‌ها اول. برای دیدن جزئیات کامل، روی یک ردیف ضربه بزنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermetures inattendues et exceptions de ressources signalées par le système à Lorvex, ainsi que les erreurs que Lorvex a lui-même enregistrées, les plus récentes en premier. Touchez une ligne pour voir tous les détails."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קריסות וחריגות משאבים שהמערכת מדווחת ל-Lorvex, וגם שגיאות ש-Lorvex רשם בעצמו, החדשות ראשונות. יש להקיש על שורה כדי לראות את כל הפרטים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम द्वारा Lorvex को बताए गए क्रैश और रिसोर्स अपवाद, साथ ही Lorvex द्वारा खुद दर्ज की गई त्रुटियाँ, सबसे नई पहले। पूरा ब्योरा देखने के लिए किसी पंक्ति पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Crash dan pengecualian sumber daya yang dilaporkan sistem ke Lorvex, ditambah kesalahan yang dicatat Lorvex sendiri, dari yang terbaru. Ketuk baris untuk melihat detail lengkapnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arresti anomali ed eccezioni di risorse segnalati dal sistema a Lorvex, più gli errori registrati da Lorvex stesso, dal più recente. Tocca una riga per vederne tutti i dettagli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムからLorvexに報告されたクラッシュとリソース例外、およびLorvex自身が記録したエラーを、新しい順に表示します。行をタップすると詳細を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템이 Lorvex에 보고한 충돌과 리소스 예외, 그리고 Lorvex가 직접 기록한 오류를 최신순으로 표시합니다. 행을 탭하면 자세한 내용을 볼 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टीम Lorvex ला कळवते ते क्रॅश आणि रिसोर्स अपवाद, तसेच Lorvex ने स्वतः नोंदवलेल्या त्रुटी, नवीन आधी. संपूर्ण तपशील पाहण्यासाठी एका ओळीवर टॅप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ranap dan pengecualian sumber yang dilaporkan sistem kepada Lorvex, serta ralat yang direkodkan oleh Lorvex sendiri, yang terbaharu dahulu. Ketik baris untuk melihat butiran penuhnya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Crashes en resource-uitzonderingen die het systeem aan Lorvex meldt, plus fouten die Lorvex zelf heeft vastgelegd, nieuwste eerst. Tik op een rij om alle details te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Awarie i przekroczenia limitów zasobów zgłaszane przez system do Lorvex oraz błędy zapisane przez sam Lorvex, od najnowszych. Stuknij wiersz, aby zobaczyć wszystkie szczegóły."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerramentos inesperados e exceções de recursos que o sistema relata ao Lorvex, além de erros que o próprio Lorvex registrou, do mais recente ao mais antigo. Toque em uma linha para ver todos os detalhes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Închideri neașteptate și excepții de resurse raportate de sistem către Lorvex, plus erorile înregistrate chiar de Lorvex, cele mai recente primele. Atingeți un rând pentru a vedea toate detaliile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбои и превышения лимитов ресурсов, о которых система сообщает Lorvex, а также ошибки, записанные самим Lorvex, — сначала новые. Коснитесь строки, чтобы увидеть все подробности."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சிஸ்டம் Lorvexக்குத் தெரிவிக்கும் செயலிழப்புகள், ரிசோர்ஸ் எக்ஸெப்ஷன்கள், மேலும் Lorvex தானே பதிவுசெய்த பிழைகள், புதியவை முதலில். முழு விவரத்தைப் பார்க்க ஒரு வரிசையைத் தட்டவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సిస్టమ్ Lorvexకు నివేదించే క్రాష్‌లు, రిసోర్స్ ఎక్సెప్షన్‌లు, అలాగే Lorvex స్వయంగా నమోదు చేసిన ఎర్రర్‌లు, కొత్తవి మొదట. పూర్తి వివరాలను చూడటానికి ఒక వరుసను ట్యాప్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การขัดข้องและข้อยกเว้นด้านทรัพยากรที่ระบบรายงานให้ Lorvex รวมถึงข้อผิดพลาดที่ Lorvex บันทึกเอง เรียงจากใหม่สุด แตะแถวเพื่อดูรายละเอียดทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistemin Lorvex’e bildirdiği çökmeler ve kaynak istisnaları ile Lorvex’in kendi kaydettiği hatalar, en yeni en üstte. Tüm ayrıntıyı görmek için bir satıra dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аварії та перевищення лімітів ресурсів, про які система повідомляє Lorvex, а також помилки, записані самим Lorvex, — спочатку новіші. Торкніть рядок, щоб побачити всі подробиці."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سسٹم کی طرف سے Lorvex کو رپورٹ کیے گئے کریش اور وسائل کے استثنیٰ، نیز Lorvex کے اپنے ریکارڈ کردہ ایرر، تازہ ترین پہلے۔ مکمل تفصیل دیکھنے کے لیے کسی قطار پر ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các lần sập ứng dụng và ngoại lệ tài nguyên do hệ thống báo cho Lorvex, cùng các lỗi Lorvex tự ghi lại, mới nhất trước. Chạm vào một hàng để xem chi tiết đầy đủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统向 Lorvex 报告的崩溃和资源异常，以及 Lorvex 自己记录的错误，最新的排在前面。点按任意一行可查看完整详情。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統回報給 Lorvex 的當機與資源例外，以及 Lorvex 自行記錄的錯誤，依時間由新到舊排列。點一下任一列即可查看完整詳細資料。"
          }
        }
      }
    },
