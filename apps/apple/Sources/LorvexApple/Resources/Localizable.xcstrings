        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש ללחוץ על ＋ כדי להתחיל הרגל שרוצים לבנות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो आदत बनानी हो, उसे शुरू करने के लिए ＋ पर क्लिक करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su ＋ per iniziare un’abitudine che vuoi costruire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "＋をクリックして、身につけたい習慣を始めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "＋ 버튼을 클릭하여 만들고 싶은 습관을 시작하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op ＋ om te beginnen met een gewoonte die je wilt opbouwen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij ＋, aby zacząć budować nawyk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em ＋ para começar um hábito que você quer criar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Faceți clic pe ＋ pentru a începe un obicei pe care doriți să-l formați."
