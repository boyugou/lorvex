    "system.task.dependency.read.waiting_none_dialog": {
      "comment": "Siri dialog when no task depends on an unfinished task",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مهمة بانتظار مهمة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো টাস্ক অন্য টাস্কের অপেক্ষায় নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Aufgabe wartet auf eine andere."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καμία εργασία δεν περιμένει άλλη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No task is waiting on another."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna tarea depende de otra."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ کاری منتظر کار دیگری نیست."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune tâche ne dépend d’une autre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אף משימה לא ממתינה למשימה אחרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई कार्य किसी अन्य कार्य पर निर्भर नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada tugas yang menunggu tugas lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna attività dipende da un’altra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のタスクに依存しているタスクはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 할 일에 의존하는 할 일이 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोणतेही कार्य दुसऱ्या कार्यावर अवलंबून नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada tugas yang menunggu tugas lain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen enkele taak wacht op een andere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadne zadanie nie zależy od innego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma tarefa depende de outra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicio sarcină nu așteaptă o altă sarcină."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни одна задача не зависит от другой."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எந்தப் பணியும் வேறொரு பணிக்காகக் காத்திருக்கவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏ టాస్క్ కూడా మరో టాస్క్ కోసం వేచి లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีงานที่ต้องรองานอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir görevi bekleyen görev yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жодне завдання не залежить від іншого."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی کام کسی دوسرے کے انتظار میں نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có nhiệm vụ nào đang chờ nhiệm vụ khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有任务在等待其他任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有任務相依於其他任務。"
          }
        }
      }
    },
