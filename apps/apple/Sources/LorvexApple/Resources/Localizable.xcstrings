    "settings.data_import.preview.notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه هي السجلات التي يحتوي عليها هذا الملف. لن يُكتب أي شيء حتى تختار \"استيراد\"."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফাইলে থাকা রেকর্ডগুলি এখানে দেখানো হয়েছে। আপনি ইম্পোর্ট বেছে না নেওয়া পর্যন্ত কিছুই লেখা হয় না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies sind die Datensätze in dieser Datei. Es wird nichts geschrieben, bis du „Importieren“ wählst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτές είναι οι εγγραφές που περιέχει αυτό το αρχείο. Δεν γράφεται τίποτα μέχρι να επιλέξετε Εισαγωγή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are the records this file contains. Nothing is written until you choose Import."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos son los registros que contiene este archivo. No se escribe nada hasta que elijas Importar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این‌ها رکوردهای موجود در این فایل هستند. تا زمانی که «وارد کردن» را انتخاب نکنید چیزی نوشته نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voici les enregistrements que contient ce fichier. Rien n’est écrit tant que vous ne choisissez pas Importer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אלה הרשומות שבקובץ. דבר לא ייכתב עד לבחירה באפשרות \"ייבוא\"."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ाइल में ये रिकॉर्ड हैं। जब तक आप “इंपोर्ट करें” नहीं चुनते, कुछ भी नहीं लिखा जाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berikut rekaman yang ada di file ini. Tidak ada yang ditulis sampai Anda memilih Impor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi sono i record contenuti nel file. Non viene scritto nulla finché non scegli Importa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルに含まれるレコードです。「読み込む」を選択するまで、何も書き込まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일에 들어 있는 항목입니다. 가져오기를 선택하기 전에는 아무것도 기록되지 않습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या फाइलमध्ये असलेले रेकॉर्ड येथे दाखवले आहेत. तुम्ही इम्पोर्ट निवडेपर्यंत काहीही लिहिले जात नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini ialah rekod yang terdapat dalam fail ini. Tiada apa-apa ditulis sehingga anda memilih Import."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit zijn de records in dit bestand. Er wordt niets geschreven totdat je ‘Importeer’ kiest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To są rekordy zawarte w tym pliku. Nic nie jest zapisywane, dopóki nie wybierzesz „Importuj”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes são os registros contidos neste arquivo. Nada é gravado até você escolher Importar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acestea sunt înregistrările din acest fișier. Nu se scrie nimic până când alegeți „Importați”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вот записи, которые содержит этот файл. Ничего не записывается, пока вы не нажмёте «Импортировать»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் கோப்பில் உள்ள பதிவுகள் இவை. நீங்கள் இம்போர்ட் செய்யும் வரை எதுவும் எழுதப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫైల్‌లో ఉన్న రికార్డ్‌లు ఇవి. మీరు ఇంపోర్ట్ చేసే వరకు ఏదీ రాయబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือรายการที่ไฟล์นี้มีอยู่ จะยังไม่มีการเขียนข้อมูลจนกว่าคุณจะเลือกนำเข้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar bu dosyanın içerdiği kayıtlardır. İçe aktar düğmesini seçene kadar hiçbir şey yazılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ось записи, які містить цей файл. Нічого не записується, доки ви не виберете «Імпортувати»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ وہ ریکارڈز ہیں جو اس فائل میں موجود ہیں۔ جب تک آپ امپورٹ منتخب نہیں کرتے کچھ نہیں لکھا جاتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là các bản ghi có trong tệp này. Sẽ không có gì được ghi cho đến khi bạn chọn Nhập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些是此文件包含的记录。选择“导入”前不会写入任何数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些是此檔案包含的紀錄。在你選擇「匯入」之前，不會寫入任何內容。"
          }
        }
      }
    },
