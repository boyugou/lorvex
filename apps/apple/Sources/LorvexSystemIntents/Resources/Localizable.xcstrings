    "system.habit.reminder.update.title": {
      "comment": "Title of the App Intent that changes a habit reminder's time or turns it on or off",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحديث تذكير عادة في Lorvex"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex অভ্যাসের রিমাইন্ডার আপডেট করুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex-Gewohnheitserinnerung aktualisieren"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενημέρωση υπόμνησης συνήθειας Lorvex"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update Lorvex Habit Reminder"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizar recordatorio de hábito de Lorvex"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به‌روزرسانی یادآور عادت Lorvex"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre à jour un rappel d’habitude de Lorvex"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדכון תזכורת הרגל ב-Lorvex"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex आदत का रिमाइंडर अपडेट करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perbarui Pengingat Kebiasaan Lorvex"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna promemoria abitudine di Lorvex"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexの習慣のリマインダーを更新"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 습관 알림 업데이트"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex सवयीचा रिमाइंडर अपडेट करा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemas Kini Peringatan Tabiat Lorvex"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werk Lorvex-gewoonteherinnering bij"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaktualizuj przypomnienie dla nawyku Lorvex"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualizar lembrete de hábito do Lorvex"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizare memento obicei Lorvex"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновить напоминание для привычки Lorvex"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex பழக்க நினைவூட்டலைப் புதுப்பி"
          }
        },
        "te": {
