    "review.empty.not_loaded.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر الأنماط الأسبوعية بعد أن يجمع Lorvex نشاطًا كافيًا من المهام الأخيرة لتلخيصه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekly patterns appear after Lorvex has enough recent task activity to summarize."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los patrones semanales aparecen cuando Lorvex tiene suficiente actividad reciente de tareas que resumir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tendances hebdomadaires apparaissent quand Lorvex dispose d’assez d’activité récente sur les tâches pour la résumer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब Lorvex के पास सार निकालने लायक पर्याप्त हाल की कार्य गतिविधि होगी, तब साप्ताहिक पैटर्न यहाँ दिखेंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tendenze settimanali compaiono quando Lorvex ha abbastanza attività recenti da riassumere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexが集計できるだけの最近のタスクの動きがたまると、週ごとのパターンが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex가 요약할 만큼 최근 할 일 활동이 쌓이면 주간 패턴이 표시됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wzorce tygodnia pojawią się, gdy w Lorvex zbierze się wystarczająco dużo niedawnej aktywności związanej z zadaniami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os padrões semanais aparecem quando o Lorvex tem atividade recente suficiente nas tarefas para resumir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закономерности недели появятся, когда в Lorvex накопится достаточно недавней активности по задачам."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закономірності тижня з’являться, коли в Lorvex накопичиться достатньо нещодавньої активності із завданнями."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 Lorvex 有足够近期任务活动可总结时，每周模式会显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當 Lorvex 累積足夠的近期任務活動可供彙整後，就會顯示每週的規律。"
          }
        }
      }
    },
