    "widget.config.today.description": {
      "comment": "Description shown in the system widget configuration sheet for the Today widget",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر قائمة لعرض مهامها فقط."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a list to show only its tasks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una lista para ver solo sus tareas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فهرستی را انتخاب کنید تا فقط کارهای آن نمایش داده شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une liste pour n’afficher que ses tâches."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור רשימה כדי להציג רק את המשימות שלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ किसी एक सूची के कार्य दिखाने के लिए सूची चुनें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una lista per mostrare solo le sue attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストを選ぶと、そのリストのタスクだけを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록을 선택하면 해당 목록의 할 일만 표시됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz listę, aby pokazywać tylko jej zadania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma lista para mostrar somente as tarefas dela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите список, чтобы показывать только его задачи."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть список, щоб показувати лише його завдання."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف اس کے کام دکھانے کے لیے کوئی فہرست منتخب کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个列表，只显示其中的任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個清單，就只會顯示其中的任務。"
          }
        }
      }
