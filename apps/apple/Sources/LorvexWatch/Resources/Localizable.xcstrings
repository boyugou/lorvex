    "watch.error.snapshot_unavailable": {
      "comment": "Localized error description when the watch cannot load its Today snapshot; %@ is the localized recovery/status message for the fallback reason",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيانات الساعة غير متاحة: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch data unavailable: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos del reloj no disponibles: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données de la montre indisponibles : %@"
          }
