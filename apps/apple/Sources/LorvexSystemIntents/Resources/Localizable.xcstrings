    "system.calendar.search.description": {
      "comment": "Description for the Search Lorvex Calendar Events App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البحث في أحداث تقويم Lorvex من الاختصارات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শর্টকাট থেকে Lorvex ক্যালেন্ডার ইভেন্ট সার্চ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sucht Ereignisse im Lorvex-Kalender über Kurzbefehle."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναζητήστε γεγονότα ημερολογίου Lorvex από τις Συντομεύσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search Lorvex calendar events from Shortcuts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca eventos de calendario de Lorvex desde Atajos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "جست‌وجوی رویدادهای تقویم Lorvex از طریق میان‌برها."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche des événements du calendrier de Lorvex depuis Raccourcis."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חיפוש אירועי לוח השנה של Lorvex דרך קיצורי דרך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट्स से Lorvex कैलेंडर इवेंट खोजें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencari acara kalender Lorvex dari Pintasan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca eventi del calendario di Lorvex da Comandi rapidi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットでLorvexのカレンダーイベントを検索します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어에서 Lorvex 캘린더 이벤트를 검색합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट द्वारे Lorvex दिनदर्शिका इव्हेंट सर्च करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencari peristiwa kalendar Lorvex daripada Pintasan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoekt activiteiten in de Lorvex-agenda via Opdrachten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukuje wydarzenia kalendarza Lorvex ze Skrótów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca eventos do calendário do Lorvex pelos Atalhos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Caută evenimente în calendarul Lorvex prin Scurtături."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ищет события календаря Lorvex из «Быстрых команд»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்கவழிகள் மூலம் Lorvex கேலண்டர் நிகழ்வுகளைத் தேடவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "షార్ట్‌కట్స్ నుండి Lorvex క్యాలెండర్ ఇవెంట్‌లను శోధించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค้นหากิจกรรมปฏิทิน Lorvex จากคำสั่งลัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kestirmeler ile Lorvex takvim etkinliklerinde arama yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шукає події календаря Lorvex зі «Швидких команд»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شارٹ کٹس سے Lorvex کیلنڈر ایونٹس تلاش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm kiếm các sự kiện lịch Lorvex từ Phím tắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“快捷指令”搜索 Lorvex 日历事件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過捷徑搜尋 Lorvex 行事曆事件。"
          }
        }
      }
    },
