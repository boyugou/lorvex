        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak muncul di hari-hari Anda sampai saat itu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuori dalle tue giornate fino ad allora."
          }
        },
