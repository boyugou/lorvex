    "settings.sync.delete_cloud.confirm.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete iCloud Data"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除 iCloud 数据"
          }
        }
      }
    },
    "settings.sync.delete_cloud.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently removes all Lorvex data from your iCloud account, for every device that syncs with it. Data stored on this device stays intact. Sync stays off until you turn it back on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将从你的 iCloud 账户中永久移除所有 Lorvex 数据，对与其同步的所有设备生效。此设备上存储的数据保持不变。同步将保持关闭，直到你重新开启。"
          }
        }
      }
    },
    "settings.sync.delete_cloud.error.busy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud Sync is updating. Try again in a moment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云同步正在更新。请稍后重试。"
          }
        }
      }
    },
    "settings.sync.delete_cloud.error.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t finish deleting iCloud data (%@). Check your connection and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法完成删除 iCloud 数据（%@）。请检查网络连接后重试。"
          }
        }
      }
    },
    "settings.sync.delete_cloud.error.no_account": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No usable iCloud account. Sign in to iCloud and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可用的 iCloud 账户。请登录 iCloud 后重试。"
          }
        }
      }
    },
    "settings.sync.delete_cloud.error.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud sync isn’t available in this build."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本不支持 iCloud 同步。"
          }
        }
      }
    },
    "settings.sync.delete_cloud.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete every Lorvex record from your iCloud account — for all devices that sync with it. Data on this device is not touched. Sync turns off until you re-enable it, which re-uploads this device’s data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从你的 iCloud 账户中删除所有 Lorvex 记录——对与其同步的所有设备生效。此设备上的数据不受影响。同步将关闭，直到你重新启用；重新启用时会重新上传此设备的数据。"
          }
        }
      }
    },
    "settings.sync.delete_cloud.success": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex data was deleted from iCloud. Sync is now off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 数据已从 iCloud 中删除。同步现已关闭。"
          }
        }
      }
    },
    "settings.sync.delete_cloud.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete iCloud Data…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除 iCloud 数据…"
          }
        }
      }
    },
    "settings.sync.detail.off": {
      "comment": "Under the iCloud switch while sync is off.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tasks stay on this device. Turn this on to see the same tasks, lists, and habits on your other devices."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
