    "settings.mcp.helper_missing_detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع Lorvex العثور على برنامج MCP المساعد المدمج فيه. أعد تثبيت Lorvex من التنزيل الأصلي لاستعادته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex findet seinen integrierten MCP-Helfer nicht. Installiere Lorvex erneut aus dem ursprünglichen Download, um ihn wiederherzustellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex can’t find its built-in MCP helper. Reinstall Lorvex from the original download to restore it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex no encuentra su programa auxiliar MCP integrado. Vuelve a instalar Lorvex desde la descarga original para restaurarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه کمکی MCP داخلی Lorvex پیدا نشد. برای بازیابی آن، Lorvex را از دانلود اصلی دوباره نصب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex ne trouve pas son utilitaire MCP intégré. Réinstallez Lorvex depuis le téléchargement d’origine pour le restaurer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כלי העזר המובנה של MCP לא נמצא. יש להתקין מחדש את Lorvex מההורדה המקורית כדי לשחזר אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex को अपना बिल्ट-इन MCP हेल्पर नहीं मिल रहा। उसे बहाल करने के लिए Lorvex को मूल डाउनलोड से दोबारा इंस्टॉल करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex non trova l’helper MCP integrato. Reinstalla Lorvex dal download originale per ripristinarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LorvexのMCPヘルパーが見つかりません。元のダウンロードからLorvexを再インストールして復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 내장 MCP 도우미를 찾을 수 없습니다. 원래 다운로드한 파일로 Lorvex를 다시 설치하여 복원하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex kan zijn ingebouwde MCP-helper niet vinden. Installeer Lorvex opnieuw vanaf de oorspronkelijke download om de helper te herstellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex nie może znaleźć wbudowanej aplikacji pomocniczej MCP. Zainstaluj Lorvex ponownie z oryginalnego pobrania, aby ją przywrócić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lorvex não encontra o utilitário MCP integrado. Reinstale o Lorvex a partir do download original para restaurá-lo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex nu își găsește programul auxiliar MCP încorporat. Reinstalați Lorvex din descărcarea originală pentru a-l restaura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex не удаётся найти встроенную вспомогательную программу MCP. Переустановите Lorvex из исходной загрузки, чтобы восстановить её."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex не вдається знайти вбудовану допоміжну програму MCP. Перевстановіть Lorvex з оригінального завантаження, щоб відновити її."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بلٹ اِن MCP ہیلپر نہیں مل رہا۔ اسے بحال کرنے کے لیے Lorvex کو اصل ڈاؤن لوڈ سے دوبارہ انسٹال کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 找不到其内置的 MCP 帮助程序。请从原始下载重新安装 Lorvex 以恢复它。"
          }
        },
        "zh-Hant": {
