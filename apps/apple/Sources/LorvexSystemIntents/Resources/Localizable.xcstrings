    "system.status.setup.read.description": {
      "comment": "Description for the Read Lorvex Setup Status App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة حالة إعداد Lorvex من الاختصارات أو Siri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Lorvex setup status from Shortcuts or Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee el estado de configuración de Lorvex desde Atajos o Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit l’état de la configuration de Lorvex depuis Raccourcis ou Siri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट्स या Siri से Lorvex सेटअप की स्थिति पढ़ें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge lo stato della configurazione di Lorvex da Comandi rapidi o Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットまたはSiriでLorvexのセットアップ状況を読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어 또는 Siri에서 Lorvex 초기 설정 상태를 읽습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytuje stan konfiguracji Lorvex ze Skrótów lub Siri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê o status da configuração do Lorvex pelos Atalhos ou pela Siri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает состояние настройки Lorvex из «Быстрых команд» или Siri."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читає стан налаштування Lorvex зі «Швидких команд» або Siri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“快捷指令”或 Siri 读取 Lorvex 设置状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過捷徑或 Siri 讀取 Lorvex 初始設定狀態。"
          }
        }
      }
    },
    "system.status.setup.read.dialog.complete": {
      "comment": "Setup-status dialog when setup is complete; arguments are list count and task count",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتمل إعداد Lorvex. القوائم: %1$lld، المهام: %2$lld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex setup is complete. Lists: %1$lld, tasks: %2$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración de Lorvex está completa. Listas: %1$lld, tareas: %2$lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration de Lorvex est terminée. Listes : %1$lld, tâches : %2$lld."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex सेटअप पूरा है। सूचियाँ: %1$lld, कार्य: %2$lld।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La configurazione di Lorvex è completa. Liste: %1$lld, attività: %2$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexのセットアップは完了しています。リスト：%1$lld件、タスク：%2$lld件。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 초기 설정이 완료되었습니다. 목록 %1$lld개, 할 일 %2$lld개."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguracja Lorvex jest zakończona. Liczba list: %1$lld, zadań: %2$lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração do Lorvex está concluída. Listas: %1$lld, tarefas: %2$lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройка Lorvex завершена. Списков: %1$lld, задач: %2$lld."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштування Lorvex завершено. Списків: %1$lld, завдань: %2$lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 设置已完成。列表：%1$lld，任务：%2$lld。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 初始設定已完成。清單：%1$lld 個，任務：%2$lld 個。"
          }
        }
      }
    },
