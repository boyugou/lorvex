    "batch_cancel.plain_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم إلغاء المهام المحددة. يمكنك إعادة فتح كل منها على حدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্বাচিত টাস্কগুলি বাতিল করা হবে। প্রতিটি টাস্ক আপনি আলাদাভাবে আবার খুলতে পারবেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählten Aufgaben werden abgebrochen. Du kannst sie einzeln wieder öffnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι επιλεγμένες εργασίες θα ακυρωθούν. Μπορείτε να τις ανοίξετε ξανά μία προς μία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected tasks will be cancelled. You can reopen them individually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas seleccionadas se cancelarán. Puedes reabrirlas una por una."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارهای انتخاب‌شده لغو می‌شوند. می‌توانید هرکدام را جداگانه دوباره باز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches sélectionnées seront annulées. Vous pouvez les rouvrir une par une."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשימות שנבחרו יבוטלו. אפשר לפתוח כל אחת מחדש בנפרד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुने गए कार्य रद्द हो जाएँगे। आप उन्हें एक-एक करके फिर से खोल सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas yang dipilih akan dibatalkan. Anda dapat membukanya kembali satu per satu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le attività selezionate verranno annullate. Puoi riaprirle singolarmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したタスクがキャンセルされます。あとから個別に未完了に戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 할 일이 취소됩니다. 나중에 개별적으로 다시 열 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "निवडलेली कार्ये रद्द केली जातील. तुम्ही ती एक-एक करून पुन्हा उघडू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas yang dipilih akan dibatalkan. Anda boleh membukanya semula satu demi satu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De geselecteerde taken worden geannuleerd. Je kunt ze afzonderlijk heropenen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrane zadania zostaną anulowane. Możesz otworzyć każde z nich ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas selecionadas serão canceladas. Você pode reabri-las individualmente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarcinile selectate vor fi anulate. Le puteți redeschide individual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранные задачи будут отменены. Вы сможете открыть каждую из них снова."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேர்ந்தெடுத்த பணிகள் ரத்துசெய்யப்படும். ஒவ்வொன்றையும் தனித்தனியாக மீண்டும் திறக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎంచుకున్న టాస్క్‌లు రద్దు చేయబడతాయి. మీరు వాటిని ఒక్కొక్కటిగా మళ్ళీ తెరవవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานที่เลือกจะถูกยกเลิก คุณสามารถเปิดงานอีกครั้งได้ทีละงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili görevler iptal edilecek. Bunları tek tek yeniden açabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрані завдання буде скасовано. Ви зможете знову відкрити кожне з них."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب کام منسوخ کر دیے جائیں گے۔ آپ انہیں انفرادی طور پر دوبارہ کھول سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các nhiệm vụ đã chọn sẽ bị hủy. Bạn có thể mở lại từng nhiệm vụ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选任务将被取消。你可以单独重新打开它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選的任務將被取消。你可以之後個別重新開啟它們。"
          }
        }
      }
    },
