    "today.calm.schedule.empty": {
      "comment": "Schedule pane when there is nothing to draw",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد أحداث في التقويم ولا مهام لها وقت محدد بعد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing on the calendar and no timed work yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada en el calendario y aún no hay tareas con hora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien au calendrier et aucune tâche avec horaire pour l’instant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलेंडर में कुछ नहीं है और समय वाला कोई काम भी नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente in calendario e ancora nessuna attività con orario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーに予定はなく、時刻の決まったタスクもまだありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더에 일정이 없고, 시간이 정해진 할 일도 아직 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na razie brak wydarzeń w kalendarzu i zadań z godziną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada no calendário e nenhuma tarefa com horário ainda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нет ни событий в календаре, ни задач со временем."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки що немає ні подій у календарі, ні завдань із часом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日历上没有安排，也还没有定时的任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "行事曆上沒有事件，也還沒有排定時間的任務。"
          }
        }
      }
