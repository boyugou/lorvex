    "task_detail.ai_notes.empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد ملاحظات من الذكاء الاصطناعي بعد. يضيف مساعدك الملاحظات هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও কোনো AI নোট নেই। আপনার অ্যাসিস্ট্যান্ট এখানে নোট যোগ করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine KI-Notizen. Dein Assistent fügt hier Notizen hinzu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν ακόμη σημειώσεις AI. Ο βοηθός σας προσθέτει σημειώσεις εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No AI notes yet. Your assistant adds notes here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay notas de IA. Tu asistente las añade aquí."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز یادداشت هوش مصنوعی وجود ندارد. دستیار شما یادداشت‌ها را اینجا اضافه می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune note de l’IA pour l’instant. Votre assistant ajoute ses notes ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין אין הערות AI. העוזר שלך מוסיף כאן הערות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई AI नोट नहीं। आपका असिस्टेंट नोट यहाँ जोड़ता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada catatan AI. Asisten menambahkan catatan di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna nota dell’IA. Il tuo assistente aggiunge le note qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIのメモはまだありません。アシスタントがここにメモを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 AI 메모가 없습니다. 어시스턴트가 여기에 메모를 추가합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अजून AI नोट्स नाहीत. तुमचा सहाय्यक येथे नोट्स जोडतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada nota AI. Pembantu AI anda menambahkan nota di sini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen AI-notities. Je assistent voegt hier notities toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak notatek AI. Tutaj asystent dodaje notatki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma nota da IA ainda. Seu assistente adiciona notas aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu există notițe AI. Asistentul adaugă notițe aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заметок ИИ пока нет. Здесь ассистент добавляет заметки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีโน้ตจาก AI ผู้ช่วยของคุณจะเพิ่มโน้ตที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz yapay zekâ notu yok. Asistanınız notları buraya ekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нотаток ШІ ще немає. Тут асистент додає нотатки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی تک کوئی AI نوٹ نہیں۔ آپ کا اسسٹنٹ نوٹس یہاں شامل کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có ghi chú AI. Trợ lý sẽ thêm ghi chú tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有助手上下文。助手会在这里添加笔记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無 AI 備註。助理會在這裡新增備註。"
          }
        }
      }
    },
