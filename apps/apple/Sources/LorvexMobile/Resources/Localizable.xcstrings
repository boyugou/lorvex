          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронізація оновлюється. Повторіть спробу трохи пізніше."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کلاؤڈ سنک اپ ڈیٹ ہو رہا ہے۔ کچھ دیر بعد دوبارہ کوشش کریں۔"
          }
        },
        "zh-Hans": {
