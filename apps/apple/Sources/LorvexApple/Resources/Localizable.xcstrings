    "settings.cloud_delete.confirm.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete iCloud Data"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除 iCloud 数据"
          }
        }
      }
    },
    "settings.cloud_delete.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently removes all Lorvex data from your iCloud account, for every device that syncs with it. Data stored locally on this Mac stays intact. Sync stays off until you turn it back on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将从你的 iCloud 账户中永久移除所有 Lorvex 数据，对与其同步的所有设备生效。这台 Mac 上本地存储的数据保持不变。同步将保持关闭，直到你重新开启。"
          }
        }
      }
    },
    "settings.cloud_delete.confirm.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Lorvex data from iCloud everywhere?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要从 iCloud 中删除所有设备的 Lorvex 数据吗？"
          }
        }
      }
    },
    "settings.cloud_delete.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete every Lorvex record from your iCloud account — for all devices that sync with it. The local data on this Mac is not touched. iCloud sync turns off and stays off until you re-enable it, which re-uploads this Mac’s data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从你的 iCloud 账户中删除所有 Lorvex 记录——对与其同步的所有设备生效。这台 Mac 上的本地数据不受影响。iCloud 同步将关闭并保持关闭，直到你重新启用；重新启用时会重新上传这台 Mac 的数据。"
          }
        }
      }
    },
    "settings.cloud_delete.error.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t finish deleting iCloud data (%@). Check your connection and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法完成删除 iCloud 数据（%@）。请检查网络连接后重试。"
          }
        }
      }
    },
    "settings.cloud_delete.error.no_account": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No usable iCloud account. Sign in to iCloud and try again."
