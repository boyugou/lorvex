    "task_detail.checklist.empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف أول عنصر إلى قائمة التحقق لتقسيم هذه المهمة إلى خطوات ملموسة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই টাস্ককে সুনির্দিষ্ট ধাপে ভাগ করতে প্রথম চেকলিস্ট আইটেমটি যোগ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge den ersten Checklistenpunkt hinzu, um diese Aufgabe in konkrete Schritte aufzuteilen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε το πρώτο στοιχείο λίστας ελέγχου για να χωρίσετε αυτήν την εργασία σε συγκεκριμένα βήματα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the first checklist item to break this task into concrete steps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade el primer elemento de la lista de comprobación para dividir esta tarea en pasos concretos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اولین مورد چک‌لیست را اضافه کنید تا این کار به مراحل مشخص تقسیم شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez le premier élément de la liste de contrôle pour découper cette tâche en étapes concrètes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להוסיף את הפריט הראשון לרשימת התיוג כדי לפצל את המשימה לשלבים מוחשיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस कार्य को ठोस चरणों में बाँटने के लिए पहला चेकलिस्ट आइटम जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan item daftar centang pertama untuk memecah tugas ini menjadi langkah-langkah konkret."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi il primo elemento alla lista di controllo per suddividere questa attività in passaggi concreti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のチェックリスト項目を追加して、このタスクを具体的なステップに分けましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 체크리스트 항목을 추가하여 이 할 일을 구체적인 단계로 나눠 보세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या कार्याचे ठोस टप्पे करण्यासाठी पहिला तपासणी यादी आयटम जोडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
