    "system.task.pause.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف مهمة بدأ العمل عليها في Lorvex مؤقتًا. تبقى في يومها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুরু হওয়া একটি Lorvex টাস্ক পজ করুন। এটি নিজের দিনেই থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert eine gestartete Lorvex-Aufgabe. Sie bleibt auf ihrem Tag geplant."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέστε σε παύση μια εργασία Lorvex που έχει ξεκινήσει. Παραμένει στην ημέρα της."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause a started Lorvex task. It stays on its day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa una tarea de Lorvex iniciada. Se queda en su día."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مکث یک کار شروع‌شده در Lorvex. در همان روز باقی می‌ماند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met en pause une tâche de Lorvex démarrée. Elle reste à la même date."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השהיית משימה שהותחלה ב-Lorvex. היא נשארת ביום שלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू किया गया Lorvex कार्य रोकें। वह अपने दिन पर ही रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjeda tugas Lorvex yang sudah dimulai. Tugas tetap berada di harinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mette in pausa un’attività di Lorvex iniziata. Resta nel suo giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始したLorvexのタスクを一時停止します。タスクは同じ日のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작한 Lorvex 할 일을 일시 중지합니다. 할 일은 해당 날짜에 그대로 남습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरू झालेले एक Lorvex कार्य पॉज करा. ते त्याच्या दिवशीच राहते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjeda tugas Lorvex yang sudah dimulakan. Tugas kekal pada harinya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauzeert een gestarte Lorvex-taak. De taak blijft op dezelfde dag gepland."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymuje rozpoczęte zadanie Lorvex. Pozostaje ono zaplanowane na ten sam dzień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa uma tarefa do Lorvex iniciada. Ela continua no mesmo dia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspendă o sarcină Lorvex începută. Rămâne în ziua ei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приостанавливает начатую задачу Lorvex. Она остаётся запланированной на тот же день."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடங்கிய Lorvex பணியை இடைநிறுத்து. அது அதன் நாளிலேயே இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రారంభించిన Lorvex టాస్క్‌ను పాజ్ చేయండి. ఇది దాని రోజులోనే ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดพักงาน Lorvex ที่เริ่มแล้ว งานจะยังอยู่ในวันเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlatılmış bir Lorvex görevini duraklatın. Planlandığı günde kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Призупиняє розпочате завдання Lorvex. Воно залишається запланованим на той самий день."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شروع کیے گئے Lorvex کام کو موقوف کریں۔ یہ اپنے دن پر ہی رہتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạm dừng một nhiệm vụ Lorvex đã bắt đầu. Nhiệm vụ vẫn ở trong ngày của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停一个已开始的 Lorvex 任务，它仍留在原来的日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫停已開始的 Lorvex 任務。任務會保留在原本的日期。"
          }
        }
      }
    },
