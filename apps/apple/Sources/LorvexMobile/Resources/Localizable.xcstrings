          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入"
          }
        }
      }
    },
    "data_import.error.busy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما زالت عملية استيراد أو عملية بيانات أخرى قيد التنفيذ. انتظر حتى تنتهي، ثم حاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আরেকটি ইম্পোর্ট বা ডেটা অপারেশন এখনও চলছে। শেষ হওয়া পর্যন্ত অপেক্ষা করুন, তারপর আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Import oder Datenvorgang läuft noch. Warte, bis er abgeschlossen ist, und versuche es dann erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άλλη εισαγωγή ή λειτουργία δεδομένων εκτελείται ακόμη. Περιμένετε να ολοκληρωθεί και δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another import or data operation is still running. Wait for it to finish, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía hay otra importación u operación de datos en curso. Espera a que termine e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک وارد کردن یا عملیات داده دیگر هنوز در حال اجراست. منتظر پایان آن بمانید و دوباره تلاش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre importation ou opération sur les données est encore en cours. Attendez qu’elle se termine, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייבוא או פעולת נתונים אחרת עדיין פועלים. יש להמתין לסיומם ואז לנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई दूसरा इंपोर्ट या डेटा ऑपरेशन अभी चल रहा है। उसके पूरा होने तक रुकें, फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Impor atau operasi data lain masih berjalan. Tunggu hingga selesai, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’altra importazione o operazione sui dati è ancora in corso. Attendi che termini, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の読み込みまたはデータ操作がまだ実行中です。完了するまで待ってから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 가져오기 또는 데이터 작업이 아직 실행 중입니다. 완료될 때까지 기다린 후 다시 시도하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दुसरे इम्पोर्ट किंवा डेटा ऑपरेशन अजून सुरू आहे. ते पूर्ण होईपर्यंत थांबा आणि मग पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Import atau operasi data lain masih berjalan. Tunggu sehingga selesai, kemudian cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is nog een andere import of gegevensbewerking bezig. Wacht tot die klaar is en probeer het daarna opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inny import lub inna operacja na danych jest jeszcze w toku. Poczekaj na jej zakończenie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra importação ou operação de dados ainda está em andamento. Aguarde a conclusão e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un alt import sau o altă operațiune cu datele este încă în desfășurare. Așteptați să se termine, apoi încercați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другая операция импорта или обработки данных ещё выполняется. Дождитесь её завершения и повторите попытку."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மற்றொரு இம்போர்ட் அல்லது தரவுச் செயல்பாடு இன்னும் நடைபெறுகிறது. அது முடியும் வரை காத்திருந்து, மீண்டும் முயலவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మరో ఇంపోర్ట్ లేదా డేటా చర్య ఇంకా నడుస్తోంది. అది పూర్తయ్యే వరకు వేచి ఉండి, మళ్ళీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การนำเข้าหรือการดำเนินการกับข้อมูลอื่นยังทำงานอยู่ รอให้เสร็จก่อนแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir içe aktarma veya veri işlemi hâlâ çalışıyor. Bitmesini bekleyip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інша операція імпорту чи обробки даних ще триває. Зачекайте на її завершення й повторіть спробу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی دوسرا امپورٹ یا ڈیٹا آپریشن ابھی جاری ہے۔ اس کے ختم ہونے کا انتظار کریں، پھر دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một thao tác nhập hoặc dữ liệu khác vẫn đang chạy. Hãy đợi nó hoàn tất rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一项导入或数据操作仍在进行中。请等待其完成后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一項匯入或資料作業仍在進行中。請等待完成後再試一次。"
          }
        }
      }
    },
    "data_import.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استعد بياناتك من ملف تصدير JSON أو ZIP من Lorvex. سترى محتويات الملف قبل كتابة أي شيء. إعادة استيراد الملف نفسه لا تنشئ نسخًا مكررة أبدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex-এর JSON বা ZIP এক্সপোর্ট থেকে রিস্টোর করুন। কিছু লেখার আগে ফাইলে কী আছে তা আপনি দেখতে পাবেন। একই ফাইল আবার ইম্পোর্ট করলে কখনো ডুপ্লিকেট তৈরি হয় না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt Daten aus einem Lorvex-Export (JSON oder ZIP) wieder her. Du siehst, was die Datei enthält, bevor etwas geschrieben wird. Beim erneuten Import derselben Datei entstehen nie Duplikate."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαναφορά από εξαγωγή JSON ή ZIP του Lorvex. Θα δείτε τι περιέχει το αρχείο προτού γραφτεί οτιδήποτε. Η εκ νέου εισαγωγή του ίδιου αρχείου δεν δημιουργεί ποτέ διπλότυπα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore from a Lorvex JSON or ZIP export. You’ll see what the file contains before anything is written. Re-importing the same file never creates duplicates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura desde una exportación de Lorvex en JSON o ZIP. Verás lo que contiene el archivo antes de que se escriba nada. Volver a importar el mismo archivo nunca crea duplicados."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از یک خروجی JSON یا ZIP مربوط به Lorvex بازیابی کنید. پیش از نوشتن هر چیزی، محتوای فایل را می‌بینید. وارد کردن دوباره همان فایل هرگز موارد تکراری ایجاد نمی‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurez à partir d’une exportation JSON ou ZIP de Lorvex. Vous verrez le contenu du fichier avant que quoi que ce soit ne soit écrit. Réimporter le même fichier ne crée jamais de doublons."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שחזור מייצוא JSON או ZIP של Lorvex. לפני שייכתב משהו, יוצג תוכן הקובץ. ייבוא חוזר של אותו קובץ לא יוצר כפילויות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex के JSON या ZIP एक्सपोर्ट से रीस्टोर करें। कुछ भी लिखे जाने से पहले आप देख सकेंगे कि फ़ाइल में क्या है। एक ही फ़ाइल को दोबारा इंपोर्ट करने से डुप्लिकेट नहीं बनते।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulihkan dari ekspor JSON atau ZIP Lorvex. Isi file akan ditampilkan sebelum apa pun ditulis. Mengimpor ulang file yang sama tidak pernah membuat duplikat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina da un’esportazione JSON o ZIP di Lorvex. Vedrai cosa contiene il file prima che venga scritto qualsiasi dato. Reimportare lo stesso file non crea mai duplicati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LorvexのJSONまたはZIPの書き出しファイルから復元します。何かが書き込まれる前に、ファイルの内容を確認できます。同じファイルを読み込み直しても、重複は作成されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex JSON 또는 ZIP 내보내기 파일에서 복원합니다. 데이터가 기록되기 전에 파일 내용을 확인할 수 있습니다. 같은 파일을 다시 가져와도 중복이 생기지 않습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex च्या JSON किंवा ZIP एक्सपोर्टमधून रीस्टोअर करा. काहीही लिहिले जाण्यापूर्वी फाइलमध्ये काय आहे ते तुम्हाला दिसेल. तीच फाइल पुन्हा इम्पोर्ट केल्याने कधीही डुप्लिकेट तयार होत नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulihkan daripada eksport JSON atau ZIP Lorvex. Kandungan fail akan ditunjukkan sebelum apa-apa ditulis. Mengimport semula fail yang sama tidak pernah mencipta pendua."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstelt gegevens uit een Lorvex-export (JSON of ZIP). Je ziet wat het bestand bevat voordat er iets wordt geschreven. Hetzelfde bestand opnieuw importeren levert nooit duplicaten op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywróć dane z eksportu Lorvex w formacie JSON lub ZIP. Zanim cokolwiek zostanie zapisane, zobaczysz, co zawiera plik. Ponowny import tego samego pliku nigdy nie tworzy duplikatów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaure a partir de uma exportação JSON ou ZIP do Lorvex. Você verá o que o arquivo contém antes de qualquer coisa ser gravada. Importar o mesmo arquivo novamente nunca cria duplicatas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurează datele dintr-un export Lorvex (JSON sau ZIP). Veți vedea ce conține fișierul înainte de a se scrie ceva. Reimportarea aceluiași fișier nu creează niciodată dubluri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановите данные из экспорта Lorvex в формате JSON или ZIP. Прежде чем что-либо будет записано, вы увидите, что содержит файл. Повторный импорт того же файла никогда не создаёт дубликатов."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex JSON அல்லது ZIP எக்ஸ்போர்ட்டிலிருந்து மீட்டெடுக்கவும். எதுவும் எழுதப்படுவதற்கு முன் கோப்பில் என்ன உள்ளது என்பதைப் பார்ப்பீர்கள். அதே கோப்பை மீண்டும் இம்போர்ட் செய்தாலும் நகல்கள் உருவாகாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex JSON లేదా ZIP ఎక్స్‌పోర్ట్ నుండి పునరుద్ధరించండి. ఏదైనా రాసే ముందు ఫైల్‌లో ఏముందో మీకు కనిపిస్తుంది. అదే ఫైల్‌ను మళ్ళీ ఇంపోర్ట్ చేసినా డూప్లికేట్‌లు సృష్టించబడవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กู้คืนจากไฟล์ส่งออก JSON หรือ ZIP ของ Lorvex คุณจะเห็นเนื้อหาของไฟล์ก่อนที่จะมีการเขียนข้อมูลลงไป การนำเข้าไฟล์เดิมซ้ำจะไม่สร้างข้อมูลซ้ำซ้อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Lorvex JSON veya ZIP dışa aktarımından geri yükleyin. Hiçbir şey yazılmadan önce dosyanın içeriğini görürsünüz. Aynı dosyayı yeniden içe aktarmak asla yinelenen kayıt oluşturmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновіть дані з експорту Lorvex у форматі JSON або ZIP. Перш ніж щось буде записано, ви побачите, що містить файл. Повторний імпорт того самого файлу ніколи не створює дублікатів."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بحالی کے لیے Lorvex کی JSON یا ZIP ایکسپورٹ استعمال کریں۔ کچھ بھی لکھے جانے سے پہلے آپ کو فائل کا مواد نظر آئے گا۔ ایک ہی فائل دوبارہ امپورٹ کرنے سے کبھی ڈپلیکیٹ نہیں بنتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục từ bản xuất JSON hoặc ZIP của Lorvex. Nội dung tệp sẽ được hiển thị trước khi ghi bất cứ thứ gì. Nhập lại cùng một tệp không bao giờ tạo bản trùng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 Lorvex 的 JSON 或 ZIP 导出中恢复。在写入任何内容之前，你会看到文件包含的内容。重新导入同一文件绝不会创建重复项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從 Lorvex 的 JSON 或 ZIP 匯出檔復原。在寫入任何內容之前，你可以先查看檔案內容。重複匯入同一個檔案不會產生重複的項目。"
          }
        }
      }
    },
