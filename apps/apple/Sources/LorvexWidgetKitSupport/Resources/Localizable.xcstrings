          "stringUnit": {
            "state": "translated",
            "value": "आज के कार्य एक नज़र में देखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat tugas hari ini sekilas."
          }
