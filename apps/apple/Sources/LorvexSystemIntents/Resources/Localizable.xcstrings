    "system.tag.list.description": {
      "comment": "Description for the List Lorvex Tags App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض جميع وسوم مهام Lorvex من الاختصارات أو Siri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "List all Lorvex task tags from Shortcuts or Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra todas las etiquetas de tareas de Lorvex desde Atajos o Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste tous les tags de tâches de Lorvex depuis Raccourcis ou Siri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट्स या Siri से Lorvex के सभी कार्य टैग दिखाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elenca tutti i tag delle attività di Lorvex da Comandi rapidi o Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットまたはSiriでLorvexのタスクのタグをすべて一覧表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어 또는 Siri에서 Lorvex 할 일 태그를 모두 나열합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje wszystkie tagi zadań Lorvex ze Skrótów lub Siri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista todas as etiquetas de tarefas do Lorvex pelos Atalhos ou pela Siri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает все теги задач Lorvex из «Быстрых команд» или Siri."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує всі теги завдань Lorvex зі «Швидких команд» або Siri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“快捷指令”或 Siri 列出所有 Lorvex 任务标签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過捷徑或 Siri 列出所有 Lorvex 任務標籤。"
          }
        }
      }
