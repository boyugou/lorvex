    "system.task.dependency.read.description": {
      "comment": "Description for the Read Lorvex Task Dependencies App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة المهام غير المكتملة التي تنتظرها مهمة في Lorvex، أو، عند عدم اختيار مهمة، كل مهمة لا تزال تنتظر مهمة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো Lorvex টাস্ক যে অসম্পূর্ণ টাস্কগুলির উপর নির্ভর করে সেগুলি পড়ুন; কোনো টাস্ক না দিলে, অন্য টাস্কের অপেক্ষায় থাকা প্রতিটি টাস্ক পড়ুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest die unerledigten Aufgaben, auf die eine Lorvex-Aufgabe wartet, oder ohne Aufgabe alle Aufgaben, die noch auf eine andere warten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαβάστε τις ημιτελείς εργασίες από τις οποίες εξαρτάται μια εργασία Lorvex ή, χωρίς εργασία, κάθε εργασία που εξακολουθεί να περιμένει κάποια άλλη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the unfinished tasks a Lorvex task waits on, or, without a task, every task still waiting on another."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee las tareas pendientes de las que depende una tarea de Lorvex o, si no se elige ninguna, todas las tareas que aún dependen de otra."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خواندن کارهای ناتمامی که یک کار Lorvex منتظر آن‌هاست، یا بدون انتخاب کار، همه کارهایی که هنوز منتظر کار دیگری هستند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit les tâches à faire dont dépend une tâche de Lorvex ou, si aucune n’est choisie, toutes les tâches qui dépendent encore d’une autre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קריאת המשימות שלא הושלמו שמשימה ב-Lorvex ממתינה להן, או, ללא משימה, כל משימה שעדיין ממתינה למשימה אחרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex का कोई कार्य जिन लंबित कार्यों पर निर्भर है, उन्हें पढ़ें; या कार्य चुने बिना, वे सभी कार्य पढ़ें जो अब भी किसी अन्य कार्य पर निर्भर हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca tugas yang belum selesai dan ditunggu oleh sebuah tugas Lorvex, atau, tanpa tugas, semua tugas yang masih menunggu tugas lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge le attività da fare da cui dipende un’attività di Lorvex o, se non ne viene scelta nessuna, tutte le attività che dipendono ancora da un’altra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexのタスクが依存している未完了のタスクを読み取ります。タスクを指定しない場合は、まだ他のタスクに依存しているすべてのタスクを読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 할 일이 의존하는 미완료 할 일을 읽습니다. 할 일을 지정하지 않으면 아직 다른 할 일에 의존하는 모든 할 일을 읽습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एखादे Lorvex कार्य ज्या अपूर्ण कार्यांवर अवलंबून आहे ती वाचा; कार्य न दिल्यास, दुसऱ्या कार्याच्या प्रतीक्षेत असलेले प्रत्येक कार्य वाचा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca tugas belum selesai yang ditunggu oleh sesuatu tugas Lorvex, atau, tanpa tugas, setiap tugas yang masih menunggu tugas lain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest de onvoltooide taken waarop een Lorvex-taak wacht, of, zonder taak, alle taken die nog op een andere wachten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytuje zadania do zrobienia, od których zależy zadanie Lorvex, albo, jeśli nie wskazano zadania, wszystkie zadania, które nadal zależą od innego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê as tarefas pendentes das quais depende uma tarefa do Lorvex ou, se nenhuma for escolhida, todas as tarefas que ainda dependem de outra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Citește sarcinile nefinalizate pe care le așteaptă o sarcină Lorvex sau, fără o sarcină, toate sarcinile care încă așteaptă o altă sarcină."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает невыполненные задачи, от которых зависит задача Lorvex, или, если задача не выбрана, все задачи, которые всё ещё зависят от другой."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு Lorvex பணி காத்திருக்கும் முடிக்கப்படாத பணிகளைப் படிக்கவும்; பணி இல்லாவிட்டால், வேறொரு பணிக்காக இன்னும் காத்திருக்கும் ஒவ்வொரு பணியையும் படிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక Lorvex టాస్క్ దేని కోసం వేచి ఉందో ఆ పూర్తి కాని టాస్క్‌లను చదవండి; టాస్క్ ఇవ్వకపోతే, మరొక టాస్క్ కోసం ఇంకా వేచి ఉన్న ప్రతి టాస్క్‌ను చదవండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านงานที่ยังไม่เสร็จซึ่งงาน Lorvex ต้องรอ หรือหากไม่ระบุงาน จะอ่านงานทั้งหมดที่ยังรองานอื่นอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Lorvex görevinin beklediği bitmemiş görevleri veya görev seçilmezse başka bir göreve hâlâ bağımlı olan her görevi okuyun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читає невиконані завдання, від яких залежить завдання Lorvex, або, якщо завдання не вибрано, усі завдання, що досі залежать від іншого."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی Lorvex کام کے جن نامکمل کاموں کا انتظار ہے انہیں پڑھیں، یا کام کے بغیر وہ تمام کام جو ابھی کسی دوسرے کے انتظار میں ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc các nhiệm vụ chưa hoàn thành mà một nhiệm vụ Lorvex đang chờ, hoặc, nếu không chọn nhiệm vụ, mọi nhiệm vụ vẫn đang chờ nhiệm vụ khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取某项 Lorvex 任务正在等待的未完成任务；未选择任务时，读取所有仍在等待其他任务的任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取某個 Lorvex 任務相依的未完成任務；未選擇任務時，讀取所有仍相依於其他任務的任務。"
          }
        }
      }
    },
