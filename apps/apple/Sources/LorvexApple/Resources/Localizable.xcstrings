        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Lorvex δεν μπόρεσε να διαβάσει τα ημερολόγιά σας. Θα προσπαθήσει ξανά αυτόματα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex couldn’t read your calendars. It will try again automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex no pudo leer tus calendarios. Volverá a intentarlo automáticamente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه Lorvex نتوانست تقویم‌های شما را بخواند. به‌صورت خودکار دوباره تلاش می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex n’a pas pu lire vos calendriers. Il réessaiera automatiquement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפליקציית Lorvex לא הצליחה לקרוא את לוחות השנה שלך. היא תנסה שוב אוטומטית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex आपके कैलेंडर नहीं पढ़ सका। वह अपने आप फिर से कोशिश करेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex tidak dapat membaca kalender. Akan dicoba lagi secara otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex non è riuscito a leggere i tuoi calendari. Riproverà automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexはカレンダーを読み取れませんでした。自動的に再試行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex에서 캘린더를 읽을 수 없습니다. 자동으로 다시 시도합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या दिनदर्शिका वाचता आल्या नाहीत. पुन्हा प्रयत्न आपोआप केला जाईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex tidak dapat membaca kalendar. Ia akan mencuba semula secara automatik."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex kon je agenda’s niet lezen. Het wordt automatisch opnieuw geprobeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex nie mógł odczytać twoich kalendarzy. Spróbuje ponownie automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lorvex não conseguiu ler seus calendários. Ele tentará novamente automaticamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex nu a putut citi calendarele. Se va reîncerca automat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex не удалось прочитать ваши календари. Попытка будет повторена автоматически."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex อ่านปฏิทินของคุณไม่ได้ และจะลองอีกครั้งโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex takvimlerinizi okuyamadı. Otomatik olarak yeniden deneyecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex не вдалося прочитати ваші календарі. Спробу буде повторено автоматично."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے کیلنڈرز Lorvex نہیں پڑھ سکا۔ یہ خود بخود دوبارہ کوشش کرے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex không thể đọc lịch. Lorvex sẽ tự động thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 没能读取你的日历，稍后会自动重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 無法讀取你的行事曆，將會自動重試。"
          }
        }
      }
    },
    "settings.calendar.write_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يصل حدث حفظته في Lorvex إلى تقويمك. احفظه مرة أخرى لإعادة المحاولة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex-এ আপনার সেভ করা একটি ইভেন্ট আপনার ক্যালেন্ডারে পৌঁছায়নি। আবার চেষ্টা করতে সেটি আবার সেভ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein in Lorvex gesichertes Ereignis hat deinen Kalender nicht erreicht. Sichere es erneut, um es noch einmal zu versuchen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα γεγονός που αποθηκεύσατε στο Lorvex δεν έφτασε στο ημερολόγιό σας. Αποθηκεύστε το ξανά για να δοκιμάσετε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An event you saved in Lorvex didn’t reach your calendar. Save it again to retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un evento que guardaste en Lorvex no llegó a tu calendario. Vuelve a guardarlo para reintentar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رویدادی که در Lorvex ذخیره کردید به تقویم شما نرسید. برای تلاش دوباره، آن را دوباره ذخیره کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un événement enregistré dans Lorvex n’a pas atteint votre calendrier. Enregistrez-le à nouveau pour réessayer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אירוע ששמרת ב-Lorvex לא הגיע ללוח השנה שלך. אפשר לשמור אותו שוב כדי לנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex में सहेजा गया एक इवेंट आपके कैलेंडर तक नहीं पहुँचा। फिर से कोशिश करने के लिए उसे दोबारा सहेजें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Acara yang disimpan di Lorvex tidak sampai ke kalender. Simpan lagi untuk mencoba kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un evento salvato in Lorvex non è arrivato nel tuo calendario. Salvalo di nuovo per riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexで保存したイベントがカレンダーに反映されませんでした。もう一度保存して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex에서 저장한 이벤트가 캘린더에 반영되지 않았습니다. 다시 저장하여 재시도하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex मध्ये तुम्ही जतन केलेला एक इव्हेंट तुमच्या दिनदर्शिकेपर्यंत पोहोचला नाही. पुन्हा प्रयत्न करण्यासाठी तो पुन्हा जतन करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peristiwa yang disimpan dalam Lorvex tidak sampai ke kalendar. Simpan semula untuk mencuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een activiteit die je in Lorvex hebt bewaard, is niet in je agenda terechtgekomen. Bewaar de activiteit opnieuw om het nog eens te proberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydarzenie zapisane w Lorvex nie trafiło do twojego kalendarza. Zapisz je ponownie, aby spróbować jeszcze raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um evento que você salvou no Lorvex não chegou ao seu calendário. Salve-o novamente para tentar de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un eveniment salvat în Lorvex nu a ajuns în calendar. Salvați-l din nou pentru a reîncerca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Событие, сохранённое в Lorvex, не попало в ваш календарь. Сохраните его ещё раз, чтобы повторить попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กิจกรรมที่คุณบันทึกใน Lorvex ไม่ถึงปฏิทินของคุณ บันทึกอีกครั้งเพื่อลองใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex’te kaydettiğiniz bir etkinlik takviminize ulaşmadı. Yeniden denemek için etkinliği tekrar kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Подія, збережена в Lorvex, не потрапила до вашого календаря. Збережіть її ще раз, щоб повторити спробу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک ایونٹ جو آپ نے Lorvex میں محفوظ کیا تھا آپ کے کیلنڈر تک نہیں پہنچا۔ دوبارہ کوشش کے لیے اسے دوبارہ محفوظ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một sự kiện đã lưu trong Lorvex không đến được lịch. Hãy lưu lại để thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在 Lorvex 中保存的一个事件没能写入日历。再保存一次即可重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在 Lorvex 儲存的事件未能寫入行事曆。請重新儲存以再試一次。"
          }
        }
      }
    },
