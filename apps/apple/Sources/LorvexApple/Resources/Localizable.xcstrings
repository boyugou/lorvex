    "habit_detail.weekdays.empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر نمطك الأسبوعي هنا بعد أسبوعين من التسجيلات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দুই সপ্তাহের চেক-ইনের পর আপনার সাপ্তাহিক প্যাটার্ন এখানে দেখা যাবে।"
