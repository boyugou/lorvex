            "value": "یک آرشیو ZIP با یک فایل JSON برای هر دسته. Lorvex می‌تواند دوباره آن را وارد کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une archive ZIP contenant un fichier JSON par catégorie. Lorvex peut la réimporter."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ארכיון ZIP עם קובץ JSON אחד לכל קטגוריה. אפשר לייבא אותו שוב אל Lorvex."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ZIP आर्काइव, जिसमें हर श्रेणी की एक JSON फ़ाइल होती है। Lorvex इसे फिर से इंपोर्ट कर सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Arsip ZIP dengan satu file JSON per kategori. Lorvex dapat mengimpornya kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un archivio ZIP con un file JSON per categoria. Lorvex può importarlo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カテゴリごとに1つのJSONファイルを収めたZIPアーカイブです。Lorvexで再び読み込めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카테고리별로 JSON 파일 하나씩 담은 ZIP 보관 파일입니다. Lorvex에서 다시 가져올 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक श्रेणीसाठी एक JSON फाइल असलेली ZIP फाइल. Lorvex ती पुन्हा इम्पोर्ट करू शकते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkib ZIP dengan satu fail JSON bagi setiap kategori. Lorvex boleh mengimportnya semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een ZIP-archief met één JSON-bestand per categorie. Lorvex kan het weer importeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiwum ZIP z jednym plikiem JSON na kategorię. Lorvex może je ponownie zaimportować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um arquivo ZIP com um arquivo JSON por categoria. O Lorvex pode importá-lo novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O arhivă ZIP cu un fișier JSON pentru fiecare categorie. Lorvex o poate importa din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ZIP-архив с одним JSON-файлом на каждую категорию. Lorvex сможет снова его импортировать."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு வகைக்கும் ஒரு JSON கோப்பு கொண்ட ZIP காப்பகம். Lorvex இதை மீண்டும் இம்போர்ட் செய்யும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి విభాగానికి ఒక JSON ఫైల్‌తో కూడిన ZIP ఆర్కైవ్. Lorvex దీన్ని మళ్ళీ ఇంపోర్ట్ చేయగలదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ ZIP ที่มีไฟล์ JSON หนึ่งไฟล์ต่อหนึ่งหมวดหมู่ Lorvex นำเข้าได้อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her kategori için bir JSON dosyası içeren bir ZIP arşivi. Lorvex bunu yeniden içe aktarabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ZIP-архів з одним JSON-файлом для кожної категорії. Lorvex зможе знову його імпортувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک ZIP آرکائیو جس میں ہر زمرے کی ایک JSON فائل ہوتی ہے۔ Lorvex اسے دوبارہ امپورٹ کر سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một tệp lưu trữ ZIP với một tệp JSON cho mỗi danh mục. Lorvex có thể nhập lại tệp này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个 ZIP 压缩包，每个类别一个 JSON 文件。Lorvex 可以再次导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個 ZIP 封存檔，每個類別各含一個 JSON 檔案。Lorvex 可再次匯入。"
          }
        }
      }
    },
