    "review.empty.not_loaded.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر الأنماط الأسبوعية بعد أن يجمع Lorvex نشاطًا كافيًا من المهام الأخيرة لتلخيصه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex-এর কাছে সারসংক্ষেপ করার মতো যথেষ্ট সাম্প্রতিক টাস্ক অ্যাক্টিভিটি জমলে সাপ্তাহিক প্যাটার্ন এখানে দেখা যাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wochenmuster erscheinen, sobald Lorvex genug aktuelle Aufgabenaktivität zum Zusammenfassen hat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα εβδομαδιαία μοτίβα εμφανίζονται όταν το Lorvex έχει αρκετή πρόσφατη δραστηριότητα εργασιών για σύνοψη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekly patterns appear after Lorvex has enough recent task activity to summarize."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los patrones semanales aparecen cuando Lorvex tiene suficiente actividad reciente de tareas que resumir."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "الگوهای هفتگی وقتی نمایش داده می‌شوند که Lorvex فعالیت اخیر کافی در کارها برای خلاصه‌کردن داشته باشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tendances hebdomadaires apparaissent quand Lorvex dispose d’assez d’activité récente sur les tâches pour la résumer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דפוסים שבועיים יופיעו כשתהיה ל-Lorvex מספיק פעילות אחרונה במשימות לסיכום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब Lorvex के पास सार निकालने लायक पर्याप्त हाल की कार्य गतिविधि होगी, तब साप्ताहिक पैटर्न यहाँ दिखेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pola mingguan muncul setelah Lorvex memiliki cukup aktivitas tugas terbaru untuk dirangkum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tendenze settimanali compaiono quando Lorvex ha abbastanza attività recenti da riassumere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexが集計できるだけの最近のタスクの動きがたまると、週ごとのパターンが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex가 요약할 만큼 최근 할 일 활동이 쌓이면 주간 패턴이 표시됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सारांश तयार करण्यासाठी Lorvex कडे पुरेशी अलीकडील कार्य ॲक्टिव्हिटी जमा झाल्यावर साप्ताहिक पॅटर्न येथे दिसतील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Corak mingguan muncul selepas Lorvex mempunyai cukup aktiviti tugas terkini untuk diringkaskan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekpatronen verschijnen zodra Lorvex genoeg recente taakactiviteit heeft om samen te vatten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wzorce tygodnia pojawią się, gdy w Lorvex zbierze się wystarczająco dużo niedawnej aktywności związanej z zadaniami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os padrões semanais aparecem quando o Lorvex tem atividade recente suficiente nas tarefas para resumir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiparele săptămânale apar după ce Lorvex are suficientă activitate recentă cu sarcinile pentru a o rezuma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закономерности недели появятся, когда в Lorvex накопится достаточно недавней активности по задачам."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்கம் தர Lorvexஇல் போதுமான சமீபத்திய பணிச் செயல்பாடு இருக்கும்போது வாராந்தர பேட்டர்ன்கள் தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexలో సారాంశం ఇవ్వడానికి తగినంత ఇటీవలి టాస్క్ యాక్టివిటి ఉన్నప్పుడు వారంవారీ ప్యాటర్న్‌లు కనిపిస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปแบบรายสัปดาห์จะปรากฏเมื่อ Lorvex มีกิจกรรมของงานล่าสุดมากพอให้สรุป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex’in özetleyebileceği yeterli güncel görev etkinliği oluştuğunda haftalık örüntüler burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закономірності тижня з’являться, коли в Lorvex накопичиться достатньо нещодавньої активності із завданнями."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہفتہ وار پیٹرن اس وقت نظر آتے ہیں جب Lorvex کے پاس خلاصہ کرنے کے لیے کاموں کی کافی حالیہ سرگرمی ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các xu hướng hàng tuần sẽ xuất hiện khi Lorvex có đủ hoạt động nhiệm vụ gần đây để tóm tắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 Lorvex 有足够近期任务活动可总结时，每周模式会显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當 Lorvex 累積足夠的近期任務活動可供彙整後，就會顯示每週的規律。"
          }
        }
      }
    },
