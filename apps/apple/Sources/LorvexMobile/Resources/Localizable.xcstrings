        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitiş saati, başlangıç saatinden sonra olmalıdır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час завершення має бути пізніше за час початку"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اختتامی وقت آغاز کے وقت کے بعد ہونا چاہیے"
