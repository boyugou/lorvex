    "detached_window.placeholder.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر عنصرًا من النافذة الرئيسية، أو ربما تم حذفه على جهاز آخر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রধান উইন্ডো থেকে একটি আইটেম নির্বাচন করুন – অথবা সেটি অন্য ডিভাইসে ডিলিট হয়ে থাকতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle im Hauptfenster ein Objekt aus – oder es wurde möglicherweise auf einem anderen Gerät gelöscht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε ένα στοιχείο από το κύριο παράθυρο ή ίσως έχει διαγραφεί σε άλλη συσκευή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select an item from the main window — or it may have been deleted on another device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona un elemento en la ventana principal, o puede que se haya eliminado en otro dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک مورد را از پنجره اصلی انتخاب کنید — یا ممکن است در دستگاه دیگری حذف شده باشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un élément dans la fenêtre principale. Il a peut-être été supprimé sur un autre appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור פריט מהחלון הראשי — או שייתכן שהוא נמחק במכשיר אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुख्य विंडो से कोई आइटम चुनें — या हो सकता है उसे किसी दूसरे डिवाइस पर हटा दिया गया हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih item di jendela utama – atau item ini mungkin telah dihapus di perangkat lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona un elemento nella finestra principale oppure potrebbe essere stato eliminato su un altro dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メインウインドウで項目を選択してください。別のデバイスで削除された可能性もあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메인 윈도우에서 항목을 선택하세요. 다른 기기에서 삭제되었을 수도 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मुख्य विंडोमधून एखादा आयटम सिलेक्ट करा – किंवा तो दुसऱ्या डिव्हाइसवर हटवला गेला असू शकतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih item daripada tetingkap utama – atau item ini mungkin telah dipadam pada peranti lain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer een onderdeel in het hoofdvenster – of het is mogelijk op een ander apparaat verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz element w oknie głównym — lub mógł zostać usunięty na innym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione um item na janela principal ou ele pode ter sido excluído em outro dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Selectați un element în fereastra principală – sau este posibil să fi fost șters pe alt dispozitiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите элемент в главном окне — или он мог быть удалён на другом устройстве."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முதன்மைச் சாளரத்திலிருந்து ஒரு ஐட்டத்தைத் தேர்ந்தெடுக்கவும் – அல்லது அது வேறொரு சாதனத்தில் நீக்கப்பட்டிருக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రధాన విండో నుండి ఒక ఐటెమ్‌ను ఎంచుకోండి – లేదా దానిని మరొక డివైజ్‌లో డిలీట్ చేసి ఉండవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกรายการจากหน้าต่างหลัก หรืออาจถูกลบไปแล้วบนอุปกรณ์เครื่องอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana pencereden bir öğe seçin; ya da başka bir aygıtta silinmiş olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть елемент у головному вікні — або його могли видалити на іншому пристрої."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مرکزی ونڈو سے کوئی آئٹم منتخب کریں — یا ہو سکتا ہے اسے کسی دوسری ڈیوائس پر حذف کر دیا گیا ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một mục trong cửa sổ chính – hoặc mục này có thể đã bị xóa trên thiết bị khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在主窗口选择一个项目，或该项目可能已在另一台设备上删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在主視窗中選取一個項目；該項目也可能已在另一台裝置上被刪除。"
          }
        }
      }
    },
    "detached_window.placeholder.no_list_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تحديد قائمة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো তালিকা নির্বাচিত নেই"
          }
        },
        "de": {
          "stringUnit": {
