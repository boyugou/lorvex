    "widget.preview.briefing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مراجعة المواصفات هي الأهم اليوم؛ أما حجز الرحلات فيمكنه الانتظار حتى الخميس."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ স্পেক পর্যালোচনাই সবচেয়ে জরুরি; ফ্লাইটের বুকিং বৃহস্পতিবার পর্যন্ত অপেক্ষা করতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Prüfen der Spezifikation ist heute am wichtigsten; die Flüge können bis Donnerstag warten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ανασκόπηση των προδιαγραφών είναι το πιο σημαντικό σήμερα, ενώ οι πτήσεις μπορούν να περιμένουν μέχρι την Πέμπτη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The spec review matters most today; the flights can wait until Thursday."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy lo más importante es revisar la especificación; los vuelos pueden esperar hasta el jueves."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مرور مشخصات امروز از همه مهم‌تر است؛ رزرو پروازها می‌تواند تا پنجشنبه صبر کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La relecture des spécifications compte le plus aujourd’hui ; les vols peuvent attendre jeudi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סקירת המפרט היא החשובה ביותר היום; עם הטיסות אפשר להמתין עד יום חמישי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज सबसे ज़रूरी काम स्पेक की समीक्षा है; फ़्लाइट बुक करना गुरुवार तक रुक सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinjauan spesifikasi paling penting hari ini; tiket pesawat bisa menunggu hingga Kamis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La revisione delle specifiche è la cosa più importante oggi; i voli possono aspettare fino a giovedì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は仕様書のレビューがいちばん大切です。フライトの手配は木曜日まで待てます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 사양서 검토가 가장 중요합니다. 항공편 예약은 목요일까지 미뤄도 됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आज स्पेकचा आढावा सर्वात महत्त्वाचा आहे; फ्लाइटची बुकिंग गुरुवारपर्यंत थांबू शकते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semakan spesifikasi paling penting hari ini; penerbangan boleh menunggu hingga Khamis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het nakijken van de specificatie is vandaag het belangrijkst; de vluchten kunnen tot donderdag wachten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziś najważniejsze jest przejrzenie specyfikacji; loty mogą poczekać do czwartku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A revisão da especificação é o mais importante hoje; os voos podem esperar até quinta-feira."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificarea specificației este cel mai important lucru astăzi; zborurile pot aștepta până joi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня важнее всего проверить спецификацию; авиабилеты могут подождать до четверга."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันนี้การทบทวนข้อกำหนดสำคัญที่สุด ส่วนเที่ยวบินรอถึงวันพฤหัสบดีได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün en önemlisi teknik şartname incelemesi; uçuşlar Perşembe’ye kadar bekleyebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сьогодні найважливіше перевірити специфікацію; авіаквитки можуть почекати до четверга."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج تصریحات کا جائزہ سب سے اہم ہے؛ پروازوں کی بکنگ جمعرات تک رک سکتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôm nay việc xem lại đặc tả quan trọng nhất; vé máy bay có thể để đến thứ Năm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天最要紧的是审阅规格，机票可以等到周四再订。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天最重要的是審閱規格書，訂機票可以等到星期四。"
          }
        }
