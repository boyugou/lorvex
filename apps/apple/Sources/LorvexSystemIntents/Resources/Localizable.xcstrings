{
  "sourceLanguage": "en",
  "strings": {
    "system.calendar.create.description": {
      "comment": "Description for the Create Lorvex Calendar Event App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنشاء حدث تقويم Lorvex من الاختصارات أو Siri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a Lorvex calendar event from Shortcuts or Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un evento de calendario de Lorvex desde Atajos o Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée un événement du calendrier de Lorvex depuis Raccourcis ou Siri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट्स या Siri से Lorvex कैलेंडर इवेंट बनाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un evento del calendario di Lorvex da Comandi rapidi o Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットまたはSiriでLorvexのカレンダーイベントを作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어 또는 Siri에서 Lorvex 캘린더 이벤트를 만듭니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tworzy wydarzenie kalendarza Lorvex ze Skrótów lub Siri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria um evento do calendário do Lorvex pelos Atalhos ou pela Siri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создаёт событие календаря Lorvex из «Быстрых команд» или Siri."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створює подію календаря Lorvex зі «Швидких команд» або Siri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“快捷指令”或 Siri 创建一个 Lorvex 日历事件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過捷徑或 Siri 建立 Lorvex 行事曆事件。"
          }
        }
      }
    },
    "system.calendar.create.dialog": {
      "comment": "Dialog after creating a calendar event; first %@ is event title and second %@ is start date",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إنشاء حدث التقويم %@ بتاريخ %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Created calendar event %@ for %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se creó el evento “%1$@” para %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Événement du calendrier « %@ » créé pour le %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ के लिए कैलेंडर इवेंट “%1$@” बनाया गया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evento del calendario “%@” creato per il %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーイベント「%@」を%@に作成しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 캘린더 이벤트를 %@에 만들었습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utworzono wydarzenie kalendarza „%@” na %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Evento do calendário “%@” criado para %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создано событие календаря «%@» на %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створено подію календаря «%@» на %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已为 %2$@ 创建日历事件“%1$@”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已建立行事曆事件「%@」，開始時間：%@。"
          }
        }
      }
    },
