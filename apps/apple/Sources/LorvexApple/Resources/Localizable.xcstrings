          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开同步后才会检查 iCloud。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟同步後，才會檢查 iCloud。"
