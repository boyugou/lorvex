        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El día en que planeas trabajar en ella."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روزی که قصد دارید روی آن کار کنید."
