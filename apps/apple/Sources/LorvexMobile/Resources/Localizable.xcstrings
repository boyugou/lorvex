    "settings.calendar.access.off_detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتم قراءة أي أحداث تقويم في Lorvex."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No calendar events are read into Lorvex."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex no lee ningún evento de calendario."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ رویداد تقویمی در Lorvex خوانده نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun événement du calendrier n’est lu dans Lorvex."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נקראים אירועי לוח שנה אל Lorvex."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई कैलेंडर इवेंट Lorvex में नहीं पढ़ा जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun evento del calendario viene letto in Lorvex."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーイベントはLorvexに読み込まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 이벤트를 Lorvex로 읽어 오지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydarzenia z kalendarza nie są odczytywane w Lorvex."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum evento do calendário é lido no Lorvex."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "События календаря не считываются в Lorvex."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Події календаря не зчитуються в Lorvex."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی کیلنڈر ایونٹ Lorvex میں نہیں پڑھا جاتا۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会将日历事件读入 Lorvex。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會將行事曆事件讀取到 Lorvex 中。"
          }
        }
      }
    },
    "settings.calendar.access.scope_detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينطبق على ما يمكن لـ Lorvex والمساعدين المتصلين رؤيته على هذا الجهاز."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to what Lorvex and connected assistants can see on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a lo que Lorvex y los asistentes conectados pueden ver en este dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای آنچه Lorvex و دستیارهای متصل در این دستگاه می‌توانند ببینند اعمال می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique à ce que Lorvex et les assistants connectés peuvent voir sur cet appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חל על מה ש-Lorvex והעוזרים המחוברים יכולים לראות במכשיר זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह इस पर लागू होता है कि इस डिवाइस पर Lorvex और जुड़े हुए असिस्टेंट क्या देख सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si applica a ciò che Lorvex e gli assistenti connessi possono vedere su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定は、このデバイス上でLorvexと接続済みのアシスタントが見られる内容に適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 Lorvex와 연결된 어시스턴트가 볼 수 있는 내용에 적용됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Określa, co Lorvex i połączeni asystenci mogą widzieć na tym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se ao que o Lorvex e os assistentes conectados podem ver neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Определяет, что Lorvex и подключённые ассистенты могут видеть на этом устройстве."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Визначає, що Lorvex і підключені асистенти можуть бачити на цьому пристрої."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ اس پر لاگو ہوتا ہے جو Lorvex اور منسلک اسسٹنٹس اس ڈیوائس پر دیکھ سکتے ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于 Lorvex 和已连接的助手可在此设备上看到的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適用於 Lorvex 與已連接的助理在此裝置上能看到的內容。"
          }
        }
      }
    },
    "settings.calendar.access_denied": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى التقويم متوقف. افتح الإعدادات للسماح لـ Lorvex بقراءة تقويمات الجهاز."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar access is off. Open Settings to allow Lorvex to read device calendars."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso al calendario está desactivado. Abre Ajustes para permitir que Lorvex lea los calendarios del dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به تقویم خاموش است. برای اینکه Lorvex بتواند تقویم‌های دستگاه را بخواند، تنظیمات را باز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au calendrier est désactivé. Ouvrez les réglages pour autoriser Lorvex à lire les calendriers de l’appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגישה ללוח השנה כבויה. יש לפתוח את ההגדרות כדי לאפשר ל-Lorvex לקרוא את לוחות השנה במכשיר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलेंडर एक्सेस बंद है। Lorvex को डिवाइस के कैलेंडर पढ़ने देने के लिए सेटिंग्ज़ खोलें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso al calendario è disattivato. Apri Impostazioni per consentire a Lorvex di leggere i calendari del dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーへのアクセスがオフです。「設定」を開いて、Lorvexがデバイスのカレンダーを読み取れるようにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 접근이 꺼져 있습니다. 설정을 열어 Lorvex가 기기 캘린더를 읽을 수 있도록 허용하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do kalendarza jest wyłączony. Otwórz Ustawienia, aby zezwolić Lorvex na odczyt kalendarzy urządzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao calendário está desativado. Abra os Ajustes para permitir que o Lorvex leia os calendários do dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к календарю выключен. Откройте Настройки, чтобы разрешить Lorvex читать календари устройства."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до календаря вимкнено. Відкрийте Параметри, щоб дозволити Lorvex читати календарі пристрою."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیلنڈر تک رسائی بند ہے۔ Lorvex کو ڈیوائس کے کیلنڈرز پڑھنے کی اجازت دینے کے لیے ترتیبات کھولیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日历访问权限已关闭。打开设置以允许 Lorvex 读取设备日历。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "行事曆存取權限已關閉。請開啟「設定」，允許 Lorvex 讀取裝置行事曆。"
          }
        }
      }
    },
