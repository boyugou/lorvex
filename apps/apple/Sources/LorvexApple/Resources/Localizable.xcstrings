    "task_detail.ai_notes.clear_confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى إزالة السياق الذي يحتفظ به المساعد لهذه المهمة. لا يتغير نص المهمة ولا سجل النشاط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird der vom Assistenten gepflegte Kontext dieser Aufgabe entfernt. Der Aufgabentext und der Aktivitätsverlauf bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the assistant-maintained context for this task. The task body and activity history are unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina el contexto que mantiene el asistente para esta tarea. El cuerpo de la tarea y el historial de actividad no cambian."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زمینه‌ای که دستیار برای این کار نگه می‌دارد حذف می‌شود. متن کار و تاریخچه فعالیت بدون تغییر می‌مانند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime le contexte géré par l’assistant pour cette tâche. Le contenu de la tâche et l’historique d’activité restent inchangés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההקשר שהעוזר מתחזק למשימה זו יוסר. גוף המשימה והיסטוריית הפעילות לא ישתנו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे इस कार्य का असिस्टेंट द्वारा रखा गया संदर्भ हट जाता है। कार्य के नोट और गतिविधि का इतिहास नहीं बदलते।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione rimuove il contesto gestito dall’assistente per questa attività. Il contenuto dell’attività e la cronologia delle attività restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタスクについてアシスタントが管理しているコンテキストを削除します。タスクの本文とアクティビティ履歴は変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 할 일에 대해 어시스턴트가 관리하는 컨텍스트를 제거합니다. 할 일 본문과 활동 기록은 변경되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt de door de assistent bijgehouden context van deze taak verwijderd. De inhoud van de taak en de activiteitengeschiedenis blijven ongewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie kontekstu tego zadania prowadzonego przez asystenta. Treść zadania i historia aktywności pozostaną bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove o contexto mantido pelo assistente para esta tarefa. O conteúdo da tarefa e o histórico de atividades permanecem inalterados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această acțiune elimină contextul gestionat de asistent pentru această sarcină. Conținutul sarcinii și istoricul activității rămân neschimbate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будет удалён контекст этой задачи, который ведёт ассистент. Текст задачи и история действий не изменятся."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Буде видалено контекст цього завдання, який веде асистент. Основний текст завдання та історія дій не зміняться."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کام کے لیے اسسٹنٹ کا رکھا ہوا سیاق ہٹا دیا جائے گا۔ کام کا متن اور سرگرمی کی تاریخچہ جوں کے توں رہتے ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会移除助手为这项任务维护的上下文。任务正文和活动记录保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會移除助理為此任務維護的背景資訊。任務內容與活動記錄不會變動。"
          }
        }
      }
    },
