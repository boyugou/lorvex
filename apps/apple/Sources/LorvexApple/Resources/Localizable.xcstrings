          "stringUnit": {
            "state": "translated",
            "value": "এই টাস্ক ক্যালেন্ডারে যোগ করার আগে একটি প্ল্যান করা তারিখ যোগ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege ein Plandatum fest, bevor du diese Aufgabe zum Kalender hinzufügst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε μια προγραμματισμένη ημερομηνία πριν προσθέσετε αυτήν την εργασία στο Ημερολόγιο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a planned date before adding this task to Calendar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una fecha planificada antes de añadir esta tarea al calendario."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از افزودن این کار به تقویم، یک تاریخ برنامه‌ریزی اضافه کنید."
          }
        },
        "fr": {
          "stringUnit": {
