    "error.database_newer": {
      "comment": "Shown when the database was written by a newer version of Lorvex than the one running.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إنشاء قاعدة البيانات هذه بواسطة إصدار أحدث من Lorvex. يُرجى تحديث Lorvex لفتحها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datenbank wurde mit einer neueren Version von Lorvex erstellt. Bitte aktualisiere Lorvex, um sie zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This database was created by a newer version of Lorvex. Please update Lorvex to open it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta base de datos la creó una versión más reciente de Lorvex. Actualiza Lorvex para abrirla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این پایگاه‌داده با نسخه‌ای جدیدتر از Lorvex ایجاد شده است. برای باز کردن آن، Lorvex را به‌روزرسانی کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette base de données a été créée par une version plus récente de Lorvex. Mettez à jour Lorvex pour l’ouvrir."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסד הנתונים הזה נוצר בגרסה חדשה יותר של Lorvex. יש לעדכן את Lorvex כדי לפתוח אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डेटाबेस Lorvex के नए संस्करण में बना था। इसे खोलने के लिए कृपया Lorvex अपडेट करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo database è stato creato da una versione più recente di Lorvex. Aggiorna Lorvex per aprirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデータベースは、より新しいバージョンのLorvexで作成されました。開くにはLorvexをアップデートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 데이터베이스는 더 새로운 버전의 Lorvex에서 만들어졌습니다. 열려면 Lorvex를 업데이트하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze database is gemaakt met een nieuwere versie van Lorvex. Werk Lorvex bij om de database te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta baza danych została utworzona przez nowszą wersję Lorvex. Zaktualizuj Lorvex, aby ją otworzyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este banco de dados foi criado por uma versão mais recente do Lorvex. Atualize o Lorvex para abri-lo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această bază de date a fost creată cu o versiune mai nouă a Lorvex. Actualizați Lorvex pentru a o deschide."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта база данных создана более новой версией Lorvex. Обновите Lorvex, чтобы открыть её."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю базу даних створено новішою версією Lorvex. Оновіть Lorvex, щоб відкрити її."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ڈیٹابیس Lorvex کے نئے ورژن سے بنایا گیا تھا۔ اسے کھولنے کے لیے براہ کرم Lorvex اپ ڈیٹ کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此数据库由较新版本的 Lorvex 创建。请更新 Lorvex 以打开它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此資料庫是由較新版本的 Lorvex 建立的。請更新 Lorvex 才能開啟。"
          }
        }
      }
    },
    "error.generic": {
      "comment": "Shown when an action failed for a reason that may go away if the person tries again.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خطأ ما. يُرجى المحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas ist schiefgelaufen. Bitte versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo salió mal. Inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مشکلی پیش آمد. لطفاً دوباره تلاش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une erreur s’est produite. Veuillez réessayer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משהו השתבש. יש לנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ गड़बड़ हो गई। कृपया फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si è verificato un errore. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題が発生しました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제가 발생했습니다. 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is iets misgegaan. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coś poszło nie tak. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo deu errado. Tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceva nu a funcționat corect. Încercați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что-то пошло не так. Повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щось пішло не так. Повторіть спробу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کچھ غلط ہو گیا۔ براہ کرم دوبارہ کوشش کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出了点问题，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發生了問題，請再試一次。"
          }
        }
      }
    },
    "error.item_gone": {
