    "data_import.background.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستمر الاستيراد في العمل إذا أغلقت هذه الشاشة. وإذا لم يكتمل، فتحقق من اتصالك بالإنترنت."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The import keeps running if you close this. If it doesn’t finish, check your internet connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La importación continúa si cierras esta pantalla. Si no termina, comprueba tu conexión a internet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’importation se poursuit si vous fermez cette fenêtre. Si elle ne se termine pas, vérifiez votre connexion internet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे बंद करने पर भी इंपोर्ट चलता रहेगा। अगर यह पूरा न हो, तो अपना इंटरनेट कनेक्शन जाँचें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’importazione continua anche se chiudi questa schermata. Se non termina, controlla la connessione a internet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じても読み込みは続行されます。完了しない場合は、インターネット接続を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면을 닫아도 가져오기는 계속 진행됩니다. 완료되지 않으면 인터넷 연결을 확인하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Import będzie trwał, nawet jeśli zamkniesz ten ekran. Jeśli się nie zakończy, sprawdź połączenie z internetem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A importação continua se você fechar esta tela. Se ela não terminar, verifique sua conexão com a internet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импорт продолжится, даже если вы закроете этот экран. Если он не завершится, проверьте подключение к интернету."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імпорт триватиме, навіть якщо ви закриєте цей екран. Якщо він не завершиться, перевірте підключення до інтернету."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭此界面后导入会继续。如果一直没完成，请检查网络连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使關閉此畫面，匯入仍會繼續。若未能完成，請檢查你的網際網路連線。"
          }
        }
      }
    },
