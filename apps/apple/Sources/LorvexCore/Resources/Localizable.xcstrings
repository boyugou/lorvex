        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο τίτλος είναι πολύ μεγάλος. Συντομεύστε τον και δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This title is too long. Shorten it and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este título es demasiado largo. Acórtalo e inténtalo de nuevo."
