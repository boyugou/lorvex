    "habits.detail.momentum.a11y": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقدم الفترة %1$lld من %2$lld، السلسلة الحالية %3$lld، أفضل سلسلة %4$lld"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সময়কালের অগ্রগতি %2$lldটির মধ্যে %1$lldটি, বর্তমান ধারা %3$lld, সেরা ধারা %4$lld"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortschritt im Zeitraum %1$lld von %2$lld, aktuelle Serie %3$lld, beste Serie %4$lld"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρόοδος περιόδου %1$lld από %2$lld, τρέχον σερί %3$lld, καλύτερο σερί %4$lld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Period progress %1$lld of %2$lld, current streak %3$lld, best streak %4$lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Progreso del periodo %1$lld de %2$lld, racha actual %3$lld, mejor racha %4$lld"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیشرفت دوره: %1$lld از %2$lld، زنجیره فعلی %3$lld، بهترین زنجیره %4$lld"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Progression de la période : %1$lld sur %2$lld, série en cours : %3$lld, meilleure série : %4$lld"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התקדמות התקופה: %1$lld מתוך %2$lld, הרצף הנוכחי %3$lld, הרצף הטוב ביותר %4$lld"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अवधि की प्रगति: %2$lld में से %1$lld, मौजूदा स्ट्रीक %3$lld, सबसे लंबी स्ट्रीक %4$lld"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemajuan periode %1$lld dari %2$lld, rekor saat ini %3$lld, rekor terbaik %4$lld"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Progresso del periodo: %1$lld su %2$lld, serie attuale: %3$lld, serie migliore: %4$lld"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期間の進捗：%2$lld中%1$lld、現在の連続記録：%3$lld、最長の連続記録：%4$lld"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기간 진행률: %2$lld 중 %1$lld, 현재 연속 기록: %3$lld, 최장 연속 기록: %4$lld"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कालावधीची प्रगती %2$lld पैकी %1$lld, सध्याची स्ट्रीक %3$lld, सर्वोत्तम स्ट्रीक %4$lld"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemajuan tempoh %1$lld daripada %2$lld, rentetan semasa %3$lld, rentetan terbaik %4$lld"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voortgang in de periode %1$lld van %2$lld, huidige reeks %3$lld, beste reeks %4$lld"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Postęp okresu: %1$lld z %2$lld, obecna seria: %3$lld, najlepsza seria: %4$lld"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Progresso do período: %1$lld de %2$lld, sequência atual: %3$lld, melhor sequência: %4$lld"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Progresul perioadei %1$lld din %2$lld, seria curentă %3$lld, cea mai bună serie %4$lld"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогресс периода: %1$lld из %2$lld, текущая серия: %3$lld, лучшая серия: %4$lld"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காலகட்ட முன்னேற்றம் %1$lld/%2$lld, தற்போதைய ஸ்ட்ரீக் %3$lld, சிறந்த ஸ்ட்ரீக் %4$lld"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వ్యవధి ప్రోగ్రెస్ %2$lldలో %1$lld, ప్రస్తుత స్ట్రీక్ %3$lld, అత్యుత్తమ స్ట్రీక్ %4$lld"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความคืบหน้าของช่วงเวลา %1$lld จาก %2$lld, สถิติต่อเนื่องปัจจุบัน %3$lld, สถิติต่อเนื่องสูงสุด %4$lld"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dönem ilerlemesi: %2$lld içinde %1$lld, güncel seri %3$lld, en iyi seri %4$lld"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогрес періоду: %1$lld з %2$lld, поточна серія: %3$lld, найкраща серія: %4$lld"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مدت کی پیش رفت: %2$lld میں سے %1$lld، موجودہ تسلسل %3$lld، بہترین تسلسل %4$lld"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiến độ kỳ này %1$lld trên %2$lld, chuỗi hiện tại %3$lld, chuỗi dài nhất %4$lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "周期进度 %1$lld/%2$lld，当前连续 %3$lld，最佳连续 %4$lld"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
