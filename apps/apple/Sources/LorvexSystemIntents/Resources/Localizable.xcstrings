    "system.memory.save.description": {
      "comment": "Description for the Save Lorvex Memory App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حفظ إدخال في ذاكرة Lorvex القابلة للكتابة بالذكاء الاصطناعي من الاختصارات أو Siri."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শর্টকাট বা Siri থেকে AI লিখতে পারে এমন একটি Lorvex মেমোরি এন্ট্রি সেভ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichert einen von KI beschreibbaren Lorvex-Gedächtniseintrag über Kurzbefehle oder Siri."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκεύστε μια εγγράψιμη από AI καταχώριση μνήμης Lorvex από τις Συντομεύσεις ή το Siri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save an AI-writable Lorvex memory entry from Shortcuts or Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda un recuerdo de Lorvex editable por IA desde Atajos o Siri."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ذخیره یک مورد حافظه Lorvex، قابل‌نوشتن توسط هوش مصنوعی، از طریق میان‌برها یا Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre un souvenir de Lorvex modifiable par l’IA depuis Raccourcis ou Siri."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמירת רשומת זיכרון ב-Lorvex שניתנת לכתיבה על ידי AI, דרך קיצורי דרך או Siri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट्स या Siri से AI द्वारा लिखने योग्य Lorvex मेमोरी एंट्री सहेजें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan entri memori Lorvex yang dapat ditulis AI dari Pintasan atau Siri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva un ricordo di Lorvex modificabile dall’IA da Comandi rapidi o Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットまたはSiriで、AIが書き込めるLorvexのメモリを保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어 또는 Siri에서 AI가 쓸 수 있는 Lorvex 메모리를 저장합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट किंवा Siri द्वारे AI लिहू शकेल अशी एक Lorvex मेमरी नोंद जतन करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan entri memori Lorvex yang boleh ditulis AI daripada Pintasan atau Siri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaart een door AI beschrijfbaar Lorvex-geheugenitem via Opdrachten of Siri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuje wpis pamięci Lorvex zapisywalny przez AI ze Skrótów lub Siri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva uma memória do Lorvex editável pela IA pelos Atalhos ou pela Siri."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvează o înregistrare din memoria Lorvex ce poate fi scrisă de AI prin Scurtături sau Siri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет запись памяти Lorvex, доступную для записи ИИ, из «Быстрых команд» или Siri."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்கவழிகள் அல்லது Siri மூலம் AI எழுதக்கூடிய Lorvex நினைவகப் பதிவைச் சேமிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "షార్ట్‌కట్స్ లేదా Siri నుండి AI రాయగలిగే Lorvex మెమరీ నమోదును సేవ్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกรายการหน่วยความจำ Lorvex ที่ AI เขียนได้จากคำสั่งลัดหรือ Siri"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kestirmeler veya Siri ile yapay zekânın yazabildiği bir Lorvex bellek girdisini kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігає запис пам’яті Lorvex, доступний для запису ШІ, зі «Швидких команд» або Siri."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شارٹ کٹس یا Siri سے AI کے لیے قابل تحریر Lorvex حافظہ اندراج محفوظ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu một mục ghi nhớ Lorvex mà AI có thể ghi từ Phím tắt hoặc Siri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“快捷指令”或 Siri 保存一个 AI 可写的 Lorvex 记忆条目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過捷徑或 Siri 儲存 AI 可寫入的 Lorvex 記憶。"
          }
        }
      }
    },
