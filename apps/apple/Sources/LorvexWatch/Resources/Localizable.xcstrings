    "watch.delivery.workspace_replaced": {
      "comment": "Reason retained when a queued command belongs to a replaced iPhone database workspace",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم استبدال مساحة عمل iPhone قبل تطبيق هذا الإجراء."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPhone workspace was replaced before this action was applied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espacio de trabajo del iPhone se reemplazó antes de aplicar esta acción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’espace de travail de l’iPhone a été remplacé avant l’application de cette action."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस कार्रवाई के लागू होने से पहले iPhone का वर्कस्पेस बदल दिया गया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’area di lavoro di iPhone è stata sostituita prima che l’azione venisse applicata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作が適用される前に、iPhoneのデータベースが置き換えられました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 동작이 적용되기 전에 iPhone의 데이터베이스가 교체되었습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obszar roboczy na iPhonie został zastąpiony przed zastosowaniem tej akcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O espaço de trabalho do iPhone foi substituído antes de esta ação ser aplicada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рабочая область на iPhone была заменена до применения этого действия."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Робочу область на iPhone було замінено до застосування цієї дії."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用此操作前，iPhone 工作区已被替换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在套用此操作前，iPhone 的資料庫已被取代。"
          }
        }
      }
    },
    "watch.error.action_failed": {
      "comment": "Watch Today: a task or habit action failed to save",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم حفظ هذا التغيير. حاول مرة أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That change didn’t save. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cambio no se guardó. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La modification n’a pas été enregistrée. Réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह बदलाव सहेजा नहीं जा सका। फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modifica non è stata salvata. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を保存できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항을 저장하지 못했습니다. 다시 시도하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zapisano zmiany. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A alteração não foi salva. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменение не сохранено. Повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміну не збережено. Повторіть спробу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这项更改没有保存，请再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存這項變更，請再試一次。"
          }
        }
      }
    },
    "watch.error.capture_forwarder_required": {
      "comment": "Error shown if a watch capture action reaches a read-only snapshot backend without an iPhone/Mac mutation forwarder",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Lorvex على iPhone أو Mac لإضافة مهام جديدة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Lorvex on iPhone or Mac to capture new tasks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Lorvex en el iPhone o el Mac para añadir tareas nuevas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Lorvex sur l’iPhone ou le Mac pour ajouter de nouvelles tâches."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नए कार्य जोड़ने के लिए iPhone या Mac पर Lorvex खोलें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Lorvex su iPhone o Mac per aggiungere nuove attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいタスクを追加するには、iPhoneまたはMacでLorvexを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 할 일을 추가하려면 iPhone 또는 Mac에서 Lorvex를 여세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Lorvex na iPhonie lub Macu, aby dodawać nowe zadania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Lorvex no iPhone ou no Mac para adicionar novas tarefas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Lorvex на iPhone или Mac, чтобы добавлять новые задачи."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте Lorvex на iPhone або Mac, щоб додавати нові завдання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 或 Mac 上打开 Lorvex 以添加新任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 iPhone 或 Mac 上開啟 Lorvex 以新增任務。"
          }
        }
      }
    },
