    "recurring_cancel.batch_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد إلغاء حالات التكرار المحددة فقط، أم إنهاء كل سلاسل التكرار المحددة؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু নির্বাচিত বারের টাস্কগুলি বাতিল করবেন, নাকি নির্বাচিত প্রতিটি পুনরাবৃত্ত সিরিজ শেষ করবেন?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die ausgewählten Wiederholungen abbrechen oder jede ausgewählte Serie beenden?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Να ακυρωθούν μόνο οι επιλεγμένες επαναλήψεις ή να τερματιστούν όλες οι επιλεγμένες σειρές επαναλήψεων;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel only the selected occurrences, or end every selected repeating series?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cancelar solo las repeticiones seleccionadas o terminar las series completas?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط تکرارهای انتخاب‌شده لغو شوند یا همه مجموعه‌های تکرارشونده انتخاب‌شده پایان یابند؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler uniquement les occurrences sélectionnées ou mettre fin à toutes les séries récurrentes sélectionnées ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לבטל רק את המופעים שנבחרו או לסיים כל סדרה חוזרת שנבחרה?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल चुने गए बार रद्द करें, या चुनी गई हर दोहराई जाने वाली श्रृंखला समाप्त करें?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batalkan hanya kejadian yang dipilih, atau akhiri setiap rangkaian pengulangan yang dipilih?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annullare solo le occorrenze selezionate o terminare tutte le serie ricorrenti selezionate?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した回のみキャンセルしますか？それとも、選択した繰り返しをすべて終了しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 반복만 취소하시겠습니까, 아니면 선택한 반복 전체를 종료하시겠습니까?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फक्त सिलेक्ट केलेल्या वेळा रद्द करायच्या, की सिलेक्ट केलेली प्रत्येक पुनरावृत्ती मालिका संपवायची?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Batalkan hanya kejadian yang dipilih, atau tamatkan setiap siri perulangan yang dipilih?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de geselecteerde herhalingen annuleren, of elke geselecteerde reeks beëindigen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulować tylko wybrane wystąpienia czy wszystkie wybrane serie?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar somente as ocorrências selecionadas ou encerrar todas as séries recorrentes selecionadas?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulați doar aparițiile selectate sau încheiați fiecare serie repetitivă selectată?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить только выбранные повторения или все выбранные серии?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องการยกเลิกเฉพาะครั้งที่เลือก หรือยุติการทำประจำทุกชุดที่เลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca seçili yinelemeler mi iptal edilsin, yoksa seçili yinelenen serilerin tümü mü sonlandırılsın?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасувати лише вибрані повторення чи всі вибрані серії?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف منتخب تکرار منسوخ کریں یا ہر منتخب دہرائی جانے والی سیریز ختم کریں؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ hủy các lần lặp đã chọn, hay kết thúc việc lặp lại của mọi nhiệm vụ đã chọn?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只取消所选的这几次，还是结束所有选中的重复系列？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要只取消所選的這幾次，還是結束所選的所有重複系列？"
          }
        }
      }
    },
