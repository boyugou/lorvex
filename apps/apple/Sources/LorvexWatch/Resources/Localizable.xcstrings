    "watch.error.unavailable.remedy": {
      "comment": "Remedy text when the watch snapshot is unavailable",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Lorvex على iPhone للمزامنة، ثم أعد المحاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Lorvex auf deinem iPhone, um zu synchronisieren, und versuche es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Lorvex on your iPhone to sync, then retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Lorvex en tu iPhone para sincronizar y vuelve a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای همگام‌سازی، Lorvex را در iPhone خود باز کنید و دوباره تلاش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Lorvex sur votre iPhone pour synchroniser, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לסנכרן, יש לפתוח את Lorvex ב-iPhone ולנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिंक करने के लिए अपने iPhone पर Lorvex खोलें, फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Lorvex di iPhone untuk menyelaraskan, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Lorvex su iPhone per sincronizzare, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneでLorvexを開いて同期してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 Lorvex를 열어 동기화한 후 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Lorvex pada iPhone untuk menyelaraskan, kemudian cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Lorvex op je iPhone om te synchroniseren en probeer het daarna opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Lorvex na iPhonie, aby zsynchronizować, i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Lorvex no seu iPhone para sincronizar e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschideți Lorvex pe iPhone pentru a sincroniza, apoi reîncercați."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Lorvex на iPhone для синхронизации и повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте Lorvex на iPhone для синхронізації та повторіть спробу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سنک کے لیے اپنے iPhone پر Lorvex کھولیں، پھر دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy mở Lorvex trên iPhone để đồng bộ hóa, rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 iPhone 上打开 Lorvex 以同步，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 iPhone 上開啟 Lorvex 進行同步，然後重試。"
          }
        }
      }
    },
