    "settings.working_hours.caption": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الساعات التي يخطط Lorvex مهامك ضمنها. يُحتسب امتلاء اليوم بالنسبة إليها، وتبقى الأوقات المقترحة داخلها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex এই সময়ের মধ্যেই আপনার টাস্ক প্ল্যান করে। একটি দিন কতটা ভরা, তা এই সময়ের হিসাবে ধরা হয় এবং প্রস্তাবিত সময়ও এর মধ্যেই থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex plant deine Aufgaben innerhalb dieser Stunden. Daran bemisst sich, wie voll ein Tag ist, und vorgeschlagene Zeiten liegen immer innerhalb davon."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Lorvex προγραμματίζει τις εργασίες σας μέσα σε αυτές τις ώρες. Κρίνει πόσο γεμάτη είναι μια ημέρα με βάση αυτές, και οι προτεινόμενες ώρες παραμένουν μέσα σε αυτές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex plans your tasks into these hours. It judges how full a day is against them, and suggested times stay inside them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las horas en las que Lorvex planifica tus tareas. Lo lleno que está un día se mide con respecto a ellas, y los horarios sugeridos siempre quedan dentro."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارهای شما را Lorvex در همین ساعت‌ها برنامه‌ریزی می‌کند. پر بودن یک روز نسبت به این ساعت‌ها سنجیده می‌شود و زمان‌های پیشنهادی درون آن‌ها می‌مانند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les heures dans lesquelles Lorvex planifie vos tâches. Le taux de remplissage d’une journée est calculé par rapport à ces heures, et les horaires suggérés restent dans cette plage."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשימות שלך מתוכננות בשעות האלה. מידת העומס ביום נמדדת לפיהן, והזמנים המוצעים נשארים בתוכן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वे घंटे जिनमें Lorvex आपके कार्य प्लान करता है। दिन कितना भरा है, इसकी गिनती इन्हीं के हिसाब से होती है, और सुझाए गए समय इन्हीं के भीतर रहते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex merencanakan tugas ke dalam jam-jam ini. Penuh tidaknya suatu hari dinilai berdasarkan jam ini, dan waktu yang disarankan tetap berada di dalamnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ore in cui Lorvex pianifica le tue attività. Il riempimento di una giornata viene calcolato rispetto a queste ore e gli orari suggeriti restano al loro interno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexがタスクを予定に入れる時間帯です。1日の混み具合はこの時間帯を基準に数えられ、提案される時間もこの範囲内に収まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex가 할 일을 일정에 배치하는 시간입니다. 하루가 얼마나 찼는지는 이 시간을 기준으로 계산되고, 제안되는 시간도 이 범위 안에서만 정해집니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची कार्ये याच तासांमध्ये प्लॅन केली जातात. दिवस किती भरलेला आहे हे याच तासांच्या आधारे ठरवले जाते, आणि सुचवलेल्या वेळाही यांच्या आतच राहतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex merancang tugas anda ke dalam jam ini. Ia menilai betapa penuhnya sesuatu hari berdasarkan jam ini, dan masa yang dicadangkan kekal di dalamnya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex plant je taken binnen deze uren in. Hieraan wordt afgemeten hoe vol een dag is, en voorgestelde tijden blijven erbinnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Godziny, w które Lorvex planuje twoje zadania. Wypełnienie dnia liczy się względem nich, a sugerowane godziny mieszczą się w ich granicach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As horas em que o Lorvex planeja suas tarefas. O quanto um dia está cheio é medido em relação a elas, e os horários sugeridos ficam dentro delas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex planifică sarcinile în aceste ore. Gradul de încărcare al unei zile se măsoară în raport cu ele, iar orele sugerate rămân în interiorul lor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часы, в которые Lorvex планирует ваши задачи. Загруженность дня рассчитывается относительно них, а предлагаемое время не выходит за их пределы."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex உங்கள் பணிகளை இந்த மணிநேரங்களுக்குள் திட்டமிடும். ஒரு நாள் எவ்வளவு நிரம்பியுள்ளது என்பதை இவற்றை வைத்து மதிப்பிடும்; பரிந்துரைக்கும் நேரங்களும் இவற்றுக்குள்ளேயே இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex మీ టాస్క్‌లను ఈ గంటల్లో ప్లాన్ చేస్తుంది. రోజు ఎంత నిండి ఉందో వీటి ఆధారంగా అంచనా వేస్తుంది, సూచించే సమయాలు కూడా వీటి లోపలే ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex วางแผนงานของคุณในช่วงเวลานี้ โดยใช้ช่วงเวลานี้ประเมินว่าวันหนึ่งเต็มแค่ไหน และเวลาที่แนะนำจะอยู่ภายในช่วงนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex görevlerinizi bu saatlere planlar. Bir günün ne kadar dolu olduğunu bu saatlere göre değerlendirir ve önerilen zamanlar bunların içinde kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Години, у які Lorvex планує ваші завдання. Заповненість дня обчислюється відносно них, а запропонований час не виходить за їхні межі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے کاموں کی منصوبہ بندی Lorvex ان اوقات میں کرتا ہے۔ دن کتنا بھرا ہے اس کا حساب انہی کے مقابلے میں ہوتا ہے، اور تجویز کردہ اوقات انہی کے اندر رہتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex lên kế hoạch cho nhiệm vụ trong những giờ này. Mức độ đầy của một ngày được đánh giá theo các giờ này, và thời gian gợi ý luôn nằm trong đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 在这个时段里安排任务：每天有多满按它计算，建议的时间也只会落在其中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 會把任務安排在這段時間內。一天的滿載程度以此計算，建議的時間也只會落在這段時間裡。"
          }
        }
      }
    },
