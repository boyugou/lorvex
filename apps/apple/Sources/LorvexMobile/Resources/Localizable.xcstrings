    "settings.calendar.load_error": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل التقويمات. تحقق من الوصول إلى التقويم في الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যালেন্ডার লোড করা যায়নি। সেটিংসে ক্যালেন্ডার অ্যাক্সেস পরীক্ষা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalender konnten nicht geladen werden. Prüfe den Kalenderzugriff in den Einstellungen."
