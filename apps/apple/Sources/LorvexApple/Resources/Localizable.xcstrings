    "reviews.weekly.empty.message": {
      "comment": "macOS week review empty state message.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر الأسبوع هنا بمجرد أن يكون لدى Lorvex نشاط للمهام يمكن تلخيصه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The week appears here once Lorvex has task activity to summarize."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La semana aparece aquí cuando Lorvex tenga actividad de tareas que resumir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La semaine apparaît ici dès que Lorvex a de l’activité à résumer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब Lorvex के पास सार निकालने लायक कार्य गतिविधि होगी, तब सप्ताह यहाँ दिखेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La settimana apparirà qui non appena Lorvex avrà attività da riassumere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要約できるタスクのアクティビティがLorvexに記録されると、ここに今週の内容が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex에 요약할 할 일 활동이 생기면 이번 주 내용이 여기에 표시됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsumowanie tygodnia pojawi się tutaj, gdy w Lorvex pojawi się aktywność związana z zadaniami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A semana aparece aqui quando o Lorvex tiver atividade de tarefas para resumir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Итоги недели появятся здесь, как только в Lorvex накопится активность по задачам."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підсумки тижня з’являться тут, щойно в Lorvex накопичиться активність із завданнями."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有了任务记录后，这里会总结这一周。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當 Lorvex 有可摘要的任務活動時，這一週的內容會顯示在這裡。"
          }
        }
      }
    },
