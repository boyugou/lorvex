        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am stärksten am %1$@, am schwächsten am %2$@."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πιο δυνατές ημέρες: %1$@, πιο αδύναμες: %2$@."
