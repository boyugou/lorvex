    "setup.welcome.assistant.detail": {
      "comment": "Simplified Chinese deliberately names no assistant product here (China mainland App Store review); other languages may name Claude as the example.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتضمن Lorvex ذكاءً اصطناعيًا خاصًا به. اربط Claude أو أي مساعد آخر يدعم MCP بتطبيق Lorvex على جهاز Mac."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex-এর নিজস্ব কোনো AI নেই। আপনার Mac-এ Lorvex-এর সাথে Claude বা অন্য কোনো MCP অ্যাসিস্ট্যান্ট কানেক্ট করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex hat keine eigene KI. Verbinde Claude oder einen anderen MCP-Assistenten auf deinem Mac mit Lorvex."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Lorvex δεν έχει δικό του AI. Συνδέστε το Claude ή έναν άλλο βοηθό MCP στο Lorvex στο Mac σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex has no AI of its own. Connect Claude or another MCP assistant to Lorvex on your Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex no tiene IA propia. Conecta Claude u otro asistente MCP a Lorvex en tu Mac."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه Lorvex هوش مصنوعی مخصوص به خود ندارد. Claude یا دستیار MCP دیگری را روی Mac خود به Lorvex وصل کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex n’a pas d’IA propre. Connectez Claude ou un autre assistant MCP à Lorvex sur votre Mac."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ל-Lorvex אין AI מובנה. אפשר לחבר את Claude או עוזר MCP אחר אל Lorvex ב-Mac שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex में अपना कोई AI नहीं है। अपने Mac पर Lorvex से Claude या कोई दूसरा MCP असिस्टेंट जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex tidak memiliki AI sendiri. Hubungkan Claude atau asisten MCP lain ke Lorvex di Mac Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex non ha un’IA propria. Collega Claude o un altro assistente MCP a Lorvex sul tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LorvexにはAIが組み込まれていません。MacでClaudeなどのMCPアシスタントをLorvexに接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex에는 자체 AI가 없습니다. Mac에서 Claude 또는 다른 MCP 어시스턴트를 Lorvex에 연결하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex चे स्वतःचे AI नाही. तुमच्या Mac वर Lorvex शी Claude किंवा दुसरा MCP सहाय्यक कनेक्ट करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex tidak mempunyai AI sendiri. Sambungkan Claude atau pembantu AI MCP yang lain kepada Lorvex pada Mac anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex heeft geen eigen AI. Verbind Claude of een andere MCP-assistent op je Mac met Lorvex."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex nie ma własnej sztucznej inteligencji. Połącz Claude lub innego asystenta MCP z Lorvex na swoim Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lorvex não tem IA própria. Conecte o Claude ou outro assistente MCP ao Lorvex no seu Mac."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex nu are un AI propriu. Conectați Claude sau un alt asistent MCP la Lorvex pe Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Lorvex нет собственного ИИ. Подключите Claude или другого MCP-ассистента к Lorvex на своём Mac."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexக்குச் சொந்த AI இல்லை. உங்கள் Macஇல் Claude அல்லது வேறொரு MCP அசிஸ்டென்ட்டை Lorvex உடன் இணைக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexకు సొంత AI లేదు. మీ Macలో Lorvexకు Claude లేదా మరో MCP అసిస్టెంట్‌ను కనెక్ట్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex ไม่มี AI ในตัว เชื่อมต่อ Claude หรือผู้ช่วย MCP อื่นกับ Lorvex บน Mac ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex’in kendi yapay zekâsı yok. Mac’inizde Claude’u veya başka bir MCP asistanını Lorvex’e bağlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У Lorvex немає власного ШІ. Підключіть Claude або іншого MCP-асистента до Lorvex на своєму Mac."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ایپ میں اپنا کوئی AI نہیں ہے۔ اپنے Mac پر Claude یا کوئی اور MCP اسسٹنٹ Lorvex سے جوڑ لیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex không có AI riêng. Hãy kết nối Claude hoặc một trợ lý MCP khác với Lorvex trên máy Mac của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 本身不含 AI。请在 Mac 上的 Lorvex 中连接支持 MCP 的 AI 助手。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 本身沒有內建 AI。請在你的 Mac 上將 Claude 或其他 MCP 助理連接到 Lorvex。"
          }
        }
      }
    },
    "setup.welcome.today.title": {
      "extractionState": "manual",
