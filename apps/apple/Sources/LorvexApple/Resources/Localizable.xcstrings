    "recurring_cancel.batch_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء المهام المتكررة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পুনরাবৃত্ত টাস্ক বাতিল করুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederkehrende Aufgaben abbrechen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακύρωση επαναλαμβανόμενων εργασιών"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel Recurring Tasks"
          }
        },
        "es": {
          "stringUnit": {
