{
  "sourceLanguage": "en",
  "strings": {
    "widget.control.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض المهمة في أعلى قائمة اليوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজকের তালিকার সবার উপরের টাস্কটি দেখায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die oberste Aufgabe in „Heute“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζει την εργασία στην κορυφή του «Σήμερα»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the task at the top of Today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la primera tarea de Hoy."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کار بالای فهرست «امروز» را نشان می‌دهد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche la tâche en tête d’Aujourd’hui."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג את המשימה שבראש \"היום\"."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज की सूची में सबसे ऊपर का कार्य दिखाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan tugas teratas di Hari Ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra l’attività in cima a Oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の先頭のタスクを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 맨 위 할 일을 표시합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आजच्या यादीतील सर्वात वरचे कार्य दाखवते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunjukkan tugas teratas dalam Hari Ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont de bovenste taak in ‘Vandaag’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje zadanie na początku „Dzisiaj”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra a tarefa no topo de Hoje."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișează prima sarcină din „Astăzi”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает задачу, которая стоит первой в «Сегодня»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงงานบนสุดของวันนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün sayfasının en üstündeki görevi gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує завдання, яке стоїть першим у «Сьогодні»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "\"آج\" میں سب سے اوپر والا کام دکھاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị nhiệm vụ đứng đầu trong Hôm nay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示“今天”最上面的任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示今天最上方的任務。"
          }
        }
      }
    },
