    },
    "system.task.start.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدء مهمة في Lorvex. تتصدر المهام التي بدأ العمل عليها قائمة اليوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি Lorvex টাস্ক শুরু করুন। শুরু হওয়া টাস্ক আজকের তালিকার শীর্ষে থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet eine Lorvex-Aufgabe. Gestartete Aufgaben stehen unter „Heute“ ganz oben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκινήστε μια εργασία Lorvex. Οι εργασίες που έχουν ξεκινήσει εμφανίζονται πρώτες στο «Σήμερα»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a Lorvex task. Started tasks lead Today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia una tarea de Lorvex. Las tareas iniciadas encabezan Hoy."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شروع یک کار Lorvex. کارهای شروع‌شده در «امروز» در صدر فهرست قرار می‌گیرند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarre une tâche de Lorvex. Les tâches démarrées figurent en tête d’Aujourd’hui."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחלת משימה ב-Lorvex. משימות שהותחלו מופיעות ראשונות ב\"היום\"."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex कार्य शुरू करें। शुरू किए गए कार्य “आज” में सबसे ऊपर रहते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memulai tugas Lorvex. Tugas yang sudah dimulai tampil paling atas di Hari Ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia un’attività di Lorvex. Le attività iniziate sono in cima a Oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexのタスクを開始します。開始したタスクは「今日」の先頭に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 할 일을 시작합니다. 시작한 할 일은 오늘 화면의 맨 위에 표시됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एक Lorvex कार्य सुरू करा. सुरू झालेली कार्ये आजच्या यादीत सर्वात वर असतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memulakan tugas Lorvex. Tugas yang telah dimulakan dipaparkan paling atas dalam Hari Ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start een Lorvex-taak. Gestarte taken staan bovenaan ‘Vandaag’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoczyna zadanie Lorvex. Rozpoczęte zadania są na początku „Dzisiaj”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia uma tarefa do Lorvex. As tarefas iniciadas ficam no topo de Hoje."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Începe o sarcină Lorvex. Sarcinile începute apar primele în „Astăzi”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начинает задачу Lorvex. Начатые задачи стоят первыми в «Сегодня»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex பணியைத் தொடங்கு. தொடங்கிய பணிகள் இன்றைய பட்டியலில் முதலில் இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex టాస్క్‌ను ప్రారంభించండి. ప్రారంభించిన టాస్క్‌లు ఈరోజు జాబితాలో మొదట ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มงาน Lorvex งานที่เริ่มแล้วจะแสดงเป็นอันดับแรกในวันนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Lorvex görevini başlatın. Başlatılan görevler Bugün sayfasında en üstte yer alır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Починає завдання Lorvex. Розпочаті завдання йдуть першими в «Сьогодні»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک Lorvex کام شروع کریں۔ شروع کیے گئے کام \"آج\" میں سب سے اوپر آتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu một nhiệm vụ Lorvex. Các nhiệm vụ đã bắt đầu được xếp đầu tiên trong Hôm nay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始一个 Lorvex 任务。已开始的任务排在今天最前面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始 Lorvex 任務。已開始的任務會排在「今天」的最上方。"
          }
        }
      }
    },
