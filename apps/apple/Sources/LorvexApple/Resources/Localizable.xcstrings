          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu ritmo semanal aparece aqui depois de duas semanas de registros."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiparul săptămânal va apărea aici după două săptămâni de bifări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появится ваш недельный ритм после двух недель отметок."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут з’явиться ваш тижневий ритм після двох тижнів позначок."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دو ہفتوں کے چیک اِن کے بعد آپ کا ہفتہ وار پیٹرن یہاں نظر آئے گا۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打卡满两周后，这里会显示你一周里的规律。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "累積兩週的打卡紀錄後，這裡會顯示你每週的規律。"
          }
        }
      }
    },
    "habit_detail.weekdays.even": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متقارب تقريبًا على مدار الأسبوع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über die Woche hinweg etwa gleichmäßig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About even across the week."
          }
        },
        "es": {
          "stringUnit": {
