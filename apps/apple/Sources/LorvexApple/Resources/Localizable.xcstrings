    "tasks.empty.no_matching_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مهام تطابق تصفية الأولوية المحددة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্বাচিত প্রাধান্য ফিল্টারের সাথে কোনো টাস্ক মেলেনি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Aufgaben entsprechen dem ausgewählten Prioritätsfilter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καμία εργασία δεν ταιριάζει με το επιλεγμένο φίλτρο προτεραιότητας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No tasks match the selected priority filter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna tarea coincide con el filtro de prioridad seleccionado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ کاری با فیلتر اولویت انتخاب‌شده مطابقت ندارد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune tâche ne correspond au filtre de priorité sélectionné."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין משימות שתואמות למסנן העדיפות שנבחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुने गए प्राथमिकता फ़िल्टर से कोई कार्य मेल नहीं खाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada tugas yang cocok dengan filter prioritas yang dipilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna attività corrisponde al filtro di priorità selezionato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した優先度フィルタに一致するタスクはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 우선순위 필터와 일치하는 할 일이 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "निवडलेल्या प्राधान्य फिल्टरशी कोणतेही कार्य जुळत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada tugas sepadan dengan penapis keutamaan yang dipilih."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen taken komen overeen met het geselecteerde prioriteitsfilter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadne zadanie nie pasuje do wybranego filtra priorytetu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma tarefa corresponde ao filtro de prioridade selecionado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicio sarcină nu corespunde filtrului de prioritate selectat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет задач, подходящих под выбранный фильтр приоритета."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีงานที่ตรงกับตัวกรองความสำคัญที่เลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili öncelik filtresiyle eşleşen görev yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає завдань, що відповідають вибраному фільтру пріоритету."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب ترجیحی فلٹر سے کوئی کام مطابقت نہیں رکھتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có nhiệm vụ nào khớp với bộ lọc mức ưu tiên đã chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
