            "value": "あなただけのもの"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나만의 공간"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko dla ciebie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Privado, só seu"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только для вас"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише для вас"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف آپ کے لیے"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只属于你"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只屬於你"
          }
        }
      }
    },
    "setup.sync.private.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُخزَّن مشفّرة في حساب iCloud الخاص بك. ليس لدى Lorvex خادم خاص به."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored encrypted in your own iCloud account. Lorvex has no server of its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guardan cifrados en tu propia cuenta de iCloud. Lorvex no tiene servidor propio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به‌صورت رمزگذاری‌شده در حساب iCloud خودتان ذخیره می‌شود. Lorvex سرور اختصاصی ندارد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données sont chiffrées dans votre propre compte iCloud. Lorvex n’a pas de serveur propre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נשמר מוצפן בחשבון ה-iCloud שלך. אין ל-Lorvex שרת עצמאי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके अपने iCloud खाते में एन्क्रिप्टेड रूप में सहेजा जाता है। Lorvex का अपना कोई सर्वर नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati sono archiviati con crittografia nel tuo account iCloud. Lorvex non ha un server proprio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなた自身のiCloudアカウントに暗号化して保存されます。Lorvexには独自のサーバはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 본인의 iCloud 계정에 암호화되어 저장됩니다. Lorvex에는 자체 서버가 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane są przechowywane w postaci zaszyfrowanej na twoim koncie iCloud. Lorvex nie ma własnego serwera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dados ficam armazenados com criptografia na sua própria conta do iCloud. O Lorvex não tem servidor próprio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранится в зашифрованном виде в вашей учётной записи iCloud. У Lorvex нет собственного сервера."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігається в зашифрованому вигляді у вашому обліковому записі iCloud. У Lorvex немає власного сервера."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے اپنے iCloud اکاؤنٹ میں خفیہ کردہ حالت میں محفوظ۔ Lorvex کا اپنا کوئی سرور نہیں ہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加密保存在你自己的 iCloud 账户中。Lorvex 没有自己的服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料會加密儲存在你自己的 iCloud 帳號中。Lorvex 沒有自己的伺服器。"
          }
        }
      }
    },
