    "settings.sync.paused.account_changed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر حساب iCloud المسجَّل الدخول إليه. تم إيقاف المزامنة مؤقتًا حتى لا تختلط بيانات هذا الجهاز بحساب مختلف."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The signed-in iCloud account changed. Sync is paused so this device’s data isn’t mixed into a different account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta de iCloud con la sesión iniciada ha cambiado. La sincronización está en pausa para que los datos de este dispositivo no se mezclen con los de otra cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte iCloud connecté a changé. La synchronisation est en pause afin que les données de cet appareil ne soient pas mélangées à celles d’un autre compte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन किया हुआ iCloud खाता बदल गया है। सिंक रोक दिया गया है, ताकि इस डिवाइस का डेटा किसी दूसरे खाते में न मिल जाए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’account iCloud connesso è cambiato. La sincronizzazione è in pausa affinché i dati di questo dispositivo non vengano mescolati con quelli di un altro account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインしているiCloudアカウントが変更されました。このデバイスのデータが別のアカウントに混在しないよう、同期を一時停止しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인한 iCloud 계정이 변경되었습니다. 이 기기의 데이터가 다른 계정에 섞이지 않도록 동기화를 일시 중지했습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalogowane konto iCloud zostało zmienione. Synchronizacja jest wstrzymana, aby dane z tego urządzenia nie zmieszały się z danymi innego konta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta do iCloud conectada mudou. A sincronização está pausada para que os dados deste dispositivo não sejam misturados com os de outra conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учётная запись iCloud, в которую выполнен вход, изменилась. Синхронизация приостановлена, чтобы данные этого устройства не смешались с данными другой учётной записи."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обліковий запис iCloud, в який виконано вхід, змінився. Синхронізацію призупинено, щоб дані цього пристрою не змішалися з даними іншого облікового запису."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录的 iCloud 账户已更改。同步已暂停，以防此设备的数据混入其他账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入的 iCloud 帳號已變更。為避免此裝置的資料混入其他帳號，已暫停同步。"
          }
        }
      }
    },
    "settings.sync.paused.user_deleted_zone": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حذف بيانات Lorvex من iCloud. تظل المزامنة متوقفة مؤقتًا حتى لا يعيد هذا الجهاز رفعها دون موافقتك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex data was deleted from iCloud. Sync stays paused so this device doesn’t re-upload it without your consent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de Lorvex se eliminaron de iCloud. La sincronización sigue en pausa para que este dispositivo no los vuelva a subir sin tu consentimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données Lorvex ont été supprimées d’iCloud. La synchronisation reste en pause afin que cet appareil ne les renvoie pas sans votre accord."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud से Lorvex का डेटा हटा दिया गया था। सिंक रुका रहेगा, ताकि यह डिवाइस आपकी सहमति के बिना उसे दोबारा अपलोड न करे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati di Lorvex sono stati eliminati da iCloud. La sincronizzazione resta in pausa affinché questo dispositivo non li ricarichi senza il tuo consenso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudからLorvexのデータが削除されました。このデバイスがあなたの同意なくデータを再アップロードしないよう、同期は一時停止のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에서 Lorvex 데이터가 삭제되었습니다. 이 기기가 동의 없이 데이터를 다시 업로드하지 않도록 동기화는 일시 중지된 상태로 유지됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane Lorvex zostały usunięte z iCloud. Synchronizacja pozostaje wstrzymana, aby to urządzenie nie przesłało ich ponownie bez twojej zgody."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados do Lorvex foram excluídos do iCloud. A sincronização continua pausada para que este dispositivo não os reenvie sem o seu consentimento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные Lorvex были удалены из iCloud. Синхронизация остаётся приостановленной, чтобы это устройство не загрузило их повторно без вашего согласия."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані Lorvex було видалено з iCloud. Синхронізація залишається призупиненою, щоб цей пристрій не завантажив їх повторно без вашої згоди."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 数据已从 iCloud 中删除。同步保持暂停，以防此设备在未经你同意的情况下重新上传数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已從 iCloud 刪除 Lorvex 資料。在你同意之前，此裝置不會重新上傳資料，因此同步會維持暫停。"
          }
        }
      }
    },
    "settings.sync.paused.user_deleted_zone.retry_hint": {
      "comment": "Second sentence of the userDeletedZone pause notice: how to recover if the deletion was interrupted mid-way (running it again is safe and idempotent)",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا انقطع الحذف قبل اكتماله، فشغّل \"حذف بيانات iCloud\" مرة أخرى لإكماله بأمان."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the deletion was interrupted before it finished, run Delete iCloud Data again to complete it safely."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la eliminación se interrumpió antes de terminar, vuelve a ejecutar Eliminar datos de iCloud para completarla de forma segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la suppression a été interrompue avant la fin, exécutez de nouveau Supprimer les données iCloud pour la terminer en toute sécurité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर हटाना पूरा होने से पहले रुक गया था, तो उसे सुरक्षित रूप से पूरा करने के लिए “iCloud डेटा हटाएँ” फिर से चलाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se l’eliminazione è stata interrotta prima del termine, esegui di nuovo Elimina dati iCloud per completarla in sicurezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除が完了する前に中断された場合は、「iCloudデータを削除」をもう一度実行すると、安全に完了できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제가 끝나기 전에 중단되었다면 ‘iCloud 데이터 삭제’를 다시 실행하여 안전하게 완료하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli usuwanie zostało przerwane, uruchom ponownie „Usuń dane iCloud”, aby bezpiecznie je dokończyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a exclusão foi interrompida antes de terminar, execute Excluir dados do iCloud novamente para concluí-la com segurança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если удаление было прервано, запустите «Удалить данные iCloud» ещё раз, чтобы безопасно завершить его."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо видалення було перервано, запустіть «Видалити дані iCloud» ще раз, щоб безпечно завершити його."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果删除在完成前被中断，再次运行“删除 iCloud 数据”即可安全地完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果刪除在完成前被中斷，請再次執行「刪除 iCloud 資料」，即可安全完成。"
          }
        }
      }
    },
    "settings.sync.resume.action": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة الرفع واستئناف المزامنة…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-upload & Resume Sync…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver a subir y reanudar sincronización…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renvoyer et reprendre la synchronisation…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोबारा अपलोड करें और सिंक फिर शुरू करें…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricarica e riprendi la sincronizzazione…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再アップロードして同期を再開…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 업로드하고 동기화 재개…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prześlij ponownie i wznów synchronizację…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reenviar e retomar a sincronização…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправить заново и возобновить синхронизацию…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надіслати знову й відновити синхронізацію…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新上传并恢复同步…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
