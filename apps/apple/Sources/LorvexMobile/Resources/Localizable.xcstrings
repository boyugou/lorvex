        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終判断はあなたに"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최종 결정은 직접 하세요"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अंतिम निर्णय तुमचाच"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda yang menentukan"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jij hebt het laatste woord"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnie słowo należy do ciebie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A palavra final é sua"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultimul cuvânt vă aparține"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последнее слово за вами"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இறுதி முடிவு உங்களுடையது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తుది నిర్ణయం మీదే"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเป็นผู้ตัดสินใจ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son söz sizin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Останнє слово за вами"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آخری فیصلہ آپ کا"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn là người quyết định cuối cùng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最终由你决定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最後由你決定"
          }
        }
      }
    },
    "setup.welcome.control.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقترح مساعدك ويخطط، وأنت تقرر ما يبقى في قائمتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অ্যাসিস্ট্যান্ট প্রস্তাব দেয় ও প্ল্যান করে; আপনার তালিকায় কী থাকবে তা আপনিই ঠিক করেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Assistent macht Vorschläge und plant; du entscheidest, was auf deiner Liste bleibt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο βοηθός σας προτείνει και προγραμματίζει, ενώ εσείς αποφασίζετε τι μένει στη λίστα σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your assistant suggests and plans; you decide what stays on your list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu asistente sugiere y planifica; tú decides qué se queda en tu lista."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دستیارتان پیشنهاد می‌دهد و برنامه می‌ریزد؛ شما تصمیم می‌گیرید چه چیزی در فهرستتان بماند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre assistant suggère et planifie ; c’est vous qui décidez de ce qui reste dans votre liste."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העוזר מציע ומתכנן, וההחלטה מה יישאר ברשימה היא שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका असिस्टेंट सुझाव देता है और प्लान करता है; आपकी सूची में क्या रहे, यह आप तय करते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Asisten menyarankan dan merencanakan; Anda yang memutuskan apa yang tetap ada di daftar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo assistente suggerisce e pianifica; sei tu a decidere cosa resta nella tua lista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "提案と計画はアシスタントが行い、リストに残すものはあなたが決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어시스턴트가 제안하고 계획하며, 목록에 무엇을 남길지는 직접 결정합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा सहाय्यक सुचवतो आणि प्लॅन करतो; तुमच्या यादीत काय राहील ते तुम्ही ठरवता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembantu AI mencadangkan dan merancang; anda yang memutuskan apa yang kekal dalam senarai."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je assistent doet suggesties en plant; jij beslist wat op je lijst blijft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Asystent proponuje i planuje, a ty decydujesz, co zostanie na liście."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu assistente sugere e planeja; você decide o que fica na sua lista."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Asistentul sugerează și planifică; ce rămâne pe listă decideți."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ассистент предлагает и планирует, а вы решаете, что останется в списке."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் அசிஸ்டென்ட் பரிந்துரைக்கும், திட்டமிடும்; உங்கள் பட்டியலில் எது இருக்க வேண்டும் என்பதை நீங்களே முடிவு செய்கிறீர்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ అసిస్టెంట్ సూచిస్తుంది, ప్లాన్ చేస్తుంది; మీ జాబితాలో ఏది ఉండాలో మీరు నిర్ణయిస్తారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ช่วยของคุณแนะนำและวางแผน ส่วนคุณเป็นผู้ตัดสินว่าอะไรจะอยู่ในลิสต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asistanınız önerir ve planlar; listenizde nelerin kalacağına siz karar verirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Асистент пропонує й планує, а ви вирішуєте, що залишиться в списку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا اسسٹنٹ تجویز دیتا اور منصوبہ بناتا ہے؛ آپ طے کرتے ہیں کہ آپ کی فہرست میں کیا رہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trợ lý gợi ý và lên kế hoạch; bạn quyết định điều gì được giữ lại trong danh sách."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手负责建议和规划，清单上留下什么由你决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "助理負責建議與規劃，要留下哪些任務由你決定。"
          }
        }
      }
    },
    "setup.sync.devices.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء متطابق على جميع أجهزتك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সব ডিভাইসে একই"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf jedem Gerät dasselbe"
          }
        },
        "el": {
