    "system.calendar.ics.export.description": {
      "comment": "Description for the Export Lorvex Calendar ICS App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجهيز أحداث تقويم Lorvex بصيغة ICS من الاختصارات أو Siri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare Lorvex calendar events as ICS from Shortcuts or Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara eventos de calendario de Lorvex como ICS desde Atajos o Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prépare les événements du calendrier de Lorvex au format ICS depuis Raccourcis ou Siri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट्स या Siri से Lorvex कैलेंडर इवेंट को ICS के रूप में तैयार करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara gli eventi del calendario di Lorvex in formato ICS da Comandi rapidi o Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットまたはSiriでLorvexのカレンダーイベントをICSとして用意します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어 또는 Siri에서 Lorvex 캘린더 이벤트를 ICS로 준비합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przygotowuje wydarzenia kalendarza Lorvex w formacie ICS ze Skrótów lub Siri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara os eventos do calendário do Lorvex como ICS pelos Atalhos ou pela Siri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готовит события календаря Lorvex в формате ICS из «Быстрых команд» или Siri."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готує події календаря Lorvex у форматі ICS зі «Швидких команд» або Siri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“快捷指令”或 Siri 将 Lorvex 日历事件准备为 ICS。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過捷徑或 Siri 將 Lorvex 行事曆事件準備成 ICS。"
          }
        }
      }
    },
