          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagterugblik voor %@ bijgewerkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaktualizowano podsumowanie dnia za %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
