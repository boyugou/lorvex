{
  "sourceLanguage": "en",
  "strings": {
    "widget.action.complete.a11y": {
      "comment": "Accessibility label for the complete-task widget button; %@ is the task title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成“%@”"
          }
        }
      }
    },
    "widget.circular.a11y": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld task left today"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld tasks left today"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "今天还剩 %lld 个任务"
                }
              }
            }
          }
        }
      }
    },
    "widget.circular.left": {
      "comment": "Caption under the tasks-left number inside the Lock Screen ring",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "left"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待办"
          }
        }
      }
    },
    "widget.circular.min": {
      "comment": "Caption under the minutes-left number inside the Lock Screen ring",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "min"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分钟"
          }
        }
      }
    },
    "widget.circular.running.a11y": {
      "comment": "Accessibility label of the Lock Screen ring while a block runs; %lld minutes left",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld min left"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还剩 %lld 分钟"
          }
        }
      }
    },
    "widget.config.parameter.list": {
      "comment": "Parameter title for selecting a list in the Today widget configuration sheet",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "List"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列表"
          }
        }
      }
    },
    "widget.config.today.description": {
      "comment": "Description shown in the system widget configuration sheet for the Today widget",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a list to show only its tasks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个列表，只显示其中的任务。"
          }
        }
      }
    },
    "widget.config.today.title": {
      "comment": "Title shown in the system widget configuration sheet for the Today widget",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天"
          }
        }
      }
    },
    "widget.empty.no_habits": {
      "comment": "Shown when no habits are tracked",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No habits tracked yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未追踪任何习惯。"
          }
        }
      }
    },
    "widget.entity.list.type": {
      "comment": "Type label for Lorvex list entities in widget configuration",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "List"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列表"
          }
        }
      }
    },
    "widget.foot.done_today": {
      "comment": "Foot line on the large widget: tasks completed today; %lld count",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld done today"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天已完成 %lld 项"
          }
        }
      }
    },
    "widget.foot.more_today": {
      "comment": "Foot line: how many more Today tasks follow the ones shown; %lld count",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld more today"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另有 %lld 项"
          }
        }
      }
    },
    "widget.habits.all_done": {
      "comment": "Footer shown when all habits are done for the day",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All habits done today"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的习惯已全部完成"
          }
        }
      }
    },
    "widget.habits.circular.a11y": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld of %#@habitcount@"
          },
          "substitutions": {
            "habitcount": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg habit done"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg habits done"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成 %1$lld / %#@habitcount@"
          },
          "substitutions": {
            "habitcount": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg 个习惯"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "widget.habits.complete.a11y": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete %@"
          }
        },
