        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay notas de IA. Tu asistente las añade aquí."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز یادداشت هوش مصنوعی وجود ندارد. دستیار شما یادداشت‌ها را اینجا اضافه می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
