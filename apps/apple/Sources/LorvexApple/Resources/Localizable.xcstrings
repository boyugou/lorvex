        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Искать задачи, переходить или добавлять…"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பணிகளைத் தேடவும், வழிசெலுத்தவும் அல்லது விரைவாகச் சேர்க்கவும்…"
