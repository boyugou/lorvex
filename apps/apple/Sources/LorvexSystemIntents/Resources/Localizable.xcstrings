        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Taaktitels, gescheiden door komma’s of nieuwe regels."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tytuły zadań rozdzielone przecinkiem lub nową linią."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Títulos de tarefas separados por vírgulas ou quebras de linha."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Titluri de sarcini separate prin virgulă sau rând nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Названия задач через запятую или перенос строки."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காற்புள்ளி அல்லது புதிய வரியால் பிரிக்கப்பட்ட பணித் தலைப்புகள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కామా లేదా కొత్త లైన్‌తో వేరు చేసిన టాస్క్ టైటిల్‌లు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อเรื่องงานที่คั่นด้วยเครื่องหมายจุลภาคหรือการขึ้นบรรทัดใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Virgül veya satır sonuyla ayrılmış görev başlıkları."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назви завдань через кому або новий рядок."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کاموں کے عنوانات، کوما یا نئی لائن سے الگ کیے ہوئے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tiêu đề nhiệm vụ được phân tách bằng dấu phẩy hoặc dòng mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用逗号或换行分隔的任务标题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以逗號或換行分隔的任務標題。"
          }
        }
      }
    },
    "system.task.batch.reopen.description": {
      "comment": "Description for the Batch Reopen Lorvex Tasks App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة فتح عدة مهام في Lorvex باستخدام المعرّفات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আইডি দিয়ে একাধিক Lorvex টাস্ক আবার খুলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet mehrere Lorvex-Aufgaben anhand ihrer ID wieder."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε ξανά πολλές εργασίες Lorvex με βάση το αναγνωριστικό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reopen multiple Lorvex tasks by ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reabre varias tareas de Lorvex por ID."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بازگشایی چند کار Lorvex با شناسه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rouvre plusieurs tâches de Lorvex à partir de leurs ID."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתיחה מחדש של כמה משימות ב-Lorvex לפי מזהה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ID से कई Lorvex कार्य फिर से खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka kembali beberapa tugas Lorvex berdasarkan ID."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riapre più attività di Lorvex tramite ID."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IDを指定して、複数のLorvexのタスクを未完了に戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ID로 여러 Lorvex 할 일을 다시 엽니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ID वापरून अनेक Lorvex कार्ये पुन्हा उघडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka semula beberapa tugas Lorvex mengikut ID."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heropent meerdere Lorvex-taken op basis van hun ID."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponownie otwiera kilka zadań Lorvex według ID."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reabre várias tarefas do Lorvex por ID."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Redeschide mai multe sarcini Lorvex după ID."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снова открывает несколько задач Lorvex по ID."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ID மூலம் பல Lorvex பணிகளை மீண்டும் திறக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ID ద్వారా అనేక Lorvex టాస్క్‌లను మళ్ళీ తెరవండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดงาน Lorvex หลายรายการใหม่โดยระบุ ID"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birden fazla Lorvex görevini kimliğe göre yeniden açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знову відкриває кілька завдань Lorvex за ID."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آئی ڈی کے ذریعے متعدد Lorvex کام دوبارہ کھولیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở lại nhiều nhiệm vụ Lorvex theo ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 ID 批量重新打开多个 Lorvex 任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依 ID 重新開啟多個 Lorvex 任務。"
          }
        }
      }
    },
