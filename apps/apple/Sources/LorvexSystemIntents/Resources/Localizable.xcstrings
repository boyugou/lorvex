    "system.task.checklist.toggle.description": {
      "comment": "Description for the Toggle Lorvex Checklist Item App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحديد عنصر في قائمة التحقق في Lorvex كمكتمل أو غير مكتمل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি Lorvex চেকলিস্ট আইটেম সম্পূর্ণ বা অসম্পূর্ণ হিসাবে সেট করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt einen Lorvex-Checklistenpunkt auf erledigt oder nicht erledigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορίστε ένα στοιχείο λίστας ελέγχου Lorvex ως ολοκληρωμένο ή μη ολοκληρωμένο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a Lorvex checklist item complete or incomplete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca un elemento de la lista de comprobación de Lorvex como completado o pendiente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تعیین وضعیت یک مورد چک‌لیست Lorvex به تکمیل‌شده یا تکمیل‌نشده."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque un élément de liste de contrôle de Lorvex comme terminé ou non terminé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סימון פריט ברשימת תיוג ב-Lorvex כהושלם או כלא הושלם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex चेकलिस्ट आइटम को पूर्ण या लंबित चिह्नित करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menandai item daftar centang Lorvex sebagai selesai atau belum selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta un elemento della lista di controllo di Lorvex come completato o non completato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexのチェックリスト項目を完了または未完了にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 체크리스트 항목을 완료 또는 미완료로 설정합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एक Lorvex तपासणी यादी आयटम पूर्ण किंवा अपूर्ण म्हणून सेट करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
