    "today.calm.headline.left_one": {
      "comment": "Today headline with one count fragment, e.g. '3 tasks left today.'",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المتبقي اليوم: %@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ %@ বাকি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute noch %@."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακόμη %@ για σήμερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ left today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún hay %@ para hoy."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ برای امروز باقی مانده است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il reste %@ aujourd’hui."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נותר להיום: %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज %@ बाकी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tersisa hari ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora %@ oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は%@が残っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 %@ 남았습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आज बाकी: %@."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ berbaki hari ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog %@ voor vandaag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na dziś zostało: %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda há %@ para hoje."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mai aveți %@ astăzi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня осталось: %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันนี้เหลืออีก %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün %@ kaldı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сьогодні залишилося: %@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج باقی: %@۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ còn lại hôm nay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天还剩 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天還剩 %@。"
          }
        }
      }
    },
    "today.calm.headline.left_both": {
