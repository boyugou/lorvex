    "widget.preview.briefing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مراجعة المواصفات هي الأهم اليوم؛ أما حجز الرحلات فيمكنه الانتظار حتى الخميس."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The spec review matters most today; the flights can wait until Thursday."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy lo más importante es revisar la especificación; los vuelos pueden esperar hasta el jueves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La relecture des spécifications compte le plus aujourd’hui ; les vols peuvent attendre jeudi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज सबसे ज़रूरी काम स्पेक की समीक्षा है; फ़्लाइट बुक करना गुरुवार तक रुक सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La revisione delle specifiche è la cosa più importante oggi; i voli possono aspettare fino a giovedì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は仕様書のレビューがいちばん大切です。フライトの手配は木曜日まで待てます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 사양서 검토가 가장 중요합니다. 항공편 예약은 목요일까지 미뤄도 됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziś najważniejsze jest przejrzenie specyfikacji; loty mogą poczekać do czwartku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
