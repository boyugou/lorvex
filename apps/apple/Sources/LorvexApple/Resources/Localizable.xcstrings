          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ meer dan er in je daguren past"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekracza godziny dnia o %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a mais do que o horário do dia comporta"
