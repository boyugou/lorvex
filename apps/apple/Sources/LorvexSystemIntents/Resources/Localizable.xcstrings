    "system.task.search.dialog.more": {
      "comment": "Dialog after a search returns more than five matching tasks; total and remaining counts pluralize independently around the visible titles",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@total@: %2$@, and %#@remaining@"
          },
          "substitutions": {
            "total": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg matching Lorvex task"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg matching Lorvex tasks"
                    }
                  }
                }
              }
            },
            "remaining": {
              "argNum": 3,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg more"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg more"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@total@：%2$@，%#@remaining@"
          },
          "substitutions": {
            "total": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg 个匹配的 Lorvex 任务"
                    }
                  }
                }
              }
            },
            "remaining": {
              "argNum": 3,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "另外 %arg 个"
                    }
                  }
                }
              }
            }
          }
        }
      }
