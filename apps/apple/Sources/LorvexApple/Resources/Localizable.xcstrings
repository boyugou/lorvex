            "state": "translated",
            "value": "Adicione manualmente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте сами"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте самі"
          }
        },
        "zh-Hans": {
