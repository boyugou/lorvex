          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 일일 회고를 업데이트했습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaktualizowano podsumowanie dnia za %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisão diária atualizada para %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Итоги дня за %@ обновлены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підсумки дня за %@ оновлено."
