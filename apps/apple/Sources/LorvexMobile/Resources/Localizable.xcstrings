    "tasks.empty.someday.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مهام \"يومًا ما\" هي التزامات مركونة جانبًا لا ينبغي أن تشتّت انتباهك اليوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“কোনোদিন” বিভাগের টাস্কগুলি তুলে রাখা অঙ্গীকার, যা আজকের দিনে মনোযোগ ভাঙবে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben unter „Irgendwann“ sind zurückgestellte Verpflichtungen, die heute nicht ablenken sollen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εργασίες «Κάποτε» είναι δεσμεύσεις σε αναμονή που δεν πρέπει να αποσπούν την προσοχή από τη σημερινή ημέρα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someday tasks are parked commitments that should not distract today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas de Algún día son compromisos en pausa que no deben distraerte hoy."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارهای «شاید بعدها» تعهدهای کنار گذاشته‌شده‌ای هستند که نباید امروز حواستان را پرت کنند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches « Un jour » sont des engagements mis de côté qui ne doivent pas distraire aujourd’hui."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משימות \"מתישהו\" הן התחייבויות שמוחזקות בצד כדי שלא יסיחו את הדעת היום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“किसी दिन” वाले कार्य अलग रखी गई वे प्रतिबद्धताएँ हैं जो आज का ध्यान न भटकाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas Suatu Hari adalah komitmen yang disisihkan dan tidak seharusnya mengganggu hari ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le attività “Prima o poi” sono impegni messi da parte che non devono distrarre oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「いつか」のタスクは、今日の妨げにならないよう脇に置いてある取り組みです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘언젠가’ 할 일은 오늘 일정에 방해가 되지 않도록 잠시 보류해 둔 일입니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "‘कधीतरी’ मधील कार्ये म्हणजे बाजूला ठेवलेल्या वचनबद्धता, ज्या आजच्या दिवसात अडथळा आणू नयेत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas Suatu Hari ialah komitmen yang diketepikan dan tidak sepatutnya mengganggu hari ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Taken onder ‘Ooit’ zijn geparkeerde toezeggingen die vandaag niet mogen afleiden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadania „Kiedyś” to odłożone zobowiązania, które nie powinny rozpraszać dzisiaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas “Algum dia” são compromissos guardados que não devem distrair você hoje."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarcinile din „Cândva” sunt angajamente puse deoparte, care nu ar trebui să vă distragă astăzi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задачи «Когда-нибудь» — это отложенные обязательства, которые не должны отвлекать сегодня."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "என்றாவது ஒரு நாள் பணிகள் என்பவை ஒதுக்கி வைக்கப்பட்டவை; அவை இன்றைய கவனத்தைச் சிதறடிக்கக் கூடாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏదో ఒక రోజు టాస్క్‌లు అంటే పక్కన పెట్టిన పనులు; అవి ఈరోజు మీ దృష్టిని మళ్ళించకూడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งาน “สักวัน” คือสิ่งที่ตั้งใจจะทำซึ่งพักไว้ก่อน เพื่อไม่ให้รบกวนวันนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Bir gün” görevleri, bugünün dikkatini dağıtmaması gereken, bekletilen taahhütlerdir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завдання «Колись» — це відкладені зобов’язання, які не мають відволікати сьогодні."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "\"کسی دن\" کے کام الگ رکھے گئے وعدے ہیں، تاکہ وہ آج آپ کا دھیان نہ بٹائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhiệm vụ Một ngày nào đó là những cam kết được cất riêng, không nên làm phân tâm hôm nay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“将来某天”里的任务是暂存的承诺，不应干扰今天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「將來某天」的任務是先放在一旁的待辦事項，不會干擾今天。"
          }
        }
      }
    },
