        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" کی یہ تکرار منسوخ کرتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hủy lần lặp này của %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
