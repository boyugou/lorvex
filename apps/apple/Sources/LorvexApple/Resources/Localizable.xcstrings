    "settings.open_at_login.approval": {
      "comment": "Shown beside a button while Lorvex's login item waits for the user to turn it on in System Settings. The path names the System Settings panes General and Login Items as the Mac shows them in the user's language.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل Lorvex في إعدادات النظام > عام > عناصر الدخول والملحقات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিস্টেম সেটিংস > সাধারণ > লগইন আইটেম-এ Lorvex চালু করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte Lorvex unter Systemeinstellungen > Allgemein > Anmeldeobjekte & Erweiterungen ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε το Lorvex στις Ρυθμίσεις συστήματος > Γενικά > Στοιχεία εισόδου και επεκτάσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Lorvex in System Settings > General > Login Items & Extensions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Lorvex en Ajustes del Sistema > General > Ítems de inicio y extensiones."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex را در تنظیمات سیستم > عمومی > موارد ورود روشن کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Lorvex dans Réglages Système > Général > Ouverture et extensions."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להפעיל את Lorvex בהגדרות המערכת > כללי > פריטי התחברות והרחבות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम सेटिंग्ज़ > सामान्य > लॉगइन आइटम और एक्सटेंशन में Lorvex चालू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan Lorvex di Pengaturan Sistem > Umum > Item Masuk & Ekstensi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Lorvex in Impostazioni di Sistema > Generali > Elementi login ed estensioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定」>「一般」>「ログイン項目と機能拡張」でLorvexをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 > 일반 > 로그인 항목 및 확장 프로그램에서 Lorvex를 켜세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टीम सेटिंग > सामान्य > लॉगिन आयटम मध्ये Lorvex चालू करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan Lorvex dalam Seting Sistem > Am > Item Log Masuk & Sambungan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet Lorvex aan in Systeeminstellingen > Algemeen > Inlogonderdelen en extensies."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz Lorvex w Ustawieniach systemowych > Ogólne > Rzeczy i rozszerzenia otwierane podczas logowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Lorvex em Ajustes do Sistema > Geral > Itens de Início de Sessão e Extensões."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activați Lorvex în Configurări sistem > General > Lansare la login și extensii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Lorvex в «Системные настройки» > «Основные» > «Объекты входа и расширения»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சிஸ்டம் அமைப்புகள் > பொது > உள்நுழைவு ஐட்டங்களில் Lorvexஐ ஆன் செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సిస్టమ్ సెట్టింగ్స్ > సాధారణం > లాగిన్ ఐటెమ్‌లలో Lorvexను ఆన్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Lorvex ในการตั้งค่าระบบ > ทั่วไป > รายการเข้าสู่ระบบและส่วนขยาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları > Genel > Oturum Açma Öğeleri ve Genişletmeler’de Lorvex’i açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть Lorvex у «Системні параметри» > «Загальні» > «Автозапуск і розширення»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سسٹم کی ترتیبات > عمومی > لاگ اِن آئٹمز میں Lorvex کو آن کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy bật Lorvex trong Cài đặt hệ thống > Cài đặt chung > Mục đăng nhập & Phần mở rộng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置”>“通用”>“登录项与扩展”中打开 Lorvex。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請前往「系統設定」>「一般」>「登入項目與延伸功能」打開 Lorvex。"
          }
        }
      }
    },
    "settings.open_at_login.detail": {
      "comment": "Footer under the Open at Login switch in Settings. Quick Capture is the small window that opens over any app; its name is the command's name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُفتح Lorvex عند تسجيل الدخول، فيكون شريط القوائم واختصار «إضافة سريعة» جاهزَين دائمًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লগইনের সময় Lorvex খুলে যায়, তাই মেনু বার আর “দ্রুত যোগ করুন” শর্টকাট সবসময় তৈরি থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex öffnet sich beim Anmelden, damit die Menüleiste und der Kurzbefehl für die Schnelleingabe immer bereit sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Lorvex ανοίγει κατά τη σύνδεση, ώστε η γραμμή μενού και η συντόμευση της Γρήγορης προσθήκης να είναι πάντα έτοιμες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex opens at login, so the menu bar and the Quick Capture shortcut are always ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex se abre al iniciar sesión, así que la barra de menús y el atajo de Captura rápida siempre están listos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex هنگام ورود باز می‌شود، پس نوار منو و میان‌بر افزودن سریع همیشه آماده‌اند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex s’ouvre à la connexion, pour que la barre des menus et le raccourci d’ajout rapide soient toujours prêts."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex נפתח בעת ההתחברות, כך שסרגל התפריטים וקיצור ההוספה המהירה תמיד מוכנים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉगिन करते ही Lorvex खुल जाता है, इसलिए मेन्यू बार और “तुरंत जोड़ें” शॉर्टकट हमेशा तैयार रहते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex terbuka saat login, sehingga bilah menu dan pintasan Catat Cepat selalu siap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex si apre al login, così la barra dei menu e la scorciatoia per l’aggiunta rapida sono sempre pronte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時にLorvexが開くので、メニューバーとクイック入力のショートカットをいつでも使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인할 때 Lorvex가 열려서 메뉴 막대와 빠른 추가 단축키를 언제든 쓸 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉगिन करताच Lorvex उघडते, त्यामुळे मेन्यू बार आणि “त्वरित जोडा” शॉर्टकट नेहमी तयार असतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex dibuka semasa log masuk, jadi bar menu dan pintasan Catat Cepat sentiasa sedia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex opent bij het inloggen, zodat de menubalk en de sneltoets voor Snel vastleggen altijd klaarstaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex otwiera się przy logowaniu, więc pasek menu i skrót Szybkiego dodawania są zawsze gotowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lorvex abre ao fazer login, para que a barra de menus e o atalho de Captura rápida estejam sempre prontos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex se deschide la autentificare, astfel încât bara de meniu și comanda rapidă Adăugare rapidă sunt mereu pregătite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex открывается при входе в систему, поэтому строка меню и сочетание клавиш быстрого добавления всегда под рукой."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex உள்நுழையும்போது திறக்கும், எனவே மெனு பார், விரைவுச் சேர்த்தல் சுருக்கவழி ஆகியவை எப்போதும் தயாராக இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex లాగిన్ సమయంలో తెరుచుకుంటుంది, కాబట్టి మెన్యూ బార్ మరియు త్వరిత జోడింపు షార్ట్‌కట్ ఎల్లప్పుడూ సిద్ధంగా ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex จะเปิดเมื่อเข้าสู่ระบบ เมนูบาร์และทางลัดจดงานจึงพร้อมใช้เสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex oturum açıldığında açılır; böylece menü çubuğu ve Hızlı ekle kısayolu her zaman hazır olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex відкривається під час входу в систему, тож рядок меню та комбінація клавіш швидкого додавання завжди напоготові."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لاگ اِن پر Lorvex کھل جاتا ہے، اس لیے مینو بار اور فوری اضافہ شارٹ کٹ ہمیشہ تیار رہتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex mở khi đăng nhập, nên thanh menu và phím tắt Ghi nhanh luôn sẵn sàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时自动打开 Lorvex，菜单栏和“快速收集”快捷键随时可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入時自動打開 Lorvex，選單列和「快速新增」快速鍵隨時可用。"
          }
        }
      }
    },
    "settings.open_at_login.failed": {
      "comment": "Footer under the Open at Login switch when changing it did not work. The path names the System Settings panes General and Login Items as the Mac shows them in the user's language.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Lorvex تغيير هذا الإعداد. استخدم إعدادات النظام > عام > عناصر الدخول والملحقات بدلًا من ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex এটি পরিবর্তন করতে পারেনি। এর বদলে সিস্টেম সেটিংস > সাধারণ > লগইন আইটেম ব্যবহার করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex konnte das nicht ändern. Verwende stattdessen Systemeinstellungen > Allgemein > Anmeldeobjekte & Erweiterungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Lorvex δεν μπόρεσε να αλλάξει αυτή τη ρύθμιση. Χρησιμοποιήστε αντί γι’ αυτό τις Ρυθμίσεις συστήματος > Γενικά > Στοιχεία εισόδου και επεκτάσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex couldn’t change this. Use System Settings > General > Login Items & Extensions instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex no pudo cambiar esto. Usa Ajustes del Sistema > General > Ítems de inicio y extensiones."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex نتوانست این مورد را تغییر دهد. به‌جای آن از تنظیمات سیستم > عمومی > موارد ورود استفاده کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex n’a pas pu modifier ce réglage. Utilisez plutôt Réglages Système > Général > Ouverture et extensions."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex לא הצליח לשנות זאת. יש להשתמש במקום זאת בהגדרות המערכת > כללי > פריטי התחברות והרחבות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex इसे बदल नहीं सका। इसके बजाय सिस्टम सेटिंग्ज़ > सामान्य > लॉगइन आइटम और एक्सटेंशन का उपयोग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex tidak dapat mengubah ini. Gunakan Pengaturan Sistem > Umum > Item Masuk & Ekstensi sebagai gantinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile modificarlo. Usa invece Impostazioni di Sistema > Generali > Elementi login ed estensioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexでは変更できませんでした。代わりに「システム設定」>「一般」>「ログイン項目と機能拡張」を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex에서 변경하지 못했습니다. 대신 시스템 설정 > 일반 > 로그인 항목 및 확장 프로그램을 이용하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex हे बदलू शकले नाही. त्याऐवजी सिस्टीम सेटिंग > सामान्य > लॉगिन आयटम वापरा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex tidak dapat mengubah ini. Gunakan Seting Sistem > Am > Item Log Masuk & Sambungan sebagai gantinya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex kon dit niet wijzigen. Gebruik in plaats daarvan Systeeminstellingen > Algemeen > Inlogonderdelen en extensies."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zmienić tego ustawienia. Użyj zamiast tego Ustawień systemowych > Ogólne > Rzeczy i rozszerzenia otwierane podczas logowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lorvex não conseguiu alterar isso. Use Ajustes do Sistema > Geral > Itens de Início de Sessão e Extensões."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex nu a putut modifica această setare. Folosiți în schimb Configurări sistem > General > Lansare la login și extensii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex не удалось изменить эту настройку. Используйте вместо этого «Системные настройки» > «Основные» > «Объекты входа и расширения»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex இதை மாற்ற முடியவில்லை. அதற்குப் பதிலாக சிஸ்டம் அமைப்புகள் > பொது > உள்நுழைவு ஐட்டங்களைப் பயன்படுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex దీన్ని మార్చలేకపోయింది. బదులుగా సిస్టమ్ సెట్టింగ్స్ > సాధారణం > లాగిన్ ఐటెమ్‌లను ఉపయోగించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex เปลี่ยนค่านี้ไม่ได้ ให้ใช้การตั้งค่าระบบ > ทั่วไป > รายการเข้าสู่ระบบและส่วนขยายแทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex bunu değiştiremedi. Bunun yerine Sistem Ayarları > Genel > Oturum Açma Öğeleri ve Genişletmeler’i kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex не вдалося змінити цей параметр. Скористайтеся натомість «Системні параметри» > «Загальні» > «Автозапуск і розширення»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex اسے تبدیل نہیں کر سکا۔ اس کے بجائے سسٹم کی ترتیبات > عمومی > لاگ اِن آئٹمز استعمال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex không thể thay đổi mục này. Hãy dùng Cài đặt hệ thống > Cài đặt chung > Mục đăng nhập & Phần mở rộng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 无法更改此设置。请改用“系统设置”>“通用”>“登录项与扩展”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 無法變更此設定。請改用「系統設定」>「一般」>「登入項目與延伸功能」。"
          }
        }
      }
    },
    "settings.open_at_login.open_settings": {
