    "habit_detail.weekdays.insight": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأقوى يوم %1$@، والأضعف يوم %2$@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সবচেয়ে ভালো দিন: %1$@, সবচেয়ে দুর্বল দিন: %2$@।"
