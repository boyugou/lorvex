    "system.habit.reminder.update.description": {
      "comment": "Description of the App Intent that changes a habit reminder's time or turns it on or off",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيير موعد تذكير عادة في Lorvex، أو تشغيله أو إيقافه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex অভ্যাসের রিমাইন্ডার কখন বাজবে তা বদলান, অথবা সেটি চালু বা বন্ধ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert, wann eine Lorvex-Gewohnheitserinnerung ausgelöst wird, oder schaltet sie ein oder aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αλλάξτε πότε χτυπά η υπόμνηση μιας συνήθειας Lorvex ή ενεργοποιήστε ή απενεργοποιήστε την."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change when a Lorvex habit reminder goes off, or turn it on or off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia la hora de un recordatorio de hábito de Lorvex, o lo activa o desactiva."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تغییر زمان فعال شدن یادآور یک عادت Lorvex، یا روشن یا خاموش کردن آن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifie l’heure d’un rappel d’habitude de Lorvex, ou l’active ou le désactive."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שינוי השעה שבה תזכורת של הרגל ב-Lorvex מופעלת, או הפעלה וכיבוי שלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex आदत के रिमाइंडर का समय बदलें, या उसे चालू या बंद करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengubah kapan pengingat kebiasaan Lorvex berbunyi, atau menyalakan atau mematikannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia l’ora di un promemoria di abitudine di Lorvex, oppure lo attiva o disattiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexの習慣のリマインダーの時刻を変更するか、オンまたはオフにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 습관 알림의 시간을 바꾸거나 알림을 켜거나 끕니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex सवयीचा रिमाइंडर केव्हा वाजेल ते बदला, किंवा तो चालू किंवा बंद करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengubah bila peringatan tabiat Lorvex berbunyi, atau mengaktifkan atau menyahaktifkannya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigt wanneer een Lorvex-gewoonteherinnering afgaat, of zet die aan of uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmienia godzinę przypomnienia dla nawyku Lorvex albo je włącza lub wyłącza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altera o horário de um lembrete de hábito do Lorvex ou o ativa ou desativa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifică momentul în care se declanșează un memento de obicei Lorvex sau îl activează ori îl dezactivează."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняет время напоминания для привычки Lorvex или включает и выключает его."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex பழக்க நினைவூட்டல் எப்போது வர வேண்டும் என்பதை மாற்றவும், அல்லது அதை ஆன் அல்லது ஆஃப் செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex అలవాటు రిమైండర్ ఎప్పుడు వస్తుందో మార్చండి, లేదా దాన్ని ఆన్ లేదా ఆఫ్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนเวลาที่เตือนความจำของนิสัย Lorvex จะดังขึ้น หรือเปิดหรือปิดเตือนความจำนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Lorvex alışkanlığı anımsatıcısının ne zaman çalacağını değiştirin ya da anımsatıcıyı açın veya kapatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінює час нагадування для звички Lorvex або вмикає чи вимикає його."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی Lorvex عادت کی یاد دہانی کا وقت بدلیں، یا اسے آن یا بند کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi thời điểm lời nhắc thói quen Lorvex kích hoạt, hoặc bật hay tắt lời nhắc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改一个 Lorvex 习惯提醒的时间，或将其打开或关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改 Lorvex 習慣提醒的時間，或將其開啟或關閉。"
          }
        }
      }
    },
    "system.habit.reminder.update.off_dialog": {
      "comment": "Siri reply after turning off a habit reminder; %1$@ is the habit's name, %2$@ the reminder's clock time",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إيقاف تذكير %1$@ عند %2$@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” অভ্যাসের %2$@ সময়ের রিমাইন্ডার বন্ধ করা হয়েছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerung für %1$@ um %2$@ ausgeschaltet."
