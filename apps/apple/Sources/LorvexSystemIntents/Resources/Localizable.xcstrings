    "system.review.weekly.read.description": {
      "comment": "Description for the Read Lorvex Weekly Review App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة لقطة المراجعة الأسبوعية في Lorvex."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex সাপ্তাহিক পর্যালোচনার স্ন্যাপশট পড়ুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest den Snapshot des Lorvex-Wochenrückblicks."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαβάστε τη σύνοψη της εβδομαδιαίας ανασκόπησης Lorvex."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the Lorvex weekly review snapshot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee la instantánea de la revisión semanal de Lorvex."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خواندن اسنپ‌شات مرور هفتگی Lorvex."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit l’instantané du bilan hebdomadaire de Lorvex."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קריאת תמונת המצב של הסקירה השבועית ב-Lorvex."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex की साप्ताहिक समीक्षा का स्नैपशॉट पढ़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca snapshot tinjauan mingguan Lorvex."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge l’istantanea della revisione settimanale di Lorvex."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexの毎週の振り返りのスナップショットを読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 주간 회고 스냅샷을 읽습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex साप्ताहिक आढाव्याचा स्नॅपशॉट वाचा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca syot kilat semakan mingguan Lorvex."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest de snapshot van de Lorvex-weekterugblik."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytuje bieżące podsumowanie tygodnia Lorvex."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê o instantâneo da revisão semanal do Lorvex."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Citește instantaneul recapitulării săptămânale Lorvex."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает текущие итоги недели Lorvex."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex வாராந்தர மீள்பார்வை ஸ்னாப்ஷாட்டைப் படிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex వారంవారీ సమీక్ష స్నాప్‌షాట్‌ను చదవండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านสรุปการทบทวนรายสัปดาห์ของ Lorvex"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex haftalık gözden geçirme özetini okuyun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читає поточні підсумки тижня Lorvex."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہفتہ وار جائزے کا اسنیپ شاٹ Lorvex سے پڑھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc ảnh chụp nhanh tổng kết hàng tuần của Lorvex."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取 Lorvex 每周回顾快照。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取 Lorvex 每週回顧快照。"
          }
        }
      }
    },
    "system.review.weekly.read.dialog": {
      "comment": "Siri's answer after reading the weekly review. Argument: tasks completed this week.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "اكتملت %lld مهام هذا الأسبوع."
                }
              },
              "many": {
