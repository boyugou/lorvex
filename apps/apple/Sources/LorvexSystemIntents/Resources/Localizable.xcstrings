    "system.calendar.update.description": {
      "comment": "Description for the Update Lorvex Calendar Event App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحديث حدث تقويم Lorvex من الاختصارات أو Siri."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শর্টকাট বা Siri থেকে একটি Lorvex ক্যালেন্ডার ইভেন্ট আপডেট করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiert ein Ereignis im Lorvex-Kalender über Kurzbefehle oder Siri."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενημερώστε ένα γεγονός ημερολογίου Lorvex από τις Συντομεύσεις ή το Siri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update a Lorvex calendar event from Shortcuts or Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza un evento de calendario de Lorvex desde Atajos o Siri."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به‌روزرسانی رویداد تقویم Lorvex از طریق میان‌برها یا Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met à jour un événement du calendrier de Lorvex depuis Raccourcis ou Siri."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדכון אירוע בלוח השנה של Lorvex דרך קיצורי דרך או Siri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट्स या Siri से Lorvex कैलेंडर इवेंट अपडेट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memperbarui acara kalender Lorvex dari Pintasan atau Siri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna un evento del calendario di Lorvex da Comandi rapidi o Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットまたはSiriでLorvexのカレンダーイベントを更新します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어 또는 Siri에서 Lorvex 캘린더 이벤트를 업데이트합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट किंवा Siri द्वारे एक Lorvex दिनदर्शिका इव्हेंट अपडेट करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengemas kini peristiwa kalendar Lorvex daripada Pintasan atau Siri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werkt een activiteit in de Lorvex-agenda bij via Opdrachten of Siri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizuje wydarzenie kalendarza Lorvex ze Skrótów lub Siri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualiza um evento do calendário do Lorvex pelos Atalhos ou pela Siri."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizează un eveniment din calendarul Lorvex prin Scurtături sau Siri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновляет событие календаря Lorvex из «Быстрых команд» или Siri."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்கவழிகள் அல்லது Siri மூலம் Lorvex கேலண்டர் நிகழ்வைப் புதுப்பிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "షార్ట్‌కట్స్ లేదా Siri నుండి Lorvex క్యాలెండర్ ఇవెంట్‌ను అప్‌డేట్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปเดตกิจกรรมปฏิทิน Lorvex จากคำสั่งลัดหรือ Siri"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kestirmeler veya Siri ile bir Lorvex takvim etkinliğini güncelleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновлює подію календаря Lorvex зі «Швидких команд» або Siri."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شارٹ کٹس یا Siri سے Lorvex کیلنڈر ایونٹ اپ ڈیٹ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cập nhật một sự kiện lịch Lorvex từ Phím tắt hoặc Siri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“快捷指令”或 Siri 更新一个 Lorvex 日历事件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過捷徑或 Siri 更新 Lorvex 行事曆事件。"
          }
        }
      }
    },
