            "value": "Identique sur chaque appareil"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אותו דבר בכל מכשיר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर डिवाइस पर एक जैसा"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sama di setiap perangkat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uguale su ogni dispositivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのデバイスでも同じ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기기에서 동일하게"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक डिव्हाइसवर सारखेच"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sama pada setiap peranti"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op elk apparaat hetzelfde"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To samo na każdym urządzeniu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Igual em todos os dispositivos"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La fel pe fiecare dispozitiv"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно и то же на всех устройствах"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เหมือนกันบนทุกอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her aygıtta aynı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Те саме на всіх пристроях"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر ڈیوائس پر یکساں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giống nhau trên mọi thiết bị"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有设备保持一致"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每台裝置都一致"
          }
        }
      }
    },
    "setup.sync.devices.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى مهامك وقوائمك وعاداتك متطابقة على Mac وiPhone وiPad."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার Mac, iPhone ও iPad-এ আপনার টাস্ক, তালিকা ও অভ্যাস একসাথে মিলে থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Aufgaben, Listen und Gewohnheiten bleiben auf deinem Mac, iPhone und iPad auf demselben Stand."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εργασίες, οι λίστες και οι συνήθειές σας παραμένουν συγχρονισμένες σε Mac, iPhone και iPad."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tasks, lists, and habits stay in step on your Mac, iPhone, and iPad."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus tareas, listas y hábitos se mantienen al día en el Mac, el iPhone y el iPad."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارها، فهرست‌ها و عادت‌های شما در Mac، iPhone و iPad هماهنگ می‌مانند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos tâches, listes et habitudes restent synchronisées sur votre Mac, votre iPhone et votre iPad."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשימות, הרשימות וההרגלים שלך נשארים מסונכרנים ב-Mac, ב-iPhone וב-iPad."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके कार्य, सूचियाँ और आदतें आपके Mac, iPhone और iPad पर एक जैसी रहती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas, daftar, dan kebiasaan tetap selaras di Mac, iPhone, dan iPad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue attività, liste e abitudini restano allineate su Mac, iPhone e iPad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスク、リスト、習慣は、Mac、iPhone、iPadで同じ状態に保たれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일, 목록, 습관이 Mac, iPhone, iPad에서 항상 동일하게 유지됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या Mac, iPhone आणि iPad वर तुमची कार्ये, याद्या आणि सवयी सारख्या राहतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas, senarai dan tabiat kekal selaras pada Mac, iPhone dan iPad."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je taken, lijsten en gewoontes blijven op je Mac, iPhone en iPad gelijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadania, listy i nawyki są takie same na Macu, iPhonie i iPadzie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas tarefas, listas e hábitos ficam em sincronia no seu Mac, iPhone e iPad."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarcinile, listele și obiceiurile se mențin sincronizate pe Mac, iPhone și iPad."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задачи, списки и привычки совпадают на вашем Mac, iPhone и iPad."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งาน ลิสต์ และนิสัยของคุณตรงกันทั้งบน Mac, iPhone และ iPad"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’inizde, iPhone’unuzda ve iPad’inizde görevleriniz, listeleriniz ve alışkanlıklarınız hep aynı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завдання, списки й звички збігаються на вашому Mac, iPhone та iPad."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے کام، فہرستیں اور عادات آپ کے Mac، iPhone اور iPad پر ہم آہنگ رہتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhiệm vụ, danh sách và thói quen luôn đồng bộ trên Mac, iPhone và iPad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务、列表和习惯在 Mac、iPhone 和 iPad 上同步更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的任務、清單和習慣會在 Mac、iPhone 和 iPad 上保持同步。"
          }
        }
      }
    },
