            "state": "translated",
            "value": "Prepare a Lorvex JSON or CSV data export from Shortcuts or Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara una exportación de datos de Lorvex en JSON o CSV desde Atajos o Siri."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آماده‌سازی خروجی داده‌های Lorvex به‌صورت JSON یا CSV از طریق میان‌برها یا Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prépare une exportation des données de Lorvex en JSON ou CSV depuis Raccourcis ou Siri."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכנת ייצוא נתוני Lorvex בפורמט JSON או CSV דרך קיצורי דרך או Siri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट्स या Siri से Lorvex का JSON या CSV डेटा एक्सपोर्ट तैयार करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyiapkan ekspor data Lorvex dalam format JSON atau CSV dari Pintasan atau Siri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara un’esportazione dei dati di Lorvex in JSON o CSV da Comandi rapidi o Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットまたはSiriで、LorvexのデータをJSONまたはCSVで書き出す準備をします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어 또는 Siri에서 Lorvex 데이터를 JSON 또는 CSV로 내보낼 준비를 합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट किंवा Siri द्वारे Lorvex डेटाचा JSON किंवा CSV एक्सपोर्ट तयार करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyediakan eksport data Lorvex dalam format JSON atau CSV daripada Pintasan atau Siri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereidt een Lorvex-gegevensexport als JSON of CSV voor via Opdrachten of Siri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przygotowuje eksport danych Lorvex w formacie JSON lub CSV ze Skrótów lub Siri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara uma exportação dos dados do Lorvex em JSON ou CSV pelos Atalhos ou pela Siri."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregătește un export de date Lorvex în format JSON sau CSV prin Scurtături sau Siri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готовит экспорт данных Lorvex в формате JSON или CSV из «Быстрых команд» или Siri."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்கவழிகள் அல்லது Siri மூலம் Lorvex JSON அல்லது CSV தரவு எக்ஸ்போர்ட்டைத் தயார் செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "షార్ట్‌కట్స్ లేదా Siri నుండి Lorvex JSON లేదా CSV డేటా ఎక్స్‌పోర్ట్‌ను తయారు చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เตรียมการส่งออกข้อมูล Lorvex เป็น JSON หรือ CSV จากคำสั่งลัดหรือ Siri"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kestirmeler veya Siri ile bir Lorvex JSON ya da CSV veri dışa aktarımı hazırlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готує експорт даних Lorvex у форматі JSON або CSV зі «Швидких команд» або Siri."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شارٹ کٹس یا Siri سے Lorvex ڈیٹا کا JSON یا CSV ایکسپورٹ تیار کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuẩn bị bản xuất dữ liệu Lorvex dạng JSON hoặc CSV từ Phím tắt hoặc Siri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“快捷指令”或 Siri 准备 Lorvex JSON 或 CSV 数据导出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過捷徑或 Siri 準備 Lorvex 資料的 JSON 或 CSV 匯出檔。"
          }
        }
      }
    },
