    "habits.sheet.field.milestone_goal_hint_count": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفل عند هذا العدد من الإكمالات. تستمر العادة بعد ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই সংখ্যক বার সম্পন্ন হলে উদযাপন হবে। এরপরও অভ্যাসটি চলতে থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei dieser Anzahl an Erledigungen wird gefeiert. Die Gewohnheit läuft danach weiter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γιορτάστε όταν φτάσετε αυτό το πλήθος ολοκληρώσεων. Η συνήθεια συνεχίζεται και μετά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Celebrate at this many completions. The habit keeps going after."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Celebra al llegar a este número de registros. El hábito continúa después."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با رسیدن به این تعداد تکمیل جشن می‌گیرید. عادت پس از آن ادامه دارد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Célébrez à ce nombre de réalisations. L’habitude continue ensuite."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חוגגים בהגעה למספר ההשלמות הזה. ההרגל נמשך לאחר מכן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इतने चेक-इन पूरे होने पर जश्न मनाएँ। उसके बाद भी आदत जारी रहती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rayakan pada jumlah penyelesaian ini. Kebiasaan tetap berlanjut setelahnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Festeggia a questo numero di completamenti. L’abitudine continua anche dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この完了回数に達したらお祝いします。習慣はその後も続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 완료 횟수에 도달하면 축하합니다. 이후에도 습관은 계속됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "इतक्या वेळा पूर्ण झाल्यावर उत्सव साजरा केला जाईल. त्यानंतरही सवय सुरू राहते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Raikan pada bilangan penyelesaian ini. Tabiat terus berjalan selepas itu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij dit aantal keren wordt er gevierd. De gewoonte gaat daarna door."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczba wykonań, którą warto uczcić. Nawyk trwa także po jej osiągnięciu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comemore ao atingir este número de conclusões. O hábito continua depois disso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La acest număr de finalizări se sărbătorește. Obiceiul continuă și după aceea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Число выполнений, которое стоит отпраздновать. Привычка продолжается и после этого."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இத்தனை முறை முடிக்கும்போது கொண்டாடவும். அதற்குப் பிறகும் பழக்கம் தொடரும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇన్ని సార్లు పూర్తి చేసినప్పుడు వేడుక చేసుకోండి. ఆ తర్వాత కూడా అలవాటు కొనసాగుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉลองเมื่อทำครบจำนวนครั้งนี้ นิสัยนี้จะดำเนินต่อไปหลังจากนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kadar tamamlamaya ulaşınca kutlanır. Alışkanlık sonrasında da devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кількість виконань, яку варто відсвяткувати. Звичка триває й після цього."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اتنی تکمیلات پر جشن منائیں۔ عادت اس کے بعد بھی جاری رہتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ăn mừng khi đạt số lần hoàn thành này. Thói quen vẫn tiếp tục sau đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "达到这么多次完成时庆祝。习惯之后仍会继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "達到這個完成次數時會慶祝一下，習慣之後仍會繼續。"
          }
        }
      }
    },
