          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarefa foi cancelada. Reabra-a antes de concluí-la."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această sarcină a fost anulată. Redeschideți-o înainte de a o finaliza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта задача отменена. Чтобы выполнить её, сначала откройте её снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це завдання скасовано. Щоб виконати його, спершу відкрийте його знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ کام منسوخ کر دیا گیا تھا۔ مکمل کرنے سے پہلے اسے دوبارہ کھولیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个任务已取消，请先重新打开再完成。"
          }
        },
        "zh-Hant": {
