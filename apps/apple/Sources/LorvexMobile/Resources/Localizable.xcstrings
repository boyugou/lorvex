    "tasks.empty.message": {
      "comment": "Empty-state description when there are no open tasks",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مهمة للبدء، أو اطلب من مساعد الذكاء الاصطناعي أن يخطط يومك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture a task to get started — or ask your AI assistant to plan your day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una tarea para empezar o pide a tu asistente de IA que planifique tu día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une tâche pour commencer, ou demandez à votre assistant IA de planifier votre journée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू करने के लिए कोई कार्य जोड़ें, या अपने AI असिस्टेंट से अपना दिन प्लान करने को कहें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un’attività per iniziare oppure chiedi al tuo assistente IA di pianificare la tua giornata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクを追加して始めましょう。または、AIアシスタントに1日の計画を頼むこともできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일을 추가해 시작해 보세요. 또는 AI 어시스턴트에게 하루 계획을 부탁할 수도 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj zadanie, aby zacząć — albo poproś asystenta AI o zaplanowanie dnia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma tarefa para começar ou peça ao seu assistente de IA para planejar seu dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте задачу, чтобы начать. Или попросите ИИ-ассистента спланировать ваш день."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте завдання, щоб почати. Або попросіть ШІ-асистента спланувати ваш день."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加一个任务即可开始——或让你的 AI 助手为你规划这一天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增一個任務來開始，或請你的 AI 助理規劃你的一天。"
          }
        }
      }
    },
    "tasks.empty.open.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مهمة أو اطلب من المساعد تخطيط العمل المفيد التالي."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture a task or ask the assistant to plan the next useful work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una tarea o pide al asistente que planifique el siguiente trabajo útil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une tâche ou demandez à l’assistant de planifier la prochaine chose utile à faire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई कार्य जोड़ें या असिस्टेंट से अगला उपयोगी काम प्लान करने को कहें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un’attività oppure chiedi all’assistente di pianificare il prossimo lavoro utile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクを追加するか、次に取り組むとよいことをアシスタントに計画してもらいましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일을 추가하거나, 어시스턴트에게 다음에 하면 좋은 일을 계획해 달라고 요청해 보세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj zadanie lub poproś asystenta o zaplanowanie kolejnych pożytecznych działań."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma tarefa ou peça ao assistente para planejar o próximo trabalho útil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте задачу или попросите ассистента спланировать ближайшие полезные дела."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте завдання або попросіть асистента спланувати найближчі корисні справи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加一个任务，或让助手规划下一件有价值的事。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增任務，或請助理規劃接下來最值得做的事。"
          }
        }
      }
    },
