    "reviews.weekly.empty.message": {
      "comment": "macOS week review empty state message.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر الأسبوع هنا بمجرد أن يكون لدى Lorvex نشاط للمهام يمكن تلخيصه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সারসংক্ষেপ তৈরি করার মতো টাস্ক অ্যাক্টিভিটি Lorvex-এ থাকলে সপ্তাহটি এখানে দেখা যাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Woche erscheint hier, sobald Lorvex Aufgabenaktivität zum Zusammenfassen hat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εβδομάδα εμφανίζεται εδώ μόλις το Lorvex έχει δραστηριότητα εργασιών για σύνοψη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The week appears here once Lorvex has task activity to summarize."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La semana aparece aquí cuando Lorvex tenga actividad de tareas que resumir."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی Lorvex فعالیتی در کارها برای خلاصه‌کردن داشته باشد، هفته در اینجا نمایش داده می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La semaine apparaît ici dès que Lorvex a de l’activité à résumer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השבוע יופיע כאן כשתהיה פעילות במשימות ב-Lorvex לסיכום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब Lorvex के पास सार निकालने लायक कार्य गतिविधि होगी, तब सप्ताह यहाँ दिखेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Minggu ini akan muncul di sini setelah Lorvex memiliki aktivitas tugas untuk dirangkum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La settimana apparirà qui non appena Lorvex avrà attività da riassumere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要約できるタスクのアクティビティがLorvexに記録されると、ここに今週の内容が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex에 요약할 할 일 활동이 생기면 이번 주 내용이 여기에 표시됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सारांश देण्यासाठी Lorvex मध्ये कार्य ॲक्टिव्हिटी झाल्यावर आठवडा येथे दिसेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Minggu ini akan muncul di sini setelah Lorvex mempunyai aktiviti tugas untuk diringkaskan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De week verschijnt hier zodra Lorvex taakactiviteit heeft om samen te vatten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsumowanie tygodnia pojawi się tutaj, gdy w Lorvex pojawi się aktywność związana z zadaniami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A semana aparece aqui quando o Lorvex tiver atividade de tarefas para resumir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Săptămâna apare aici imediat ce Lorvex are activitate cu sarcini de rezumat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Итоги недели появятся здесь, как только в Lorvex накопится активность по задачам."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்கமாகக் காட்ட Lorvexஇல் பணிச் செயல்பாடு இருக்கும்போது வாரம் இங்கே தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సారాంశం ఇవ్వడానికి Lorvexలో టాస్క్ యాక్టివిటి ఉన్నప్పుడు వారం ఇక్కడ కనిపిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สัปดาห์จะปรากฏที่นี่เมื่อ Lorvex มีกิจกรรมของงานให้สรุป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex’in özetleyebileceği görev etkinliği oluştuğunda hafta burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підсумки тижня з’являться тут, щойно в Lorvex накопичиться активність із завданнями."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب Lorvex کے پاس خلاصہ کرنے کے لیے کاموں کی سرگرمی ہو گی تو ہفتہ یہاں نظر آئے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuần này sẽ xuất hiện tại đây khi Lorvex có hoạt động nhiệm vụ để tóm tắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有了任务记录后，这里会总结这一周。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當 Lorvex 有可摘要的任務活動時，這一週的內容會顯示在這裡。"
          }
        }
      }
    },
