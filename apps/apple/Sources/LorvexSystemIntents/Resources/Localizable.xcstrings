    "system.task.reminders.due.read.description": {
      "comment": "Description for the Read Lorvex Due Task Reminders App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة تذكيرات مهام Lorvex التي حان موعدها وما زالت قيد الانتظار."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে অপেক্ষমাণ Lorvex টাস্ক রিমাইন্ডারের সময় হয়েছে সেগুলি পড়ুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest ausstehende Lorvex-Aufgabenerinnerungen, die fällig sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαβάστε τις εκκρεμείς υπομνήσεις εργασιών Lorvex των οποίων έφτασε η ώρα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read pending Lorvex task reminders that are due."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee los recordatorios pendientes de tareas de Lorvex cuya hora ya ha llegado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خواندن یادآورهای در انتظار کارهای Lorvex که سررسید شده‌اند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit les rappels de tâches de Lorvex en attente qui sont échus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קריאת תזכורות ממתינות של משימות ב-Lorvex שהגיע זמנן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex कार्यों के वे लंबित रिमाइंडर पढ़ें जिनका समय हो चुका है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca pengingat tugas Lorvex yang masih menunggu dan sudah jatuh tempo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge i promemoria in sospeso delle attività di Lorvex che sono scaduti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻になった、保留中のLorvexのタスクのリマインダーを読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간이 된 대기 중인 Lorvex 할 일 알림을 읽습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ज्यांची वेळ झाली आहे असे प्रलंबित Lorvex कार्य रिमाइंडर वाचा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca peringatan tugas Lorvex yang masih menunggu dan telah tiba masanya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest openstaande Lorvex-taakherinneringen die nu aan de beurt zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytuje oczekujące przypomnienia zadań Lorvex, których czas już nadszedł."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê os lembretes pendentes de tarefas do Lorvex que estão vencidos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Citește mementourile sarcinilor Lorvex în așteptare care sunt scadente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает ожидающие напоминания задач Lorvex, время которых уже наступило."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நேரம் வந்துவிட்ட, நிலுவையில் உள்ள Lorvex பணி நினைவூட்டல்களைப் படிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సమయం వచ్చిన పెండింగ్ Lorvex టాస్క్ రిమైండర్‌లను చదవండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านเตือนความจำงาน Lorvex ที่รอดำเนินการและถึงเวลาแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanı gelmiş bekleyen Lorvex görev anımsatıcılarını okuyun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читає очікувані нагадування завдань Lorvex, час яких уже настав."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کاموں کی وہ باقی یاد دہانیاں Lorvex سے پڑھیں جن کا وقت آ چکا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc các lời nhắc nhiệm vụ Lorvex đang chờ và đã đến hạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取已经到期的待处理 Lorvex 任务提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取已到時間、待處理的 Lorvex 任務提醒。"
          }
        }
      }
    },
