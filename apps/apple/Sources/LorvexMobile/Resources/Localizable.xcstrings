    "settings.calendar_export.footer": {
      "comment": "Footer under the calendar export in Settings › Data Export.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أحداثك من اليوم حتى الثلاثين يومًا التالية، كملف ICS يمكن لتطبيقات التقويم الأخرى استيراده."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ থেকে পরবর্তী 30 দিন পর্যন্ত আপনার ইভেন্ট, একটি .ics ফাইল হিসাবে, যা অন্য ক্যালেন্ডার অ্যাপ ইম্পোর্ট করতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Ereignisse ab heute für die nächsten 30 Tage als .ics-Datei, die andere Kalender-Apps importieren können."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα γεγονότα σας από σήμερα έως τις επόμενες 30 ημέρες, ως αρχείο .ics που μπορούν να εισαγάγουν άλλες εφαρμογές ημερολογίου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your events from today through the next 30 days, as an .ics file other calendar apps can import."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus eventos desde hoy y durante los próximos 30 días, en un archivo .ics que otras apps de calendario pueden importar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رویدادهای شما از امروز تا سی روز آینده، به‌صورت فایل ICS که برنامه‌های تقویم دیگر می‌توانند وارد کنند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos événements d’aujourd’hui et des 30 prochains jours, sous forme de fichier .ics que d’autres apps de calendrier peuvent importer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האירועים שלך מהיום ועד 30 הימים הבאים, כקובץ ICS שאפליקציות לוח שנה אחרות יכולות לייבא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज से अगले 30 दिनों तक के आपके इवेंट, .ics फ़ाइल के रूप में, जिसे दूसरे कैलेंडर ऐप इंपोर्ट कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Acara dari hari ini hingga 30 hari ke depan, sebagai file .ics yang dapat diimpor app kalender lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi eventi da oggi ai prossimi 30 giorni, come file .ics che altre app di calendario possono importare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日から30日間のイベントを、他のカレンダーAppで読み込める.icsファイルとして書き出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘부터 30일 동안의 이벤트를 다른 캘린더 앱에서 가져올 수 있는 .ics 파일로 내보냅니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आजपासून पुढील 30 दिवसांपर्यंतचे तुमचे इव्हेंट, एका .ics फाइलच्या रूपात, जी इतर दिनदर्शिका ॲप्स इम्पोर्ट करू शकतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peristiwa dari hari ini sehingga 30 hari akan datang, sebagai fail .ics yang boleh diimport oleh app kalendar lain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je activiteiten vanaf vandaag voor de komende 30 dagen, als .ics-bestand dat andere agenda-apps kunnen importeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje wydarzenia od dziś na 30 dni do przodu jako plik .ics, który można zaimportować do innych aplikacji kalendarzowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus eventos de hoje até os próximos 30 dias, como um arquivo .ics que outros apps de calendário podem importar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Evenimentele de astăzi și din următoarele 30 de zile, ca fișier .ics pe care alte aplicații de calendar îl pot importa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши события с сегодняшнего дня на 30 дней вперёд в виде файла .ics, который можно импортировать в другие календарные приложения."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்று முதல் அடுத்த 30 நாட்கள் வரையிலான உங்கள் நிகழ்வுகள், பிற கேலண்டர் செயலிகள் இம்போர்ட் செய்யக்கூடிய .ics கோப்பாக."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈరోజు నుండి తదుపరి 30 రోజుల వరకు మీ ఇవెంట్‌లు, ఇతర క్యాలెండర్ యాప్‌లు ఇంపోర్ట్ చేయగల .ics ఫైల్‌గా."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กิจกรรมของคุณตั้งแต่วันนี้ไปอีก 30 วัน เป็นไฟล์ .ics ที่แอปปฏิทินอื่นนำเข้าได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünden itibaren önümüzdeki 30 güne ait etkinlikleriniz, diğer takvim uygulamalarının içe aktarabileceği bir .ics dosyası olarak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші події від сьогоднішнього дня на 30 днів уперед у вигляді файлу .ics, який можна імпортувати в інші календарні програми."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج سے اگلے 30 دنوں تک آپ کے ایونٹس، ICS فائل کی صورت میں جسے دوسری کیلنڈر ایپس امپورٹ کر سکتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các sự kiện từ hôm nay đến 30 ngày tới, dưới dạng tệp .ics mà các ứng dụng lịch khác có thể nhập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从今天起 30 天内的日程，导出为其他日历应用可以导入的 .ics 文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將今天起 30 天內的事件匯出為其他行事曆 App 可匯入的 .ics 檔案。"
          }
        }
      }
    },
