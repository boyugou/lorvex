    "memory.composer.footer": {
      "comment": "Footer under the New Memory sheet fields",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المفتاح القصير هو اسم الإدخال، أما المحتوى فهو ما يتذكره مساعدك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছোট একটি কী মেমোরির নাম নির্ধারণ করে; বিষয়বস্তু হলো যা আপনার অ্যাসিস্ট্যান্ট মনে রাখে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kurzer Schlüssel benennt den Eintrag; der Inhalt ist das, woran sich dein Assistent erinnert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα σύντομο κλειδί ονομάζει την καταχώριση, ενώ το περιεχόμενο είναι όσα θυμάται ο βοηθός σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A short key names the memory; the content is what your assistant recalls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una clave corta da nombre al recuerdo; el contenido es lo que recuerda tu asistente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک کلید کوتاه نام حافظه را تعیین می‌کند؛ محتوا همان چیزی است که دستیارتان به یاد می‌آورد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une clé courte nomme le souvenir ; le contenu est ce dont se souvient votre assistant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפתח קצר נותן שם לזיכרון; התוכן הוא מה שהעוזר שלך זוכר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छोटी कुंजी मेमोरी का नाम तय करती है; सामग्री वही है जो आपका असिस्टेंट याद रखता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci singkat menamai memori; konten adalah yang diingat asisten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una chiave breve dà un nome al ricordo; il contenuto è ciò che il tuo assistente ricorda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短いキーでメモリに名前を付けます。内容は、アシスタントが思い出す情報です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧은 키가 메모리의 이름이 되고, 내용은 어시스턴트가 기억해 두는 정보입니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एक छोटी की मेमरीला नाव देते; मजकूर म्हणजे तुमचा सहाय्यक जे लक्षात ठेवतो ते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci ringkas menamakan memori; kandungan ialah apa yang diingati pembantu AI."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een korte sleutel geeft het item een naam; de inhoud is wat je assistent onthoudt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krótki klucz nazywa wpis, a treść jest tym, co pamięta twój asystent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma chave curta dá nome à memória; o conteúdo é o que seu assistente lembra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O cheie scurtă dă un nume înregistrării; conținutul este ceea ce reține asistentul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Короткий ключ — это название записи, а содержимое — то, что помнит ваш ассистент."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு குறுகிய கீ இந்த நினைவகப் பதிவுக்குப் பெயரிடுகிறது; உங்கள் அசிஸ்டென்ட் நினைவில் வைத்திருப்பது உள்ளடக்கம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చిన్న కీ ఈ మెమరీకి పేరు పెడుతుంది; మీ అసిస్టెంట్ గుర్తుంచుకునేది కంటెంట్."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์สั้นใช้ตั้งชื่อรายการหน่วยความจำ ส่วนเนื้อหาคือสิ่งที่ผู้ช่วยของคุณจดจำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısa bir anahtar bellek girdisini adlandırır; içerik, asistanınızın hatırladığı şeydir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Короткий ключ — це назва запису, а вміст — те, що пам’ятає ваш асистент."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک مختصر کلید حافظے کا نام بتاتی ہے؛ مواد وہ ہے جو آپ کا اسسٹنٹ یاد رکھتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa ngắn đặt tên cho mục ghi nhớ; nội dung là điều trợ lý ghi nhớ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键是这条记忆的简短名称；内容是助手会回忆起的信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簡短的鍵是這則記憶的名稱，內容則是助理會回想起的資訊。"
          }
        }
      }
    },
    "memory.detail.empty.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر إدخالًا لقراءته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পড়ার জন্য একটি মেমোরি বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Gedächtniseintrag aus, um ihn zu lesen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε μια καταχώριση μνήμης για να τη διαβάσετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a memory to read it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un recuerdo para leerlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای خواندن، یک مورد حافظه را انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un souvenir pour le lire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור רשומת זיכרון כדי לקרוא אותה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पढ़ने के लिए कोई मेमोरी चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih memori untuk membacanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un ricordo per leggerlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモリを選択すると、内容を読めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모리를 선택하면 내용을 읽을 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वाचण्यासाठी एक मेमरी निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih memori untuk membacanya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een geheugenitem om het te lezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz wpis, aby go przeczytać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma memória para lê-la."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți o înregistrare din memorie pentru a o citi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите запись, чтобы прочитать её."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "படிக்க ஒரு நினைவகப் பதிவைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చదవడానికి ఒక మెమరీ నమోదును ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกรายการหน่วยความจำเพื่ออ่าน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okumak için bir bellek girdisi seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть запис, щоб прочитати його."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پڑھنے کے لیے کوئی حافظہ اندراج منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một mục ghi nhớ để đọc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一条记忆，阅读它的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一則記憶即可閱讀。"
          }
        }
      }
    },
