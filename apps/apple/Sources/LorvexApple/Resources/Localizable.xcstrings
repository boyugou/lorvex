    "list_row.delete.archived_nonempty_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن حذف هذه القائمة ما دامت تحتوي على مهام. ألغِ أرشفتها لاستعادة القائمة ومهامها، ثم انقل المهام أو امسحها قبل حذفها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Liste kann nicht gelöscht werden, solange sie noch Aufgaben enthält. Hebe die Archivierung auf, um die Liste und ihre Aufgaben wiederherzustellen, und verschiebe oder entferne die Aufgaben, bevor du die Liste löschst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This list can’t be deleted while it still holds tasks. Unarchive it to restore the list and its tasks, then move or clear them before deleting it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta lista no se puede eliminar mientras contenga tareas. Desarchívala para restaurar la lista y sus tareas; luego muévelas o elimínalas antes de eliminar la lista."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تا زمانی که این فهرست کار دارد قابل حذف نیست. آن را از بایگانی خارج کنید تا فهرست و کارهایش بازگردانده شوند؛ سپس پیش از حذف، کارها را منتقل یا پاک کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette liste ne peut pas être supprimée tant qu’elle contient des tâches. Désarchivez-la pour restaurer la liste et ses tâches, puis déplacez-les ou supprimez-les avant de supprimer la liste."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אי אפשר למחוק רשימה זו כל עוד יש בה משימות. יש להוציא אותה מהארכיון כדי לשחזר את הרשימה ואת המשימות שלה, ואז להעביר או לנקות אותן לפני המחיקה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस सूची में अभी कार्य हैं, इसलिए इसे हटाया नहीं जा सकता। सूची और उसके कार्य वापस पाने के लिए इसे संग्रह से निकालें, फिर हटाने से पहले कार्यों को दूसरी सूची में ले जाएँ या हटा दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa lista non può essere eliminata finché contiene attività. Rimuovila dall’archivio per ripristinare la lista e le sue attività, poi spostale o rimuovile prima di eliminare la lista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクが残っているリストは削除できません。アーカイブを解除してリストとタスクを元に戻し、タスクを移動または消去してから削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일이 남아 있는 목록은 삭제할 수 없습니다. 보관을 해제하여 목록과 할 일을 복원한 다음, 할 일을 옮기거나 지운 후에 삭제하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze lijst kan niet worden verwijderd zolang er nog taken in staan. Haal de lijst uit het archief om de lijst en de taken te herstellen, en verplaats of verwijder de taken voordat je de lijst verwijdert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tej listy nie można usunąć, dopóki zawiera zadania. Przywróć ją z archiwum, aby odzyskać listę i jej zadania, a następnie przenieś je lub wyczyść przed usunięciem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta lista não pode ser excluída enquanto ainda tiver tarefas. Desarquive-a para restaurar a lista e suas tarefas e, em seguida, mova-as ou limpe-as antes de excluí-la."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această listă nu poate fi ștearsă cât timp mai conține sarcini. Dezarhivați-o pentru a restaura lista și sarcinile ei, apoi mutați sau eliminați sarcinile înainte de a șterge lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот список нельзя удалить, пока в нём остаются задачи. Верните его из архива, чтобы восстановить список и его задачи, затем переместите или очистите их перед удалением."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей список не можна видалити, поки в ньому лишаються завдання. Поверніть його з архіву, щоб відновити список і його завдання, а потім перемістіть або очистьте їх перед видаленням."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب تک اس فہرست میں کام موجود ہیں اسے حذف نہیں کیا جا سکتا۔ فہرست اور اس کے کام بحال کرنے کے لیے اسے آرکائیو سے نکالیں، پھر حذف کرنے سے پہلے کاموں کو منتقل یا صاف کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此列表仍有任务时无法删除。请取消归档以恢复列表及其任务，然后移动或清除这些任务，再删除该列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清單內仍有任務時無法刪除。請先取消封存以還原清單及其任務，再移動或清除這些任務，然後才能刪除。"
          }
        }
      }
    },
