    "system.status.session_context.read.description": {
      "comment": "Description for the Read Lorvex Session Context App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة التاريخ الحالي في Lorvex وحالة المزامنة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Lorvex’s current date and sync status."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee la fecha actual y el estado de sincronización de Lorvex."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit la date actuelle et l’état de synchronisation de Lorvex."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex की मौजूदा तारीख़ और सिंक की स्थिति पढ़ें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge la data corrente e lo stato di sincronizzazione di Lorvex."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexの現在の日付と同期の状況を読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex의 현재 날짜와 동기화 상태를 읽습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytuje bieżącą datę i stan synchronizacji Lorvex."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê a data atual e o status de sincronização do Lorvex."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает текущую дату и состояние синхронизации Lorvex."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читає поточну дату й стан синхронізації Lorvex."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取 Lorvex 的当前日期和同步状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取 Lorvex 目前的日期與同步狀態。"
          }
        }
      }
    },
    "system.status.session_context.read.dialog": {
      "comment": "Dialog after reading session context; first %@ is date, second %@ is sync backend",
      "extractionState": "manual",
