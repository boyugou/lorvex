        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η φόρτωση των ημερολογίων. Ελέγξτε την πρόσβαση στο ημερολόγιο στις Ρυθμίσεις."
          }
