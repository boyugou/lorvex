    "system.habit.unskip.description": {
      "comment": "Description for the Undo Lorvex Habit Skip App Intent. Taking back a skip returns the day to an ordinary open day.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التراجع عن تخطي يوم لعادة في Lorvex من الاختصارات أو Siri."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শর্টকাট বা Siri থেকে একটি Lorvex অভ্যাসে একটি দিন এড়িয়ে যাওয়া বাতিল করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hebt das Überspringen eines Tages für eine Lorvex-Gewohnheit über Kurzbefehle oder Siri auf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναιρέστε την παράλειψη μιας ημέρας για μια συνήθεια Lorvex από τις Συντομεύσεις ή το Siri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take back a skipped day for a Lorvex habit from Shortcuts or Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deshace la omisión de un día de un hábito de Lorvex desde Atajos o Siri."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "واگرد رد کردن یک روز برای یک عادت Lorvex از طریق میان‌برها یا Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annule le saut d’un jour pour une habitude de Lorvex depuis Raccourcis ou Siri."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביטול דילוג על יום בהרגל ב-Lorvex דרך קיצורי דרך או Siri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट्स या Siri से Lorvex की किसी आदत का छोड़ा गया दिन वापस लें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membatalkan hari yang dilewati untuk kebiasaan Lorvex dari Pintasan atau Siri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla il salto di un giorno per un’abitudine di Lorvex da Comandi rapidi o Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットまたはSiriでLorvexの習慣のスキップを1日分取り消します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어 또는 Siri에서 Lorvex 습관의 하루 건너뛰기를 취소합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट किंवा Siri द्वारे एका Lorvex सवयीचा एक दिवस वगळणे रद्द करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membatalkan hari yang dilangkau bagi tabiat Lorvex daripada Pintasan atau Siri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maakt het overslaan van een dag voor een Lorvex-gewoonte ongedaan via Opdrachten of Siri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cofa pominięcie dnia dla nawyku Lorvex ze Skrótów lub Siri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desfaz o pulo de um dia de um hábito do Lorvex pelos Atalhos ou pela Siri."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulează omiterea unei zile dintr-un obicei Lorvex prin Scurtături sau Siri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменяет пропуск дня для привычки Lorvex из «Быстрых команд» или Siri."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்கவழிகள் அல்லது Siri மூலம் Lorvex பழக்கத்தின் ஒரு நாள் தவிர்ப்பை ரத்துசெய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "షార్ట్‌కట్స్ లేదా Siri నుండి Lorvex అలవాటులో ఒక రోజు దాటవేతను రద్దు చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเลิกการข้ามวันของนิสัย Lorvex จากคำสั่งลัดหรือ Siri"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kestirmeler veya Siri ile bir Lorvex alışkanlığı için atlanan günü geri alın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасовує пропуск дня для звички Lorvex зі «Швидких команд» або Siri."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شارٹ کٹس یا Siri سے کسی Lorvex عادت کا چھوڑا گیا دن واپس لیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoàn tác việc bỏ qua một ngày của một thói quen Lorvex từ Phím tắt hoặc Siri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“快捷指令”或 Siri 撤销对一个 Lorvex 习惯某一天的跳过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過捷徑或 Siri 復原 Lorvex 習慣某一天的略過。"
          }
        }
      }
    },
    "system.habit.unskip.dialog": {
      "comment": "Dialog after taking back a habit's skip; %@ is the habit name",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم التراجع عن تخطي %@ في Lorvex."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex-এ অভ্যাস “%@” এড়িয়ে যাওয়া বাতিল করা হয়েছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überspringen von %@ in Lorvex aufgehoben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναιρέθηκε η παράλειψη της συνήθειας %@ στο Lorvex."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Took back the skip for %@ in Lorvex."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se deshizo la omisión de “%@” en Lorvex."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رد کردن عادت «%@» در Lorvex لغو شد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saut annulé pour l’habitude « %@ » dans Lorvex."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדילוג על ההרגל \"%@\" בוטל ב-Lorvex."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex में आदत “%@” का छोड़ा गया दिन वापस ले लिया गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari yang dilewati untuk %@ dibatalkan di Lorvex."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salto annullato per l’abitudine “%@” in Lorvex."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexで「%@」のスキップを取り消しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex에서 “%@” 습관의 건너뛰기를 취소했습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex मध्ये सवय ‘%@’ वगळणे रद्द केले."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari yang dilangkau untuk %@ dibatalkan dalam Lorvex."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Overslaan van %@ ongedaan gemaakt in Lorvex."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cofnięto pominięcie nawyku „%@” w Lorvex."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulo do hábito “%@” desfeito no Lorvex."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Omiterea obiceiului %@ a fost anulată în Lorvex."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропуск привычки «%@» отменён в Lorvex."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexஇல் “%@” பழக்கத்தின் தவிர்ப்பு ரத்துசெய்யப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexలో “%@” అలవాటు దాటవేత రద్దు చేయబడింది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเลิกการข้าม %@ แล้วใน Lorvex"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex’te atlama geri alındı: %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропуск звички «%@» скасовано в Lorvex."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عادت \"%@\" کا چھوڑا گیا دن Lorvex میں واپس لے لیا گیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã hoàn tác việc bỏ qua %@ trong Lorvex."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在 Lorvex 中撤销“%@”的跳过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已在 Lorvex 中復原「%@」的略過。"
          }
        }
      }
    },
    "system.habit.unskip.title": {
      "comment": "Title for the Undo Lorvex Habit Skip App Intent. It takes back an earlier skip of a habit's day.",
