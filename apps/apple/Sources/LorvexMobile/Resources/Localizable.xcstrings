            "state": "translated",
            "value": "カレンダーイベントはLorvexに読み込まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 이벤트를 Lorvex로 읽어 오지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydarzenia z kalendarza nie są odczytywane w Lorvex."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum evento do calendário é lido no Lorvex."
          }
        },
        "ru": {
