        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найчастіше: %1$@, найрідше: %2$@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سب سے مضبوط %1$@ کو، سب سے کمزور %2$@ کو۔"
