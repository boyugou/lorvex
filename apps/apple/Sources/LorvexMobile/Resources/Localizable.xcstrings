            "value": "Delete iCloud Data"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar datos de iCloud"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer les données iCloud"
          }
        },
        "hi": {
