    "tasks.empty.completed.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر المهام المكتملة هنا بعد إنهاء العمل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completed tasks will appear here after work is closed out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas aparecerán aquí cuando las completes."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارهای تکمیل‌شده پس از پایان کار در اینجا نمایش داده می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches terminées apparaîtront ici une fois le travail clôturé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משימות שהושלמו יופיעו כאן אחרי שהעבודה עליהן תסתיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "काम पूरा होने के बाद पूर्ण कार्य यहाँ दिखेंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le attività completate appariranno qui quando il lavoro sarà concluso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了したタスクは、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료한 할 일이 여기에 표시됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukończone zadania pojawią się tutaj po zakończeniu pracy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas concluídas aparecerão aqui depois que o trabalho for encerrado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполненные задачи появятся здесь, когда работа будет завершена."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виконані завдання з’являться тут, коли роботу буде завершено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کام ختم کرنے کے بعد مکمل کام یہاں نظر آئیں گے۔"
