{
  "sourceLanguage": "en",
  "strings": {
    "widget.control.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض المهمة في أعلى قائمة اليوم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the task at the top of Today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la primera tarea de Hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche la tâche en tête d’Aujourd’hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज की सूची में सबसे ऊपर का कार्य दिखाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra l’attività in cima a Oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の先頭のタスクを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 맨 위 할 일을 표시합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje zadanie na początku „Dzisiaj”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra a tarefa no topo de Hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает задачу, которая стоит первой в «Сегодня»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує завдання, яке стоїть першим у «Сьогодні»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示“今天”最上面的任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示今天最上方的任務。"
          }
        }
      }
    },
