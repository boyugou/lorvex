    "system.task.batch.complete.title": {
      "comment": "Title for the Batch Complete Lorvex Tasks App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إكمال مهام Lorvex دفعة واحدة"
          }
        },
        "bn": {
          "stringUnit": {
