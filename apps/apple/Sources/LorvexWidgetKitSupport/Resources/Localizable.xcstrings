        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 할 일 완료 현황을 한눈에 확인하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledź dzisiejszy postęp zadań na pierwszy rzut oka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe rapidamente a conclusão das tarefas de hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следите за выполнением задач на сегодня с одного взгляда."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стежте за виконанням завдань на сьогодні з одного погляду."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
