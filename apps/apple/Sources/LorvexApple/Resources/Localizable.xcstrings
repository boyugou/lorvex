      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القائمة فارغة وستتم إزالتها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তালিকাটি খালি এবং সরিয়ে ফেলা হবে।"
          }
        },
        "de": {
