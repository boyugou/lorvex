            "state": "translated",
            "value": "Já existe uma etiqueta com esse nome. Escolha outro nome."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Există deja un tag cu acest nume. Alegeți alt nume."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тег с таким названием уже существует. Выберите другое название."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் பெயரில் குறிச்சொல் ஏற்கெனவே உள்ளது. வேறொரு பெயரைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ పేరుతో ట్యాగ్ ఇప్పటికే ఉంది. వేరే పేరును ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีแท็กที่ใช้ชื่อนี้อยู่แล้ว เลือกชื่ออื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ada sahip bir etiket zaten var. Başka bir ad seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тег із такою назвою вже існує. Виберіть іншу назву."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس نام کا ٹیگ پہلے سے موجود ہے۔ کوئی اور نام منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã có thẻ với tên này. Hãy chọn tên khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有同名标签，请换一个名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有同名標籤，請換一個名稱。"
          }
        }
      }
    },
    "error.reason.tag_too_long": {
      "comment": "Alert shown when one of a task's tags is longer than the app accepts.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أحد الوسوم طويل جدًا. اختصره ثم حاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ট্যাগ অনেক বড়। এটি ছোট করে আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tag ist zu lang. Kürze ihn und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια ετικέτα είναι πολύ μεγάλη. Συντομεύστε την και δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tag is too long. Shorten it and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una etiqueta es demasiado larga. Acórtala e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک برچسب بیش از حد طولانی است. آن را کوتاه‌تر کنید و دوباره تلاش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tag est trop long. Raccourcissez-le, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אחד התגים ארוך מדי. יש לקצר אותו ולנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक टैग बहुत लंबा है। उसे छोटा करके फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Label terlalu panjang. Persingkat lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tag è troppo lungo. Accorcialo e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグが長すぎます。短くしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "태그가 너무 깁니다. 줄인 후 다시 시도하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एक टॅग खूप मोठा आहे. तो लहान करा आणि पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag terlalu panjang. Pendekkan dan cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een tag is te lang. Kort de tag in en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden z tagów jest za długi. Skróć go i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma etiqueta é longa demais. Encurte-a e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tag este prea lung. Scurtați-l și încercați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один из тегов слишком длинный. Сократите его и попробуйте ещё раз."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு குறிச்சொல் மிக நீளமாக உள்ளது. அதைச் சுருக்கி, மீண்டும் முயலவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక ట్యాగ్ చాలా పొడవుగా ఉంది. దాన్ని తగ్గించి, మళ్ళీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แท็กยาวเกินไป ย่อให้สั้นลงแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir etiket çok uzun. Kısaltıp yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один із тегів задовгий. Скоротіть його та спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک ٹیگ بہت لمبا ہے۔ اسے مختصر کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một thẻ quá dài. Hãy rút ngắn rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签太长了，请缩短后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤太長了，請縮短後再試。"
          }
        }
      }
    },
    "error.reason.task_start_blocked": {
      "comment": "Alert shown when a person starts a task whose dependencies are not finished.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعتمد هذه المهمة على مهام لم تكتمل بعد. أكمِلها أو ألغِها أولًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই টাস্কটি এমন টাস্কের উপর নির্ভর করে যেগুলি এখনও সম্পন্ন হয়নি। আগে সেগুলি সম্পূর্ণ বা বাতিল করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aufgabe hängt von Aufgaben ab, die noch nicht erledigt sind. Erledige oder breche diese zuerst ab."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η εργασία εξαρτάται από εργασίες που δεν έχουν ολοκληρωθεί ακόμη. Ολοκληρώστε ή ακυρώστε τις πρώτα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This task depends on tasks that aren’t done yet. Finish or cancel them first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarea depende de tareas que aún no están terminadas. Termínalas o cancélalas primero."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار به کارهایی وابسته است که هنوز انجام نشده‌اند. ابتدا آن‌ها را تکمیل یا لغو کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette tâche dépend de tâches qui ne sont pas encore terminées. Terminez-les ou annulez-les d’abord."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשימה הזו תלויה במשימות שעדיין לא הושלמו. יש להשלים או לבטל אותן קודם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कार्य उन कार्यों पर निर्भर है जो अभी पूरे नहीं हुए हैं। पहले उन्हें पूरा या रद्द करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas ini bergantung pada tugas yang belum selesai. Selesaikan atau batalkan tugas tersebut terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa attività dipende da attività non ancora completate. Completale o annullale prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタスクの依存先のタスクがまだ完了していません。先に完了するか、キャンセルしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 할 일이 의존하는 할 일이 아직 완료되지 않았습니다. 먼저 완료하거나 취소하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे कार्य अशा कार्यांवर अवलंबून आहे जी अजून पूर्ण झालेली नाहीत. आधी ती पूर्ण करा किंवा रद्द करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas ini bergantung pada tugas yang belum selesai. Selesaikan atau batalkan tugas itu dahulu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze taak hangt af van taken die nog niet zijn voltooid. Voltooi of annuleer die eerst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zadanie zależy od zadań, które nie są jeszcze ukończone. Najpierw je ukończ lub anuluj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarefa depende de tarefas que ainda não foram concluídas. Conclua ou cancele essas tarefas primeiro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această sarcină depinde de sarcini care nu sunt încă finalizate. Finalizați-le sau anulați-le mai întâi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта задача зависит от незавершённых задач. Сначала завершите или отмените их."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் பணி இன்னும் முடியாத பணிகளைச் சார்ந்துள்ளது. முதலில் அவற்றை நிறைவுசெய்யவும் அல்லது ரத்துசெய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ టాస్క్ ఇంకా పూర్తికాని టాస్క్‌లపై ఆధారపడి ఉంది. ముందుగా వాటిని పూర్తి చేయండి లేదా రద్దు చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานนี้ต้องรองานที่ยังไม่เสร็จ ทำงานเหล่านั้นให้เสร็จหรือยกเลิกก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu görev, henüz tamamlanmamış görevlere bağlı. Önce onları tamamlayın veya iptal edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це завдання залежить від незавершених завдань. Спершу завершіть або скасуйте їх."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ کام ایسے کاموں پر منحصر ہے جو ابھی مکمل نہیں ہوئے۔ پہلے انہیں مکمل یا منسوخ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhiệm vụ này phụ thuộc vào các nhiệm vụ chưa xong. Hãy hoàn thành hoặc hủy chúng trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个任务依赖的任务还没完成，请先完成或取消它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個任務相依的任務還沒完成，請先完成或取消它們。"
          }
        }
      }
    },
