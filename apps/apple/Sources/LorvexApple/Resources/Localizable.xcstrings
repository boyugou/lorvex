    "settings.language.relaunch_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد تشغيل Lorvex لتطبيق اللغة الجديدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন ভাষা প্রয়োগ করতে Lorvex রিস্টার্ট করুন।"
          }
        },
        "de": {
          "stringUnit": {
