    "habits.reminders.hint.daily": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الأيام المجدولة لهذه العادة فقط، ويتوقف بمجرد إكمالها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only on the days this habit is scheduled, and stops once it’s done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los días en que este hábito está planificado; se detiene al completarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement les jours où cette habitude est prévue, et s’arrête dès qu’elle est faite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल उन दिनों में जब यह आदत तय है, और आदत पूरी होते ही रुक जाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo nei giorni in cui questa abitudine è prevista e si ferma una volta completata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この習慣の予定日のみ通知し、完了すると止まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 습관이 예정된 날에만 알리며, 완료하면 멈춥니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko w dni, w których nawyk jest zaplanowany, i kończy się po jego wykonaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente nos dias em que este hábito está previsto e para assim que for concluído."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только в дни, когда запланирована привычка, и прекращается после выполнения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише в дні, на які запланована звичка, і припиняється після виконання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在该习惯计划的日子提醒，完成后即停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會在這個習慣安排的日子提醒，完成後就會停止。"
          }
        }
      }
    },
    "habits.reminders.hint.monthly": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يذكّرك في اليوم %lld من كل شهر، ويتوقف بمجرد إكمالها."
