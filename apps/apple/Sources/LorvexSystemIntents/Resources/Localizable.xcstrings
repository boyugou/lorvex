          }
        }
      }
    },
    "system.task.reminders.due.read.title": {
      "comment": "Title for the Read Lorvex Due Task Reminders App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة تذكيرات المهام المستحقة في Lorvex"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সময় হওয়া Lorvex টাস্ক রিমাইন্ডার পড়ুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fällige Lorvex-Aufgabenerinnerungen lesen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανάγνωση υπομνήσεων εργασιών Lorvex που έφτασε η ώρα τους"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Lorvex Due Task Reminders"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer recordatorios vencidos de tareas de Lorvex"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خواندن یادآورهای سررسیدشده کار Lorvex"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire les rappels de tâches échus de Lorvex"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קריאת תזכורות שהגיע זמנן ב-Lorvex"
