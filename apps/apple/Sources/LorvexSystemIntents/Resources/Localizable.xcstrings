    "system.task.update.description": {
      "comment": "Description for the Update Lorvex Task App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحديث تفاصيل مهمة في Lorvex من الاختصارات أو Siri."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শর্টকাট বা Siri থেকে Lorvex টাস্কের বিবরণ আপডেট করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiert die Details einer Lorvex-Aufgabe über Kurzbefehle oder Siri."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενημερώστε τις λεπτομέρειες μιας εργασίας Lorvex από τις Συντομεύσεις ή το Siri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update Lorvex task details from Shortcuts or Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza los detalles de una tarea de Lorvex desde Atajos o Siri."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به‌روزرسانی جزئیات یک کار Lorvex از طریق میان‌برها یا Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met à jour les détails d’une tâche de Lorvex depuis Raccourcis ou Siri."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדכון פרטי משימה ב-Lorvex דרך קיצורי דרך או Siri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट्स या Siri से Lorvex कार्य का ब्योरा अपडेट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memperbarui detail tugas Lorvex dari Pintasan atau Siri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna i dettagli di un’attività di Lorvex da Comandi rapidi o Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットまたはSiriでLorvexのタスクの詳細を更新します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어 또는 Siri에서 Lorvex 할 일 세부 정보를 업데이트합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट किंवा Siri द्वारे Lorvex कार्याचे तपशील अपडेट करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengemas kini butiran tugas Lorvex daripada Pintasan atau Siri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werkt de details van een Lorvex-taak bij via Opdrachten of Siri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizuje szczegóły zadania Lorvex ze Skrótów lub Siri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualiza os detalhes de uma tarefa do Lorvex pelos Atalhos ou pela Siri."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizează detaliile unei sarcini Lorvex prin Scurtături sau Siri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновляет подробности задачи Lorvex из «Быстрых команд» или Siri."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்கவழிகள் அல்லது Siri மூலம் Lorvex பணி விவரங்களைப் புதுப்பிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "షార్ట్‌కట్స్ లేదా Siri నుండి Lorvex టాస్క్ వివరాలను అప్‌డేట్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปเดตรายละเอียดงาน Lorvex จากคำสั่งลัดหรือ Siri"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kestirmeler veya Siri ile Lorvex görev ayrıntılarını güncelleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновлює подробиці завдання Lorvex зі «Швидких команд» або Siri."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شارٹ کٹس یا Siri سے Lorvex کام کی تفصیلات اپ ڈیٹ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cập nhật chi tiết nhiệm vụ Lorvex từ Phím tắt hoặc Siri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“快捷指令”或 Siri 更新 Lorvex 任务详情。"
          }
        },
        "zh-Hant": {
