    "settings.mcp.connect_blurb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex is built for an assistant to do most of the work: your AI client launches Lorvex’s built-in helper to read and update tasks, lists, habits, memory, reviews, and calendar entries. Copy the setup prompt below only into assistants you trust."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 的设计是让助手完成大部分工作：你的 AI 客户端会启动 Lorvex 内置助手，读取和更新任务、列表、习惯、记忆、回顾和日历条目。请仅将下方的设置提示词复制到你信任的助手中。"
          }
        }
      }
    },
