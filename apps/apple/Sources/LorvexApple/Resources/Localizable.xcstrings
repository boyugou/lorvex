    "settings.cloud_sync.summary.live_last_push": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المزامنة المباشرة نشطة. آخر رفع %@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইভ সিঙ্ক সক্রিয়। সর্বশেষ আপলোড: %@।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Synchronisierung aktiv. Letzter Upload (%@)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο ζωντανός συγχρονισμός είναι ενεργός. Τελευταία αποστολή: %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live sync active. Last push %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronización en vivo activa. Último envío: %@."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همگام‌سازی زنده فعال است. آخرین بارگذاری %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisation en direct active. Dernier envoi : %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סנכרון חי פעיל. ההעלאה האחרונה %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव सिंक चालू है। आख़िरी अपलोड %@।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyelarasan langsung aktif. Terakhir diunggah %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizzazione live attiva. Ultimo invio: %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブ同期が有効です。前回のアップロード：%@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 동기화가 활성화되어 있습니다. 마지막 업로드: %@."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव्ह सिंक सक्रिय. शेवटचे अपलोड: %@."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyelarasan langsung aktif. Terakhir dimuat naik %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Live synchronisatie actief. Laatste upload %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja na żywo jest aktywna. Ostatnie wysłanie: %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronização em tempo real ativa. Último envio: %@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizare live activă. Ultima încărcare (%@)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация в реальном времени активна. Последняя отправка: %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมข้อมูลแบบเรียลไทม์ทำงานอยู่ ส่งล่าสุด %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı eşzamanlama etkin. Son gönderim: %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронізація в реальному часі активна. Останнє надсилання: %@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لائیو سنک فعال ہے۔ آخری اپ لوڈ %@۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng bộ hóa trực tiếp đang hoạt động. Lần tải lên gần nhất: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时同步已启用。上次推送：%@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即時同步已啟用。上次上傳：%@。"
