    "system.task.parameter.depends_on.description": {
      "comment": "Help text under the Depends On parameter of Update Lorvex Task",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المهام التي يجب إنجازها أولًا. تحل محل التبعيات الحالية للمهمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে টাস্কগুলি আগে শেষ করতে হবে। এটি টাস্কের বর্তমান নির্ভরতাগুলি প্রতিস্থাপন করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufgaben, die zuerst erledigt werden müssen. Ersetzt die aktuellen Abhängigkeiten der Aufgabe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εργασίες που πρέπει να ολοκληρωθούν πρώτα. Αντικαθιστά τις τρέχουσες εξαρτήσεις της εργασίας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tasks to finish first. Replaces the task’s current dependencies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas que deben terminarse antes. Sustituye las dependencias actuales de la tarea."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارهایی که باید ابتدا تمام شوند. وابستگی‌های فعلی کار را جایگزین می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches à terminer d’abord. Remplace les dépendances actuelles de la tâche."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשימות שיש להשלים קודם. מחליף את התלויות הקיימות של המשימה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वे कार्य जिन्हें पहले पूरा करना है। यह कार्य की मौजूदा निर्भरताओं की जगह लेता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas yang harus diselesaikan lebih dulu. Menggantikan dependensi tugas saat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le attività da completare prima. Sostituisce le dipendenze attuali dell’attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に完了するタスク。タスクの現在の依存関係を置き換えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 끝내야 하는 할 일입니다. 할 일의 현재 의존 관계를 대체합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जी कार्ये आधी पूर्ण करायची आहेत. हे कार्याचे सध्याचे अवलंबित्व बदलते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas yang mesti disiapkan dahulu. Menggantikan kebergantungan semasa tugas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De taken die eerst moeten worden voltooid. Vervangt de huidige afhankelijkheden van de taak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadania, które trzeba ukończyć najpierw. Zastępuje obecne zależności zadania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas a concluir primeiro. Substitui as dependências atuais da tarefa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarcinile care trebuie finalizate mai întâi. Înlocuiește dependențele actuale ale sarcinii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задачи, которые нужно выполнить сначала. Заменяет текущие зависимости задачи."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முதலில் முடிக்க வேண்டிய பணிகள். பணியின் தற்போதைய சார்புகளை மாற்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ముందుగా పూర్తి చేయాల్సిన టాస్క్‌లు. టాస్క్ ప్రస్తుత డిపెండెన్సీలను రీప్లేస్ చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานที่ต้องทำให้เสร็จก่อน จะแทนที่งานที่ต้องรออยู่ในปัจจุบัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce bitirilecek görevler. Görevin mevcut bağımlılıklarının yerine geçer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завдання, які треба виконати спершу. Замінює поточні залежності завдання."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ کام جو پہلے مکمل ہونے چاہییں۔ یہ کام کے موجودہ انحصارات کو بدل دیتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các nhiệm vụ cần hoàn thành trước. Thay thế các phụ thuộc hiện tại của nhiệm vụ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要先完成的任务。会替换该任务现有的依赖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要先完成的任務。會取代該任務現有的相依項目。"
          }
        }
      }
    },
