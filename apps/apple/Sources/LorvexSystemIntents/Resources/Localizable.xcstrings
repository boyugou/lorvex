          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeert een Lorvex-checklistonderdeel als voltooid of niet voltooid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznacza element listy kontrolnej Lorvex jako ukończony lub nieukończony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca um item da lista de verificação do Lorvex como concluído ou não concluído."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Marchează un element din lista de control Lorvex drept finalizat sau nefinalizat."
