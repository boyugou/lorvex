    "widget.progress.desc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابع إنجاز مهام اليوم بنظرة سريعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজকের টাস্ক সম্পূর্ণ হওয়ার অগ্রগতি এক নজরে দেখুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh auf einen Blick, wie viele heutige Aufgaben erledigt sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρακολουθήστε με μια ματιά την ολοκλήρωση των εργασιών σήμερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track today’s task completion at a glance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue de un vistazo las tareas que completas hoy."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تکمیل کارهای امروز را با یک نگاه دنبال کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez d’un coup d’œil l’avancement des tâches du jour."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מבט מהיר על השלמת המשימות של היום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज के कितने कार्य पूरे हुए, एक नज़र में देखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantau penyelesaian tugas hari ini sekilas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui a colpo d’occhio il completamento delle attività di oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のタスクの達成状況をひと目で確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 할 일 완료 현황을 한눈에 확인하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आजची कार्ये किती पूर्ण झाली ते एका दृष्टिक्षेपात पाहा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jejaki penyelesaian tugas hari ini dengan sekali pandang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volg de voortgang van de taken van vandaag in één oogopslag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledź dzisiejszy postęp zadań na pierwszy rzut oka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe rapidamente a conclusão das tarefas de hoje."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Urmăriți dintr-o privire finalizarea sarcinilor de astăzi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следите за выполнением задач на сегодня с одного взгляда."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตามความคืบหน้างานของวันนี้ได้ในพริบตา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünkü görev tamamlamayı tek bakışta izleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стежте за виконанням завдань на сьогодні з одного погляду."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج کے کاموں کی تکمیل ایک نظر میں دیکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi nhanh mức hoàn thành nhiệm vụ hôm nay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼追踪今天的任务完成情况。"
          }
        },
