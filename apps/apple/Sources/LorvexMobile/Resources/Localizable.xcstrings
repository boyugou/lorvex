            "state": "translated",
            "value": "Wähle eine Endzeit nach der Startzeit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε ώρα λήξης μετά την ώρα έναρξης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick an end time after the start time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una hora de fin posterior a la de inicio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زمان پایانی بعد از زمان شروع انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une heure de fin postérieure à l’heure de début."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור שעת סיום אחרי שעת ההתחלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू होने के समय के बाद का खत्म होने का समय चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih waktu berakhir setelah waktu mulai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un’ora di fine successiva a quella di inizio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了時刻は開始時刻より後にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료 시간을 시작 시간 이후로 선택하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरुवातीच्या वेळेनंतरची समाप्तीची वेळ निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih masa tamat selepas masa mula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een eindtijd na de starttijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz godzinę zakończenia późniejszą niż godzina rozpoczęcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um horário de término depois do horário de início."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți o oră de sfârșit după ora de început."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите время окончания позже времени начала."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடக்க நேரத்துக்குப் பிறகான முடிவு நேரத்தைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రారంభ సమయం తర్వాత ఉండే ముగింపు సమయాన్ని ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกเวลาสิ้นสุดที่อยู่หลังเวลาเริ่มต้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlangıç saatinden sonra bir bitiş saati seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть час завершення пізніше за час початку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آغاز کے وقت کے بعد کا اختتامی وقت منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy chọn giờ kết thúc sau giờ bắt đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择晚于开始时间的结束时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇晚於開始時間的結束時間。"
          }
        }
      }
    },
