        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pribadi, hanya untuk Anda"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Privato, solo tuo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなただけのもの"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나만의 공간"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फक्त तुमच्यासाठी खाजगी"
          }
