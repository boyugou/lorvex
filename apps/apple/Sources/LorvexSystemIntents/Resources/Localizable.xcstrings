    "system.tag.list.description": {
      "comment": "Description for the List Lorvex Tags App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض جميع وسوم مهام Lorvex من الاختصارات أو Siri."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শর্টকাট বা Siri থেকে সব Lorvex টাস্ক ট্যাগ দেখান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Listet alle Tags für Lorvex-Aufgaben über Kurzbefehle oder Siri auf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίστε όλες τις ετικέτες εργασιών Lorvex από τις Συντομεύσεις ή το Siri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "List all Lorvex task tags from Shortcuts or Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra todas las etiquetas de tareas de Lorvex desde Atajos o Siri."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فهرست همه برچسب‌های کارهای Lorvex از طریق میان‌برها یا Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste tous les tags de tâches de Lorvex depuis Raccourcis ou Siri."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצגת כל התגים של משימות ב-Lorvex דרך קיצורי דרך או Siri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट्स या Siri से Lorvex के सभी कार्य टैग दिखाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan semua label tugas Lorvex dari Pintasan atau Siri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elenca tutti i tag delle attività di Lorvex da Comandi rapidi o Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットまたはSiriでLorvexのタスクのタグをすべて一覧表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어 또는 Siri에서 Lorvex 할 일 태그를 모두 나열합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट किंवा Siri द्वारे सर्व Lorvex कार्य टॅग दाखवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyenaraikan semua tag tugas Lorvex daripada Pintasan atau Siri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont alle tags voor Lorvex-taken via Opdrachten of Siri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje wszystkie tagi zadań Lorvex ze Skrótów lub Siri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista todas as etiquetas de tarefas do Lorvex pelos Atalhos ou pela Siri."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișează toate tagurile pentru sarcinile Lorvex prin Scurtături sau Siri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает все теги задач Lorvex из «Быстрых команд» или Siri."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்கவழிகள் அல்லது Siri மூலம் அனைத்து Lorvex பணிக் குறிச்சொற்களையும் பட்டியலிடவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "షార్ట్‌కట్స్ లేదా Siri నుండి అన్ని Lorvex టాస్క్ ట్యాగ్‌లను జాబితా చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงแท็กงาน Lorvex ทั้งหมดจากคำสั่งลัดหรือ Siri"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kestirmeler veya Siri ile tüm Lorvex görev etiketlerini listeleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує всі теги завдань Lorvex зі «Швидких команд» або Siri."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شارٹ کٹس یا Siri سے Lorvex کے تمام کام ٹیگز کی فہرست دیکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liệt kê tất cả thẻ nhiệm vụ Lorvex từ Phím tắt hoặc Siri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“快捷指令”或 Siri 列出所有 Lorvex 任务标签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過捷徑或 Siri 列出所有 Lorvex 任務標籤。"
          }
        }
      }
    },
