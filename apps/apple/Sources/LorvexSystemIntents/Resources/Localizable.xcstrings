    "system.list.health.read.description": {
      "comment": "Description for the Find Lorvex Lists with Overdue Tasks App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البحث عن قوائم Lorvex التي تحتوي على مهام متأخرة، مع عدد المهام المتأخرة في كل منها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find the Lorvex lists that have overdue tasks, and how many each has."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca las listas de Lorvex que tienen tareas vencidas y cuántas tiene cada una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve les listes de Lorvex qui ont des tâches en retard, avec le nombre de tâches pour chacune."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उन Lorvex सूचियों को खोजें जिनमें अतिदेय कार्य हैं, और यह भी कि हर सूची में कितने हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova le liste di Lorvex che hanno attività in ritardo e quante ne ha ciascuna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限切れのタスクがあるLorvexのリストと、それぞれの期限切れタスクの件数を探します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기한 초과 할 일이 있는 Lorvex 목록과 목록별 개수를 찾습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukuje listy Lorvex z zaległymi zadaniami i podaje, ile ich jest w każdej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontra as listas do Lorvex que têm tarefas atrasadas e quantas cada uma tem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Находит списки Lorvex с просроченными задачами и показывает, сколько их в каждом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знаходить списки Lorvex із простроченими завданнями й показує, скільки їх у кожному."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找有逾期任务的 Lorvex 列表，以及每个列表各有多少项逾期任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尋找有逾期任務的 Lorvex 清單，以及各清單的逾期任務數量。"
          }
        }
      }
    },
