          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடர் பணிகளை ரத்துசெய்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పునరావృతమయ్యే టాస్క్‌లను రద్దు చేయండి"
          }
