    "system.task.reopen.description": {
      "comment": "Description for the Reopen Lorvex Task App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة فتح مهمة مكتملة أو ملغاة أو مؤجلة في Lorvex."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reopen a completed, cancelled, or deferred Lorvex task."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reabre una tarea de Lorvex completada, cancelada o aplazada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rouvre une tâche de Lorvex terminée, annulée ou reportée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्ण, रद्द या टाले गए Lorvex कार्य को फिर से खोलें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riapre un’attività di Lorvex completata, annullata o rimandata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了、キャンセル、または延期したLorvexのタスクを未完了に戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료, 취소 또는 미뤄진 Lorvex 할 일을 다시 엽니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponownie otwiera ukończone, anulowane lub odłożone zadanie Lorvex."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reabre uma tarefa do Lorvex concluída, cancelada ou adiada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снова открывает выполненную, отменённую или отложенную задачу Lorvex."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знову відкриває виконане, скасоване або відкладене завдання Lorvex."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新打开已完成、已取消或已推迟的 Lorvex 任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新開啟已完成、已取消或已延後的 Lorvex 任務。"
          }
        }
      }
    },
