    "task_detail.picker.when.hint": {
      "comment": "iPhone task field sheet footer for the planned day.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اليوم الذي تخطط للعمل عليها فيه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The day you plan to work on it."
