    "system.memory.delete.description": {
      "comment": "Description for the Delete Lorvex Memory App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف إدخال من ذاكرة Lorvex القابلة للكتابة بالذكاء الاصطناعي باستخدام المفتاح، من الاختصارات أو Siri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete an AI-writable Lorvex memory entry by key from Shortcuts or Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina un recuerdo de Lorvex editable por IA por clave desde Atajos o Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime un souvenir de Lorvex modifiable par l’IA à partir de sa clé, depuis Raccourcis ou Siri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट्स या Siri से कुंजी के आधार पर AI द्वारा लिखने योग्य Lorvex मेमोरी एंट्री हटाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina un ricordo di Lorvex modificabile dall’IA tramite chiave da Comandi rapidi o Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットまたはSiriで、キーを指定してAIが書き込めるLorvexのメモリを削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어 또는 Siri에서 키로 AI가 쓸 수 있는 Lorvex 메모리를 삭제합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa według klucza wpis pamięci Lorvex zapisywalny przez AI ze Skrótów lub Siri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclui uma memória do Lorvex editável pela IA pela chave, pelos Atalhos ou pela Siri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет по ключу запись памяти Lorvex, доступную для записи ИИ, из «Быстрых команд» или Siri."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаляє за ключем запис пам’яті Lorvex, доступний для запису ШІ, зі «Швидких команд» або Siri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“快捷指令”或 Siri 按键删除一个 AI 可写的 Lorvex 记忆条目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過捷徑或 Siri，依鍵刪除 AI 可寫入的 Lorvex 記憶。"
          }
        }
      }
    },
