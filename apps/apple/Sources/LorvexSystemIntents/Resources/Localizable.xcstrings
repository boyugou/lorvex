    "system.habit.batch_complete.description": {
      "comment": "Description for the Batch Complete Lorvex Habits App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إكمال عدة عادات في Lorvex من الاختصارات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শর্টকাট থেকে একাধিক Lorvex অভ্যাস সম্পূর্ণ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erledigt mehrere Lorvex-Gewohnheiten über Kurzbefehle."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ολοκληρώστε πολλές συνήθειες Lorvex από τις Συντομεύσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete multiple Lorvex habits from Shortcuts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa varios hábitos de Lorvex desde Atajos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تکمیل چند عادت Lorvex از طریق میان‌برها."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Valide plusieurs habitudes de Lorvex depuis Raccourcis."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השלמת כמה הרגלים ב-Lorvex דרך קיצורי דרך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट्स से Lorvex की कई आदतें पूर्ण करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyelesaikan beberapa kebiasaan Lorvex dari Pintasan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa più abitudini di Lorvex da Comandi rapidi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットでLorvexの複数の習慣を完了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어에서 Lorvex 습관 여러 개를 완료합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट द्वारे अनेक Lorvex सवयी पूर्ण करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyelesaikan beberapa tabiat Lorvex daripada Pintasan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltooit meerdere Lorvex-gewoontes via Opdrachten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykonuje kilka nawyków Lorvex ze Skrótów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclui vários hábitos do Lorvex pelos Atalhos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalizează mai multe obiceiuri Lorvex prin Scurtături."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполняет несколько привычек Lorvex из «Быстрых команд»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்கவழிகள் மூலம் பல Lorvex பழக்கங்களை நிறைவுசெய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "షార్ట్‌కట్స్ నుండి ఒకేసారి అనేక Lorvex అలవాట్లను పూర్తి చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำนิสัย Lorvex หลายรายการให้เสร็จจากคำสั่งลัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kestirmeler ile birden fazla Lorvex alışkanlığını tamamlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виконує кілька звичок Lorvex зі «Швидких команд»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شارٹ کٹس سے متعدد Lorvex عادات مکمل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoàn thành nhiều thói quen Lorvex từ Phím tắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“快捷指令”完成多个 Lorvex 习惯。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過捷徑一次完成多個 Lorvex 習慣。"
          }
        }
      }
    },
