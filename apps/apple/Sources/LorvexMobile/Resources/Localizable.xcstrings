    "habits.sheet.field.milestone_goal_hint_count": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفل عند هذا العدد من الإكمالات. تستمر العادة بعد ذلك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Celebrate at this many completions. The habit keeps going after."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Celebra al llegar a este número de registros. El hábito continúa después."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با رسیدن به این تعداد تکمیل جشن می‌گیرید. عادت پس از آن ادامه دارد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Célébrez à ce nombre de réalisations. L’habitude continue ensuite."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חוגגים בהגעה למספר ההשלמות הזה. ההרגל נמשך לאחר מכן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इतने चेक-इन पूरे होने पर जश्न मनाएँ। उसके बाद भी आदत जारी रहती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Festeggia a questo numero di completamenti. L’abitudine continua anche dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この完了回数に達したらお祝いします。習慣はその後も続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 완료 횟수에 도달하면 축하합니다. 이후에도 습관은 계속됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczba wykonań, którą warto uczcić. Nawyk trwa także po jej osiągnięciu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comemore ao atingir este número de conclusões. O hábito continua depois disso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Число выполнений, которое стоит отпраздновать. Привычка продолжается и после этого."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кількість виконань, яку варто відсвяткувати. Звичка триває й після цього."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اتنی تکمیلات پر جشن منائیں۔ عادت اس کے بعد بھی جاری رہتی ہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "达到这么多次完成时庆祝。习惯之后仍会继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "達到這個完成次數時會慶祝一下，習慣之後仍會繼續。"
          }
        }
      }
    },
