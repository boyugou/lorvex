{
  "sourceLanguage": "en",
  "strings": {
    "system.ai_changelog.read.description": {
      "comment": "Description for the Read Lorvex AI Changelog App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة أحدث إدخالات سجل تغييرات الذكاء الاصطناعي في Lorvex من الاختصارات أو Siri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read recent Lorvex AI changelog entries from Shortcuts or Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee las entradas recientes del registro de cambios de IA de Lorvex desde Atajos o Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit les entrées récentes du journal des modifications de l’IA de Lorvex depuis Raccourcis ou Siri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट्स या Siri से Lorvex AI चेंजलॉग की हाल की एंट्री पढ़ें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge le voci recenti del registro modifiche IA di Lorvex da Comandi rapidi o Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットまたはSiriで、Lorvexの最近のAI変更履歴を読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어 또는 Siri에서 최근 Lorvex AI 변경 기록을 읽습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytuje ostatnie wpisy dziennika zmian AI Lorvex ze Skrótów lub Siri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê as entradas recentes do registro de alterações da IA do Lorvex pelos Atalhos ou pela Siri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает последние записи журнала изменений ИИ Lorvex из «Быстрых команд» или Siri."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читає останні записи журналу змін ШІ Lorvex зі «Швидких команд» або Siri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“快捷指令”或 Siri 读取最近的 Lorvex AI 变更记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過捷徑或 Siri 讀取 Lorvex 最近的 AI 變更記錄。"
          }
        }
      }
    },
    "system.ai_changelog.read.dialog": {
      "comment": "Dialog after reading AI changelog; %lld is entry count and %@ is summary",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld إدخالات في سجل التغييرات. %2$@"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld إدخالًا في سجل التغييرات. %2$@"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "إدخال واحد في سجل التغييرات. %2$@"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld إدخال في سجل التغييرات. %2$@"
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "إدخالان في سجل التغييرات. %2$@"
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لا توجد إدخالات في سجل التغييرات. %2$@"
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld changelog entry. %2$@"
