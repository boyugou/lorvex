    "habits.detail.rhythm.a11y": {
      "comment": "VoiceOver label of a habit's rhythm strip. 1: periods completed. 2: periods the strip shows.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شريط الإيقاع: اكتملت %1$lld من أصل %#@periods@"
          },
          "substitutions": {
            "periods": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
