          "stringUnit": {
            "state": "translated",
            "value": "Brak notatek AI. Tutaj asystent dodaje notatki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma nota da IA ainda. Seu assistente adiciona notas aqui."
          }
        },
