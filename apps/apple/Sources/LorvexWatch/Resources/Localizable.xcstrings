    "watch.complication.description": {
      "comment": "Description shown for the Lorvex Today watch complication in the system complication gallery",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض عدد المهام المتبقية اليوم والمهمة الأولى في القائمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt, wie viele Aufgaben heute noch offen sind und welche ganz oben steht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows how many tasks are left today and the one at the top."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra cuántas tareas quedan hoy y la primera de la lista."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تعداد کارهای باقی‌مانده برای امروز و کار بالای فهرست را نشان می‌دهد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le nombre de tâches restantes aujourd’hui et celle qui est en tête."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג כמה משימות נותרו להיום ואת המשימה שבראש הרשימה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज कितने कार्य बाकी हैं और सबसे ऊपर कौन-सा है, यह दिखाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan jumlah tugas yang tersisa hari ini dan tugas teratas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra quante attività restano oggi e quella in cima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の残りタスク数と、先頭のタスクを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 남은 할 일 수와 맨 위 할 일을 표시합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunjukkan bilangan tugas yang berbaki hari ini dan tugas teratas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont hoeveel taken er vandaag nog zijn en welke bovenaan staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje, ile zadań zostało na dziś i które jest pierwsze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra quantas tarefas restam hoje e a primeira da lista."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișează câte sarcini au mai rămas astăzi și care este prima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает, сколько задач осталось на сегодня и какая из них первая."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує, скільки завдань залишилося на сьогодні та яке з них перше."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج کتنے کام باقی ہیں اور سب سے اوپر والا کون سا ہے، یہ دکھاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị số nhiệm vụ còn lại hôm nay và nhiệm vụ đứng đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示今天还剩几项任务，以及排在最前面的一项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示今天剩下的任務數量，以及最上方的任務。"
          }
        }
      }
    },
