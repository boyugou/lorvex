            "state": "translated",
            "value": "Prepara una exportación de datos de Lorvex en JSON o CSV desde Atajos o Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prépare une exportation des données de Lorvex en JSON ou CSV depuis Raccourcis ou Siri."
