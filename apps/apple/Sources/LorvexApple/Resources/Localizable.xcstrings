    "settings.permissions.show_task_notes_footer": {
      "comment": "Footer explaining the show-task-notes-in-notifications toggle's default-off behavior",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند الإيقاف، تعرض التذكيرات عنوان المهمة فقط، وليس ملاحظاتك أبدًا، على شاشة القفل وفي اللافتات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বন্ধ থাকলে লক স্ক্রিন ও ব্যানারে রিমাইন্ডারে শুধু টাস্কের শিরোনাম দেখায় – আপনার নোট কখনোই নয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn diese Option ausgeschaltet ist, zeigen Erinnerungen auf dem Sperrbildschirm und in Bannern nur den Aufgabentitel – niemals deine Notizen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν είναι ανενεργό, οι υπομνήσεις εμφανίζουν μόνο τον τίτλο της εργασίας – ποτέ τις σημειώσεις σας – στην οθόνη κλειδώματος και στα πανό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, reminders show only the task title — never your notes — on the lock screen and banners."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está desactivado, los recordatorios muestran solo el título de la tarea, nunca tus notas, en la pantalla bloqueada y en los banners."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی خاموش باشد، یادآورها در صفحه قفل و بنرها فقط عنوان کار را نشان می‌دهند و هرگز یادداشت‌های شما را نمایش نمی‌دهند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque cette option est désactivée, les rappels n’affichent que le titre de la tâche, jamais vos notes, sur l’écran de verrouillage et dans les bannières."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשהאפשרות כבויה, התזכורות מציגות במסך הנעילה ובבאנרים רק את כותרת המשימה — אף פעם לא את ההערות שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद होने पर, रिमाइंडर लॉक स्क्रीन और बैनर पर केवल कार्य का शीर्षक दिखाते हैं, आपके नोट कभी नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat nonaktif, pengingat hanya menampilkan judul tugas – tidak pernah catatan – di layar kunci dan banner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando è disattivata, i promemoria mostrano solo il titolo dell’attività, mai le tue note, nella schermata di blocco e nei banner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフの場合、ロック画面とバナーにはタスクのタイトルだけが表示され、メモは表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 잠금 화면과 배너에 할 일 제목만 표시되고 메모는 표시되지 않습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑफ असताना रिमाइंडर लॉक स्क्रीन आणि बॅनरवर फक्त कार्याचे शीर्षक दाखवतात – तुमच्या नोट्स कधीच नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila tidak aktif, peringatan hanya menunjukkan tajuk tugas – tidak pernah nota anda – pada skrin kunci dan sepanduk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als dit uit staat, tonen herinneringen op het toegangsscherm en in banners alleen de taaktitel – nooit je notities."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy wyłączone, przypomnienia pokazują tylko tytuł zadania — nigdy notatki — na ekranie blokady i w banerach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando desativada, os lembretes mostram apenas o título da tarefa, nunca suas notas, na tela bloqueada e nos banners."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când este dezactivat, mementourile afișează doar titlul sarcinii – niciodată notițele – pe ecranul de blocare și în bannere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если выключено, напоминания показывают только название задачи — никогда заметки — на экране блокировки и в баннерах."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อปิดอยู่ เตือนความจำจะแสดงเฉพาะชื่องาน ไม่แสดงโน้ตของคุณ บนหน้าจอล็อคและแบนเนอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalıyken anımsatıcılar, Kilitli Ekran’da ve bildirim başlıklarında yalnızca görevin adını gösterir; notlarınızı asla göstermez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо вимкнено, нагадування показують лише назву завдання — ніколи нотатки — на екрані блокування та в банерах."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بند ہونے پر، لاک اسکرین اور بینرز پر یاد دہانیاں صرف کام کا عنوان دکھاتی ہیں — آپ کے نوٹس کبھی نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi tắt, lời nhắc chỉ hiển thị tiêu đề nhiệm vụ – không bao giờ hiển thị ghi chú – trên màn hình khóa và biểu ngữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭时，提醒仅在锁屏和横幅通知中显示任务标题，绝不显示你的备注。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉時，鎖定畫面與橫幅上的提醒只會顯示任務標題，不會顯示你的備註。"
          }
        }
      }
    },
