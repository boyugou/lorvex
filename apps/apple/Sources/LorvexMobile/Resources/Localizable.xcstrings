    "today.schedule.no_time_left": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتبقَّ وقت اليوم لهذه المهام. تنتهي ساعات يومك عند %@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই টাস্কগুলির জন্য আজ আর সময় নেই। আপনার দিনের ঘণ্টার শেষ সময়: %@।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute bleibt für diese Aufgaben keine Zeit mehr. Deine Tagesstunden enden um %@."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν απομένει χρόνος σήμερα για αυτές τις εργασίες. Οι ώρες ημέρας σας τελειώνουν στις %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No time is left today for these tasks. Your day hours end at %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy ya no queda tiempo para estas tareas. Tu horario del día termina: %@."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "امروز برای این کارها زمانی باقی نمانده است. ساعت‌های روز شما در %@ پایان می‌یابد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne reste plus de temps aujourd’hui pour ces tâches. Vos horaires de la journée se terminent à %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נשאר זמן היום למשימות האלה. שעות היום שלך מסתיימות ב-%@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज इन कार्यों के लिए समय नहीं बचा है। आपके दिन के घंटे %@ पर समाप्त होते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada waktu tersisa hari ini untuk tugas-tugas ini. Jam aktif berakhir pukul %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi non resta più tempo per queste attività. Gli orari della tua giornata terminano alle %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日はこれらのタスクに使える時間が残っていません。予定に使う時間帯は%@までです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 이 할 일들을 할 시간이 남아 있지 않습니다. 일정 가능 시간은 %@에 끝납니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या कार्यांसाठी आज वेळ उरलेला नाही. तुमच्या दिवसाच्या तासांची समाप्ती: %@."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada masa berbaki hari ini untuk tugas ini. Jam aktif tamat pada %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is vandaag geen tijd meer voor deze taken. Je daguren eindigen om %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na dziś nie zostało czasu na te zadania. Godziny dnia kończą się o %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há mais tempo hoje para estas tarefas. O horário do seu dia termina às %@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Astăzi nu mai rămâne timp pentru aceste sarcini. Orele zilei se încheie la %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На сегодня не осталось времени для этих задач. Часы дня заканчиваются в %@."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் பணிகளுக்கு இன்று நேரம் மீதமில்லை. உங்கள் நாளின் மணிநேரங்கள் முடிவடையும் நேரம்: %@."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ టాస్క్‌ల కోసం ఈరోజు సమయం మిగిలి లేదు. మీ రోజు గంటలు ముగిసే సమయం: %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันนี้ไม่เหลือเวลาสำหรับงานเหล่านี้ ชั่วโมงของวันสิ้นสุดเวลา %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün bu görevlere ayıracak zaman kalmadı. Gün saatleriniz %@ saatinde bitiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На сьогодні не залишилося часу для цих завдань. Години дня закінчуються о %@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج ان کاموں کے لیے کوئی وقت باقی نہیں۔ آپ کے دن کے اوقات %@ پر ختم ہوتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôm nay không còn thời gian cho các nhiệm vụ này. Khung giờ trong ngày kết thúc lúc %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天已没有可安排的时间放这些任务。可安排时段到 %@ 结束。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天已沒有時間處理這些任務。你的可安排時段到 %@ 結束。"
          }
        }
      }
    },
