          }
        }
      }
    },
    "error.reason.habit_reminder_time_taken": {
      "comment": "Alert shown when a habit reminder is set to a time the habit already has a reminder at.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لهذه العادة تذكير في هذا الوقت بالفعل. اختر وقتًا آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Gewohnheit gibt es zu dieser Uhrzeit bereits eine Erinnerung. Wähle eine andere Uhrzeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit already has a reminder at that time. Choose another time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este hábito ya tiene un recordatorio a esa hora. Elige otra hora."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این عادت از قبل در همان ساعت یادآور دارد. ساعت دیگری انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette habitude a déjà un rappel à cette heure. Choisissez une autre heure."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להרגל הזה כבר יש תזכורת בשעה הזו. יש לבחור שעה אחרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस आदत के लिए उस समय पहले से एक रिमाइंडर है। कोई दूसरा समय चुनें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa abitudine ha già un promemoria a quell’ora. Scegli un altro orario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この習慣にはその時刻のリマインダーがすでにあります。別の時刻を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 습관에는 그 시간에 이미 알림이 있습니다. 다른 시간을 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze gewoonte heeft al een herinnering op dat tijdstip. Kies een ander tijdstip."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten nawyk ma już przypomnienie o tej godzinie. Wybierz inną godzinę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este hábito já tem um lembrete nesse horário. Escolha outro horário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest obicei are deja un memento la ora respectivă. Alegeți altă oră."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этой привычки уже есть напоминание на это время. Выберите другое время."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця звичка вже має нагадування на цей час. Виберіть інший час."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس عادت کی اس وقت پہلے سے یاد دہانی موجود ہے۔ کوئی اور وقت منتخب کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个习惯在这个时间已有提醒，请换一个时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個習慣在這個時間已有提醒，請換一個時間。"
          }
        }
      }
    },
    "error.reason.memory_name_taken": {
      "comment": "Alert shown when an entry in Memory (what the assistant remembers) is renamed to the name of another entry.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توجد ذاكرة بهذا الاسم بالفعل. اختر اسمًا آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Gedächtniseintrag mit diesem Namen existiert bereits. Wähle einen anderen Namen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A memory with this name already exists. Choose another name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe una memoria con este nombre. Elige otro nombre."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مورد دیگری در حافظه با این نام وجود دارد. نام دیگری انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une mémoire porte déjà ce nom. Choisissez-en un autre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כבר קיימת רשומת זיכרון בשם הזה. יש לבחור שם אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस नाम की मेमोरी पहले से मौजूद है। कोई दूसरा नाम चुनें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esiste già una memoria con questo nome. Scegli un altro nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ名前のメモリがすでにあります。別の名前を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 이름의 메모리가 이미 있습니다. 다른 이름을 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er bestaat al een geheugenitem met deze naam. Kies een andere naam."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpis pamięci o tej nazwie już istnieje. Wybierz inną nazwę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já existe uma memória com esse nome. Escolha outro nome."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Există deja o înregistrare din memorie cu acest nume. Alegeți alt nume."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись памяти с таким названием уже существует. Выберите другое название."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис пам’яті з такою назвою вже існує. Виберіть іншу назву."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس نام کا حافظہ اندراج پہلے سے موجود ہے۔ کوئی اور نام منتخب کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有同名记忆，请换一个名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有同名記憶，請換一個名稱。"
          }
        }
      }
    },
    "error.reason.notes_too_long": {
      "comment": "Alert shown when a task's notes are longer than the app accepts.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الملاحظات طويلة جدًا. اختصرها ثم حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Notizen sind zu lang. Kürze sie und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These notes are too long. Shorten them and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas notas son demasiado largas. Acórtalas e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این یادداشت‌ها بیش از حد طولانی‌اند. آن‌ها را کوتاه‌تر کنید و دوباره تلاش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces notes sont trop longues. Raccourcissez-les, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההערות האלה ארוכות מדי. יש לקצר אותן ולנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये नोट बहुत लंबे हैं। इन्हें छोटा करके फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste note sono troppo lunghe. Accorciale e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモが長すぎます。短くしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모가 너무 깁니다. 줄인 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze notities zijn te lang. Kort ze in en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te notatki są za długie. Skróć je i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas notas são longas demais. Encurte-as e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceste notițe sunt prea lungi. Scurtați-le și încercați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заметки слишком длинные. Сократите их и попробуйте ещё раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нотатки задовгі. Скоротіть їх та спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ نوٹس بہت لمبے ہیں۔ انہیں مختصر کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备注太长了，请缩短后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備註太長了，請縮短後再試。"
          }
        }
      }
    },
    "error.reason.pausing_unstarted_task": {
      "comment": "Alert shown when a person pauses a task that is not in progress.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن الإيقاف المؤقت إلا لمهمة قيد التنفيذ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur eine Aufgabe in Bearbeitung kann pausiert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a task in progress can be paused."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se puede pausar una tarea en curso."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط کاری که در حال انجام است را می‌توان مکث کرد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule une tâche en cours peut être mise en pause."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להשהות רק משימה בתהליך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल प्रगति में चल रहे कार्य को ही रोका जा सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un’attività in corso può essere messa in pausa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止できるのは進行中のタスクだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 중인 할 일만 일시 정지할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen een taak die bezig is, kan worden gepauzeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymać można tylko zadanie w toku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só é possível pausar uma tarefa em andamento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar o sarcină în curs poate fi suspendată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приостановить можно только задачу в работе."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Призупинити можна лише завдання, що в роботі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف جاری کام کو موقوف کیا جا سکتا ہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有进行中的任务才能暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有進行中的任務才能暫停。"
          }
        }
      }
    },
    "error.reason.record_too_long_to_sync": {
      "comment": "Alert shown when saving an item whose text, all fields together, is more than one sync record can carry.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا العنصر أطول من أن تتم مزامنته. اختصر أطول نص فيه ثم حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Objekt ist zu lang für die Synchronisierung. Kürze den längsten Text und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item is too long to sync. Shorten its longest text and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este elemento es demasiado largo para sincronizarse. Acorta su texto más largo e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این مورد برای همگام‌سازی بیش از حد طولانی است. طولانی‌ترین متن آن را کوتاه کنید و دوباره تلاش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet élément est trop long pour être synchronisé. Raccourcissez son texte le plus long, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפריט הזה ארוך מדי לסנכרון. יש לקצר את הטקסט הארוך ביותר שבו ולנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आइटम सिंक होने के लिए बहुत लंबा है। इसका सबसे लंबा टेक्स्ट छोटा करके फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elemento è troppo lungo per essere sincronizzato. Accorcia il testo più lungo e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目は長すぎて同期できません。いちばん長いテキストを短くしてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목이 너무 길어 동기화할 수 없습니다. 가장 긴 텍스트를 줄인 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit item is te lang om te synchroniseren. Kort de langste tekst in en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten element jest za długi, aby go zsynchronizować. Skróć jego najdłuższy tekst i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este item é longo demais para sincronizar. Encurte o texto mais longo e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest element este prea lung pentru a fi sincronizat. Scurtați cel mai lung text și încercați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот элемент слишком длинный для синхронизации. Сократите самый длинный текст и попробуйте ещё раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей елемент задовгий для синхронізації. Скоротіть найдовший текст та спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ آئٹم سنک کرنے کے لیے بہت لمبا ہے۔ اس کا سب سے لمبا متن مختصر کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容太长，无法同步，请缩短最长的部分后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內容太長，無法同步，請縮短最長的部分後再試。"
          }
        }
      }
    },
    "error.reason.starting_canceled_task": {
      "comment": "Alert shown when a person starts a task that was canceled.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إلغاء هذه المهمة. أعِد فتحها قبل بدئها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aufgabe wurde abgebrochen. Öffne sie wieder, bevor du sie startest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This task was canceled. Reopen it before starting it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarea se canceló. Reábrela antes de iniciarla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار لغو شده است. پیش از شروع، آن را بازگشایی کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette tâche a été annulée. Rouvrez-la avant de la démarrer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשימה הזו בוטלה. יש לפתוח אותה מחדש לפני התחלתה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कार्य रद्द कर दिया गया है। शुरू करने से पहले इसे फिर से खोलें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa attività è stata annullata. Riaprila prima di iniziarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタスクはキャンセルされています。開始する前に未完了に戻してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 할 일은 취소되었습니다. 시작하려면 먼저 다시 여세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze taak is geannuleerd. Heropen de taak voordat je deze start."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zadanie zostało anulowane. Otwórz je ponownie, zanim je rozpoczniesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarefa foi cancelada. Reabra-a antes de iniciá-la."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această sarcină a fost anulată. Redeschideți-o înainte de a o începe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта задача отменена. Чтобы начать её, сначала откройте её снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це завдання скасовано. Щоб почати його, спершу відкрийте його знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ کام منسوخ کر دیا گیا تھا۔ شروع کرنے سے پہلے اسے دوبارہ کھولیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个任务已取消，请先重新打开再开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個任務已取消，請先重新開啟再開始。"
          }
        }
      }
    },
    "error.reason.starting_done_task": {
      "comment": "Alert shown when a person starts a task that is already done.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه المهمة مكتملة بالفعل. أعِد فتحها قبل بدئها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aufgabe ist bereits erledigt. Öffne sie wieder, bevor du sie startest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This task is already done. Reopen it before starting it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarea ya está completada. Reábrela antes de iniciarla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار از قبل تکمیل شده است. پیش از شروع، آن را بازگشایی کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette tâche est déjà terminée. Rouvrez-la avant de la démarrer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשימה הזו כבר הושלמה. יש לפתוח אותה מחדש לפני התחלתה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कार्य पहले ही पूरा हो चुका है। शुरू करने से पहले इसे फिर से खोलें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa attività è già completata. Riaprila prima di iniziarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタスクはすでに完了しています。開始する前に未完了に戻してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 할 일은 이미 완료되었습니다. 시작하려면 먼저 다시 여세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze taak is al voltooid. Heropen de taak voordat je deze start."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zadanie jest już ukończone. Otwórz je ponownie, zanim je rozpoczniesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarefa já foi concluída. Reabra-a antes de iniciá-la."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această sarcină este deja finalizată. Redeschideți-o înainte de a o începe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта задача уже выполнена. Чтобы начать её, сначала откройте её снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це завдання вже виконано. Щоб почати його, спершу відкрийте його знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ کام پہلے ہی مکمل ہو چکا ہے۔ شروع کرنے سے پہلے اسے دوبارہ کھولیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个任务已经完成，请先重新打开再开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個任務已經完成，請先重新開啟再開始。"
          }
        }
      }
    },
    "error.reason.starting_someday_task": {
