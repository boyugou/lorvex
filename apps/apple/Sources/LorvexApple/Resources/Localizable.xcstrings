          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоден асистент ще не використовував Lorvex на цьому Mac."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی تک کسی اسسٹنٹ نے اس Mac پر Lorvex استعمال نہیں کیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có trợ lý nào dùng Lorvex trên máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
