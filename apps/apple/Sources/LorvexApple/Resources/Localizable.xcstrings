    "habits.sheet.field.milestone_goal_hint_streak": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طول السلسلة بالأيام، مثل ثلاثين. تستمر العادة."
          }
        },
        "de": {
          "stringUnit": {
