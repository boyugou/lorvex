        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "టాస్క్‌ను జోడించడానికి ఏ ట్యాబ్‌లో అయినా ＋ ట్యాప్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะ ＋ ในแท็บใดก็ได้เพื่อเพิ่มงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görev eklemek için herhangi bir sekmede ＋ simgesine dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніть ＋ на будь-якій вкладці, щоб додати завдання."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کام شامل کرنے کے لیے کسی بھی ٹیب پر ＋ پر ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm ＋ trên bất kỳ tab nào để thêm nhiệm vụ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意标签页点按 ＋ 即可添加任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何分頁點一下 ＋ 即可新增任務。"
          }
        }
      }
    },
    "setup.done.assistant.title": {
      "extractionState": "manual",
      "localizations": {
