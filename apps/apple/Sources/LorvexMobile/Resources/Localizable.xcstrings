    "data_export.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصدير كامل لجداول الفئات التي تحددها، بصيغة JSON أو CSV أو كحزمة ZIP."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নির্বাচন করা বিভাগগুলির সম্পূর্ণ টেবিল এক্সপোর্ট, JSON, CSV বা ZIP প্যাকেজ হিসাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vollständiger Tabellenexport der ausgewählten Kategorien als JSON, CSV oder ZIP-Paket."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εξαγωγή όλων των δεδομένων των κατηγοριών που επιλέγετε, ως JSON, CSV ή πακέτο ZIP."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full-table export of the categories you select, as JSON, CSV, or a ZIP package."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
