    "recurrence.anchor.completion.hint": {
      "comment": "One line beneath the repeat editor's anchor control, explaining “After completion”.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحدَّد موعد المهمة التالية بناءً على وقت إكمال هذه المهمة، لذا فإن الإكمال المتأخر يؤخر موعدها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next one is scheduled relative to when you complete this, so a late finish pushes it forward."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La siguiente se programa a partir del momento en que completes esta, por lo que terminar tarde la retrasa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La prochaine occurrence est planifiée à partir du moment où vous terminez celle-ci : si vous finissez en retard, elle est repoussée d’autant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगली बार की तारीख़ इस पर निर्भर है कि आप इसे कब पूरा करते हैं, इसलिए देर से पूरा करने पर वह आगे खिसक जाती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La successiva viene pianificata in base a quando completi questa, quindi un completamento in ritardo la sposta in avanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回は、このタスクを完了した日を基準にスケジュールされます。完了が遅れると、次回もその分後ろにずれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 할 일은 이 할 일을 완료한 시점을 기준으로 일정이 잡히므로, 늦게 완료하면 그만큼 뒤로 밀립니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolejne powtórzenie jest planowane od momentu ukończenia tego, więc późne ukończenie przesuwa je do przodu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A próxima é planejada com base em quando você conclui esta, então uma conclusão tardia a empurra para frente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующее повторение планируется от момента выполнения этого, поэтому позднее выполнение сдвигает его вперёд."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наступне повторення планується від моменту виконання цього, тож пізніше виконання зсуває його вперед."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一个会以你完成这一个的时间为基准来安排，因此完成得越晚，下一个就顺延得越晚。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下一次會以你完成這一次的時間為基準來安排，所以越晚完成，下一次就越晚。"
          }
        }
      }
    },
