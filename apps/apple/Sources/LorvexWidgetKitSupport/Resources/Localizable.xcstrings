    "widget.today.desc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطّلع على مهام اليوم بنظرة سريعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
