          }
        }
      }
    },
    "widget.progress.inline": {
      "comment": "Inline progress text; %1$lld completed of %2$lld total",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%#@taskcount@"
