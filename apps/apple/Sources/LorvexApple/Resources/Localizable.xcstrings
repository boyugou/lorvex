    "memory.delete.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف إدخال الذاكرة. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Gedächtniseintrag wird entfernt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The memory entry is removed. This can’t be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará el recuerdo. Esta acción no se puede deshacer."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این مورد از حافظه حذف می‌شود. این کار قابل بازگشت نیست."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le souvenir sera supprimé. Cette action est irréversible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשומת הזיכרון תימחק. לא ניתן לבטל פעולה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेमोरी एंट्री हटा दी जाएगी। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ricordo verrà rimosso. L’azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモリ項目が削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모리 항목이 삭제됩니다. 이 동작은 취소할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het geheugenitem wordt verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpis zostanie usunięty. Tej czynności nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A memória será removida. Esta ação não pode ser desfeita."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrarea din memorie va fi eliminată. Această acțiune nu poate fi anulată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись будет удалена. Это действие нельзя отменить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис буде видалено. Цю дію не можна скасувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "حافظے کا یہ اندراج ہٹا دیا جائے گا۔ اسے واپس نہیں کیا جا سکتا۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该记忆条目及其历史记录将被删除，此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此記憶項目將被移除，且無法還原。"
          }
        }
      }
    },
