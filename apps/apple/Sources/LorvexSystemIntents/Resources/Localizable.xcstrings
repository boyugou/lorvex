    "system.task.cancel.description": {
      "comment": "Description for cancelling only one Lorvex task occurrence while preserving future occurrences",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء هذا التكرار لمهمة في Lorvex من الاختصارات أو Siri. تستمر المهام المتكررة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel this Lorvex task occurrence from Shortcuts or Siri. Repeating tasks continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancela esta repetición de una tarea de Lorvex desde Atajos o Siri. Las tareas recurrentes continúan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annule cette occurrence d’une tâche de Lorvex depuis Raccourcis ou Siri. Les tâches récurrentes continuent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट्स या Siri से Lorvex कार्य का केवल यह एक बार रद्द करें। दोहराए जाने वाले कार्य जारी रहते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla questa occorrenza di un’attività di Lorvex da Comandi rapidi o Siri. Le attività ricorrenti continuano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットまたはSiriで、Lorvexのタスクの今回分をキャンセルします。繰り返しタスクは以降も続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어 또는 Siri에서 Lorvex 할 일의 이번 반복을 취소합니다. 반복되는 할 일은 계속됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anuluje to wystąpienie zadania Lorvex ze Skrótów lub Siri. Zadania powtarzające się są kontynuowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancela esta ocorrência de uma tarefa do Lorvex pelos Atalhos ou pela Siri. As tarefas recorrentes continuam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменяет это повторение задачи Lorvex из «Быстрых команд» или Siri. Повторяющиеся задачи продолжаются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасовує це повторення завдання Lorvex зі «Швидких команд» або Siri. Повторювані завдання тривають."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过快捷指令或 Siri 仅取消 Lorvex 任务的本次执行。之后的执行仍会继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過捷徑或 Siri 取消 Lorvex 任務的這一次。重複任務會繼續進行。"
          }
        }
      }
    },
