    "system.tag.rename.description": {
      "comment": "Description for the Rename Lorvex Tag App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة تسمية وسم مهام في Lorvex من الاختصارات أو Siri."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শর্টকাট বা Siri থেকে একটি Lorvex টাস্ক ট্যাগের নাম বদলান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benennt einen Tag von Lorvex-Aufgaben über Kurzbefehle oder Siri um."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετονομάστε μια ετικέτα εργασιών Lorvex από τις Συντομεύσεις ή το Siri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rename a Lorvex task tag from Shortcuts or Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Renombra una etiqueta de tareas de Lorvex desde Atajos o Siri."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تغییر نام یک برچسب کار Lorvex از طریق میان‌برها یا Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renomme un tag de tâches de Lorvex depuis Raccourcis ou Siri."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שינוי שם של תג משימות ב-Lorvex דרך קיצורי דרך או Siri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट्स या Siri से Lorvex कार्य टैग का नाम बदलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengubah nama label tugas Lorvex dari Pintasan atau Siri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinomina un tag delle attività di Lorvex da Comandi rapidi o Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットまたはSiriでLorvexのタスクのタグ名を変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어 또는 Siri에서 Lorvex 할 일 태그의 이름을 바꿉니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट किंवा Siri द्वारे एका Lorvex कार्य टॅगचे नाव बदला."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menamakan semula tag tugas Lorvex daripada Pintasan atau Siri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hernoemt een tag voor Lorvex-taken via Opdrachten of Siri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmienia nazwę tagu zadań Lorvex ze Skrótów lub Siri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renomeia uma etiqueta de tarefas do Lorvex pelos Atalhos ou pela Siri."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Redenumește un tag pentru sarcinile Lorvex prin Scurtături sau Siri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переименовывает тег задач Lorvex из «Быстрых команд» или Siri."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்கவழிகள் அல்லது Siri மூலம் Lorvex பணிக் குறிச்சொல்லின் பெயரை மாற்றவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "షార్ట్‌కట్స్ లేదా Siri నుండి Lorvex టాస్క్ ట్యాగ్ పేరు మార్చండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนชื่อแท็กงาน Lorvex จากคำสั่งลัดหรือ Siri"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kestirmeler veya Siri ile bir Lorvex görev etiketini yeniden adlandırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейменовує тег завдань Lorvex зі «Швидких команд» або Siri."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شارٹ کٹس یا Siri سے Lorvex کام ٹیگ کا نام بدلیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổi tên một thẻ nhiệm vụ Lorvex từ Phím tắt hoặc Siri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“快捷指令”或 Siri 重命名 Lorvex 任务标签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過捷徑或 Siri 重新命名 Lorvex 任務標籤。"
          }
        }
      }
    },
