            "value": "MO、WE、FR 等星期代碼（選填）。"
          }
        }
      }
    },
    "system.task.pause.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف مهمة بدأ العمل عليها في Lorvex مؤقتًا. تبقى في يومها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause a started Lorvex task. It stays on its day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa una tarea de Lorvex iniciada. Se queda en su día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met en pause une tâche de Lorvex démarrée. Elle reste à la même date."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू किया गया Lorvex कार्य रोकें। वह अपने दिन पर ही रहता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mette in pausa un’attività di Lorvex iniziata. Resta nel suo giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始したLorvexのタスクを一時停止します。タスクは同じ日のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작한 Lorvex 할 일을 일시 중지합니다. 할 일은 해당 날짜에 그대로 남습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymuje rozpoczęte zadanie Lorvex. Pozostaje ono zaplanowane na ten sam dzień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa uma tarefa do Lorvex iniciada. Ela continua no mesmo dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приостанавливает начатую задачу Lorvex. Она остаётся запланированной на тот же день."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Призупиняє розпочате завдання Lorvex. Воно залишається запланованим на той самий день."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停一个已开始的 Lorvex 任务，它仍留在原来的日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫停已開始的 Lorvex 任務。任務會保留在原本的日期。"
          }
        }
      }
    },
