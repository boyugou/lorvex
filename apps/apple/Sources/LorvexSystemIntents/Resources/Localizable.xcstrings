          "stringUnit": {
            "state": "translated",
            "value": "حذف یکی از یادآورهای یک عادت Lorvex."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime l’un des rappels d’une habitude de Lorvex."
          }
        },
