        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar tareas, navegar o añadir…"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "جست‌وجوی کارها، پیمایش یا افزودن…"
