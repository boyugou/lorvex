        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 할 일을 외부 캘린더 이벤트에 연결합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiązuje zadanie Lorvex z wydarzeniem kalendarza zewnętrznego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vincula uma tarefa do Lorvex a um evento externo do calendário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Связывает задачу Lorvex с событием внешнего календаря."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
