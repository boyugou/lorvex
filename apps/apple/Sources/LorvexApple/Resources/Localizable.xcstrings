    "setup.welcome.assistant.detail": {
      "comment": "Simplified Chinese deliberately names no assistant product here (China mainland App Store review); other languages may name Claude as the example.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتضمن Lorvex ذكاءً اصطناعيًا خاصًا به. اربط Claude أو مساعد MCP آخر على جهاز Mac هذا، وسيضيف المهام ويخطط معك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex hat keine eigene KI. Verbinde Claude oder einen anderen MCP-Assistenten auf diesem Mac, und er erfasst und plant gemeinsam mit dir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex has no AI of its own. Connect Claude or another MCP assistant on this Mac, and it captures and plans with you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex no tiene IA propia. Conecta Claude u otro asistente MCP en este Mac y anotará y planificará contigo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه Lorvex هوش مصنوعی مخصوص به خود ندارد. Claude یا دستیار MCP دیگری را روی این Mac وصل کنید تا همراه شما کارها را ثبت و برنامه‌ریزی کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex n’a pas d’IA propre. Connectez Claude ou un autre assistant MCP sur ce Mac : il ajoute des tâches et planifie avec vous."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ל-Lorvex אין AI מובנה. אפשר לחבר ל-Mac הזה את Claude או עוזר MCP אחר, והוא יוסיף משימות ויתכנן יחד איתך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex में अपना कोई AI नहीं है। इस Mac पर Claude या कोई दूसरा MCP असिस्टेंट जोड़ें, और वह आपके साथ कार्य जोड़ेगा और प्लान करेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex non ha un’IA propria. Collega Claude o un altro assistente MCP su questo Mac e aggiungerà attività e pianificherà con te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LorvexにはAIが組み込まれていません。このMacでClaudeなどのMCPアシスタントを接続すると、タスクの追加や計画を一緒に行ってくれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex에는 자체 AI가 없습니다. 이 Mac에서 Claude 또는 다른 MCP 어시스턴트를 연결하면 함께 할 일을 추가하고 계획해 줍니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex heeft geen eigen AI. Verbind Claude of een andere MCP-assistent op deze Mac, en die legt vast en plant samen met jou."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex nie ma własnej sztucznej inteligencji. Połącz Claude lub innego asystenta MCP na tym Macu, a będzie dodawać zadania i planować razem z tobą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lorvex não tem IA própria. Conecte o Claude ou outro assistente MCP neste Mac e ele adiciona tarefas e planeja com você."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex nu are un AI propriu. Conectați Claude sau un alt asistent MCP pe acest Mac, iar acesta vă ajută să adăugați sarcini și să planificați."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Lorvex нет собственного ИИ. Подключите Claude или другого MCP-ассистента на этом Mac, и он будет добавлять задачи и планировать вместе с вами."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У Lorvex немає власного ШІ. Підключіть Claude або іншого MCP-асистента на цьому Mac, і він додаватиме завдання та плануватиме разом із вами."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ایپ میں اپنا کوئی AI نہیں ہے۔ اس Mac پر Claude یا کوئی اور MCP اسسٹنٹ جوڑ لیں، وہ آپ کے ساتھ مل کر کام شامل کرے گا اور منصوبہ بنائے گا۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 本身不含 AI。在这台 Mac 上连接支持 MCP 的 AI 助手，它会和你一起记录和规划。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 本身沒有內建 AI。在這部 Mac 上連接 Claude 或其他 MCP 助理後，它就能與你一起快速新增任務並規劃。"
          }
        }
      }
    },
    "setup.welcome.today.title": {
      "extractionState": "manual",
      "localizations": {
