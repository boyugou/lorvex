    "system.memory.read.description": {
      "comment": "Description for the Read Lorvex Memory App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة إدخال من ذاكرة Lorvex باستخدام المفتاح من الاختصارات أو Siri."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শর্টকাট বা Siri থেকে কী ব্যবহার করে একটি Lorvex মেমোরি এন্ট্রি পড়ুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest einen Lorvex-Gedächtniseintrag anhand seines Schlüssels über Kurzbefehle oder Siri."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαβάστε μια καταχώριση μνήμης Lorvex με βάση το κλειδί της από τις Συντομεύσεις ή το Siri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read a Lorvex memory entry by key from Shortcuts or Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee un recuerdo de Lorvex por clave desde Atajos o Siri."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خواندن یک مورد حافظه Lorvex با کلید، از طریق میان‌برها یا Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit un souvenir de Lorvex à partir de sa clé, depuis Raccourcis ou Siri."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קריאת רשומת זיכרון ב-Lorvex לפי מפתח, דרך קיצורי דרך או Siri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट्स या Siri से कुंजी के आधार पर Lorvex मेमोरी एंट्री पढ़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca entri memori Lorvex berdasarkan kunci dari Pintasan atau Siri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge un ricordo di Lorvex tramite chiave da Comandi rapidi o Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットまたはSiriで、キーを指定してLorvexのメモリを読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어 또는 Siri에서 키로 Lorvex 메모리를 읽습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट किंवा Siri द्वारे की वापरून एक Lorvex मेमरी नोंद वाचा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca entri memori Lorvex mengikut kunci daripada Pintasan atau Siri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest een Lorvex-geheugenitem op basis van de sleutel via Opdrachten of Siri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytuje według klucza wpis pamięci Lorvex ze Skrótów lub Siri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê uma memória do Lorvex pela chave, pelos Atalhos ou pela Siri."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Citește după cheie o înregistrare din memoria Lorvex prin Scurtături sau Siri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает по ключу запись памяти Lorvex из «Быстрых команд» или Siri."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்கவழிகள் அல்லது Siri மூலம் கீ அடிப்படையில் Lorvex நினைவகப் பதிவைப் படிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "షార్ట్‌కట్స్ లేదా Siri నుండి కీ ద్వారా Lorvex మెమరీ నమోదును చదవండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านรายการหน่วยความจำ Lorvex โดยระบุคีย์ จากคำสั่งลัดหรือ Siri"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kestirmeler veya Siri ile bir Lorvex bellek girdisini anahtarıyla okuyun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читає за ключем запис пам’яті Lorvex зі «Швидких команд» або Siri."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شارٹ کٹس یا Siri سے کلید کے ذریعے Lorvex حافظہ اندراج پڑھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc một mục ghi nhớ Lorvex theo khóa từ Phím tắt hoặc Siri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“快捷指令”或 Siri 按键读取 Lorvex 记忆条目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過捷徑或 Siri，依鍵讀取 Lorvex 記憶。"
          }
        }
      }
    },
