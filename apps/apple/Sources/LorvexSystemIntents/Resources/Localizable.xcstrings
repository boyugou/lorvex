        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบรายการนี้หรือไม่ การดำเนินการนี้ไม่สามารถเลิกทำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu öğe silinsin mi? Bu işlem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити цей елемент? Цю дію не можна скасувати."
          }
        },
        "ur": {
