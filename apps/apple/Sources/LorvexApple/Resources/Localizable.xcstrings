    "settings.calendar.two_way_detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ Lorvex أحداث تقويمك، ويكتب الأحداث التي تضيفها فيه في تقويم \"Lorvex\" المخصص، ولا يكتب أبدًا في تقويماتك الشخصية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest deine Kalenderereignisse in Lorvex ein und schreibt die in Lorvex hinzugefügten Ereignisse in einen eigenen Kalender „Lorvex“ – niemals in deine persönlichen Kalender."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read your calendar events into Lorvex and write the events you add in Lorvex into a dedicated “Lorvex” calendar — never your personal calendars."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee tus eventos del calendario en Lorvex y escribe los eventos que añadas en Lorvex en un calendario “Lorvex” propio, nunca en tus calendarios personales."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رویدادهای تقویم شما را در Lorvex می‌خواند و رویدادهایی را که در Lorvex اضافه می‌کنید در تقویم اختصاصی «Lorvex» می‌نویسد — هرگز در تقویم‌های شخصی شما."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex lit vos événements de calendrier et enregistre ceux que vous y ajoutez dans un calendrier « Lorvex » dédié, jamais dans vos calendriers personnels."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קריאת אירועי לוח השנה שלך אל Lorvex וכתיבת האירועים שמוסיפים ב-Lorvex ללוח שנה ייעודי בשם \"Lorvex\" — אף פעם לא ללוחות השנה האישיים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके कैलेंडर इवेंट Lorvex में पढ़े जाते हैं, और Lorvex में जोड़े गए इवेंट एक अलग “Lorvex” कैलेंडर में लिखे जाते हैं। आपके निजी कैलेंडर में कभी कुछ नहीं लिखा जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex legge gli eventi del tuo calendario e scrive quelli che aggiungi in Lorvex in un calendario “Lorvex” dedicato, mai nei tuoi calendari personali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーのイベントをLorvexに読み込み、Lorvexで追加したイベントは専用の「Lorvex」カレンダーに書き込みます。個人のカレンダーには書き込みません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 이벤트를 Lorvex로 읽어 오고, Lorvex에서 추가한 이벤트는 전용 ‘Lorvex’ 캘린더에 기록합니다. 개인 캘린더에는 기록하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest je agenda-activiteiten in Lorvex in en schrijft activiteiten die je in Lorvex toevoegt naar een aparte agenda ‘Lorvex’ – nooit naar je persoonlijke agenda’s."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex odczytuje wydarzenia z twoich kalendarzy, a dodane w Lorvex wydarzenia zapisuje w osobnym kalendarzu „Lorvex” — nigdy w twoich kalendarzach osobistych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lorvex lê os eventos do seu calendário e grava os eventos que você adiciona nele em um calendário “Lorvex” dedicado, nunca nos seus calendários pessoais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Citește evenimentele din calendar în Lorvex și scrie evenimentele adăugate în Lorvex într-un calendar dedicat „Lorvex” – niciodată în calendarele personale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex считывает события из ваших календарей, а добавленные в Lorvex события записывает в отдельный календарь «Lorvex» — никогда не в ваши личные календари."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex зчитує події з ваших календарів, а додані в Lorvex події записує в окремий календар «Lorvex» — ніколи не у ваші особисті календарі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے کیلنڈر ایونٹس کو Lorvex میں پڑھیں اور Lorvex میں شامل کردہ ایونٹس کو ایک مخصوص \"Lorvex\" کیلنڈر میں لکھیں — آپ کے ذاتی کیلنڈرز میں کبھی نہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将你的日历事件读入 Lorvex，并把你在 Lorvex 中添加的事件写入专用的“Lorvex”日历，不会写入你的个人日历。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將你的行事曆事件讀取到 Lorvex，並把你在 Lorvex 中新增的事件寫入專用的「Lorvex」行事曆，絕不會寫入你的個人行事曆。"
          }
        }
      }
    },
