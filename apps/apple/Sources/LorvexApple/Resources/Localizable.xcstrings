    "settings.permissions.show_task_notes": {
      "comment": "Toggle label: whether a task's notes may appear in its reminder notification",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار ملاحظات المهمة في الإشعارات"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নোটিফিকেশনে টাস্কের নোট দেখান"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgabennotizen in Mitteilungen anzeigen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφάνιση σημειώσεων εργασίας στις γνωστοποιήσεις"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
