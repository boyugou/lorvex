    "setup.done.capture.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط ⁦⌘N⁩ في أي مكان في Lorvex لإضافة مهمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টাস্ক যোগ করতে Lorvex-এর যেকোনো জায়গায় ⌘N চাপুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke in Lorvex überall ⌘N, um eine Aufgabe hinzuzufügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε ⌘N οπουδήποτε στο Lorvex για να προσθέσετε μια εργασία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press ⌘N anywhere in Lorvex to add a task."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa ⌘N en cualquier parte de Lorvex para añadir una tarea."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای افزودن کار، در هر جای Lorvex کلیدهای ⁦⌘N⁩ را بزنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur ⌘N n’importe où dans Lorvex pour ajouter une tâche."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להוסיף משימה, לוחצים על ⁦⌘N⁩ בכל מקום ב-Lorvex."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्य जोड़ने के लिए Lorvex में कहीं भी ⌘N दबाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan ⌘N di mana saja di Lorvex untuk menambahkan tugas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi ⌘N ovunque in Lorvex per aggiungere un’attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexのどこでも⌘Nを押すと、タスクを追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 어디에서든 ⌘N 단축키를 눌러 할 일을 추가하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्य जोडण्यासाठी Lorvex मध्ये कुठेही ⌘N दाबा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan ⌘N di mana-mana dalam Lorvex untuk menambah tugas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk overal in Lorvex op ⌘N om een taak toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij ⌘N w dowolnym miejscu w Lorvex, aby dodać zadanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione ⌘N em qualquer lugar do Lorvex para adicionar uma tarefa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apăsați ⌘N oriunde în Lorvex pentru a adăuga o sarcină."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите ⌘N в любом месте Lorvex, чтобы добавить задачу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กด ⌘N ที่ใดก็ได้ใน Lorvex เพื่อเพิ่มงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görev eklemek için Lorvex’in herhangi bir yerinde ⌘N tuşlarına basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть ⌘N будь-де в Lorvex, щоб додати завдання."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کام شامل کرنے کے لیے Lorvex میں کہیں بھی ⁦⌘N⁩ دبائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn ⌘N ở bất kỳ đâu trong Lorvex để thêm nhiệm vụ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Lorvex 中随时按 ⌘N 添加任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Lorvex 的任何地方按下 ⌘N，即可新增任務。"
          }
        }
      }
    },
    "setup.done.assistant.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أو دع مساعدك يضيفها"
          }
