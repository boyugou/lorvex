    "settings.sync.status.checking": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ التحقق…"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চেক করা হচ্ছে…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird geprüft …"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έλεγχος…"
          }
        },
