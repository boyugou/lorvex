    "system.day_times.read.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة مهام Lorvex التي لها وقت محدد اليوم أو في تاريخ معين."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the Lorvex tasks with a time today or on a specific date."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee las tareas de Lorvex con hora de hoy o de una fecha concreta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit les tâches Lorvex ayant un horaire aujourd’hui ou à une date précise."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज या किसी तय तारीख़ के वे Lorvex कार्य पढ़ें जिनका समय तय है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge le attività di Lorvex con un orario oggi o in una data specifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日または指定した日の、時間が設定されたLorvexのタスクを読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 또는 지정한 날짜에 시간이 정해진 Lorvex 할 일을 읽습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytuje zadania Lorvex z godziną na dzisiaj lub wybraną datę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê as tarefas do Lorvex com horário hoje ou em uma data específica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает задачи Lorvex со временем на сегодня или на выбранную дату."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читає завдання Lorvex із часом на сьогодні або на вибрану дату."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取今天或指定日期里有时间安排的 Lorvex 任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取今天或指定日期已安排時間的 Lorvex 任務。"
          }
        }
      }
    },
