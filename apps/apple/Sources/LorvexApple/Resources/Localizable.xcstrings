    "setup.sync.private.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُخزَّن مشفّرة في حساب iCloud الخاص بك. ليس لدى Lorvex خادم خاص به."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নিজের iCloud অ্যাকাউন্টে এনক্রিপ্টেড অবস্থায় সংরক্ষিত। Lorvex-এর নিজস্ব কোনো সার্ভার নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsselt in deinem eigenen iCloud-Account gespeichert. Lorvex hat keinen eigenen Server."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκεύονται κρυπτογραφημένα στον δικό σας λογαριασμό iCloud. Το Lorvex δεν έχει δικό του διακομιστή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored encrypted in your own iCloud account. Lorvex has no server of its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guardan cifrados en tu propia cuenta de iCloud. Lorvex no tiene servidor propio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به‌صورت رمزگذاری‌شده در حساب iCloud خودتان ذخیره می‌شود. Lorvex سرور اختصاصی ندارد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données sont chiffrées dans votre propre compte iCloud. Lorvex n’a pas de serveur propre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נשמר מוצפן בחשבון ה-iCloud שלך. אין ל-Lorvex שרת עצמאי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके अपने iCloud खाते में एन्क्रिप्टेड रूप में सहेजा जाता है। Lorvex का अपना कोई सर्वर नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disimpan terenkripsi di akun iCloud milik Anda sendiri. Lorvex tidak memiliki server sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati sono archiviati con crittografia nel tuo account iCloud. Lorvex non ha un server proprio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなた自身のiCloudアカウントに暗号化して保存されます。Lorvexには独自のサーバはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 본인의 iCloud 계정에 암호화되어 저장됩니다. Lorvex에는 자체 서버가 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या स्वतःच्या iCloud अकाउंटमध्ये एनक्रिप्ट करून साठवले जाते. Lorvex चा स्वतःचा कोणताही सर्व्हर नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Disimpan dengan penyulitan dalam akaun iCloud anda sendiri. Lorvex tidak mempunyai pelayan sendiri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Versleuteld opgeslagen in je eigen iCloud-account. Lorvex heeft geen eigen server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane są przechowywane w postaci zaszyfrowanej na twoim koncie iCloud. Lorvex nie ma własnego serwera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dados ficam armazenados com criptografia na sua própria conta do iCloud. O Lorvex não tem servidor próprio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Stocate criptat în propriul cont iCloud. Lorvex nu are un server propriu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранится в зашифрованном виде в вашей учётной записи iCloud. У Lorvex нет собственного сервера."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் சொந்த iCloud கணக்கில் என்கிரிப்ட் செய்து சேமிக்கப்படுகிறது. Lorvexக்குச் சொந்த சர்வர் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ స్వంత iCloud ఖాతాలో ఎన్‌క్రిప్ట్ చేసి నిల్వ చేయబడుతుంది. Lorvexకు సొంత సర్వర్ లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดเก็บแบบเข้ารหัสในบัญชี iCloud ของคุณเอง Lorvex ไม่มีเซิร์ฟเวอร์ของตัวเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi iCloud hesabınızda şifrelenmiş olarak saklanır. Lorvex’in kendi sunucusu yoktur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігається в зашифрованому вигляді у вашому обліковому записі iCloud. У Lorvex немає власного сервера."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے اپنے iCloud اکاؤنٹ میں خفیہ کردہ حالت میں محفوظ۔ Lorvex کا اپنا کوئی سرور نہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được lưu trữ ở dạng mã hóa trong chính tài khoản iCloud của bạn. Lorvex không có máy chủ riêng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加密保存在你自己的 iCloud 账户中。Lorvex 没有自己的服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料會加密儲存在你自己的 iCloud 帳號中。Lorvex 沒有自己的伺服器。"
          }
        }
      }
    },
    "setup.sync.off.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقفها متى شئت"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যখন খুশি বন্ধ করুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jederzeit ausschaltbar"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απενεργοποίηση όποτε θέλετε"
          }
        },
        "en": {
