        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדפוס השבועי שלך יוצג כאן לאחר שבועיים של סימונים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दो सप्ताह के चेक-इन के बाद आपका साप्ताहिक पैटर्न यहाँ दिखेगा।"
