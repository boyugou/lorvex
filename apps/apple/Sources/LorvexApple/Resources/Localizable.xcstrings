            "value": "எந்த நேர்வுகளை நீக்க வேண்டும் என்பதைத் தேர்வுசெய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏ సందర్భాలను డిలీట్ చేయాలో ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกกิจกรรมที่ต้องการลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silinecek etkinlikleri seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть, які повторення видалити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب کریں کہ کون سی تکرارات حذف کی جائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn những lần lặp cần xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择要删除哪些重复项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇要刪除的範圍。"
          }
        }
      }
    },
    "calendar.delete_event.scope.title": {
