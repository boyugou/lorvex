    "error.reason.tag_name_taken": {
      "comment": "Alert shown when a tag is renamed to the name of another tag.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد وسم بهذا الاسم بالفعل. اختر اسمًا آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tag mit diesem Namen existiert bereits. Wähle einen anderen Namen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tag with this name already exists. Choose another name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe una etiqueta con este nombre. Elige otro nombre."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برچسبی با این نام از قبل وجود دارد. نام دیگری انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tag porte déjà ce nom. Choisissez-en un autre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כבר קיים תג בשם הזה. יש לבחור שם אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस नाम का टैग पहले से मौजूद है। कोई दूसरा नाम चुनें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esiste già un tag con questo nome. Scegli un altro nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ名前のタグがすでにあります。別の名前を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 이름의 태그가 이미 있습니다. 다른 이름을 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er bestaat al een tag met deze naam. Kies een andere naam."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag o tej nazwie już istnieje. Wybierz inną nazwę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já existe uma etiqueta com esse nome. Escolha outro nome."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Există deja un tag cu acest nume. Alegeți alt nume."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тег с таким названием уже существует. Выберите другое название."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тег із такою назвою вже існує. Виберіть іншу назву."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس نام کا ٹیگ پہلے سے موجود ہے۔ کوئی اور نام منتخب کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有同名标签，请换一个名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有同名標籤，請換一個名稱。"
          }
        }
      }
    },
    "error.reason.tag_too_long": {
      "comment": "Alert shown when one of a task's tags is longer than the app accepts.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أحد الوسوم طويل جدًا. اختصره ثم حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tag ist zu lang. Kürze ihn und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tag is too long. Shorten it and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una etiqueta es demasiado larga. Acórtala e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک برچسب بیش از حد طولانی است. آن را کوتاه‌تر کنید و دوباره تلاش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tag est trop long. Raccourcissez-le, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אחד התגים ארוך מדי. יש לקצר אותו ולנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक टैग बहुत लंबा है। उसे छोटा करके फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tag è troppo lungo. Accorcialo e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグが長すぎます。短くしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "태그가 너무 깁니다. 줄인 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een tag is te lang. Kort de tag in en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden z tagów jest za długi. Skróć go i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma etiqueta é longa demais. Encurte-a e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tag este prea lung. Scurtați-l și încercați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один из тегов слишком длинный. Сократите его и попробуйте ещё раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один із тегів задовгий. Скоротіть його та спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک ٹیگ بہت لمبا ہے۔ اسے مختصر کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签太长了，请缩短后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤太長了，請縮短後再試。"
          }
        }
      }
    },
    "error.reason.task_start_blocked": {
      "comment": "Alert shown when a person starts a task whose dependencies are not finished.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعتمد هذه المهمة على مهام لم تكتمل بعد. أكمِلها أو ألغِها أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aufgabe hängt von Aufgaben ab, die noch nicht erledigt sind. Erledige oder breche diese zuerst ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This task depends on tasks that aren’t done yet. Finish or cancel them first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarea depende de tareas que aún no están terminadas. Termínalas o cancélalas primero."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار به کارهایی وابسته است که هنوز انجام نشده‌اند. ابتدا آن‌ها را تکمیل یا لغو کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette tâche dépend de tâches qui ne sont pas encore terminées. Terminez-les ou annulez-les d’abord."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשימה הזו תלויה במשימות שעדיין לא הושלמו. יש להשלים או לבטל אותן קודם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कार्य उन कार्यों पर निर्भर है जो अभी पूरे नहीं हुए हैं। पहले उन्हें पूरा या रद्द करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa attività dipende da attività non ancora completate. Completale o annullale prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタスクの依存先のタスクがまだ完了していません。先に完了するか、キャンセルしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 할 일이 의존하는 할 일이 아직 완료되지 않았습니다. 먼저 완료하거나 취소하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze taak hangt af van taken die nog niet zijn voltooid. Voltooi of annuleer die eerst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zadanie zależy od zadań, które nie są jeszcze ukończone. Najpierw je ukończ lub anuluj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarefa depende de tarefas que ainda não foram concluídas. Conclua ou cancele essas tarefas primeiro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această sarcină depinde de sarcini care nu sunt încă finalizate. Finalizați-le sau anulați-le mai întâi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта задача зависит от незавершённых задач. Сначала завершите или отмените их."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це завдання залежить від незавершених завдань. Спершу завершіть або скасуйте їх."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ کام ایسے کاموں پر منحصر ہے جو ابھی مکمل نہیں ہوئے۔ پہلے انہیں مکمل یا منسوخ کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个任务依赖的任务还没完成，请先完成或取消它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個任務相依的任務還沒完成，請先完成或取消它們。"
          }
        }
      }
    },
    "error.reason.text_too_long": {
      "comment": "Alert shown when text the person wrote (other than a title, notes, or a tag) is longer than the app accepts.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا النص طويل جدًا. اختصره ثم حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Text ist zu lang. Kürze ihn und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This text is too long. Shorten it and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este texto es demasiado largo. Acórtalo e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این متن بیش از حد طولانی است. آن را کوتاه‌تر کنید و دوباره تلاش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce texte est trop long. Raccourcissez-le, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הטקסט הזה ארוך מדי. יש לקצר אותו ולנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह टेक्स्ट बहुत लंबा है। इसे छोटा करके फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo testo è troppo lungo. Accorcialo e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストが長すぎます。短くしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트가 너무 깁니다. 줄인 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze tekst is te lang. Kort de tekst in en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten tekst jest za długi. Skróć go i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este texto é longo demais. Encurte-o e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest text este prea lung. Scurtați-l și încercați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст слишком длинный. Сократите его и попробуйте ещё раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст задовгий. Скоротіть його та спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ متن بہت لمبا ہے۔ اسے مختصر کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容太长了，请缩短后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內容太長了，請縮短後再試。"
          }
        }
      }
    },
    "error.reason.title_required": {
      "comment": "Alert shown when a task is saved without a title, for example from a Shortcuts action given a blank title.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج المهمة إلى عنوان. أضف عنوانًا ثم حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Aufgabe braucht einen Titel. Gib einen Titel ein und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A task needs a title. Add one and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarea necesita un título. Añade uno e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کار باید عنوان داشته باشد. یکی اضافه کنید و دوباره تلاش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une tâche doit avoir un titre. Ajoutez-en un, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למשימה נדרשת כותרת. יש להוסיף כותרת ולנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्य का शीर्षक होना ज़रूरी है। शीर्षक जोड़कर फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’attività deve avere un titolo. Aggiungine uno e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクにはタイトルが必要です。タイトルを入力してからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일에는 제목이 필요합니다. 제목을 입력한 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een taak heeft een titel nodig. Voeg een titel toe en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadanie musi mieć tytuł. Dodaj go i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tarefa precisa de um título. Adicione um e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O sarcină are nevoie de un titlu. Adăugați unul și încercați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У задачи должно быть название. Добавьте его и попробуйте ещё раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завдання повинно мати назву. Додайте її та спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کام کا عنوان ضروری ہے۔ ایک شامل کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务需要标题，请输入标题后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任務需要標題，請輸入標題後再試。"
          }
        }
      }
    },
