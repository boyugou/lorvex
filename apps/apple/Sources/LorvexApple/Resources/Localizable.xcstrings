          "stringUnit": {
            "state": "translated",
            "value": "لا توجد ملاحظات من الذكاء الاصطناعي بعد. يضيف مساعدك الملاحظات هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও কোনো AI নোট নেই। আপনার অ্যাসিস্ট্যান্ট এখানে নোট যোগ করে।"
