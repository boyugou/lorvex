    "watch.error.load.remedy": {
      "comment": "Remedy text for a generic Today-load failure",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد المحاولة، أو افتح Lorvex على iPhone إذا استمرت المشكلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche es erneut oder öffne Lorvex auf deinem iPhone, falls das Problem bestehen bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry, or open Lorvex on your iPhone if this persists."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inténtalo de nuevo o, si continúa, abre Lorvex en tu iPhone."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دوباره تلاش کنید؛ اگر ادامه یافت، Lorvex را در iPhone خود باز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayez ou, si le problème persiste, ouvrez Lorvex sur votre iPhone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לנסות שוב, או לפתוח את Lorvex ב-iPhone אם הבעיה נמשכת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फिर से कोशिश करें, या समस्या बनी रहे तो अपने iPhone पर Lorvex खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coba lagi, atau buka Lorvex di iPhone jika masalah berlanjut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprova oppure, se il problema persiste, apri Lorvex su iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行してください。解決しない場合は、iPhoneでLorvexを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 시도하세요. 계속되면 iPhone에서 Lorvex를 여세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuba lagi, atau buka Lorvex pada iPhone jika masalah berterusan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer het opnieuw of open Lorvex op je iPhone als het probleem blijft bestaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj ponownie albo otwórz Lorvex na iPhonie, jeśli problem nie ustąpi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente novamente ou, se o problema persistir, abra o Lorvex no seu iPhone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reîncercați sau deschideți Lorvex pe iPhone dacă problema persistă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторите попытку или откройте Lorvex на iPhone, если проблема не исчезнет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторіть спробу або відкрийте Lorvex на iPhone, якщо проблема не зникне."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دوبارہ کوشش کریں، یا مسئلہ برقرار رہے تو اپنے iPhone پر Lorvex کھولیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thử lại, hoặc mở Lorvex trên iPhone nếu sự cố vẫn tiếp diễn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重试，若仍未解决，请在 iPhone 上打开 Lorvex。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重試；若問題持續，請在 iPhone 上開啟 Lorvex。"
          }
        }
      }
    },
    "watch.error.load.title": {
      "comment": "Headline for a generic Today-load failure",
      "extractionState": "manual",
