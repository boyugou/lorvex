    "settings.time_zone.caption": {
      "comment": "Caption under the time zone setting",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتسب Lorvex الأيام وفق هذه المنطقة الزمنية على جميع أجهزتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex আপনার সব ডিভাইসে এই সময় অঞ্চল অনুযায়ী দিন গণনা করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex zählt Tage auf allen deinen Geräten in dieser Zeitzone."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Lorvex μετράει τις ημέρες με βάση αυτήν τη ζώνη ώρας σε όλες τις συσκευές σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex counts days in this time zone on all your devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex cuenta los días en esta zona horaria en todos tus dispositivos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روزها در همه دستگاه‌های شما بر اساس این منطقه زمانی شمرده می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex compte les jours dans ce fuseau horaire sur tous vos appareils."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הימים נספרים באזור הזמן הזה בכל המכשירים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex आपके सभी डिवाइस पर इसी टाइम ज़ोन में दिन गिनता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex menghitung hari menurut zona waktu ini di semua perangkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex conta i giorni in questo fuso orario su tutti i tuoi dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexは、すべてのデバイスでこのタイムゾーンを基準に日を区切ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex는 모든 기기에서 이 시간대를 기준으로 하루를 계산합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या सर्व डिव्हाइसवर दिवस याच काल विभागानुसार मोजले जातात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex mengira hari mengikut zon waktu ini pada semua peranti anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op al je apparaten telt Lorvex de dagen volgens deze tijdzone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex liczy dni w tej strefie czasowej na wszystkich twoich urządzeniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lorvex conta os dias neste fuso horário em todos os seus dispositivos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex numără zilele în acest fus orar pe toate dispozitivele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex считает дни в этом часовом поясе на всех ваших устройствах."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex นับวันตามไทม์โซนนี้บนอุปกรณ์ทุกเครื่องของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex, tüm aygıtlarınızda günleri bu saat diliminde sayar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex відлічує дні в цьому часовому поясі на всіх ваших пристроях."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی تمام ڈیوائسز پر دن اسی ٹائم زون میں گنے جاتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex tính ngày theo múi giờ này trên tất cả thiết bị của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 在你的所有设备上都按这个时区计算日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 在你的所有裝置上都以此時區來計算日期。"
          }
        }
      }
    },
