    "watch.action.pause.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل %@ من المهام التي بدأ العمل عليها"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimmt %@ aus den gestarteten Aufgaben heraus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Takes %@ out of the started tasks"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita “%@” de las tareas iniciadas"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» را از کارهای شروع‌شده خارج می‌کند"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire « %@ » des tâches démarrées"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוציא את \"%@\" מהמשימות שהותחלו"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” को शुरू हुए कार्यों से हटाता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengeluarkan %@ dari tugas yang dimulai"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Toglie “%@” dalle attività iniziate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を開始済みのタスクから外します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작된 할 일에서 “%@” 항목을 제외합니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengeluarkan %@ daripada tugas yang dimulakan"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Haalt %@ uit de gestarte taken"
          }
        },
        "pl": {
