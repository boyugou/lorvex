    "settings.data_import.error.busy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما زالت عملية استيراد أو عملية بيانات أخرى قيد التنفيذ. انتظر حتى تنتهي، ثم حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Import oder Datenvorgang läuft noch. Warte, bis er abgeschlossen ist, und versuche es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another import or data operation is still running. Wait for it to finish, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía hay otra importación u operación de datos en curso. Espera a que termine e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک وارد کردن یا عملیات داده دیگر هنوز در حال اجراست. منتظر پایان آن بمانید و دوباره تلاش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre importation ou opération sur les données est encore en cours. Attendez qu’elle se termine, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייבוא או פעולת נתונים אחרת עדיין פועלים. יש להמתין לסיומם ואז לנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई दूसरा इंपोर्ट या डेटा ऑपरेशन अभी चल रहा है। उसके पूरा होने तक रुकें, फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’altra importazione o operazione sui dati è ancora in corso. Attendi che termini, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の読み込みまたはデータ操作がまだ実行中です。完了するまで待ってから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 가져오기 또는 데이터 작업이 아직 실행 중입니다. 완료될 때까지 기다린 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is nog een andere import of gegevensbewerking bezig. Wacht tot die klaar is en probeer het daarna opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inny import lub inna operacja na danych jest jeszcze w toku. Poczekaj na jej zakończenie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra importação ou operação de dados ainda está em andamento. Aguarde a conclusão e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un alt import sau o altă operațiune cu datele este încă în desfășurare. Așteptați să se termine, apoi încercați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другая операция импорта или обработки данных ещё выполняется. Дождитесь её завершения и повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інша операція імпорту чи обробки даних ще триває. Зачекайте на її завершення й повторіть спробу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی دوسرا امپورٹ یا ڈیٹا آپریشن ابھی جاری ہے۔ اس کے ختم ہونے کا انتظار کریں، پھر دوبارہ کوشش کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一项导入或数据操作仍在进行中。请等待其完成后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一項匯入或資料作業仍在進行中。請等待完成後再試一次。"
          }
        }
      }
    },
    "settings.data_import.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حمّل بيانات من ملف JSON أو ZIP أنشأته باستخدام \"تصدير\" أعلاه. سترى محتويات الملف أولًا، ولا يؤدي الاستيراد إلى تكرار بيانات موجودة لديك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt Daten aus einer JSON- oder ZIP-Datei, die du oben mit „Exportieren“ erstellt hast. Zuerst siehst du, was die Datei enthält; durch das Importieren werden vorhandene Daten nie dupliziert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load data from a JSON or ZIP file you made with Export above. You’ll see what the file contains first; importing never duplicates data you already have."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga datos desde un archivo JSON o ZIP creado con Exportar, más arriba. Primero verás lo que contiene el archivo; importar nunca duplica datos que ya tienes."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "داده‌ها را از یک فایل JSON یا ZIP که با «صادر کردن» بالا ساخته‌اید بارگیری کنید. ابتدا محتوای فایل را می‌بینید؛ وارد کردن هرگز داده‌های موجود شما را تکراری نمی‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chargez des données depuis un fichier JSON ou ZIP créé avec la fonction d’exportation ci-dessus. Vous verrez d’abord le contenu du fichier ; l’importation ne duplique jamais les données que vous avez déjà."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טעינת נתונים מקובץ JSON או ZIP שנוצר באמצעות הייצוא שלמעלה. קודם יוצג תוכן הקובץ; הייבוא אף פעם לא משכפל נתונים שכבר קיימים אצלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊपर एक्सपोर्ट से बनाई गई JSON या ZIP फ़ाइल से डेटा लोड करें। पहले आप देख सकेंगे कि फ़ाइल में क्या है; इंपोर्ट करने से आपके पास पहले से मौजूद डेटा की डुप्लिकेट कॉपी नहीं बनती।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica i dati da un file JSON o ZIP creato con l’esportazione qui sopra. Vedrai prima il contenuto del file; l’importazione non duplica mai i dati che hai già."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上の「書き出す」で作成したJSONまたはZIPファイルからデータを読み込みます。先にファイルの内容を確認できます。すでにあるデータが重複することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위의 내보내기로 만든 JSON 또는 ZIP 파일에서 데이터를 불러옵니다. 먼저 파일 내용을 확인할 수 있으며, 이미 있는 데이터가 중복되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laadt gegevens uit een JSON- of ZIP-bestand dat je hierboven met Exporteren hebt gemaakt. Je ziet eerst wat het bestand bevat; importeren dupliceert nooit gegevens die je al hebt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wczytaj dane z pliku JSON lub ZIP utworzonego za pomocą eksportu powyżej. Najpierw zobaczysz, co zawiera plik; import nigdy nie duplikuje danych, które już masz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carregue dados de um arquivo JSON ou ZIP criado com a exportação acima. Você verá primeiro o conteúdo do arquivo; a importação nunca duplica dados que você já tem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încarcă datele dintr-un fișier JSON sau ZIP creat cu Export mai sus. Veți vedea mai întâi ce conține fișierul; importul nu duplică niciodată datele existente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузите данные из файла JSON или ZIP, созданного с помощью экспорта выше. Сначала вы увидите, что содержится в файле; импорт никогда не дублирует уже имеющиеся данные."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажте дані з файлу JSON або ZIP, створеного за допомогою експорту вище. Спочатку ви побачите, що міститься у файлі; імпорт ніколи не дублює дані, які у вас уже є."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اوپر ایکسپورٹ سے بنائی گئی JSON یا ZIP فائل سے ڈیٹا لوڈ کریں۔ پہلے آپ کو فائل کا مواد دکھایا جائے گا؛ امپورٹ کرنے سے آپ کا موجودہ ڈیٹا کبھی دہرایا نہیں جاتا۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从你用上方“导出”创建的 JSON 或 ZIP 文件加载数据。你会先看到文件包含的内容；导入绝不会重复你已有的数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從你用上方「匯出」建立的 JSON 或 ZIP 檔案載入資料。你可以先查看檔案內容；匯入不會讓你已有的資料重複。"
          }
        }
      }
    },
    "settings.data_import.preview.not_imported": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير مستورد (لا يمكن استعادته بأمان بعد)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
