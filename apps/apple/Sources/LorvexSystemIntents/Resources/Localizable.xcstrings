    "system.task.list.description": {
      "comment": "Description for the List Lorvex Tasks App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض مهام Lorvex حسب الحالة أو القائمة أو الأولوية أو النص."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্টেটাস, তালিকা, প্রাধান্য বা লেখা অনুযায়ী Lorvex টাস্ক দেখান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Listet Lorvex-Aufgaben nach Status, Liste, Priorität oder Text auf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίστε εργασίες Lorvex ανά κατάσταση, λίστα, προτεραιότητα ή κείμενο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "List Lorvex tasks by status, list, priority, or text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra tareas de Lorvex por estado, lista, prioridad o texto."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فهرست کارهای Lorvex بر اساس وضعیت، فهرست، اولویت یا متن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les tâches de Lorvex par état, liste, priorité ou texte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצגת משימות ב-Lorvex לפי סטטוס, רשימה, עדיפות או טקסט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थिति, सूची, प्राथमिकता या टेक्स्ट के आधार पर Lorvex कार्य दिखाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan tugas Lorvex berdasarkan status, daftar, prioritas, atau teks."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra le attività di Lorvex per stato, lista, priorità o testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "状態、リスト、優先度、テキストでLorvexのタスクを一覧表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상태, 목록, 우선순위 또는 텍스트로 Lorvex 할 일을 나열합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्टेटस, यादी, प्राधान्य किंवा मजकुरानुसार Lorvex कार्ये दाखवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyenaraikan tugas Lorvex mengikut status, senarai, keutamaan atau teks."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont Lorvex-taken op status, lijst, prioriteit of tekst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje zadania Lorvex według statusu, listy, priorytetu lub tekstu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista tarefas do Lorvex por status, lista, prioridade ou texto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișează sarcinile Lorvex după stare, listă, prioritate sau text."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает задачи Lorvex по статусу, списку, приоритету или тексту."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நிலை, பட்டியல், முன்னுரிமை அல்லது உரை அடிப்படையில் Lorvex பணிகளைப் பட்டியலிடவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్థితి, జాబితా, ప్రాధాన్యత లేదా టెక్స్ట్ ఆధారంగా Lorvex టాస్క్‌లను జాబితా చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงงาน Lorvex ตามสถานะ ลิสต์ ความสำคัญ หรือข้อความ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex görevlerini duruma, listeye, önceliğe veya metne göre listeleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує завдання Lorvex за статусом, списком, пріоритетом або текстом."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "حالت، فہرست، ترجیح یا متن کے مطابق Lorvex کام دیکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liệt kê nhiệm vụ Lorvex theo trạng thái, danh sách, mức ưu tiên hoặc văn bản."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按状态、列表、优先级或文本列出 Lorvex 任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依狀態、清單、優先順序或文字列出 Lorvex 任務。"
          }
        }
      }
    },
