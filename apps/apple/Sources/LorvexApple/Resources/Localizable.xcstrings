                  "state": "translated",
                  "value": "\"%1$@\" کو ایک بار ملتوی کیا گیا۔"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "\"%1$@\" کو %2$lld بار ملتوی کیا گیا۔"
                }
              }
            }
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” đã bị hoãn %2$lld lần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”已经推迟了 %2$lld 次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」已被延後 %2$lld 次。"
          }
        }
      }
    },
    "review.week.decision.message": {
      "comment": "Week review decision detail.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد وضعها في \"يومًا ما\" إلى أن تصبح ذات أهمية؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি গুরুত্বপূর্ণ না হওয়া পর্যন্ত “কোনোদিন” বিভাগে রেখে দেবেন?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In „Irgendwann“ ablegen, bis es wichtig wird?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Να μεταφερθεί στο «Κάποτε» μέχρι να αποκτήσει σημασία;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Park it in Someday until it matters?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Dejarla en Algún día hasta que importe?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تا وقتی اهمیت پیدا کند، آن را در «شاید بعدها» نگه دارید؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mettre de côté dans Un jour jusqu’à ce qu’elle compte ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להעביר אל \"מתישהו\" עד שזה יהיה חשוב?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक यह ज़रूरी न हो जाए, इसे “किसी दिन” में रख दें?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan di Suatu Hari sampai tugas ini kembali penting?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metterla in Prima o poi finché non diventa importante?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重要になるまで「いつか」に置いておきますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중요해질 때까지 ‘언젠가’에 보관할까요?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ते महत्त्वाचे होईपर्यंत ‘कधीतरी’ मध्ये ठेवायचे का?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan dalam Suatu Hari sehingga ia penting semula?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet het in ‘Ooit’ tot het ertoe doet?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odłożyć do „Kiedyś”, dopóki nie stanie się ważne?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixá-la em Algum dia até que se torne importante?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutați-o în „Cândva” până când devine importantă?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убрать в «Когда-нибудь», пока это не станет важным?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அது முக்கியமாகும் வரை என்றாவது ஒரு நாள் பிரிவில் வைக்கவா?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అది ముఖ్యమయ్యే వరకు ఏదో ఒక రోజు విభాగంలో ఉంచాలా?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บไว้ใน “สักวัน” จนกว่าจะสำคัญหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önem kazanana kadar “Bir gün”e taşınsın mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прибрати в «Колись», доки це не стане важливим?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب تک ضروری نہ ہو اسے \"کسی دن\" میں رکھ دیں؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cất vào Một ngày nào đó cho đến khi nó quan trọng trở lại?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先放进“将来某天”，等需要时再拿出来？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要先放進「將來某天」，等重要時再處理嗎？"
          }
        }
      }
    },
