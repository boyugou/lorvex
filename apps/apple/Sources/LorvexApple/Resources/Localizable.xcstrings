    "tasks.empty.no_tasks_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب مهمة في الحقل أعلاه، أو اطلب من مساعدك إضافة بعضها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib oben im Feld eine Aufgabe ein – oder bitte deinen Assistenten, einige hinzuzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type a task in the field above — or ask your assistant to add some."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe una tarea en el campo de arriba o pide a tu asistente que añada algunas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک کار را در کادر بالا بنویسید — یا از دستیار خود بخواهید چند کار اضافه کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une tâche dans le champ ci-dessus, ou demandez à votre assistant d’en ajouter."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להקליד משימה בשדה שלמעלה — או לבקש מהעוזר שלך להוסיף כמה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊपर के फ़ील्ड में कार्य लिखें, या अपने असिस्टेंट से कुछ जोड़ने को कहें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi un’attività nel campo qui sopra oppure chiedi al tuo assistente di aggiungerne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上の入力欄にタスクを入力するか、アシスタントに追加を頼んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위 입력란에 할 일을 입력하거나 어시스턴트에게 추가를 요청하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ een taak in het veld hierboven – of vraag je assistent om er een paar toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz zadanie w polu powyżej — albo poproś asystenta o dodanie kilku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite uma tarefa no campo acima ou peça ao seu assistente para adicionar algumas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduceți o sarcină în câmpul de mai sus – sau cereți asistentului să adauge câteva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите задачу в поле выше — или попросите ассистента добавить несколько."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть завдання в полі вище — або попросіть асистента додати кілька."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اوپر والے فیلڈ میں کام ٹائپ کریں — یا اپنے اسسٹنٹ سے کچھ شامل کرنے کو کہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在上方输入任务，或让助手帮你添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在上方欄位輸入任務，或請助理幫你新增。"
          }
        }
      }
    },
