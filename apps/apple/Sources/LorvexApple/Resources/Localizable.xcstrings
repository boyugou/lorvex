    "recurring_cancel.batch_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء المهام المتكررة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পুনরাবৃত্ত টাস্ক বাতিল করুন"
          }
        },
        "de": {
