    "tasks.empty.message": {
      "comment": "Empty-state description when there are no open tasks",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مهمة للبدء، أو اطلب من مساعد الذكاء الاصطناعي أن يخطط يومك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুরু করতে একটি টাস্ক যোগ করুন – অথবা আপনার AI অ্যাসিস্ট্যান্টকে দিনের প্ল্যান করতে বলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse eine Aufgabe, um loszulegen – oder bitte deinen KI-Assistenten, deinen Tag zu planen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε μια εργασία για να ξεκινήσετε ή ζητήστε από τον βοηθό AI να προγραμματίσει την ημέρα σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture a task to get started — or ask your AI assistant to plan your day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una tarea para empezar o pide a tu asistente de IA que planifique tu día."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای شروع، یک کار اضافه کنید — یا از دستیار هوش مصنوعی خود بخواهید روزتان را برنامه‌ریزی کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une tâche pour commencer, ou demandez à votre assistant IA de planifier votre journée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להוסיף משימה כדי להתחיל — או לבקש מעוזר ה-AI שלך לתכנן את היום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू करने के लिए कोई कार्य जोड़ें, या अपने AI असिस्टेंट से अपना दिन प्लान करने को कहें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catat tugas untuk memulai – atau minta asisten AI merencanakan hari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un’attività per iniziare oppure chiedi al tuo assistente IA di pianificare la tua giornata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクを追加して始めましょう。または、AIアシスタントに1日の計画を頼むこともできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일을 추가해 시작해 보세요. 또는 AI 어시스턴트에게 하루 계획을 부탁할 수도 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरू करण्यासाठी एक कार्य जोडा – किंवा तुमच्या AI सहाय्यकाला तुमचा दिवस प्लॅन करायला सांगा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Catat tugas untuk bermula – atau minta pembantu AI merancang hari."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg een taak vast om te beginnen – of vraag je AI-assistent om je dag te plannen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj zadanie, aby zacząć — albo poproś asystenta AI o zaplanowanie dnia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma tarefa para começar ou peça ao seu assistente de IA para planejar seu dia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adăugați o sarcină pentru a începe – sau rugați asistentul AI să vă planifice ziua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте задачу, чтобы начать. Или попросите ИИ-ассистента спланировать ваш день."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடங்க, ஒரு பணியைச் சேர்க்கவும் – அல்லது நாளைத் திட்டமிடச் சொல்லி உங்கள் AI அசிஸ்டென்ட்டிடம் கேட்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రారంభించడానికి ఒక టాస్క్‌ను జోడించండి – లేదా రోజును ప్లాన్ చేయమని మీ AI అసిస్టెంట్‌ను అడగండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จดงานเพื่อเริ่มต้น หรือขอให้ผู้ช่วย AI วางแผนวันของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlamak için bir görev ekleyin ya da yapay zekâ asistanınızdan gününüzü planlamasını isteyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте завдання, щоб почати. Або попросіть ШІ-асистента спланувати ваш день."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شروع کرنے کے لیے کوئی کام شامل کریں — یا اپنے AI اسسٹنٹ سے اپنا دن منصوبہ بند کرنے کو کہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi nhanh một nhiệm vụ để bắt đầu – hoặc nhờ trợ lý AI lên kế hoạch cho ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加一个任务即可开始——或让你的 AI 助手为你规划这一天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增一個任務來開始，或請你的 AI 助理規劃你的一天。"
          }
        }
      }
    },
    "tasks.empty.open.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مهمة أو اطلب من المساعد تخطيط العمل المفيد التالي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি টাস্ক যোগ করুন, অথবা অ্যাসিস্ট্যান্টকে পরের দরকারি কাজটি প্ল্যান করতে বলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse eine Aufgabe oder bitte den Assistenten, die nächste sinnvolle Arbeit zu planen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε μια εργασία ή ζητήστε από τον βοηθό να προγραμματίσει την επόμενη χρήσιμη δουλειά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture a task or ask the assistant to plan the next useful work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una tarea o pide al asistente que planifique el siguiente trabajo útil."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک کار اضافه کنید یا از دستیار بخواهید کار مفید بعدی را برنامه‌ریزی کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une tâche ou demandez à l’assistant de planifier la prochaine chose utile à faire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להוסיף משימה או לבקש מהעוזר לתכנן את העבודה השימושית הבאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई कार्य जोड़ें या असिस्टेंट से अगला उपयोगी काम प्लान करने को कहें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catat tugas atau minta asisten merencanakan pekerjaan berguna berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un’attività oppure chiedi all’assistente di pianificare il prossimo lavoro utile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクを追加するか、次に取り組むとよいことをアシスタントに計画してもらいましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일을 추가하거나, 어시스턴트에게 다음에 하면 좋은 일을 계획해 달라고 요청해 보세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एक कार्य जोडा किंवा सहाय्यकाला पुढील उपयुक्त काम प्लॅन करायला सांगा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Catat tugas atau minta pembantu AI merancang kerja berguna yang seterusnya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg een taak vast of vraag de assistent om het volgende nuttige werk te plannen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj zadanie lub poproś asystenta o zaplanowanie kolejnych pożytecznych działań."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma tarefa ou peça ao assistente para planejar o próximo trabalho útil."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adăugați o sarcină sau rugați asistentul să planifice următoarea lucrare utilă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте задачу или попросите ассистента спланировать ближайшие полезные дела."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு பணியைச் சேர்க்கவும், அல்லது அடுத்த பயனுள்ள வேலையைத் திட்டமிடச் சொல்லி அசிஸ்டென்ட்டிடம் கேட்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక టాస్క్‌ను జోడించండి, లేదా తర్వాత చేయాల్సిన ఉపయోగకరమైన పనిని ప్లాన్ చేయమని అసిస్టెంట్‌ను అడగండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จดงาน หรือขอให้ผู้ช่วยวางแผนงานที่เป็นประโยชน์ถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir görev ekleyin ya da asistandan sıradaki yararlı işi planlamasını isteyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте завдання або попросіть асистента спланувати найближчі корисні справи."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی کام شامل کریں یا اسسٹنٹ سے اگلا مفید کام منصوبہ بند کرنے کو کہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi nhanh một nhiệm vụ hoặc nhờ trợ lý lên kế hoạch cho công việc hữu ích tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加一个任务，或让助手规划下一件有价值的事。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增任務，或請助理規劃接下來最值得做的事。"
          }
        }
      }
    },
    "tasks.empty.open.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
