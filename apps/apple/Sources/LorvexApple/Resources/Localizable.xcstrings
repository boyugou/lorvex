        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw planowaną datę, zanim dodasz to zadanie do Kalendarza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma data planejada antes de adicionar esta tarefa ao calendário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adăugați o dată planificată înainte de a adăuga această sarcină în calendar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите запланированную дату, прежде чем добавлять эту задачу в Календарь."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
