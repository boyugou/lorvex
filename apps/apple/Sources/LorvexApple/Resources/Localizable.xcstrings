    "list_row.archive.nonempty_count_message": {
      "comment": "Message of the dialog that offers to archive a list that still holds tasks, since only an empty list can be deleted. 1: the list name. 2: how many tasks it holds.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لا يمكن حذف \"%1$@\" ما دامت تحتوي على %2$lld مهام. أرشفها بدلًا من ذلك لإنهاء استخدامها مع الاحتفاظ بمهامها وسجلها. يمكنك إلغاء الأرشفة لاحقًا."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لا يمكن حذف \"%1$@\" ما دامت تحتوي على %2$lld مهمة. أرشفها بدلًا من ذلك لإنهاء استخدامها مع الاحتفاظ بمهامها وسجلها. يمكنك إلغاء الأرشفة لاحقًا."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لا يمكن حذف \"%1$@\" ما دامت تحتوي على مهمة واحدة. أرشفها بدلًا من ذلك لإنهاء استخدامها مع الاحتفاظ بمهامها وسجلها. يمكنك إلغاء الأرشفة لاحقًا."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لا يمكن حذف \"%1$@\" ما دامت تحتوي على %2$lld مهمة. أرشفها بدلًا من ذلك لإنهاء استخدامها مع الاحتفاظ بمهامها وسجلها. يمكنك إلغاء الأرشفة لاحقًا."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لا يمكن حذف \"%1$@\" ما دامت تحتوي على مهمتين. أرشفها بدلًا من ذلك لإنهاء استخدامها مع الاحتفاظ بمهامها وسجلها. يمكنك إلغاء الأرشفة لاحقًا."
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لا يمكن حذف \"%1$@\" ما دامت تحتوي على %2$lld مهمة. أرشفها بدلًا من ذلك لإنهاء استخدامها مع الاحتفاظ بمهامها وسجلها. يمكنك إلغاء الأرشفة لاحقًا."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "“%1$@” can’t be deleted while it still holds %2$lld task. Archive it instead to retire it while keeping its tasks and history. You can unarchive it later."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "“%1$@” can’t be deleted while it still holds %2$lld tasks. Archive it instead to retire it while keeping its tasks and history. You can unarchive it later."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "“%1$@” no se puede eliminar mientras contenga %2$lld tarea. Archívala para retirarla sin perder sus tareas ni su historial. Puedes desarchivarla más adelante."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "“%1$@” no se puede eliminar mientras contenga %2$lld tareas. Archívala para retirarla sin perder sus tareas ni su historial. Puedes desarchivarla más adelante."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "« %1$@ » ne peut pas être supprimée tant qu’elle contient encore %2$lld tâche. Archivez-la plutôt pour la retirer tout en conservant ses tâches et son historique. Vous pourrez la désarchiver plus tard."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "« %1$@ » ne peut pas être supprimée tant qu’elle contient encore %2$lld tâches. Archivez-la plutôt pour la retirer tout en conservant ses tâches et son historique. Vous pourrez la désarchiver plus tard."
                }
              }
            }
          }
        },
        "hi": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "“%1$@” में अभी %2$lld कार्य है, इसलिए उसे हटाया नहीं जा सकता। इसके बजाय उसे संग्रहीत करें; इससे सूची हट जाती है, पर उसके कार्य और इतिहास बने रहते हैं। आप उसे बाद में संग्रह से निकाल सकते हैं।"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "“%1$@” में अभी %2$lld कार्य हैं, इसलिए उसे हटाया नहीं जा सकता। इसके बजाय उसे संग्रहीत करें; इससे सूची हट जाती है, पर उसके कार्य और इतिहास बने रहते हैं। आप उसे बाद में संग्रह से निकाल सकते हैं।"
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "“%1$@” में अभी %2$lld कार्य हैं, इसलिए उसे हटाया नहीं जा सकता। इसके बजाय उसे संग्रहीत करें; इससे सूची हट जाती है, पर उसके कार्य और इतिहास बने रहते हैं। आप उसे बाद में संग्रह से निकाल सकते हैं।"
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "“%1$@” non può essere eliminata finché contiene ancora %2$lld attività. Archiviala invece per metterla da parte mantenendo le sue attività e la sua cronologia. Potrai rimuoverla dall’archivio in seguito."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "“%1$@” non può essere eliminata finché contiene ancora %2$lld attività. Archiviala invece per metterla da parte mantenendo le sue attività e la sua cronologia. Potrai rimuoverla dall’archivio in seguito."
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」には%2$lld件のタスクが残っているため、削除できません。代わりにアーカイブすると、リストは片づけられ、タスクと履歴は残ります。あとからアーカイブを解除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”에 할 일이 %2$lld개 남아 있어 삭제할 수 없습니다. 대신 보관하면 목록은 정리되고 할 일과 기록은 그대로 남습니다. 나중에 보관을 해제할 수 있습니다."
          }
        },
        "pl": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Listy „%1$@” nie można usunąć, dopóki zawiera jeszcze %2$lld zadania. Zarchiwizuj ją, aby wycofać listę, zachowując zadania i historię. Później możesz ją przywrócić z archiwum."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Listy „%1$@” nie można usunąć, dopóki zawiera jeszcze %2$lld zadań. Zarchiwizuj ją, aby wycofać listę, zachowując zadania i historię. Później możesz ją przywrócić z archiwum."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Listy „%1$@” nie można usunąć, dopóki zawiera jeszcze %2$lld zadanie. Zarchiwizuj ją, aby wycofać listę, zachowując zadania i historię. Później możesz ją przywrócić z archiwum."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Listy „%1$@” nie można usunąć, dopóki zawiera jeszcze %2$lld zadania. Zarchiwizuj ją, aby wycofać listę, zachowując zadania i historię. Później możesz ją przywrócić z archiwum."
                }
              }
            }
          }
        },
        "pt-BR": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "“%1$@” não pode ser excluída enquanto ainda tiver %2$lld tarefa. Arquive-a para retirá-la de uso e manter suas tarefas e seu histórico. Você pode desarquivá-la depois."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "“%1$@” não pode ser excluída enquanto ainda tiver %2$lld tarefas. Arquive-a para retirá-la de uso e manter suas tarefas e seu histórico. Você pode desarquivá-la depois."
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Список «%1$@» нельзя удалить, пока в нём остаются %2$lld задачи. Заархивируйте его, чтобы убрать из списков, но сохранить задачи и историю. Позже его можно вернуть из архива."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Список «%1$@» нельзя удалить, пока в нём остаются %2$lld задач. Заархивируйте его, чтобы убрать из списков, но сохранить задачи и историю. Позже его можно вернуть из архива."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Список «%1$@» нельзя удалить, пока в нём остаётся %2$lld задача. Заархивируйте его, чтобы убрать из списков, но сохранить задачи и историю. Позже его можно вернуть из архива."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Список «%1$@» нельзя удалить, пока в нём остаётся %2$lld задачи. Заархивируйте его, чтобы убрать из списков, но сохранить задачи и историю. Позже его можно вернуть из архива."
                }
              }
            }
          }
        },
