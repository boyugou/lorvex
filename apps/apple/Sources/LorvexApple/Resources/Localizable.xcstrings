    "lists.empty.no_active_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا القوائم التي تحتوي على مهام غير مكتملة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাকি টাস্ক আছে এমন তালিকা এখানে দেখা যাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen mit offenen Aufgaben erscheinen hier."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι λίστες με ανοιχτές εργασίες θα εμφανίζονται εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lists with open tasks will appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las listas con tareas pendientes aparecerán aquí."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فهرست‌هایی که کار باز دارند اینجا نمایش داده می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les listes contenant des tâches à faire apparaîtront ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשימות עם משימות פתוחות יופיעו כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लंबित कार्यों वाली सूचियाँ यहाँ दिखेंगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar yang memiliki tugas belum selesai akan muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le liste con attività da fare appariranno qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未完了のタスクがあるリストがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미완료 할 일이 있는 목록이 여기에 표시됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रलंबित कार्ये असलेल्या याद्या येथे दिसतील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Senarai yang mempunyai tugas belum selesai akan dipaparkan di sini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lijsten met open taken verschijnen hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj pojawią się listy z zadaniami do zrobienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As listas com tarefas pendentes aparecerão aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Listele cu sarcini de făcut vor apărea aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появятся списки с невыполненными задачами."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิสต์ที่มีงานยังไม่เสร็จจะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık görevleri olan listeler burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут з’являться списки з невиконаними завданнями."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ فہرستیں جن میں نامکمل کام ہوں یہاں نظر آئیں گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các danh sách có nhiệm vụ chưa hoàn thành sẽ xuất hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "含有未完成任务的列表会显示在这里。"
          }
