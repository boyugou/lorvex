          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার প্রথম টাস্ক যোগ করতে ＋ ট্যাপ করুন – অথবা আপনার অ্যাসিস্ট্যান্টকে কয়েকটি যোগ করতে বলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf ＋, um deine erste Aufgabe zu erfassen – oder bitte deinen Assistenten, welche hinzuzufügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε ＋ για να προσθέσετε την πρώτη σας εργασία ή ζητήστε από τον βοηθό σας να προσθέσει μερικές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap ＋ to capture your first task — or ask your assistant to add some."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca ＋ para añadir tu primera tarea o pide a tu asistente que añada algunas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای افزودن اولین کار، روی ＋ ضربه بزنید — یا از دستیارتان بخواهید چند کار اضافه کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez ＋ pour ajouter votre première tâche, ou demandez à votre assistant d’en ajouter."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להקיש על ＋ כדי להוסיף את המשימה הראשונה — או לבקש מהעוזר שלך להוסיף כמה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना पहला कार्य जोड़ने के लिए ＋ पर टैप करें, या अपने असिस्टेंट से कुछ जोड़ने को कहें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk ＋ untuk mencatat tugas pertama – atau minta asisten menambahkan beberapa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca ＋ per aggiungere la tua prima attività oppure chiedi al tuo assistente di aggiungerne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "＋をタップして最初のタスクを追加しましょう。アシスタントに頼んで追加してもらうこともできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "＋ 버튼을 탭하여 첫 할 일을 추가해 보세요. 어시스턴트에게 대신 추가해 달라고 할 수도 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे पहिले कार्य जोडण्यासाठी ＋ टॅप करा – किंवा तुमच्या सहाय्यकाला काही कार्ये जोडायला सांगा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik ＋ untuk mencatat tugas pertama – atau minta pembantu AI menambah beberapa tugas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op ＋ om je eerste taak vast te leggen – of vraag je assistent er een paar toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij ＋, aby dodać pierwsze zadanie — albo poproś asystenta o dodanie kilku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em ＋ para adicionar sua primeira tarefa ou peça ao seu assistente para adicionar algumas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți ＋ pentru a adăuga prima sarcină – sau rugați asistentul să adauge câteva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь ＋, чтобы добавить первую задачу. Или попросите ассистента добавить несколько."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் முதல் பணியைச் சேர்க்க ＋ தட்டவும் – அல்லது சிலவற்றைச் சேர்க்குமாறு உங்கள் அசிஸ்டென்ட்டிடம் கேட்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ మొదటి టాస్క్‌ను జోడించడానికి ＋ ట్యాప్ చేయండి – లేదా కొన్ని జోడించమని మీ అసిస్టెంట్‌ను అడగండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะ ＋ เพื่อจดงานแรกของคุณ หรือขอให้ผู้ช่วยเพิ่มให้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk görevinizi eklemek için ＋ simgesine dokunun ya da asistanınızdan birkaç görev eklemesini isteyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніть ＋, щоб додати перше завдання. Або попросіть асистента додати кілька."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنا پہلا کام شامل کرنے کے لیے ＋ پر ٹیپ کریں — یا اپنے اسسٹنٹ سے کچھ شامل کرنے کو کہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm ＋ để ghi nhanh nhiệm vụ đầu tiên – hoặc nhờ trợ lý thêm vài nhiệm vụ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按 ＋ 添加第一个任务，或让助手帮你添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下 ＋ 新增你的第一個任務，也可以請助理幫你新增。"
          }
        }
      }
    },
