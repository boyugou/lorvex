    "error.reason.calendar_time_skipped": {
      "comment": "Alert shown when an event starts at a time the clocks skip on the day daylight saving time begins (for example 2:30 AM when clocks jump from 2:00 to 3:00).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الوقت غير موجود في ذلك اليوم لأن الساعات تتقدّم مع بدء التوقيت الصيفي. اختر وقتًا قبله أو بعده."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Uhrzeit gibt es an diesem Tag nicht, weil die Uhren für die Sommerzeit vorgestellt werden. Wähle eine frühere oder spätere Uhrzeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This time doesn’t exist on that day because the clocks move forward for daylight saving time. Pick an earlier or later time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta hora no existe ese día porque los relojes se adelantan por el horario de verano. Elige una hora anterior o posterior."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این ساعت در آن روز وجود ندارد، چون ساعت‌ها برای ساعت تابستانی جلو می‌روند. ساعتی زودتر یا دیرتر انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette heure n’existe pas ce jour-là, car les horloges avancent pour l’heure d’été. Choisissez une heure plus tôt ou plus tard."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השעה הזו לא קיימת ביום הזה, כי השעון מתקדם במעבר לשעון קיץ. יש לבחור שעה מוקדמת או מאוחרת יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस दिन यह समय मौजूद नहीं है, क्योंकि डेलाइट सेविंग टाइम के लिए घड़ियाँ आगे बढ़ जाती हैं। इससे पहले या बाद का समय चुनें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quest’ora non esiste in quel giorno perché gli orologi vanno avanti per l’ora legale. Scegli un orario precedente o successivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日は夏時間の開始で時計が進むため、この時刻は存在しません。前後の時刻を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이날은 서머타임 시작으로 시계가 앞당겨져 이 시간이 없습니다. 더 이르거나 늦은 시간을 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit tijdstip bestaat niet op die dag omdat de klok voor de zomertijd vooruit wordt gezet. Kies een eerder of later tijdstip."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tego dnia nie ma takiej godziny, ponieważ zegary przestawia się do przodu na czas letni. Wybierz wcześniejszą lub późniejszą godzinę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este horário não existe nesse dia porque os relógios são adiantados para o horário de verão. Escolha um horário anterior ou posterior."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această oră nu există în ziua respectivă, deoarece ceasurile se mută înainte pentru ora de vară. Alegeți o oră mai devreme sau mai târziu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этот день такого времени нет: часы переводятся вперёд на летнее время. Выберите более раннее или более позднее время."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цього дня такого часу немає: годинники переводять уперед на літній час. Виберіть раніший або пізніший час."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ وقت اس دن موجود نہیں کیونکہ ڈے لائٹ سیونگ ٹائم کے لیے گھڑیاں آگے بڑھ جاتی ہیں۔ پہلے یا بعد کا کوئی وقت منتخب کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一天因夏令时开始、时钟拨快，没有这个时间。请选一个更早或更晚的时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這一天因夏令時間開始、時鐘撥快，沒有這個時間。請選擇更早或更晚的時間。"
          }
        }
      }
    },
    "error.reason.canceling_done_task": {
      "comment": "Alert shown when a person cancels a task that is already done.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه المهمة مكتملة بالفعل. أعِد فتحها قبل إلغائها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aufgabe ist bereits erledigt. Öffne sie wieder, bevor du sie abbrichst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This task is already done. Reopen it before canceling it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarea ya está completada. Reábrela antes de cancelarla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار از قبل تکمیل شده است. پیش از لغو، آن را بازگشایی کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette tâche est déjà terminée. Rouvrez-la avant de l’annuler."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשימה הזו כבר הושלמה. יש לפתוח אותה מחדש לפני ביטולה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कार्य पहले ही पूरा हो चुका है। रद्द करने से पहले इसे फिर से खोलें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa attività è già completata. Riaprila prima di annullarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタスクはすでに完了しています。キャンセルする前に未完了に戻してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 할 일은 이미 완료되었습니다. 취소하려면 먼저 다시 여세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze taak is al voltooid. Heropen de taak voordat je deze annuleert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zadanie jest już ukończone. Otwórz je ponownie, zanim je anulujesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarefa já foi concluída. Reabra-a antes de cancelá-la."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această sarcină este deja finalizată. Redeschideți-o înainte de a o anula."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта задача уже выполнена. Чтобы отменить её, сначала откройте её снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це завдання вже виконано. Щоб скасувати його, спершу відкрийте його знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ کام پہلے ہی مکمل ہو چکا ہے۔ منسوخ کرنے سے پہلے اسے دوبارہ کھولیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个任务已经完成，请先重新打开再取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個任務已經完成，請先重新開啟再取消。"
          }
        }
      }
    },
    "error.reason.completing_canceled_task": {
