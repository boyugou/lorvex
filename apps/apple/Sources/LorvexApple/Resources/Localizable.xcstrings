    "memory.empty.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر ＋ لحفظ ما تريد أن يتذكره مساعدك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাসিস্ট্যান্টকে যা মনে রাখাতে চান, তা সেভ করতে ＋ ক্লিক করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf ＋, um etwas festzuhalten, das sich dein Assistent merken soll."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάντε κλικ στο ＋ για να αποθηκεύσετε κάτι που πρέπει να θυμάται ο βοηθός σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click ＋ to save something your assistant should remember."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en ＋ para guardar algo que tu asistente deba recordar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای ذخیره چیزی که دستیارتان باید به خاطر بسپارد، روی ＋ کلیک کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur ＋ pour enregistrer ce que votre assistant doit retenir."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש ללחוץ על ＋ כדי לשמור משהו שהעוזר שלך צריך לזכור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो बात आपके असिस्टेंट को याद रखनी चाहिए, उसे सहेजने के लिए ＋ पर क्लिक करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik ＋ untuk menyimpan sesuatu yang perlu diingat asisten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su ＋ per salvare qualcosa che il tuo assistente dovrebbe ricordare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "＋をクリックして、アシスタントに覚えてほしいことを保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "＋ 버튼을 클릭하여 어시스턴트가 기억해야 할 내용을 저장하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सहाय्यकाने लक्षात ठेवावे असे काही जतन करण्यासाठी ＋ क्लिक करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik ＋ untuk menyimpan sesuatu yang perlu diingati pembantu AI."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op ＋ om iets te bewaren dat je assistent moet onthouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij ＋, aby zapisać coś, co asystent powinien zapamiętać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em ＋ para salvar algo que seu assistente deve lembrar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Faceți clic pe ＋ pentru a salva ceva ce ar trebui să rețină asistentul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите ＋, чтобы сохранить то, что ассистент должен помнить."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் அசிஸ்டென்ட் நினைவில் வைத்திருக்க வேண்டியதைச் சேமிக்க ＋ கிளிக் செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ అసిస్టెంట్ గుర్తుంచుకోవాల్సిన విషయాన్ని సేవ్ చేయడానికి ＋ క్లిక్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิก ＋ เพื่อบันทึกสิ่งที่ผู้ช่วยของคุณควรจดจำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asistanınızın hatırlaması gereken bir şeyi kaydetmek için ＋ düğmesini tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть ＋, щоб зберегти те, що має пам’ятати асистент."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی ایسی بات محفوظ کرنے کے لیے ＋ پر کلک کریں جو آپ کے اسسٹنٹ کو یاد رکھنی چاہیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm ＋ để lưu điều trợ lý cần ghi nhớ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按 ＋ 保存希望助手记住的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下 ＋ 儲存希望助理記住的事情。"
          }
        }
      }
    },
