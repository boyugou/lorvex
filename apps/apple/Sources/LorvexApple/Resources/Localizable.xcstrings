          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रलंबित याद्या नाहीत"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada Senarai Belum Selesai"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen open lijsten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak aktywnych list"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma lista com tarefas pendentes"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicio listă activă"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет активных списков"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีลิสต์ที่ยังไม่เสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık liste yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає активних списків"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی نامکمل فہرست نہیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có danh sách chưa hoàn thành"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有含未完成任务的列表"
          }
        },
        "zh-Hant": {
