    "widget.intent.complete.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إكمال مهمة في Lorvex من أداة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
