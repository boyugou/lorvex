          "stringUnit": {
            "state": "translated",
            "value": "快照不可用"
          }
        }
      }
    },
    "watch.status.unreadable": {
      "comment": "Status text when the snapshot file is unreadable",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapshot unreadable"
          }
        },
        "zh-Hans": {
