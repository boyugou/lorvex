    "system.ai_changelog.read.empty_summary": {
      "comment": "Summary used when there are no recent AI changelog entries",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد إدخالات حديثة في سجل تغييرات الذكاء الاصطناعي."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No recent AI changelog entries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay entradas recientes en el registro de cambios de IA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune entrée récente dans le journal des modifications de l’IA."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाल की कोई AI चेंजलॉग एंट्री नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna voce recente nel registro modifiche IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近のAI変更履歴はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 AI 변경 기록이 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak ostatnich wpisów dziennika zmian AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma entrada recente no registro de alterações da IA."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет недавних записей журнала изменений ИИ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає нещодавніх записів журналу змін ШІ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有最近的 AI 变更记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最近沒有 AI 變更記錄。"
          }
        }
      }
    },
