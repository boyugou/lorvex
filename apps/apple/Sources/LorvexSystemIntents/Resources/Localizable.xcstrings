    "system.task.batch.complete.description": {
      "comment": "Description for the Batch Complete Lorvex Tasks App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إكمال عدة مهام في Lorvex باستخدام المعرّفات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আইডি দিয়ে একাধিক Lorvex টাস্ক সম্পূর্ণ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erledigt mehrere Lorvex-Aufgaben anhand ihrer ID."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ολοκληρώστε πολλές εργασίες Lorvex με βάση το αναγνωριστικό."
