    "system.memory.delete.description": {
      "comment": "Description for the Delete Lorvex Memory App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف إدخال من ذاكرة Lorvex القابلة للكتابة بالذكاء الاصطناعي باستخدام المفتاح، من الاختصارات أو Siri."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শর্টকাট বা Siri থেকে কী ব্যবহার করে AI লিখতে পারে এমন একটি Lorvex মেমোরি এন্ট্রি ডিলিট করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht einen von KI beschreibbaren Lorvex-Gedächtniseintrag anhand seines Schlüssels über Kurzbefehle oder Siri."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράψτε μια εγγράψιμη από AI καταχώριση μνήμης Lorvex με βάση το κλειδί της από τις Συντομεύσεις ή το Siri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete an AI-writable Lorvex memory entry by key from Shortcuts or Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina un recuerdo de Lorvex editable por IA por clave desde Atajos o Siri."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف یک مورد حافظه Lorvex، قابل‌نوشتن توسط هوش مصنوعی، با کلید، از طریق میان‌برها یا Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime un souvenir de Lorvex modifiable par l’IA à partir de sa clé, depuis Raccourcis ou Siri."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחיקת רשומת זיכרון ב-Lorvex שניתנת לכתיבה על ידי AI, לפי מפתח, דרך קיצורי דרך או Siri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट्स या Siri से कुंजी के आधार पर AI द्वारा लिखने योग्य Lorvex मेमोरी एंट्री हटाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus entri memori Lorvex yang dapat ditulis AI berdasarkan kunci dari Pintasan atau Siri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina un ricordo di Lorvex modificabile dall’IA tramite chiave da Comandi rapidi o Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットまたはSiriで、キーを指定してAIが書き込めるLorvexのメモリを削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어 또는 Siri에서 키로 AI가 쓸 수 있는 Lorvex 메모리를 삭제합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट किंवा Siri द्वारे की वापरून AI लिहू शकेल अशी एक Lorvex मेमरी नोंद हटवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memadamkan entri memori Lorvex yang boleh ditulis AI mengikut kunci daripada Pintasan atau Siri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert een door AI beschrijfbaar Lorvex-geheugenitem op basis van de sleutel via Opdrachten of Siri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa według klucza wpis pamięci Lorvex zapisywalny przez AI ze Skrótów lub Siri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclui uma memória do Lorvex editável pela IA pela chave, pelos Atalhos ou pela Siri."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șterge după cheie o înregistrare din memoria Lorvex ce poate fi scrisă de AI, prin Scurtături sau Siri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет по ключу запись памяти Lorvex, доступную для записи ИИ, из «Быстрых команд» или Siri."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்கவழிகள் அல்லது Siri மூலம் கீ அடிப்படையில் AI எழுதக்கூடிய Lorvex நினைவகப் பதிவை நீக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "షార్ట్‌కట్స్ లేదా Siri నుండి కీ ద్వారా AI రాయగలిగే Lorvex మెమరీ నమోదును డిలీట్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบรายการหน่วยความจำ Lorvex ที่ AI เขียนได้โดยระบุคีย์ จากคำสั่งลัดหรือ Siri"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kestirmeler veya Siri ile yapay zekânın yazabildiği bir Lorvex bellek girdisini anahtarıyla silin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаляє за ключем запис пам’яті Lorvex, доступний для запису ШІ, зі «Швидких команд» або Siri."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شارٹ کٹس یا Siri سے کلید کے ذریعے AI کے لیے قابل تحریر Lorvex حافظہ اندراج حذف کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa một mục ghi nhớ Lorvex mà AI có thể ghi theo khóa từ Phím tắt hoặc Siri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“快捷指令”或 Siri 按键删除一个 AI 可写的 Lorvex 记忆条目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過捷徑或 Siri，依鍵刪除 AI 可寫入的 Lorvex 記憶。"
          }
        }
      }
    },
