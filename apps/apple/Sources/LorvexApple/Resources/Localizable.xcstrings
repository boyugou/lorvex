    "settings.cloud_sync.live_detail": {
      "comment": "Under the iCloud switch while sync is on.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى مهامك وقوائمك وعاداتك متطابقة على كل جهاز مسجّل الدخول إلى حساب iCloud الخاص بك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার iCloud অ্যাকাউন্টে সাইন ইন করা প্রতিটি ডিভাইসে আপনার টাস্ক, তালিকা ও অভ্যাস একই থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Aufgaben, Listen und Gewohnheiten sind auf jedem Gerät identisch, das bei deinem iCloud-Account angemeldet ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εργασίες, οι λίστες και οι συνήθειές σας παραμένουν ίδιες σε κάθε συσκευή που έχει συνδεθεί στον λογαριασμό σας iCloud."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tasks, lists, and habits stay the same on every device signed in to your iCloud account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus tareas, listas y hábitos son los mismos en todos los dispositivos con sesión iniciada en tu cuenta de iCloud."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارها، فهرست‌ها و عادت‌های شما در همه دستگاه‌هایی که با حساب iCloud شما وارد شده‌اند یکسان می‌مانند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos tâches, listes et habitudes restent identiques sur tous les appareils connectés à votre compte iCloud."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשימות, הרשימות וההרגלים שלך נשארים זהים בכל מכשיר שמחובר לחשבון ה-iCloud שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके iCloud खाते में साइन इन हर डिवाइस पर आपके कार्य, सूचियाँ और आदतें एक जैसी रहती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas, daftar, dan kebiasaan tetap sama di setiap perangkat yang masuk ke akun iCloud Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue attività, liste e abitudini restano uguali su ogni dispositivo connesso al tuo account iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスク、リスト、習慣は、同じiCloudアカウントでサインインしているすべてのデバイスで同じ状態に保たれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일, 목록, 습관이 iCloud 계정으로 로그인한 모든 기기에서 동일하게 유지됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या iCloud अकाउंटमध्ये साइन इन केलेल्या प्रत्येक डिव्हाइसवर तुमची कार्ये, याद्या आणि सवयी सारख्याच राहतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas, senarai dan tabiat kekal sama pada setiap peranti yang didaftar masuk ke akaun iCloud anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je taken, lijsten en gewoontes blijven op elk apparaat hetzelfde dat bij je iCloud-account is ingelogd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje zadania, listy i nawyki są takie same na każdym urządzeniu zalogowanym na twoje konto iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas tarefas, listas e hábitos permanecem iguais em todos os dispositivos conectados à sua conta do iCloud."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarcinile, listele și obiceiurile rămân aceleași pe fiecare dispozitiv conectat la contul iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши задачи, списки и привычки одинаковы на всех устройствах, на которых выполнен вход в вашу учётную запись iCloud."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் iCloud கணக்கில் உள்நுழைந்துள்ள ஒவ்வொரு சாதனத்திலும் உங்கள் பணிகள், பட்டியல்கள், பழக்கங்கள் ஒரே மாதிரி இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ iCloud ఖాతాలో సైన్ ఇన్ చేసిన ప్రతి డివైజ్‌లో మీ టాస్క్‌లు, జాబితాలు, అలవాట్లు ఒకేలా ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งาน ลิสต์ และนิสัยของคุณจะเหมือนกันบนทุกอุปกรณ์ที่ลงชื่อเข้าบัญชี iCloud ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görevleriniz, listeleriniz ve alışkanlıklarınız, iCloud hesabınızla giriş yapmış her aygıtta aynı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші завдання, списки та звички однакові на всіх пристроях, на яких виконано вхід в обліковий запис iCloud."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے کام، فہرستیں اور عادات آپ کے iCloud اکاؤنٹ میں سائن اِن ہر ڈیوائس پر یکساں رہتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhiệm vụ, danh sách và thói quen luôn giống nhau trên mọi thiết bị đăng nhập vào tài khoản iCloud của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务、清单和习惯会在登录同一 iCloud 账户的每台设备上保持一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的任務、清單和習慣會在所有登入同一個 iCloud 帳號的裝置上保持一致。"
          }
        }
      }
    },
    "settings.cloud_sync.not_run_yet": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تعمل المزامنة بعد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিঙ্ক এখনও চালানো হয়নি।"
          }
        },
        "de": {
