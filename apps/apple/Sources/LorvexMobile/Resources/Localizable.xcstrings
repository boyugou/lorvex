            "state": "translated",
            "value": "Geen taken onder ‘Ooit’"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak zadań „Kiedyś”"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma tarefa “Algum dia”"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicio sarcină în „Cândva”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет задач «Когда-нибудь»"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "என்றாவது ஒரு நாள் பணிகள் இல்லை"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏదో ఒక రోజు టాస్క్‌లు లేవు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีงาน “สักวัน”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Bir gün” görevi yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає завдань «Колись»"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "\"کسی دن\" میں کوئی کام نہیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có nhiệm vụ Một ngày nào đó"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有“将来某天”的任务"
          }
        },
        "zh-Hant": {
