    "settings.working_hours.invalid": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر وقت نهاية بعد وقت البداية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুরুর সময়ের পরে একটি শেষ সময় বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Endzeit nach der Startzeit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε ώρα λήξης μετά την ώρα έναρξης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick an end time after the start time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una hora de fin posterior a la de inicio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زمان پایانی بعد از زمان شروع انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une heure de fin postérieure à l’heure de début."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור שעת סיום אחרי שעת ההתחלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू होने के समय के बाद का खत्म होने का समय चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih waktu berakhir setelah waktu mulai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un’ora di fine successiva a quella di inizio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了時刻は開始時刻より後にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료 시간을 시작 시간 이후로 선택하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
