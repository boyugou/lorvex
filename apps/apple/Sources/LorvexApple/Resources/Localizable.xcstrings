        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्य खोजें, नेविगेट करें या जोड़ें…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cari tugas, navigasi, atau catat…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca attività, naviga o aggiungi…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクを検索、移動、追加…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일 검색, 이동 또는 추가…"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्ये सर्च करा, नॅव्हिगेट करा किंवा जोडा…"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cari tugas, navigasi atau catat…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoek taken, navigeer of leg vast…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szukaj zadań, nawiguj lub dodawaj…"
          }
        },
