    "calendar.plan_rail.hint": {
      "comment": "Hint under the Unplanned Tasks rail heading telling the person to drag a task onto a day or a time in the calendar",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب مهمة إلى يوم أو وقت لتخطيطها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্ল্যান করতে একটি টাস্ক কোনো দিনে বা সময়ে টেনে আনুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgabe auf einen Tag oder eine Uhrzeit ziehen, um sie zu planen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρετε μια εργασία σε μια ημέρα ή ώρα για να την προγραμματίσετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a task onto a day or a time to plan it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra una tarea a un día o una hora para planificarla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای برنامه‌ریزی، یک کار را روی یک روز یا ساعت بکشید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser une tâche sur un jour ou une heure pour la planifier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גררו משימה אל יום או שעה כדי לתכנן אותה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्लान करने के लिए कार्य को किसी दिन या समय पर खींचें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret tugas ke sebuah hari atau jam untuk merencanakannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina un’attività su un giorno o un orario per pianificarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクを日付や時刻へドラッグして、予定にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일을 날짜나 시간으로 끌어다 놓아 계획하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्लॅन करण्यासाठी कार्य एखाद्या दिवसावर किंवा वेळेवर ओढा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret tugas ke satu hari atau masa untuk merancangnya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep een taak naar een dag of tijd om hem in te plannen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij zadanie na dzień lub godzinę, aby je zaplanować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste uma tarefa para um dia ou horário para planejá-la."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trageți o sarcină pe o zi sau o oră pentru a o planifica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите задачу на день или время, чтобы запланировать её."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "திட்டமிட, ஒரு பணியை ஒரு நாளுக்கோ நேரத்துக்கோ இழுத்து விடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్లాన్ చేయడానికి టాస్క్‌ను ఒక రోజు లేదా సమయంపైకి లాగండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากงานไปวางบนวันหรือเวลาเพื่อวางแผน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planlamak için bir görevi bir güne veya saate sürükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть завдання на день або час, щоб запланувати його."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پلان کرنے کے لیے کسی کام کو دن یا وقت پر گھسیٹیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo một nhiệm vụ vào một ngày hoặc giờ để lên kế hoạch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把任务拖到某一天或某个时间，即可计划。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將任務拖到某一天或某個時間，即可安排。"
          }
        }
      }
    },
