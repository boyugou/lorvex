    "system.list.delete.description": {
      "comment": "Description for the Delete Lorvex List App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف قائمة فارغة في Lorvex من الاختصارات أو Siri."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শর্টকাট বা Siri থেকে একটি খালি Lorvex তালিকা ডিলিট করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
