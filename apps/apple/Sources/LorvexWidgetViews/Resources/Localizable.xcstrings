          "stringUnit": {
            "state": "translated",
            "value": "完成 %@"
          }
        }
      }
    },
    "widget.habits.row.progress.a11y": {
      "comment": "VoiceOver label for a habit row; first argument is the habit name, second is today's completion count, third is today's target",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$lld of %3$lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，已完成 %2$lld/%3$lld"
          }
        }
      }
    },
    "widget.habits.title": {
      "comment": "Header title for the habits widget",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
