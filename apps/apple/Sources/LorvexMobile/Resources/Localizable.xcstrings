    "habits.empty.no_active.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط ＋ لبدء عادة تريد بناءها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে অভ্যাস গড়ে তুলতে চান, তা শুরু করতে ＋ ট্যাপ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf ＋, um eine neue Gewohnheit aufzubauen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε ＋ για να ξεκινήσετε μια συνήθεια που θέλετε να χτίσετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap ＋ to start a habit you want to build."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca ＋ para empezar un hábito que quieras formar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای شروع عادتی که می‌خواهید بسازید، روی ＋ ضربه بزنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez ＋ pour commencer une habitude que vous souhaitez adopter."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להקיש על ＋ כדי להתחיל הרגל שרוצים לבנות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो आदत बनानी हो, उसे शुरू करने के लिए ＋ पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk ＋ untuk memulai kebiasaan yang ingin dibangun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca ＋ per iniziare un’abitudine che vuoi costruire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "＋をタップして、身につけたい習慣を始めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "＋ 버튼을 탭하여 만들고 싶은 습관을 시작하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हाला जी सवय लावायची आहे ती सुरू करण्यासाठी ＋ टॅप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik ＋ untuk memulakan tabiat yang ingin dibina."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op ＋ om te beginnen met een gewoonte die je wilt opbouwen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij ＋, aby zacząć budować nawyk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em ＋ para começar um hábito que você quer criar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți ＋ pentru a începe un obicei pe care doriți să-l formați."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь ＋, чтобы начать формировать привычку."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் உருவாக்க விரும்பும் பழக்கத்தைத் தொடங்க ＋ தட்டவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు పెంపొందించుకోవాలనుకుంటున్న అలవాటును ప్రారంభించడానికి ＋ ట్యాప్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะ ＋ เพื่อเริ่มสร้างนิสัยที่ต้องการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oluşturmak istediğiniz bir alışkanlığa başlamak için ＋ simgesine dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніть ＋, щоб почати формувати звичку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جو عادت بنانا چاہتے ہیں اسے شروع کرنے کے لیے ＋ پر ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm ＋ để bắt đầu một thói quen muốn xây dựng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按 ＋ 开始培养一个习惯。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下 ＋ 開始養成你想建立的習慣。"
          }
        }
      }
    },
