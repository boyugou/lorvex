    "list_detail.empty.no_tasks_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا المهام المعيّنة لهذه القائمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই তালিকার টাস্ক এখানে দেখা যাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben, die dieser Liste zugewiesen sind, erscheinen hier."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εργασίες που ανατίθενται σε αυτή τη λίστα θα εμφανίζονται εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasks assigned to this list will appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas asignadas a esta lista aparecerán aquí."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارهای اختصاص‌یافته به این فهرست اینجا نمایش داده می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches affectées à cette liste apparaîtront ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משימות ששויכו לרשימה זו יופיעו כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस सूची में डाले गए कार्य यहाँ दिखेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas di daftar ini akan muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le attività assegnate a questa lista appariranno qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリストに割り当てたタスクがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 목록에 지정한 할 일이 여기에 표시됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या यादीतील कार्ये येथे दिसतील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas dalam senarai ini akan dipaparkan di sini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Taken die aan deze lijst zijn toegewezen, verschijnen hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadania przypisane do tej listy pojawią się tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas atribuídas a esta lista aparecerão aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarcinile atribuite acestei liste vor apărea aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появятся задачи из этого списка."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานที่กำหนดให้ลิสต์นี้จะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu listeye atanan görevler burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут з’являться завдання з цього списку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس فہرست میں تفویض کیے گئے کام یہاں نظر آئیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhiệm vụ trong danh sách này sẽ xuất hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分配到此列表的任务会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指派到此清單的任務會顯示在這裡。"
          }
        }
      }
    },
