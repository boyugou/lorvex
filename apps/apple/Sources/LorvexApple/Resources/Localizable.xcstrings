          "stringUnit": {
            "state": "translated",
            "value": "Affiche sur l’icône du Dock le nombre de tâches à faire en retard ou à échéance aujourd’hui."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג על סמל ה-Dock את מספר המשימות הפתוחות שבאיחור או שתאריך היעד שלהן היום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डॉक आइकन पर अतिदेय और आज नियत लंबित कार्यों की संख्या दिखाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra sull’icona del Dock il numero di attività da fare in ritardo o in scadenza oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dockのアイコンに、期限切れと今日が期限の未完了タスクの数を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 아이콘에 기한이 지났거나 오늘 기한인 미완료 할 일의 수를 표시합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont het aantal openstaande taken die verlopen zijn of vandaag vervallen op het Dock-symbool."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje na ikonie w Docku liczbę zaległych zadań oraz zadań do zrobienia z terminem na dzisiaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra no ícone do Dock o número de tarefas pendentes atrasadas ou com prazo para hoje."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișează numărul de sarcini de făcut restante sau scadente astăzi pe pictograma din Dock."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает на значке в Dock число невыполненных задач, которые просрочены или должны быть выполнены сегодня."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує на значку в Dock кількість невиконаних завдань, які прострочені або мають бути виконані сьогодні."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تاخیر زدہ اور آج مقررہ نامکمل کاموں کی تعداد Dock آئیکن پر دکھاتا ہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在程序坞图标上显示逾期和今日到期的未完成任务数量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Dock 圖示上顯示逾期與今天到期的未完成任務數量。"
          }
        }
      }
    },
