    "widget.config.today.description": {
      "comment": "Description shown in the system widget configuration sheet for the Today widget",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر قائمة لعرض مهامها فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু একটি তালিকার টাস্ক দেখাতে সেটি বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Liste, um nur ihre Aufgaben anzuzeigen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε μια λίστα για να εμφανίζονται μόνο οι εργασίες της."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a list to show only its tasks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una lista para ver solo sus tareas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فهرستی را انتخاب کنید تا فقط کارهای آن نمایش داده شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une liste pour n’afficher que ses tâches."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור רשימה כדי להציג רק את המשימות שלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ किसी एक सूची के कार्य दिखाने के लिए सूची चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih daftar untuk hanya menampilkan tugasnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una lista per mostrare solo le sue attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストを選ぶと、そのリストのタスクだけを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록을 선택하면 해당 목록의 할 일만 표시됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फक्त एका यादीतील कार्ये दाखवण्यासाठी ती निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih senarai untuk hanya menunjukkan tugasnya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een lijst om alleen de taken ervan te tonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz listę, aby pokazywać tylko jej zadania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma lista para mostrar somente as tarefas dela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți o listă pentru a afișa doar sarcinile ei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите список, чтобы показывать только его задачи."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு பட்டியலைத் தேர்ந்தெடுத்தால், அந்தப் பட்டியலின் பணிகள் மட்டுமே காட்டப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక జాబితాను ఎంచుకుంటే, ఆ జాబితాలోని టాస్క్‌లు మాత్రమే చూపబడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกลิสต์เพื่อแสดงเฉพาะงานในลิสต์นั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca o listenin görevlerini göstermek için bir liste seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть список, щоб показувати лише його завдання."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف اس کے کام دکھانے کے لیے کوئی فہرست منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một danh sách để chỉ hiển thị các nhiệm vụ của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个列表，只显示其中的任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個清單，就只會顯示其中的任務。"
          }
        }
      }
    },
