{
  "sourceLanguage": "en",
  "strings": {
    "watch.action.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel Task"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消任务"
          }
        }
      }
    },
    "watch.action.cancel.a11y": {
      "comment": "Accessibility label for the cancel-task button",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel occurrence"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅取消本次"
          }
        }
      }
    },
    "watch.action.cancel.confirm": {
      "comment": "Title of the cancel-task confirmation dialog; %@ is the task title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel this occurrence of %@?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅取消“%@”的这一次？"
          }
        }
      }
    },
    "watch.action.cancel.hint": {
      "comment": "Accessibility hint for cancelling a task; %@ is the task title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancels this occurrence of %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅取消“%@”的这一次"
          }
        }
      }
    },
    "watch.action.cancel.message": {
      "comment": "Confirmation message for cancelling a task",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For repeating tasks, only this occurrence is cancelled and future occurrences continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对于重复任务，只会取消本次，之后的任务仍会继续。"
          }
        }
      }
    },
    "watch.action.cancel_task": {
      "comment": "Destructive button in the cancel confirmation dialog",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel Occurrence"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅取消本次"
          }
        }
      }
    },
    "watch.action.complete.a11y": {
      "comment": "Accessibility label for completing a queued task; %@ is the task title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark %@ complete"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将“%@”标记为完成"
          }
        }
      }
    },
    "watch.action.defer.hint": {
      "comment": "Accessibility hint for deferring a task; %@ is the task title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Defers %@ until tomorrow"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将“%@”推迟到明天"
          }
        }
      }
    },
    "watch.action.keep_task": {
      "comment": "Cancel button in the cancel-task confirmation dialog (keeps the task)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Task"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留任务"
          }
        }
      }
    },
    "watch.action.tomorrow": {
      "comment": "Short label for deferring the task to tomorrow",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomorrow"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明天"
          }
        }
      }
    },
    "watch.capture.pending.a11y": {
      "comment": "Accessibility label for a durably queued task awaiting phone application; %@ is the task title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pending task: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待处理任务：%@"
          }
        }
      }
    },
    "watch.capture.capturing": {
      "comment": "Capture button label while a capture is in flight",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加中"
          }
        }
      }
    },
    "watch.capture.placeholder": {
      "comment": "Placeholder text for the new-task capture field",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New task"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新任务"
          }
        }
      }
    },
    "watch.capture.submit": {
      "comment": "Capture button label",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加"
          }
        }
      }
    },
    "watch.capture.submit.a11y": {
      "comment": "Accessibility label for the capture button",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture task"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加任务"
          }
        }
      }
    },
    "watch.capture.title.a11y": {
      "comment": "Accessibility label for the new-task title field",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New task title"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新任务标题"
          }
        }
      }
    },
    "watch.delivery.dismiss": {
      "comment": "Button that removes a terminal rejected watch command from the durable journal",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dismiss"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "忽略"
          }
        }
      }
    },
    "watch.delivery.journal_failure": {
      "comment": "Status shown when the durable watch command journal cannot be opened safely",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved actions unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存操作不可用"
          }
        }
      }
    },
    "watch.delivery.journal_failure.hint": {
      "comment": "Accessibility recovery hint when the durable watch command journal cannot be opened",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Lorvex on iPhone, then reopen the watch app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上打开 Lorvex，然后重新打开手表 App"
          }
        }
      }
    },
    "watch.delivery.pending": {
      "comment": "Count of durably queued watch commands awaiting phone application; %lld is the count",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld pending"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 项待处理"
          }
        }
      }
    },
    "watch.delivery.rejected": {
      "comment": "Title for a rejected watch command; %lld is its monotonic sequence",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Action %lld wasn’t applied"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作 %lld 未应用"
          }
        }
      }
    },
    "watch.delivery.rejection.unreadable": {
      "comment": "Watch delivery: the phone repeatedly answered a command without an acknowledgement",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPhone couldn’t read this action. Update Lorvex on both devices."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 无法读取这项操作。请在两台设备上都更新 Lorvex。"
          }
        }
      }
    },
    "watch.delivery.section": {
      "comment": "Section header for durable Watch-to-iPhone command delivery",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phone delivery"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送到 iPhone"
          }
        }
      }
    },
    "watch.delivery.rejection.conflict": {
      "comment": "Reason shown when an iPhone rejects a queued action because newer data conflicts",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action conflicts with newer changes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作与较新的更改冲突。"
          }
        }
      }
    },
    "watch.delivery.rejection.generic": {
      "comment": "Generic localized reason for an unknown terminal iPhone rejection code",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action wasn’t applied on iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作未在 iPhone 上应用。"
          }
        }
      }
    },
    "watch.delivery.rejection.invalid_title": {
      "comment": "Reason shown when a queued capture title is no longer valid",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task title is no longer valid."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务标题不再有效。"
          }
        }
      }
    },
    "watch.delivery.rejection.not_found": {
      "comment": "Reason shown when the item targeted by a queued action no longer exists",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The item no longer exists on iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该项目已不在 iPhone 上。"
          }
        }
      }
    },
    "watch.delivery.rejection.out_of_date": {
      "comment": "Reason shown when a queued protocol command is stale or collides with an earlier command",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This saved action is out of date."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此已存操作已过期。"
          }
        }
      }
    },
    "watch.delivery.rejection.validation_failed": {
      "comment": "Reason shown when the phone rejects a queued action as no longer valid",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action is no longer valid."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作不再有效。"
          }
        }
      }
    },
    "watch.delivery.workspace_replaced": {
      "comment": "Reason retained when a queued command belongs to a replaced iPhone database workspace",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPhone workspace was replaced before this action was applied."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用此操作前，iPhone 工作区已被替换。"
          }
        }
      }
    },
    "watch.error.action_failed": {
      "comment": "Watch Today: a task or habit action failed to save",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That change didn’t save. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这项更改没有保存，请再试一次。"
          }
        }
      }
    },
    "watch.error.capture_forwarder_required": {
      "comment": "Error shown if a watch capture action reaches a read-only snapshot backend without an iPhone/Mac mutation forwarder",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Lorvex on iPhone or Mac to capture new tasks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 或 Mac 上打开 Lorvex 以添加新任务。"
          }
        }
      }
    },
    "watch.error.forwarder_required": {
      "comment": "Error shown if a watch mutation action reaches a read-only snapshot backend without an iPhone/Mac mutation forwarder",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Lorvex on iPhone or Mac to apply this action."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 或 Mac 上打开 Lorvex 以应用此操作。"
          }
        }
      }
    },
    "watch.error.load.remedy": {
      "comment": "Remedy text for a generic Today-load failure",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry, or open Lorvex on your iPhone if this persists."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重试，若仍未解决，请在 iPhone 上打开 Lorvex。"
          }
        }
      }
    },
    "watch.error.load.title": {
      "comment": "Headline for a generic Today-load failure",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t load Today"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载今天的任务"
          }
        }
      }
    },
    "watch.error.retry": {
      "comment": "Retry button label",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "watch.error.retry.hint": {
      "comment": "Accessibility hint for the retry button",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reloads Today from the snapshot or paired iPhone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从快照或已配对的 iPhone 重新加载今天的任务"
          }
        }
      }
    },
    "watch.error.snapshot_unavailable": {
      "comment": "Localized error description when the watch cannot load its Today snapshot; %@ is the localized recovery/status message for the fallback reason",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch data unavailable: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手表数据不可用：%@"
          }
        }
      }
    },
    "watch.error.unavailable.remedy": {
      "comment": "Remedy text when the watch snapshot is unavailable",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Lorvex on your iPhone to sync, then retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 iPhone 上打开 Lorvex 以同步，然后重试。"
          }
        }
      }
    },
    "watch.error.unavailable.title": {
      "comment": "Headline when the watch snapshot is unavailable",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的任务不可用"
          }
        }
      }
    },
    "watch.section.habits": {
      "extractionState": "manual",
      "localizations": {
        "en": {
