    "system.list.health.read.none_dialog": {
      "comment": "Siri dialog when no Lorvex list has an overdue task",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد قائمة تحتوي على مهام متأخرة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো তালিকায় বকেয়া টাস্ক নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Liste hat überfällige Aufgaben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καμία λίστα δεν έχει εκπρόθεσμες εργασίες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No list has overdue tasks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna lista tiene tareas vencidas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ فهرستی کار عقب‌افتاده ندارد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune liste n’a de tâches en retard."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין רשימה עם משימות באיחור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी सूची में अतिदेय कार्य नहीं हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada daftar yang memiliki tugas terlewat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna lista ha attività in ritardo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限切れのタスクがあるリストはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기한 초과 할 일이 있는 목록이 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोणत्याही यादीत ओव्हरड्यू कार्ये नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada senarai yang mempunyai tugas lewat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen enkele lijst heeft verlopen taken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadna lista nie ma zaległych zadań."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma lista tem tarefas atrasadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicio listă nu are sarcini restante."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни в одном списке нет просроченных задач."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எந்தப் பட்டியலிலும் காலக்கெடு முடிந்த பணிகள் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏ జాబితాలోనూ గడువు మీరిన టాస్క్‌లు లేవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีลิสต์ใดมีงานเกินกำหนด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir listede gecikmiş görev yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоден список не містить прострочених завдань."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی فہرست میں تاخیر کا شکار کام نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có danh sách nào có nhiệm vụ quá hạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有包含逾期任务的列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有包含逾期任務的清單。"
          }
        }
      }
    },
