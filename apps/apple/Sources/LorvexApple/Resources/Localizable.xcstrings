    "tasks.empty.no_tasks_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب مهمة في الحقل أعلاه، أو اطلب من مساعدك إضافة بعضها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উপরের ফিল্ডে একটি টাস্ক লিখুন – অথবা আপনার অ্যাসিস্ট্যান্টকে কিছু যোগ করতে বলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib oben im Feld eine Aufgabe ein – oder bitte deinen Assistenten, einige hinzuzufügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πληκτρολογήστε μια εργασία στο πεδίο παραπάνω ή ζητήστε από τον βοηθό σας να προσθέσει μερικές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type a task in the field above — or ask your assistant to add some."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe una tarea en el campo de arriba o pide a tu asistente que añada algunas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک کار را در کادر بالا بنویسید — یا از دستیار خود بخواهید چند کار اضافه کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une tâche dans le champ ci-dessus, ou demandez à votre assistant d’en ajouter."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להקליד משימה בשדה שלמעלה — או לבקש מהעוזר שלך להוסיף כמה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊपर के फ़ील्ड में कार्य लिखें, या अपने असिस्टेंट से कुछ जोड़ने को कहें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik tugas di kolom di atas – atau minta asisten untuk menambahkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi un’attività nel campo qui sopra oppure chiedi al tuo assistente di aggiungerne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上の入力欄にタスクを入力するか、アシスタントに追加を頼んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위 입력란에 할 일을 입력하거나 어시스턴트에게 추가를 요청하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वरील फील्डमध्ये एक कार्य टाइप करा – किंवा तुमच्या सहाय्यकाला काही जोडायला सांगा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Taip tugas dalam medan di atas – atau minta pembantu AI menambahnya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ een taak in het veld hierboven – of vraag je assistent om er een paar toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz zadanie w polu powyżej — albo poproś asystenta o dodanie kilku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite uma tarefa no campo acima ou peça ao seu assistente para adicionar algumas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduceți o sarcină în câmpul de mai sus – sau cereți asistentului să adauge câteva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите задачу в поле выше — или попросите ассистента добавить несколько."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மேலே உள்ள புலத்தில் ஒரு பணியை டைப் செய்யவும் – அல்லது சிலவற்றைச் சேர்க்குமாறு உங்கள் அசிஸ்டென்ட்டிடம் கேட்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పైన ఉన్న ఫీల్డ్‌లో ఒక టాస్క్ టైప్ చేయండి – లేదా కొన్ని జోడించమని మీ అసిస్టెంట్‌ను అడగండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พิมพ์งานในช่องด้านบน หรือให้ผู้ช่วยของคุณเพิ่มให้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yukarıdaki alana bir görev yazın veya asistanınızdan birkaç görev eklemesini isteyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть завдання в полі вище — або попросіть асистента додати кілька."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اوپر والے فیلڈ میں کام ٹائپ کریں — یا اپنے اسسٹنٹ سے کچھ شامل کرنے کو کہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập một nhiệm vụ vào ô phía trên – hoặc nhờ trợ lý thêm giúp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在上方输入任务，或让助手帮你添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在上方欄位輸入任務，或請助理幫你新增。"
          }
        }
      }
    },
