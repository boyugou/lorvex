    "settings.calendar.access.busy_only_detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة الوقت المشغول فقط، مع إخفاء عناوين الأحداث ومواقعها وملاحظاتها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু ব্যস্ত সময় মিরর করা হয় – ইভেন্টের শিরোনাম, লোকেশন ও নোট লুকানো থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird nur die belegte Zeit gespiegelt – Titel, Orte und Notizen von Ereignissen bleiben verborgen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαβάζεται μόνο ο κατειλημμένος χρόνος – οι τίτλοι, οι τοποθεσίες και οι σημειώσεις των γεγονότων αποκρύπτονται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirror occupied time only — event titles, locations, and notes are hidden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lee solo el tiempo ocupado: los títulos, las ubicaciones y las notas de los eventos quedan ocultos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط زمان‌های اشغال‌شده منعکس می‌شوند — عنوان، مکان و یادداشت رویدادها پنهان می‌ماند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le temps occupé est lu : les titres, lieux et notes des événements sont masqués."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משקף רק זמן תפוס — כותרות, מיקומים והערות של אירועים מוסתרים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल व्यस्त समय मिरर करें; इवेंट के शीर्षक, स्थान और नोट छिपे रहते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya mencerminkan waktu yang terisi – judul, lokasi, dan catatan acara disembunyikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene letto solo il tempo occupato: titoli, luoghi e note degli eventi restano nascosti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定がある時間帯だけを読み取ります。イベントのタイトル、場所、メモは非表示になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정이 있는 시간만 읽습니다. 이벤트 제목, 위치, 메모는 숨겨집니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फक्त व्यस्त वेळ मिरर केली जाते – इव्हेंटची शीर्षके, स्थाने आणि नोट्स लपवलेली असतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya mencerminkan masa yang sibuk – tajuk, lokasi dan nota peristiwa disembunyikan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen bezette tijd wordt gespiegeld – titels, locaties en notities van activiteiten blijven verborgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytywany jest tylko zajęty czas — tytuły, miejsca i notatki wydarzeń są ukryte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas o tempo ocupado é lido: títulos, locais e notas dos eventos ficam ocultos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se oglindește doar timpul ocupat – titlurile, locațiile și notițele evenimentelor sunt ascunse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Считывается только занятое время — названия, места и заметки событий скрыты."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பிஸியாக உள்ள நேரத்தை மட்டும் மிரர் செய்யும் – நிகழ்வுத் தலைப்புகள், இருப்பிடங்கள், குறிப்புகள் மறைக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బిజీగా ఉన్న సమయాన్ని మాత్రమే మిర్రర్ చేస్తుంది – ఇవెంట్ టైటిల్‌లు, లొకేషన్‌లు, నోట్స్ దాచబడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านเฉพาะช่วงเวลาที่ไม่ว่าง ชื่อกิจกรรม สถานที่ และโน้ตจะถูกซ่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca meşgul zaman okunur; etkinlik başlıkları, konumlar ve notlar gizlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зчитується лише зайнятий час — назви, місця й нотатки подій приховано."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف مصروف وقت مرر کیا جاتا ہے — ایونٹس کے عنوان، مقامات اور نوٹس چھپے رہتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ phản chiếu khoảng thời gian bận – tiêu đề, vị trí và ghi chú của sự kiện được ẩn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只同步占用时间，隐藏事件标题、地点和备注。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只讀取佔用的時段，並隱藏事件標題、位置與備註。"
          }
        }
      }
    },
