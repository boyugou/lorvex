          "stringUnit": {
            "state": "translated",
            "value": "عناوين المهام مفصولة بفواصل أو أسطر جديدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কমা বা নতুন লাইন দিয়ে আলাদা করা টাস্কের শিরোনাম।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgabentitel, durch Komma oder Zeilenumbruch getrennt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τίτλοι εργασιών χωρισμένοι με κόμμα ή νέα γραμμή."
