            "value": "このビルドではiCloud同期を利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드에서는 iCloud 동기화를 사용할 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja iCloud nie jest dostępna w tej wersji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização do iCloud não está disponível nesta versão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация iCloud недоступна в этой сборке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронізація iCloud недоступна в цій збірці."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本不支持 iCloud 同步。"
          }
        },
        "zh-Hant": {
