    "system.task.cancel.description": {
      "comment": "Description for cancelling only one Lorvex task occurrence while preserving future occurrences",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء هذا التكرار لمهمة في Lorvex من الاختصارات أو Siri. تستمر المهام المتكررة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শর্টকাট বা Siri থেকে শুধু এইবারের Lorvex টাস্ক বাতিল করুন। পুনরাবৃত্ত টাস্ক চলতে থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bricht diese Wiederholung einer Lorvex-Aufgabe über Kurzbefehle oder Siri ab. Wiederkehrende Aufgaben laufen weiter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακυρώστε αυτή την επανάληψη μιας εργασίας Lorvex από τις Συντομεύσεις ή το Siri. Οι επαναλαμβανόμενες εργασίες συνεχίζονται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel this Lorvex task occurrence from Shortcuts or Siri. Repeating tasks continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancela esta repetición de una tarea de Lorvex desde Atajos o Siri. Las tareas recurrentes continúan."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "لغو این تکرار از یک کار Lorvex از طریق میان‌برها یا Siri. کارهای تکرارشونده ادامه می‌یابند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annule cette occurrence d’une tâche de Lorvex depuis Raccourcis ou Siri. Les tâches récurrentes continuent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביטול המופע הזה של משימה ב-Lorvex דרך קיצורי דרך או Siri. משימות חוזרות ממשיכות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट्स या Siri से Lorvex कार्य का केवल यह एक बार रद्द करें। दोहराए जाने वाले कार्य जारी रहते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membatalkan kejadian tugas Lorvex ini dari Pintasan atau Siri. Tugas berulang tetap berlanjut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla questa occorrenza di un’attività di Lorvex da Comandi rapidi o Siri. Le attività ricorrenti continuano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットまたはSiriで、Lorvexのタスクの今回分をキャンセルします。繰り返しタスクは以降も続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어 또는 Siri에서 Lorvex 할 일의 이번 반복을 취소합니다. 반복되는 할 일은 계속됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट किंवा Siri द्वारे फक्त यावेळचे Lorvex कार्य रद्द करा. पुनरावृत्ती होणारी कार्ये सुरू राहतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membatalkan kejadian tugas Lorvex ini daripada Pintasan atau Siri. Tugas berulang diteruskan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuleert deze herhaling van een Lorvex-taak via Opdrachten of Siri. Terugkerende taken lopen door."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anuluje to wystąpienie zadania Lorvex ze Skrótów lub Siri. Zadania powtarzające się są kontynuowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancela esta ocorrência de uma tarefa do Lorvex pelos Atalhos ou pela Siri. As tarefas recorrentes continuam."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulează această apariție a unei sarcini Lorvex prin Scurtături sau Siri. Sarcinile recurente continuă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменяет это повторение задачи Lorvex из «Быстрых команд» или Siri. Повторяющиеся задачи продолжаются."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்கவழிகள் அல்லது Siri மூலம் இந்த Lorvex பணி நேர்வை ரத்துசெய். தொடர் பணிகள் தொடரும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "షార్ట్‌కట్స్ లేదా Siri నుండి ఈ Lorvex టాస్క్ సందర్భాన్ని రద్దు చేయండి. పునరావృతమయ్యే టాస్క్‌లు కొనసాగుతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเลิกงาน Lorvex ครั้งนี้จากคำสั่งลัดหรือ Siri งานที่ทำประจำจะยังคงอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kestirmeler veya Siri ile bu Lorvex görev yinelemesini iptal edin. Yinelenen görevler devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасовує це повторення завдання Lorvex зі «Швидких команд» або Siri. Повторювані завдання тривають."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شارٹ کٹس یا Siri سے Lorvex کام کی اس تکرار کو منسوخ کریں۔ دہرائے جانے والے کام جاری رہتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hủy lần lặp này của nhiệm vụ Lorvex từ Phím tắt hoặc Siri. Nhiệm vụ lặp lại vẫn tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过快捷指令或 Siri 仅取消 Lorvex 任务的本次执行。之后的执行仍会继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過捷徑或 Siri 取消 Lorvex 任務的這一次。重複任務會繼續進行。"
          }
        }
      }
    },
