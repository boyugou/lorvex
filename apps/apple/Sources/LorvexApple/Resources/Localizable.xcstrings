    "setup.permissions.notifications.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلقَّ تذكيرات المهام كإشعارات من النظام."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receive task reminders as system notifications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe recordatorios de tareas como notificaciones del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevez les rappels de tâches sous forme de notifications système."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्य रिमाइंडर सिस्टम सूचनाओं के रूप में पाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi i promemoria delle attività come notifiche di sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
