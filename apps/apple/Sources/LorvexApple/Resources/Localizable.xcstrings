        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajout uniquement, lecture bloquée"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוספה בלבד — קריאה חסומה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल जोड़ना — पढ़ना अवरुद्ध"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya Tambah – pembacaan diblokir"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo aggiunta, lettura bloccata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加のみ（読み取りは不可）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가만 가능(읽기 차단됨)"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फक्त जोडता येते – वाचणे ब्लॉक केलेले"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah Sahaja – bacaan disekat"
          }
