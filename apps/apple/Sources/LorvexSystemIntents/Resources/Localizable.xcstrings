    "system.task.reminders.due.read.description": {
      "comment": "Description for the Read Lorvex Due Task Reminders App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة تذكيرات مهام Lorvex التي حان موعدها وما زالت قيد الانتظار."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read pending Lorvex task reminders that are due."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee los recordatorios pendientes de tareas de Lorvex cuya hora ya ha llegado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit les rappels de tâches de Lorvex en attente qui sont échus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex कार्यों के वे लंबित रिमाइंडर पढ़ें जिनका समय हो चुका है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge i promemoria in sospeso delle attività di Lorvex che sono scaduti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻になった、保留中のLorvexのタスクのリマインダーを読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간이 된 대기 중인 Lorvex 할 일 알림을 읽습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytuje oczekujące przypomnienia zadań Lorvex, których czas już nadszedł."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê os lembretes pendentes de tarefas do Lorvex que estão vencidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает ожидающие напоминания задач Lorvex, время которых уже наступило."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читає очікувані нагадування завдань Lorvex, час яких уже настав."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取已经到期的待处理 Lorvex 任务提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取已到時間、待處理的 Lorvex 任務提醒。"
          }
        }
      }
    },
