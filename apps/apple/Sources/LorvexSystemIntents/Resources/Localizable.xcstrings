    "system.focus_filter.description": {
      "comment": "Description for the Lorvex Focus system Focus Filter",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء تشغيل هذا التركيز، تعرض أدوات Lorvex وApple Watch المهام الموجودة في القوائم التي تختارها فقط."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While this Focus is on, Lorvex’s widgets and Apple Watch show only the tasks in the lists you choose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras este modo de concentración esté activado, los widgets de Lorvex y el Apple Watch solo muestran las tareas de las listas que elijas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que ce mode de concentration est activé, les widgets de Lorvex et l’Apple Watch n’affichent que les tâches des listes que vous choisissez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ोकस चालू रहने पर Lorvex के विजेट और Apple Watch केवल आपकी चुनी हुई सूचियों के कार्य दिखाते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché questa modalità di concentrazione è attiva, i widget di Lorvex e l’Apple Watch mostrano solo le attività delle liste che scegli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この集中モードがオンの間、LorvexのウィジェットとApple Watchには、選択したリストのタスクだけが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 집중 모드가 켜져 있는 동안 Lorvex 위젯과 Apple Watch에는 선택한 목록의 할 일만 표시됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy ten Fokus jest włączony, widżety Lorvex i Apple Watch pokazują tylko zadania z wybranych przez ciebie list."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto este modo de Foco estiver ativado, os widgets do Lorvex e o Apple Watch mostram apenas as tarefas das listas que você escolher."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока включён этот режим фокусирования, виджеты Lorvex и Apple Watch показывают только задачи из выбранных вами списков."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки ввімкнено цей режим фокусування, віджети Lorvex і Apple Watch показують лише завдання з вибраних вами списків."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启此专注模式时，Lorvex 的小组件和 Apple Watch 只显示你所选列表中的任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟此專注模式時，Lorvex 小工具和 Apple Watch 只會顯示你所選清單中的任務。"
          }
        }
      }
    },
