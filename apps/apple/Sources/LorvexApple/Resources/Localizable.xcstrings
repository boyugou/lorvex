            "value": "Серія в тижнях, яку варто відсвяткувати. Звичка триває й після цього."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جشن منانے کے لیے تسلسل، ہفتوں میں۔ عادت اس کے بعد بھی جاری رہتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuỗi cần ăn mừng, tính theo tuần. Thói quen vẫn tiếp tục sau đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连续打卡到这个周数时庆祝一下，之后习惯照常继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要慶祝的連續週數。達成後，習慣仍會持續。"
          }
        }
      }
    },
