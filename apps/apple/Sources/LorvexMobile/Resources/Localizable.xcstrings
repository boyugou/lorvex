        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Moving “%1$@”, “%2$@”, and %3$lld more to tomorrow frees about %4$@."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Moving “%1$@”, “%2$@”, and %3$lld more to tomorrow frees about %4$@."
