          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وارد نمی‌شود (هنوز نمی‌توان با اطمینان بازیابی کرد)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non importé (ne peut pas encore être restauré en toute sécurité)"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא מיובא (עדיין לא ניתן לשחזר בבטחה)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंपोर्ट नहीं होगा (अभी सुरक्षित रूप से रीस्टोर नहीं किया जा सकता)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non importato (non può ancora essere ripristinato in sicurezza)"
          }
