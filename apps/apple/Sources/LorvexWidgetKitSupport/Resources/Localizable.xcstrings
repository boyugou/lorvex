          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Lorvex, aby wczytać nawyki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Lorvex para carregar os hábitos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschideți Lorvex pentru a încărca obiceiurile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Lorvex, чтобы загрузить привычки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Lorvex เพื่อโหลดนิสัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alışkanlıkları yüklemek için Lorvex’i açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте Lorvex, щоб завантажити звички."
