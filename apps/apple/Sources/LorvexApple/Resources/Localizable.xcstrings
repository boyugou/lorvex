            "value": "يذكّرك في اليوم %lld من كل شهر، ويتوقف بمجرد إكمالها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতি মাসের %lld তারিখে মনে করায় এবং সম্পন্ন হলে থেমে যায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnert jeden Monat am %lld. und endet, sobald die Gewohnheit erledigt ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπενθυμίζει την ημέρα %lld κάθε μήνα και σταματά μόλις ολοκληρωθεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminds on day %lld each month, and stops once it’s done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuerda el día %lld de cada mes y se detiene al completarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر ماه در روز %lld یادآوری می‌کند و پس از انجام آن متوقف می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rappelle le jour %lld de chaque mois, et s’arrête dès que c’est fait."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התזכורות מופעלות ביום %lld בכל חודש ונעצרות כשההרגל בוצע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर महीने %lld तारीख़ को याद दिलाता है, और आदत पूरी होते ही रुक जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengingatkan pada tanggal %lld setiap bulan, dan berhenti setelah selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricorda il giorno %lld di ogni mese e si ferma una volta completata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎月%lld日に通知し、完了すると止まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매월 %lld일에 알리며, 완료하면 멈춥니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दर महिन्याच्या %lld तारखेला आठवण करून देतो आणि पूर्ण झाल्यावर थांबतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengingatkan pada tarikh %lld setiap bulan, dan berhenti setelah selesai."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinnert elke maand op dag %lld en stopt zodra de gewoonte is voltooid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomina %lld. dnia każdego miesiąca i kończy się po wykonaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembra no dia %lld de cada mês e para assim que for concluído."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reamintește în ziua %lld a fiecărei luni și se oprește după ce obiceiul este finalizat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминает %lld-го числа каждого месяца и прекращается после выполнения."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மாதந்தோறும் %lldஆம் நாளில் நினைவூட்டும், முடிந்ததும் நிற்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి నెల %lldవ రోజున గుర్తు చేస్తుంది, పూర్తయిన వెంటనే ఆగిపోతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เตือนในวันที่ %lld ของทุกเดือน และหยุดเมื่อทำเสร็จแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ayın %lld. gününde anımsatır; tamamlandığında durur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагадує %lld-го числа кожного місяця й припиняється після виконання."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر مہینے %lld تاریخ کو یاد دلاتی ہے، اور مکمل ہوتے ہی رک جاتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhắc vào ngày %lld mỗi tháng, và dừng khi đã hoàn thành."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每月 %lld 日提醒，完成后即停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每月 %lld 日提醒，完成後就會停止。"
          }
        }
      }
    },
