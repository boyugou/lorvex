    "settings.mcp.connect_blurb": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صُمّم Lorvex ليتولى مساعد معظم العمل: يشغّل عميل الذكاء الاصطناعي لديك البرنامج المساعد المدمج في Lorvex لقراءة المهام والقوائم والعادات والذاكرة والمراجعات وإدخالات التقويم وتحديثها. انسخ موجّه الإعداد إلى المساعدين الذين تثق بهم فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex ist darauf ausgelegt, dass ein Assistent den Großteil der Arbeit übernimmt: Dein KI-Client startet den integrierten Helfer von Lorvex, um Aufgaben, Listen, Gewohnheiten, Gedächtnis, Rückblicke und Kalendereinträge zu lesen und zu aktualisieren. Kopiere den Einrichtungs-Prompt nur in Assistenten, denen du vertraust."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex is built for an assistant to do most of the work: your AI client launches Lorvex’s built-in helper to read and update tasks, lists, habits, memory, reviews, and calendar entries. Copy the setup prompt only into assistants you trust."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex está pensado para que un asistente haga la mayor parte del trabajo: tu cliente de IA inicia el programa auxiliar integrado de Lorvex para leer y actualizar tareas, listas, hábitos, memoria, revisiones y eventos del calendario. Copia el prompt de configuración solo en asistentes de confianza."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه Lorvex طوری ساخته شده که دستیار بیشتر کارها را انجام دهد: کلاینت هوش مصنوعی شما برنامه کمکی داخلی Lorvex را اجرا می‌کند تا کارها، فهرست‌ها، عادت‌ها، حافظه، مرورها و موارد تقویم را بخواند و به‌روزرسانی کند. پرامپت راه‌اندازی را فقط در دستیارهایی کپی کنید که به آن‌ها اعتماد دارید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex est conçu pour qu’un assistant fasse l’essentiel du travail : votre client d’IA lance l’utilitaire intégré de Lorvex pour lire et mettre à jour les tâches, listes, habitudes, la mémoire, les bilans et les événements du calendrier. Ne copiez l’invite de configuration que dans des assistants de confiance."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפליקציית Lorvex נבנתה כך שהעוזר יבצע את רוב העבודה: לקוח ה-AI שלך מפעיל את כלי העזר המובנה של Lorvex כדי לקרוא ולעדכן משימות, רשימות, הרגלים, זיכרון, סקירות ורשומות לוח שנה. יש להעתיק את הנחיית ההגדרה רק אל עוזרים שסומכים עליהם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex इस तरह बना है कि ज़्यादातर काम असिस्टेंट करे: आपका AI क्लाइंट Lorvex का बिल्ट-इन हेल्पर चलाकर कार्य, सूचियाँ, आदतें, मेमोरी, समीक्षाएँ और कैलेंडर एंट्री पढ़ता और अपडेट करता है। सेटअप प्रॉम्प्ट केवल उन असिस्टेंट में कॉपी करें जिन पर आप भरोसा करते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex è pensato perché sia un assistente a svolgere gran parte del lavoro: il tuo client IA avvia l’helper integrato di Lorvex per leggere e aggiornare attività, liste, abitudini, memoria, revisioni ed eventi del calendario. Copia il prompt di configurazione solo in assistenti di cui ti fidi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexは、作業の大部分をアシスタントが行うことを前提に作られています。AIクライアントがLorvex内蔵のヘルパーを起動して、タスク、リスト、習慣、メモリ、振り返り、カレンダーの項目を読み取ったり更新したりします。セットアップ用のプロンプトは、信頼できるアシスタントにのみコピーしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex는 어시스턴트가 대부분의 작업을 처리하도록 만들어졌습니다. AI 클라이언트가 Lorvex에 내장된 도우미를 실행하여 할 일, 목록, 습관, 메모리, 회고, 캘린더 항목을 읽고 업데이트합니다. 설정 프롬프트는 신뢰하는 어시스턴트에만 복사하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex is gebouwd om een assistent het meeste werk te laten doen: je AI-client start de ingebouwde helper van Lorvex om taken, lijsten, gewoontes, geheugen, terugblikken en agenda-activiteiten te lezen en bij te werken. Kopieer de configuratieprompt alleen naar assistenten die je vertrouwt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex został zaprojektowany tak, aby większość pracy wykonywał asystent: twój klient AI uruchamia wbudowaną aplikację pomocniczą Lorvex, aby odczytywać i aktualizować zadania, listy, nawyki, pamięć, podsumowania i wydarzenia kalendarza. Kopiuj prompt konfiguracji tylko do asystentów, którym ufasz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lorvex foi feito para que um assistente faça a maior parte do trabalho: seu cliente de IA inicia o utilitário integrado do Lorvex para ler e atualizar tarefas, listas, hábitos, memória, revisões e eventos do calendário. Copie o prompt de configuração apenas em assistentes em que você confia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex este conceput pentru ca un asistent să facă cea mai mare parte a muncii: clientul AI pornește programul auxiliar încorporat al Lorvex pentru a citi și a actualiza sarcini, liste, obiceiuri, memorie, recapitulări și evenimente din calendar. Copiați promptul de configurare doar în asistenți în care aveți încredere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex создан так, чтобы основную работу выполнял ассистент: ваш ИИ-клиент запускает встроенную вспомогательную программу Lorvex, чтобы читать и обновлять задачи, списки, привычки, память, итоги и события календаря. Копируйте промпт настройки только в тех ассистентов, которым доверяете."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex створено так, щоб основну роботу виконував асистент: ваш ШІ-клієнт запускає вбудовану допоміжну програму Lorvex, щоб читати й оновлювати завдання, списки, звички, пам’ять, підсумки та події календаря. Копіюйте промпт налаштування лише в тих асистентів, яким довіряєте."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ایپ اس طرح بنائی گئی ہے کہ زیادہ تر کام اسسٹنٹ کرے: آپ کا AI کلائنٹ Lorvex کا بلٹ اِن ہیلپر چلاتا ہے تاکہ کام، فہرستیں، عادات، حافظہ، جائزے اور کیلنڈر اندراجات پڑھ اور اپ ڈیٹ کر سکے۔ سیٹ اپ پرامپٹ صرف انہی اسسٹنٹس میں کاپی کریں جن پر آپ بھروسا کرتے ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 的设计是让助手完成大部分工作：你的 AI 客户端会启动 Lorvex 内置助手，读取和更新任务、列表、习惯、记忆、回顾和日历条目。请仅将设置提示词复制到你信任的助手中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 的設計理念是讓助理處理大部分的工作：你的 AI 用戶端會啟動 Lorvex 內建的輔助程式，來讀取與更新任務、清單、習慣、記憶、回顧和行事曆項目。請只將設定提示拷貝到你信任的助理中。"
          }
        }
      }
    },
