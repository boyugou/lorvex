            "state": "translated",
            "value": "Yüksek öncelikli görev yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає завдань з високим пріоритетом"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی اعلیٰ ترجیح والا کام نہیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có nhiệm vụ có mức ưu tiên cao"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有高优先级的任务"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有高優先順序的任務"
          }
        }
      }
    },
    "tasks.empty.scheduled.message": {
      "comment": "Empty-state message of the Scheduled collection in the Tasks tab; says which tasks the collection holds.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا المهام غير المكتملة التي لها تاريخ استحقاق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শেষ তারিখ আছে এমন বাকি টাস্কগুলি এখানে দেখা যায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offene Aufgaben mit Fälligkeitsdatum erscheinen hier."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ανοιχτές εργασίες που έχουν προθεσμία εμφανίζονται εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open tasks that have a due date appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas pendientes con fecha de vencimiento aparecen aquí."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارهای باز دارای تاریخ سررسید در اینجا نمایش داده می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches à faire qui ont une échéance apparaissent ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משימות פתוחות עם תאריך יעד מופיעות כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नियत तिथि वाले लंबित कार्य यहाँ दिखते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas yang belum selesai dan memiliki tanggal jatuh tempo muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le attività da fare con una scadenza appaiono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限が設定された未完了のタスクは、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기한이 있는 미완료 할 일이 여기에 표시됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "देय दिनांक असलेली प्रलंबित कार्ये येथे दिसतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas yang belum selesai dan mempunyai tarikh jangka dipaparkan di sini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open taken met een vervaldatum verschijnen hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadania do zrobienia z terminem pojawiają się tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas pendentes com prazo aparecem aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarcinile de făcut care au o scadență apar aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появляются невыполненные задачи, у которых есть срок."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காலக்கெடு தேதி உள்ள நிலுவைப் பணிகள் இங்கே தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గడువు తేదీ ఉన్న పెండింగ్ టాస్క్‌లు ఇక్కడ కనిపిస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานที่ยังไม่เสร็จและมีวันถึงกำหนดจะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son tarihi olan açık görevler burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут з’являються невиконані завдання, які мають термін."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقررہ تاریخ والے نامکمل کام یہاں نظر آتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các nhiệm vụ chưa hoàn thành có ngày đến hạn xuất hiện tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置了截止日期的未完成任务会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定了到期日的未完成任務會顯示在這裡。"
          }
        }
      }
    },
    "tasks.empty.scheduled.title": {
      "comment": "Empty-state title of the Scheduled collection in the Tasks tab (open tasks that have a due date). Shown both when no task is open and when open tasks exist but none has a due date, so it names what the collection holds.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مهام مجدولة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো নির্ধারিত টাস্ক নেই"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine geplanten Aufgaben"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καμία προγραμματισμένη εργασία"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Scheduled Tasks"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay tareas planificadas"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کار زمان‌بندی‌شده‌ای نیست"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune tâche planifiée"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין משימות מתוזמנות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई शेड्यूल किया गया कार्य नहीं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
