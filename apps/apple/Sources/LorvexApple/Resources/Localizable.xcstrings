        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xóa “%1$@” khi danh sách vẫn còn %2$lld nhiệm vụ. Hãy lưu trữ để danh sách ngừng hoạt động mà vẫn giữ nhiệm vụ và lịch sử. Bạn có thể bỏ lưu trữ bất cứ lúc nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”仍有 %2$lld 项任务，无法删除。可改为归档，保留任务和历史记录的同时将其收起。你之后可以取消归档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」仍有 %2$lld 個任務，因此無法刪除。你可以改為封存這份清單：清單會被收起，但其中的任務與歷史紀錄都會保留。之後也可以取消封存。"
          }
        }
      }
