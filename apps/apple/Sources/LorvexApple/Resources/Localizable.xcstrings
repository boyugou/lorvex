    "settings.calendar.access.off_detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتم قراءة أي أحداث تقويم في Lorvex."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যালেন্ডারের কোনো ইভেন্ট Lorvex-এ পড়া হয় না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden keine Kalenderereignisse in Lorvex eingelesen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν διαβάζονται γεγονότα ημερολογίου στο Lorvex."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No calendar events are read into Lorvex."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex no lee ningún evento de calendario."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ رویداد تقویمی در Lorvex خوانده نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun événement du calendrier n’est lu dans Lorvex."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נקראים אירועי לוח שנה אל Lorvex."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई कैलेंडर इवेंट Lorvex में नहीं पढ़ा जाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada acara kalender yang dibaca ke dalam Lorvex."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun evento del calendario viene letto in Lorvex."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーイベントはLorvexに読み込まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 이벤트를 Lorvex로 읽어 오지 않습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दिनदर्शिकेतील कोणतेही इव्हेंट Lorvex मध्ये वाचले जात नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada peristiwa kalendar dibaca ke dalam Lorvex."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er worden geen agenda-activiteiten in Lorvex ingelezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydarzenia z kalendarza nie są odczytywane w Lorvex."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum evento do calendário é lido no Lorvex."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Niciun eveniment din calendar nu este citit în Lorvex."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "События календаря не считываются в Lorvex."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีการอ่านกิจกรรมปฏิทินเข้า Lorvex"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex’e hiçbir takvim etkinliği okunmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Події календаря не зчитуються в Lorvex."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی کیلنڈر ایونٹ Lorvex میں نہیں پڑھا جاتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có sự kiện lịch nào được đọc vào Lorvex."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会将日历事件读入 Lorvex。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會將行事曆事件讀取到 Lorvex 中。"
