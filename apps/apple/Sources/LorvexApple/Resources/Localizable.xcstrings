    "calendar.create_event.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع موعدًا حقيقيًا على الجدول الزمني للتقويم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যালেন্ডারের টাইমলাইনে একটি আসল অ্যাপয়েন্টমেন্ট রাখুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage einen echten Termin in die Zeitleiste des Kalenders ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τοποθετήστε ένα πραγματικό ραντεβού στο χρονολόγιο του ημερολογίου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place a real appointment on the calendar timeline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca una cita real en la línea de tiempo del calendario."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک قرار واقعی را روی خط زمانی تقویم قرار دهید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez un vrai rendez-vous dans la chronologie du calendrier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוספת פגישה אמיתית לציר הזמן של לוח השנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलेंडर टाइमलाइन पर कोई वास्तविक अपॉइंटमेंट रखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempatkan janji temu yang sebenarnya di lini masa kalender."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un vero appuntamento nella timeline del calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際の予定をカレンダーのタイムラインに追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 약속을 캘린더 타임라인에 배치합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दिनदर्शिकेच्या टाइमलाइनवर खरी अपॉइंटमेंट ठेवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Letakkan temu janji sebenar pada garis masa kalendar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet een echte afspraak op de tijdlijn van je agenda."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Umieść na osi czasu kalendarza prawdziwe spotkanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque um compromisso real na linha do tempo do calendário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Plasați o programare reală pe cronologia calendarului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте на временную шкалу календаря реальную встречу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางนัดหมายจริงบนไทม์ไลน์ของปฏิทิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvimin zaman çizelgesine gerçek bir randevu ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте на часову шкалу календаря реальну зустріч."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیلنڈر کی ٹائم لائن پر ایک حقیقی اپائنٹمنٹ رکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt một cuộc hẹn thật lên dòng thời gian của lịch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在日历时间轴上添加一个真实的日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在行事曆時間軸上放入一個實際的約會。"
          }
        }
      }
    },
    "calendar.create_event.needs_title.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف عنوانًا لإنشاء هذا الحدث"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ইভেন্ট তৈরি করতে একটি শিরোনাম যোগ করুন"
