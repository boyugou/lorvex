        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכותרת הזו ארוכה מדי. יש לקצר אותה ולנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह शीर्षक बहुत लंबा है। इसे छोटा करके फिर से कोशिश करें।"
          }
