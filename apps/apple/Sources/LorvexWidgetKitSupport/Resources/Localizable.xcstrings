            "value": "Lihat tugas hari ini dengan sekali pandang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zie je taken van vandaag in één oogopslag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzisiejsze zadania na pierwszy rzut oka."
          }
        },
        "pt-BR": {
          "stringUnit": {
