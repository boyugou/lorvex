    "setup.sync.devices.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى مهامك وقوائمك وعاداتك متطابقة على iPhone وiPad وMac."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone, iPad ও Mac-এ আপনার টাস্ক, তালিকা ও অভ্যাস সিঙ্ক করা থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Aufgaben, Listen und Gewohnheiten bleiben auf iPhone, iPad und Mac auf demselben Stand."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εργασίες, οι λίστες και οι συνήθειές σας παραμένουν συγχρονισμένες σε iPhone, iPad και Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tasks, lists, and habits stay in step on iPhone, iPad, and Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus tareas, listas y hábitos se mantienen al día en el iPhone, el iPad y el Mac."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارها، فهرست‌ها و عادت‌های شما در iPhone، iPad و Mac هماهنگ می‌مانند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos tâches, listes et habitudes restent synchronisées sur iPhone, iPad et Mac."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשימות, הרשימות וההרגלים שלך נשארים מסונכרנים ב-iPhone, ב-iPad וב-Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके कार्य, सूचियाँ और आदतें iPhone, iPad और Mac पर एक साथ अपडेट रहती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas, daftar, dan kebiasaan tetap selaras di iPhone, iPad, dan Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue attività, liste e abitudini restano allineate su iPhone, iPad e Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスク、リスト、習慣は、iPhone、iPad、Macで同じ状態に保たれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일, 목록, 습관이 iPhone, iPad, Mac에서 항상 동일하게 유지됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone, iPad आणि Mac वर तुमची कार्ये, याद्या आणि सवयी सिंकमध्ये राहतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas, senarai dan tabiat kekal selaras pada iPhone, iPad dan Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je taken, lijsten en gewoontes blijven op iPhone, iPad en Mac gelijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadania, listy i nawyki są takie same na iPhonie, iPadzie i Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas tarefas, listas e hábitos ficam em sincronia no iPhone, no iPad e no Mac."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarcinile, listele și obiceiurile se mențin sincronizate pe iPhone, iPad și Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задачи, списки и привычки совпадают на iPhone, iPad и Mac."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பணிகள், பட்டியல்கள், பழக்கங்கள் iPhone, iPad, Mac ஆகிய அனைத்திலும் ஒத்திசைந்திருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ టాస్క్‌లు, జాబితాలు, అలవాట్లు iPhone, iPad, Mac అన్నింటిలో సింక్ అయి ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งาน ลิสต์ และนิสัยของคุณตรงกันทั้งบน iPhone, iPad และ Mac"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone’unuzda, iPad’inizde ve Mac’inizde görevleriniz, listeleriniz ve alışkanlıklarınız hep aynı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завдання, списки й звички збігаються на iPhone, iPad та Mac."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے کام، فہرستیں اور عادات iPhone، iPad اور Mac پر ہم آہنگ رہتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhiệm vụ, danh sách và thói quen luôn đồng bộ trên iPhone, iPad và Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务、列表和习惯在 iPhone、iPad 和 Mac 上同步更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的任務、清單和習慣會在 iPhone、iPad 和 Mac 上保持同步。"
          }
        }
      }
    },
