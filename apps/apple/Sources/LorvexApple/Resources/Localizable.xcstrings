    "list_row.archive.nonempty_count_message": {
      "comment": "Message of the dialog that offers to archive a list that still holds tasks, since only an empty list can be deleted. 1: the list name. 2: how many tasks it holds.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لا يمكن حذف \"%1$@\" ما دامت تحتوي على %2$lld مهام. أرشفها بدلًا من ذلك لإنهاء استخدامها مع الاحتفاظ بمهامها وسجلها. يمكنك إلغاء الأرشفة لاحقًا."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لا يمكن حذف \"%1$@\" ما دامت تحتوي على %2$lld مهمة. أرشفها بدلًا من ذلك لإنهاء استخدامها مع الاحتفاظ بمهامها وسجلها. يمكنك إلغاء الأرشفة لاحقًا."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لا يمكن حذف \"%1$@\" ما دامت تحتوي على مهمة واحدة. أرشفها بدلًا من ذلك لإنهاء استخدامها مع الاحتفاظ بمهامها وسجلها. يمكنك إلغاء الأرشفة لاحقًا."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لا يمكن حذف \"%1$@\" ما دامت تحتوي على %2$lld مهمة. أرشفها بدلًا من ذلك لإنهاء استخدامها مع الاحتفاظ بمهامها وسجلها. يمكنك إلغاء الأرشفة لاحقًا."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لا يمكن حذف \"%1$@\" ما دامت تحتوي على مهمتين. أرشفها بدلًا من ذلك لإنهاء استخدامها مع الاحتفاظ بمهامها وسجلها. يمكنك إلغاء الأرشفة لاحقًا."
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لا يمكن حذف \"%1$@\" ما دامت تحتوي على %2$lld مهمة. أرشفها بدلًا من ذلك لإنهاء استخدامها مع الاحتفاظ بمهامها وسجلها. يمكنك إلغاء الأرشفة لاحقًا."
                }
              }
            }
          }
        },
        "bn": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "“%1$@” তালিকায় এখনও %2$lldটি টাস্ক রয়েছে, তাই এটি ডিলিট করা যাবে না। এর বদলে আর্কাইভ করুন; এতে তালিকাটি সরে যাবে, কিন্তু টাস্ক ও হিস্ট্রি থেকে যাবে। পরে আনআর্কাইভ করতে পারবেন।"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "“%1$@” তালিকায় এখনও %2$lldটি টাস্ক রয়েছে, তাই এটি ডিলিট করা যাবে না। এর বদলে আর্কাইভ করুন; এতে তালিকাটি সরে যাবে, কিন্তু টাস্ক ও হিস্ট্রি থেকে যাবে। পরে আনআর্কাইভ করতে পারবেন।"
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Die Liste „%1$@“ kann nicht gelöscht werden, solange sie noch %2$lld Aufgabe enthält. Archiviere sie stattdessen, um sie beiseitezulegen und ihre Aufgaben und ihren Verlauf zu behalten. Du kannst die Archivierung später aufheben."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Die Liste „%1$@“ kann nicht gelöscht werden, solange sie noch %2$lld Aufgaben enthält. Archiviere sie stattdessen, um sie beiseitezulegen und ihre Aufgaben und ihren Verlauf zu behalten. Du kannst die Archivierung später aufheben."
                }
              }
            }
          }
        },
        "el": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Η λίστα «%1$@» δεν μπορεί να διαγραφεί ενώ περιέχει ακόμη %2$lld εργασία. Αρχειοθετήστε την αντί για διαγραφή. Οι εργασίες και το ιστορικό της διατηρούνται. Μπορείτε να καταργήσετε την αρχειοθέτηση αργότερα."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Η λίστα «%1$@» δεν μπορεί να διαγραφεί ενώ περιέχει ακόμη %2$lld εργασίες. Αρχειοθετήστε την αντί για διαγραφή. Οι εργασίες και το ιστορικό της διατηρούνται. Μπορείτε να καταργήσετε την αρχειοθέτηση αργότερα."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "“%1$@” can’t be deleted while it still holds %2$lld task. Archive it instead to retire it while keeping its tasks and history. You can unarchive it later."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "“%1$@” can’t be deleted while it still holds %2$lld tasks. Archive it instead to retire it while keeping its tasks and history. You can unarchive it later."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "“%1$@” no se puede eliminar mientras contenga %2$lld tarea. Archívala para retirarla sin perder sus tareas ni su historial. Puedes desarchivarla más adelante."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "“%1$@” no se puede eliminar mientras contenga %2$lld tareas. Archívala para retirarla sin perder sus tareas ni su historial. Puedes desarchivarla más adelante."
                }
              }
            }
          }
        },
        "fa": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "«%1$@» تا زمانی که %2$lld کار دارد قابل حذف نیست. به‌جای آن، فهرست را بایگانی کنید تا بدون از دست رفتن کارها و تاریخچه‌اش کنار گذاشته شود. بعداً می‌توانید آن را از بایگانی خارج کنید."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "«%1$@» تا زمانی که %2$lld کار دارد قابل حذف نیست. به‌جای آن، فهرست را بایگانی کنید تا بدون از دست رفتن کارها و تاریخچه‌اش کنار گذاشته شود. بعداً می‌توانید آن را از بایگانی خارج کنید."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "« %1$@ » ne peut pas être supprimée tant qu’elle contient encore %2$lld tâche. Archivez-la plutôt pour la retirer tout en conservant ses tâches et son historique. Vous pourrez la désarchiver plus tard."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "« %1$@ » ne peut pas être supprimée tant qu’elle contient encore %2$lld tâches. Archivez-la plutôt pour la retirer tout en conservant ses tâches et son historique. Vous pourrez la désarchiver plus tard."
                }
              }
            }
          }
        },
        "he": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "אי אפשר למחוק את \"%1$@\" כל עוד יש בה משימה אחת. אפשר להעביר אותה לארכיון כדי להוציא אותה משימוש תוך שמירת המשימות וההיסטוריה שלה. אפשר להוציא אותה מהארכיון מאוחר יותר."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "אי אפשר למחוק את \"%1$@\" כל עוד יש בה %2$lld משימות. אפשר להעביר אותה לארכיון כדי להוציא אותה משימוש תוך שמירת המשימות וההיסטוריה שלה. אפשר להוציא אותה מהארכיון מאוחר יותר."
                }
              }
            }
          }
        },
        "hi": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "“%1$@” में अभी %2$lld कार्य है, इसलिए उसे हटाया नहीं जा सकता। इसके बजाय उसे संग्रहीत करें; इससे सूची हट जाती है, पर उसके कार्य और इतिहास बने रहते हैं। आप उसे बाद में संग्रह से निकाल सकते हैं।"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "“%1$@” में अभी %2$lld कार्य हैं, इसलिए उसे हटाया नहीं जा सकता। इसके बजाय उसे संग्रहीत करें; इससे सूची हट जाती है, पर उसके कार्य और इतिहास बने रहते हैं। आप उसे बाद में संग्रह से निकाल सकते हैं।"
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "“%1$@” में अभी %2$lld कार्य हैं, इसलिए उसे हटाया नहीं जा सकता। इसके बजाय उसे संग्रहीत करें; इससे सूची हट जाती है, पर उसके कार्य और इतिहास बने रहते हैं। आप उसे बाद में संग्रह से निकाल सकते हैं।"
                }
              }
            }
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” tidak dapat dihapus selama masih berisi %2$lld tugas. Arsipkan saja agar daftar ini tidak lagi aktif, dengan tugas dan riwayatnya tetap tersimpan. Pengarsipan dapat dibatalkan kapan saja."
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "“%1$@” non può essere eliminata finché contiene ancora %2$lld attività. Archiviala invece per metterla da parte mantenendo le sue attività e la sua cronologia. Potrai rimuoverla dall’archivio in seguito."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "“%1$@” non può essere eliminata finché contiene ancora %2$lld attività. Archiviala invece per metterla da parte mantenendo le sue attività e la sua cronologia. Potrai rimuoverla dall’archivio in seguito."
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」には%2$lld件のタスクが残っているため、削除できません。代わりにアーカイブすると、リストは片づけられ、タスクと履歴は残ります。あとからアーカイブを解除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”에 할 일이 %2$lld개 남아 있어 삭제할 수 없습니다. 대신 보관하면 목록은 정리되고 할 일과 기록은 그대로 남습니다. 나중에 보관을 해제할 수 있습니다."
          }
        },
        "mr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "‘%1$@’ या यादीमध्ये अजूनही %2$lld कार्य आहे, त्यामुळे ती हटवता येत नाही. त्याऐवजी संग्रहण करा; यामुळे यादी बाजूला होते, पण तिची कार्ये आणि हिस्ट्री राहते. तुम्ही नंतर संग्रहण रद्द करू शकता."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "‘%1$@’ या यादीमध्ये अजूनही %2$lld कार्ये आहेत, त्यामुळे ती हटवता येत नाही. त्याऐवजी संग्रहण करा; यामुळे यादी बाजूला होते, पण तिची कार्ये आणि हिस्ट्री राहते. तुम्ही नंतर संग्रहण रद्द करू शकता."
                }
              }
            }
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” tidak dapat dipadam selagi masih mengandungi %2$lld tugas. Arkibkan sahaja supaya senarai ini tidak lagi aktif, dengan tugas dan sejarahnya kekal tersimpan. Pengarkiban boleh dibatalkan pada bila-bila masa."
          }
        },
        "nl": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "De lijst ‘%1$@’ kan niet worden verwijderd zolang er nog %2$lld taak in staat. Archiveer de lijst in plaats daarvan om haar terzijde te leggen en de taken en de geschiedenis te bewaren. Je kunt de lijst later weer uit het archief halen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "De lijst ‘%1$@’ kan niet worden verwijderd zolang er nog %2$lld taken in staan. Archiveer de lijst in plaats daarvan om haar terzijde te leggen en de taken en de geschiedenis te bewaren. Je kunt de lijst later weer uit het archief halen."
                }
              }
            }
          }
        },
        "pl": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Listy „%1$@” nie można usunąć, dopóki zawiera jeszcze %2$lld zadania. Zarchiwizuj ją, aby wycofać listę, zachowując zadania i historię. Później możesz ją przywrócić z archiwum."
                }
              },
              "many": {
