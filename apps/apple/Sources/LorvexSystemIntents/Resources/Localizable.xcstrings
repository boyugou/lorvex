          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memadamkan salah satu peringatan tabiat Lorvex."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert een van de herinneringen van een Lorvex-gewoonte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa jedno z przypomnień dla nawyku Lorvex."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclui um dos lembretes de um hábito do Lorvex."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șterge unul dintre mementourile unui obicei Lorvex."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет одно из напоминаний для привычки Lorvex."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex பழக்கத்தின் நினைவூட்டல்களில் ஒன்றை நீக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex అలవాటు రిమైండర్‌లలో ఒకదాన్ని డిలీట్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบเตือนความจำหนึ่งรายการของนิสัย Lorvex"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
