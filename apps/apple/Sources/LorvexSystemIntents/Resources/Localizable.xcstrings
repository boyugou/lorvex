    "system.task.reminder.remove.description": {
      "comment": "Description for the Remove Lorvex Task Reminder App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة تذكير واحد من مهمة في Lorvex."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি Lorvex টাস্ক থেকে একটি রিমাইন্ডার অপসারণ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt eine Erinnerung aus einer Lorvex-Aufgabe."
          }
