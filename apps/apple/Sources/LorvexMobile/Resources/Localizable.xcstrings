    "tasks.lists.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط ＋ لتجميع المهام المترابطة في قائمة، أو اطلب من مساعدك ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সম্পর্কিত টাস্কগুলি একটি তালিকায় গুছিয়ে রাখতে ＋ ট্যাপ করুন – অথবা আপনার অ্যাসিস্ট্যান্টকে বলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf ＋, um zusammengehörige Aufgaben in einer Liste zu gruppieren – oder bitte deinen Assistenten darum."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε ＋ για να ομαδοποιήσετε σχετικές εργασίες σε μια λίστα ή ζητήστε το από τον βοηθό σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap ＋ to group related tasks into a list — or ask your assistant to."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca ＋ para agrupar tareas relacionadas en una lista, o pídeselo a tu asistente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای گروه‌بندی کارهای مرتبط در یک فهرست، روی ＋ ضربه بزنید — یا از دستیارتان بخواهید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez ＋ pour regrouper des tâches liées dans une liste, ou demandez à votre assistant de le faire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להקיש על ＋ כדי לקבץ משימות קשורות לרשימה — או לבקש זאת מהעוזר שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संबंधित कार्यों को एक सूची में रखने के लिए ＋ पर टैप करें, या अपने असिस्टेंट से कहें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk ＋ untuk mengelompokkan tugas terkait ke dalam daftar – atau minta asisten melakukannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca ＋ per raggruppare attività correlate in una lista oppure chiedi al tuo assistente di farlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "＋をタップして、関連するタスクをリストにまとめましょう。アシスタントに頼むこともできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "＋ 버튼을 탭하여 관련 할 일을 목록으로 묶어 보세요. 어시스턴트에게 요청할 수도 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "संबंधित कार्ये एका यादीत गटबद्ध करण्यासाठी ＋ टॅप करा – किंवा तुमच्या सहाय्यकाला सांगा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik ＋ untuk mengumpulkan tugas berkaitan ke dalam senarai – atau minta pembantu AI melakukannya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op ＋ om gerelateerde taken in een lijst te groeperen – of vraag het je assistent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij ＋, aby zgrupować powiązane zadania na liście — albo poproś o to asystenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em ＋ para agrupar tarefas relacionadas em uma lista ou peça ao seu assistente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți ＋ pentru a grupa sarcinile înrudite într-o listă – sau rugați asistentul să o facă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь ＋, чтобы объединить связанные задачи в список. Или попросите об этом ассистента."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடர்புடைய பணிகளை ஒரு பட்டியலில் குழுவாக்க ＋ தட்டவும் – அல்லது உங்கள் அசிஸ்டென்ட்டிடம் கேட்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సంబంధిత టాస్క్‌లను ఒక జాబితాలో గ్రూప్ చేయడానికి ＋ ట్యాప్ చేయండి – లేదా మీ అసిస్టెంట్‌ను అడగండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะ ＋ เพื่อจัดงานที่เกี่ยวข้องกันเป็นลิสต์ หรือขอให้ผู้ช่วยทำให้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlgili görevleri bir listede toplamak için ＋ simgesine dokunun ya da asistanınızdan bunu yapmasını isteyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніть ＋, щоб об’єднати пов’язані завдання в список. Або попросіть про це асистента."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "متعلقہ کاموں کو ایک فہرست میں گروپ کرنے کے لیے ＋ پر ٹیپ کریں — یا اپنے اسسٹنٹ سے کہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm ＋ để gom các nhiệm vụ liên quan vào một danh sách – hoặc nhờ trợ lý làm việc đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按 ＋ 把相关任务归入一个列表，或让助手代劳。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下 ＋ 將相關的任務整理成清單，也可以請助理代勞。"
          }
        }
      }
    },
