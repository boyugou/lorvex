          "stringUnit": {
            "state": "translated",
            "value": "یا اپنے اسسٹنٹ سے شامل کروائیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoặc để trợ lý thêm giúp"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "或者交给助手"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "或讓助理代為新增"
          }
        }
      }
    },
    "setup.done.assistant.detail": {
      "comment": "Simplified Chinese deliberately names no assistant product here (China mainland App Store review); other languages may name Claude as the example.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اربط Claude أو مساعدًا آخر من إعدادات Lorvex على جهاز Mac، وسيضيف المهام ويخطط يومك معك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার Mac-এ Lorvex-এর সেটিংসে Claude বা অন্য কোনো অ্যাসিস্ট্যান্ট কানেক্ট করুন; সেটি আপনার সাথে টাস্ক যোগ করবে ও দিন প্ল্যান করবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde Claude oder einen anderen Assistenten in den Lorvex-Einstellungen auf deinem Mac, und er fügt Aufgaben hinzu und plant deinen Tag mit dir."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδέστε το Claude ή έναν άλλο βοηθό από τις ρυθμίσεις του Lorvex στο Mac σας και θα προσθέτει εργασίες και θα προγραμματίζει την ημέρα σας μαζί σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect Claude or another assistant in Lorvex’s settings on your Mac, and it adds tasks and plans your day with you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta Claude u otro asistente en los ajustes de Lorvex en tu Mac y añadirá tareas y planificará tu día contigo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در تنظیمات Lorvex روی Mac خود، Claude یا دستیار دیگری را وصل کنید تا کارها را اضافه کند و روزتان را با شما برنامه‌ریزی کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez Claude ou un autre assistant dans les réglages de Lorvex sur votre Mac : il ajoute des tâches et planifie votre journée avec vous."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לחבר את Claude או עוזר אחר בהגדרות של Lorvex ב-Mac שלך, והוא יוסיף משימות ויתכנן איתך את היום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने Mac पर Lorvex की सेटिंग्ज़ में Claude या कोई दूसरा असिस्टेंट जोड़ें, और वह कार्य जोड़ेगा तथा आपके साथ आपका दिन प्लान करेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan Claude atau asisten lain di pengaturan Lorvex pada Mac Anda, dan asisten itu akan menambahkan tugas serta merencanakan hari bersama Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega Claude o un altro assistente nelle impostazioni di Lorvex sul tuo Mac e aggiungerà attività e pianificherà la tua giornata con te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac版Lorvexの設定でClaudeなどのアシスタントを接続すると、アシスタントがタスクを追加し、一緒に1日を計画してくれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 Lorvex 설정에서 Claude 또는 다른 어시스턴트를 연결하면 할 일을 추가하고 함께 하루를 계획해 줍니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या Mac वर Lorvex च्या सेटिंगमध्ये Claude किंवा दुसरा सहाय्यक कनेक्ट करा; तो तुमच्यासोबत कार्ये जोडेल आणि तुमचा दिवस प्लॅन करेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungkan Claude atau pembantu AI yang lain dalam seting Lorvex pada Mac anda, dan ia akan menambah tugas serta merancang hari bersama anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbind Claude of een andere assistent in de Lorvex-instellingen op je Mac, en die voegt taken toe en plant je dag met je mee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz Claude lub innego asystenta w ustawieniach Lorvex na swoim Macu, a będzie dodawać zadania i planować dzień razem z tobą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte o Claude ou outro assistente nos ajustes do Lorvex no seu Mac e ele adiciona tarefas e planeja seu dia com você."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectați Claude sau un alt asistent din configurările Lorvex de pe Mac, iar acesta adaugă sarcini și vă planifică ziua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите Claude или другого ассистента в настройках Lorvex на своём Mac, и он будет добавлять задачи и планировать день вместе с вами."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் Macஇல் Lorvex அமைப்புகளில் Claude அல்லது வேறொரு அசிஸ்டென்ட்டை இணைக்கவும், அது உங்களுடன் சேர்ந்து பணிகளைச் சேர்க்கும், உங்கள் நாளைத் திட்டமிடும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ Macలో Lorvex సెట్టింగ్స్‌లో Claude లేదా మరో అసిస్టెంట్‌ను కనెక్ట్ చేయండి, అది మీతో కలిసి టాస్క్‌లను జోడిస్తుంది, మీ రోజును ప్లాన్ చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อ Claude หรือผู้ช่วยอื่นได้ในการตั้งค่า Lorvex บน Mac ของคุณ แล้วผู้ช่วยจะเพิ่มงานและวางแผนวันของคุณร่วมกับคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’inizde Lorvex ayarlarından Claude’u ya da başka bir asistanı bağlayın; görev ekler ve gününüzü sizinle birlikte planlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключіть Claude або іншого асистента в параметрах Lorvex на своєму Mac, і він додаватиме завдання та плануватиме день разом із вами."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے Mac پر Lorvex کی ترتیبات میں Claude یا کوئی اور اسسٹنٹ جوڑ لیں، وہ کام شامل کرے گا اور آپ کے ساتھ آپ کا دن منصوبہ بنائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy kết nối Claude hoặc một trợ lý khác trong phần cài đặt của Lorvex trên máy Mac của bạn, và trợ lý sẽ cùng bạn thêm nhiệm vụ và lên kế hoạch cho cả ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上的 Lorvex 设置中连接支持 MCP 的 AI 助手，它会替你添加任务，并和你一起规划每一天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上 Lorvex 的設定中連接 Claude 或其他助理後，它就能新增任務，並與你一起規劃一天。"
          }
        }
      }
    },
    "settings.sync.storage_full": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مساحة تخزين iCloud ممتلئة. سيُكمل Lorvex المزامنة عندما تتوفر مساحة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার iCloud স্টোরেজ ভর্তি হয়ে গেছে। জায়গা হলে Lorvex সিঙ্ক শেষ করবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein iCloud-Speicher ist voll. Lorvex schließt die Synchronisierung ab, sobald wieder Platz ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο χώρος αποθήκευσης iCloud σας είναι γεμάτος. Το Lorvex θα ολοκληρώσει τον συγχρονισμό όταν υπάρξει χώρος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iCloud storage is full. Lorvex will finish syncing when there’s space."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu almacenamiento de iCloud está lleno. Lorvex terminará de sincronizar cuando haya espacio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فضای iCloud شما پر است. Lorvex وقتی جا باز شود همگام‌سازی را کامل می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre stockage iCloud est plein. Lorvex terminera la synchronisation dès qu’il y aura de la place."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האחסון ב-iCloud שלך מלא. הסנכרון יושלם כשיתפנה מקום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका iCloud स्टोरेज भर गया है। जगह मिलते ही Lorvex सिंक पूरा कर लेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyimpanan iCloud penuh. Lorvex akan menyelesaikan penyelarasan setelah ada ruang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio di archiviazione iCloud è pieno. Lorvex completerà la sincronizzazione quando ci sarà spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudのストレージがいっぱいです。空き容量ができ次第、Lorvexが同期を完了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 저장 공간이 가득 찼습니다. 공간이 생기면 Lorvex가 동기화를 마무리합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे iCloud स्टोरेज भरले आहे. जागा झाल्यावर सिंक पूर्ण केले जाईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Storan iCloud penuh. Lorvex akan menyelesaikan penyelarasan apabila ada ruang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je iCloud-opslag is vol. Lorvex voltooit de synchronisatie zodra er ruimte is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamięć iCloud jest pełna. Lorvex dokończy synchronizację, gdy zrobi się miejsce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento do iCloud está cheio. O Lorvex concluirá a sincronização quando houver espaço."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spațiul de stocare iCloud este plin. Lorvex va finaliza sincronizarea când va fi din nou loc."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранилище iCloud заполнено. Lorvex завершит синхронизацию, когда появится место."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் iCloud சேமிப்பகம் நிரம்பிவிட்டது. இடம் கிடைக்கும்போது Lorvex ஒத்திசைவை முடிக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ iCloud స్టోరేజ్ నిండింది. స్థలం ఉన్నప్పుడు Lorvex సింక్‌ను పూర్తి చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นที่จัดเก็บ iCloud ของคุณเต็ม Lorvex จะเชื่อมข้อมูลให้เสร็จเมื่อมีพื้นที่ว่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud depolama alanınız dolu. Yer açılınca Lorvex eşzamanlamayı tamamlayacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сховище iCloud заповнене. Lorvex завершить синхронізацію, щойно з’явиться місце."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا iCloud اسٹوریج بھر گیا ہے۔ جگہ ملتے ہی Lorvex سنک مکمل کر لے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dung lượng iCloud đã đầy. Lorvex sẽ hoàn tất đồng bộ hóa khi có chỗ trống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 iCloud 储存空间已满。有空间后，Lorvex 会继续完成同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 iCloud 儲存空間已滿。有空間時，Lorvex 會完成同步。"
          }
        }
      }
    },
