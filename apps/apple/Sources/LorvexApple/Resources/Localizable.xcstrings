    "settings.cloud_sync.off_detail": {
      "comment": "Under the iCloud switch while sync is off.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى مهامك على جهاز Mac هذا. شغّل هذا الخيار لترى المهام والقوائم والعادات نفسها على iPhone وأجهزتك الأخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার টাস্ক শুধু এই Mac-এ থাকে। আপনার iPhone ও অন্যান্য ডিভাইসে একই টাস্ক, তালিকা ও অভ্যাস দেখতে এটি চালু করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Aufgaben bleiben auf diesem Mac. Schalte dies ein, um dieselben Aufgaben, Listen und Gewohnheiten auf deinem iPhone und anderen Geräten zu sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εργασίες σας παραμένουν σε αυτό το Mac. Ενεργοποιήστε το για να βλέπετε τις ίδιες εργασίες, λίστες και συνήθειες στο iPhone και στις άλλες συσκευές σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tasks stay on this Mac. Turn this on to see the same tasks, lists, and habits on your iPhone and other devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus tareas se quedan en este Mac. Activa esta opción para ver las mismas tareas, listas y hábitos en el iPhone y en tus otros dispositivos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارهای شما فقط در همین Mac می‌مانند. این گزینه را روشن کنید تا همین کارها، فهرست‌ها و عادت‌ها را در iPhone و دستگاه‌های دیگرتان ببینید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos tâches restent sur ce Mac. Activez cette option pour retrouver les mêmes tâches, listes et habitudes sur votre iPhone et vos autres appareils."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשימות שלך נשארות ב-Mac הזה. יש להפעיל כדי לראות את אותן משימות, רשימות והרגלים גם ב-iPhone ובמכשירים אחרים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके कार्य इसी Mac पर रहते हैं। अपने iPhone और दूसरे डिवाइस पर वही कार्य, सूचियाँ और आदतें देखने के लिए इसे चालू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas Anda tetap berada di Mac ini. Nyalakan untuk melihat tugas, daftar, dan kebiasaan yang sama di iPhone dan perangkat lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue attività restano su questo Mac. Attiva questa opzione per vedere le stesse attività, liste e abitudini su iPhone e sugli altri dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクはこのMacにのみ保存されます。オンにすると、iPhoneやほかのデバイスでも同じタスク、リスト、習慣を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일은 이 Mac에만 저장됩니다. 켜면 iPhone과 다른 기기에서도 같은 할 일, 목록, 습관을 볼 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची कार्ये फक्त या Mac वर राहतात. तुमच्या iPhone आणि इतर डिव्हाइसवर तीच कार्ये, याद्या आणि सवयी पाहण्यासाठी हे चालू करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas anda kekal pada Mac ini. Aktifkan untuk melihat tugas, senarai dan tabiat yang sama pada iPhone dan peranti lain anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je taken blijven op deze Mac. Schakel dit in om dezelfde taken, lijsten en gewoontes op je iPhone en andere apparaten te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje zadania zostają na tym Macu. Włącz, aby widzieć te same zadania, listy i nawyki na iPhonie i innych urządzeniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas tarefas ficam neste Mac. Ative esta opção para ver as mesmas tarefas, listas e hábitos no seu iPhone e em outros dispositivos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarcinile rămân pe acest Mac. Activați această opțiune pentru a vedea aceleași sarcini, liste și obiceiuri pe iPhone și pe alte dispozitive."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши задачи хранятся только на этом Mac. Включите, чтобы видеть те же задачи, списки и привычки на iPhone и других устройствах."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานของคุณจะอยู่บน Mac เครื่องนี้ เปิดตัวเลือกนี้เพื่อดูงาน ลิสต์ และนิสัยเดียวกันบน iPhone และอุปกรณ์เครื่องอื่นของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görevleriniz bu Mac’te kalır. iPhone’unuzda ve diğer aygıtlarınızda aynı görevleri, listeleri ve alışkanlıkları görmek için bunu açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші завдання зберігаються лише на цьому Mac. Увімкніть, щоб бачити ті самі завдання, списки та звички на iPhone та інших пристроях."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے کام اسی Mac پر رہتے ہیں۔ اپنے iPhone اور دوسری ڈیوائسز پر وہی کام، فہرستیں اور عادات دیکھنے کے لیے اسے آن کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhiệm vụ của bạn vẫn nằm trên máy Mac này. Bật tùy chọn này để xem cùng các nhiệm vụ, danh sách và thói quen trên iPhone và các thiết bị khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务只保存在这台 Mac 上。打开后，iPhone 和其他设备上也会有同样的任务、清单和习惯。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的任務只會留在這部 Mac 上。開啟後，你就能在 iPhone 和其他裝置上看到相同的任務、清單和習慣。"
          }
        }
      }
    },
