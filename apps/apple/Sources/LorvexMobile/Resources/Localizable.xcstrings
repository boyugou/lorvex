    "setup.welcome.today.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما هو مخطط له أو مستحق أو بدأ العمل عليه اليوم، في قائمة واحدة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What’s planned, due, or started today, in one list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo planificado, lo que vence y lo que ya empezaste hoy, en una sola lista."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همه آنچه برای امروز تعیین شده، سررسید دارد یا شروع شده، در یک فهرست."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui est planifié, à échéance ou commencé aujourd’hui, dans une seule liste."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל מה שמתוכנן להיום, שמועד היעד שלו היום או שהתחיל היום — ברשימה אחת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज क्या प्लान है, क्या नियत है और क्या शुरू हुआ है, सब एक सूची में।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che è pianificato, in scadenza o iniziato oggi, in un’unica lista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日予定されているもの、期限のもの、開始したものを、1つのリストにまとめます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 계획되었거나 기한이 되었거나 시작한 일을 하나의 목록에 모아 보여 줍니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadania zaplanowane na dziś, z terminem na dziś lub już rozpoczęte — na jednej liście."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que está planejado, com prazo ou iniciado hoje, em uma só lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задачи, запланированные на сегодня, со сроком сегодня или уже начатые, — в одном списке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завдання, заплановані на сьогодні, з терміном на сьогодні або вже розпочаті, — в одному списку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج کے لیے جو کچھ طے ہے، مقرر ہے یا شروع ہو چکا ہے، سب ایک ہی فہرست میں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天计划做的、到期的和已开始的事，都在一个列表里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天安排好的、到期的或已開始的任務，全都集中在一份清單裡。"
          }
        }
      }
    },
    "setup.welcome.control.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لك الكلمة الأخيرة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have the last word"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú tienes la última palabra"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حرف آخر با شماست"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez le dernier mot"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המילה האחרונה שלך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आख़िरी फ़ैसला आपका"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ultima parola è tua"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終判断はあなたに"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최종 결정은 직접 하세요"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnie słowo należy do ciebie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A palavra final é sua"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последнее слово за вами"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Останнє слово за вами"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آخری فیصلہ آپ کا"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最终由你决定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最後由你決定"
          }
        }
      }
    },
    "setup.welcome.control.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقترح مساعدك ويخطط، وأنت تقرر ما يبقى في قائمتك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your assistant suggests and plans; you decide what stays on your list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu asistente sugiere y planifica; tú decides qué se queda en tu lista."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دستیارتان پیشنهاد می‌دهد و برنامه می‌ریزد؛ شما تصمیم می‌گیرید چه چیزی در فهرستتان بماند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre assistant suggère et planifie ; c’est vous qui décidez de ce qui reste dans votre liste."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העוזר מציע ומתכנן, וההחלטה מה יישאר ברשימה היא שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका असिस्टेंट सुझाव देता है और प्लान करता है; आपकी सूची में क्या रहे, यह आप तय करते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo assistente suggerisce e pianifica; sei tu a decidere cosa resta nella tua lista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "提案と計画はアシスタントが行い、リストに残すものはあなたが決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어시스턴트가 제안하고 계획하며, 목록에 무엇을 남길지는 직접 결정합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Asystent proponuje i planuje, a ty decydujesz, co zostanie na liście."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu assistente sugere e planeja; você decide o que fica na sua lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ассистент предлагает и планирует, а вы решаете, что останется в списке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Асистент пропонує й планує, а ви вирішуєте, що залишиться в списку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا اسسٹنٹ تجویز دیتا اور منصوبہ بناتا ہے؛ آپ طے کرتے ہیں کہ آپ کی فہرست میں کیا رہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手负责建议和规划，清单上留下什么由你决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "助理負責建議與規劃，要留下哪些任務由你決定。"
          }
        }
      }
    },
    "setup.sync.devices.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء متطابق على جميع أجهزتك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same on every device"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo mismo en todos tus dispositivos"
          }
        },
        "fa": {
          "stringUnit": {
