    "memory.workspace.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما يتذكره المساعد عنك. يمكنك أيضًا إضافة الإدخالات أو تعديلها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সম্পর্কে অ্যাসিস্ট্যান্ট যা মনে রাখে। আপনিও এন্ট্রি যোগ বা এডিট করতে পারেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was sich der Assistent über dich merkt. Du kannst auch selbst Einträge hinzufügen oder bearbeiten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όσα θυμάται ο βοηθός για εσάς. Μπορείτε επίσης να προσθέτετε ή να επεξεργάζεστε καταχωρίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the assistant remembers about you. You can add or edit entries too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que el asistente recuerda sobre ti. También puedes añadir o editar recuerdos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آنچه دستیار درباره شما به یاد دارد. شما هم می‌توانید موارد را اضافه یا ویرایش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que l’assistant retient à votre sujet. Vous pouvez aussi ajouter ou modifier des souvenirs."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מה שהעוזר זוכר עליך. אפשר גם להוסיף רשומות או לערוך אותן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके बारे में असिस्टेंट को जो याद है। आप भी एंट्री जोड़ या संपादित कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang diingat asisten tentang Anda. Entri juga dapat ditambahkan atau diedit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che l’assistente ricorda di te. Puoi anche aggiungere o modificare ricordi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントがあなたについて覚えていること。項目の追加や編集もできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어시스턴트가 나에 대해 기억하는 내용입니다. 항목을 직접 추가하거나 편집할 수도 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सहाय्यक तुमच्याबद्दल काय लक्षात ठेवतो. तुम्ही स्वतःही नोंदी जोडू किंवा संपादित करू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang diingati pembantu AI tentang anda. Anda juga boleh menambah atau mengedit entri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat de assistent over jou onthoudt. Je kunt ook zelf items toevoegen of wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co asystent o tobie pamięta. Wpisy możesz też dodawać i edytować samodzielnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o assistente lembra sobre você. Você também pode adicionar ou editar memórias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce reține asistentul despre dvs. Puteți adăuga sau edita și înregistrări din memorie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что ассистент помнит о вас. Вы тоже можете добавлять и изменять записи."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்களைப் பற்றி அசிஸ்டென்ட் நினைவில் வைத்திருப்பவை. பதிவுகளை நீங்களும் சேர்க்கலாம் அல்லது திருத்தலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ గురించి అసిస్టెంట్‌కు గుర్తున్నవి. మీరు కూడా నమోదులు జోడించవచ్చు లేదా ఎడిట్ చేయవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่ผู้ช่วยจดจำเกี่ยวกับคุณ คุณสามารถเพิ่มหรือแก้ไขรายการได้เช่นกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asistanın sizin hakkınızda hatırladıkları. Siz de bellek girdisi ekleyebilir veya düzenleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що асистент пам’ятає про вас. Ви також можете додавати й змінювати записи."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسسٹنٹ آپ کے بارے میں کیا یاد رکھتا ہے۔ آپ بھی اندراجات شامل یا ان میں ترمیم کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những điều trợ lý ghi nhớ về bạn. Bạn cũng có thể thêm hoặc sửa mục ghi nhớ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手记住的关于你的信息。你也可以添加或编辑条目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "助理記得的關於你的事。你也可以自行新增或編輯項目。"
          }
        }
      }
    },
