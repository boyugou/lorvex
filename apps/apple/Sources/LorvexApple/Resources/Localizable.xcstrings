    "memory.workspace.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما يتذكره المساعد عنك. يمكنك أيضًا إضافة الملاحظات أو تعديلها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সম্পর্কে অ্যাসিস্ট্যান্ট যা মনে রাখে। আপনিও নোট যোগ বা এডিট করতে পারেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was sich der Assistent über dich merkt. Du kannst auch selbst Notizen hinzufügen oder bearbeiten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όσα θυμάται ο βοηθός για εσάς. Μπορείτε επίσης να προσθέτετε ή να επεξεργάζεστε σημειώσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the assistant remembers about you. You can add or edit notes too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que el asistente recuerda sobre ti. También puedes añadir o editar notas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آنچه دستیار درباره شما به یاد دارد. شما هم می‌توانید یادداشت‌ها را اضافه یا ویرایش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que l’assistant retient à votre sujet. Vous pouvez aussi ajouter ou modifier des notes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מה שהעוזר זוכר עליך. אפשר גם להוסיף הערות או לערוך אותן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके बारे में असिस्टेंट को जो याद है। आप भी नोट जोड़ या संपादित कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang diingat asisten tentang Anda. Catatan juga dapat ditambahkan atau diedit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che l’assistente ricorda di te. Puoi anche aggiungere o modificare note."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントがあなたについて覚えていること。項目の追加や編集もできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어시스턴트가 나에 대해 기억하는 내용입니다. 항목을 직접 추가하거나 편집할 수도 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सहाय्यक तुमच्याबद्दल काय लक्षात ठेवतो. तुम्ही स्वतःही नोट्स जोडू किंवा संपादित करू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang diingati pembantu AI tentang anda. Anda juga boleh menambah atau mengedit nota."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat de assistent over jou onthoudt. Je kunt ook zelf notities toevoegen of wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co asystent o tobie pamięta. Notatki możesz też dodawać i edytować samodzielnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o assistente lembra sobre você. Você também pode adicionar ou editar notas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce reține asistentul despre dvs. Puteți adăuga sau edita și notițe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что ассистент помнит о вас. Вы тоже можете добавлять и изменять заметки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่ผู้ช่วยจดจำเกี่ยวกับคุณ คุณสามารถเพิ่มหรือแก้ไขโน้ตได้เช่นกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asistanın sizin hakkınızda hatırladıkları. Siz de not ekleyebilir veya düzenleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що асистент пам’ятає про вас. Ви також можете додавати й змінювати нотатки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسسٹنٹ آپ کے بارے میں کیا یاد رکھتا ہے۔ آپ بھی نوٹس شامل یا ان میں ترمیم کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những điều trợ lý ghi nhớ về bạn. Bạn cũng có thể thêm hoặc sửa ghi chú."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手记住的关于你的信息。你也可以添加或编辑笔记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "助理記得的關於你的事。你也可以自行新增或編輯項目。"
          }
        }
      }
    },
