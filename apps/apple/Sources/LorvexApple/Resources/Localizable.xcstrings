    "command_palette.search.placeholder": {
      "comment": "Command palette search field placeholder",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث في المهام أو انتقل أو أضف…"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টাস্ক সার্চ করুন, নেভিগেট করুন বা যোগ করুন…"
          }
