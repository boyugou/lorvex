    "settings.reset_device.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently erases all Lorvex data and settings on this device. It doesn’t touch iCloud: if sync was on, your data stays in iCloud and can download again when sync is re-enabled. To remove the iCloud copy too, use Delete iCloud Data first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久清除此设备上的所有 Lorvex 数据和设置。此操作不影响 iCloud：如果之前开启了同步，数据仍会保留在 iCloud 中，重新启用同步后可能会再次下载。若要同时删除 iCloud 中的副本，请先使用“删除 iCloud 数据”。"
          }
        }
      }
    },
    "settings.reset_device.confirm.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase this device’s data?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要抹掉此设备上的数据吗？"
          }
        }
      }
    },
