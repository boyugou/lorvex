    "system.day_times.read.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة مهام Lorvex التي لها وقت محدد اليوم أو في تاريخ معين."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ বা কোনো নির্দিষ্ট তারিখে সময় ঠিক করা Lorvex টাস্ক পড়ুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest die Lorvex-Aufgaben mit Uhrzeit für heute oder ein bestimmtes Datum."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαβάστε τις εργασίες Lorvex που έχουν ώρα σήμερα ή σε μια συγκεκριμένη ημερομηνία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the Lorvex tasks with a time today or on a specific date."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee las tareas de Lorvex con hora de hoy o de una fecha concreta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خواندن کارهای Lorvex دارای زمان در امروز یا یک تاریخ مشخص."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit les tâches Lorvex ayant un horaire aujourd’hui ou à une date précise."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קריאת משימות Lorvex עם שעה, להיום או לתאריך מסוים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज या किसी तय तारीख़ के वे Lorvex कार्य पढ़ें जिनका समय तय है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca tugas Lorvex yang memiliki waktu hari ini atau pada tanggal tertentu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge le attività di Lorvex con un orario oggi o in una data specifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日または指定した日の、時間が設定されたLorvexのタスクを読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 또는 지정한 날짜에 시간이 정해진 Lorvex 할 일을 읽습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आज किंवा एखाद्या विशिष्ट तारखेला वेळ असलेली Lorvex कार्ये वाचा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca tugas Lorvex yang mempunyai masa hari ini atau pada tarikh tertentu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest de Lorvex-taken met een tijd voor vandaag of een bepaalde datum."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytuje zadania Lorvex z godziną na dzisiaj lub wybraną datę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê as tarefas do Lorvex com horário hoje ou em uma data específica."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Citește sarcinile Lorvex cu oră pentru astăzi sau pentru o anumită dată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает задачи Lorvex со временем на сегодня или на выбранную дату."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்று அல்லது குறிப்பிட்ட தேதியில் நேரம் உள்ள Lorvex பணிகளைப் படிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈరోజు లేదా ఒక నిర్దిష్ట తేదీన సమయం ఉన్న Lorvex టాస్క్‌లను చదవండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านงาน Lorvex ที่กำหนดเวลาไว้ในวันนี้หรือในวันที่ที่ระบุ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün veya belirli bir tarihte saati olan Lorvex görevlerini okuyun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читає завдання Lorvex із часом на сьогодні або на вибрану дату."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج یا کسی خاص تاریخ کے وہ Lorvex کام پڑھیں جن کا وقت مقرر ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc các nhiệm vụ Lorvex có giờ trong hôm nay hoặc vào một ngày cụ thể."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取今天或指定日期里有时间安排的 Lorvex 任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取今天或指定日期已安排時間的 Lorvex 任務。"
          }
        }
      }
    },
