        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pola mingguan akan muncul di sini setelah dua minggu check-in."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo ritmo settimanale apparirà qui dopo due settimane di registrazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェックインが2週間たまると、曜日ごとのパターンがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2주 동안 체크인하면 요일별 패턴이 여기에 표시됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दोन आठवड्यांच्या चेक-इननंतर तुमचा साप्ताहिक पॅटर्न येथे दिसेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Corak mingguan akan dipaparkan di sini selepas dua minggu check-in."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je weekpatroon verschijnt hier na twee weken afvinken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój tygodniowy rytm pojawi się tutaj po dwóch tygodniach odhaczeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu ritmo semanal aparece aqui depois de duas semanas de registros."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiparul săptămânal va apărea aici după două săptămâni de bifări."
