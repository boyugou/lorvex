    "system.memory.save.description": {
      "comment": "Description for the Save Lorvex Memory App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حفظ إدخال في ذاكرة Lorvex القابلة للكتابة بالذكاء الاصطناعي من الاختصارات أو Siri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save an AI-writable Lorvex memory entry from Shortcuts or Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda un recuerdo de Lorvex editable por IA desde Atajos o Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre un souvenir de Lorvex modifiable par l’IA depuis Raccourcis ou Siri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट्स या Siri से AI द्वारा लिखने योग्य Lorvex मेमोरी एंट्री सहेजें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva un ricordo di Lorvex modificabile dall’IA da Comandi rapidi o Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットまたはSiriで、AIが書き込めるLorvexのメモリを保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어 또는 Siri에서 AI가 쓸 수 있는 Lorvex 메모리를 저장합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuje wpis pamięci Lorvex zapisywalny przez AI ze Skrótów lub Siri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva uma memória do Lorvex editável pela IA pelos Atalhos ou pela Siri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет запись памяти Lorvex, доступную для записи ИИ, из «Быстрых команд» или Siri."
