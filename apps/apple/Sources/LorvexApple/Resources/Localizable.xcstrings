            "value": "Privado, só seu"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только для вас"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише для вас"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只属于你"
          }
        },
        "zh-Hant": {
          "stringUnit": {
