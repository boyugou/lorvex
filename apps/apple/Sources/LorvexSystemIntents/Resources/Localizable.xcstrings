          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράψτε μια άδεια λίστα Lorvex από τις Συντομεύσεις ή το Siri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete an empty Lorvex list from Shortcuts or Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina una lista de Lorvex vacía desde Atajos o Siri."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف یک فهرست خالی Lorvex از طریق میان‌برها یا Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime une liste vide de Lorvex depuis Raccourcis ou Siri."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחיקת רשימה ריקה ב-Lorvex דרך קיצורי דרך או Siri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट्स या Siri से Lorvex की कोई खाली सूची हटाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
