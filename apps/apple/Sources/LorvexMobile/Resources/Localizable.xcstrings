            "state": "translated",
            "value": "＋ 버튼을 탭하여 어시스턴트가 기억해야 할 내용을 저장하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij ＋, aby zapisać coś, co asystent powinien zapamiętać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em ＋ para salvar algo que seu assistente deve lembrar."
