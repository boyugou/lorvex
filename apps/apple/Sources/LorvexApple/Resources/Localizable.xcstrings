    "settings.mcp.helper_blocked_detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامج MCP المساعد المدمج في Lorvex غير قابل للتنفيذ. أعد تثبيت Lorvex من التنزيل الأصلي، أو أزل عنه سمة الحجر، لاستعادة الاتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der integrierte MCP-Helfer von Lorvex ist nicht ausführbar. Installiere Lorvex erneut aus dem ursprünglichen Download oder entferne die Quarantäne, um die Verbindung wiederherzustellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex’s built-in MCP helper isn’t executable. Reinstall Lorvex from the original download, or remove it from quarantine, to restore the connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El programa auxiliar MCP integrado de Lorvex no es ejecutable. Vuelve a instalar Lorvex desde la descarga original o quítalo de la cuarentena para restablecer la conexión."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه کمکی MCP داخلی Lorvex قابل اجرا نیست. برای بازگرداندن اتصال، Lorvex را از دانلود اصلی دوباره نصب کنید یا آن را از قرنطینه خارج کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’utilitaire MCP intégré de Lorvex n’est pas exécutable. Réinstallez Lorvex depuis le téléchargement d’origine, ou retirez-le de la quarantaine, pour rétablir la connexion."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כלי העזר המובנה של MCP ב-Lorvex אינו ניתן להפעלה. כדי לשחזר את החיבור יש להתקין מחדש את Lorvex מההורדה המקורית, או להסיר אותו מההסגר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex का बिल्ट-इन MCP हेल्पर चलाया नहीं जा सकता। कनेक्शन बहाल करने के लिए Lorvex को मूल डाउनलोड से दोबारा इंस्टॉल करें, या उसे क्वारंटीन से हटाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’helper MCP integrato di Lorvex non è eseguibile. Reinstalla Lorvex dal download originale oppure rimuovilo dalla quarantena per ripristinare la connessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LorvexのMCPヘルパーを実行できません。接続を復元するには、元のダウンロードからLorvexを再インストールするか、隔離を解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 내장 MCP 도우미를 실행할 수 없습니다. 연결을 복원하려면 원래 다운로드한 파일로 Lorvex를 다시 설치하거나 격리를 해제하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ingebouwde MCP-helper van Lorvex is niet uitvoerbaar. Installeer Lorvex opnieuw vanaf de oorspronkelijke download of verwijder de quarantaine om de verbinding te herstellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wbudowana aplikacja pomocnicza MCP w Lorvex nie jest wykonywalna. Zainstaluj Lorvex ponownie z oryginalnego pobrania lub usuń ją z kwarantanny, aby przywrócić połączenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O utilitário MCP integrado do Lorvex não é executável. Reinstale o Lorvex a partir do download original ou remova-o da quarentena para restaurar a conexão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Programul auxiliar MCP încorporat al Lorvex nu este executabil. Reinstalați Lorvex din descărcarea originală sau eliminați-l din carantină pentru a restabili conexiunea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встроенная вспомогательная программа MCP в Lorvex не является исполняемой. Переустановите Lorvex из исходной загрузки или снимите с неё карантин, чтобы восстановить подключение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вбудована допоміжна програма MCP у Lorvex не є виконуваною. Перевстановіть Lorvex з оригінального завантаження або зніміть з неї карантин, щоб відновити підключення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بلٹ اِن MCP ہیلپر قابل عمل نہیں ہے۔ کنکشن بحال کرنے کے لیے Lorvex کو اصل ڈاؤن لوڈ سے دوبارہ انسٹال کریں، یا اسے کوارنٹین سے ہٹائیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 的内置 MCP 帮助程序不可执行。请从原始下载重新安装 Lorvex，或将其移出隔离区，以恢复连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 內建的 MCP 輔助程式無法執行。若要恢復連線，請用原始下載檔重新安裝 Lorvex，或解除其隔離狀態。"
          }
        }
      }
    },
