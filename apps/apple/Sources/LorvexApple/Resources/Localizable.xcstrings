    "habits.reminders.hint.daily": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الأيام المجدولة لهذه العادة فقط، ويتوقف بمجرد إكمالها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিমাইন্ডার শুধু এই অভ্যাসের নির্ধারিত দিনে আসে এবং অভ্যাসটি সম্পন্ন হলে থেমে যায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur an den Tagen, an denen diese Gewohnheit geplant ist, und endet, sobald sie erledigt ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπενθυμίζει μόνο τις ημέρες που είναι προγραμματισμένη η συνήθεια και σταματά μόλις ολοκληρωθεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only on the days this habit is scheduled, and stops once it’s done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los días en que este hábito está planificado; se detiene al completarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط در روزهایی که این عادت برنامه‌ریزی شده است یادآوری می‌شود و پس از انجام آن متوقف می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement les jours où cette habitude est prévue, et s’arrête dès qu’elle est faite."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התזכורות פועלות רק בימים שבהם ההרגל מתוזמן ונעצרות כשההרגל בוצע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल उन दिनों में जब यह आदत तय है, और आदत पूरी होते ही रुक जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pada hari yang dijadwalkan untuk kebiasaan ini, dan berhenti setelah selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo nei giorni in cui questa abitudine è prevista e si ferma una volta completata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この習慣の予定日のみ通知し、完了すると止まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 습관이 예정된 날에만 알리며, 완료하면 멈춥니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमाइंडर फक्त या सवयीसाठी ठरवलेल्या दिवशी येतो आणि सवय पूर्ण झाल्यावर थांबतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pada hari tabiat ini dijadualkan, dan berhenti setelah selesai."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen op de dagen waarop deze gewoonte gepland staat, en stopt zodra de gewoonte is voltooid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko w dni, w których nawyk jest zaplanowany, i kończy się po jego wykonaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente nos dias em que este hábito está previsto e para assim que for concluído."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar în zilele în care obiceiul este planificat și se oprește după ce este finalizat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только в дни, когда запланирована привычка, и прекращается после выполнения."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் பழக்கம் திட்டமிடப்பட்ட நாட்களில் மட்டும், அது முடிந்ததும் நிற்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ అలవాటు షెడ్యూల్ చేసిన రోజుల్లో మాత్రమే, అది పూర్తయిన వెంటనే ఆగిపోతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เตือนเฉพาะวันที่กำหนดนิสัยนี้ไว้ และหยุดเมื่อทำเสร็จแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca alışkanlığın planlandığı günlerde anımsatır; tamamlandığında durur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише в дні, на які запланована звичка, і припиняється після виконання."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ صرف ان دنوں میں یاد دلاتی ہے جب عادت طے ہو، اور مکمل ہوتے ہی رک جاتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ vào những ngày thói quen này được lên lịch, và dừng khi đã hoàn thành."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在该习惯计划的日子提醒，完成后即停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會在這個習慣安排的日子提醒，完成後就會停止。"
          }
        }
      }
    },
    "habits.reminders.hint.monthly": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
