          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hängt Notizen über Kurzbefehle oder Siri an eine Lorvex-Aufgabe an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε σημειώσεις στο τέλος μιας εργασίας Lorvex από τις Συντομεύσεις ή το Siri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Append notes to a Lorvex task from Shortcuts or Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade notas a una tarea de Lorvex desde Atajos o Siri."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "افزودن یادداشت به پایان یک کار Lorvex از طریق میان‌برها یا Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute des notes à une tâche de Lorvex depuis Raccourcis ou Siri."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוספת הערות בסוף משימה ב-Lorvex דרך קיצורי דרך או Siri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट्स या Siri से Lorvex कार्य में नोट जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menambahkan catatan ke tugas Lorvex dari Pintasan atau Siri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge note a un’attività di Lorvex da Comandi rapidi o Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットまたはSiriでLorvexのタスクにメモを追記します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어 또는 Siri에서 Lorvex 할 일에 메모를 덧붙입니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट किंवा Siri द्वारे एका Lorvex कार्याच्या नोट्सच्या शेवटी मजकूर जोडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menambah nota pada tugas Lorvex daripada Pintasan atau Siri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voegt notities toe aan een Lorvex-taak via Opdrachten of Siri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dołącza notatki do zadania Lorvex ze Skrótów lub Siri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona notas a uma tarefa do Lorvex pelos Atalhos ou pela Siri."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă notițe la o sarcină Lorvex prin Scurtături sau Siri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет заметки к задаче Lorvex из «Быстрых команд» или Siri."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்கவழிகள் அல்லது Siri மூலம் Lorvex பணியில் குறிப்புகளைச் சேர்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "షార్ట్‌కట్స్ లేదా Siri నుండి Lorvex టాస్క్‌కు నోట్స్‌ను జోడించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มโน้ตต่อท้ายงาน Lorvex จากคำสั่งลัดหรือ Siri"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kestirmeler veya Siri ile bir Lorvex görevinin notlarına ekleme yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додає нотатки до завдання Lorvex зі «Швидких команд» або Siri."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شارٹ کٹس یا Siri سے Lorvex کام کے آخر میں نوٹس شامل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm ghi chú vào một nhiệm vụ Lorvex từ Phím tắt hoặc Siri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“快捷指令”或 Siri 向 Lorvex 任务追加备注。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過捷徑或 Siri 在 Lorvex 任務中附加備註。"
          }
        }
      }
    },
