    "watch.delivery.rejection.unreadable": {
      "comment": "Watch delivery: the phone repeatedly answered a command without an acknowledgement",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة هذا الإجراء على iPhone. حدّث Lorvex على كلا الجهازين."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPhone couldn’t read this action. Update Lorvex on both devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu iPhone no pudo leer esta acción. Actualiza Lorvex en ambos dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre iPhone n’a pas pu lire cette action. Mettez à jour Lorvex sur les deux appareils."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका iPhone यह कार्रवाई पढ़ नहीं सका। दोनों डिवाइस पर Lorvex अपडेट करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo iPhone non è riuscito a leggere questa azione. Aggiorna Lorvex su entrambi i dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneでこの操作を読み取れませんでした。両方のデバイスでLorvexをアップデートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 이 동작을 읽을 수 없습니다. 두 기기에서 모두 Lorvex를 업데이트하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone nie mógł odczytać tej akcji. Zaktualizuj Lorvex na obu urządzeniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu iPhone não conseguiu ler esta ação. Atualize o Lorvex nos dois dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone не смог прочитать это действие. Обновите Lorvex на обоих устройствах."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone не зміг прочитати цю дію. Оновіть Lorvex на обох пристроях."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 无法读取这项操作。请在两台设备上都更新 Lorvex。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 iPhone 無法讀取此操作。請在兩部裝置上都更新 Lorvex。"
          }
        }
      }
    },
