    "settings.working_hours.caption": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الساعات التي يخطط Lorvex مهامك ضمنها. يُحتسب امتلاء اليوم بالنسبة إليها، وتبقى الأوقات المقترحة داخلها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex plant deine Aufgaben innerhalb dieser Stunden. Daran bemisst sich, wie voll ein Tag ist, und vorgeschlagene Zeiten liegen immer innerhalb davon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex plans your tasks into these hours. It judges how full a day is against them, and suggested times stay inside them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las horas en las que Lorvex planifica tus tareas. La carga de un día se mide con respecto a ellas, y los horarios sugeridos siempre quedan dentro."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارهای شما را Lorvex در همین ساعت‌ها برنامه‌ریزی می‌کند. پر بودن یک روز نسبت به این ساعت‌ها سنجیده می‌شود و زمان‌های پیشنهادی درون آن‌ها می‌مانند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les heures dans lesquelles Lorvex planifie vos tâches. Le taux de remplissage d’une journée est calculé par rapport à ces heures, et les horaires suggérés restent dans cette plage."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשימות שלך מתוכננות בשעות האלה. מידת העומס ביום נמדדת לפיהן, והזמנים המוצעים נשארים בתוכן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वे घंटे जिनमें Lorvex आपके कार्य प्लान करता है। दिन कितना भरा है, इसकी गिनती इन्हीं के हिसाब से होती है, और सुझाए गए समय इन्हीं के भीतर रहते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ore in cui Lorvex pianifica le tue attività. Il riempimento di una giornata viene calcolato rispetto a queste ore e gli orari suggeriti restano al loro interno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexがタスクを予定に入れる時間帯です。1日の混み具合はこの時間帯を基準に数えられ、提案される時間もこの範囲内に収まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex가 할 일을 일정에 배치하는 시간입니다. 하루가 얼마나 찼는지는 이 시간을 기준으로 계산되고, 제안되는 시간도 이 범위 안에서만 정해집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex plant je taken binnen deze uren in. Hieraan wordt afgemeten hoe vol een dag is, en voorgestelde tijden blijven erbinnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Godziny, w które Lorvex planuje twoje zadania. Wypełnienie dnia liczy się względem nich, a sugerowane godziny mieszczą się w ich granicach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As horas em que o Lorvex planeja suas tarefas. O quanto um dia está cheio é medido em relação a elas, e os horários sugeridos ficam dentro delas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex planifică sarcinile în aceste ore. Gradul de încărcare al unei zile se măsoară în raport cu ele, iar orele sugerate rămân în interiorul lor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часы, в которые Lorvex планирует ваши задачи. Загруженность дня рассчитывается относительно них, а предлагаемое время не выходит за их пределы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Години, у які Lorvex планує ваші завдання. Заповненість дня обчислюється відносно них, а запропонований час не виходить за їхні межі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے کاموں کی منصوبہ بندی Lorvex ان اوقات میں کرتا ہے۔ دن کتنا بھرا ہے اس کا حساب انہی کے مقابلے میں ہوتا ہے، اور تجویز کردہ اوقات انہی کے اندر رہتے ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 在这个时段里安排任务：每天有多满按它计算，建议的时间也只会落在其中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 會把任務安排在這段時間內。一天的滿載程度以此計算，建議的時間也只會落在這段時間裡。"
          }
        }
      }
    },
