    "task_detail.actions.pause.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف هذه المهمة مؤقتًا. تبقى في يومها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই টাস্ক পজ করুন। এটি নিজের দিনেই থাকবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aufgabe pausieren. Sie bleibt an ihrem Tag."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παύση αυτής της εργασίας. Παραμένει στην ημέρα της."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause this task. It stays on its day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa esta tarea. Se queda en su día."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار را مکث کنید. در همان روز باقی می‌ماند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre cette tâche en pause. Elle reste sur son jour."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השהיית המשימה. היא נשארת ביום שלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस कार्य को रोकें। यह अपने दिन पर ही रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeda tugas ini. Tugas tetap berada di harinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti in pausa questa attività. Resta nel suo giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタスクを一時停止します。タスクはその日のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 할 일을 일시 중지합니다. 할 일은 해당 날짜에 그대로 남습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे कार्य पॉज करा. ते त्याच दिवशी राहील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeda tugas ini. Ia kekal pada harinya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauzeer deze taak. De taak blijft op dezelfde dag staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymaj zadanie. Zostanie w swoim dniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar esta tarefa. Ela continua no mesmo dia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspendați această sarcină. Rămâne în ziua ei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приостановить задачу. Её день не изменится."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดพักงานนี้ งานจะยังอยู่ในวันเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu görevi duraklat. Planlandığı günde kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Призупинити завдання. Його день не зміниться."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کام کو موقوف کریں۔ یہ اپنے دن پر ہی رہتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạm dừng nhiệm vụ này. Nhiệm vụ vẫn ở đúng ngày của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停这项任务，它仍留在原来的日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫停這個任務。它仍會留在原本的日期。"
          }
        }
      }
    },
    "task_detail.actions.start.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدء هذه المهمة. تتصدر المهام التي بدأ العمل عليها قائمة اليوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই টাস্ক শুরু করুন। শুরু করা টাস্ক “আজ” তালিকার শীর্ষে থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aufgabe starten. Gestartete Aufgaben stehen in „Heute“ ganz oben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έναρξη αυτής της εργασίας. Οι εργασίες που έχουν ξεκινήσει εμφανίζονται πρώτες στο «Σήμερα»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start this task. Started tasks lead Today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia esta tarea. Las tareas iniciadas encabezan Hoy."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار را شروع کنید. کارهای شروع‌شده در «امروز» در صدر فهرست قرار می‌گیرند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrer cette tâche. Les tâches démarrées passent en tête d’Aujourd’hui."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחלת המשימה. משימות שהותחלו מופיעות ראשונות ב\"היום\"."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस कार्य को शुरू करें। शुरू किए गए कार्य “आज” में सबसे ऊपर रहते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai tugas ini. Tugas yang sudah dimulai berada di urutan teratas Hari Ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia questa attività. Le attività iniziate vengono prima in Oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタスクを開始します。開始したタスクは「今日」の先頭に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 할 일을 시작합니다. 시작한 할 일은 오늘 목록의 맨 위에 표시됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे कार्य सुरू करा. सुरू केलेली कार्ये ‘आज’ यादीत सर्वात वर असतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulakan tugas ini. Tugas yang sudah dimulakan berada di bahagian teratas Hari Ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start deze taak. Gestarte taken staan bovenaan in ‘Vandaag’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpocznij zadanie. Rozpoczęte zadania są na początku widoku „Dzisiaj”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar esta tarefa. As tarefas iniciadas aparecem primeiro em Hoje."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Începeți această sarcină. Sarcinile începute apar primele în „Astăzi”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начать задачу. Начатые задачи показываются первыми в «Сегодня»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มงานนี้ งานที่เริ่มแล้วจะแสดงเป็นอันดับแรกในวันนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu görevi başlat. Başlatılan görevler Bugün sayfasında en üstte yer alır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почати завдання. Розпочаті завдання показуються першими в «Сьогодні»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کام کو شروع کریں۔ شروع کیے گئے کام \"آج\" میں سب سے اوپر آتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu nhiệm vụ này. Các nhiệm vụ đã bắt đầu nằm ở đầu danh sách Hôm nay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始这项任务。已开始的任务排在今天最前面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始這個任務。已開始的任務會排在「今天」的最前面。"
          }
        }
      }
    },
