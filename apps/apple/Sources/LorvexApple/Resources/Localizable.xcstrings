        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen taken in deze lijst"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak zadań na tej liście"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma tarefa nesta lista"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicio sarcină în această listă"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом списке нет задач"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цьому списку немає завдань"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس فہرست میں کوئی کام نہیں"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此列表中没有任务"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此清單中沒有任務"
          }
        }
      }
    },
    "tasks.empty.no_matching_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مهام تطابق تصفية الأولوية المحددة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Aufgaben entsprechen dem ausgewählten Prioritätsfilter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No tasks match the selected priority filter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna tarea coincide con el filtro de prioridad seleccionado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ کاری با فیلتر اولویت انتخاب‌شده مطابقت ندارد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune tâche ne correspond au filtre de priorité sélectionné."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין משימות שתואמות למסנן העדיפות שנבחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुने गए प्राथमिकता फ़िल्टर से कोई कार्य मेल नहीं खाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna attività corrisponde al filtro di priorità selezionato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した優先度フィルタに一致するタスクはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 우선순위 필터와 일치하는 할 일이 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen taken komen overeen met het geselecteerde prioriteitsfilter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadne zadanie nie pasuje do wybranego filtra priorytetu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma tarefa corresponde ao filtro de prioridade selecionado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicio sarcină nu corespunde filtrului de prioritate selectat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет задач, подходящих под выбранный фильтр приоритета."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає завдань, що відповідають вибраному фільтру пріоритету."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب ترجیحی فلٹر سے کوئی کام مطابقت نہیں رکھتا۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有任务匹配所选优先级筛选。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有符合所選優先順序篩選條件的任務。"
          }
        }
      }
    },
