          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex कार्याचा रिमाइंडर काढून टाका"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Padam Peringatan Tugas Lorvex"
          }
        },
        "nl": {
