    "settings.reset_device.confirm.action": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسح هذا الجهاز"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase This Device"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrar este dispositivo"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پاک کردن داده‌های این دستگاه"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer cet appareil"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחיקת נתוני המכשיר הזה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस को मिटाएँ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella questo dispositivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスを消去"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기 지우기"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń dane z urządzenia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar este dispositivo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стереть данные устройства"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стерти дані пристрою"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ڈیوائس کا ڈیٹا مٹائیں"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抹掉此设备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
