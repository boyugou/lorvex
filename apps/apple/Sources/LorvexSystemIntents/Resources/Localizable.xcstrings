    "system.task.plan_today.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تخطيط مهمة في Lorvex لليوم لتظهر في قائمة اليوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি Lorvex টাস্ক আজকের জন্য প্ল্যান করুন, যাতে সেটি আজকের টাস্কের মধ্যে দেখা যায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plant eine Lorvex-Aufgabe für heute, damit sie unter „Heute“ erscheint."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προγραμματίστε μια εργασία Lorvex για σήμερα, ώστε να εμφανίζεται στο «Σήμερα»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan a Lorvex task for today so it appears on Today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifica una tarea de Lorvex para hoy: aparecerá en Hoy."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه‌ریزی یک کار Lorvex برای امروز تا در «امروز» نمایش داده شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifie une tâche de Lorvex pour aujourd’hui afin qu’elle apparaisse dans Aujourd’hui."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תכנון משימה ב-Lorvex להיום כדי שתופיע ב\"היום\"."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex कार्य को आज के लिए प्लान करें, ताकि वह “आज” में दिखे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Merencanakan tugas Lorvex untuk hari ini agar muncul di Hari Ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pianifica un’attività di Lorvex per oggi in modo che compaia in Oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexのタスクを今日の予定にして、「今日」に表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 할 일을 오늘로 계획하여 오늘 화면에 표시합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एक Lorvex कार्य आजसाठी प्लॅन करा, म्हणजे ते आजच्या कार्यांमध्ये दिसेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Merancang tugas Lorvex untuk hari ini supaya dipaparkan dalam Hari Ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plant een Lorvex-taak voor vandaag, zodat die onder ‘Vandaag’ verschijnt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Planuje zadanie Lorvex na dzisiaj, aby pojawiło się w „Dzisiaj”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Planeja uma tarefa do Lorvex para hoje para que ela apareça em Hoje."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifică o sarcină Lorvex pentru astăzi, astfel încât să apară în „Astăzi”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Планирует задачу Lorvex на сегодня, чтобы она появилась в «Сегодня»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex பணியை இன்றைக்குத் திட்டமிடு, அப்போது அது இன்றைய பட்டியலில் தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex టాస్క్‌ను ఈరోజు కోసం ప్లాన్ చేయండి, అప్పుడు అది ఈరోజు జాబితాలో కనిపిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางแผนงาน Lorvex ให้เป็นของวันนี้ เพื่อให้แสดงในวันนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Lorvex görevini bugüne planlayın; Bugün sayfasında görünsün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Планує завдання Lorvex на сьогодні, щоб воно з’явилося в «Сьогодні»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی Lorvex کام کو آج کے لیے منصوبہ بند کریں تاکہ وہ \"آج\" میں نظر آئے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lên kế hoạch cho một nhiệm vụ Lorvex hôm nay để nó xuất hiện trong Hôm nay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把一项 Lorvex 任务安排到今天，让它出现在“今天”里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 Lorvex 任務安排在今天，讓它顯示在「今天」中。"
          }
        }
      }
    },
