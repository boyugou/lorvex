          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex를 열어 습관을 불러오세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Lorvex, aby wczytać nawyki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Lorvex para carregar os hábitos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Lorvex, чтобы загрузить привычки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте Lorvex, щоб завантажити звички."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Lorvex 以加载习惯。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 Lorvex 以載入習慣。"
          }
        }
      }
    },
