    "habit_detail.goal.hint.completions": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد من الإكمالات للاحتفال به. تستمر العادة بعد ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যতবার সম্পন্ন হলে উদযাপন করবেন, সেই সংখ্যা। এরপরও অভ্যাসটি চলতে থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Anzahl an Erledigungen zum Feiern. Die Gewohnheit läuft danach weiter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αριθμός ολοκληρώσεων που αξίζει να γιορτάσετε. Η συνήθεια συνεχίζεται και μετά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A number of completions to celebrate. The habit keeps going after it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un número de registros que celebrar. El hábito continúa después."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تعداد دفعات تکمیل که با رسیدن به آن جشن می‌گیرید. عادت پس از آن ادامه دارد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nombre de réalisations à célébrer. L’habitude continue ensuite."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מספר השלמות שיש לחגוג. ההרגל נמשך גם לאחר מכן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जश्न मनाने के लिए चेक-इन की संख्या। उसके बाद भी आदत जारी रहती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumlah penyelesaian yang akan dirayakan. Kebiasaan tetap berlanjut setelahnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un numero di completamenti da festeggiare. L’abitudine continua anche dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お祝いする完了回数です。習慣はその後も続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "축하할 완료 횟수입니다. 이후에도 습관은 계속됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "किती वेळा पूर्ण झाल्यावर साजरे करायचे, ती संख्या. त्यानंतरही सवय सुरू राहते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilangan penyelesaian untuk diraikan. Tabiat ini terus berjalan selepas itu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een aantal keren om te vieren. De gewoonte gaat daarna door."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczba wykonań, którą warto uczcić. Nawyk trwa także po jej osiągnięciu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um número de conclusões para comemorar. O hábito continua depois disso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un număr de finalizări de sărbătorit. Obiceiul continuă și după aceea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Число выполнений, которое стоит отпраздновать. Привычка продолжается и после этого."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கொண்டாட வேண்டிய முறைகளின் எண்ணிக்கை. அதற்குப் பிறகும் பழக்கம் தொடரும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వేడుక చేసుకోవాల్సిన సార్ల సంఖ్య. ఆ తర్వాత కూడా అలవాటు కొనసాగుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำนวนครั้งที่ทำสำเร็จที่ต้องการฉลอง นิสัยนี้จะดำเนินต่อไปหลังจากนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutlanacak tamamlama sayısı. Alışkanlık bundan sonra da devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кількість виконань, яку варто відсвяткувати. Звичка триває й після цього."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تکمیل کی وہ تعداد جس پر جشن منایا جائے۔ عادت اس کے بعد بھی جاری رہتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số lần hoàn thành cần ăn mừng. Thói quen vẫn tiếp tục sau đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "累计完成到这个次数时庆祝一下，之后习惯照常继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要慶祝的完成次數。達成後，習慣仍會持續。"
          }
        }
      }
    },
