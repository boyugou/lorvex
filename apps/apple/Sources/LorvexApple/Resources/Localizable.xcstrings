            "state": "translated",
            "value": "Check-in hari ini untuk kebiasaan ini akan dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione cancella le registrazioni di oggi per questa abitudine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この習慣の今日のチェックインがクリアされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 습관의 오늘 체크인이 지워집니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "यामुळे या सवयीचे आजचे चेक-इन क्लिअर होतील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Check-in hari ini untuk tabiat ini akan dikosongkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wis je wat je vandaag voor deze gewoonte hebt afgevinkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhaczenia z dzisiaj dla tego nawyku zostaną wyczyszczone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso apaga os registros de hoje deste hábito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această acțiune șterge bifările de astăzi pentru acest obicei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметки за сегодня для этой привычки будут удалены."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเช็คอินของนิสัยนี้ในวันนี้จะถูกล้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem, bu alışkanlık için bugünkü işaretlemeleri temizler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначки за сьогодні для цієї звички буде очищено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس عادت کے آج کے چیک اِن صاف ہو جائیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các lần điểm danh hôm nay của thói quen này sẽ bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将清除该习惯今天的打卡记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會清除這個習慣今天的打卡紀錄。"
          }
        }
      }
    },
