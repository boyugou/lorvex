        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消這一次"
          }
        }
      }
    },
    "watch.action.cancel.confirm": {
      "comment": "Title of the cancel-task confirmation dialog; %@ is the task title",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد إلغاء هذا التكرار من \"%@\"؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Wiederholung von %@ abbrechen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel this occurrence of %@?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cancelar esta repetición de “%@”?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این تکرار از «%@» لغو شود؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler cette occurrence de « %@ » ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לבטל את המופע הזה של \"%@\"?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” को केवल इस बार के लिए रद्द करें?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batalkan kejadian ini dari %@?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annullare questa occorrenza di “%@”?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の今回分をキャンセルしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”의 이번 반복을 취소하시겠습니까?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Batalkan kejadian ini bagi %@?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze herhaling van %@ annuleren?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulować to wystąpienie zadania „%@”?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar esta ocorrência de “%@”?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulați această apariție a sarcinii %@?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить это повторение задачи «%@»?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасувати це повторення завдання «%@»?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" کی یہ تکرار منسوخ کریں؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hủy lần lặp này của %@?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅取消“%@”的这一次？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要取消「%@」的這一次嗎？"
          }
        }
      }
    },
