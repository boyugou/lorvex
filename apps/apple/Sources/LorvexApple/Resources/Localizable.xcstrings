    "review.week.decision.message": {
      "comment": "Week review decision detail.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد وضعها في \"يومًا ما\" إلى أن تصبح ذات أهمية؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Park it in Someday until it matters?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Dejarla en Algún día hasta que importe?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mettre de côté dans Un jour jusqu’à ce qu’elle compte ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक यह ज़रूरी न हो जाए, इसे “किसी दिन” में रख दें?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metterla in Prima o poi finché non diventa importante?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重要になるまで「いつか」に置いておきますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중요해질 때까지 ‘언젠가’에 보관할까요?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odłożyć do „Kiedyś”, dopóki nie stanie się ważne?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixá-la em Algum dia até que se torne importante?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убрать в «Когда-нибудь», пока это не станет важным?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прибрати в «Колись», доки це не стане важливим?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先放进“将来某天”，等需要时再拿出来？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要先放進「將來某天」，等重要時再處理嗎？"
          }
        }
      }
    },
    "review.week.decision.action": {
