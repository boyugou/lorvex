{
  "sourceLanguage": "en",
  "strings": {
    "system.calendar.create.description": {
      "comment": "Description for the Create Lorvex Calendar Event App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنشاء حدث تقويم Lorvex من الاختصارات أو Siri."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শর্টকাট বা Siri থেকে একটি Lorvex ক্যালেন্ডার ইভেন্ট তৈরি করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt ein Ereignis im Lorvex-Kalender über Kurzbefehle oder Siri."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργήστε ένα γεγονός ημερολογίου Lorvex από τις Συντομεύσεις ή το Siri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a Lorvex calendar event from Shortcuts or Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un evento de calendario de Lorvex desde Atajos o Siri."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ایجاد رویداد تقویم Lorvex از طریق میان‌برها یا Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée un événement du calendrier de Lorvex depuis Raccourcis ou Siri."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יצירת אירוע בלוח השנה של Lorvex דרך קיצורי דרך או Siri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट्स या Siri से Lorvex कैलेंडर इवेंट बनाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuat acara kalender Lorvex dari Pintasan atau Siri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un evento del calendario di Lorvex da Comandi rapidi o Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットまたはSiriでLorvexのカレンダーイベントを作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어 또는 Siri에서 Lorvex 캘린더 이벤트를 만듭니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट किंवा Siri द्वारे एक Lorvex दिनदर्शिका इव्हेंट तयार करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencipta peristiwa kalendar Lorvex daripada Pintasan atau Siri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maakt een activiteit aan in de Lorvex-agenda via Opdrachten of Siri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tworzy wydarzenie kalendarza Lorvex ze Skrótów lub Siri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria um evento do calendário do Lorvex pelos Atalhos ou pela Siri."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Creează un eveniment în calendarul Lorvex prin Scurtături sau Siri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создаёт событие календаря Lorvex из «Быстрых команд» или Siri."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்கவழிகள் அல்லது Siri மூலம் Lorvex கேலண்டர் நிகழ்வை உருவாக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "షార్ట్‌కట్స్ లేదా Siri నుండి Lorvex క్యాలెండర్ ఇవెంట్‌ను సృష్టించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างกิจกรรมปฏิทิน Lorvex จากคำสั่งลัดหรือ Siri"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kestirmeler veya Siri ile bir Lorvex takvim etkinliği oluşturun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створює подію календаря Lorvex зі «Швидких команд» або Siri."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شارٹ کٹس یا Siri سے Lorvex کیلنڈر ایونٹ بنائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo một sự kiện lịch Lorvex từ Phím tắt hoặc Siri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“快捷指令”或 Siri 创建一个 Lorvex 日历事件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過捷徑或 Siri 建立 Lorvex 行事曆事件。"
          }
        }
      }
    },
    "system.calendar.create.dialog": {
      "comment": "Dialog after creating a calendar event; first %@ is event title and second %@ is start date",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إنشاء حدث التقويم %@ بتاريخ %@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যালেন্ডার ইভেন্ট “%@” তৈরি করা হয়েছে। শুরুর তারিখ: %@।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalenderereignis %@ für %@ erstellt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργήθηκε το γεγονός ημερολογίου %1$@ για %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Created calendar event %@ for %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se creó el evento “%1$@” para %2$@."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رویداد تقویم «%1$@» برای %2$@ ایجاد شد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Événement du calendrier « %@ » créé pour le %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נוצר אירוע בלוח השנה \"%1$@\" בתאריך %2$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ के लिए कैलेंडर इवेंट “%1$@” बनाया गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Acara kalender %@ dibuat untuk %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evento del calendario “%@” creato per il %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーイベント「%@」を%@に作成しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 캘린더 이벤트를 %@에 만들었습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दिनदर्शिका इव्हेंट ‘%@’ तयार केला. सुरुवातीचा दिनांक: %@."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peristiwa kalendar %@ dicipta untuk %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Activiteit %@ aangemaakt voor %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utworzono wydarzenie kalendarza „%@” na %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Evento do calendário “%@” criado para %@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Evenimentul %@ a fost creat pentru %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создано событие календаря «%@» на %@."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” என்ற கேலண்டர் நிகழ்வு %@ நேரத்தில் உருவாக்கப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” అనే క్యాలెండర్ ఇవెంట్ %@ కోసం సృష్టించబడింది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างกิจกรรมปฏิทิน %1$@ สำหรับ %2$@ แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ için takvim etkinliği oluşturuldu: %1$@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створено подію календаря «%@» на %@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیلنڈر ایونٹ \"%1$@\" %2$@ کے لیے بنایا گیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tạo sự kiện lịch %@ cho %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已为 %2$@ 创建日历事件“%1$@”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已建立行事曆事件「%@」，開始時間：%@。"
          }
        }
      }
    },
