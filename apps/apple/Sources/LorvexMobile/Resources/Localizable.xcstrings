          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это можно изменить в любой момент в настройках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це можна змінити будь-коли в параметрах."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后也可以随时在设置中更改。"
          }
