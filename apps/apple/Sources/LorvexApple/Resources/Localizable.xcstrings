    "settings.calendar.access.full_details_detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة تفاصيل الأحداث كاملة، بما في ذلك العناوين والمواقع والملاحظات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইভেন্টের শিরোনাম, লোকেশন ও নোটসহ পূর্ণ বিবরণ মিরর করা হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiegelt alle Ereignisdetails, einschließlich Titel, Orte und Notizen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαβάζονται όλες οι λεπτομέρειες των γεγονότων, συμπεριλαμβανομένων των τίτλων, των τοποθεσιών και των σημειώσεων."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirror full event details, including titles, locations, and notes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se leen todos los detalles de los eventos, incluidos títulos, ubicaciones y notas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "جزئیات کامل رویدادها، از جمله عنوان، مکان و یادداشت‌ها، منعکس می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les détails des événements sont lus, y compris les titres, lieux et notes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משקף פרטי אירועים מלאים, כולל כותרות, מיקומים והערות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इवेंट का पूरा ब्योरा मिरर करें, जिसमें शीर्षक, स्थान और नोट शामिल हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencerminkan detail acara selengkapnya, termasuk judul, lokasi, dan catatan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono letti tutti i dettagli degli eventi, inclusi titoli, luoghi e note."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトル、場所、メモを含む、イベントの詳細をすべて読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목, 위치, 메모를 포함한 이벤트의 모든 세부 정보를 읽습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शीर्षके, स्थाने आणि नोट्ससह इव्हेंटचे संपूर्ण तपशील मिरर केले जातात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencerminkan butiran peristiwa penuh, termasuk tajuk, lokasi dan nota."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiegelt alle activiteitsgegevens, inclusief titels, locaties en notities."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytywane są wszystkie szczegóły wydarzeń, w tym tytuły, miejsca i notatki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os detalhes dos eventos são lidos, incluindo títulos, locais e notas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oglindește toate detaliile evenimentelor, inclusiv titlurile, locațiile și notițele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Считываются все подробности событий, включая названия, места и заметки."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தலைப்புகள், இருப்பிடங்கள், குறிப்புகள் உட்பட முழு நிகழ்வு விவரங்களையும் மிரர் செய்யும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "టైటిల్‌లు, లొకేషన్‌లు, నోట్స్‌తో సహా పూర్తి ఇవెంట్ వివరాలను మిర్రర్ చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านรายละเอียดกิจกรรมทั้งหมด รวมถึงชื่อเรื่อง สถานที่ และโน้ต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlıklar, konumlar ve notlar dahil tüm etkinlik ayrıntıları okunur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зчитуються всі подробиці подій, зокрема назви, місця й нотатки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایونٹس کی مکمل تفصیلات، بشمول عنوان، مقامات اور نوٹس، مرر کی جاتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phản chiếu đầy đủ chi tiết sự kiện, gồm tiêu đề, vị trí và ghi chú."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步完整事件详情，包括标题、地点和备注。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取完整的事件詳細資料，包含標題、位置與備註。"
          }
        }
      }
    },
