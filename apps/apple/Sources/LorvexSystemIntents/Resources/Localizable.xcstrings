    "system.review.daily.amend.description": {
      "comment": "Description for the Amend Lorvex Daily Review App Intent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحديث حقول مراجعة يومية موجودة في Lorvex."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগে থেকে থাকা Lorvex দৈনিক পর্যালোচনার ফিল্ড আপডেট করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiert Felder eines vorhandenen Lorvex-Tagesrückblicks."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενημερώστε πεδία σε μια υπάρχουσα ημερήσια ανασκόπηση Lorvex."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update fields on an existing Lorvex daily review."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza campos de una revisión diaria de Lorvex existente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به‌روزرسانی فیلدهای یک مرور روزانه موجود در Lorvex."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met à jour des champs d’un bilan quotidien existant de Lorvex."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדכון שדות בסקירה יומית קיימת ב-Lorvex."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौजूदा Lorvex दैनिक समीक्षा के फ़ील्ड अपडेट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memperbarui kolom pada tinjauan harian Lorvex yang sudah ada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna i campi di una revisione giornaliera di Lorvex esistente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexの既存の毎日の振り返りの項目を更新します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 Lorvex 일일 회고의 항목을 업데이트합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आधीपासून असलेल्या Lorvex दैनिक आढाव्यातील फील्ड अपडेट करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengemas kini medan pada semakan harian Lorvex yang sedia ada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werkt velden van een bestaande Lorvex-dagterugblik bij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizuje pola istniejącego podsumowania dnia Lorvex."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualiza campos de uma revisão diária do Lorvex existente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizează câmpurile unei recapitulări zilnice Lorvex existente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновляет поля существующих итогов дня Lorvex."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஏற்கெனவே உள்ள Lorvex தினசரி மீள்பார்வையின் புலங்களைப் புதுப்பிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇప్పటికే ఉన్న Lorvex రోజువారీ సమీక్షలోని ఫీల్డ్‌లను అప్‌డేట్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปเดตข้อมูลบางส่วนในการทบทวนรายวัน Lorvex ที่มีอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut bir Lorvex günlük gözden geçirmesindeki alanları güncelleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновлює поля наявних підсумків дня Lorvex."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موجودہ Lorvex روزانہ جائزے کے فیلڈز اپ ڈیٹ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cập nhật các trường trong một bản tổng kết hàng ngày Lorvex hiện có."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新现有 Lorvex 每日回顾的字段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新現有 Lorvex 每日回顧的欄位。"
          }
        }
      }
    },
    "system.review.daily.amend.dialog": {
      "comment": "Dialog after amending daily review; %@ is review date",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تحديث المراجعة اليومية بتاريخ %@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ তারিখের দৈনিক পর্যালোচনা আপডেট করা হয়েছে।"
          }
        },
