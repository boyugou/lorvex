          "stringUnit": {
            "state": "translated",
            "value": "時間どおりのリマインダー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제시간에 알림"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienia na czas"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembretes no horário"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминания вовремя"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагадування вчасно"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准时提醒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "準時提醒"
          }
        }
      }
    },
    "setup.notifications.due.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينبّهك Lorvex عندما يحين موعد تذكير مهمة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex notifies you when a task’s reminder is due."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex te avisa cuando llega la hora del recordatorio de una tarea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex vous notifie quand arrive l’heure du rappel d’une tâche."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्य के रिमाइंडर का समय होने पर Lorvex आपको सूचित करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex ti avvisa quando arriva l’ora del promemoria di un’attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクのリマインダーの時刻になると、Lorvexが通知します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일의 알림 시간이 되면 Lorvex가 알려 줍니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex powiadomi cię, gdy nadejdzie czas przypomnienia o zadaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lorvex avisa quando chega a hora do lembrete de uma tarefa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex уведомит вас, когда подойдёт время напоминания о задаче."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex сповістить вас, коли настане час нагадування про завдання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务的提醒时间到了，Lorvex 会通知你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任務的提醒時間一到，Lorvex 就會通知你。"
          }
        }
      }
    },
    "setup.notifications.act.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصرّف من الإشعار نفسه"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Act from the notification"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actúa desde la notificación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agissez depuis la notification"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचना से ही कार्रवाई करें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Agisci dalla notifica"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知からそのまま操作"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림에서 바로 처리"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działaj prosto z powiadomienia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aja pela notificação"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действуйте прямо из уведомления"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дійте просто зі сповіщення"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在通知中直接处理"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接從通知操作"
          }
        }
      }
    },
    "setup.notifications.act.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكمل المهمة، أو أجّل تذكيرها ساعة، أو أجّلها إلى الغد، مباشرةً من الإشعار."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete the task, snooze it for an hour, or defer it to tomorrow right from the notification."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa la tarea, pospónla una hora o aplázala a mañana directamente desde la notificación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez la tâche, faites-vous rappeler dans une heure ou reportez-la à demain, directement depuis la notification."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्य को पूर्ण करें, 1 घंटे के लिए स्नूज़ करें या कल पर टालें, सब सीधे सूचना से।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa l’attività, posticipala di un’ora o rimandala a domani direttamente dalla notifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知から、そのままタスクの完了、1時間のスヌーズ、明日への延期ができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림에서 바로 할 일을 완료하거나, 1시간 뒤로 다시 알리거나, 내일로 미룰 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukończ zadanie, przypomnij o nim za godzinę lub odłóż je na jutro prosto z powiadomienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclua a tarefa, peça para ser lembrado em uma hora ou adie-a para amanhã, direto pela notificação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполните задачу, напомните о ней через час или отложите на завтра прямо из уведомления."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виконайте завдання, нагадайте про нього за годину або відкладіть на завтра просто зі сповіщення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接在通知中完成任务、1 小时后再提醒，或推迟到明天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接從通知完成任務、延後 1 小時提醒，或延到明天。"
          }
        }
      }
    },
    "setup.notifications.change.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
