    "system.focus_filter.description": {
      "comment": "Description for the Lorvex Focus system Focus Filter",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء تشغيل هذا التركيز، تعرض أدوات Lorvex وApple Watch المهام الموجودة في القوائم التي تختارها فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফোকাস চালু থাকলে Lorvex-এর উইজেট ও Apple Watch শুধু আপনার বেছে নেওয়া তালিকার টাস্ক দেখায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange dieser Fokus aktiv ist, zeigen die Widgets von Lorvex und die Apple Watch nur die Aufgaben aus den Listen, die du auswählst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όσο αυτή η Συγκέντρωση είναι ενεργή, τα widget του Lorvex και το Apple Watch εμφανίζουν μόνο τις εργασίες των λιστών που επιλέγετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While this Focus is on, Lorvex’s widgets and Apple Watch show only the tasks in the lists you choose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras este modo de concentración esté activado, los widgets de Lorvex y el Apple Watch solo muestran las tareas de las listas que elijas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تا زمانی که این حالت تمرکز روشن است، ویجت‌های Lorvex و Apple Watch فقط کارهای فهرست‌هایی را که انتخاب می‌کنید نشان می‌دهند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que ce mode de concentration est activé, les widgets de Lorvex et l’Apple Watch n’affichent que les tâches des listes que vous choisissez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשמצב הריכוז הזה פעיל, הווידג׳טים של Lorvex וה-Apple Watch מציגים רק את המשימות שברשימות שבחרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ोकस चालू रहने पर Lorvex के विजेट और Apple Watch केवल आपकी चुनी हुई सूचियों के कार्य दिखाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat Fokus ini aktif, widget Lorvex dan Apple Watch hanya menampilkan tugas dalam daftar yang Anda pilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché questa modalità di concentrazione è attiva, i widget di Lorvex e l’Apple Watch mostrano solo le attività delle liste che scegli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この集中モードがオンの間、LorvexのウィジェットとApple Watchには、選択したリストのタスクだけが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 집중 모드가 켜져 있는 동안 Lorvex 위젯과 Apple Watch에는 선택한 목록의 할 일만 표시됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा फोकस चालू असताना Lorvex चे विजेट आणि Apple Watch फक्त तुम्ही निवडलेल्या याद्यांमधील कार्ये दाखवतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila Fokus ini aktif, widget Lorvex dan Apple Watch hanya menunjukkan tugas dalam senarai yang anda pilih."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zolang deze focus aan staat, tonen de widgets van Lorvex en de Apple Watch alleen de taken in de lijsten die je kiest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy ten Fokus jest włączony, widżety Lorvex i Apple Watch pokazują tylko zadania z wybranych przez ciebie list."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto este modo de Foco estiver ativado, os widgets do Lorvex e o Apple Watch mostram apenas as tarefas das listas que você escolher."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât timp această Concentrare este activă, widgeturile Lorvex și Apple Watch afișează doar sarcinile din listele alese."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока включён этот режим фокусирования, виджеты Lorvex и Apple Watch показывают только задачи из выбранных вами списков."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த ஃபோகஸ் ஆன் ஆக இருக்கும்போது, Lorvex விட்ஜெட்கள் மற்றும் Apple Watch நீங்கள் தேர்ந்தெடுத்த பட்டியல்களில் உள்ள பணிகளை மட்டுமே காட்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫోకస్ ఆన్‌లో ఉన్నప్పుడు, Lorvex విడ్జెట్‌లు, Apple Watch మీరు ఎంచుకున్న జాబితాలలోని టాస్క్‌లను మాత్రమే చూపుతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะที่โฟกัสนี้เปิดอยู่ วิดเจ็ตของ Lorvex และ Apple Watch จะแสดงเฉพาะงานในลิสต์ที่คุณเลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Odak açıkken Lorvex’in araç takımları ve Apple Watch yalnızca seçtiğiniz listelerdeki görevleri gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки ввімкнено цей режим фокусування, віджети Lorvex і Apple Watch показують лише завдання з вибраних вами списків."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب تک یہ فوکس آن ہے، Lorvex کے ویجٹس اور Apple Watch صرف وہ کام دکھاتے ہیں جو آپ کی منتخب کردہ فہرستوں میں ہوں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi Tập trung này bật, các tiện ích của Lorvex và Apple Watch chỉ hiển thị nhiệm vụ trong những danh sách bạn chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启此专注模式时，Lorvex 的小组件和 Apple Watch 只显示你所选列表中的任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟此專注模式時，Lorvex 小工具和 Apple Watch 只會顯示你所選清單中的任務。"
          }
        }
      }
    },
