        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了しなければならない日です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마쳐야 하는 날입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzień, do którego zadanie trzeba ukończyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dia até o qual ela precisa estar concluída."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "День, к которому задачу нужно завершить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "День, до якого завдання потрібно завершити."
