          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukuje zadania Lorvex według tagu ze Skrótów lub Siri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontra tarefas do Lorvex com uma etiqueta pelos Atalhos ou pela Siri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Находит задачи Lorvex по тегу из «Быстрых команд» или Siri."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
