    "settings.reset.confirm.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset This Device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置此设备"
          }
        }
      }
    },
    "settings.reset.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently erases all Lorvex data and settings on this Mac. It doesn’t touch iCloud: if sync was on, your data stays in iCloud and can download again when sync is re-enabled. To remove the iCloud copy too, use Delete iCloud Data first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久清除这台 Mac 上的所有 Lorvex 数据和设置。此操作不影响 iCloud：如果之前开启了同步，数据仍会保留在 iCloud 中，重新启用同步后可能会再次下载。若要同时删除 iCloud 中的副本，请先使用“删除 iCloud 数据”。"
          }
        }
      }
    },
    "settings.reset.confirm.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset Lorvex on this Mac?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要重置这台 Mac 上的 Lorvex 吗？"
          }
        }
      }
    },
    "settings.reset.delete_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t finish erasing local data. Restart Lorvex and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法完成本地数据清除。请重新启动 Lorvex 后重试。"
          }
        }
      }
    },
    "settings.reset.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase Lorvex-managed local data and settings on this Mac and start fresh. This is local-only: data already synced to iCloud stays in iCloud and can download again when sync is re-enabled. System Calendar events are not deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除本台 Mac 上由 Lorvex 管理的本地数据和设置并重新开始。此操作仅限本地：已同步到 iCloud 的数据会保留在 iCloud 中，重新启用同步后可能会再次下载。系统日历中的事件不会被删除。"
          }
        }
      }
    },
    "settings.reset.environment_database_error": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex is using a database path from the launch environment. Remove that environment setting and restart Lorvex before resetting local data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 正在使用来自启动环境的数据库路径。请先移除该环境设置并重启 Lorvex，然后再重置本地数据。"
          }
        }
      }
    },
    "settings.reset.section": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
