    "settings.activity.retention.footer.off": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي الإيقاف إلى التوقف عن التسجيل ومسح الإدخالات الموجودة على جميع أجهزتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Aus“ beendet die Aufzeichnung und löscht vorhandene Einträge auf allen deinen Geräten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off stops recording and clears existing entries on all your devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Desactivado, se deja de registrar y se borran las entradas existentes en todos tus dispositivos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با خاموش‌کردن، ثبت متوقف می‌شود و موارد موجود در همه دستگاه‌های شما پاک می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : l’enregistrement s’arrête et les entrées existantes sont effacées sur tous vos appareils."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כיבוי עוצר את ההקלטה ומוחק את הרשומות הקיימות בכל המכשירים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद करने पर रिकॉर्डिंग रुक जाती है और आपके सभी डिवाइस से मौजूदा एंट्री हट जाती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato: interrompe la registrazione e cancella le voci esistenti su tutti i tuoi dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると記録が停止され、すべてのデバイスで既存の項目が消去されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 기록이 중단되고 모든 기기의 기존 항목이 지워집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Uit’ stopt met opnemen en wist bestaande vermeldingen op al je apparaten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcja „Wył.” wstrzymuje zapisywanie i usuwa istniejące wpisy na wszystkich twoich urządzeniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado: interrompe a gravação e apaga as entradas existentes em todos os seus dispositivos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Opțiunea „Dezactivat” oprește scrierea în jurnal și șterge înregistrările existente de pe toate dispozitivele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если выбрать «Выкл.», запись прекращается, а существующие записи на всех ваших устройствах удаляются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо вибрати «Вимк.», запис припиняється, а наявні записи на всіх ваших пристроях видаляються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بند کرنے سے ریکارڈنگ رک جاتی ہے اور آپ کی تمام ڈیوائسز پر موجودہ اندراجات صاف ہو جاتے ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后将停止记录，并清除你所有设备上的现有条目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後會停止記錄，並清除你所有裝置上的現有項目。"
          }
        }
      }
    },
    "settings.activity.retention.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُقتطع الإدخالات الأقدم عند المزامنة. يؤدي الإيقاف إلى التوقف عن التسجيل ومسح الإدخالات الموجودة على جميع أجهزتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ältere Einträge werden bei der Synchronisierung bereinigt. „Aus“ beendet die Aufzeichnung und löscht vorhandene Einträge auf allen deinen Geräten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Older entries are trimmed on sync. Off stops recording and clears existing entries on all your devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las entradas más antiguas se eliminan al sincronizar. Con Desactivado, se deja de registrar y se borran las entradas existentes en todos tus dispositivos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "موارد قدیمی‌تر هنگام همگام‌سازی حذف می‌شوند. با خاموش‌کردن، ثبت متوقف می‌شود و موارد موجود در همه دستگاه‌های شما پاک می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les entrées plus anciennes sont supprimées lors de la synchronisation. Désactivé : l’enregistrement s’arrête et les entrées existantes sont effacées sur tous vos appareils."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשומות ישנות יותר נגזמות בעת סנכרון. כיבוי עוצר את ההקלטה ומוחק את הרשומות הקיימות בכל המכשירים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिंक होने पर पुरानी एंट्री हटा दी जाती हैं। बंद करने पर रिकॉर्डिंग रुक जाती है और आपके सभी डिवाइस से मौजूदा एंट्री हट जाती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le voci meno recenti vengono rimosse durante la sincronizzazione. Disattivato: interrompe la registrazione e cancella le voci esistenti su tutti i tuoi dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古い項目は同期時に整理されます。オフにすると記録が停止され、すべてのデバイスで既存の項目が消去されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오래된 항목은 동기화할 때 정리됩니다. 끄면 기록이 중단되고 모든 기기의 기존 항목이 지워집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oudere vermeldingen worden bij het synchroniseren opgeschoond. ‘Uit’ stopt met opnemen en wist bestaande vermeldingen op al je apparaten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Starsze wpisy są usuwane podczas synchronizacji. Opcja „Wył.” wstrzymuje zapisywanie i usuwa istniejące wpisy na wszystkich twoich urządzeniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As entradas mais antigas são removidas na sincronização. Desativado: interrompe a gravação e apaga as entradas existentes em todos os seus dispositivos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrările mai vechi sunt eliminate la sincronizare. Opțiunea „Dezactivat” oprește scrierea în jurnal și șterge înregistrările existente de pe toate dispozitivele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старые записи удаляются при синхронизации. Если выбрать «Выкл.», запись прекращается, а существующие записи на всех ваших устройствах удаляются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Старіші записи видаляються під час синхронізації. Якщо вибрати «Вимк.», запис припиняється, а наявні записи на всіх ваших пристроях видаляються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پرانے اندراجات سنک کے دوران کم کر دیے جاتے ہیں۔ بند کرنے سے ریکارڈنگ رک جاتی ہے اور آپ کی تمام ڈیوائسز پر موجودہ اندراجات صاف ہو جاتے ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "较早的条目会在同步时清理。关闭后将停止记录，并清除你所有设备上的现有条目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "較舊的項目會在同步時被修剪。關閉後會停止記錄，並清除你所有裝置上的現有項目。"
          }
        }
      }
    },
