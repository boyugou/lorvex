          "stringUnit": {
            "state": "translated",
            "value": "Η εργασία %@ δεν περιμένει καμία εργασία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn’t waiting on any task."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” no depende de ninguna tarea."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کار «%@» منتظر هیچ کاری نیست."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » ne dépend d’aucune tâche."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשימה \"%@\" לא ממתינה לאף משימה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” किसी कार्य पर निर्भर नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tidak menunggu tugas apa pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” non dipende da nessuna attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はどのタスクにも依存していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 할 일은 다른 할 일에 의존하지 않습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ कोणत्याही कार्यावर अवलंबून नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tidak menunggu sebarang tugas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wacht op geen enkele taak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadanie „%@” nie zależy od żadnego zadania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” não depende de nenhuma tarefa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nu așteaptă nicio sarcină."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задача «%@» не зависит ни от одной задачи."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” எந்தப் பணிக்காகவும் காத்திருக்கவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ఏ టాస్క్ కోసం వేచి లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ไม่ต้องรองานใด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hiçbir görevi beklemiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завдання «%@» не залежить від жодного завдання."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کام \"%@\" کسی کام کے انتظار میں نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ không phải chờ nhiệm vụ nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”没有在等待任何任务。"
          }
