            "value": "Delete Lorvex data from iCloud everywhere?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar los datos de Lorvex de iCloud en todos los dispositivos?"
          }
        },
        "fa": {
