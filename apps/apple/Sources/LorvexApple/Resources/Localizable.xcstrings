          "stringUnit": {
            "state": "translated",
            "value": "Alegeți o oră de sfârșit după ora de început."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите время окончания позже времени начала."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடக்க நேரத்துக்குப் பிறகான முடிவு நேரத்தைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రారంభ సమయం తర్వాత ఉండే ముగింపు సమయాన్ని ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
