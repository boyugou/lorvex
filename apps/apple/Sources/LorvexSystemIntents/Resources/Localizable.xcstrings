          "stringUnit": {
            "state": "translated",
            "value": "要移除此項目嗎？"
          }
        }
      }
    },
    "system.confirm.reset_habit": {
      "comment": "Confirmation prompt before resetting a Lorvex habit's logged completions",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد إعادة تعيين هذه العادة؟ سيتم مسح الإكمالات المسجلة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অভ্যাসটি রিসেট করবেন? লগ করা চেক-ইন মুছে যাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Gewohnheit zurücksetzen? Erfasste Einträge werden gelöscht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Να γίνει επαναφορά αυτής της συνήθειας; Οι καταγεγραμμένες ολοκληρώσεις θα διαγραφούν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset this habit? Logged completions will be cleared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Restablecer este hábito? Se borrarán sus registros."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این عادت بازنشانی شود؟ ثبت‌های انجام‌شده پاک می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinitialiser cette habitude ? Les réalisations enregistrées seront effacées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאפס את ההרגל הזה? הסימונים שנרשמו יימחקו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस आदत को रीसेट करें? दर्ज किए गए चेक-इन साफ़ हो जाएँगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur ulang kebiasaan ini? Penyelesaian yang tercatat akan dibersihkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Reimpostare questa abitudine? I completamenti registrati verranno cancellati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この習慣をリセットしますか？記録済みの完了はすべて消去されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 습관을 초기화하시겠습니까? 기록된 완료 내역이 모두 지워집니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ही सवय रीसेट करायची का? नोंदवलेले चेक-इन क्लिअर होतील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset tabiat ini? Penyelesaian yang direkodkan akan dikosongkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze gewoonte terugzetten? Alles wat is afgevinkt, wordt gewist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zresetować ten nawyk? Zapisane wykonania zostaną wyczyszczone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Redefinir este hábito? As conclusões registradas serão apagadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Resetați acest obicei? Bifările înregistrate vor fi șterse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбросить эту привычку? Записанные выполнения будут удалены."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் பழக்கத்தை மீட்டமைக்கவா? பதிவான செக்-இன்கள் அழிக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ అలవాటును రీసెట్ చేయాలా? నమోదు చేసిన చెక్ ఇన్‌లు క్లియర్ అవుతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีเซ็ตนิสัยนี้หรือไม่ การทำสำเร็จที่บันทึกไว้จะถูกล้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alışkanlık sıfırlansın mı? Kayıtlı tamamlamalar silinecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скинути цю звичку? Записані виконання буде видалено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس عادت کو ری سیٹ کریں؟ درج شدہ چیک اِنز صاف ہو جائیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt lại thói quen này? Các lần hoàn thành đã ghi sẽ bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置此习惯？已记录的完成情况将被清除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要重設此習慣嗎？已記錄的完成次數將會清除。"
          }
        }
      }
    },
    "system.day_times.none_fit_dialog": {
      "comment": "Dialog when no task fits the working time left; %@ is the date (YYYY-MM-DD)",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مهمة تتسع للوقت المتبقي في %@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ তারিখের বাকি সময়ে কোনো টাস্ক বসানো যাচ্ছে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für keine Aufgabe reicht die verbleibende Zeit am %@."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καμία εργασία δεν χωράει στον χρόνο που απομένει στις %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No task fits the time left on %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna tarea cabe en el tiempo que queda el %@."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ کاری در زمان باقی‌مانده برای %@ جا نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune tâche ne tient dans le temps restant le %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אף משימה לא נכנסת בזמן שנותר ב%@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ के बचे हुए समय में कोई कार्य नहीं समा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada tugas yang muat dalam waktu yang tersisa pada %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna attività entra nel tempo rimasto il %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の残り時間に収まるタスクはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 남은 시간에 맞는 할 일이 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ रोजी उरलेल्या वेळेत कोणतेही कार्य बसत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada tugas yang muat dalam masa yang berbaki pada %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen enkele taak past in de resterende tijd op %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadne zadanie nie mieści się w czasie pozostałym na %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma tarefa cabe no tempo restante em %@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicio sarcină nu încape în timpul rămas din data de %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни одна задача не помещается в оставшееся время на %@."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ தேதியில் மீதமுள்ள நேரத்தில் எந்தப் பணியும் பொருந்தவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ తేదీన మిగిలి ఉన్న సమయానికి ఏ టాస్క్ సరిపోదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีงานที่พอดีกับเวลาที่เหลือในวันที่ %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tarihinde kalan zamana sığan görev yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жодне завдання не вміщується в час, що залишився на %@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ کے باقی وقت میں کوئی کام نہیں سما سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có nhiệm vụ nào vừa với thời gian còn lại vào %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 剩下的可安排时间里放不下任何任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有任何任務能放進 %@ 剩餘的時間。"
          }
        }
      }
    },
    "system.day_times.nothing_to_place_dialog": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء في %@ يحتاج إلى وقت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ তারিখে কোনো কিছুরই সময় ঠিক করার দরকার নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am %@ braucht nichts eine Uhrzeit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τίποτα στις %@ δεν χρειάζεται ώρα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing on %@ needs a time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada del %@ necesita una hora."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در %@ چیزی نیاز به زمان ندارد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune tâche du %@ n’a besoin d’un horaire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין ב%@ דבר שצריך לקבוע לו שעה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पर किसी कार्य का समय तय करने की ज़रूरत नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang perlu diberi waktu pada %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna attività del %@ ha bisogno di un orario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@には時間の指定が必要なタスクはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에는 시간이 필요한 항목이 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ रोजी कोणत्याही गोष्टीची वेळ ठरवण्याची गरज नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada apa-apa pada %@ yang memerlukan masa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets op %@ heeft een tijd nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na %@ nic nie wymaga godziny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada em %@ precisa de um horário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic din data de %@ nu are nevoie de oră."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На %@ нет задач, которым нужно время."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ தேதியில் நேரம் ஒதுக்க வேண்டிய பணி எதுவும் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ తేదీన సమయం కేటాయించాల్సిన టాస్క్ ఏదీ లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีงานในวันที่ %@ ที่ต้องกำหนดเวลา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tarihinde saat gerektiren bir şey yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На %@ немає завдань, яким потрібен час."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ پر کسی چیز کا وقت مقرر کرنا ضروری نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì vào %@ cần đặt giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有需要安排时间的任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@沒有需要安排時間的項目。"
          }
        }
      }
    },
    "system.day_times.propose.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقتراح أوقات لمهام Lorvex اليوم، أو لمهام تاريخ محدد، حول أحداث تقويمك. لا يتم حفظ أي شيء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ক্যালেন্ডারের সাথে মিলিয়ে আজকের বা কোনো নির্দিষ্ট তারিখের Lorvex টাস্কের জন্য সময় প্রস্তাব করুন। কিছুই সেভ করা হয় না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlägt Zeiten für die Lorvex-Aufgaben von heute oder eines bestimmten Datums vor, rund um deinen Kalender. Es wird nichts gesichert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προτείνετε ώρες για τις εργασίες Lorvex της ημέρας ή μιας συγκεκριμένης ημερομηνίας, γύρω από το ημερολόγιό σας. Δεν αποθηκεύεται τίποτα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggest times for today’s Lorvex tasks, or a specific date’s, around your calendar. Nothing is saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugiere horarios para las tareas de Lorvex de hoy o de una fecha concreta, teniendo en cuenta tu calendario. No se guarda nada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیشنهاد زمان برای کارهای Lorvex امروز یا تاریخی مشخص، با در نظر گرفتن تقویم شما. چیزی ذخیره نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggère des horaires pour les tâches Lorvex d’aujourd’hui ou d’une date précise, autour de votre calendrier. Rien n’est enregistré."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצעת שעות למשימות Lorvex של היום או של תאריך מסוים, בהתאם ללוח השנה שלך. שום דבר לא נשמר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके कैलेंडर के आसपास आज के, या किसी तय तारीख़ के, Lorvex कार्यों के लिए समय सुझाएँ। कुछ भी सहेजा नहीं जाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyarankan waktu untuk tugas Lorvex hari ini, atau untuk tanggal tertentu, sesuai dengan kalender Anda. Tidak ada yang disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggerisce orari per le attività Lorvex di oggi o di una data specifica, attorno al tuo calendario. Non viene salvato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日、または指定した日のLorvexのタスクについて、カレンダーを避けて時間を提案します。保存はされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 또는 지정한 날짜의 Lorvex 할 일에 대해 캘린더 일정을 피해 시간을 제안합니다. 저장되지는 않습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या दिनदर्शिकेनुसार आजच्या किंवा एखाद्या विशिष्ट तारखेच्या Lorvex कार्यांसाठी वेळा सुचवा. काहीही जतन केले जात नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencadangkan masa untuk tugas Lorvex hari ini, atau untuk tarikh tertentu, mengikut kalendar anda. Tiada apa-apa yang disimpan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelt tijden voor voor de Lorvex-taken van vandaag of van een bepaalde datum, rond je agenda. Er wordt niets bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proponuje godziny dla zadań Lorvex na dzisiaj lub wybraną datę z uwzględnieniem twojego kalendarza. Nic nie jest zapisywane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugere horários para as tarefas do Lorvex de hoje ou de uma data específica, considerando seu calendário. Nada é salvo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugerează ore pentru sarcinile Lorvex de astăzi sau dintr-o anumită dată, în jurul calendarului. Nu se salvează nimic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предлагает время для задач Lorvex на сегодня или на выбранную дату с учётом вашего календаря. Ничего не сохраняется."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கேலண்டரைக் கருத்தில் கொண்டு, இன்றைய அல்லது குறிப்பிட்ட தேதியின் Lorvex பணிகளுக்கு நேரங்களைப் பரிந்துரை. எதுவும் சேமிக்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ క్యాలెండర్‌ను పరిగణనలోకి తీసుకుని, ఈరోజు లేదా ఒక నిర్దిష్ట తేదీ నాటి Lorvex టాస్క్‌లకు సమయాలను సూచించండి. ఏదీ సేవ్ చేయబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แนะนำเวลาสำหรับงาน Lorvex ของวันนี้หรือของวันที่ที่ระบุ โดยเลี่ยงช่วงที่มีนัดในปฏิทินของคุณ จะไม่มีการบันทึกอะไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takviminizi gözeterek bugünün veya belirli bir tarihin Lorvex görevleri için saat önerin. Hiçbir şey kaydedilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропонує час для завдань Lorvex на сьогодні або на вибрану дату з урахуванням вашого календаря. Нічого не зберігається."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج یا کسی خاص تاریخ کے Lorvex کاموں کے لیے آپ کے کیلنڈر کے مطابق اوقات تجویز کریں۔ کچھ محفوظ نہیں ہوتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gợi ý giờ cho các nhiệm vụ Lorvex hôm nay, hoặc của một ngày cụ thể, dựa trên lịch của bạn. Không có gì được lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "围绕你的日历，为今天或指定日期的 Lorvex 任务建议时间。不会保存任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依照你的行事曆，為今天或指定日期的 Lorvex 任務建議時間。不會儲存任何內容。"
          }
        }
      }
    },
