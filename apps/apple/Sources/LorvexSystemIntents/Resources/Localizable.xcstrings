    "system.confirm.delete": {
      "comment": "Confirmation prompt before permanently deleting a Lorvex item from Shortcuts or Siri",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد حذف هذا العنصر؟ لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই আইটেমটি ডিলিট করবেন? এটি পূর্বাবস্থায় ফেরানো যাবে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Element löschen? Dies kann nicht rückgängig gemacht werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Να διαγραφεί αυτό το στοιχείο; Αυτή η ενέργεια δεν μπορεί να αναιρεθεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this item? This can’t be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar este elemento? Esta acción no se puede deshacer."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این مورد حذف شود؟ این کار قابل بازگشت نیست."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer cet élément ? Cette action est irréversible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למחוק את הפריט הזה? לא ניתן לבטל פעולה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस आइटम को हटाएँ? इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus item ini? Tindakan ini tidak dapat diurungkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare questo elemento? L’operazione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目を削除しますか？この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목을 삭제하시겠습니까? 이 동작은 취소할 수 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा आयटम हटवायचा का? हे पूर्ववत करता येणार नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Padam item ini? Tindakan ini tidak boleh dibuat asal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit item verwijderen? Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć ten element? Tej czynności nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir este item? Esta ação não pode ser desfeita."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ștergeți acest element? Această acțiune nu poate fi anulată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить этот элемент? Это действие нельзя отменить."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த ஐட்டத்தை நீக்கவா? இதைச் செயல்தவிர்க்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఐటెమ్‌ను డిలీట్ చేయాలా? ఇది అన్‌డూ చేయబడదు."
