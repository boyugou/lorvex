        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제할 범위를 선택하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, które wystąpienia usunąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quais ocorrências excluir."
          }
        },
        "ru": {
          "stringUnit": {
