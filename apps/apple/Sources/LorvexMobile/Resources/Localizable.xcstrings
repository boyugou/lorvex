    "today.overbooked.move.more": {
      "comment": "Today's overbooked note. 1 and 2: the first two task titles to move. 3: how many more tasks move. 4: the time it frees, formatted, e.g. “1 hr 30 min”.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "نقل \"%1$@\" و\"%2$@\" و%3$lld مهام أخرى إلى الغد يوفّر حوالي %4$@."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "نقل \"%1$@\" و\"%2$@\" و%3$lld مهمة أخرى إلى الغد يوفّر حوالي %4$@."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "نقل \"%1$@\" و\"%2$@\" ومهمة واحدة أخرى إلى الغد يوفّر حوالي %4$@."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "نقل \"%1$@\" و\"%2$@\" و%3$lld مهمة أخرى إلى الغد يوفّر حوالي %4$@."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "نقل \"%1$@\" و\"%2$@\" ومهمتين أخريين إلى الغد يوفّر حوالي %4$@."
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "نقل \"%1$@\" و\"%2$@\" و%3$lld مهمة أخرى إلى الغد يوفّر حوالي %4$@."
                }
              }
            }
