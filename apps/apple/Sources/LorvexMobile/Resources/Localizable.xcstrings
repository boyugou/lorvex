    "database.recovery.notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Lorvex فتح قاعدة بياناتك السابقة (%1$@)، فتم وضعها جانبًا وإنشاء قاعدة جديدة. بياناتك السابقة محفوظة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex আপনার আগের ডেটাবেস (%1$@) খুলতে পারেনি, তাই সেটি আলাদা করে রাখা হয়েছে এবং একটি নতুন ডেটাবেস তৈরি করা হয়েছে। আপনার আগের ডেটা সংরক্ষিত আছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex konnte deine bisherige Datenbank (%1$@) nicht öffnen. Sie wurde beiseitegelegt und eine neue Datenbank wurde angelegt. Deine früheren Daten sind erhalten geblieben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Lorvex δεν μπόρεσε να ανοίξει την προηγούμενη βάση δεδομένων σας (%1$@), οπότε τέθηκε στην άκρη και δημιουργήθηκε μια νέα. Τα προηγούμενα δεδομένα σας διατηρούνται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex couldn’t open your previous database (%1$@), so it was set aside and a fresh one was created. Your earlier data is preserved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex no pudo abrir tu base de datos anterior (%1$@), así que se apartó y se creó una nueva. Tus datos anteriores se conservan."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه Lorvex نتوانست پایگاه‌داده قبلی شما (%1$@) را باز کند؛ بنابراین آن را کنار گذاشت و یک پایگاه‌داده تازه ایجاد کرد. داده‌های قبلی شما حفظ شده‌اند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex n’a pas pu ouvrir votre base de données précédente (%1$@). Elle a été mise de côté et une nouvelle base a été créée. Vos données antérieures sont conservées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לפתוח את מסד הנתונים הקודם שלך (%1$@) ב-Lorvex, ולכן הוא הועבר הצידה ונוצר מסד נתונים חדש. הנתונים הקודמים שלך נשמרו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex आपका पिछला डेटाबेस (%1$@) नहीं खोल सका, इसलिए उसे अलग रख दिया गया और नया डेटाबेस बनाया गया। आपका पहले का डेटा सुरक्षित है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex tidak dapat membuka basis data sebelumnya (%1$@), sehingga basis data itu disisihkan dan yang baru dibuat. Data lama tetap tersimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex non è riuscito ad aprire il tuo database precedente (%1$@), quindi è stato messo da parte ed è stato creato un nuovo database. I tuoi dati precedenti sono conservati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvexが以前のデータベース（%1$@）を開けなかったため、そのデータベースは別の場所に保管され、新しいデータベースが作成されました。以前のデータは保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex에서 이전 데이터베이스(%1$@)를 열 수 없어 따로 보관하고 새 데이터베이스를 만들었습니다. 이전 데이터는 그대로 보존되어 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex ला तुमचा आधीचा डेटाबेस (%1$@) उघडता आला नाही, म्हणून तो वेगळा ठेवला गेला आणि नवीन डेटाबेस तयार केला गेला. तुमचा आधीचा डेटा जतन केलेला आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex tidak dapat membuka pangkalan data sebelumnya (%1$@), jadi ia diasingkan dan yang baharu dicipta. Data lama dipelihara."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex kon je vorige database (%1$@) niet openen. Deze is apart gezet en er is een nieuwe database aangemaakt. Je eerdere gegevens zijn bewaard gebleven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex nie mógł otworzyć twojej poprzedniej bazy danych (%1$@), więc odłożył ją na bok i utworzył nową. Twoje wcześniejsze dane są zachowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lorvex não conseguiu abrir seu banco de dados anterior (%1$@), então ele foi separado e um novo foi criado. Seus dados anteriores foram preservados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex nu a putut deschide baza de date anterioară (%1$@), așa că aceasta a fost pusă deoparte și a fost creată una nouă. Datele anterioare sunt păstrate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex не удалось открыть вашу прежнюю базу данных (%1$@), поэтому она сохранена отдельно, а вместо неё создана новая. Ваши прежние данные не потеряны."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் முந்தைய தரவுத்தளத்தைத் (%1$@) திறக்க முடியவில்லை, எனவே அது ஒதுக்கி வைக்கப்பட்டுப் புதிய தரவுத்தளம் உருவாக்கப்பட்டது. உங்கள் முந்தைய தரவு பாதுகாக்கப்பட்டுள்ளது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ మునుపటి డేటాబేస్‌ను (%1$@) తెరవడం వీలుపడలేదు, అందువల్ల దానిని పక్కన పెట్టి కొత్త డేటాబేస్ సృష్టించబడింది. మీ మునుపటి డేటా భద్రంగా ఉంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex เปิดฐานข้อมูลเดิมของคุณไม่ได้ (%1$@) จึงแยกไฟล์นั้นไว้ต่างหากและสร้างฐานข้อมูลใหม่ ข้อมูลเดิมของคุณยังอยู่ครบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex önceki veritabanınızı açamadı (%1$@), bu yüzden kenara ayrıldı ve yeni bir veritabanı oluşturuldu. Önceki verileriniz korunuyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex не вдалося відкрити вашу попередню базу даних (%1$@), тому її збережено окремо, а замість неї створено нову. Ваші попередні дані збережено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا پچھلا ڈیٹابیس (%1$@) Lorvex نہیں کھول سکا، اس لیے اسے الگ رکھ دیا گیا اور ایک نیا ڈیٹابیس بنا دیا گیا۔ آپ کا پرانا ڈیٹا محفوظ ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex không thể mở cơ sở dữ liệu trước đó (%1$@), nên cơ sở dữ liệu đó đã được cất riêng và một cơ sở dữ liệu mới đã được tạo. Dữ liệu cũ vẫn được giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 无法打开你之前的数据库（%1$@），因此已将其保存起来并创建了一个新数据库。你之前的数据仍会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex 無法開啟你先前的資料庫（%1$@），因此已將它另行保存，並建立了一個新的資料庫。你先前的資料仍會保留。"
          }
        }
      }
    },
