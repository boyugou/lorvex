        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời nhắc đúng giờ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准时提醒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "準時提醒"
          }
        }
      }
    },
    "setup.notifications.due.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينبّهك Lorvex عندما يحين موعد تذكير مهمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টাস্কের রিমাইন্ডারের সময় হলে Lorvex আপনাকে জানায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex benachrichtigt dich, wenn die Erinnerung einer Aufgabe ansteht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Lorvex σας ειδοποιεί όταν έρθει η ώρα της υπόμνησης μιας εργασίας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex notifies you when a task’s reminder is due."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex te avisa cuando llega la hora del recordatorio de una tarea."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی زمان یادآور یک کار برسد، Lorvex به شما اعلان می‌دهد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex vous notifie quand arrive l’heure du rappel d’une tâche."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשמגיע הזמן של תזכורת למשימה, Lorvex שולח לך התראה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्य के रिमाइंडर का समय होने पर Lorvex आपको सूचित करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex memberi tahu Anda saat pengingat tugas tiba waktunya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex ti avvisa quando arriva l’ora del promemoria di un’attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクのリマインダーの時刻になると、Lorvexが通知します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일의 알림 시간이 되면 Lorvex가 알려 줍니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्याच्या रिमाइंडरची वेळ झाली की Lorvex तुम्हाला कळवते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex memberitahu anda apabila tiba masa peringatan tugas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex waarschuwt je wanneer de herinnering van een taak afgaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex powiadomi cię, gdy nadejdzie czas przypomnienia o zadaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lorvex avisa quando chega a hora do lembrete de uma tarefa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex vă anunță când se declanșează mementoul unei sarcini."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex уведомит вас, когда подойдёт время напоминания о задаче."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு பணியின் நினைவூட்டல் நேரம் வரும்போது Lorvex உங்களுக்குத் தெரிவிக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "టాస్క్ రిమైండర్ సమయం వచ్చినప్పుడు Lorvex మీకు తెలియజేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex จะแจ้งเตือนคุณเมื่อถึงเวลาเตือนความจำของงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir görevin anımsatıcısının zamanı geldiğinde Lorvex size bildirim gönderir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex сповістить вас, коли настане час нагадування про завдання."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب کسی کام کی یاد دہانی کا وقت آتا ہے تو Lorvex آپ کو مطلع کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorvex thông báo cho bạn khi lời nhắc của một nhiệm vụ đến giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务的提醒时间到了，Lorvex 会通知你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任務的提醒時間一到，Lorvex 就會通知你。"
          }
        }
      }
    },
    "setup.notifications.act.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصرّف من الإشعار نفسه"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নোটিফিকেশন থেকেই অ্যাকশন নিন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkt in der Mitteilung handeln"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργήστε από τη γνωστοποίηση"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Act from the notification"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actúa desde la notificación"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از خود اعلان اقدام کنید"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agissez depuis la notification"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה ישירות מההתראה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचना से ही कार्रवाई करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bertindak dari pemberitahuan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Agisci dalla notifica"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知からそのまま操作"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림에서 바로 처리"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नोटिफिकेशनमधूनच कृती करा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bertindak daripada pemberitahuan"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Handel vanuit de melding"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działaj prosto z powiadomienia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aja pela notificação"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acționați din notificare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действуйте прямо из уведомления"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அறிவிப்பிலிருந்தே செயல்படவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నోటిఫికేషన్ నుండే చర్య తీసుకోండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดำเนินการจากการแจ้งเตือน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimden işlem yapın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дійте просто зі сповіщення"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نوٹیفکیشن ہی سے عمل کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác ngay từ thông báo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在通知中直接处理"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接從通知操作"
          }
        }
      }
    },
    "setup.notifications.act.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكمل المهمة، أو أجّل تذكيرها ساعة، أو أجّلها إلى الغد، مباشرةً من الإشعار."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নোটিফিকেশন থেকেই টাস্কটি সম্পূর্ণ করুন, এক ঘণ্টার জন্য স্নুজ করুন, অথবা আগামীকালের জন্য পিছিয়ে দিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erledige die Aufgabe, lass dich in einer Stunde erneut erinnern oder verschiebe sie auf morgen – direkt in der Mitteilung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ολοκληρώστε την εργασία, αναβάλετέ την για μία ώρα ή για αύριο, κατευθείαν από τη γνωστοποίηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete the task, snooze it for an hour, or defer it to tomorrow right from the notification."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa la tarea, pospónla una hora o aplázala a mañana directamente desde la notificación."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کار را مستقیم از خود اعلان تکمیل کنید، برای یک ساعت به تعویق بیندازید یا به فردا موکول کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez la tâche, faites-vous rappeler dans une heure ou reportez-la à demain, directement depuis la notification."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להשלים את המשימה, להפעיל לה נודניק לשעה או לדחות אותה למחר, ישירות מההתראה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्य को पूर्ण करें, 1 घंटे के लिए स्नूज़ करें या कल पर टालें, सब सीधे सूचना से।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesaikan tugas, tunda satu jam, atau tunda ke besok langsung dari pemberitahuan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa l’attività, posticipala di un’ora o rimandala a domani direttamente dalla notifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知から、そのままタスクの完了、1時間のスヌーズ、明日への延期ができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림에서 바로 할 일을 완료하거나, 1시간 뒤로 다시 알리거나, 내일로 미룰 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नोटिफिकेशनमधूनच कार्य पूर्ण करा, एका तासासाठी स्नूझ करा किंवा उद्यासाठी पुढे ढकला."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesaikan tugas, tangguh selama satu jam atau tangguhkan hingga esok terus daripada pemberitahuan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltooi de taak, laat je er over een uur opnieuw aan herinneren of stel uit tot morgen – direct vanuit de melding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukończ zadanie, przypomnij o nim za godzinę lub odłóż je na jutro prosto z powiadomienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclua a tarefa, peça para ser lembrado em uma hora ou adie-a para amanhã, direto pela notificação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalizați sarcina, cereți o reamintire peste o oră sau amânați-o pentru mâine – direct din notificare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполните задачу, напомните о ней через час или отложите на завтра прямо из уведомления."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அறிவிப்பிலிருந்தே பணியை நிறைவுசெய்யலாம், ஒரு மணிநேரம் ஒத்திவைக்கலாம் அல்லது நாளைக்குத் தள்ளிவைக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నోటిఫికేషన్ నుండే టాస్క్‌ను పూర్తి చేయవచ్చు, ఒక గంట స్నూజ్ చేయవచ్చు లేదా రేపటికి వాయిదా వేయవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำงานให้เสร็จ เลื่อนไปหนึ่งชั่วโมง หรือเลื่อนไปพรุ่งนี้ได้จากการแจ้งเตือนเลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görevi tamamlayın, bir saat erteleyin veya yarına erteleyin; hepsi doğrudan bildirimden."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виконайте завдання, нагадайте про нього за годину або відкладіть на завтра просто зі сповіщення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کام کو براہ راست نوٹیفکیشن سے مکمل کریں، ایک گھنٹے کے لیے اسنوز کریں یا کل تک ملتوی کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoàn thành nhiệm vụ, báo lại sau 1 giờ hoặc hoãn đến ngày mai ngay từ thông báo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接在通知中完成任务、1 小时后再提醒，或推迟到明天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接從通知完成任務、延後 1 小時提醒，或延到明天。"
          }
        }
      }
    },
    "setup.notifications.change.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
